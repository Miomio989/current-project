    def _wire_shortcuts(self) -> None:
        QShortcut(QKeySequence("Ctrl+Return"), self, activated=self.on_generate)
        QShortcut(QKeySequence("Ctrl+Enter"), self, activated=self.on_generate)
        QShortcut(QKeySequence("Ctrl+S"), self, activated=self.save_current)
        QShortcut(QKeySequence("F10"), self, activated=lambda: self.menu_btn.showMenu())
        QShortcut(QKeySequence("Escape"), self, activated=self._escape)
        QShortcut(QKeySequence("Ctrl+Shift+T"), self, activated=self._toggle_theme)
        for i in range(self.tabs.count()):
            QShortcut(QKeySequence(f"Ctrl+{i + 1}"), self, activated=lambda i=i: self.tabs.setCurrentIndex(i))
        QShortcut(QKeySequence("Ctrl+0"), self, activated=lambda: self.fit_btn.toggle())
        QShortcut(QKeySequence("Ctrl+Shift+G"), self, activated=lambda: self.right_tabs.setCurrentIndex(1))
        QShortcut(QKeySequence("Ctrl+Shift+V"), self, activated=lambda: self.right_tabs.setCurrentIndex(0))
        # previous / next image (strip on the viewer tab, grid on the gallery
        # tab) - scoped to the right panel so the prompt editors keep the keys
        for seq, delta in (("Left", -1), ("Right", 1)):
            sc = QShortcut(QKeySequence(seq), self.right_tabs)
            sc.setContext(Qt.ShortcutContext.WidgetWithChildrenShortcut)
            sc.activated.connect(lambda d=delta: self._strip_step(d))
        del_sc = QShortcut(QKeySequence("Delete"), self.gallery, activated=self.delete_current)
        del_sc.setContext(Qt.ShortcutContext.WidgetShortcut)
        for act in (self.act_left, self.act_gallery, self.act_neg, self.act_full):
            self.addAction(act)

    def resizeEvent(self, e) -> None:  # noqa: N802
        super().resizeEvent(e)
        self._adapt_layout()

    def showEvent(self, e) -> None:  # noqa: N802
        super().showEvent(e)
        if not getattr(self, "_split_applied", False):
            self._split_applied = True
            QTimer.singleShot(0, self._apply_splitter)

    def _apply_splitter(self) -> None:
        total = max(1, self.split.width())
        saved = (self.settings.get("ui") or {}).get("splitter")
        left = None
        if saved and len(saved) == 2 and all(isinstance(x, (int, float)) for x in saved) and sum(saved) > 0:
            left = int(saved[0] * total / sum(saved))
        if left is None or left < 376 or total - left < 300:
            left = int(max(376, min(486, total * 0.47)))
        self.split.setSizes([left, max(300, total - left)])
        self._adapt_layout()

    def _adapt_layout(self) -> None:
        short = self.height() < 700
        self.mini_queue.setFixedHeight(48 if short else 92)
        narrow = self.right.width() < 440
        self.save_btn.setText("SAVE" if narrow else "SAVE \u25B8 OUTPUT")
        # keep DELETE reachable on small displays (it also lives in the \u22EF menu)
        self.act_buttons["DELETE"].setVisible(self.right.width() >= 380)
        self.horde_line.setVisible(self.left.width() >= 430)
        # compact the seed row on narrow panels (tooltip keeps the full meaning)
        self.dice_btn.setText("\u2684" if self.left.width() < 430 else "\u2684 RANDOM")
        # zoom controls step aside on the narrowest right panels - Ctrl+wheel
        # zooming and the 1:1 button keep working regardless
        zoomish = (self.zoom_out_btn, self.zoom_in_btn, self.zoom_label)
        for b in zoomish:
            b.setVisible(self.right.width() >= 384)
        self._fit_tabs()

    def _fit_tabs(self) -> None:
        """Keep the seven symbol tabs comfortable: shrink the glyph font a
        notch only if the bar would not fit the panel width."""
        bar = self.tabs.tabBar()
        corner_w = self.menu_btn.width() + (self.theme_btn.width() if getattr(self, "theme_btn", None) else 0)
        avail = self.left.width() - corner_w - 12
        if avail <= 0:
            return
        scale = float((self.settings.get("ui") or {}).get("font_scale", 1.0) or 1.0)
        chosen = 11.0
        for size in (11.0, 10.5, 10.0, 9.5, 9.0):
            fm = QFontMetrics(_font(size * scale, True))
            need = sum(fm.horizontalAdvance(t) + 16 + 4 for t in self._tab_symbols) + 8
            if need <= avail:
                chosen = size
                break
        if getattr(self, "_tab_pt", None) != chosen:
            self._tab_pt = chosen
            bar.setStyleSheet(f"QTabBar::tab {{ font-size: {chosen * scale:.1f}pt; }}")
        tight = self.left.width() < 465
        self.neg_btn.setText("NEG" if tight else "NEGATIVE")
        self.clear_btn.setText("\u2715" if tight else "CLEAR")

    def eventFilter(self, obj, ev) -> bool:  # noqa: N802
        if ev.type() == QEvent.Type.KeyPress and obj in (self.prompt_edit, self.neg_edit):
            if ev.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter) and ev.modifiers() & Qt.KeyboardModifier.ControlModifier:
                self.on_generate()
                return True
        return super().eventFilter(obj, ev)

