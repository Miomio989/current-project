def draw_gothic_filigree_panel(
    dest: pygame.Surface,
    rect: pygame.Rect,
    bg_alpha: int = 212,
    border_silver: RGB = (212, 206, 224),
    accent_crimson: RGB = (224, 28, 76),
    ornate_corners: bool = True,
) -> None:
    panel = pygame.Surface((rect.w, rect.h), pygame.SRCALPHA)
    top_c = (18, 8, 22)
    bot_c = (8, 4, 12)
    steps = max(8, min(32, rect.h // 4))
    bh = max(2, rect.h // steps + 1)
    for i in range(steps):
        u = i / float(max(1, steps - 1))
        c = lerp_rgb(top_c, bot_c, u)
        pygame.draw.rect(panel, (c[0], c[1], c[2], bg_alpha), (0, int(u * rect.h), rect.w, bh))
    pygame.draw.line(panel, (accent_crimson[0], accent_crimson[1], accent_crimson[2], 140), (4, 3), (rect.w - 5, 3), 2)
    dest.blit(panel, rect.topleft)

    pygame.draw.rect(dest, (24, 12, 28), rect.inflate(2, 2), 2)
    pygame.draw.rect(dest, border_silver, rect, 1)
    inner = rect.inflate(-6, -6)
    if inner.w > 12 and inner.h > 12:
        pygame.draw.rect(dest, (96, 74, 106), inner, 1)

    if ornate_corners:
        c_len = min(14, rect.w // 5, rect.h // 4)
        for cx, cy, dx, dy in (
            (rect.left, rect.top, 1, 1),
            (rect.right - 1, rect.top, -1, 1),
            (rect.left, rect.bottom - 1, 1, -1),
            (rect.right - 1, rect.bottom - 1, -1, -1),
        ):
            pygame.draw.line(dest, (248, 242, 255), (cx, cy), (cx + dx * c_len, cy), 2)
            pygame.draw.line(dest, (248, 242, 255), (cx, cy), (cx, cy + dy * c_len), 2)
            pts = [
                (cx + dx * 4, cy + dy * 1),
                (cx + dx * 7, cy + dy * 4),
                (cx + dx * 4, cy + dy * 7),
                (cx + dx * 1, cy + dy * 4),
            ]
            pygame.draw.polygon(dest, accent_crimson, pts)
            pygame.draw.polygon(dest, border_silver, pts, 1)


