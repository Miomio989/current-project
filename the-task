def _find_system_font(serif: bool = True, bold: bool = True, cjk: bool = False) -> Optional[str]:
    direct_paths: List[str] = []
    if serif:
        direct_paths = [
            "/usr/share/fonts/truetype/dejavu/DejaVuSerif-Bold.ttf" if bold else "/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf",
            "/usr/share/fonts/truetype/liberation/LiberationSerif-Bold.ttf" if bold else "/usr/share/fonts/truetype/liberation/LiberationSerif-Regular.ttf",
            "/usr/share/fonts/truetype/freefont/FreeSerifBold.ttf" if bold else "/usr/share/fonts/truetype/freefont/FreeSerif.ttf",
            "C:/Windows/Fonts/georgiab.ttf" if bold else "C:/Windows/Fonts/georgia.ttf",
            "C:/Windows/Fonts/timesbd.ttf" if bold else "C:/Windows/Fonts/times.ttf",
            "/System/Library/Fonts/Supplemental/Georgia Bold.ttf",
        ]
    else:
        direct_paths = [
            "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf" if bold else "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
            "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf" if bold else "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
            "/usr/share/fonts/truetype/freefont/FreeSansBold.ttf" if bold else "/usr/share/fonts/truetype/freefont/FreeSans.ttf",
            "C:/Windows/Fonts/segoeuib.ttf" if bold else "C:/Windows/Fonts/segoeui.ttf",
            "C:/Windows/Fonts/arialbd.ttf" if bold else "C:/Windows/Fonts/arial.ttf",
        ]
    for p in direct_paths:
        if os.path.exists(p):
            return p
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        names = ("georgia", "dejavuserif", "timesnewroman") if serif else ("segoeui", "dejavusans", "arial")
        for nm in names:
            try:
                matched = pygame.font.match_font(nm, bold=bold)
                if matched and os.path.exists(matched):
                    return matched
            except Exception:
                pass
    return None


class FontManager:
    """Crisp cached serif/gothic/display typography renderer with embossed drop-shadows."""

    def __init__(self) -> None:
        self._serif_b = _find_system_font(serif=True, bold=True)
        self._serif_r = _find_system_font(serif=True, bold=False)
        self._sans_b = _find_system_font(serif=False, bold=True)
        self._sans_r = _find_system_font(serif=False, bold=False)
        self._cache: Dict[Tuple[int, bool, bool, bool], pygame.font.Font] = {}

    def get(self, size: int, serif: bool = True, bold: bool = True, italic: bool = False) -> pygame.font.Font:
        key = (size, serif, bold, italic)
        f = self._cache.get(key)
        if f is not None:
            return f
        path = (self._serif_b if bold else self._serif_r) if serif else (self._sans_b if bold else self._sans_r)
        try:
            f = pygame.font.Font(path, size) if path else pygame.font.SysFont("serif" if serif else "sans", size, bold=bold, italic=italic)
        except Exception:
            f = pygame.font.Font(None, size)
        if italic:
            f.set_italic(True)
        self._cache[key] = f
        return f

    def draw_text(
        self,
        surf: pygame.Surface,
        text: str,
        pos: Pt2,
        size: int = 18,
        color: RGB = (250, 236, 206),
        shadow: Optional[RGB] = (14, 4, 8),
        outline: Optional[RGB] = None,
        serif: bool = True,
        bold: bool = True,
        italic: bool = False,
        align: str = "left",
        alpha: int = 255,
    ) -> pygame.Rect:
        f = self.get(size, serif=serif, bold=bold, italic=italic)
        txt_s = f.render(text, True, color)
        w, h = txt_s.get_size()
        x, y = int(pos[0]), int(pos[1])
        if align == "center":
            x -= w // 2
        elif align == "right":
            x -= w
        if alpha < 255:
            txt_s.set_alpha(alpha)
        if shadow is not None:
            sh_s = f.render(text, True, shadow)
            if alpha < 255:
                sh_s.set_alpha(int(alpha * 0.85))
            surf.blit(sh_s, (x + 2, y + 2))
        if outline is not None:
            ol_s = f.render(text, True, outline)
            if alpha < 255:
                ol_s.set_alpha(alpha)
            for ox, oy in ((-1, 0), (1, 0), (0, -1), (0, 1)):
                surf.blit(ol_s, (x + ox, y + oy))
        surf.blit(txt_s, (x, y))
        return pygame.Rect(x, y, w, h)


def render_japanese_calligraphy_logo(
    cg: StudioCGRasterizer,
    width: int = 440,
    height: int = 112,
) -> pygame.Surface:
    """
    Procedurally paints the original Japanese game title "呪いの刃" in expressive
    wet-ink sumi-e calligraphy strokes with crimson cursed glow & gold rim —
    guaranteed 100% consistent across all OS platforms even without CJK fonts!
    """
    ss = 2
    W, H = width * ss, height * ss
    surf = pygame.Surface((W, H), pygame.SRCALPHA)
    sx = W / 440.0
    sy = H / 112.0

    def stroke(pts: Sequence[Pt2], ws: Sequence[float]) -> None:
        s_pts = [(p[0] * sx, p[1] * sy) for p in pts]
        s_ws = [w * min(sx, sy) for w in ws]
        # Dense smooth curve sampling if >= 4 points or direct polyline
        if len(s_pts) == 4:
            curve = sample_cubic(s_pts[0], s_pts[1], s_pts[2], s_pts[3], 12)
            cws = [lerp(s_ws[0], s_ws[1], i / 12.0) if i < 6 else lerp(s_ws[1], s_ws[-1], (i - 6) / 6.0) for i in range(13)]
        elif len(s_pts) == 3:
            curve = sample_quad(s_pts[0], s_pts[1], s_pts[2], 10)
