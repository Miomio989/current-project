    def _render_keyframe_studio(self, target: pygame.Surface) -> None:
        st = self.all_states[self.state_idx]
        kfs = self.bank.get_frame_list(st)
        if self.playing:
            self.tick_accum += 1
            self.frame_idx = self.bank.get_frame_index_for_tick(st, self.tick_accum, loop=True)
        self.frame_idx = clamp_int(self.frame_idx, 0, len(kfs) - 1)
        kf = kfs[self.frame_idx]

        # Left scrolling state list
