        # Stock numeral & Ready status callout
        stock_x = (bar_x + bar_w + 18) if left_side else (bar_x - 18)
        stock_col = UI_GOLD_BRIGHT if stocks >= 2 else (UI_CRIMSON_GLOW if stocks >= 1 else UI_TEXT_MUTED)
        self.fonts.draw_text(
            target, f"{stocks}", (stock_x, base_y + 8), size=30,
            color=stock_col, outline_px=3, style="serif", bold=True, align="center",
        )
        status_txt = ""
        if stocks >= 2:
            status_txt = "CRIMSON JUDGMENT READY  [214214+Atk / C+S]"
        elif stocks >= 1:
            status_txt = "ECLIPSE REQUIEM READY  [236236+Atk / H+S]"
        else:
