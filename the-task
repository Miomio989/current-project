class OptionsScreen:
    """Interactive Audio, Video, Gore, Gameplay & Controls Options Screen."""

    def __init__(
        self,
        fonts: FontManager,
        stage: CursedCathedralStage,
        settings: GameSettings,
        audio: AudioManager,
    ) -> None:
        self.fonts = fonts
        self.stage = stage
        self.settings = settings
        self.audio = audio
        self.cursor: int = 0
        self.display_changed_flag: bool = False
        self.return_to_pause: bool = False

    def handle_key(self, key: int) -> Optional[str]:
        rows = 10
        if key in (pygame.K_UP, pygame.K_w):
            self.cursor = (self.cursor - 1) % rows
            self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)
        elif key in (pygame.K_DOWN, pygame.K_s):
            self.cursor = (self.cursor + 1) % rows
            self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)
        elif key in (pygame.K_LEFT, pygame.K_a, pygame.K_RIGHT, pygame.K_d, pygame.K_RETURN, pygame.K_SPACE):
            delta = -1 if key in (pygame.K_LEFT, pygame.K_a) else 1
            self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)
            s = self.settings
            if self.cursor == 0:
                s.master_volume = clamp(round(s.master_volume + delta * 0.05, 2), 0.0, 1.0)
                self.audio.apply_volumes()
            elif self.cursor == 1:
                s.bgm_volume = clamp(round(s.bgm_volume + delta * 0.05, 2), 0.0, 1.0)
                self.audio.apply_volumes()
            elif self.cursor == 2:
                s.sfx_volume = clamp(round(s.sfx_volume + delta * 0.05, 2), 0.0, 1.0)
                self.audio.play_sfx(SFXId.HIT_MEDIUM, vol_scale=0.9)
            elif self.cursor == 3:
                s.fullscreen = not s.fullscreen
                self.display_changed_flag = True
            elif self.cursor == 4:
                s.gore_explicit = not s.gore_explicit
            elif self.cursor == 5:
                s.particle_high = not s.particle_high
            elif self.cursor == 6:
                s.screen_shake = not s.screen_shake
            elif self.cursor == 7:
                s.simple_inputs_p1 = not s.simple_inputs_p1
            elif self.cursor == 8:
                s.simple_inputs_p2 = not s.simple_inputs_p2
            elif self.cursor == 9:
                s.show_fps = not s.show_fps
        elif key in (pygame.K_ESCAPE, pygame.K_BACKSPACE):
            self.audio.play_sfx(SFXId.UI_CANCEL, vol_scale=0.8)
            return "CLOSE"
        return None

    def render(self, target: pygame.Surface) -> None:
        self.stage.render_background(target, STAGE_CENTER_X, GROUND_Y - 190.0, 1.0)
        ov = pygame.Surface((SCREEN_W, SCREEN_H), pygame.SRCALPHA)
        ov.fill((10, 4, 12, 192))
        target.blit(ov, (0, 0))

        self.fonts.draw_text(target, "OPTIONS & SYSTEM CONFIGURATION", (HALF_W, 38), size=30, color=UI_GOLD_BRIGHT, outline_px=3, style="serif", bold=True, align="center")

        s = self.settings
        panel = pygame.Rect(68, 92, 654, 570)
