def compose_training_acid_trance(synth: ProceduralAudioSynth) -> Optional[pygame.mixer.Sound]:
    """Compose a hypnotic 138 BPM deep dark-acid breakbeat trance groove for Training Lab.

    Designed for sustained ecstatic flow-state combo practice without ear fatigue:
    tight sub-kick, crisp syncopated breakbeat rim/hat shuffle, bubbling 303 bassline
    in D Minor Pentatonic, and ethereal dark velvet chord stabs.
    """
    bpm = 138.0
    step_sec = 60.0 / bpm / 4.0
    total_steps = 64
    total_samples = int(round(total_steps * step_sec * synth.sr))
    buf_l = [0.0] * total_samples
    buf_r = [0.0] * total_samples

    # Syncopated liquid-dark breakbeat drum grid
    kick_steps = {0, 6, 10}
    snare_steps = {4, 12}
    ghost_steps = {7, 9, 15}
    for bar in range(4):
        for st in range(16):
            pos = int(round((bar * 16 + st) * step_sec * synth.sr))
            if st in kick_steps:
                synth._stamp(buf_l, buf_r, synth._kick_sub, pos, vol=0.82 if st == 0 else 0.64)
            if st in snare_steps:
                synth._stamp(buf_l, buf_r, synth._snare_break, pos, vol=0.62, pan=-0.08)
            elif st in ghost_steps:
                synth._stamp(buf_l, buf_r, synth._snare_ghost, pos, vol=0.34, pan=0.12)
            if st % 4 == 2:
                synth._stamp(buf_l, buf_r, synth._hat_open, pos, vol=0.32, pan=0.16)
            else:
                synth._stamp(buf_l, buf_r, synth._hat_closed, pos, vol=0.22 if st % 2 == 0 else 0.14, pan=-0.16)

    # Bubbling hypnotic 303 acid line in D Dorian/Minor
    bass_pat = [
        38, 0, 38, 50, 41, 0, 45, 38, 43, 0, 45, 38, 48, 45, 43, 41,
        38, 0, 50, 38, 45, 0, 43, 41, 36, 0, 43, 36, 45, 43, 41, 38,
    ] * 2
    chord_roots = [50, 53, 48, 45]
    inv_sr = 1.0 / float(synth.sr)
    lut = synth._sin_lut
    lut_n = synth._lut_n
    mask = synth._lut_mask

    lp1 = lp2 = fb = 0.0
    b_ph = sub_ph = p1 = p2 = p3 = 0.0
    for st in range(total_steps):
        s0 = int(round(st * step_sec * synth.sr))
        s1 = min(total_samples, int(round((st + 1) * step_sec * synth.sr)))
        note = bass_pat[st]
        b_freq = _midi_to_hz(note) if note > 0 else 0.0
        root = chord_roots[st // 16]
        pf1, pf2, pf3 = _midi_to_hz(root), _midi_to_hz(root + 3), _midi_to_hz(root + 7)
        lfo = 0.5 + 0.5 * math.sin((st / float(total_steps)) * _TWO_PI)
        seg = max(1, s1 - s0)
        for k in range(seg):
            idx = s0 + k
            u = k / float(seg)
            acid = 0.0
            if b_freq > 0.0:
                b_ph = (b_ph + b_freq * inv_sr) % 1.0
                sub_ph += (b_freq * 0.5) * inv_sr * lut_n
                saw = b_ph * 2.0 - 1.0
                env = math.exp(-u * 4.4)
                cut = clamp(0.10 + lfo * 0.22 + env * 0.28, 0.06, 0.78)
                lp1 += cut * ((saw - fb * 0.52) - lp1)
                lp2 += cut * (lp1 - lp2)
                fb = lp1 - lp2
                acid = _fast_tanh((lp2 * 1.9 + lut[int(sub_ph) & mask] * 0.38) * 1.35) * 0.36
            p1 += pf1 * inv_sr * lut_n
            p2 += pf2 * inv_sr * lut_n
            p3 += pf3 * inv_sr * lut_n
            pad = (lut[int(p1) & mask] * 0.45 + lut[int(p2) & mask] * 0.35 + lut[int(p3) & mask] * 0.30) * 0.09
            buf_l[idx] += acid + pad
            buf_r[idx] += acid + pad

    # Stereo dub-techno 3/16 ping-pong feedback wash
    delay_s = int(round(step_sec * 3.0 * synth.sr))
    for i in range(total_samples):
        src = (i - delay_s) % total_samples
        buf_l[i] = _fast_tanh((buf_l[i] + buf_r[src] * 0.22) * 0.90)
        buf_r[i] = _fast_tanh((buf_r[i] + buf_l[src] * 0.22) * 0.90)
    return synth._to_stereo_sound(buf_l, buf_r, gain=0.72)


def compose_sovereign_boss_ost(synth: ProceduralAudioSynth) -> Optional[pygame.mixer.Sound]:
    """Compose a blistering 154 BPM Apocalyptic Industrial Breakbeat + Cathedral Bell
    Final Boss Assault track for Stage 5: SOVEREIGN OF 呪いの刃!
    """
    bpm = 154.0
    step_sec = 60.0 / bpm / 4.0
    total_steps = 64
    total_samples = int(round(total_steps * step_sec * synth.sr))
    buf_l = [0.0] * total_samples
    buf_r = [0.0] * total_samples

    # Relentless double-time Gabber-tinted Techno Kick + Sliced Amen Snare barrage
    kick_steps = {0, 3, 4, 8, 10, 12, 14, 15}
    snare_steps = {4, 12}
    ghost_steps = {2, 6, 7, 9, 11, 13, 15}
    for bar in range(4):
        for st in range(16):
            pos = int(round((bar * 16 + st) * step_sec * synth.sr))
            if st in kick_steps:
                synth._stamp(buf_l, buf_r, synth._kick_hard, pos, vol=0.98 if st % 4 == 0 else 0.78)
            if st in snare_steps or (bar == 3 and st >= 12):
                synth._stamp(buf_l, buf_r, synth._snare_break, pos, vol=0.90, pan=-0.05)
                synth._stamp(buf_l, buf_r, synth._clap_ind, pos, vol=0.58, pan=0.08)
            elif st in ghost_steps:
                synth._stamp(buf_l, buf_r, synth._snare_ghost, pos, vol=0.46, pan=0.16 if st % 2 else -0.16)
            synth._stamp(buf_l, buf_r, synth._hat_open if st % 2 == 1 else synth._hat_closed, pos, vol=0.40, pan=-0.18 if st % 2 else 0.18)

    # Aggressive D Locrian / Phrygian Dominant screaming boss bass & arpeggio
    bass_pat = [
        38, 38, 50, 39, 38, 44, 45, 38, 38, 50, 46, 45, 44, 42, 39, 38,
        39, 39, 51, 39, 45, 44, 42, 39, 38, 50, 38, 51, 50, 46, 45, 44,
    ] * 2
    lead_pat = [
        74, 75, 74, 70, 69, 70, 69, 66, 62, 69, 74, 75, 77, 75, 74, 70,
        75, 74, 70, 69, 66, 69, 70, 74, 78, 77, 75, 74, 70, 69, 66, 63,
    ] * 2

    inv_sr = 1.0 / float(synth.sr)
    lut = synth._sin_lut
    lut_n = synth._lut_n
    mask = synth._lut_mask
    lp1 = lp2 = fb = 0.0
    b_ph = l1 = l2 = bell_p = 0.0
    bell_hz = _midi_to_hz(50)

    for st in range(total_steps):
        s0 = int(round(st * step_sec * synth.sr))
        s1 = min(total_samples, int(round((st + 1) * step_sec * synth.sr)))
        bf = _midi_to_hz(bass_pat[st])
        lf = _midi_to_hz(lead_pat[st])
        seg = max(1, s1 - s0)
        bar_step = st % 32
        for k in range(seg):
            idx = s0 + k
            u = k / float(seg)
            b_ph = (b_ph + bf * inv_sr) % 1.0
            saw = b_ph * 2.0 - 1.0
            cut = clamp(0.24 + math.exp(-u * 3.0) * 0.44, 0.12, 0.88)
            lp1 += cut * ((saw - fb * 0.62) - lp1)
            lp2 += cut * (lp1 - lp2)
            fb = lp1 - lp2
            acid = _fast_tanh(lp2 * 2.8) * 0.42

            l1 = (l1 + lf * inv_sr) % 1.0
            l2 = (l2 + lf * 1.009 * inv_sr) % 1.0
            l_env = math.exp(-u * 2.6)
            lead_v = ((l1 * 2.0 - 1.0) + (l2 * 2.0 - 1.0) * 0.9) * l_env * 0.18

            # Ominous cathedral bell toll striking every 2 bars!
            bell_t = (bar_step + u) * step_sec
            bell_p += bell_hz * inv_sr * lut_n
            bell = (lut[int(bell_p) & mask] + 0.5 * lut[int(bell_p * 2.41) & mask]) * math.exp(-bell_t * 1.8) * 0.24

            buf_l[idx] += acid + lead_v + bell
            buf_r[idx] += acid + lead_v * 0.92 + bell

    delay_s = int(round(step_sec * 3.0 * synth.sr))
    for i in range(total_samples):
        src = (i - delay_s) % total_samples
        buf_l[i] = _fast_tanh((buf_l[i] + buf_r[src] * 0.18) * 0.94)
        buf_r[i] = _fast_tanh((buf_r[i] + buf_l[src] * 0.18) * 0.94)
    return synth._to_stereo_sound(buf_l, buf_r, gain=0.82)


# Seamlessly attach the Training Trance & Boss Assault tracks to AudioManager!
_orig_audio_bake = AudioManager.step_bake


def _extended_audio_bake(self: AudioManager) -> float:
    prog = _orig_audio_bake(self)
    if self._bake_stage >= 5 and self.enabled and self.synth is not None:
        if "TRAINING_TRANCE" not in getattr(self, "_extra_bgm", {}):
            self._extra_bgm: Dict[str, Optional[pygame.mixer.Sound]] = {
                "TRAINING_TRANCE": compose_training_acid_trance(self.synth),
                "SOVEREIGN_BOSS": compose_sovereign_boss_ost(self.synth),
            }
    return prog


def _play_extra_bgm(self: AudioManager, key: str) -> None:
    if not self.enabled or self._bgm_channel is None:
        return
    extra = getattr(self, "_extra_bgm", {})
    snd = extra.get(key)
    if snd is not None:
        self.current_bgm = BGMId.BATTLE_ASSAULT_B if key == "SOVEREIGN_BOSS" else BGMId.BATTLE_ASSAULT_A
        self._bgm_channel.play(snd, loops=-1, fade_ms=260)
        self.apply_volumes()


AudioManager.step_bake = _extended_audio_bake  # type: ignore[method-assign]
AudioManager.play_extra_bgm = _play_extra_bgm  # type: ignore[attr-defined]

