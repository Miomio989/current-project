        sh = proj[f"{side}_shoulder"]
        el = proj[f"{side}_elbow"]
        wr = proj[f"{side}_wrist"]
        s = pscale[f"{side}_elbow"]

        # 1. Dramatic puffed black Juliet upper sleeve (shoulder -> mid-upper-arm)
        puff_end = sh.lerp_to(el, 0.62)
        self.rast.draw_shaded_capsule(
            surf,
            sh,
