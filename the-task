class CommandListScreen:
    def __init__(self, move_reg: Dict[FighterState, MoveSpec], fonts: FontManager) -> None:
        self.fonts = fonts
        self.moves: List[MoveSpec] = list(move_reg.values())
        self.cursor: int = 0
        self.scroll: int = 0

    def handle_key(self, key: int) -> bool:
        if key in (pygame.K_UP, pygame.K_w):
            self.cursor = (self.cursor - 1) % len(self.moves)
        elif key in (pygame.K_DOWN, pygame.K_s):
            self.cursor = (self.cursor + 1) % len(self.moves)
        elif key in (pygame.K_ESCAPE, pygame.K_BACKSPACE):
            return True
        if self.cursor < self.scroll:
            self.scroll = self.cursor
        elif self.cursor >= self.scroll + 11:
            self.scroll = self.cursor - 10
        return False

    def render(self, dest: pygame.Surface, stage: CursedCathedralStage, bank: SpriteBank, t: float) -> None:
        stage.render_background(dest, STAGE_CENTER_X, 0.0)
        veil = pygame.Surface((INTERNAL_W, INTERNAL_H), pygame.SRCALPHA)
        veil.fill((12, 4, 18, 206))
        dest.blit(veil, (0, 0))

        self.fonts.draw_text(dest, "COMMAND LIST & FRAME DATA CODEX", 400, 18, size=22, color=(255, 228, 168), style="serif", bold=True, align="center")
        list_rect = pygame.Rect(24, 58, 434, 488)
        detail_rect = pygame.Rect(472, 58, 304, 488)
        draw_gothic_filigree_panel(dest, list_rect, bg_alpha=215)
        draw_gothic_filigree_panel(dest, detail_rect, bg_alpha=215)

        vis = self.moves[self.scroll : self.scroll + 11]
        for idx, mv in enumerate(vis):
            real_i = self.scroll + idx
            ry = 74 + idx * 41
            sel = (real_i == self.cursor)
            if sel:
                pygame.draw.rect(dest, (132, 18, 52), (34, ry - 2, 414, 36))
                pygame.draw.rect(dest, (255, 204, 118), (34, ry - 2, 414, 36), 1)
            cat_c = (255, 212, 92) if mv.category in ("SUPER", "FATAL") else ((255, 112, 168) if mv.category == "SPECIAL" else (188, 218, 248))
            self.fonts.draw_text(dest, f"[{mv.category[:4]}]", 42, ry + 8, size=10, color=cat_c, style="mono", bold=True)
            self.fonts.draw_text(dest, mv.display_name, 96, ry + 4, size=13, color=(255, 246, 248) if sel else (218, 202, 216), style="serif", bold=sel)
            self.fonts.draw_text(dest, mv.command_notation, 438, ry + 8, size=11, color=(255, 214, 134), style="mono", bold=True, align="right")

        # Live animated keyframe preview of selected move on right panel!
        cur = self.moves[self.cursor]
        frames = bank.get_keyframes(cur.state)
        fi = int(t * 10.0) % len(frames)
        spr = bank.get_sprite("CRIMSON_ORIGINAL", cur.state, fi, facing_right=True, eclipse_mode=(cur.category == "FATAL"))
        dest.blit(spr, (612 - SPRITE_ANCHOR_X, 310 - SPRITE_ANCHOR_Y))

        self.fonts.draw_text(dest, cur.display_name, 624, 76, size=16, color=(255, 228, 168), style="serif", bold=True, align="center")
        self.fonts.draw_text(dest, cur.command_notation, 624, 98, size=13, color=(255, 118, 168), style="mono", bold=True, align="center")

        y = 336
        dmg = sum(hw.damage for hw in cur.hit_windows)
        self.fonts.draw_text(dest, f"DAMAGE   : {dmg}   CURSE COST: {cur.curse_cost}", 488, y, size=11, color=(244, 232, 240), style="mono")
        self.fonts.draw_text(dest, f"STARTUP  : {cur.startup}f  ACTIVE: {cur.active}f  REC: {cur.recovery}f", 488, y + 20, size=11, color=(156, 218, 255), style="mono")
        self.fonts.draw_text(dest, f"ON-HIT   : {cur.on_hit_adv_label}   ON-BLOCK: {cur.on_block_adv_label}", 488, y + 40, size=11, color=(255, 214, 118), style="mono")
        self.fonts.draw_text(dest, f"KEYFRAMES: {len(frames)} Hand-Authored Cels", 488, y + 60, size=11, color=(216, 178, 232), style="mono")

        # Wrap description cleanly
        words = cur.description.split(" ")
        line = ""
        dy = y + 90
        for w in words:
            cand = (line + " " + w).strip()
            if len(cand) > 35:
                self.fonts.draw_text(dest, line, 488, dy, size=12, color=(232, 216, 228), style="sans")
                dy += 18
                line = w
            else:
                line = cand
        if line:
            self.fonts.draw_text(dest, line, 488, dy, size=12, color=(232, 216, 228), style="sans")

        self.fonts.draw_text(dest, "[UP/DN] Browse Moves   [ESC] Return", 400, 566, size=12, color=(212, 188, 206), style="mono", align="center")


