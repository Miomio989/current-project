    def _sync_caption(self) -> None:
        if not self.viewer.path:
            self.caption.setText("\u2014")
            return
        meta = self.viewer.meta
        bits = [os.path.basename(self.viewer.path)]
        if meta.get("width") and meta.get("height"):
            bits.append(f"{meta['width']}\u00d7{meta['height']}")
        if meta.get("model"):
            bits.append(str(meta["model"]))
        if meta.get("seed") is not None:
            bits.append(f"seed {meta['seed']}")
        if isinstance(meta.get("aesthetic"), (int, float)):
            bits.append(f"\u2605{float(meta['aesthetic']):.2f}")
        if meta.get("favorite"):
            bits.append("\u2605")
        self.caption.setText("  \u2022  ".join(str(b) for b in bits))

