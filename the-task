    def _apply_video_mode(self) -> pygame.Surface:
        if self.headless:
            return pygame.display.set_mode((RENDER_W, RENDER_H))
        if self.settings.fullscreen:
            return pygame.display.set_mode((0, 0), pygame.FULLSCREEN)
        w = int(RENDER_W * self.settings.display_scale)
        h = int(RENDER_H * self.settings.display_scale)
        return pygame.display.set_mode((w, h), pygame.RESIZABLE)

    def _present_crisp_800x600(self) -> None:
        """
        Locked 800x600 rendering stretched with crisp nearest-neighbor pixelization
        (pygame.transform.scale — strictly NO blurry anti-aliasing!).
        """
        win_w, win_h = self.window.get_size()
        if win_w == RENDER_W and win_h == RENDER_H:
            self.window.blit(self.canvas, (0, 0))
        else:
            scale = min(win_w / float(RENDER_W), win_h / float(RENDER_H))
            dw = max(1, int(RENDER_W * scale))
            dh = max(1, int(RENDER_H * scale))
            ox = (win_w - dw) // 2
            oy = (win_h - dh) // 2
            self.window.fill((0, 0, 0))
            stretched = pygame.transform.scale(self.canvas, (dw, dh))
            self.window.blit(stretched, (ox, oy))
        pygame.display.flip()

    def run(self) -> int:
        while self.running:
            dt = self.clock.tick(TARGET_FPS) / 1000.0
            self.ui_time += dt
            self.match.current_fps = max(1.0, self.clock.get_fps())
            self.audio.update()

            for ev in pygame.event.get():
                if ev.type == pygame.QUIT:
                    self.running = False
                elif ev.type == pygame.VIDEORESIZE and not self.settings.fullscreen:
                    self.window = pygame.display.set_mode((max(400, ev.w), max(300, ev.h)), pygame.RESIZABLE)
                elif ev.type == pygame.KEYDOWN:
                    self._handle_keydown(ev.key)

            self._update_screen(dt)
            self._render_screen()
            self._present_crisp_800x600()

        self.audio.shutdown()
        pygame.quit()
        return 0

    def _handle_keydown(self, key: int) -> None:
        if self.screen == ScreenState.KEY_CONFIG and self.keycfg_listening:
            if key != pygame.K_ESCAPE:
                attrs = ("up", "down", "left", "right", "btn_a", "btn_b", "btn_c", "btn_d", "btn_throw", "btn_shadow", "btn_burst")
                setattr(self.inp_mgr.p1_bind, attrs[self.keycfg_cursor], key)
                self.audio.play_sfx(SFXId.UI_CONFIRM)
            self.keycfg_listening = False
            return

        if self.screen == ScreenState.TITLE:
            if key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_u, pygame.K_j):
                self.audio.play_sfx(SFXId.FIGHT_GONG)
                self.audio.play_ost(OSTTrackId.SANCTUM_OF_ASH)
                self.screen = ScreenState.MAIN_MENU
            elif key == pygame.K_ESCAPE:
                self.running = False

        elif self.screen == ScreenState.MAIN_MENU:
            if key in (pygame.K_UP, pygame.K_w):
                self.menu_cursor = (self.menu_cursor - 1) % len(self.main_menu_items)
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_DOWN, pygame.K_s):
                self.menu_cursor = (self.menu_cursor + 1) % len(self.main_menu_items)
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key == pygame.K_ESCAPE:
                self.audio.play_sfx(SFXId.UI_BACK)
                self.screen = ScreenState.TITLE
            elif key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_u):
                self.audio.play_sfx(SFXId.UI_CONFIRM)
                self._activate_main_menu()

        elif self.screen == ScreenState.CHAR_SELECT:
            n_pals = len(CECILIA_PALETTES)
            if key in (pygame.K_LEFT, pygame.K_a):
                self.p1_pal_idx = (self.p1_pal_idx - 1) % n_pals
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_RIGHT, pygame.K_d):
                self.p1_pal_idx = (self.p1_pal_idx + 1) % n_pals
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_q,):
                self.p2_pal_idx = (self.p2_pal_idx - 1) % n_pals
                self.audio.play_sfx(SFXId.UI_TAB)
            elif key in (pygame.K_e,):
                self.p2_pal_idx = (self.p2_pal_idx + 1) % n_pals
                self.audio.play_sfx(SFXId.UI_TAB)
            elif key == pygame.K_ESCAPE:
                self.audio.play_sfx(SFXId.UI_BACK)
                self.screen = ScreenState.MAIN_MENU
            elif key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_u):
                self.audio.play_sfx(SFXId.BLADE_DRAW)
                if self.sel_mode in (GameMode.TRAINING, GameMode.COMBO_TRIALS):
                    self.match.start_match(self.sel_mode, self.p1_pal_idx, self.p2_pal_idx, 0, self.match.active_trial_idx)
                    self.screen = ScreenState.BATTLE
                else:
                    self.match.survival_wave = 1
                    self.match.score = 0
                    self.match.start_match(self.sel_mode, self.p1_pal_idx, self.p2_pal_idx, 0)
                    self.vs_timer = 2.0
                    self.screen = ScreenState.VS_SPLASH

        elif self.screen == ScreenState.VS_SPLASH:
            if key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_ESCAPE):
                self.vs_timer = 0.0
                self.screen = ScreenState.BATTLE

        elif self.screen == ScreenState.BATTLE:
            if key == pygame.K_ESCAPE:
                self.pause_cursor = 0
                self.audio.play_sfx(SFXId.UI_TAB)
                self.screen = ScreenState.PAUSE
            elif self.match.mode == GameMode.TRAINING:
                if key == pygame.K_F1:
                    self.match.reset_training_positions()
                    self.audio.play_sfx(SFXId.UI_TAB)
                elif key == pygame.K_F2:
                    modes = list(DummyBehavior)
                    i = (modes.index(self.match.training_cfg.dummy_mode) + 1) % len(modes)
                    self.match.training_cfg.dummy_mode = modes[i]
