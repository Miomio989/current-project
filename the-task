                v_add(v_add(guard_c, v_mul(u_dir, g_thick * 0.55)), v_mul(nrm, sgn * gw * 0.68)),
                v_add(v_add(guard_c, v_mul(u_dir, g_thick * 2.15)), v_mul(nrm, sgn * gw * 0.44)),
                v_add(guard_c, v_mul(u_dir, g_thick * 1.2)),
