    def _draw_mossy_column(
        self,
        surf: pygame.Surface,
        bx: float,
        by: float,
        height: float,
        width: float,
        tilt_deg: float,
        seed: int,
    ) -> None:
        """
        Painterly leaning fluted Romanesque/Corinthian stone column draped in
        creeping moss & vines — signature landmark from graphics-mockup.jpg!
        """
        rng = random.Random(seed)
        ang = math.radians(tilt_deg)
        up = (math.sin(ang), -math.cos(ang))
        right = (math.cos(ang), math.sin(ang))
        hw = width * 0.5

        p_bl = (bx - right[0] * hw * 1.15, by - right[1] * hw * 1.15)
        p_br = (bx + right[0] * hw * 1.15, by + right[1] * hw * 1.15)
        top_c = (bx + up[0] * height, by + up[1] * height)
        p_tl = (top_c[0] - right[0] * hw * 0.92, top_c[1] - right[1] * hw * 0.92)
        p_tr = (top_c[0] + right[0] * hw * 0.92, top_c[1] + right[1] * hw * 0.92)

        # Jagged broken stone top or ornate Corinthian capital
        shaft = [p_bl, p_br, p_tr, (top_c[0] + up[0] * 10, top_c[1] + up[1] * 10), p_tl]
        self.cg.fill_shaded_poly(
            surf, shaft,
            [(22, 18, 22), (62, 50, 44), (118, 94, 68), (168, 126, 82)],
            light_dir=(-0.6, -0.8),
            rim_color=(228, 114, 64), rim_width=2.0,
            ink_color=(14, 10, 14), ink_width=1.6,
        )
        # Fluted vertical stone grooves!
        for f in (-0.62, -0.32, 0.0, 0.32, 0.62):
            f_bot = (bx + right[0] * hw * f, by + right[1] * hw * f)
            f_top = (top_c[0] + right[0] * hw * 0.88 * f, top_c[1] + right[1] * hw * 0.88 * f)
            pygame.draw.line(surf, (24, 18, 20, 175), f_bot, f_top, 2)
            pygame.draw.line(surf, (152, 122, 86, 130), (f_bot[0] + 2, f_bot[1]), (f_top[0] + 2, f_top[1]), 1)

        # Crumbled Corinthian capital crown!
        cap_w = hw * 1.48
        cap_poly = [
            (top_c[0] - right[0] * hw, top_c[1] - right[1] * hw),
            (top_c[0] + right[0] * hw, top_c[1] + right[1] * hw),
            (top_c[0] + right[0] * cap_w + up[0] * 18, top_c[1] + right[1] * cap_w + up[1] * 18),
            (top_c[0] + up[0] * 24, top_c[1] + up[1] * 24),
            (top_c[0] - right[0] * cap_w + up[0] * 18, top_c[1] - right[1] * cap_w + up[1] * 18),
        ]
        self.cg.fill_shaded_poly(
            surf, cap_poly,
            [(26, 22, 22), (76, 66, 46), (146, 118, 72)],
            light_dir=(-0.5, -0.85), ink_color=(14, 10, 12), ink_width=1.5,
        )

        # Creeping olive-green moss & hanging vine ribbons wrapping column!
        for k in range(18):
            t = rng.uniform(0.10, 1.04)
            cx = bx + up[0] * (height * t) + right[0] * rng.uniform(-hw * 1.0, hw * 1.0)
            cy = by + up[1] * (height * t) + right[1] * rng.uniform(-hw * 1.0, hw * 1.0)
            rad = rng.uniform(4.5, 11.0)
            mc = lerp_rgb((36, 52, 24), (96, 118, 48), rng.uniform(0.0, 1.0))
            pygame.draw.circle(surf, (mc[0], mc[1], mc[2], 215), (int(cx), int(cy)), int(rad))

    def _draw_gnarled_tree(
        self, surf: pygame.Surface, bx: float, by: float, h: float, lean: float, seed: int
    ) -> None:
        rng = random.Random(seed)
        trunk_col = (24, 14, 18)
        rim_col = (128, 42, 36)

        def branch(p0: Pt2, length: float, angle: float, thick: float, depth: int) -> None:
            if depth <= 0 or length < 10:
                return
            mid = (
                p0[0] + math.cos(angle) * length * 0.5 + rng.uniform(-8, 8),
                p0[1] + math.sin(angle) * length * 0.5 + rng.uniform(-6, 6),
            )
            p1 = (p0[0] + math.cos(angle) * length, p0[1] + math.sin(angle) * length)
            pts = sample_quad(p0, mid, p1, 6)
            ws = [lerp(thick, thick * 0.56, i / 6.0) for i in range(7)]
            poly = build_tapered_ribbon_poly(pts, ws)
            pygame.draw.polygon(surf, trunk_col, poly)
            pygame.draw.aalines(surf, rim_col, False, pts[:4])
            # Hanging eerie Spanish moss strands
            if depth <= 2 and rng.random() < 0.72:
                m_len = rng.uniform(16, 44)
                pygame.draw.line(surf, (46, 56, 28, 175), mid, (mid[0] + rng.uniform(-3, 3), mid[1] + m_len), 2)
            # Split into 2 gnarled sub-branches
            branch(p1, length * rng.uniform(0.62, 0.76), angle - rng.uniform(0.28, 0.58), thick * 0.62, depth - 1)
            branch(p1, length * rng.uniform(0.58, 0.74), angle + rng.uniform(0.24, 0.56), thick * 0.58, depth - 1)

        branch((bx, by), h * 0.42, -math.pi * 0.5 + lean, h * 0.068, 4)

