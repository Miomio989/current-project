class GalleryThumbLoader(QThread):
    """Decodes gallery thumbnails off the GUI thread. ask() queues work tagged
    with the current page generation; reset() invalidates everything in flight
    so a page change never paints stale images into the new page."""
    thumb_ready = pyqtSignal(int, str, QImage)

    def __init__(self, parent: Optional[QObject] = None):
        super().__init__(parent)
        self._jobs: "_pyqueue.Queue[Tuple[int, str, QSize]]" = _pyqueue.Queue()
        self._gen = 0
        self._stop = False

    def current_gen(self) -> int:
        return self._gen

    def ask(self, path: str, size: QSize) -> None:
        self._jobs.put((self._gen, path, QSize(size)))

    def reset(self) -> None:
        self._gen += 1
        try:
            while True:
                self._jobs.get_nowait()
        except _pyqueue.Empty:
            pass

    def stop(self) -> None:
        self._stop = True

    def run(self) -> None:
        while not self._stop:
            try:
                rid, path, size = self._jobs.get(timeout=0.15)
            except _pyqueue.Empty:
                continue
            if rid != self._gen:
                continue                       # page changed under us
            try:
                reader = QImageReader(path)
                reader.setAutoTransform(True)
                sz = reader.size()
                if not sz.isValid() or sz.isEmpty():
                    continue
                reader.setScaledSize(sz.scaled(size, Qt.AspectRatioMode.KeepAspectRatio))
                img = reader.read()
                if not img.isNull():
                    self.thumb_ready.emit(rid, path, img)
            except Exception:  # noqa: BLE001 - a bad file must not kill the thread
                continue


class GalleryTileDelegate(QStyledItemDelegate):
    """ACDSee-style tile: bevelled frame, letterboxed thumbnail, two-line
    caption (file name + date / score), the model chip (KREA / ANIMA) and the
    aesthetic star over the image, an accent selection ring plus a check
    square so multi-select states stay readable. v1.8.0: three tile sizes
    (S / M / L) chosen by the gallery toolbar."""
    ROLE_PIX = Qt.ItemDataRole.UserRole + 2
    ROLE_META = Qt.ItemDataRole.UserRole + 1
    SIZES = {   # key -> (tile w, tile h, image w, image h)
        "S": (150, 150, 136, 88),
        "M": (178, 176, 164, 110),
        "L": (212, 208, 198, 136),
    }

    def __init__(self, size_key: str = "M", parent: Optional[QObject] = None):
        super().__init__(parent)
        self.size_key = "M" if size_key not in self.SIZES else size_key

    def set_size_key(self, key: str) -> None:
        self.size_key = key if key in self.SIZES else "M"

    def img_size(self) -> Tuple[int, int]:
        _w, _h, iw, ih = self.SIZES[self.size_key]
        return iw, ih

    def paint(self, p: QPainter, opt: QStyleOptionViewItem, index: QModelIndex) -> None:
        p.save()
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(opt.rect).adjusted(2, 2, -2, -2)
        selected = bool(opt.state & QStyle.StateFlag.State_Selected)
        hover = bool(opt.state & QStyle.StateFlag.State_MouseOver)
        # bevelled frame
        g = QLinearGradient(0, r.top(), 0, r.bottom())
        g.setColorAt(0, QColor(PAL["gtile_hi"])); g.setColorAt(1, QColor(PAL["gtile_lo"]))
        p.setPen(QPen(QColor(PAL["acc"]) if selected else (QColor(PAL["acc_lo"]) if hover else QColor(PAL["gtile_inner"])),
                      2 if selected else 1))
        p.setBrush(QBrush(g))
        p.drawRoundedRect(r, 5, 5)
        img_w, img_h = self.img_size()
        inner = QRectF(r.left() + 7, r.top() + 7, img_w, img_h)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(PAL["gtile_inner"]))
        p.drawRoundedRect(inner, 3, 3)
        pix = index.data(self.ROLE_PIX)
        if isinstance(pix, QPixmap) and not pix.isNull():
            scaled = pix.scaled(inner.size().toSize(), Qt.AspectRatioMode.KeepAspectRatio,
                                Qt.TransformationMode.SmoothTransformation)
            p.drawPixmap(int(inner.left() + (inner.width() - scaled.width()) / 2),
                         int(inner.top() + (inner.height() - scaled.height()) / 2), scaled)
        else:
            p.setPen(QColor(PAL["dim"]))
            p.setFont(_font(10, True))
            p.drawText(inner, Qt.AlignmentFlag.AlignCenter, "\u2026")
        meta = index.data(self.ROLE_META) or {}
        # caption: file name + info line
        name = os.path.basename(str(index.data(Qt.ItemDataRole.UserRole) or ""))
        cap_top = inner.bottom() + 3
        p.setFont(_font(8.5, True))
        p.setPen(QColor(0, 0, 0, 130))
        p.drawText(QRectF(r.left() + 8, cap_top + 1, r.width() - 16, 13),
                   Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft, elide(name, 30))
        p.setPen(QColor(PAL["sh_title"]) if selected else QColor(PAL["muted"]))
        p.drawText(QRectF(r.left() + 7, cap_top, r.width() - 16, 13),
                   Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft, elide(name, 30))
        infos: List[str] = []
        if meta.get("saved_at") or meta.get("created_at"):
            try:
                infos.append(time.strftime("%y-%m-%d %H:%M",
                                           time.localtime(float(meta.get("saved_at") or meta.get("created_at")))))
            except (TypeError, ValueError):
                pass
        if isinstance(meta.get("aesthetic"), (int, float)):
            infos.append(f"\u2605 {float(meta['aesthetic']):.1f}")
        if meta.get("censored"):
            infos.append("CENSORED")
        p.setFont(_font(8))
        p.setPen(QColor(0, 0, 0, 110))
        p.drawText(QRectF(r.left() + 8, cap_top + 15, r.width() - 16, 12),
                   Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft, "  \u2022  ".join(infos))
        info_col = PAL["badge_star"] if (infos and infos[-1].startswith("\u2605")) else PAL["dim"]
        if meta.get("censored"):
            info_col = PAL["err"]
        p.setPen(QColor(info_col))
        p.drawText(QRectF(r.left() + 7, cap_top + 14, r.width() - 16, 12),
                   Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft, "  \u2022  ".join(infos))
        # model chip (Anima / Krea) over the image, top right
        badge = model_short(str(meta.get("model", "")))
        if badge:
            p.setFont(_font(7.5, True))
            fm = QFontMetrics(p.font())
            bw = fm.horizontalAdvance(badge) + 10
            br = QRectF(inner.right() - bw - 5, inner.top() + 5, bw, 15)
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QColor(0, 0, 0, 175))
            p.drawRoundedRect(br, 3, 3)
            tint = PAL.get("tint_krea" if badge == "KREA" else "tint_anima", PAL["acc_hi"])
            p.setPen(QColor(tint))
            p.drawText(br, Qt.AlignmentFlag.AlignCenter, badge)
        # aesthetic star badge, bottom right (kept in sync with the strip)
        if isinstance(meta.get("aesthetic"), (int, float)):
            txt = f"\u2605 {float(meta['aesthetic']):.1f}"
            p.setFont(_font(7.5, True))
            fm = QFontMetrics(p.font())
            aw = fm.horizontalAdvance(txt) + 10
            ar_ = QRectF(inner.right() - aw - 5, inner.bottom() - 20, aw, 15)
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QColor(0, 0, 0, 185))
            p.drawRoundedRect(ar_, 3, 3)
            p.setPen(QColor(PAL["badge_star"]))
            p.drawText(ar_, Qt.AlignmentFlag.AlignCenter, txt)
        if selected:
            sel_glow = QColor(GOLD["edge"])
            sel_glow.setAlpha(130)
            p.setPen(QPen(sel_glow, 1))
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.drawRoundedRect(r.adjusted(-1, -1, 1, 1), 6, 6)
            chk = QRectF(inner.left() + 5, inner.top() + 5, 16, 16)
            p.setPen(QPen(QColor(PAL["acc_dk"]), 1))
            p.setBrush(QColor(PAL["acc"]))
            p.drawRoundedRect(chk, 3, 3)
            p.setPen(QColor(PAL["acc_txt"]))
            p.setFont(_font(9, True))
            p.drawText(chk, Qt.AlignmentFlag.AlignCenter, "\u2713")
        p.restore()

    def sizeHint(self, opt: QStyleOptionViewItem, index: QModelIndex) -> QSize:  # noqa: N802
        w, h, _iw, _ih = self.SIZES[self.size_key]
        return QSize(w, h)


