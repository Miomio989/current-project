    def _apply_portrait_medallion_frame(
        self,
        surf: "pygame.Surface",
        gold: Tuple[int, int, int],
        crimson: Tuple[int, int, int],
    ) -> None:
        """Clips portrait inside circle and renders ornate flame-aureole gold halo ring border."""
        w, h = surf.get_size()
        cx, cy = w // 2, h // 2
        # Circular alpha clip mask
        mask = pygame.Surface((w, h), pygame.SRCALPHA)
        pygame.draw.circle(mask, (255, 255, 255, 255), (cx, cy), 100)
        surf.blit(mask, (0, 0), special_flags=pygame.BLEND_RGBA_MIN)

        # Ornate gold & crimson flame-halo border
        pygame.draw.circle(surf, (*crimson, 230), (cx, cy), 108, 6)
        pygame.draw.circle(surf, (*gold, 255), (cx, cy), 104, 4)
        pygame.draw.circle(surf, (255, 240, 164, 240), (cx, cy), 99, 2)
        for i in range(16):
            ang = i * (math.tau / 16.0)
            r0 = 104
            r1 = 122 if i % 2 == 0 else 114
            p0 = (cx + int(math.cos(ang - 0.10) * r0), cy + int(math.sin(ang - 0.10) * r0))
            p1 = (cx + int(math.cos(ang) * r1), cy + int(math.sin(ang) * r1))
            p2 = (cx + int(math.cos(ang + 0.10) * r0), cy + int(math.sin(ang + 0.10) * r0))
            pygame.draw.polygon(surf, (*gold, 245), (p0, p1, p2))
            pygame.draw.polygon(surf, (*crimson, 210), (p0, p1, p2), 1)

    def _build_material_textures(self) -> None:
        """Generates 256px procedural textures for temple flagstones, stained moon-window, and Fester glyph strip."""
        # 1. Cracked Temple Flagstone Texture (Voronoi cracks + mossy fBm)
        sz = 128
        stone = pygame.Surface((sz, sz))
        px = pygame.PixelArray(stone)
        for y in range(sz):
            for x in range(sz):
                n = self.noise.fbm(x * 0.08, y * 0.08, 3)
                crack = self.noise.worley_edge(x * 0.075, y * 0.075)
                base = lerp_color((36, 26, 30), (74, 52, 54), n)
                col = lerp_color(base, (12, 8, 12), crack * 0.85)
                px[x, y] = (col[0] << 16) | (col[1] << 8) | col[2]
        del px
        self.surfaces["tex_flagstone"] = stone

        # 2. Glowing Crimson Stained-Glass Moon-Window Texture
        mw = pygame.Surface((256, 256), pygame.SRCALPHA)
        cx = cy = 128
        for r, col in ((120, (130, 12, 18, 230)), (106, (215, 22, 24, 245)), (76, (255, 58, 32, 250)), (38, (255, 138, 62, 255))):
