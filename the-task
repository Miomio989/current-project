def _midi_hz(note: float) -> float:
    return 440.0 * (2.0 ** ((note - 69.0) / 12.0))


def _soft_sat(x: float) -> float:
    """Smooth analog tube-saturation curve (zero harsh hard-clipping)."""
    if x > 2.4:
        return 0.96
    if x < -2.4:
        return -0.96
    return x / (1.0 + 0.28 * x * x)


