def draw_baroque_filigree_rect(
    surf: pygame.Surface,
    rect: pygame.Rect,
    fill_top: RGBA = (18, 8, 16, 224),
    fill_bot: RGBA = (8, 3, 10, 236),
    gold_hi: RGB = (252, 228, 148),
    gold_mid: RGB = (196, 146, 56),
    gold_sh: RGB = (92, 56, 18),
    crimson_accent: RGB = (186, 22, 42),
) -> None:
    """Soulcalibur / DMC4 / graphics-mockup.jpg baroque antique-gold beveled frame."""
    x, y, w, h = rect
    panel = pygame.Surface((w, h), pygame.SRCALPHA)
    # Vertical velvet gradient backing
    for row in range(0, h, 2):
        t = row / float(max(1, h))
        c = (
            int(lerp(fill_top[0], fill_bot[0], t)),
            int(lerp(fill_top[1], fill_bot[1], t)),
            int(lerp(fill_top[2], fill_bot[2], t)),
            int(lerp(fill_top[3], fill_bot[3], t)),
        )
        pygame.draw.rect(panel, c, (0, row, w, 2))
    surf.blit(panel, (x, y))

    # Multi-layer beveled gold border + crimson inset line
    pygame.draw.rect(surf, gold_sh, (x - 1, y - 1, w + 2, h + 2), 2)
    pygame.draw.rect(surf, gold_mid, (x, y, w, h), 2)
    pygame.draw.rect(surf, gold_hi, (x + 1, y + 1, w - 2, h - 2), 1)
    if w > 18 and h > 16:
        pygame.draw.rect(surf, crimson_accent, (x + 4, y + 4, w - 8, h - 8), 1)

    # Ornate baroque corner spearhead finials & scroll flourishes!
    cs = min(12, w // 4, h // 4)
    for cx, cy, dx, dy in (
        (x, y, 1, 1),
        (x + w, y, -1, 1),
        (x, y + h, 1, -1),
        (x + w, y + h, -1, -1),
    ):
        pts = [
            (cx - dx * 3, cy - dy * 3),
            (cx + dx * cs, cy),
            (cx + dx * (cs * 0.45), cy + dy * (cs * 0.45)),
            (cx, cy + dy * cs),
        ]
        pygame.draw.polygon(surf, gold_mid, pts)
        pygame.draw.aalines(surf, gold_hi, True, pts)
        pygame.draw.circle(surf, crimson_accent, (int(cx + dx * 3), int(cy + dy * 3)), 2)


