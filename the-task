        for i in range(n):
            t = i * inv_sr
            # Time-dilation sub-drop + crystalline sword ring
            f = 38.0 + 180.0 * math.exp(-t * 10.0)
            ph += f * inv_sr * _TWO_PI
            drop = math.sin(ph) * math.exp(-t * 4.5) * 0.85
            bell = (math.sin(t * 2420.0 * _TWO_PI) + 0.6 * math.sin(t * 3630.0 * _TWO_PI)) * math.exp(-t * 8.0) * 0.52
            out[i] = _fast_tanh((drop + bell) * 1.7) * 0.88
