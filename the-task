@dataclass
class ReplayFrame:
    p1_dx: int
    p1_dy: int
    p1_btn: int
    p2_dx: int
    p2_dy: int
    p2_btn: int


class MatchReplayBuffer:
    """Deterministic per-round input stream recorder & instant replay player."""

    def __init__(self) -> None:
        self.frames: List[ReplayFrame] = []
        self.playing: bool = False
        self.play_cursor: int = 0
        self.recorded_p1_pal: int = 0
        self.recorded_p2_pal: int = 1
        self.recorded_p2_name: str = ""

    def start_recording(self, p1_pal: int, p2_pal: int, p2_name: str) -> None:
        self.frames.clear()
        self.playing = False
        self.play_cursor = 0
        self.recorded_p1_pal = p1_pal
        self.recorded_p2_pal = p2_pal
        self.recorded_p2_name = p2_name

    def record(
        self, p1_dx: int, p1_dy: int, p1_btn: InputButton, p2_dx: int, p2_dy: int, p2_btn: InputButton
    ) -> None:
        if len(self.frames) < 12000:
            self.frames.append(ReplayFrame(p1_dx, p1_dy, int(p1_btn), p2_dx, p2_dy, int(p2_btn)))

    def has_replay(self) -> bool:
        return len(self.frames) > 20

    def start_playback(self) -> bool:
        if not self.has_replay():
            return False
        self.playing = True
        self.play_cursor = 0
        return True

    def stop_playback(self) -> None:
        self.playing = False
        self.play_cursor = 0

    def next_frame(self) -> Optional[ReplayFrame]:
        if not self.playing or self.play_cursor >= len(self.frames):
            return None
        fr = self.frames[self.play_cursor]
        self.play_cursor += 1
        return fr


class MatchDirector:
    """Orchestrates live battles across Arcade, Versus CPU, Versus 2P,
    Survival Gauntlet, Training Lab, and Instant Replay Playback.
    """

    def __init__(
        self,
        settings: GameSettings,
        training_cfg: TrainingSettings,
        fonts: FontManager,
        bank: SpriteBank,
        stage: CursedCathedralStage,
        audio: AudioManager,
        inputs: InputManager,
        rast: PainterlyRasterizer,
    ) -> None:
        self.settings = settings
        self.training_cfg = training_cfg
        self.fonts = fonts
        self.bank = bank
        self.stage = stage
        self.audio = audio
        self.inputs = inputs

        self.cam = CameraDirector()
        self.vfx = VFXManager(settings, rast)
        self.combat = CombatResolver(settings, self.vfx, self.cam, audio, stage)
        self.hud = BattleHUDRenderer(fonts, bank)
        self.training_lab = TrainingLabOverlay(fonts)
        self.dummy_ctrl = TrainingDummyController()
        self.replay = MatchReplayBuffer()

        # Active match state
        self.mode: GameMode = GameMode.VERSUS_CPU
        self.phase: RoundPhase = RoundPhase.INTRO
        self.phase_timer: int = 0
        self.round_num: int = 1
        self.timer_frames: int = 99 * TARGET_FPS
        self.ko_slowmo_tick: int = 0
        self.banner_text: str = ""
        self.banner_subtext: str = ""
        self.banner_alpha: float = 0.0

        # Fighters & AI
        self.p1: Fighter = Fighter(0, "CECILIA DARKMOON", 0)
        self.p2: Fighter = Fighter(1, "CECILIA — SHADOW MIRROR", 1)
        self.ai_p2: Optional[ShadowCeciliaAI] = None
        self.ai_p1_demo: Optional[ShadowCeciliaAI] = None  # Used only in QA / demo mode

        # Arcade / Survival progression state
        self.arcade_stage_idx: int = 0
        self.arcade_total_score: int = 0
        self.arcade_start_time: float = 0.0
        self.arcade_accum_stats: MatchStats = MatchStats()
        self.survival_wins: int = 0
        self.current_rival: Optional[RivalPersona] = None

        # Pause & Post-Match Menu overlays
        self.paused: bool = False
        self.pause_cursor: int = 0
        self.training_menu_open: bool = False
        self.training_menu_cursor: int = 0
        self.match_end_cursor: int = 0
        self.winner_idx: int = 0  # 0=P1, 1=P2, -1=Draw
        self.tick_counter: int = 0

    def start_new_mode(self, mode: GameMode) -> Optional[RivalPersona]:
        """Initialize a full session for the chosen GameMode; returns initial RivalPersona if any."""
        self.mode = mode
        self.paused = False
        self.training_menu_open = False
        self.replay.stop_playback()
        self.arcade_stage_idx = 0
        self.arcade_total_score = 0
        self.arcade_start_time = time.time()
        self.arcade_accum_stats = MatchStats()
        self.survival_wins = 0
        self.current_rival = None
        self.ai_p1_demo = None

        if mode == GameMode.ARCADE:
            self.current_rival = ARCADE_LADDER[0]
            self._configure_match_fighters(
                p1_pal=self.settings.p1_palette_idx,
                p2_pal=self.current_rival.palette_idx,
                p2_name=self.current_rival.name,
                p2_hp=int(MAX_HP * self.current_rival.hp_multiplier),
                ai_diff=self.current_rival.difficulty,
                persona=self.current_rival,
            )
            return self.current_rival

        if mode == GameMode.SURVIVAL:
            self._setup_next_survival_rival()
            return self.current_rival

        if mode == GameMode.VERSUS_CPU:
            p2_pal = self.settings.p2_palette_idx
            self._configure_match_fighters(
                p1_pal=self.settings.p1_palette_idx,
                p2_pal=p2_pal,
                p2_name=f"CECILIA — {CECILIA_PALETTES[p2_pal].display_name}",
                p2_hp=MAX_HP,
                ai_diff=self.settings.cpu_difficulty,
                persona=None,
            )
            return None

        if mode == GameMode.VERSUS_2P:
            p2_pal = self.settings.p2_palette_idx
            self._configure_match_fighters(
                p1_pal=self.settings.p1_palette_idx,
                p2_pal=p2_pal,
                p2_name=f"P2 CECILIA ({CECILIA_PALETTES[p2_pal].display_name})",
                p2_hp=MAX_HP,
                ai_diff=None,
                persona=None,
            )
            return None

        # TRAINING LAB
        p2_pal = self.settings.p2_palette_idx
        self._configure_match_fighters(
            p1_pal=self.settings.p1_palette_idx,
            p2_pal=p2_pal,
            p2_name="TRAINING DUMMY — CECILIA",
            p2_hp=MAX_HP,
            ai_diff=None,
            persona=None,
        )
        return None

    def _setup_next_survival_rival(self) -> None:
        idx = self.survival_wins % len(ARCADE_LADDER)
        base = ARCADE_LADDER[idx]
        diffs = list(AIDifficulty)
        d_idx = clamp_int(self.survival_wins // 2, 0, len(diffs) - 1)
        self.current_rival = RivalPersona(
            stage_index=self.survival_wins + 1,
            name=f"WAVE {self.survival_wins + 1} — {base.name.split('—')[-1].strip()}",
            title=base.title,
            palette_idx=(idx + 1) % len(CECILIA_PALETTES),
            difficulty=diffs[d_idx],
            intro_quote=base.intro_quote,
            victory_quote=base.victory_quote,
            ai_aggression=clamp(0.46 + self.survival_wins * 0.05, 0.45, 0.90),
            ai_zoning=clamp(0.36 + self.survival_wins * 0.04, 0.35, 0.72),
            ai_parry_rate=clamp(0.08 + self.survival_wins * 0.04, 0.08, 0.44),
            hp_multiplier=clamp(0.90 + self.survival_wins * 0.05, 0.90, 1.35),
        )
        keep_hp = self.p1.hp if self.survival_wins > 0 else MAX_HP
        self._configure_match_fighters(
            p1_pal=self.settings.p1_palette_idx,
            p2_pal=self.current_rival.palette_idx,
            p2_name=self.current_rival.name,
            p2_hp=int(MAX_HP * self.current_rival.hp_multiplier),
            ai_diff=self.current_rival.difficulty,
            persona=self.current_rival,
        )
        if self.survival_wins > 0:
            # Stylish-rank scaled HP recovery between Survival waves!
            heal = int(MAX_HP * (0.28 + self.p1.stylish.rank.tier * 0.06))
            self.p1.hp = min(MAX_HP, keep_hp + heal)
            self.p1.display_red_hp = float(self.p1.hp)

    def _configure_match_fighters(
        self,
        p1_pal: int,
        p2_pal: int,
        p2_name: str,
        p2_hp: int,
        ai_diff: Optional[AIDifficulty],
        persona: Optional[RivalPersona],
    ) -> None:
        self.p1 = Fighter(0, "CECILIA DARKMOON", p1_pal, MAX_HP)
        self.p2 = Fighter(1, p2_name, p2_pal, p2_hp)
        self.ai_p2 = ShadowCeciliaAI(ai_diff, persona) if ai_diff is not None else None
        self.round_num = 1
        self.p1.rounds_won = 0
        self.p2.rounds_won = 0
        self.match_end_cursor = 0
        self.begin_round(is_first_round=True)

    def begin_round(self, is_first_round: bool = False) -> None:
        """Reset arena, decals, camera, and start INTRO or direct FIGHT (Training)."""
        self.stage.reset_round_decals()
        self.vfx.reset_round()
        self.combat.reset_round()
        self.cam.reset()
        self.inputs.buffers[0].reset()
        self.inputs.buffers[1].reset()
        if self.ai_p2 is not None:
            self.ai_p2.reset()
        self.dummy_ctrl.reset()

        keep_meter = (not is_first_round) or (self.mode == GameMode.SURVIVAL and self.survival_wins > 0)
        preserve_surv_hp = self.p1.hp if (self.mode == GameMode.SURVIVAL and self.survival_wins > 0 and is_first_round) else None
        self.p1.reset_for_round(STAGE_CENTER_X - 240.0, facing_right=True, keep_meter=keep_meter)
        self.p2.reset_for_round(STAGE_CENTER_X + 240.0, facing_right=False, keep_meter=keep_meter)
        if preserve_surv_hp is not None:
            self.p1.hp = clamp_int(preserve_surv_hp, int(MAX_HP * 0.25), MAX_HP)
            self.p1.display_red_hp = float(self.p1.hp)

        is_inf = (self.mode == GameMode.TRAINING) or (self.settings.round_timer_sec == 0)
        self.timer_frames = 99 * TARGET_FPS if is_inf else (self.settings.round_timer_sec * TARGET_FPS)
        self.ko_slowmo_tick = 0

        if not self.replay.playing and self.mode != GameMode.TRAINING:
            self.replay.start_recording(self.p1.palette_idx, self.p2.palette_idx, self.p2.name)

        if self.mode == GameMode.TRAINING:
            self.phase = RoundPhase.FIGHT
            self.phase_timer = 0
            self.banner_text = ""
            self.banner_alpha = 0.0
            if hasattr(self.audio, "play_extra_bgm"):
                self.audio.play_extra_bgm("TRAINING_TRANCE")
            else:
                self.audio.play_bgm(BGMId.BATTLE_ASSAULT_A)
        elif is_first_round and not self.replay.playing:
            self.phase = RoundPhase.INTRO
            self.phase_timer = 86
            self.p1.enter_state(FighterState.INTRO_POSE)
            self.p2.enter_state(FighterState.INTRO_POSE)
            self.banner_text = "CURSED CATHEDRAL SWAMP"
            self.banner_subtext = "RUINS OF THE BLOOD-RED MIRE"
            self.banner_alpha = 1.0
            self.audio.play_bgm(BGMId.BATTLE_ASSAULT_A)
        else:
            self._enter_round_call()

    def _enter_round_call(self) -> None:
        self.phase = RoundPhase.ROUND_CALL
        self.phase_timer = 84
        self.p1.enter_state(FighterState.IDLE)
        self.p2.enter_state(FighterState.IDLE)
        final_r = (
            self.p1.rounds_won == self._rounds_needed() - 1
            and self.p2.rounds_won == self._rounds_needed() - 1
            and self._rounds_needed() > 1
        )
        self.banner_text = "FINAL ROUND" if final_r else f"ROUND {self.round_num}"
        self.banner_subtext = "PREPARE TO DRAW STEEL"
        self.banner_alpha = 1.0
        self.audio.play_sfx(SFXId.ROUND_GONG, vol_scale=0.95)
        if self.mode == GameMode.ARCADE and self.arcade_stage_idx == len(ARCADE_LADDER) - 1 and hasattr(self.audio, "play_extra_bgm"):
            self.audio.play_extra_bgm("SOVEREIGN_BOSS")
        else:
            self.audio.play_bgm(BGMId.BATTLE_ASSAULT_B if final_r else BGMId.BATTLE_ASSAULT_A)

    def _rounds_needed(self) -> int:
        if self.mode == GameMode.SURVIVAL:
            return 1
        return self.settings.rounds_to_win

    def get_arcade_stage_label(self) -> str:
        if self.mode == GameMode.ARCADE:
            return f"STAGE {self.arcade_stage_idx + 1} / {len(ARCADE_LADDER)}"
        if self.mode == GameMode.SURVIVAL:
            return f"SURVIVAL WAVE {self.survival_wins + 1}"
        if self.mode == GameMode.TRAINING:
            return "TRAINING LAB"
        return ""

    # --------------------------------------------------------------------------
    # TRAINING LAB POSITION RESET & PAUSE / MATCH-END KEY HANDLING
    # --------------------------------------------------------------------------
    def reset_training_positions(self, spot: str = "CENTER") -> None:
        if spot == "LEFT":
            x1, x2 = STAGE_LEFT_WALL + 140.0, STAGE_LEFT_WALL + 320.0
        elif spot == "RIGHT":
            x1, x2 = STAGE_RIGHT_WALL - 320.0, STAGE_RIGHT_WALL - 140.0
        else:
            x1, x2 = STAGE_CENTER_X - 210.0, STAGE_CENTER_X + 210.0
        self.p1.reset_for_round(x1, facing_right=True, keep_meter=True)
        self.p2.reset_for_round(x2, facing_right=False, keep_meter=True)
        self.p1.super_meter = MAX_SUPER_METER if self.training_cfg.auto_max_super else max(self.p1.super_meter, 100.0)
        self.vfx.reset_round()
        self.combat.reset_round()
        self.cam.reset()
        self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)

    def handle_keydown(self, key: int) -> Optional[str]:
        """Handle menu/pause/hotkey events during battle; returns navigation command if leaving battle."""
        # Instant Replay exit hotkey
        if self.replay.playing and key == pygame.K_ESCAPE:
            self.replay.stop_playback()
            self.phase = RoundPhase.MATCH_END
            self.audio.play_sfx(SFXId.UI_CANCEL, vol_scale=0.8)
            return None

        # Skip Intro Pose smoothly on Confirm/Attack
        if self.phase == RoundPhase.INTRO and key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_u):
            self._enter_round_call()
            return None

        # Post-Match Breakdown Menu navigation
        if self.phase == RoundPhase.MATCH_END and not self.paused:
            opts = self._get_match_end_options()
            if key in (pygame.K_UP, pygame.K_w):
                self.match_end_cursor = (self.match_end_cursor - 1) % len(opts)
                self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)
            elif key in (pygame.K_DOWN, pygame.K_s):
                self.match_end_cursor = (self.match_end_cursor + 1) % len(opts)
                self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)
            elif key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_u):
                self.audio.play_sfx(SFXId.UI_CONFIRM, vol_scale=0.9)
                chosen = opts[self.match_end_cursor]
                return self._execute_match_end_choice(chosen)
            return None

        # Training Lab quick hotkeys when unpaused
        if self.mode == GameMode.TRAINING and not self.paused:
            if key == pygame.K_F1:
                self.reset_training_positions("CENTER")
                return None
            if key == pygame.K_F2:
                self.reset_training_positions("LEFT")
                return None
            if key == pygame.K_F3:
                self.reset_training_positions("RIGHT")
                return None
            if key == pygame.K_F4:
                modes = list(DummyMode)
                i = (modes.index(self.training_cfg.dummy_mode) + 1) % len(modes)
                self.training_cfg.dummy_mode = modes[i]
                self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)
                return None
            if key == pygame.K_F5:
                self.training_cfg.show_hitboxes = not self.training_cfg.show_hitboxes
                self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)
                return None
            if key == pygame.K_F6:
                self.training_lab.trials.cycle_trial()
                self.audio.play_sfx(SFXId.UI_CONFIRM, vol_scale=0.8)
                return None
            if key == pygame.K_TAB:
                self.paused = True
                self.training_menu_open = True
                self.training_menu_cursor = 0
                self.audio.set_duck(0.35)
                self.audio.play_sfx(SFXId.UI_CONFIRM, vol_scale=0.8)
                return None

        # Pause Toggle
        if key == pygame.K_ESCAPE:
            self.paused = not self.paused
            self.training_menu_open = False
            self.pause_cursor = 0
            self.audio.set_duck(0.35 if self.paused else 1.0)
            self.audio.play_sfx(SFXId.UI_CANCEL if not self.paused else SFXId.UI_CONFIRM, vol_scale=0.8)
            return None

        if not self.paused:
            return None

        # Inside Training Lab Settings Submenu
        if self.training_menu_open:
            return self._handle_training_submenu_key(key)

        # Standard Pause Menu navigation
        p_opts = self._get_pause_options()
        if key in (pygame.K_UP, pygame.K_w):
            self.pause_cursor = (self.pause_cursor - 1) % len(p_opts)
            self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)
        elif key in (pygame.K_DOWN, pygame.K_s):
            self.pause_cursor = (self.pause_cursor + 1) % len(p_opts)
            self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)
        elif key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_u):
            self.audio.play_sfx(SFXId.UI_CONFIRM, vol_scale=0.9)
            sel = p_opts[self.pause_cursor]
            if sel == "RESUME DUEL":
                self.paused = False
                self.audio.set_duck(1.0)
            elif sel == "TRAINING LAB SETTINGS":
                self.training_menu_open = True
                self.training_menu_cursor = 0
            elif sel == "COMMAND LIST & CODEX":
                return "OPEN_CODEX"
            elif sel == "OPTIONS & CONTROLS":
                return "OPEN_OPTIONS"
            elif sel == "RESTART MATCH":
                self.paused = False
                self.audio.set_duck(1.0)
                self.p1.rounds_won = 0
                self.p2.rounds_won = 0
                self.round_num = 1
                self.begin_round(is_first_round=True)
            elif sel == "RETURN TO MAIN SANCTUM":
                self.paused = False
                self.audio.set_duck(1.0)
                return "EXIT_TO_MENU"
        return None

    def _get_pause_options(self) -> List[str]:
        opts = ["RESUME DUEL"]
        if self.mode == GameMode.TRAINING:
            opts.append("TRAINING LAB SETTINGS")
        opts.extend([
            "COMMAND LIST & CODEX",
            "OPTIONS & CONTROLS",
            "RESTART MATCH",
            "RETURN TO MAIN SANCTUM",
        ])
        return opts

    def _handle_training_submenu_key(self, key: int) -> Optional[str]:
        rows = 9
        if key in (pygame.K_UP, pygame.K_w):
            self.training_menu_cursor = (self.training_menu_cursor - 1) % rows
            self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)
        elif key in (pygame.K_DOWN, pygame.K_s):
            self.training_menu_cursor = (self.training_menu_cursor + 1) % rows
            self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)
        elif key in (pygame.K_LEFT, pygame.K_a, pygame.K_RIGHT, pygame.K_d, pygame.K_RETURN, pygame.K_SPACE):
            delta = -1 if key in (pygame.K_LEFT, pygame.K_a) else 1
            c = self.training_cfg
            self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)
            if self.training_menu_cursor == 0:
                ms = list(DummyMode)
                c.dummy_mode = ms[(ms.index(c.dummy_mode) + delta) % len(ms)]
            elif self.training_menu_cursor == 1:
                c.show_hitboxes = not c.show_hitboxes
            elif self.training_menu_cursor == 2:
                c.show_framedata = not c.show_framedata
            elif self.training_menu_cursor == 3:
                c.show_input_history = not c.show_input_history
            elif self.training_menu_cursor == 4:
                c.auto_regen_hp = not c.auto_regen_hp
            elif self.training_menu_cursor == 5:
                c.auto_max_super = not c.auto_max_super
            elif self.training_menu_cursor == 6:
                c.auto_max_resonance = not c.auto_max_resonance
            elif self.training_menu_cursor == 7:
                c.counter_hit_forced = not c.counter_hit_forced
            elif self.training_menu_cursor == 8:
                self.training_lab.trials.cycle_trial()
        elif key == pygame.K_BACKSPACE:
            self.training_menu_open = False
        return None

    def _get_match_end_options(self) -> List[str]:
        opts: List[str] = []
        if self.mode == GameMode.ARCADE and self.winner_idx == 0:
            if self.arcade_stage_idx + 1 < len(ARCADE_LADDER):
                opts.append("NEXT DARKMOON TRIAL")
            else:
                opts.append("CLAIM SOVEREIGN EPILOGUE")
        elif self.mode == GameMode.SURVIVAL and self.winner_idx == 0:
            opts.append("NEXT SURVIVAL WAVE")
        opts.append("REMATCH")
        if self.replay.has_replay():
            opts.append("WATCH INSTANT REPLAY")
        opts.append("CHANGE PALETTE / SETUP")
        opts.append("RETURN TO MAIN SANCTUM")
        return opts

    def _execute_match_end_choice(self, choice: str) -> Optional[str]:
        if choice == "NEXT DARKMOON TRIAL":
            self._accumulate_arcade_stats()
            self.arcade_stage_idx += 1
            self.current_rival = ARCADE_LADDER[self.arcade_stage_idx]
            self._configure_match_fighters(
                p1_pal=self.settings.p1_palette_idx,
                p2_pal=self.current_rival.palette_idx,
                p2_name=self.current_rival.name,
                p2_hp=int(MAX_HP * self.current_rival.hp_multiplier),
                ai_diff=self.current_rival.difficulty,
                persona=self.current_rival,
            )
            return "SHOW_VS_NEXT"
        if choice == "CLAIM SOVEREIGN EPILOGUE":
            self._accumulate_arcade_stats()
            return "ARCADE_ENDING"
        if choice == "NEXT SURVIVAL WAVE":
            self.survival_wins += 1
            self._setup_next_survival_rival()
            return "SHOW_VS_NEXT"
        if choice == "REMATCH":
            self.p1.rounds_won = 0
            self.p2.rounds_won = 0
            self.round_num = 1
            self.p1.stats = MatchStats()
            self.p2.stats = MatchStats()
            self.begin_round(is_first_round=True)
            return None
        if choice == "WATCH INSTANT REPLAY":
            if self.replay.start_playback():
                self.begin_round(is_first_round=False)
                self.phase = RoundPhase.FIGHT
                self.banner_text = ""
                self.banner_alpha = 0.0
            return None
        if choice == "CHANGE PALETTE / SETUP":
            return "OPEN_SETUP"
        return "EXIT_TO_MENU"

    def _accumulate_arcade_stats(self) -> None:
        s = self.p1.stats
        acc = self.arcade_accum_stats
        self.arcade_total_score += s.stylish_score + (self.p1.hp // 2)
        acc.damage_dealt += s.damage_dealt
        acc.max_combo = max(acc.max_combo, s.max_combo)
        acc.max_combo_damage = max(acc.max_combo_damage, s.max_combo_damage)
        acc.counter_hits += s.counter_hits
        acc.just_guards += s.just_guards
        acc.parries += s.parries
        acc.weapon_clashes += s.weapon_clashes
        acc.curse_ruptures += s.curse_ruptures
        acc.fatal_executions += s.fatal_executions
        if s.highest_rank.tier > acc.highest_rank.tier:
            acc.highest_rank = s.highest_rank

    # --------------------------------------------------------------------------
    # MAIN 60HZ DETERMINISTIC BATTLE SIMULATION TICK
    # --------------------------------------------------------------------------
    def tick(self, keys: Sequence[bool]) -> None:
        self.tick_counter += 1
        self.hud.update(FIXED_DT)
        if self.paused:
            return

        # Dynamic Stage lighting reacts to Super Arts, Resonance & Fatal Executions
        eclipse_target = 0.0
        if self.combat.super_freeze_frames > 0 or self.p1.state in (
            FighterState.SUPER_ECLIPSE_REQUIEM, FighterState.FATAL_CRIMSON_JUDGMENT
        ) or self.p2.state in (
            FighterState.SUPER_ECLIPSE_REQUIEM, FighterState.FATAL_CRIMSON_JUDGMENT
        ):
            eclipse_target = 0.88
        self.stage.update(
            FIXED_DT,
            resonance_any=(self.p1.resonance_active or self.p2.resonance_active),
            eclipse_target=eclipse_target,
        )

        # Update Super Freeze cinematic cut-in frames
        if self.combat.super_freeze_frames > 0:
            self.combat.super_freeze_frames -= 1
            self.vfx.update(self.stage)
            self.cam.update(self.p1, self.p2, FIXED_DT)
            self.audio.set_duck(0.45)
            return
        self.audio.set_duck(1.0)

        # Phase-specific updates
        if self.phase == RoundPhase.INTRO:
            self.phase_timer -= 1
            self.p1.state_tick += 1
            self.p2.state_tick += 1
            self.cam.update(self.p1, self.p2, FIXED_DT)
            self.vfx.update(self.stage)
            self.banner_alpha = smoothstep(min(1.0, self.phase_timer / 16.0))
            if self.phase_timer <= 0:
                self._enter_round_call()
            return

        if self.phase == RoundPhase.ROUND_CALL:
            self.phase_timer -= 1
            self.p1.state_tick += 1
            self.p2.state_tick += 1
            self.cam.update(self.p1, self.p2, FIXED_DT)
            self.vfx.update(self.stage)
            if self.phase_timer == 26:
                self.banner_text = "UNSHEATHE!"
                self.banner_subtext = "FIGHT"
                self.audio.play_sfx(SFXId.FIGHT_SHOUT, vol_scale=1.0)
            self.banner_alpha = 1.0 if self.phase_timer > 10 else (self.phase_timer / 10.0)
            if self.phase_timer <= 0:
                self.phase = RoundPhase.FIGHT
                self.banner_text = ""
                self.banner_alpha = 0.0
            return

        if self.phase == RoundPhase.KO_SLOWMO:
            self.phase_timer -= 1
            self.ko_slowmo_tick += 1
            self.vfx.update(self.stage)
            self.cam.update(self.p1, self.p2, FIXED_DT)
            # Advance physics every 4th frame for dramatic 0.25x anime KO slow-motion!
            if self.ko_slowmo_tick % 4 == 0:
                self.p1.tick_physics_and_state(self.p2, self.audio, self.stage)
                self.p2.tick_physics_and_state(self.p1, self.audio, self.stage)
                self.combat.resolve_pushboxes(self.p1, self.p2)
            if self.phase_timer <= 0:
                self._conclude_round()
            return

        if self.phase == RoundPhase.ROUND_END:
            self.phase_timer -= 1
            self.p1.state_tick += 1
            self.p2.state_tick += 1
            self.vfx.update(self.stage)
            self.cam.update(self.p1, self.p2, FIXED_DT)
            if self.phase_timer <= 0:
                if self.replay.playing:
                    self.replay.stop_playback()
                    self.phase = RoundPhase.MATCH_END
                elif self.p1.rounds_won >= self._rounds_needed() or self.p2.rounds_won >= self._rounds_needed():
                    self.winner_idx = 0 if self.p1.rounds_won >= self.p2.rounds_won else 1
                    self.phase = RoundPhase.MATCH_END
                    self.match_end_cursor = 0
                    self.audio.play_bgm(BGMId.VICTORY_THEME)
                else:
                    self.round_num += 1
                    self.begin_round(is_first_round=False)
            return

        if self.phase == RoundPhase.MATCH_END:
            self.p1.state_tick += 1
            self.p2.state_tick += 1
            self.vfx.update(self.stage)
            self.cam.update(self.p1, self.p2, FIXED_DT)
            return

        # ======================================================================
        # ACTIVE FIGHT PHASE
        # ======================================================================
        # Hitstop freeze frames (visual hit-shake + VFX keep animating!)
        if self.combat.hitstop_frames > 0:
            self.combat.hitstop_frames -= 1
            self.vfx.update(self.stage)
            self.cam.update(self.p1, self.p2, FIXED_DT)
            return

        # 1. Poll Inputs (Live Human / AI / Dummy / Replay)
        direct_p1: Optional[Tuple[FighterState, bool]] = None
        direct_p2: Optional[Tuple[FighterState, bool]] = None

        if self.replay.playing:
            rf = self.replay.next_frame()
            if rf is None:
                self.replay.stop_playback()
                self.phase = RoundPhase.MATCH_END
                return
            self.inputs.push_ai_command(0, rf.p1_dx, rf.p1_dy, InputButton(rf.p1_btn), self.p1.facing_right)
            self.inputs.push_ai_command(1, rf.p2_dx, rf.p2_dy, InputButton(rf.p2_btn), self.p2.facing_right)
        else:
            if self.ai_p1_demo is not None:
                dx1, dy1, b1, direct_p1 = self.ai_p1_demo.compute_frame_input(self.p1, self.p2, self.vfx.projectiles)
                f1_in = self.inputs.push_ai_command(0, dx1, dy1, b1, self.p1.facing_right)
            else:
                f1_in = self.inputs.poll_human_player(0, self.p1.facing_right, keys)

            if self.mode == GameMode.VERSUS_2P:
                f2_in = self.inputs.poll_human_player(1, self.p2.facing_right, keys)
            elif self.mode == GameMode.TRAINING:
                dx2, dy2, b2, direct_p2 = self.dummy_ctrl.compute_frame_input(self.p2, self.p1, self.training_cfg, self.vfx.projectiles)
                f2_in = self.inputs.push_ai_command(1, dx2, dy2, b2, self.p2.facing_right)
            elif self.ai_p2 is not None:
                dx2, dy2, b2, direct_p2 = self.ai_p2.compute_frame_input(self.p2, self.p1, self.vfx.projectiles)
                f2_in = self.inputs.push_ai_command(1, dx2, dy2, b2, self.p2.facing_right)
            else:
                f2_in = self.inputs.push_ai_command(1, 0, 0, InputButton.NONE, self.p2.facing_right)

            if self.mode != GameMode.TRAINING:
                self.replay.record(f1_in.raw_dx, f1_in.raw_dy, f1_in.held, f2_in.raw_dx, f2_in.raw_dy, f2_in.held)

        # 2. Apply Fighter Command & Movement Interpretation
        started1 = self._apply_fighter_controls(self.p1, self.p2, self.inputs.buffers[0], self.settings.simple_inputs_p1, direct_p1)
        started2 = self._apply_fighter_controls(self.p2, self.p1, self.inputs.buffers[1], self.settings.simple_inputs_p2, direct_p2)
        if started1 is not None:
            self.combat.on_move_started(self.p1, started1)
        if started2 is not None:
            self.combat.on_move_started(self.p2, started2)

        # 3. Advance Deterministic Physics & State Machines
        self.p1.tick_physics_and_state(self.p2, self.audio, self.stage)
        self.p2.tick_physics_and_state(self.p1, self.audio, self.stage)
        self.combat.resolve_pushboxes(self.p1, self.p2)

        # 4. Resolve Swordplay, Clashes, Parries, Guards, Curse & Projectiles
        force_ct = (self.mode == GameMode.TRAINING and self.training_cfg.counter_hit_forced)
        self.combat.resolve_frame(self.p1, self.p2, self.inputs.buffers[0], self.inputs.buffers[1], force_ct)

        # 5. Spawn Stylized Afterimages during Dash, Blink, EX, Resonance & Supers
        for f in (self.p1, self.p2):
            if self.tick_counter % 3 == 0 and (
                f.resonance_active
                or f.is_ex_move
                or f.state in (
                    FighterState.DASH_FWD,
                    FighterState.SPECIAL_SHADOW_STEP,
                    FighterState.SUPER_ECLIPSE_REQUIEM,
                    FighterState.FATAL_CRIMSON_JUDGMENT,
                    FighterState.SPECIAL_ABYSS_ASCENSION,
                )
            ):
                fi = self.bank.get_frame_index_for_tick(f.state, f.state_tick, loop=f.is_neutral_movable)
                spr = self.bank.get_sprite(f.palette_idx, f.state, fi, f.facing_right, f.resonance_active)
                pal = CECILIA_PALETTES[f.palette_idx]
                tint = pal.aura_primary if not f.is_ex_move else (255, 210, 110)
                self.vfx.spawn_afterimage(f, spr, tint, life=9)

        # 6. Dynamic Climax Techno/Breakbeat OST escalation on Low HP or Resonance!
        if self.mode != GameMode.TRAINING and (
            self.p1.hp < self.p1.max_hp * 0.30
            or self.p2.hp < self.p2.max_hp * 0.30
            or self.p1.resonance_active
            or self.p2.resonance_active
        ):
            self.audio.play_bgm(BGMId.BATTLE_ASSAULT_B)

        # 7. Training Lab Auto-Regen & Combo Trials OR Live Round KO / Timer Check
        if self.mode == GameMode.TRAINING:
            self.training_lab.apply_training_rules(self.p1, self.p2, self.training_cfg, self.audio)
            if self.p1.hp <= 0:
                self.p1.hp = self.p1.max_hp
            if self.p2.hp <= 0:
                self.p2.hp = self.p2.max_hp
        else:
            if self.settings.round_timer_sec > 0:
                self.timer_frames = max(0, self.timer_frames - 1)
            if not self.p1.alive or not self.p2.alive or (self.settings.round_timer_sec > 0 and self.timer_frames <= 0):
                self._trigger_ko_slowmo()

        self.vfx.update(self.stage)
        self.cam.update(self.p1, self.p2, FIXED_DT)

    def _apply_fighter_controls(
        self,
        f: Fighter,
        opp: Fighter,
        buf: InputBuffer,
        simple_mode: bool,
        direct_cmd: Optional[Tuple[FighterState, bool]],
    ) -> Optional[FighterState]:
        if direct_cmd is not None and not f.in_throw_lock and f.alive:
            st, is_ex = direct_cmd
            if f.is_neutral_movable or f.is_air_movable or (f.is_attacking and f.can_cancel_into(st)):
                f.enter_state(st, is_ex=is_ex)
                return st
        return f.try_process_input(buf, opp, simple_mode, self.audio)

    def _trigger_ko_slowmo(self) -> None:
        self.phase = RoundPhase.KO_SLOWMO
        self.phase_timer = KO_SLOWMO_FRAMES
        self.ko_slowmo_tick = 0
        self.audio.play_sfx(SFXId.KO_IMPACT, vol_scale=1.0)
        if not self.p1.alive and not self.p2.alive:
            self.banner_text = "DOUBLE K.O.!"
            self.banner_subtext = "MUTUAL RUIN"
        elif self.combat.last_ko_was_fatal:
            self.banner_text = "CRIMSON JUDGMENT!"
            self.banner_subtext = "FATAL EXECUTION"
        elif self.settings.round_timer_sec > 0 and self.timer_frames <= 0:
            self.banner_text = "TIME OVER"
            self.banner_subtext = "JUDGMENT BY VITALITY"
        else:
            self.banner_text = "K.O.!"
            self.banner_subtext = "THE CURSED BLADE PREVAILS"
        self.banner_alpha = 1.0
        focus_f = self.p2 if not self.p2.alive else self.p1
        self.cam.trigger_dramatic_zoom(focus_f.x, focus_f.y - 120.0, 1.32, KO_SLOWMO_FRAMES)

    def _conclude_round(self) -> None:
        self.phase = RoundPhase.ROUND_END
        self.phase_timer = 104
        if self.p1.hp > self.p2.hp:
            self.p1.rounds_won += 1
            self.p1.enter_state(FighterState.VICTORY_POSE)
            self.banner_text = "CECILIA DARKMOON WINS"
            self.banner_subtext = "PERFECT POISE" if self.p1.hp == self.p1.max_hp else "CURSED VICTORY"
        elif self.p2.hp > self.p1.hp:
            self.p2.rounds_won += 1
            self.p2.enter_state(FighterState.VICTORY_POSE)
            self.banner_text = f"{self.p2.name} WINS"
            self.banner_subtext = "BLOOD CLAIMED"
        else:
            # Double KO grants both a round unless match point draw
            if self.p1.rounds_won < self._rounds_needed() - 1:
                self.p1.rounds_won += 1
            if self.p2.rounds_won < self._rounds_needed() - 1:
                self.p2.rounds_won += 1
            self.banner_text = "DRAW ROUND"
            self.banner_subtext = "BLADES EVEN"
