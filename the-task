# MASTER APPLICATION HOST (LOCKED 800x600 PIXEL-NEAREST SCALER & FULL GAME LOOP)
# ==============================================================================

class NoroiNoYaibaApp:
    """
    Master AAA Application Host for 呪いの刃.

    Locks internal rendering to exactly 800x600 and upscales to any larger
    window/fullscreen resolution via crisp nearest-neighbor pixelization
    (pygame.transform.scale, ZERO anti-aliasing blur) for blazing performance
    on low-end laptops while preserving PS3/PS4 painterly CG sprite detail.
    """

    MAIN_MENU_ITEMS: Tuple[Tuple[str, str], ...] = (
        ("ARCADE MODE", "Ascend the 6-Stage Darkmoon Cathedral Ladder and confront Eclipse Cecilia."),
        ("VERSUS CPU", "Custom duel against any of the 6 adaptive Shadow Cecilia personas."),
        ("VERSUS 2P LOCAL", "Head-to-head local 2-player steel duel (Dual Keyboard / Gamepads)."),
        ("SURVIVAL GAUNTLET", "Endless bloodmoon trial with partial vampiric recovery between foes."),
        ("TRAINING LAB", "Hitboxes, live frame-data timeline, input tape & 12 Combo Trials."),
        ("COMMAND CODEX", "Complete move list, exact frame data & live animated keyframe preview."),
        ("GALLERY & OST JUKEBOX", "Inspect all 830 hand-drawn cels, CG Cut-Ins & full Techno/Breakbeat OST."),
        ("DARKMOON ARCHIVE", "Classified Gothic-Modern lore dossiers of Cecilia and the Cursed Blade."),
        ("REPLAY THEATER", "Watch frame-exact deterministic playback of your last recorded duel."),
        ("OPTIONS", "Audio mix, 800x600 integer pixel scaling, scanlines & R18+ blood tuning."),
        ("EXIT GAME", "Sheathe the Cursed Blade and leave the Drowned Cathedral."),
    )

    def __init__(self, headless: bool = False) -> None:
        self.headless = headless
        pygame.init()
        self.settings = GameSettings()
        self.canvas = pygame.Surface((INTERNAL_W, INTERNAL_H))
        self.display: Optional[pygame.Surface] = None
        self._crt_overlay = self._build_scanline_overlay()
        self._configure_display()

        self.fonts = FontManager()
        self.rast = PainterlyRasterizer()
        self.bank = SpriteBank(self.rast)
        self.stage = CursedCathedralStage(self.rast)
        self.audio = AudioManager(self.settings, headless=headless)
        self.inputs = InputManager()

        self.menus = MenuScreensRenderer(self.rast, self.bank, self.fonts)
        self.match = MatchDirector(self.rast, self.bank, self.stage, self.audio, self.fonts, self.inputs, self.settings)
        self.match.match_finished_callback = self._on_match_finished

        self.codex = CommandListScreen(self.match.move_reg, self.fonts)
        self.gallery = GalleryScreen(self.bank, self.audio, self.fonts)
        self.lore = LoreArchiveScreen(self.fonts)
        self.options = OptionsScreen(self.settings, self.fonts)

        self.screen: ScreenState = ScreenState.LOADING
        self.return_screen: ScreenState = ScreenState.MAIN_MENU
        self.running: bool = True
        self.app_time: float = 0.0
        self.load_progress: float = 0.0
        self.load_status: str = "Forging Cursed Cathedral..."
        self.bank.queue_prebake(("CRIMSON_ORIGINAL", "MOONLIT_MIRABELLE"))

        # Menu navigation state
        self.main_cursor: int = 0
        self.setup_mode: GameMode = GameMode.VERSUS_CPU
        self.setup_cursor: int = 4
        self.setup_p1_pal: int = 0
        self.setup_p2_pal: int = 1
        self.setup_rival: int = 2
        self.setup_diff: int = 2
        self.vs_timer: int = 0
        self.pause_cursor: int = 0
        self.post_cursor: int = 0
        self.post_p1_won: bool = True
        self.post_options: Tuple[str, ...] = ("REMATCH", "MAIN MENU")
        self.fps_measured: float = 60.0

    def _build_scanline_overlay(self) -> pygame.Surface:
        surf = pygame.Surface((INTERNAL_W, INTERNAL_H), pygame.SRCALPHA)
        for y in range(0, INTERNAL_H, 2):
            pygame.draw.line(surf, (0, 0, 0, 48), (0, y), (INTERNAL_W, y))
        return surf

    def _configure_display(self) -> None:
        if self.headless:
            self.display = pygame.display.set_mode((INTERNAL_W, INTERNAL_H))
            return
        flags = pygame.FULLSCREEN if self.settings.fullscreen else pygame.RESIZABLE
        w = INTERNAL_W * self.settings.window_scale
        h = INTERNAL_H * self.settings.window_scale
        self.display = pygame.display.set_mode((w, h), flags)
        pygame.display.set_caption(f"{GAME_TITLE_JP} — {GAME_SUBTITLE_EN}")

    def bake_all_blocking(self) -> float:
        t0 = time.perf_counter()
        self.stage.ensure_baked()
        self.bank.ensure_prebaked()
        self.load_progress = 1.0
        return time.perf_counter() - t0

    def _on_match_finished(self, p1_won: bool) -> None:
        self.post_p1_won = p1_won
        self.post_cursor = 0
        if self.match.mode == GameMode.ARCADE and p1_won:
            if self.match.arcade_stage_idx + 1 >= len(ARCADE_LADDER):
                self.screen = ScreenState.ARCADE_ENDING
                self.audio.play_bgm(OSTTrackId.TITLE_OVERTURE)
                return
            self.post_options = ("NEXT ARCADE STAGE", "REMATCH", "MAIN MENU")
        elif self.match.mode == GameMode.SURVIVAL and p1_won:
            self.match.survival_streak += 1
            self.post_options = ("NEXT CHALLENGER", "MAIN MENU")
        else:
            self.post_options = ("REMATCH", "CHANGE SETUP", "MAIN MENU")
        self.screen = ScreenState.POST_MATCH
        self.audio.play_bgm(OSTTrackId.MENU_SANCTUM)

    def _launch_vs_and_battle(self, mode: GameMode, arcade_stage: int = 0) -> None:
        p1_pk = PALETTE_ORDER[self.setup_p1_pal % len(PALETTE_ORDER)]
        p2_pk = PALETTE_ORDER[self.setup_p2_pal % len(PALETTE_ORDER)]
        diff = list(AIDifficulty)[self.setup_diff % len(AIDifficulty)]
        self.match.start_new_mode(mode, p1_pal=p1_pk, p2_pal=p2_pk, rival_idx=self.setup_rival, ai_diff=diff, arcade_stage=arcade_stage)
        if mode in (GameMode.TRAINING, GameMode.REPLAY):
            self.screen = ScreenState.BATTLE
        else:
            self.vs_timer = 110
            self.screen = ScreenState.VS_SPLASH

    def handle_keydown(self, key: int) -> None:
        if key == pygame.K_F11:
            self.settings.fullscreen = not self.settings.fullscreen
            self._configure_display()
            return

        if self.screen == ScreenState.TITLE:
            if key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_z, pygame.K_j):
                self.audio.play_sfx(SFXId.UI_CONFIRM)
                self.screen = ScreenState.MAIN_MENU
                self.audio.play_bgm(OSTTrackId.MENU_SANCTUM)
            elif key == pygame.K_ESCAPE:
                self.running = False

        elif self.screen == ScreenState.MAIN_MENU:
            if key in (pygame.K_UP, pygame.K_w):
                self.main_cursor = (self.main_cursor - 1) % len(self.MAIN_MENU_ITEMS)
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_DOWN, pygame.K_s):
                self.main_cursor = (self.main_cursor + 1) % len(self.MAIN_MENU_ITEMS)
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key == pygame.K_ESCAPE:
                self.screen = ScreenState.TITLE
                self.audio.play_bgm(OSTTrackId.TITLE_OVERTURE)
            elif key in (pygame.K_RETURN, pygame.K_SPACE):
                self.audio.play_sfx(SFXId.UI_CONFIRM)
                idx = self.main_cursor
                if idx == 0:
                    self._launch_vs_and_battle(GameMode.ARCADE, arcade_stage=0)
                elif idx == 1:
                    self.setup_mode = GameMode.VERSUS_CPU
                    self.screen = ScreenState.MODE_SETUP
                elif idx == 2:
                    self.setup_mode = GameMode.VERSUS_2P
                    self.screen = ScreenState.MODE_SETUP
                elif idx == 3:
                    self.match.survival_streak = 0
                    self._launch_vs_and_battle(GameMode.SURVIVAL)
                elif idx == 4:
                    self._launch_vs_and_battle(GameMode.TRAINING)
                elif idx == 5:
                    self.return_screen = ScreenState.MAIN_MENU
                    self.screen = ScreenState.COMMAND_LIST
                elif idx == 6:
                    self.screen = ScreenState.GALLERY
                elif idx == 7:
                    self.screen = ScreenState.LORE_ARCHIVE
                elif idx == 8:
                    if self.match.replay.frames:
                        self._launch_vs_and_battle(GameMode.REPLAY)
                    else:
                        self.audio.play_sfx(SFXId.UI_CANCEL)
                elif idx == 9:
                    self.return_screen = ScreenState.MAIN_MENU
                    self.screen = ScreenState.OPTIONS
                elif idx == 10:
                    self.running = False

        elif self.screen == ScreenState.MODE_SETUP:
            if key == pygame.K_ESCAPE:
                self.audio.play_sfx(SFXId.UI_CANCEL)
                self.screen = ScreenState.MAIN_MENU
            elif key in (pygame.K_UP, pygame.K_w):
                self.setup_cursor = (self.setup_cursor - 1) % 5
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_DOWN, pygame.K_s):
                self.setup_cursor = (self.setup_cursor + 1) % 5
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_LEFT, pygame.K_a, pygame.K_RIGHT, pygame.K_d):
                d = -1 if key in (pygame.K_LEFT, pygame.K_a) else 1
                self.audio.play_sfx(SFXId.UI_MOVE)
                if self.setup_cursor == 0:
                    self.setup_p1_pal = (self.setup_p1_pal + d) % len(PALETTE_ORDER)
                elif self.setup_cursor == 1:
                    self.setup_p2_pal = (self.setup_p2_pal + d) % len(PALETTE_ORDER)
                elif self.setup_cursor == 2:
                    self.setup_rival = (self.setup_rival + d) % len(ARCADE_LADDER)
                    self.setup_p2_pal = PALETTE_ORDER.index(ARCADE_LADDER[self.setup_rival].palette_key)
                elif self.setup_cursor == 3:
                    self.setup_diff = (self.setup_diff + d) % len(AIDifficulty)
            elif key in (pygame.K_RETURN, pygame.K_SPACE):
                self.audio.play_sfx(SFXId.UI_CONFIRM)
                self._launch_vs_and_battle(self.setup_mode)

        elif self.screen == ScreenState.VS_SPLASH:
            if key in (pygame.K_RETURN, pygame.K_SPACE):
                self.vs_timer = 1

        elif self.screen == ScreenState.BATTLE:
            if key == pygame.K_ESCAPE:
                self.pause_cursor = 0
                self.screen = ScreenState.PAUSE
                self.audio.play_sfx(SFXId.UI_CONFIRM)
            elif self.match.mode == GameMode.TRAINING:
                if key == pygame.K_TAB:
                    self.match.training_lab.trials.cycle_trial(1)
                    self.audio.play_sfx(SFXId.UI_MOVE)
                elif key == pygame.K_F1:
                    self.match.tcfg.show_hitboxes = not self.match.tcfg.show_hitboxes
                elif key == pygame.K_F2:
                    modes = list(DummyMode)
                    idx = (modes.index(self.match.tcfg.dummy_mode) + 1) % len(modes)
                    self.match.tcfg.dummy_mode = modes[idx]
                elif key == pygame.K_F3:
                    self.match.reset_training_positions()
                elif key == pygame.K_F4:
                    self.match.tcfg.show_frame_data = not self.match.tcfg.show_frame_data
                elif key == pygame.K_F5:
                    self.match.tcfg.infinite_eclipse = not self.match.tcfg.infinite_eclipse

        elif self.screen == ScreenState.PAUSE:
            p_items = ("RESUME BATTLE", "COMMAND CODEX", "RESTART MATCH", "OPTIONS", "RETURN TO MENU")
            if key == pygame.K_ESCAPE:
                self.screen = ScreenState.BATTLE
            elif key in (pygame.K_UP, pygame.K_w):
                self.pause_cursor = (self.pause_cursor - 1) % len(p_items)
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_DOWN, pygame.K_s):
                self.pause_cursor = (self.pause_cursor + 1) % len(p_items)
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_RETURN, pygame.K_SPACE):
                self.audio.play_sfx(SFXId.UI_CONFIRM)
                if self.pause_cursor == 0:
                    self.screen = ScreenState.BATTLE
                elif self.pause_cursor == 1:
                    self.return_screen = ScreenState.PAUSE
                    self.screen = ScreenState.COMMAND_LIST
                elif self.pause_cursor == 2:
                    self.match.start_new_mode(self.match.mode, arcade_stage=self.match.arcade_stage_idx)
                    self.screen = ScreenState.BATTLE
                elif self.pause_cursor == 3:
                    self.return_screen = ScreenState.PAUSE
                    self.screen = ScreenState.OPTIONS
                else:
                    self.screen = ScreenState.MAIN_MENU
                    self.audio.play_bgm(OSTTrackId.MENU_SANCTUM)

        elif self.screen == ScreenState.POST_MATCH:
            if key in (pygame.K_UP, pygame.K_w):
                self.post_cursor = (self.post_cursor - 1) % len(self.post_options)
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_DOWN, pygame.K_s):
                self.post_cursor = (self.post_cursor + 1) % len(self.post_options)
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_RETURN, pygame.K_SPACE):
                self.audio.play_sfx(SFXId.UI_CONFIRM)
                choice = self.post_options[self.post_cursor]
                if choice == "NEXT ARCADE STAGE":
                    self._launch_vs_and_battle(GameMode.ARCADE, arcade_stage=self.match.arcade_stage_idx + 1)
                elif choice == "NEXT CHALLENGER":
                    self._launch_vs_and_battle(GameMode.SURVIVAL)
                elif choice == "REMATCH":
                    self._launch_vs_and_battle(self.match.mode, arcade_stage=self.match.arcade_stage_idx)
                elif choice == "CHANGE SETUP":
                    self.screen = ScreenState.MODE_SETUP
                else:
                    self.screen = ScreenState.MAIN_MENU
                    self.audio.play_bgm(OSTTrackId.MENU_SANCTUM)

        elif self.screen == ScreenState.ARCADE_ENDING:
            if key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_ESCAPE):
                self.screen = ScreenState.MAIN_MENU
                self.audio.play_bgm(OSTTrackId.MENU_SANCTUM)

        elif self.screen == ScreenState.COMMAND_LIST:
            if self.codex.handle_key(key):
                self.screen = self.return_screen
        elif self.screen == ScreenState.GALLERY:
            if self.gallery.handle_key(key):
                self.screen = ScreenState.MAIN_MENU
                self.audio.play_bgm(OSTTrackId.MENU_SANCTUM)
        elif self.screen == ScreenState.LORE_ARCHIVE:
            if self.lore.handle_key(key):
                self.screen = ScreenState.MAIN_MENU
        elif self.screen == ScreenState.OPTIONS:
            exited, disp_ch = self.options.handle_key(key)
            if disp_ch:
                self._configure_display()
            if exited:
                self.screen = self.return_screen

    def step_frame(self, keys: Sequence[bool]) -> None:
        self.app_time += FIXED_DT
        if self.screen == ScreenState.LOADING:
            p_stage = self.stage.step_bake()
            if p_stage < 1.0:
                self.load_status = "Sculpting Drowned Romanesque Cathedral..."
                self.load_progress = p_stage * 0.45
            else:
                p_bank = self.bank.step_prebake(batch=8)
                self.load_status = "Baking Hand-Crafted Cecilia Cels..."
                self.load_progress = 0.45 + p_bank * 0.55
                if p_bank >= 1.0:
                    self.screen = ScreenState.TITLE
                    self.audio.play_bgm(OSTTrackId.TITLE_OVERTURE)
            return

        if self.screen == ScreenState.BATTLE:
            self.match.tick(keys)
            return

        # Keep atmospheric swamp stage & OST beat alive across menus!
        beat = self.audio.update(FIXED_DT)
        if beat > 0.0:
            self.stage.trigger_beat_pulse(beat)
        self.stage.update(FIXED_DT)

        if self.screen == ScreenState.VS_SPLASH:
            self.vs_timer -= 1
            if self.vs_timer <= 0:
                self.screen = ScreenState.BATTLE

    def render_canvas(self) -> None:
        """Render the current screen into the strictly locked 800x600 internal canvas."""
        if self.screen == ScreenState.LOADING:
            self.menus.render_loading(self.canvas, self.load_progress, self.load_status, self.app_time)
        elif self.screen == ScreenState.TITLE:
            self.menus.render_title(self.canvas, self.stage, self.app_time, self.audio)
        elif self.screen == ScreenState.MAIN_MENU:
            self.menus.render_main_menu(self.canvas, self.stage, self.MAIN_MENU_ITEMS, self.main_cursor, self.app_time, self.audio)
        elif self.screen == ScreenState.MODE_SETUP:
            self.menus.render_mode_setup(
                self.canvas, self.stage, self.setup_mode, self.setup_cursor,
                self.setup_p1_pal, self.setup_p2_pal, self.setup_rival, self.setup_diff, self.app_time,
            )
        elif self.screen == ScreenState.VS_SPLASH:
            u = 1.0 - (self.vs_timer / 110.0)
            st_lbl = f"STAGE {self.match.arcade_stage_idx + 1} — {STAGE_NAME}" if self.match.mode == GameMode.ARCADE else STAGE_NAME
            self.menus.render_vs_splash(
                self.canvas, self.match.p1.palette_key, self.match.p2.palette_key,
                self.match.p1.name, self.match.p2.name, self.match.active_rival.intro_quote, st_lbl, u,
            )
        elif self.screen in (ScreenState.BATTLE, ScreenState.PAUSE):
            self.match.render(self.canvas)
            if self.screen == ScreenState.PAUSE:
                veil = pygame.Surface((INTERNAL_W, INTERNAL_H), pygame.SRCALPHA)
                veil.fill((10, 4, 16, 178))
                self.canvas.blit(veil, (0, 0))
                draw_gothic_filigree_panel(self.canvas, pygame.Rect(236, 146, 328, 304), bg_alpha=225)
                self.fonts.draw_text(self.canvas, "PAUSED", 400, 166, size=28, color=(255, 224, 142), style="serif", bold=True, align="center")
                p_items = ("RESUME BATTLE", "COMMAND CODEX", "RESTART MATCH", "OPTIONS", "RETURN TO MENU")
                for idx, lbl in enumerate(p_items):
                    ry = 222 + idx * 42
                    sel = (idx == self.pause_cursor)
                    if sel:
                        pygame.draw.rect(self.canvas, (132, 18, 52), (258, ry - 4, 284, 34))
                        pygame.draw.rect(self.canvas, (255, 206, 118), (258, ry - 4, 284, 34), 1)
                    self.fonts.draw_text(self.canvas, lbl, 400, ry + 3, size=15, color=(255, 246, 224) if sel else (206, 186, 204), style="serif", bold=sel, align="center")
        elif self.screen == ScreenState.POST_MATCH:
            win_f = self.match.p1 if self.post_p1_won else self.match.p2
            quote = random.Random(self.match.stats.total_frames).choice(DRAMATIC_QUOTES["WIN"]) if self.post_p1_won else self.match.active_rival.win_quote
            self.menus.render_post_match(
                self.canvas, self.stage, self.post_p1_won, win_f.palette_key, win_f.name,
                quote, self.match.stats, self.post_options, self.post_cursor,
            )
        elif self.screen == ScreenState.ARCADE_ENDING:
            self.menus.render_arcade_ending(self.canvas, self.stage, self.match.stats, self.app_time)
        elif self.screen == ScreenState.COMMAND_LIST:
            self.codex.render(self.canvas, self.stage, self.bank, self.app_time)
        elif self.screen == ScreenState.GALLERY:
            self.gallery.render(self.canvas, self.stage, FIXED_DT, self.app_time)
        elif self.screen == ScreenState.LORE_ARCHIVE:
            self.lore.render(self.canvas, self.stage)
        elif self.screen == ScreenState.OPTIONS:
            self.options.render(self.canvas, self.stage)

        if self.settings.crt_scanlines:
            self.canvas.blit(self._crt_overlay, (0, 0))
        if self.settings.show_fps:
            self.fonts.draw_text(self.canvas, f"{self.fps_measured:4.1f} FPS (800x600)", 786, 582, size=10, color=(158, 242, 178), style="mono", align="right")

    def present(self) -> None:
        """
        Blit 800x600 canvas to display with strict nearest-neighbor pixel scaling
        (NO anti-aliasing blur — exact PS1 optimization standard!).
        """
        if self.display is None:
            return
        dw, dh = self.display.get_size()
        if dw == INTERNAL_W and dh == INTERNAL_H:
            self.display.blit(self.canvas, (0, 0))
        else:
            # Nearest-neighbor crisp pixel stretch maintaining 4:3 aspect ratio
            scale = min(dw / float(INTERNAL_W), dh / float(INTERNAL_H))
            sw = max(1, int(INTERNAL_W * scale))
            sh = max(1, int(INTERNAL_H * scale))
            self.display.fill((0, 0, 0))
            scaled = pygame.transform.scale(self.canvas, (sw, sh))
            self.display.blit(scaled, ((dw - sw) // 2, (dh - sh) // 2))
        pygame.display.flip()

    def run(self) -> None:
        clock = pygame.time.Clock()
        try:
            while self.running:
                for ev in pygame.event.get():
                    if ev.type == pygame.QUIT:
                        self.running = False
                    elif ev.type == pygame.KEYDOWN:
                        self.handle_keydown(ev.key)
                    elif ev.type == pygame.VIDEORESIZE and not self.settings.fullscreen:
                        self.display = pygame.display.set_mode((max(400, ev.w), max(300, ev.h)), pygame.RESIZABLE)
                keys = pygame.key.get_pressed()
                self.step_frame(keys)
                self.render_canvas()
                self.present()
                clock.tick(TARGET_FPS)
                self.fps_measured = clock.get_fps()
        finally:
            self.audio.shutdown()
            pygame.quit()


