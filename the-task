@dataclass
class StageEmber:
    x: float
    y: float
    vx: float
    vy: float
    size: float
    alpha: float
    phase: float
    color: RGB


@dataclass
class FloorDecal:
    world_x: float
    world_y: float
    kind: str  # "BLOOD" or "CRACK"
    radius: float
    seed: int
    alpha: int = 210


class CursedCathedralStage:
    """Multi-layer procedural painterly stage inspired by stage.jpg,
    Ghosts'n'Goblins, and Devil May Cry 3.
    """

    def __init__(self, rast: PainterlyRasterizer) -> None:
        self.rast = rast
        self.time_sec: float = 0.0
        self.eclipse_dim: float = 0.0       # 0=normal blood sky, 1=Super Art eclipse blackout
        self.resonance_storm: float = 0.0   # 0..1 intensifies blood-red sky storm
        self.lightning_flash: float = 0.0
        self.decals: List[FloorDecal] = []
        self.embers: List[StageEmber] = []

        # Pre-baked multi-layer panoramic parallax surfaces
        self._sky_surf: Optional[pygame.Surface] = None
        self._far_ruins_surf: Optional[pygame.Surface] = None
        self._cathedral_surf: Optional[pygame.Surface] = None
        self._mid_swamp_surf: Optional[pygame.Surface] = None
        self._ground_surf: Optional[pygame.Surface] = None
        self._fg_frame_surf: Optional[pygame.Surface] = None
        self._fog_strip: Optional[pygame.Surface] = None
        self._baked_steps: int = 0

        self._init_embers()

    def _init_embers(self) -> None:
        rng = random.Random(6661)
        self.embers.clear()
        for _ in range(72):
            col = rng.choice([(255, 72, 48), (255, 134, 62), (235, 30, 56), (255, 210, 140)])
            self.embers.append(
                StageEmber(
                    x=rng.uniform(0.0, float(SCREEN_W)),
                    y=rng.uniform(40.0, float(SCREEN_H)),
                    vx=rng.uniform(-24.0, 14.0),
                    vy=rng.uniform(-44.0, -14.0),
                    size=rng.uniform(1.4, 3.6),
                    alpha=rng.uniform(110.0, 240.0),
                    phase=rng.uniform(0.0, math.tau),
                    color=col,
                )
            )

    def reset_round_decals(self) -> None:
        self.decals.clear()
        self.eclipse_dim = 0.0
        self.resonance_storm = 0.0
        self.lightning_flash = 0.0

    def add_blood_splatter(self, world_x: float, intensity: float = 1.0) -> None:
        if len(self.decals) > 95:
            self.decals.pop(0)
        self.decals.append(
            FloorDecal(
                world_x=clamp(world_x + random.uniform(-26.0, 26.0), STAGE_LEFT_WALL, STAGE_RIGHT_WALL),
                world_y=GROUND_Y + random.uniform(-6.0, 24.0),
                kind="BLOOD",
                radius=random.uniform(12.0, 28.0) * clamp(intensity, 0.5, 1.8),
                seed=random.randint(1, 99999),
                alpha=clamp_int(int(185 * intensity), 110, 235),
            )
        )

    def add_stone_crack(self, world_x: float, intensity: float = 1.0) -> None:
        if len(self.decals) > 95:
            self.decals.pop(0)
        self.decals.append(
            FloorDecal(
                world_x=clamp(world_x, STAGE_LEFT_WALL, STAGE_RIGHT_WALL),
                world_y=GROUND_Y + random.uniform(-2.0, 10.0),
                kind="CRACK",
                radius=random.uniform(22.0, 42.0) * clamp(intensity, 0.6, 1.5),
                seed=random.randint(1, 99999),
                alpha=220,
            )
        )

    def step_bake(self) -> float:
        """Progressive stage layer baking during loading screen; returns [0..1]."""
        if self._baked_steps == 0:
            self._sky_surf = self._bake_blood_sky()
        elif self._baked_steps == 1:
            self._far_ruins_surf = self._bake_far_horizon()
        elif self._baked_steps == 2:
            self._cathedral_surf = self._bake_romanesque_cathedral()
        elif self._baked_steps == 3:
            self._mid_swamp_surf = self._bake_midground_swamp_fences()
        elif self._baked_steps == 4:
            self._ground_surf = self._bake_causeway_and_mire()
        elif self._baked_steps == 5:
            self._fg_frame_surf = self._bake_foreground_silhouette()
            self._fog_strip = self._bake_volumetric_fog()
        self._baked_steps = min(6, self._baked_steps + 1)
        return self._baked_steps / 6.0

    def ensure_baked(self) -> None:
        while self._baked_steps < 6:
            self.step_bake()

    # --------------------------------------------------------------------------
    # LAYER 0: APOCALYPTIC BLOOD-RED SKY, STORM CLOUDS, GOD-RAYS & ECLIPSE MOON
    # --------------------------------------------------------------------------
    def _bake_blood_sky(self) -> pygame.Surface:
        w, h = 1520, 520
        surf = pygame.Surface((w, h))

        # Deep apocalyptic crimson sky gradient
        stops = [
            (0.00, (18, 2, 6)),
            (0.26, (66, 6, 14)),
            (0.54, (148, 14, 18)),
            (0.78, (218, 34, 24)),
            (0.94, (248, 84, 38)),
            (1.00, (176, 26, 22)),
        ]
        for y in range(h):
            u = y / float(h - 1)
            c = stops[-1][1]
            for i in range(len(stops) - 1):
                u0, c0 = stops[i]
                u1, c1 = stops[i + 1]
                if u0 <= u <= u1:
                    c = lerp_color(c0, c1, (u - u0) / max(1e-5, u1 - u0))
                    break
            pygame.draw.line(surf, c, (0, y), (w, y))

        # Painterly tumultuous storm cloud strata generated via low-res FBM smoothscale
        cw, ch = 190, 68
        cloud_lo = pygame.Surface((cw, ch), pygame.SRCALPHA)
        for cy in range(ch):
            v = cy / float(ch - 1)
            for cx in range(cw):
                u = cx / float(cw - 1)
                n1 = fbm_noise_2d(u * 5.2, v * 3.8, octaves=4, seed=404)
                n2 = fbm_noise_2d(u * 10.5 + 3.1, v * 6.5 - 1.4, octaves=3, seed=911)
                density = n1 * 0.68 + n2 * 0.32
                if density > 0.44:
                    # Fiery rim at lower edge of clouds, ominous black-crimson tops
                    t = clamp((density - 0.44) / 0.42, 0.0, 1.0)
                    if v > 0.58 and density < 0.62:
                        col = lerp_color((248, 66, 36), (255, 162, 86), t)
                        al = int(170 * t)
                    else:
                        col = lerp_color((42, 4, 10), (14, 2, 6), t)
                        al = int(210 * t)
                    cloud_lo.set_at((cx, cy), (col[0], col[1], col[2], clamp_int(al, 0, 255)))
        cloud_hi = pygame.transform.smoothscale(cloud_lo, (w, h))
        surf.blit(cloud_hi, (0, 0))

        # Painterly soft-feathered crimson god-rays (normal alpha-blended smooth rays, no pixel stair-steps!)
        ray_surf = pygame.Surface((w, h), pygame.SRCALPHA)
        origin_x, origin_y = w * 0.50, h * 0.72
        rng = random.Random(31337)
        for ri in range(14):
            ang = math.radians(-168.0 + ri * 11.5 + rng.uniform(-2.0, 2.0))
            spread = math.radians(rng.uniform(3.5, 7.2))
            dist = 920.0
            # Multi-layer feathered soft shaft (wide dim -> narrow warm core)
            for mult_s, alpha_s in ((1.45, 10), (1.0, 14), (0.52, 16)):
                sp_a = spread * mult_s
                p1 = (origin_x + math.cos(ang - sp_a) * dist, origin_y + math.sin(ang - sp_a) * dist)
                p2 = (origin_x + math.cos(ang + sp_a) * dist, origin_y + math.sin(ang + sp_a) * dist)
                pygame.draw.polygon(ray_surf, (255, 118, 64, alpha_s), [(origin_x, origin_y), p1, p2])
        surf.blit(ray_surf, (0, 0))

        # Eclipsed Blood Moon veiled high behind the crimson storm (painterly airbrushed halo!)
        mx, my = int(w * 0.50), int(h * 0.34)
        self.rast.draw_soft_glow(surf, (mx, my), 185.0, (255, 58, 28), peak_alpha=125)
        self.rast.draw_soft_glow(surf, (mx, my), 92.0, (255, 168, 92), peak_alpha=130)
        pygame.draw.circle(surf, (255, 192, 136), (mx, my), 48)
        pygame.draw.circle(surf, (24, 3, 9), (mx + 2, my + 2), 43)
        pygame.draw.circle(surf, (255, 92, 48), (mx, my), 47, 2)

        # Re-composite subtle foreground storm cloud veil partially obscuring the Blood Moon
        veil = cloud_hi.copy()
        veil.set_alpha(95)
        surf.blit(veil, (0, 0))

        return surf

    # --------------------------------------------------------------------------
    # LAYER 1: DISTANT JAGGED HILLS, RUINED AQUEDUCTS & BLOOD MIST
    # --------------------------------------------------------------------------
    def _bake_far_horizon(self) -> pygame.Surface:
        w, h = 1760, 420
        surf = pygame.Surface((w, h), pygame.SRCALPHA)

        # Distant rugged silhouetted hills
        hill_pts: List[Tuple[float, float]] = [(0, h)]
        for i in range(45):
            x = (w * i) / 44.0
            y = h * 0.56 - 68.0 * fbm_noise_2d(i * 0.22, 1.5, octaves=3, seed=202) - 24.0 * math.sin(i * 0.45)
            hill_pts.append((x, y))
        hill_pts.append((w, h))
        self.rast.fill_shaded_poly(
            surf,
            hill_pts,
            (28, 6, 12),
            (54, 10, 16),
            (92, 18, 22),
            outline_col=(168, 34, 28),
            outline_width=1,
            horizontal_grad=False,
        )

        # Distant ruined stone aqueduct arches on left & right wings
        for start_x, count in ((120, 6), (1240, 6)):
            for k in range(count):
                ax = start_x + k * 66
                ay = int(h * 0.50)
                col_s = (36, 8, 14)
                pygame.draw.rect(surf, col_s, (ax, ay, 16, 130))
                if k < count - 1 and (k != 3):
                    # Rounded Romanesque arch spanning pillars
                    pygame.draw.rect(surf, col_s, (ax + 12, ay, 54, 22))
                    pygame.draw.arc(surf, (158, 34, 28), (ax + 14, ay + 12, 48, 44), 0.0, math.pi, 3)

        # Glowing atmospheric blood-mist band fading the base
        mist_h = 130
        for row in range(mist_h):
            t = row / float(mist_h - 1)
            al = int(145 * smoothstep(t))
            pygame.draw.line(surf, (148, 26, 26, al), (0, h - mist_h + row), (w, h - mist_h + row))

        return surf

    # --------------------------------------------------------------------------
    # LAYER 2: MONUMENTAL CURSED ROMANESQUE CATHEDRAL RUINS (CENTERPIECE!)
    # --------------------------------------------------------------------------
    def _bake_romanesque_cathedral(self) -> pygame.Surface:
        w, h = 1920, 560
        surf = pygame.Surface((w, h), pygame.SRCALPHA)
        cx = w * 0.50
        base_y = h - 42

        stone_dark = (18, 8, 12)
        stone_mid = (46, 18, 22)
        stone_lit = (98, 28, 26)
        rim_fire = (232, 68, 38)

        # Helper to paint weathered Romanesque stone tower/wall with fiery crimson sky rim-light
        def draw_stone_block(rx: float, ry: float, rw: float, rh: float, broken_top: bool = True) -> None:
            pts: List[Tuple[float, float]] = [(rx, ry + rh)]
            if broken_top:
                segs = max(4, int(rw // 18))
                for si in range(segs + 1):
                    u = si / float(segs)
                    jag = (deterministic_hash(int(rx) + si, int(ry), 777) - 0.5) * 26.0
                    pts.append((rx + u * rw, ry + jag))
            else:
                pts.extend([(rx, ry), (rx + rw, ry)])
            pts.append((rx + rw, ry + rh))
            self.rast.fill_shaded_poly(
                surf,
                pts,
                stone_dark,
                stone_mid,
                stone_lit,
                rim_col=rim_fire,
                outline_col=(14, 4, 8),
                outline_width=2,
                horizontal_grad=True,
                cylindrical=True,
            )
            # Weathered stone brick lines & masonry cracks
            rng_b = random.Random(int(rx * 13 + ry * 7))
            rows = max(3, int(rh // 22))
            for r_i in range(1, rows):
                ly = ry + r_i * 22
                if ly < ry + rh - 6:
                    pygame.draw.line(surf, (16, 6, 10), (rx + 4, ly), (rx + rw - 4, ly), 1)
                    if rng_b.random() < 0.65:
                        vx = rx + rng_b.uniform(10.0, max(12.0, rw - 10.0))
                        pygame.draw.line(surf, (14, 4, 8), (vx, ly), (vx + rng_b.uniform(-4, 4), ly + 22), 1)

        # Helper to carve shadowed Romanesque rounded archway windows
        def draw_romanesque_arch(ax: float, ay: float, aw: float, ah: float, glow_inside: bool = False) -> None:
            arch_r = aw * 0.5
            pts: List[Tuple[float, float]] = [(ax, ay + ah), (ax, ay + arch_r)]
            for k in range(13):
                ang = math.pi + math.pi * (k / 12.0)
                pts.append((ax + arch_r + math.cos(ang) * arch_r, ay + arch_r + math.sin(ang) * arch_r))
            pts.append((ax + aw, ay + ah))
            inner_col = (146, 22, 22) if glow_inside else (12, 4, 8)
            pygame.draw.polygon(surf, inner_col, pts)
            if glow_inside:
                # Eerie red glow leaking through shattered nave windows
                self.rast.draw_soft_glow(surf, (ax + arch_r, ay + ah * 0.55), aw * 0.9, (255, 58, 32), peak_alpha=75, rings=4)
            # Stone voussoir rim highlight
            pygame.draw.lines(surf, rim_fire, False, pts[1:-1], 2)
            pygame.draw.polygon(surf, (14, 4, 8), pts, 2)

        # Helper to paint perched winged demonic gargoyle silhouette
        def draw_gargoyle(gx: float, gy: float, facing: float = 1.0, sc: float = 1.0) -> None:
            pts = [
                (gx - 8 * sc * facing, gy),
                (gx - 12 * sc * facing, gy - 18 * sc),
                (gx - 28 * sc * facing, gy - 34 * sc),  # Left bat wing tip
                (gx - 10 * sc * facing, gy - 26 * sc),
                (gx - 4 * sc * facing, gy - 34 * sc),   # Horned head
                (gx + 6 * sc * facing, gy - 30 * sc),
                (gx + 24 * sc * facing, gy - 42 * sc),  # Raised right wing tip
                (gx + 16 * sc * facing, gy - 20 * sc),
                (gx + 10 * sc * facing, gy - 10 * sc),
                (gx + 12 * sc * facing, gy),
            ]
            pygame.draw.polygon(surf, (16, 6, 10), pts)
            pygame.draw.lines(surf, rim_fire, False, pts[2:8], 2)

        # 1. Flanking ruined cathedral nave colonnades (left & right wings)
        draw_stone_block(cx - 460, base_y - 230, 260, 230, broken_top=True)
        draw_stone_block(cx + 200, base_y - 245, 260, 245, broken_top=True)
        for wi in range(3):
            draw_romanesque_arch(cx - 425 + wi * 74, base_y - 165, 44, 130, glow_inside=(wi == 1))
            draw_romanesque_arch(cx + 235 + wi * 74, base_y - 175, 44, 138, glow_inside=(wi == 1))

        # 2. Central Monumental Romanesque Nave & Broken Gable Roof
        nave_poly = [
            (cx - 210, base_y),
            (cx - 210, base_y - 310),
            (cx - 125, base_y - 345),
            (cx - 40, base_y - 432),
            (cx + 12, base_y - 455),
            (cx + 68, base_y - 392),
            (cx + 145, base_y - 356),
            (cx + 210, base_y - 304),
            (cx + 210, base_y),
        ]
        self.rast.fill_shaded_poly(
            surf,
            nave_poly,
            stone_dark,
            stone_mid,
            stone_lit,
            rim_col=rim_fire,
            outline_col=(10, 3, 6),
            outline_width=2,
            horizontal_grad=True,
            cylindrical=True,
        )

        # Grand central ruined portal archway & cursed crimson altar glow
        draw_romanesque_arch(cx - 72, base_y - 210, 144, 210, glow_inside=True)
        # Inner stepped concentric Romanesque portal moldings
        draw_romanesque_arch(cx - 52, base_y - 186, 104, 186, glow_inside=False)

        # Shattered Romanesque Rose Window above the main portal!
        rose_cx, rose_cy, rose_r = int(cx), int(base_y - 294), 56
        self.rast.draw_soft_glow(surf, (rose_cx, rose_cy), 88.0, (255, 48, 28), peak_alpha=95, rings=5)
        pygame.draw.circle(surf, (16, 4, 8), (rose_cx, rose_cy), rose_r + 6)
        pygame.draw.circle(surf, (198, 34, 26), (rose_cx, rose_cy), rose_r)
        pygame.draw.circle(surf, (26, 6, 12), (rose_cx, rose_cy), rose_r - 12)
        # Radial gothic stone tracery spokes (partially broken for ruin feel!)
        for sp in range(12):
            if sp in (2, 7):
                continue  # Shattered missing spokes
            a = (math.tau * sp) / 12.0
            pygame.draw.line(
                surf,
                (18, 6, 10),
                (rose_cx, rose_cy),
                (rose_cx + math.cos(a) * rose_r, rose_cy + math.sin(a) * rose_r),
                4,
            )
        pygame.draw.circle(surf, rim_fire, (rose_cx, rose_cy), rose_r + 3, 2)

        # 3. Massive flanking cylindrical Romanesque Bell Towers with buttresses
        draw_stone_block(cx - 266, base_y - 386, 86, 386, broken_top=True)
        draw_stone_block(cx + 180, base_y - 404, 88, 404, broken_top=True)
        # Cylindrical turret window slits
        for ty in (base_y - 320, base_y - 210, base_y - 110):
            draw_romanesque_arch(cx - 238, ty, 28, 62, glow_inside=(ty == base_y - 320))
            draw_romanesque_arch(cx + 210, ty - 8, 28, 66, glow_inside=(ty == base_y - 320))

