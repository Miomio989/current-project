    def _on_edit_crop_changed(self) -> None:
        if not hasattr(self, "edit_crop_dims"):
            return
        r = self.edit_canvas.crop_doc_rect()
        if r is None:
            self.edit_crop_dims.setText("\u2014")
        else:
            self.edit_crop_dims.setText(
                f"{r.width()} \u00d7 {r.height()}  \u00b7  {self.edit_canvas.crop_aspect_key()}"
            )

    def _edit_apply_crop(self) -> None:
        r = self.edit_canvas.crop_doc_rect()
        if r is None:
            self._flash_summary("Draw a crop frame first (CROP tool).")
            return
        old_w = float(self.edit_base.width()) if self.edit_base is not None else 1.0
        old_h = float(self.edit_base.height()) if self.edit_base is not None else 1.0
        self._edit_push_undo()
        if self.edit_canvas.apply_crop(r):
            self.edit_base = self.edit_canvas.document()
            new_w = max(1.0, float(self.edit_base.width()))
            new_h = max(1.0, float(self.edit_base.height()))
            if self.edit_flares:
                scale_ratio = min(old_w, old_h) / max(1.0, min(new_w, new_h))
                kept_flares: List[Dict[str, Any]] = []
                for f in self.edit_flares:
                    nx = (float(f.get("x", 0.5)) * old_w - r.left()) / new_w
                    ny = (float(f.get("y", 0.5)) * old_h - r.top()) / new_h
                    if -0.6 <= nx <= 1.6 and -0.6 <= ny <= 1.6:
                        nf = dict(f)
                        nf["x"], nf["y"] = nx, ny
                        nf["scale"] = max(30, min(250, int(round(int(f.get("scale", 100)) * scale_ratio))))
                        kept_flares.append(nf)
                self.edit_flares = kept_flares
                self._edit_flare_sel = min(self._edit_flare_sel, len(self.edit_flares) - 1)
                self._sync_flare_ui()
            self._edit_recompute_now()
            self._update_split_info()
            if hasattr(self, "edit_stage_doc_lbl"):
                self.edit_stage_doc_lbl.setText(
                    f"{os.path.basename(self.edit_source_path or 'image')}  \u00b7  "
                    f"{self.edit_base.width()}\u00d7{self.edit_base.height()}"
                )
            self._flash_summary(
                f"Cropped to {self.edit_base.width()}\u00d7{self.edit_base.height()} \u2014 "
                "applied in memory only (Ctrl+Z undoes)"
            )
            STUDIO_LOG.info("SYS", f"Editor: cropped to {self.edit_base.width()}x{self.edit_base.height()}")

