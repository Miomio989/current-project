def dir_to_numpad(dx: int, dy: int, facing_right: bool) -> int:
    fx = dx if facing_right else -dx
    row = 7 if dy < 0 else (1 if dy > 0 else 4)
    col = 0 if fx < 0 else (2 if fx > 0 else 1)
    return row + col


class InputBuffer:
    """18-frame fighting-game motion parser with generous KoF XIII / BlazBlue leniency."""

    def __init__(self) -> None:
        self.frames: Deque[InputFrame] = collections.deque(maxlen=24)
        self.history_log: Deque[Tuple[int, InputButton]] = collections.deque(maxlen=14)
        self._prev_buttons: InputButton = InputButton.NONE
        self._last_logged_num: int = 5

    def push(self, dx: int, dy: int, buttons: InputButton, facing_right: bool) -> InputFrame:
        pressed = buttons & ~self._prev_buttons
        self._prev_buttons = buttons
        fr = InputFrame(dx=dx, dy=dy, buttons=buttons, pressed=pressed)
        self.frames.append(fr)
        num = dir_to_numpad(dx, dy, facing_right)
        if pressed != InputButton.NONE or num != self._last_logged_num:
            self.history_log.appendleft((num, pressed))
            self._last_logged_num = num
        return fr

    def latest(self) -> InputFrame:
        return self.frames[-1] if self.frames else InputFrame()

    def button_pressed(self, btn: InputButton, window: int = 5) -> bool:
        if not self.frames:
            return False
        n = len(self.frames)
        for i in range(max(0, n - window), n):
            if self.frames[i].pressed & btn:
                return True
        return False

    def match_motion(self, seq: Sequence[int], facing_right: bool, window: int = 16) -> bool:
        if not self.frames:
            return False
        n = len(self.frames)
        start = max(0, n - window)
        pos = 0
        for i in range(start, n):
            f = self.frames[i]
            np = dir_to_numpad(f.dx, f.dy, facing_right)
            if np == seq[pos]:
                pos += 1
                if pos >= len(seq):
                    return True
        return False

    def match_double_tap(self, target_dir: int, facing_right: bool, window: int = 12) -> bool:
        if len(self.frames) < 3:
            return False
        n = len(self.frames)
        start = max(0, n - window)
        stage = 0  # 0=want target, 1=want neutral, 2=want target again
        for i in range(start, n):
            np = dir_to_numpad(self.frames[i].dx, self.frames[i].dy, facing_right)
            if stage == 0 and np == target_dir:
                stage = 1
            elif stage == 1 and np == 5:
                stage = 2
            elif stage == 2 and np == target_dir:
                return True
        return False


class InputManager:
    def __init__(self) -> None:
        self.p1_bind = default_p1_bindings()
        self.p2_bind = default_p2_bindings()
        self.joysticks: List[pygame.joystick.Joystick] = []
        self._init_joysticks()

    def _init_joysticks(self) -> None:
        try:
            pygame.joystick.init()
            for i in range(pygame.joystick.get_count()):
                js = pygame.joystick.Joystick(i)
                js.init()
                self.joysticks.append(js)
        except Exception:
            pass

    def poll_player(self, player_idx: int, allow_arrows_for_p1: bool = True) -> Tuple[int, int, InputButton]:
        keys = pygame.key.get_pressed()
        b = self.p1_bind if player_idx == 0 else self.p2_bind
        dx = 0
        dy = 0
        if keys[b.left] or (player_idx == 0 and allow_arrows_for_p1 and keys[pygame.K_LEFT]):
            dx -= 1
        if keys[b.right] or (player_idx == 0 and allow_arrows_for_p1 and keys[pygame.K_RIGHT]):
            dx += 1
        if keys[b.up] or (player_idx == 0 and allow_arrows_for_p1 and keys[pygame.K_UP]):
            dy -= 1
        if keys[b.down] or (player_idx == 0 and allow_arrows_for_p1 and keys[pygame.K_DOWN]):
            dy += 1

        btns = InputButton.NONE
        if keys[b.btn_a]: btns |= InputButton.A
        if keys[b.btn_b]: btns |= InputButton.B
        if keys[b.btn_c]: btns |= InputButton.C
        if keys[b.btn_d]: btns |= InputButton.D
        if keys[b.btn_throw]: btns |= InputButton.THROW
        if keys[b.btn_shadow]: btns |= InputButton.SHADOW
        if keys[b.btn_burst]: btns |= InputButton.BURST
        if keys[b.btn_taunt]: btns |= InputButton.TAUNT

        # Optional USB Gamepad polling
        if player_idx < len(self.joysticks):
            js = self.joysticks[player_idx]
            try:
                ax = js.get_axis(0)
                ay = js.get_axis(1)
                if ax < -0.45: dx = -1
                elif ax > 0.45: dx = 1
                if ay < -0.45: dy = -1
                elif ay > 0.45: dy = 1
                if js.get_numhats() > 0:
                    hx, hy = js.get_hat(0)
                    if hx != 0: dx = hx
                    if hy != 0: dy = -hy
                nb = js.get_numbuttons()
                if nb > 0 and js.get_button(0): btns |= InputButton.A
                if nb > 1 and js.get_button(1): btns |= InputButton.B
                if nb > 2 and js.get_button(2): btns |= InputButton.C
                if nb > 3 and js.get_button(3): btns |= InputButton.D
                if nb > 4 and js.get_button(4): btns |= InputButton.THROW
                if nb > 5 and js.get_button(5): btns |= InputButton.SHADOW
                if nb > 6 and js.get_button(6): btns |= InputButton.BURST
            except Exception:
                pass

        return (dx, dy, btns)


