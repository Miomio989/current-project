    def eventFilter(self, obj, event) -> bool:  # noqa: N802
        # Ctrl+Enter straight from the prompt editors fires GENERATE.
        if (
            obj is self.prompt_edit or obj is self.neg_edit
        ) and isinstance(event, QKeyEvent) and event.type() == QEvent.Type.KeyPress:
            if event.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter) and (
                event.modifiers() & Qt.KeyboardModifier.ControlModifier
            ):
                self.on_generate()
                return True
        return super().eventFilter(obj, event)

    # ------------------------------------------------------------------ Settings Round-Trip
    def _apply_settings(self) -> None:
        s = self.settings
        ui = s.get("ui") or {}
        set_theme(str(ui.get("theme") or "gold"))
        self._apply_theme_chrome(float(ui.get("font_scale") or 1.0))

        model = str(s.get("model") or DEFAULT_MODEL)
        if model not in MODELS:
            model = DEFAULT_MODEL
        self.model_btns[model].setChecked(True)
        self._active_model_key = model_stack_key(model)

        self.prompt_edit.setPlainText(str(s.get("prompt") or ""))
        self.neg_edit.setPlainText(self._negatives.get(self._active_model_key, ""))
        self._update_negative_header()
        neg_vis = bool(s.get("negative_visible", False))
        self.neg_btn.setChecked(neg_vis)
        self.neg_section.set_expanded(neg_vis)
        self.preview_section.set_expanded(bool(s.get("preview_visible", False)))
        self.prompt_sliders_section.set_expanded(bool(s.get("sliders_drawer_visible", True)))
        self.i2i_section.set_expanded(bool(s.get("img2img_visible", False)))

        self.aspect.set_current(str(s.get("aspect") or "1:1"))
        self.seed_edit.setText(str(s.get("seed") or ""))
        self.n_spin.setValue(max(1, min(4, int(s.get("n") or 1))))
        self.direct_save_check.setChecked(bool(s.get("save_direct", False)))
        self.queue.save_direct = self.direct_save_check.isChecked()

        tset = str(s.get("template_set") or self._active_model_key)
        self.tpl_set_btns.get(tset, self.tpl_set_btns["krea"]).setChecked(True)

        opts = s.get("options") or DEFAULT_OPTIONS
        for k, cb in self.opt_checks.items():
            cb.setChecked(bool(opts.get(k, DEFAULT_OPTIONS[k])))

        adv = s.get("advanced") or {}
        self.override_check.setChecked(bool(adv.get("override", False)))
        self._set_combo(self.sampler_combo, str(adv.get("sampler") or "er_sde"))
        self._set_combo(self.scheduler_combo, str(adv.get("scheduler") or "simple"))
        self.steps_spin.setValue(int(adv.get("steps") or 10))
        self.cfg_spin.setValue(float(adv.get("cfg") or 1.0))
        self.clip_spin.setValue(int(adv.get("clip_skip") or 0))
        self.custom_size_check.setChecked(bool(adv.get("custom_size", False)))
        self.w_spin.setValue(int(adv.get("width") or 1024))
        self.h_spin.setValue(int(adv.get("height") or 1024))
        self._on_override_toggled(self.override_check.isChecked())
        self._on_size_changed()

        # ---- v4 preferences: sounds, editor, custom-aspect echo row ----
        ui_sounds = ui.get("sounds") or {}
        SOUNDS.set_prefs(
            bool(ui_sounds.get("enabled", True)),
            {ev: bool(ui_sounds.get(ev, True)) for ev in SOUND_EVENT_LABELS},
        )
        if hasattr(self, "sound_master_check"):
            self._apply_sound_ui()
        if hasattr(self, "edit_brush_size"):
            eb = ui.get("edit_brush") or {}
            self.edit_brush_size.setValue(max(4, min(400, int(eb.get("size", 48)))))
            self.edit_brush_soft.setValue(max(0, min(100, int(eb.get("soft", 45)))))
            self.edit_mask_opaque_btn.setChecked(bool(eb.get("opaque", True)))
            if hasattr(self, "edit_mask_vis_btn"):
                self.edit_mask_vis_btn.setChecked(bool(eb.get("mask_visible", True)))
            scope = str(eb.get("scope", "full"))
            if scope == "mask":
                self.edit_scope_mask.setChecked(True)
            elif scope == "unmask":
                self.edit_scope_unmask.setChecked(True)
            else:
                self.edit_scope_full.setChecked(True)
            self._on_edit_brush_changed()
            # v4.2: retouch brush preferences
            self.edit_paint_size.setValue(max(2, min(400, int(eb.get("paint_size", 36)))))
            self.edit_paint_soft.setValue(max(0, min(100, int(eb.get("paint_soft", 55)))))
            self.edit_paint_opacity.setValue(max(5, min(100, int(eb.get("paint_opacity", 100)))))
            pcol = QColor(str(eb.get("paint_color") or "#ffffff"))
            if pcol.isValid():
                self.edit_canvas.set_paint_color(pcol)
            self._sync_paint_swatch()
            self.edit_delete_original_check.setChecked(bool(ui.get("edit_delete_original", False)))
            ea = ui.get("edit_adjust") or {}
            for k, sl in self.edit_sliders.items():
                try:
                    v = int(max(-100, min(100, int(round(float(ea.get(k, 0) or 0))))))
                except (TypeError, ValueError):
                    v = 0
                sl.blockSignals(True)
                sl.setValue(v)
                sl.blockSignals(False)
                self.edit_adjust[k] = float(v)
                self.edit_slider_vals[k].setText(str(v))
            # v4.1 editor preferences: LUT grade, flare defaults, split studio
            elut = ui.get("edit_lut") or {}
            lut_key = str(elut.get("key") or "")
