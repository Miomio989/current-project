            notes = (r, r, r + 12, r, r + 1, r, r + 7, r, r, r + 12, r, r + 3, r + 1, r, r + 7, r + 10)
            acc = (1, 0, 1, 0, 2, 0, 1, 0, 1, 2, 0, 1, 0, 0, 1, 2)
        elif pattern_id == 1:
            notes = (r, 0, r, r + 12, r, r + 7, 0, r + 8, r, 0, r + 12, r, r + 10, r + 7, r + 1, r)
            acc = (1, 0, 0, 1, 0, 2, 0, 1, 1, 0, 1, 0, 2, 0, 1, 0)
        elif pattern_id == 2:
            notes = (r, r, r, r + 12, r, r, r + 1, r + 13, r, r, r + 7, r + 12, r + 8, r + 7, r + 1, r)
            acc = (1, 0, 0, 1, 0, 0, 1, 2, 1, 0, 1, 0, 2, 1, 0, 0)
        else:
