class CameraDirector:
    """AAA dynamic fighting-game camera with smooth fighter framing, auto-zoom,
    directional hit-shake, and dramatic Super/Clash/KO close-ups.
    """

    def __init__(self) -> None:
        self.x: float = STAGE_CENTER_X
        self.y: float = GROUND_Y - 190.0
        self.zoom: float = CAM_DEFAULT_ZOOM
        self.target_x: float = STAGE_CENTER_X
        self.target_y: float = GROUND_Y - 190.0
        self.target_zoom: float = CAM_DEFAULT_ZOOM

        self.shake_mag: float = 0.0
        self.shake_x: float = 0.0
        self.shake_y: float = 0.0
        self.dramatic_focus_timer: int = 0
        self.dramatic_x: float = STAGE_CENTER_X
        self.dramatic_y: float = GROUND_Y - 170.0
        self.dramatic_zoom: float = 1.24

    def reset(self) -> None:
        self.x = self.target_x = STAGE_CENTER_X
        self.y = self.target_y = GROUND_Y - 190.0
        self.zoom = self.target_zoom = CAM_DEFAULT_ZOOM
        self.shake_mag = 0.0
        self.shake_x = 0.0
        self.shake_y = 0.0
        self.dramatic_focus_timer = 0

    def add_shake(self, intensity: float, enabled: bool = True) -> None:
        if not enabled:
            return
        self.shake_mag = min(28.0, max(self.shake_mag, intensity))

    def trigger_dramatic_zoom(
        self, focus_x: float, focus_y: float, zoom: float = 1.26, duration: int = 26
    ) -> None:
        self.dramatic_focus_timer = max(self.dramatic_focus_timer, duration)
        self.dramatic_x = focus_x
        self.dramatic_y = focus_y
        self.dramatic_zoom = clamp(zoom, CAM_MIN_ZOOM, CAM_MAX_ZOOM)

    def update(self, f1: Fighter, f2: Fighter, dt: float) -> None:
        if self.dramatic_focus_timer > 0:
            self.dramatic_focus_timer -= 1
            self.target_x = self.dramatic_x
            self.target_y = self.dramatic_y
            self.target_zoom = self.dramatic_zoom
        else:
            mid_x = (f1.x + f2.x) * 0.5
            dist_x = abs(f1.x - f2.x)
            min_y = min(f1.y, f2.y)

            # Auto-zoom tightens smoothly during close swordplay & widens at long range
            if dist_x < 260.0:
                want_zoom = 1.09
            elif dist_x < 580.0:
                want_zoom = lerp(1.09, 0.98, (dist_x - 260.0) / 320.0)
            else:
                want_zoom = lerp(0.98, CAM_MIN_ZOOM, clamp((dist_x - 580.0) / 420.0, 0.0, 1.0))

            # Lift camera cleanly when either fighter jumps or gets launched skyward
            air_lift = max(0.0, GROUND_Y - min_y) * 0.36
            self.target_x = mid_x
            self.target_y = (GROUND_Y - 195.0) - air_lift
            self.target_zoom = clamp(want_zoom, CAM_MIN_ZOOM, CAM_MAX_ZOOM)

        # Keep camera strictly inside cathedral swamp stage edges
        half_vis_w = (HALF_W / max(0.6, self.target_zoom))
        min_cam_x = max(0.0, half_vis_w - 24.0)
        max_cam_x = min(STAGE_WIDTH, STAGE_WIDTH - half_vis_w + 24.0)
        if min_cam_x < max_cam_x:
            self.target_x = clamp(self.target_x, min_cam_x, max_cam_x)

        smooth = min(1.0, dt * 8.5)
        self.x = lerp(self.x, self.target_x, smooth)
        self.y = lerp(self.y, self.target_y, smooth)
        self.zoom = lerp(self.zoom, self.target_zoom, min(1.0, dt * 6.5))

        if self.shake_mag > 0.25:
            ang = random.uniform(0.0, math.tau)
            self.shake_x = math.cos(ang) * self.shake_mag
            self.shake_y = math.sin(ang) * self.shake_mag
            self.shake_mag *= 0.80
        else:
            self.shake_mag = 0.0
            self.shake_x = 0.0
            self.shake_y = 0.0

    def world_to_screen(self, wx: float, wy: float) -> Tuple[float, float]:
        sx = HALF_W + (wx - self.x) * self.zoom + self.shake_x
        sy = HALF_H + (wy - self.y) * self.zoom + self.shake_y
        return (sx, sy)


class VFXManager:
    """High-performance particle, gore, slash-spark, shockwave, afterimage & projectile host."""

    def __init__(self, settings: GameSettings, rast: PainterlyRasterizer) -> None:
        self.settings = settings
        self.rast = rast
        self.particles: List[Particle] = []
        self.rings: List[ShockwaveRing] = []
        self.afterimages: List[Afterimage] = []
        self.projectiles: List[BloodMoonProjectile] = []
        self.callouts: List[TacticalCallout] = []
        self.cut_in: SuperCutInState = SuperCutInState()
        self.screen_flash_alpha: float = 0.0
        self.screen_flash_color: RGB = (255, 42, 60)

        # Pre-baked gothic arcane sigil for Parry / Resonance / Super impacts
        self._arcane_crimson = generate_arcane_sigil_surface(220, (238, 22, 54), (255, 210, 140), 210)
        self._arcane_gold = generate_arcane_sigil_surface(220, (255, 206, 74), (255, 250, 220), 220)

    def reset_round(self) -> None:
        self.particles.clear()
        self.rings.clear()
        self.afterimages.clear()
        self.projectiles.clear()
        self.callouts.clear()
        self.cut_in = SuperCutInState()
        self.screen_flash_alpha = 0.0

    def _cap(self) -> int:
        return 360 if self.settings.particle_high else 180

    def _push_particle(self, p: Particle) -> None:
        cap = self._cap()
        if len(self.particles) >= cap:
            self.particles.pop(0)
        self.particles.append(p)

    def add_screen_flash(self, color: RGB, alpha: float = 140.0) -> None:
        self.screen_flash_color = color
        self.screen_flash_alpha = max(self.screen_flash_alpha, alpha)

    def add_callout(
        self, side: int, text: str, subtext: str = "", color: RGB = UI_CRIMSON_GLOW, duration: int = 58
    ) -> None:
        # Keep max 3 active callouts per side for crystal readability
        same_side = [c for c in self.callouts if c.side == side]
        if len(same_side) >= 3:
            self.callouts.remove(same_side[0])
        self.callouts.append(TacticalCallout(side, text, subtext, color, duration, duration))

    def trigger_cut_in(
        self,
        player_idx: int,
        palette_idx: int,
        title: str,
        subtitle: str,
        is_fatal: bool = False,
        duration: int = 38,
    ) -> None:
        self.cut_in = SuperCutInState(
            active=True,
            timer=duration,
            max_timer=duration,
            player_idx=player_idx,
            palette_idx=palette_idx,
            title=title,
            subtitle=subtitle,
            is_fatal=is_fatal,
        )

    def spawn_afterimage(self, fighter: Fighter, sprite: pygame.Surface, tint: RGB, life: int = 10) -> None:
        if len(self.afterimages) > 26:
            self.afterimages.pop(0)
        ghost = SpriteBank.make_tinted_ghost(sprite, tint, 155)
        self.afterimages.append(Afterimage(fighter.x, fighter.y, ghost, life, life))

    def spawn_slash_hit(
        self,
        wx: float,
        wy: float,
        dir_sign: float,
        pal: CeciliaPalette,
        intensity: float = 1.0,
        is_counter: bool = False,
        is_lethal: bool = False,
    ) -> None:
        """Spawn visceral R18+ arterial blood spray + glowing crimson slash burst!"""
        mult = 1.0 if self.settings.particle_high else 0.55
        # Expanding slash impact ring
        self.rings.append(
            ShockwaveRing(
                wx, wy, 12.0, (92.0 + 42.0 * intensity),
                (255, 226, 120) if is_counter else pal.slash_outer,
                life=14 if not is_counter else 20,
                max_life=14 if not is_counter else 20,
                thickness=5 if is_counter else 3,
                is_arcane=is_counter or is_lethal,
            )
        )

        # Razor diagonal slash cross lines
        for _ in range(max(2, int(4 * intensity))):
            ang = random.uniform(-1.3, 1.3)
            spd = random.uniform(8.0, 18.0) * intensity
            self._push_particle(
                Particle(
                    x=wx, y=wy,
                    vx=math.cos(ang) * spd * dir_sign,
                    vy=math.sin(ang) * spd,
                    size=random.uniform(18.0, 42.0) * intensity,
                    color=pal.slash_core if random.random() < 0.45 else pal.slash_outer,
                    alpha=245.0, life=10, max_life=10,
                    kind="SLASH_LINE", drag=0.88, angle=ang, additive=True,
                )
            )

        # R18+ Arterial crimson blood fountain (Samurai Shodown / Ninja Gaiden Sigma choreography!)
        blood_count = int((14 + 16 * intensity) * mult * (1.6 if is_lethal else 1.0))
        explicit = self.settings.gore_explicit
        for _ in range(max(4, blood_count)):
            spread = random.uniform(-0.85, 0.72)
            spd = random.uniform(4.5, 19.5) * (0.75 + 0.45 * intensity)
            col = (
                random.choice([(176, 8, 22), (218, 16, 34), (128, 4, 16), (242, 34, 48)])
                if explicit
                else random.choice([pal.aura_primary, pal.accent_base, pal.aura_secondary])
            )
            life = random.randint(18, 38)
            self._push_particle(
                Particle(
                    x=wx + random.uniform(-10.0, 10.0),
                    y=wy + random.uniform(-14.0, 14.0),
                    vx=math.cos(spread) * spd * dir_sign + random.uniform(-2.0, 2.0),
                    vy=math.sin(spread) * spd - random.uniform(2.0, 7.5),
                    size=random.uniform(2.6, 6.8) * (0.85 + 0.35 * intensity),
                    color=col, alpha=235.0, life=life, max_life=life,
                    kind="BLOOD" if explicit else "EMBER",
                    gravity=0.58 if explicit else 0.16,
                    drag=0.97,
                    additive=not explicit,
                    splat_on_ground=explicit and (random.random() < 0.32),
                )
            )

        # Hot metallic blade sparks
        spark_n = max(4, int((8 + 8 * intensity) * mult))
        for _ in range(spark_n):
            ang = random.uniform(0.0, math.tau)
            spd = random.uniform(6.0, 20.0)
            life = random.randint(10, 20)
            self._push_particle(
                Particle(
                    x=wx, y=wy, vx=math.cos(ang) * spd, vy=math.sin(ang) * spd,
                    size=random.uniform(2.0, 4.2),
                    color=(255, 240, 196) if is_counter else pal.rune_glow_core,
                    alpha=255.0, life=life, max_life=life,
                    kind="SPARK", gravity=0.22, drag=0.92, additive=True,
                )
            )

        if is_counter:
            self.add_screen_flash((255, 58, 68), 110.0)
        elif is_lethal:
            self.add_screen_flash((255, 24, 42), 185.0)

    def spawn_guard_sparks(
        self, wx: float, wy: float, dir_sign: float, just_guard: bool = False, crush: bool = False
    ) -> None:
        col_ring = (255, 224, 110) if just_guard else ((92, 212, 255) if not crush else (255, 92, 128))
        self.rings.append(
            ShockwaveRing(
                wx, wy, 10.0, 138.0 if (just_guard or crush) else 72.0,
                col_ring, life=18 if just_guard else 12, max_life=18 if just_guard else 12,
                thickness=5 if just_guard else 3, is_arcane=just_guard,
            )
        )
        n = 26 if (just_guard or crush) else 12
        for _ in range(n):
            ang = random.uniform(-1.3, 1.3)
            spd = random.uniform(6.0, 21.0)
            life = random.randint(12, 24)
            kind = "SHARD" if crush else "SPARK"
            self._push_particle(
                Particle(
                    x=wx, y=wy,
                    vx=math.cos(ang) * spd * (-dir_sign if not crush else random.choice([-1, 1])),
                    vy=math.sin(ang) * spd - 3.0,
                    size=random.uniform(3.0, 7.5 if crush else 4.5),
                    color=col_ring if random.random() < 0.6 else (255, 255, 255),
                    alpha=255.0, life=life, max_life=life,
                    kind=kind, gravity=0.35, drag=0.93,
                    angle=random.uniform(0.0, math.tau), ang_vel=random.uniform(-0.3, 0.3),
                    additive=not crush,
                )
            )
        if just_guard:
            self.add_screen_flash((255, 232, 145), 95.0)
        elif crush:
            self.add_screen_flash((120, 216, 255), 125.0)

