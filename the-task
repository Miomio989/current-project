    def make_bars(
        chords: Sequence[Tuple[int, int, int]],
        bass_sets: Sequence[Tuple[int, ...]],
        acc_sets: Sequence[Tuple[int, ...]],
        lead_sets: Sequence[Tuple[int, ...]],
        arp_sets: Sequence[Tuple[int, ...]],
        timeline: Sequence[Tuple[str, str, int, float, float, float, float, float, float, float, float]],
    ) -> Tuple[BarSectionSpec, ...]:
        """Expand a full multi-movement song form into explicit bar-by-bar arrangements."""
        out: List[BarSectionSpec] = []
        bar_cursor = 0
        for (sec_name, kit, n_bars, c0, c1, res, pg, lg, ag, sc, en) in timeline:
            for bi in range(n_bars):
                u0 = bi / float(max(1, n_bars))
                u1 = (bi + 1) / float(max(1, n_bars))
                ch = chords[bar_cursor % len(chords)]
                bp = bass_sets[bar_cursor % len(bass_sets)]
                ac = acc_sets[bar_cursor % len(acc_sets)]
                lp = lead_sets[bar_cursor % len(lead_sets)]
                ap = arp_sets[bar_cursor % len(arp_sets)]
                # Insert dramatic breakbeat fill on the last bar of 8-bar sections
                actual_kit = "FILL" if (n_bars >= 8 and bi == n_bars - 1 and kit in ("DROP_A", "BREAKBEAT", "PULSE")) else kit
                out.append(
                    BarSectionSpec(
                        section_name=sec_name,
                        chord_midi=ch,
                        bass_pattern=bp,
                        bass_accent=ac,
                        lead_pattern=lp if lg > 0.01 else (0,) * 16,
                        arp_pattern=ap if ag > 0.01 else (0,) * 16,
                        drum_kit_style=actual_kit,
                        cutoff_start=lerp(c0, c1, u0),
                        cutoff_end=lerp(c0, c1, u1),
                        resonance=res,
                        pad_gain=pg,
                        lead_gain=lg,
                        arp_gain=ag,
                        sidechain_depth=sc,
                        energy=en,
                    )
                )
                bar_cursor += 1
        return tuple(out)

