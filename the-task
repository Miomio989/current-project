def generate_arcane_sigil_surface(
    size: int,
    primary_color: RGB,
    accent_color: RGB,
) -> pygame.Surface:
    surf = pygame.Surface((size, size), pygame.SRCALPHA)
    c = size // 2
    r_out = int(size * 0.46)
    r_mid = int(size * 0.37)
    r_in = int(size * 0.25)
    pygame.draw.circle(surf, with_alpha(primary_color, 190), (c, c), r_out, 2)
    pygame.draw.circle(surf, with_alpha(accent_color, 150), (c, c), r_mid, 1)
    pygame.draw.circle(surf, with_alpha(primary_color, 175), (c, c), r_in, 2)
    for i in range(24):
        a = i * math.tau / 24.0
        p0 = (int(c + math.cos(a) * r_mid), int(c + math.sin(a) * r_mid))
        p1 = (int(c + math.cos(a) * r_out), int(c + math.sin(a) * r_out))
        pygame.draw.line(surf, with_alpha(accent_color, 145), p0, p1, 1)
    for offset in (0.0, math.pi / 3.0):
        tri = [
            (int(c + math.cos(offset + k * math.tau / 3.0) * r_mid), int(c + math.sin(offset + k * math.tau / 3.0) * r_mid))
            for k in range(3)
        ]
        pygame.draw.polygon(surf, with_alpha(primary_color, 175), tri, 2)
    pygame.draw.circle(surf, with_alpha(accent_color, 210), (c, c), int(r_in * 0.55), 2)
    return surf


def _draw_gothic_stylish_letter(
    dest: pygame.Surface,
    rast: PainterlyRasterizer,
    letter: str,
    x: float,
    y: float,
    w: float,
    h: float,
    col_hi: RGB,
    col_mid: RGB,
    col_lo: RGB,
) -> None:
    """Draw a sharp, italicized, sword-beveled DMC4/Bayonetta vector rank letter."""
    sk = w * 0.22  # Dramatic forward italic slant
    strokes: List[List[Tuple[float, float]]] = []
    if letter == "S":
        strokes = [
            [(0.95, 0.08), (0.42, 0.02), (0.12, 0.22), (0.22, 0.44), (0.86, 0.54), (0.94, 0.78), (0.58, 0.98), (0.05, 0.90)],
        ]
    elif letter == "A":
        strokes = [
            [(0.06, 0.96), (0.52, 0.04), (0.94, 0.96)],
            [(0.24, 0.64), (0.80, 0.60)],
        ]
    elif letter == "B":
        strokes = [
            [(0.16, 0.06), (0.16, 0.94)],
            [(0.16, 0.08), (0.76, 0.12), (0.86, 0.30), (0.68, 0.48), (0.16, 0.50)],
            [(0.16, 0.50), (0.82, 0.54), (0.92, 0.76), (0.72, 0.94), (0.16, 0.94)],
        ]
    elif letter == "C":
        strokes = [
            [(0.90, 0.18), (0.50, 0.04), (0.14, 0.26), (0.10, 0.74), (0.48, 0.96), (0.90, 0.82)],
        ]
    else:  # "D"
        strokes = [
            [(0.16, 0.06), (0.16, 0.94)],
            [(0.16, 0.08), (0.68, 0.14), (0.92, 0.48), (0.70, 0.88), (0.16, 0.94)],
        ]

    for st in strokes:
        pts = [Vec2(x + px * w + (1.0 - py) * sk, y + py * h) for px, py in st]
        curve = sample_catmull_rom(pts, steps_per_seg=6)
        m = len(curve)
        ws = [w * (0.14 + 0.07 * math.sin((i / float(max(1, m - 1))) * math.pi)) for i in range(m)]
        # Drop shadow
        sh_pts = [p + Vec2(3.0, 4.0) for p in curve]
        rast.paint_soft_shadow_poly(dest, build_variable_ribbon(sh_pts, [v * 1.15 for v in ws]), (16, 4, 14), alpha=230)
        # Beveled metallic painted letter
        rast.paint_shaded_poly(
            dest,
            build_variable_ribbon(curve, ws),
            color_light=col_hi,
            color_mid=col_mid,
            color_shadow=col_lo,
            light_dir=(0.25, -0.96),
            rim_color=(255, 248, 240),
            rim_strength=0.55,
            outline_color=(24, 6, 16),
            outline_width=1.6,
            cel_cut=0.45,
        )


def bake_stylish_rank_emblems(rast: PainterlyRasterizer) -> Dict[StyleRank, pygame.Surface]:
    """Bake vivid DMC4 / Bayonetta / mockup.jpg calligraphic beveled Stylish Rank badges."""
    out: Dict[StyleRank, pygame.Surface] = {}
    for rank in StyleRank:
        if rank == StyleRank.NONE:
            continue
        w, h = 158, 66
        surf = pygame.Surface((w, h), pygame.SRCALPHA)
        col = rank.color
        col_hi = lerp_rgb(col, (255, 252, 236), 0.72)
        col_lo = scale_rgb(col, 0.48)

        # Diagonal crimson-glowing sword slash streak right behind the letters
        slash_spine = sample_quad_bezier(Vec2(8, h * 0.78), Vec2(w * 0.48, h * 0.46), Vec2(w - 8, h * 0.16), steps=14)
        sw = [3.0 + 13.0 * math.sin((i / 14.0) * math.pi) for i in range(15)]
        rast.paint_soft_shadow_poly(surf, build_variable_ribbon(slash_spine, sw), (138, 10, 38), alpha=185)
        rast.paint_soft_shadow_poly(surf, build_variable_ribbon(slash_spine, [v * 0.42 for v in sw]), col, alpha=165)
        rast.paint_radial_bloom(surf, w * 0.42, h * 0.48, 54, col, alpha=145, additive=True)

        glyph = rank.glyph
        lw = 34.0 if len(glyph) == 3 else (40.0 if len(glyph) == 2 else 46.0)
        lh = 48.0
        step_x = lw * 0.86
        start_x = 12.0
        for idx, ch in enumerate(glyph):
            _draw_gothic_stylish_letter(surf, rast, ch, start_x + idx * step_x, 8.0, lw, lh, col_hi, col, col_lo)

        if rank.tier >= 5:
            sx, sy = int(start_x + lw * 0.8), 14
            pygame.draw.line(surf, (255, 252, 240), (sx - 12, sy), (sx + 12, sy), 2)
            pygame.draw.line(surf, (255, 252, 240), (sx, sy - 12), (sx, sy + 12), 2)
        out[rank] = surf
    return out


