}
_TAG_FALLBACK_COLORS = ["#6fd3c7", "#7fb3e8", "#e08fa8", "#8fd48a", "#c9a2e0", "#e0b06f"]


def tag_folder_color(name: str) -> str:
    """Colour for a tag folder: known folders keep a fixed hue, unknown ones
    get a stable colour derived from their name."""
    if name in TAG_FOLDER_COLORS:
        return TAG_FOLDER_COLORS[name]
    h = sum(ord(c) for c in name) if name else 0
    return _TAG_FALLBACK_COLORS[h % len(_TAG_FALLBACK_COLORS)]


def model_short(name: str) -> str:
    """Short chip label for any known model (generation or tile model)."""
    for table in (MODELS, TILE_MODELS):
        if name in table:
            return str(table[name]["short"])
    return ""

