    def _on_model_changed(self) -> None:
        new_key = model_stack_key(self.current_model())
        old_key = self._active_model_key
        if new_key == old_key:
            self._update_deck_badges()
            self._update_generate_subtext()
            return
        # Preserve per-model negative text & span book
        self._negatives[old_key] = self.neg_edit.toPlainText()
        self._neg_spans[old_key] = self.neg_book.snapshot()
        self._active_model_key = new_key
        self.neg_edit.setPlainText(self._negatives.get(new_key, ""))
        self.neg_book.restore(self._neg_spans.get(new_key, []))
        maintain_spans(self.neg_book, self.neg_edit.toPlainText())
        self._rehighlight(self.neg_hl, "_neg_hl_busy")
        self._update_negative_header()
        # Template set follows the model (each stack owns its preset library)
        if new_key in self.tpl_set_btns:
            self.tpl_set_btns[new_key].setChecked(True)
        self.active_template = None
        self._fill_template_list()
        self._update_template_chip()
        # LLM template sync (each stack has its own dedicated LLM template)
        if self.llm_sync_cb.isChecked() and new_key in DEFAULT_LLM_SYSTEM_PROMPTS:
            self._llm_tpl_key = new_key
            self._load_llm_system_template_ui()
        # LoRA tab follows the model stack (per-stack folders; moss = notice)
        self._lora_browse_key = new_key
        if self._lora_folder_filter != "ALL" and self._lora_folder_filter not in self._lora_stack_folders(new_key):
            self._lora_folder_filter = "ALL"
        self._rebuild_lora_ui()
        self._update_deck_badges()
        self._update_generate_subtext()
        self._refresh_fixed_label()
        self._refresh_st_cache()
        self._schedule_save()

