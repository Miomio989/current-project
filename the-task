    def _on_lora_d_trigger(self) -> None:
        if getattr(self, "_lora_detail_syncing", False):
            return
        entry = self._lora_detail_entry()
        if entry is None or not (entry.get("triggers") or []):
            return
        entry["trigger_sel"] = max(0, self.lora_d_trigger.currentIndex())
        save_lora_library(self.lora_lib)
        self.lora_list.viewport().update()
