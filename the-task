def _font(size: float, bold: bool = False, spacing: float = 0.0) -> QFont:
    f = QFont()
    f.setPointSizeF(size)
    f.setBold(bold)
    if spacing:
        f.setLetterSpacing(QFont.SpacingType.AbsoluteSpacing, spacing)
    return f


def make_button(text: str, slot: Optional[Callable] = None, small: bool = False, accent: bool = False,
                tip: str = "") -> QPushButton:
    b = QPushButton(text)
    if small:
        b.setObjectName("Small")
    if accent:
        b.setObjectName("Accent")
    if tip:
        b.setToolTip(tip)
    b.setCursor(Qt.CursorShape.PointingHandCursor)
    if slot:
        b.clicked.connect(slot)
    return b


def make_label(text: str, name: str = "") -> QLabel:
    lb = QLabel(text)
    if name:
        lb.setObjectName(name)
    return lb


def plate(layout_margin: int = 8, spacing: int = 6, name: str = "Plate") -> "tuple[QFrame, QVBoxLayout]":
    fr = QFrame()
    fr.setObjectName(name)
    lay = QVBoxLayout(fr)
    lay.setContentsMargins(layout_margin, layout_margin, layout_margin, layout_margin)
    lay.setSpacing(spacing)
    return fr, lay


class SpanBook:
    """Coloured spans inside one prompt editor. Each span remembers the exact
    text it was inserted with; when that passage is edited the span (and thus
    the colour marking) is dropped and the text becomes plain prompt text."""

    def __init__(self) -> None:
        self.spans: List[Dict[str, Any]] = []
        self.prev: str = ""

    def clear(self) -> None:
        self.spans.clear()
        self.prev = ""


def maintain_spans(book: SpanBook, new_text: str) -> None:
    """Validate the spans after every text change. A span survives when its
    text is still found at the same position (edit elsewhere) or at the
    position shifted by the length delta (edit before the span); anything
    else means the span's own text was edited and the marking is dropped."""
    if new_text == book.prev:
        return
    delta = len(new_text) - len(book.prev)
    kept: List[Dict[str, Any]] = []
    for s in book.spans:
        start, ln, txt = int(s["start"]), len(s["text"]), s["text"]
        if start >= 0 and start + ln <= len(new_text) and new_text[start:start + ln] == txt:
            kept.append(s)
            continue
        ns = start + delta
        if delta != 0 and ns >= 0 and ns + ln <= len(new_text) and new_text[ns:ns + ln] == txt:
            s["start"] = ns
            kept.append(s)
            continue
        # edited inside the span -> drop the marking, keep the text
    book.spans = kept
    book.prev = new_text


class SpanHighlighter(QSyntaxHighlighter):
    """Paints the registered tag-group spans in their folder colour."""

    def __init__(self, book: SpanBook, parent=None):
        super().__init__(parent)
        self.book = book

    def highlightBlock(self, text: str) -> None:  # noqa: N802
        if not self.book.spans or not text:
            return
        bpos = self.currentBlock().position()
        bend = bpos + len(text)
        for s in self.book.spans:
            start, ln = int(s["start"]), len(s["text"])
            if start + ln <= bpos or start >= bend:
                continue
            rel = start - bpos
            if rel >= 0 and text.startswith(s["text"], rel):
                fmt = QTextCharFormat()
                fmt.setForeground(QColor(s["color"]))
                bg = QColor(s["color"])
                bg.setAlpha(44)
                fmt.setBackground(bg)
                self.setFormat(rel, ln, fmt)


class FolderButton(QAbstractButton):
    """Glossy checkable folder chip with a colour dot (tag-group folders)."""

    def __init__(self, label: str, color: str, parent: Optional[QWidget] = None):
        super().__init__(parent)
        self.label = label
        self.color = QColor(color)
        self.setToolTip(f"Tag folder: {label}")
        self.setCheckable(True)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
        self.setMinimumHeight(26)

    def paintEvent(self, _e) -> None:  # noqa: N802
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5)
        on = self.isChecked()
        hover = self.underMouse() and self.isEnabled()
        g = QLinearGradient(0, r.top(), 0, r.bottom())
        if on:
            g.setColorAt(0, QColor(GOLD["hi"])); g.setColorAt(0.5, QColor(GOLD["mid"]))
            g.setColorAt(0.52, QColor(GOLD["mid2"])); g.setColorAt(1, QColor(GOLD["lo"]))
            border = QColor(PAL["acc_dk"])
        else:
            g.setColorAt(0, QColor(PAL["chip_hov_hi"] if hover else PAL["chip_hi"]))
            g.setColorAt(1, QColor(PAL["chip_hov_lo"] if hover else PAL["chip_lo"]))
            border = QColor(PAL["acc_lo"]) if hover else QColor(PAL["chip_border"])
        p.setPen(QPen(border, 1))
        p.setBrush(QBrush(g))
        p.drawRoundedRect(r, 4, 4)
        p.setPen(QPen(QColor(255, 255, 255, 46 if on else 30), 1))
        p.drawLine(QPointF(r.left() + 3, r.top() + 1), QPointF(r.right() - 3, r.top() + 1))
        # colour dot
        cy = r.center().y()
        p.setPen(QPen(QColor(0, 0, 0, 110), 1))
        p.setBrush(QBrush(self.color))
        p.drawEllipse(QPointF(r.left() + 10, cy), 3.6, 3.6)
        p.setFont(_font(8.6, True, 0.6))
        p.setPen(QColor(0, 0, 0, 120))
        p.drawText(QRectF(r.left() + 17, r.top() + 1, r.width() - 20, r.height() - 1),
                   Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft, self.label)
        p.setPen(QColor(PAL["acc_txt"]) if on else QColor(PAL["chip_text"]))
        p.drawText(QRectF(r.left() + 16, r.top(), r.width() - 20, r.height() - 1),
                   Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft, self.label)
        p.end()


class TilePlanPreview(QLabel):
    """The tile-upscale source image with the planned grid drawn on top.
    Every tile rectangle is coloured by its current state; before a run
    starts the grid preview follows the live scale / overlap settings."""

    def __init__(self, parent: Optional[QWidget] = None):
        super().__init__(parent)
        self.setObjectName("Sunken")
        self.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.setMinimumHeight(138)
        self._run: Optional[Dict[str, Any]] = None
        self._src: Optional[QImage] = None
        self._plan: Optional[Dict[str, Any]] = None
        self._base: Optional[QImage] = None
        self._base_key: Optional[Tuple[int, int]] = None
        self.setPlaceholder()

    def setPlaceholder(self) -> None:
        self._run = None
        self._src = None
        self._plan = None
        self._base = None
        self._base_key = None
        self.setPixmap(QPixmap())
        self.setText(f"<div style='color:{PAL['dim']}; font-size:10pt'>no image chosen yet</div>")

    def refresh_placeholder(self) -> None:
        """Re-render the placeholder text after a theme switch (no-op when a
        plan or run is being shown)."""
        if self._run is None and self._src is None and self.pixmap().isNull():
            self.setText(f"<div style='color:{PAL['dim']}; font-size:10pt'>no image chosen yet</div>")

    def set_run(self, run: Optional[Dict[str, Any]]) -> None:
        self._run = run
        self._src = None
        self._plan = None
        if run is None:
            self.setPixmap(QPixmap())
            self.setText(f"<div style='color:{PAL['dim']}; font-size:10pt'>no run selected</div>")
        self.refresh()

    def set_plan(self, src: Optional[QImage], plan: Optional[Dict[str, Any]]) -> None:
        self._run = None
        self._src = src
        self._plan = plan
        self.refresh()

    def resizeEvent(self, e) -> None:  # noqa: N802
        super().resizeEvent(e)
        self.refresh()

    def refresh(self) -> None:
        run = self._run
        if run is not None:
            src, plan = run.get("src_img"), run.get("plan")
            tiles = run.get("tiles") or []
        else:
            src, plan, tiles = self._src, self._plan, None
        if src is None or src.isNull() or plan is None:
            if run is None and src is None and self.pixmap().isNull():
                pass
            return
        avail = self.size() - QSize(12, 12)
        if avail.width() < 24 or avail.height() < 24:
            return
        pw, ph = avail.width(), avail.height()
        if plan["out_h"] * pw > plan["out_w"] * ph:      # fit inside the label
            pw = max(24, int(plan["out_w"] * ph / plan["out_h"]))
        else:
            ph = max(24, int(plan["out_h"] * pw / plan["out_w"]))
        key = (pw, ph)
        if self._base_key != key or self._base is None:
            self._base = src.scaled(pw, ph, Qt.AspectRatioMode.IgnoreAspectRatio,
                                    Qt.TransformationMode.SmoothTransformation)
            self._base_key = key
        img = self._base.copy()
        if img.format() != QImage.Format.Format_ARGB32:
            img = img.convertToFormat(QImage.Format.Format_ARGB32)
        p = QPainter(img)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        sx, sy = pw / max(1, plan["out_w"]), ph / max(1, plan["out_h"])
        if tiles is None:
            tiles = [dict(t, state=TILE_PLANNED) for t in plan["tiles"]]
        for t in tiles:
            col = QColor(TILE_STATE_COLORS.get(str(t.get("state")), "#978d77"))
            rect = QRectF(t["x"] * sx, t["y"] * sy, t["w"] * sx, t["h"] * sy)
            fill = QColor(col)
            fill.setAlpha(26)
            p.setBrush(fill)
            p.setPen(QPen(col, 1.5))
            p.drawRect(rect.adjusted(0.5, 0.5, -0.5, -0.5))
            if rect.width() > 26 and rect.height() > 14:
                p.setFont(_font(6.5, True))
                p.setPen(col.lighter(135))
                p.drawText(rect.adjusted(2.5, 1.5, -1, -1),
                           Qt.AlignmentFlag.AlignTop | Qt.AlignmentFlag.AlignLeft,
                           f"{t['row']},{t['col']}")
        p.end()
        self.setText("")
        self.setPixmap(QPixmap.fromImage(img))


