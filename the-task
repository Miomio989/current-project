        elif move_state == FighterState.FATAL_CRIMSON_JUDGMENT:
            self.super_freeze_frames = 42
            self.audio.play_sfx(SFXId.FATAL_GONG, vol_scale=1.0)
            self.audio.play_sfx(SFXId.SUPER_FLASH, vol_scale=0.9)
            self.vfx.trigger_cut_in(
                attacker.player_idx,
                attacker.palette_idx,
                "CRIMSON JUDGMENT",
                "FATAL EXECUTION — 200% SOUL",
                is_fatal=True,
                duration=42,
            )
            self.cam.trigger_dramatic_zoom(attacker.x, attacker.y - 150.0, 1.32, 42)

    def resolve_pushboxes(self, f1: Fighter, f2: Fighter) -> None:
        """Keep fighter pushboxes from overlapping while allowing clean corner & air cross-ups."""
        if f1.in_throw_lock or f2.in_throw_lock:
            return
        if f1.state == FighterState.SPECIAL_SHADOW_STEP or f2.state == FighterState.SPECIAL_SHADOW_STEP:
            return
        b1 = f1.get_pushbox_world()
        b2 = f2.get_pushbox_world()
        if not rect_intersects(b1, b2):
            return
        x1, _, w1, _ = b1
        x2, _, w2, _ = b2
        overlap = min(x1 + w1, x2 + w2) - max(x1, x2)
        if overlap <= 0.0:
            return
        push = overlap * 0.52
        if f1.x <= f2.x:
            f1.x -= push
            f2.x += push
        else:
            f1.x += push
            f2.x -= push

        # Preserve iron-wall bounds cleanly (if one is cornered, push the other fully out)
        if f1.x < STAGE_LEFT_WALL:
            extra = STAGE_LEFT_WALL - f1.x
            f1.x = STAGE_LEFT_WALL
            f2.x = min(STAGE_RIGHT_WALL, f2.x + extra)
        elif f1.x > STAGE_RIGHT_WALL:
            extra = f1.x - STAGE_RIGHT_WALL
            f1.x = STAGE_RIGHT_WALL
            f2.x = max(STAGE_LEFT_WALL, f2.x - extra)

        if f2.x < STAGE_LEFT_WALL:
            extra = STAGE_LEFT_WALL - f2.x
            f2.x = STAGE_LEFT_WALL
            f1.x = min(STAGE_RIGHT_WALL, f1.x + extra)
        elif f2.x > STAGE_RIGHT_WALL:
            extra = f2.x - STAGE_RIGHT_WALL
            f2.x = STAGE_RIGHT_WALL
            f1.x = max(STAGE_LEFT_WALL, f1.x - extra)

    def spawn_move_projectiles(self, fighters: Tuple[Fighter, Fighter]) -> None:
        for f in fighters:
            spec = f.current_move
            if spec is not None and spec.projectile_frame > 0 and not f.projectile_spawned:
                if f.state_tick >= spec.projectile_frame:
                    f.projectile_spawned = True
                    self.vfx.spawn_blood_moon_wave(f, is_ex=f.is_ex_move)
                    self.audio.play_sfx(SFXId.PROJECTILE_WAVE, vol_scale=0.92)

    def update_throw_choreography(self, f1: Fighter, f2: Fighter) -> None:
        """Keep victim positioned cleanly during Cecilia's Abyssal Impalement throw!"""
        for atk, dfn in ((f1, f2), (f2, f1)):
            if atk.state == FighterState.THROW_EXECUTE and atk.throw_victim is dfn:
                dir_s = 1.0 if atk.facing_right else -1.0
                if atk.state_tick < 14:
                    # Held right before Cecilia's blade for point-blank impalement!
                    dfn.x = clamp(atk.x + dir_s * 76.0, STAGE_LEFT_WALL, STAGE_RIGHT_WALL)
                    dfn.y = GROUND_Y
                    dfn.facing_right = not atk.facing_right
                    if atk.state_tick == 8:
                        # Impale impact!
                        pal = CECILIA_PALETTES[atk.palette_idx]
                        self.audio.play_sfx(SFXId.HIT_HEAVY, vol_scale=1.0)
                        self.audio.play_sfx(SFXId.BLOOD_SPRAY, vol_scale=0.9)
                        self.vfx.spawn_slash_hit(dfn.x, dfn.y - 108.0, dir_s, pal, intensity=1.7, is_lethal=True)
                        self.cam.add_shake(11.0, self.settings.screen_shake)
                        dfn.hitflash_timer = 6
                        dfn.hp = max(1 if dfn.hp > 600 else 0, dfn.hp - 540)
                        dfn.blood_curse = min(MAX_BLOOD_CURSE, dfn.blood_curse + 16.0)
                elif atk.state_tick == 15:
                    # High-heeled thigh-boot kick blasting victim flying across the swamp!
                    dfn.in_throw_lock = False
                    atk.throw_victim = None
                    spec = MOVE_REGISTRY[FighterState.THROW_START]
                    dmg = 760
                    dfn.hp = max(0, dfn.hp - dmg)
                    dfn.blood_curse = min(MAX_BLOOD_CURSE, dfn.blood_curse + 16.0)
                    atk.stats.damage_dealt += 1300
                    atk.super_meter = min(MAX_SUPER_METER, atk.super_meter + spec.meter_gain_hit)
                    atk.resonance_gauge = min(MAX_RESONANCE, atk.resonance_gauge + spec.resonance_gain)
                    atk.stylish.award_move(FighterState.THROW_START, spec.stylish_points, 1.1)
                    dfn.vx = dir_s * spec.knockback_x
                    dfn.vy = spec.launch_vy
                    dfn.y = GROUND_Y - 4.0
                    dfn.enter_state(FighterState.HITSTUN_LAUNCH)
                    self.audio.play_sfx(SFXId.HIT_HEAVY, vol_scale=1.0)
                    self.vfx.spawn_slash_hit(dfn.x, dfn.y - 100.0, dir_s, CECILIA_PALETTES[atk.palette_idx], intensity=1.4)
                    self.cam.add_shake(12.0, self.settings.screen_shake)

    def resolve_frame(
        self,
        f1: Fighter,
        f2: Fighter,
        buf1: InputBuffer,
        buf2: InputBuffer,
        training_force_counter: bool = False,
    ) -> None:
        """Resolve weapon clashes, melee strikes, throws, parries, and projectiles."""
        self.spawn_move_projectiles((f1, f2))
        self.update_throw_choreography(f1, f2)

        # 1. Check Samurai Shodown Weapon Clash (active Clashbox vs Clashbox)
        if self._check_weapon_clash(f1, f2):
            return

        # 2. Check Throw Tech if defender inputs throw within grab tech window
        for atk, dfn, dfn_buf in ((f1, f2, buf2), (f2, f1, buf1)):
            if atk.state == FighterState.THROW_EXECUTE and atk.state_tick <= THROW_TECH_WINDOW and atk.throw_victim is dfn:
                cur = dfn_buf.current
                if (dfn_buf.was_pressed(InputButton.L, 3) and bool(cur.held & InputButton.M)) or (
                    dfn_buf.was_pressed(InputButton.M, 3) and bool(cur.held & InputButton.L)
                ):
                    self._execute_throw_tech(atk, dfn)
                    return

        # 3. Check Melee Hits & Throws (evaluated simultaneously so genuine trades work!)
        hit_events: List[Tuple[Fighter, Fighter, InputBuffer, MoveSpec, HitWindow, Tuple[float, float]]] = []
        for atk, dfn, dfn_buf in ((f1, f2, buf2), (f2, f1, buf1)):
            ev = self._find_melee_contact(atk, dfn, dfn_buf)
            if ev is not None:
                hit_events.append(ev)

        for atk, dfn, dfn_buf, spec, win, contact_pt in hit_events:
            self._apply_melee_contact(atk, dfn, dfn_buf, spec, win, contact_pt, training_force_counter)

        # 4. Resolve Projectile-vs-Projectile Clash & Projectile-vs-Fighter Hits
        self._resolve_projectiles(f1, f2, buf1, buf2)

    def _check_weapon_clash(self, f1: Fighter, f2: Fighter) -> bool:
        s1 = f1.current_move
        s2 = f2.current_move
        if s1 is None or s2 is None or not s1.can_clash or not s2.can_clash:
            return False
        w1s = f1.get_active_hit_windows()
        w2s = f2.get_active_hit_windows()
        if not w1s or not w2s:
            return False
        for w1 in w1s:
            if w1.clashbox is None:
                continue
            r1 = w1.clashbox.to_world(f1.x, f1.y, f1.facing_right)
            for w2 in w2s:
                if w2.clashbox is None:
                    continue
                r2 = w2.clashbox.to_world(f2.x, f2.y, f2.facing_right)
                if rect_intersects(r1, r2):
                    cx, cy = rect_overlap_center(r1, r2)
                    self.vfx.spawn_weapon_clash(cx, cy)
                    self.audio.play_sfx(SFXId.WEAPON_CLASH, vol_scale=1.0)
                    self.hitstop_frames = CLASH_FREEZE_FRAMES
                    self.cam.add_shake(14.0, self.settings.screen_shake)
                    self.cam.trigger_dramatic_zoom(cx, cy, 1.26, 22)
                    self.vfx.add_callout(2, "WEAPON CLASH!", pick_dramatic_quote("CLASH"), UI_GOLD_BRIGHT, 72)

                    push_dir = -1.0 if f1.x <= f2.x else 1.0
                    for f, sign in ((f1, push_dir), (f2, -push_dir)):
                        f.vx = sign * 11.5
                        f.enter_state(FighterState.CLASH_RECOIL)
                        f.super_meter = min(MAX_SUPER_METER, f.super_meter + 18.0)
                        f.resonance_gauge = min(MAX_RESONANCE, f.resonance_gauge + 12.0)
                        f.stylish.award_raw(36.0)
                        f.stats.weapon_clashes += 1
                    return True
        return False

    def _execute_throw_tech(self, atk: Fighter, dfn: Fighter) -> None:
        dfn.in_throw_lock = False
        atk.throw_victim = None
        mx = (atk.x + dfn.x) * 0.5
        my = GROUND_Y - 115.0
        self.vfx.spawn_guard_sparks(mx, my, 1.0, just_guard=True)
        self.audio.play_sfx(SFXId.JUST_GUARD, vol_scale=0.9)
        self.vfx.add_callout(2, "THROW ESCAPE!", "TECH", UI_GUARD_CYAN, 52)
        self.hitstop_frames = 10
        push_dir = -1.0 if atk.x <= dfn.x else 1.0
        atk.vx = push_dir * 11.0
        dfn.vx = -push_dir * 11.0
        atk.enter_state(FighterState.THROW_TECH)
        dfn.enter_state(FighterState.THROW_TECH)

    def _find_melee_contact(
        self, atk: Fighter, dfn: Fighter, dfn_buf: InputBuffer
    ) -> Optional[Tuple[Fighter, Fighter, InputBuffer, MoveSpec, HitWindow, Tuple[float, float]]]:
        spec = atk.current_move
        if spec is None or not dfn.alive or dfn.in_throw_lock:
            return None
        if dfn.is_strike_invulnerable():
            return None
        # Anti-air invulnerability protects 2H against jumping aerials!
        if dfn.is_anti_air_invulnerable() and not atk.grounded:
            return None
        if dfn.state == FighterState.KNOCKDOWN:
            return None

        hurtboxes = dfn.get_hurtboxes_world()
        for win in atk.get_active_hit_windows():
            hb = win.hitbox.to_world(atk.x, atk.y, atk.facing_right)
            for hu in hurtboxes:
                if rect_intersects(hb, hu):
                    pt = rect_overlap_center(hb, hu)
                    return (atk, dfn, dfn_buf, spec, win, pt)
        return None

    def _can_defender_block(
        self, dfn: Fighter, dfn_buf: InputBuffer, hit_height: HitHeight
    ) -> bool:
        if hit_height in (HitHeight.UNBLOCKABLE, HitHeight.THROW):
            return False
        if not (dfn.is_neutral_movable or dfn.is_air_movable or dfn.is_blocking):
            return False
        if not dfn_buf.is_holding_back():
            return False
        if not dfn.grounded:
            return True  # Air guard blocks strikes
        crouching = dfn_buf.is_holding_down() or dfn.state in (FighterState.CROUCH_IDLE, FighterState.GUARD_CROUCH)
        if hit_height == HitHeight.LOW and not crouching:
            return False
        if hit_height == HitHeight.OVERHEAD and crouching:
            return False
        return True

    def _apply_melee_contact(
        self,
        atk: Fighter,
        dfn: Fighter,
        dfn_buf: InputBuffer,
        spec: MoveSpec,
        win: HitWindow,
        contact_pt: Tuple[float, float],
        force_counter: bool,
    ) -> None:
        atk.hits_landed_ids.add(win.hit_id)
        cx, cy = contact_pt
        dir_s = 1.0 if atk.facing_right else -1.0

        # 1. Command Throw Grab Execution
        if spec.hit_height == HitHeight.THROW:
            if not dfn.grounded or dfn.is_in_hitstun or dfn.is_blocking:
                return
            atk.move_has_connected = True
            atk.throw_victim = dfn
            dfn.in_throw_lock = True
            dfn.throw_tech_timer = THROW_TECH_WINDOW
            dfn.enter_state(FighterState.HITSTUN_HIGH)
            atk.enter_state(FighterState.THROW_EXECUTE)
            self.audio.play_sfx(SFXId.THROW_GRAB, vol_scale=1.0)
            self.vfx.add_callout(atk.player_idx, "ABYSSAL IMPALE!", "THROW", UI_CRIMSON_GLOW, 50)
            return

        # 2. Darkmoon Counter Parry Interception!
        if dfn.is_parry_active() and spec.hit_height != HitHeight.UNBLOCKABLE:
            dfn.stats.parries += 1
            dfn.super_meter = min(MAX_SUPER_METER, dfn.super_meter + 25.0)
            dfn.resonance_gauge = min(MAX_RESONANCE, dfn.resonance_gauge + 18.0)
            dfn.stylish.award_raw(55.0)
            dfn.facing_right = atk.x >= dfn.x
            dfn.enter_state(FighterState.SPECIAL_PARRY_COUNTER)
            self.hitstop_frames = 18
            self.audio.play_sfx(SFXId.PARRY_TRIGGER, vol_scale=1.0)
            self.vfx.spawn_guard_sparks(cx, cy, dir_s, just_guard=True)
            self.vfx.add_callout(dfn.player_idx, "DARKMOON PARRY!", pick_dramatic_quote("PARRY"), UI_GOLD_BRIGHT, 74)
            self.cam.trigger_dramatic_zoom(cx, cy, 1.28, 24)
            return

        # 3. Guard / Just Guard / Guard Crush evaluation
        if self._can_defender_block(dfn, dfn_buf, spec.hit_height):
            atk.move_was_blocked = True
            just_guard = (0 < dfn.back_hold_frames <= JUST_GUARD_WINDOW) and not dfn.is_blocking
            dfn.facing_right = atk.x >= dfn.x

            if just_guard:
                dfn.stats.just_guards += 1
                dfn.super_meter = min(MAX_SUPER_METER, dfn.super_meter + 14.0)
                dfn.resonance_gauge = min(MAX_RESONANCE, dfn.resonance_gauge + 10.0)
                dfn.guard_gauge = min(MAX_GUARD_GAUGE, dfn.guard_gauge + 18.0)
                if dfn.stylish.award_raw(34.0):
                    self.audio.play_sfx(SFXId.RANK_UP, vol_scale=0.65)
                dfn.stun_timer = max(4, spec.blockstun - 4)
                dfn.vx = dir_s * (spec.knockback_block_x * 0.65)
                dfn.enter_state(FighterState.JUST_GUARD)
                self.hitstop_frames = max(self.hitstop_frames, spec.hitstop_block + 4)
                self.audio.play_sfx(SFXId.JUST_GUARD, vol_scale=0.95)
                self.vfx.spawn_guard_sparks(cx, cy, dir_s, just_guard=True)
                self.vfx.add_callout(dfn.player_idx, "JUST GUARD!", "+SOUL  -4F STUN", UI_GOLD_BRIGHT, 56)
                return

            # Standard Block + Chip Damage + Guard Integrity Drain
            chip = int(spec.chip_damage * win.damage_mult)
            if chip > 0 and dfn.hp > 1:
                dfn.hp = max(1, dfn.hp - chip)
            atk.super_meter = min(MAX_SUPER_METER, atk.super_meter + spec.meter_gain_block)
            dfn.super_meter = min(MAX_SUPER_METER, dfn.super_meter + spec.meter_gain_block * 0.65)
            dfn.guard_gauge = max(0.0, dfn.guard_gauge - spec.guard_damage * win.damage_mult)
            dfn.vx = dir_s * spec.knockback_block_x
            self.hitstop_frames = max(self.hitstop_frames, spec.hitstop_block)

            # Check Guard Crush!
            if dfn.guard_gauge <= 0.0:
                dfn.guard_gauge = MAX_GUARD_GAUGE * 0.65
                dfn.stun_timer = 30
                dfn.enter_state(FighterState.GUARD_CRUSH)
                self.audio.play_sfx(SFXId.GUARD_CRUSH, vol_scale=1.0)
                self.vfx.spawn_guard_sparks(cx, cy, dir_s, crush=True)
                self.vfx.add_callout(atk.player_idx, "GUARD CRUSH!", "DEFENSE SHATTERED", UI_GUARD_CYAN, 66)
                self.cam.add_shake(13.0, self.settings.screen_shake)
                self.hitstop_frames = 14
                return

            dfn.stun_timer = spec.blockstun
            if not dfn.grounded:
                dfn.enter_state(FighterState.GUARD_AIR)
            elif dfn_buf.is_holding_down():
                dfn.enter_state(FighterState.GUARD_CROUCH)
            else:
                dfn.enter_state(FighterState.GUARD_STAND)
            self.audio.play_sfx(SFXId.GUARD_CLANG, vol_scale=0.88)
            self.vfx.spawn_guard_sparks(cx, cy, dir_s, just_guard=False)
            atk.last_frame_advantage = spec.blockstun - max(1, spec.total_frames - atk.state_tick)
            return

        # 4. CLEAN HIT! Check Counter Hit, First Blood, Hyper-Armor, Scaling & Blood Curse Rupture
        atk.move_has_connected = True
        is_counter = force_counter or (
            dfn.is_attacking and dfn.current_move is not None and dfn.state_tick < (dfn.current_move.startup + dfn.current_move.active)
        )
        is_first_blood = not self.first_blood_awarded
        if is_first_blood:
            self.first_blood_awarded = True
            atk.super_meter = min(MAX_SUPER_METER, atk.super_meter + 15.0)
            atk.resonance_gauge = min(MAX_RESONANCE, atk.resonance_gauge + 10.0)
            self.vfx.add_callout(atk.player_idx, "FIRST BLOOD!", "+15% SOUL", UI_CRIMSON_GLOW, 62)

        # Souls-inspired Poise Hyper-Armor absorption (takes reduced damage without flinching!)
        if dfn.has_hyper_armor() and spec.attack_level.value < AttackLevel.SUPER.value:
            arm_dmg = int(spec.damage * win.damage_mult * 0.65)
            dfn.hp = max(0, dfn.hp - arm_dmg)
            dfn.hitflash_timer = 5
            self.hitstop_frames = max(self.hitstop_frames, 7)
            self.audio.play_sfx(SFXId.GUARD_CLANG, vol_scale=0.85)
            self.audio.play_sfx(spec.sfx_hit, vol_scale=0.75)
            self.vfx.spawn_slash_hit(cx, cy, dir_s, CECILIA_PALETTES[atk.palette_idx], intensity=0.85)
            self.vfx.add_callout(dfn.player_idx, "POISE ARMOR!", "ENDURED", UI_GOLD_BRIGHT, 46)
            return

        # Combo tracking & BlazBlue/KOF XIII Proration scaling
        if not dfn.is_in_hitstun:
            atk.combo_count = 1
            atk.combo_damage = 0
            atk.combo_proration = spec.proration_initial
            atk.last_combo_moves = [spec.state]
        else:
            atk.combo_count += 1
            atk.combo_proration = max(spec.min_damage_ratio, atk.combo_proration * spec.proration_combo)
            atk.last_combo_moves.append(spec.state)
        atk.combo_display_timer = 110

        res_mult = 1.18 if atk.resonance_active else 1.0
        ex_mult = 1.18 if atk.is_ex_move else 1.0
        counter_mult = 1.15 if is_counter else 1.0
        raw_dmg = spec.damage * win.damage_mult * atk.combo_proration * res_mult * ex_mult * counter_mult
        final_dmg = max(int(spec.damage * win.damage_mult * spec.min_damage_ratio), int(round(raw_dmg)))

        # R18+ Fatal Execution lethal check: Crimson Judgment final strike executes foes under 38% HP!
        is_fatal_finisher = (
            spec.state == FighterState.FATAL_CRIMSON_JUDGMENT
            and win.is_final_hit
            and (dfn.hp - final_dmg <= int(dfn.max_hp * 0.18))
        )
        if is_fatal_finisher:
            final_dmg = dfn.hp
            self.fatal_execution_triggered = True
            self.last_ko_was_fatal = True
            atk.stats.fatal_executions += 1
            self.vfx.add_callout(atk.player_idx, "CRIMSON EXECUTION!", "FATAL JUDGMENT", UI_GOLD_BRIGHT, 95)

        dfn.hp = max(0, dfn.hp - final_dmg)
        atk.combo_damage += final_dmg
        atk.stats.damage_dealt += final_dmg
        atk.stats.max_combo = max(atk.stats.max_combo, atk.combo_count)
        atk.stats.max_combo_damage = max(atk.stats.max_combo_damage, atk.combo_damage)
        if spec.category == MoveCategory.SUPER and win.hit_id == 1:
            atk.stats.supers_landed += 1

        # Resource gains & Stylish Rank escalation
        atk.super_meter = min(MAX_SUPER_METER, atk.super_meter + spec.meter_gain_hit * win.damage_mult)
        atk.resonance_gauge = min(MAX_RESONANCE, atk.resonance_gauge + spec.resonance_gain * win.damage_mult)
        dfn.super_meter = min(MAX_SUPER_METER, dfn.super_meter + spec.meter_gain_hit * 0.45)
        dfn.resonance_gauge = min(MAX_RESONANCE, dfn.resonance_gauge + spec.resonance_gain * 0.65)
        dfn.stylish.penalize_hit()

        style_mult = 1.45 if is_counter else 1.0
        if atk.stylish.award_move(spec.state, spec.stylish_points * win.damage_mult, style_mult):
            self.audio.play_sfx(SFXId.RANK_UP, vol_scale=0.72)
        atk.stats.stylish_score += int(final_dmg * (1.0 + atk.stylish.rank.tier * 0.22))

        # Blood Curse Affliction Buildup -> CURSE RUPTURE Hemorrhage Explosion at 100%!
        dfn.blood_curse += spec.curse_buildup * win.damage_mult * (1.25 if atk.resonance_active else 1.0)
        curse_ruptured = False
        if dfn.blood_curse >= MAX_BLOOD_CURSE and dfn.hp > 0:
            dfn.blood_curse = 0.0
            curse_ruptured = True
            rupt_dmg = min(dfn.hp - 1 if dfn.hp > 1 else 0, 920)
            dfn.hp = max(0, dfn.hp - rupt_dmg)
            atk.combo_damage += rupt_dmg
            atk.stats.damage_dealt += rupt_dmg
            atk.stats.curse_ruptures += 1
            atk.stylish.award_raw(45.0)
            self.audio.play_sfx(SFXId.CURSE_RUPTURE, vol_scale=1.0)
            self.vfx.spawn_curse_rupture(dfn.x, dfn.y - 110.0)
            self.vfx.add_callout(atk.player_idx, "CURSE RUPTURE!", pick_dramatic_quote("CURSE_RUPTURE"), UI_CURSE_VIOLET, 74)
            self.stage.add_blood_splatter(dfn.x, intensity=1.7)

        # Stun / Dizzy Buildup
        dfn.stun_gauge = min(MAX_STUN_GAUGE, dfn.stun_gauge + spec.stun_damage * win.damage_mult)
        dfn.stun_decay_delay = 140

        # Apply Hitstop, Hitflash, Hitshake, Camera Shake & Audio
        hitstop = win.hitstop_override if win.hitstop_override is not None else spec.hitstop_hit
        if is_counter:
            hitstop += spec.counter_extra_hitstop
            atk.stats.counter_hits += 1
            self.vfx.add_callout(atk.player_idx, "COUNTER!", "CRITICAL SLASH", UI_GOLD_BRIGHT, 62)
            self.audio.play_sfx(SFXId.HIT_COUNTER, vol_scale=0.95)
            self.cam.trigger_dramatic_zoom(cx, cy, 1.22, 16)
        else:
            self.audio.play_sfx(spec.sfx_hit, vol_scale=0.95)

        if spec.blood_intensity >= 1.1:
            self.audio.play_sfx(SFXId.BLOOD_SPRAY, vol_scale=min(1.0, spec.blood_intensity * 0.55))

        self.hitstop_frames = max(self.hitstop_frames, hitstop)
        dfn.hitflash_timer = min(8, max(4, hitstop // 2))
        dfn.hitshake_x = dir_s * (6.5 + spec.attack_level.value * 1.4)
        self.cam.add_shake(spec.camera_shake * (1.35 if is_counter else 1.0), self.settings.screen_shake)

        self.vfx.spawn_slash_hit(
            cx,
            cy,
            dir_s,
            CECILIA_PALETTES[atk.palette_idx],
            intensity=spec.blood_intensity * (1.25 if is_counter else 1.0),
            is_counter=is_counter,
            is_lethal=(dfn.hp <= 0 or is_fatal_finisher),
        )
        if self.settings.gore_explicit and spec.blood_intensity >= 0.9:
            self.stage.add_blood_splatter(dfn.x + dir_s * 24.0, intensity=spec.blood_intensity * 0.85)

        # Apply Knockback, Launch, Groundbounce, Wallbounce & Hitstun state
        dfn.facing_right = atk.x >= dfn.x
        kb_x = win.knockback_x if win.knockback_x is not None else spec.knockback_x
        launch_vy = win.launch_vy if win.launch_vy is not None else spec.launch_vy
        if is_counter and spec.counter_launch_vy < 0.0:
            launch_vy = min(launch_vy, spec.counter_launch_vy)
        if curse_ruptured and launch_vy == 0.0:
            launch_vy = -10.5

        if spec.groundbounce and not dfn.grounded:
            dfn.has_groundbounced = True

        # Lethal blow always launches dramatically!
        if dfn.hp <= 0:
            dfn.vx = dir_s * max(13.0, kb_x * 1.25)
            dfn.vy = min(-13.5, launch_vy)
            dfn.y = min(dfn.y, GROUND_Y - 2.0)
            dfn.enter_state(FighterState.HITSTUN_LAUNCH)
            return

        # Trigger Dizzy Stun if stun meter maxed on grounded hit
        if dfn.stun_gauge >= MAX_STUN_GAUGE and dfn.grounded and launch_vy == 0.0:
            dfn.stun_timer = 95
            dfn.vx = dir_s * 6.0
            dfn.enter_state(FighterState.DIZZY_STUN)
            self.vfx.add_callout(dfn.player_idx, "DIZZY!", "STAGGERED", UI_GOLD_BRIGHT, 70)
            return

        if launch_vy < 0.0 or not dfn.grounded or spec.sweep_knockdown or win.force_hard_kd:
            dfn.juggle_hits += 1
            dfn.vx = dir_s * kb_x * (0.85 if not dfn.grounded else 1.0)
            dfn.vy = launch_vy if launch_vy != 0.0 else -10.5
            if dfn.vy < 0.0:
                dfn.y = min(dfn.y, GROUND_Y - 2.0)
            dfn.enter_state(FighterState.HITSTUN_LAUNCH)
        else:
            dfn.vx = dir_s * kb_x
            dfn.stun_timer = spec.hitstun + (spec.counter_extra_hitstun if is_counter else 0)
            if spec.hit_height == HitHeight.LOW:
                dfn.enter_state(FighterState.HITSTUN_LOW)
            else:
                dfn.enter_state(FighterState.HITSTUN_HIGH)

        atk.last_frame_advantage = dfn.stun_timer - max(1, spec.total_frames - atk.state_tick)

    def _resolve_projectiles(
        self, f1: Fighter, f2: Fighter, buf1: InputBuffer, buf2: InputBuffer
    ) -> None:
        projs = self.vfx.projectiles
        # 1. Projectile vs Projectile clash
        for i in range(len(projs)):
            p1 = projs[i]
            if p1.hits_remaining <= 0:
                continue
            r1 = p1.get_hitbox_world()
            for j in range(i + 1, len(projs)):
                p2 = projs[j]
                if p2.hits_remaining <= 0 or p1.owner_idx == p2.owner_idx:
                    continue
                r2 = p2.get_hitbox_world()
                if rect_intersects(r1, r2):
                    cx, cy = rect_overlap_center(r1, r2)
                    p1.hits_remaining -= 1
                    p2.hits_remaining -= 1
                    self.vfx.spawn_weapon_clash(cx, cy)
                    self.audio.play_sfx(SFXId.GUARD_CLANG, vol_scale=0.9)

        # 2. Projectile vs Opposing Fighter
        for pr in projs:
            if pr.hits_remaining <= 0 or pr.hit_cooldown > 0:
                continue
            owner = f1 if pr.owner_idx == 0 else f2
            dfn = f2 if pr.owner_idx == 0 else f1
            dfn_buf = buf2 if pr.owner_idx == 0 else buf1
            if not dfn.alive or dfn.is_strike_invulnerable() or dfn.state == FighterState.KNOCKDOWN:
                continue
            pb = pr.get_hitbox_world()
            hit_pt: Optional[Tuple[float, float]] = None
            for hu in dfn.get_hurtboxes_world():
                if rect_intersects(pb, hu):
                    hit_pt = rect_overlap_center(pb, hu)
                    break
            if hit_pt is None:
                continue

            pr.hits_remaining -= 1
            pr.hit_cooldown = 7
            cx, cy = hit_pt
            dir_s = 1.0 if pr.facing_right else -1.0

            if dfn.is_parry_active():
                dfn.stats.parries += 1
                dfn.super_meter = min(MAX_SUPER_METER, dfn.super_meter + 20.0)
                dfn.stylish.award_raw(40.0)
                self.vfx.spawn_guard_sparks(cx, cy, dir_s, just_guard=True)
                self.audio.play_sfx(SFXId.PARRY_TRIGGER, vol_scale=0.9)
                self.vfx.add_callout(dfn.player_idx, "WAVE PARRY!", "+20% SOUL", UI_GOLD_BRIGHT, 52)
                continue

            if self._can_defender_block(dfn, dfn_buf, HitHeight.MID):
                just = 0 < dfn.back_hold_frames <= JUST_GUARD_WINDOW and not dfn.is_blocking
                if just:
                    dfn.stats.just_guards += 1
                    dfn.super_meter = min(MAX_SUPER_METER, dfn.super_meter + 12.0)
                    dfn.stun_timer = 10
                    dfn.enter_state(FighterState.JUST_GUARD)
                    self.vfx.spawn_guard_sparks(cx, cy, dir_s, just_guard=True)
                    self.audio.play_sfx(SFXId.JUST_GUARD, vol_scale=0.9)
                    self.vfx.add_callout(dfn.player_idx, "JUST GUARD!", "+SOUL", UI_GOLD_BRIGHT, 48)
                else:
                    if dfn.hp > 1:
                        dfn.hp = max(1, dfn.hp - pr.chip_damage)
                    dfn.vx = dir_s * 7.5
                    dfn.stun_timer = 15
                    dfn.enter_state(FighterState.GUARD_CROUCH if dfn_buf.is_holding_down() else FighterState.GUARD_STAND)
                    self.vfx.spawn_guard_sparks(cx, cy, dir_s, just_guard=False)
                    self.audio.play_sfx(SFXId.GUARD_CLANG, vol_scale=0.85)
                continue

            # Clean projectile slash hit!
            if not dfn.is_in_hitstun:
                owner.combo_count = 1
                owner.combo_damage = 0
                owner.combo_proration = 0.92
            else:
                owner.combo_count += 1
                owner.combo_proration = max(0.22, owner.combo_proration * 0.88)
            owner.combo_display_timer = 100
            dmg = max(160, int(pr.damage * owner.combo_proration))
            dfn.hp = max(0, dfn.hp - dmg)
            owner.combo_damage += dmg
            owner.stats.damage_dealt += dmg
            owner.stats.max_combo = max(owner.stats.max_combo, owner.combo_count)
            owner.stylish.award_move(FighterState.SPECIAL_CRESCENT_WAVE, 22.0)
            dfn.blood_curse = min(MAX_BLOOD_CURSE, dfn.blood_curse + pr.curse_buildup)
            dfn.hitflash_timer = 5
            dfn.vx = dir_s * 9.5
            if not dfn.grounded or dfn.hp <= 0 or (pr.is_ex and pr.hits_remaining == 0):
                dfn.vy = -11.5
                dfn.y = min(dfn.y, GROUND_Y - 2.0)
                dfn.enter_state(FighterState.HITSTUN_LAUNCH)
            else:
                dfn.stun_timer = 22
                dfn.enter_state(FighterState.HITSTUN_HIGH)
            self.hitstop_frames = max(self.hitstop_frames, 7)
            self.audio.play_sfx(SFXId.HIT_HEAVY, vol_scale=0.92)
            self.vfx.spawn_slash_hit(cx, cy, dir_s, CECILIA_PALETTES[pr.palette_idx], intensity=1.25)
            self.cam.add_shake(7.5, self.settings.screen_shake)

