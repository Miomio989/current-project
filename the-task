def build_mini_icon_svg(kind: str, palette: Optional[Dict[str, str]] = None) -> str:
    """24x24 mini vector emblem with theme-distinct silhouette backing seat and
    high-contrast metallic strokes that read unmistakably even at 13px scale."""
    p = palette or C
    defs = _svg_defs_common(p)
    motif_tpl = _MINI_ICON_MOTIFS.get(kind) or _MINI_ICON_MOTIFS["info"]
    motif = motif_tpl.format(
        p["svg_metal_1"], p["svg_metal_1"], p["svg_metal_1"], p["svg_metal_1"],
        p["svg_metal_1"], p["svg_metal_1"], p["svg_metal_1"], p["svg_metal_1"],
    )
    k = p.get("key", "seestation")
    if k == "seestation":
        seat = (
            f"<rect x='1.2' y='1.2' width='21.6' height='21.6' rx='6.0' fill='url(#bodyLac)' "
            f"stroke='{p['line_hi']}' stroke-opacity='0.55' stroke-width='0.8' opacity='0.56'/>"
        )
    elif k == "crimson":
        seat = (
            f"<rect x='1.2' y='1.2' width='21.6' height='21.6' rx='0' fill='url(#bodyLac)' "
            f"stroke='{p['hdr_line']}' stroke-opacity='0.6' stroke-width='0.8' opacity='0.58'/>"
