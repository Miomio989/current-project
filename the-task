class ProceduralNoise2D:
    """Deterministic value/fBm/ridged/Voronoi noise engine for painterly stone, storm clouds, and blade veins."""

    def __init__(self, seed: int = 1926) -> None:
        rng = random.Random(seed)
        self.perm: List[int] = list(range(256))
        rng.shuffle(self.perm)
        self.perm = self.perm * 2
        self.vals: List[float] = [rng.random() for _ in range(256)]

    def _hash(self, ix: int, iy: int) -> float:
        return self.vals[self.perm[(ix & 255) + self.perm[iy & 255]] & 255]

    def value(self, x: float, y: float) -> float:
        ix = int(math.floor(x))
        iy = int(math.floor(y))
        fx = x - ix
        fy = y - iy
        ux = fx * fx * (3.0 - 2.0 * fx)
        uy = fy * fy * (3.0 - 2.0 * fy)
        v00 = self._hash(ix, iy)
        v10 = self._hash(ix + 1, iy)
        v01 = self._hash(ix, iy + 1)
        v11 = self._hash(ix + 1, iy + 1)
        a = v00 + (v10 - v00) * ux
        b = v01 + (v11 - v01) * ux
        return a + (b - a) * uy

    def fbm(self, x: float, y: float, octaves: int = 4, lacunarity: float = 2.05, gain: float = 0.5) -> float:
        total = 0.0
        amp = 0.5
        freq = 1.0
        norm = 0.0
        for _ in range(octaves):
            total += self.value(x * freq, y * freq) * amp
            norm += amp
            freq *= lacunarity
            amp *= gain
        return total / max(1e-6, norm)

    def ridged(self, x: float, y: float, octaves: int = 4) -> float:
        total = 0.0
        amp = 0.55
        freq = 1.0
        norm = 0.0
        for _ in range(octaves):
            n = 1.0 - abs(self.value(x * freq, y * freq) * 2.0 - 1.0)
            total += (n * n) * amp
            norm += amp
            freq *= 2.12
            amp *= 0.48
        return total / max(1e-6, norm)

    def worley_edge(self, x: float, y: float) -> float:
        """Returns stone/vein crack intensity (high near Voronoi cell borders)."""
        ix = int(math.floor(x))
        iy = int(math.floor(y))
        d1 = 99.0
        d2 = 99.0
        for oy in (-1, 0, 1):
            for ox in (-1, 0, 1):
                cx = ix + ox
                cy = iy + oy
                px = cx + self._hash(cx, cy)
                py = cy + self._hash(cx + 37, cy + 91)
                dx = px - x
                dy = py - y
                d = math.sqrt(dx * dx + dy * dy)
                if d < d1:
                    d2 = d1
                    d1 = d
                elif d < d2:
                    d2 = d
        return clamp(1.0 - (d2 - d1) * 4.5, 0.0, 1.0)


class BrushVectorRasterizer:
    """
    Emulates Japanese/Pixiv digital brush strokes, ink sumi-e tapering, cloud-scroll
    Bézier filigree, lotus petal mandalas, and wet-edge painterly glazing onto pygame Surfaces.
    """

    @staticmethod
    def bezier_quad(
        p0: Tuple[float, float], p1: Tuple[float, float], p2: Tuple[float, float], steps: int = 20
    ) -> List[Tuple[float, float]]:
        pts: List[Tuple[float, float]] = []
        for i in range(steps + 1):
            t = i / float(steps)
            mt = 1.0 - t
            x = mt * mt * p0[0] + 2.0 * mt * t * p1[0] + t * t * p2[0]
            y = mt * mt * p0[1] + 2.0 * mt * t * p1[1] + t * t * p2[1]
            pts.append((x, y))
        return pts

    @staticmethod
    def draw_brush_stroke(
        surf: "pygame.Surface",
        pts: Sequence[Tuple[float, float]],
        color: Tuple[int, int, int, int],
        base_width: float = 8.0,
        taper_start: bool = True,
        taper_end: bool = True,
        bristles: int = 5,
        seed: int = 7,
    ) -> None:
        """Draws a tapered multi-bristle painterly brush stroke with ink splatter edges."""
        n = len(pts)
        if n < 2:
            return
        rng = random.Random(seed)
        r, g, b, a = color
        for i in range(n):
            t = i / float(max(1, n - 1))
            w = base_width
            if taper_start and t < 0.25:
                w *= smoothstep(t / 0.25)
            if taper_end and t > 0.65:
                w *= smoothstep((1.0 - t) / 0.35)
            rad = max(1, int(w * 0.5))
            px, py = pts[i]
            pygame.draw.circle(surf, (r, g, b, a), (int(px), int(py)), rad)
            for bi in range(bristles):
                ox = rng.uniform(-w * 0.38, w * 0.38)
                oy = rng.uniform(-w * 0.38, w * 0.38)
                ba = int(a * rng.uniform(0.35, 0.78))
                brad = max(1, int(rad * rng.uniform(0.3, 0.7)))
                pygame.draw.circle(surf, (r, g, b, ba), (int(px + ox), int(py + oy)), brad)

    @staticmethod
    def draw_cloud_scroll(
        surf: "pygame.Surface",
        cx: float, cy: float, radius: float,
        color: Tuple[int, int, int, int],
        turns: float = 1.65, width: int = 2, mirror: float = 1.0,
    ) -> None:
        """Draws ornate East/South Asian temple cloud-scroll filigree spirals."""
        pts: List[Tuple[int, int]] = []
        steps = 28
        for i in range(steps + 1):
            t = i / float(steps)
            ang = t * turns * math.tau * mirror
            rr = radius * (1.0 - t * 0.82)
            pts.append((int(cx + math.cos(ang) * rr), int(cy + math.sin(ang) * rr)))
        if len(pts) >= 2:
            pygame.draw.lines(surf, color, False, pts, width)

    @staticmethod
    def draw_lotus_ring(
        surf: "pygame.Surface",
        cx: int, cy: int,
        inner_r: float, outer_r: float,
        petals: int,
        stroke_col: Tuple[int, int, int, int],
        fill_col: Optional[Tuple[int, int, int, int]] = None,
        phase: float = 0.0,
        line_w: int = 2,
    ) -> None:
        """Draws concentric temple lotus petal rings for sigils, menus, and portrait halos."""
        step = math.tau / float(petals)
        for p in range(petals):
            a_mid = phase + p * step
            a_left = a_mid - step * 0.44
            a_right = a_mid + step * 0.44
            p_base_l = (cx + math.cos(a_left) * inner_r, cy + math.sin(a_left) * inner_r)
            p_base_r = (cx + math.cos(a_right) * inner_r, cy + math.sin(a_right) * inner_r)
            p_tip = (cx + math.cos(a_mid) * outer_r, cy + math.sin(a_mid) * outer_r)
            mid_r = (inner_r + outer_r) * 0.56
            p_ctrl_l = (cx + math.cos(a_mid - step * 0.34) * mid_r, cy + math.sin(a_mid - step * 0.34) * mid_r)
            p_ctrl_r = (cx + math.cos(a_mid + step * 0.34) * mid_r, cy + math.sin(a_mid + step * 0.34) * mid_r)
            left_arc = BrushVectorRasterizer.bezier_quad(p_base_l, p_ctrl_l, p_tip, 8)
            right_arc = BrushVectorRasterizer.bezier_quad(p_tip, p_ctrl_r, p_base_r, 8)
            poly = [(int(x), int(y)) for (x, y) in left_arc + right_arc]
            if fill_col is not None:
                pygame.draw.polygon(surf, fill_col, poly)
            pygame.draw.polygon(surf, stroke_col, poly, line_w)


class ProceduralTextureAtlas:
    """
