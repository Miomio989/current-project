# SECTION 6: STUDIO PAINTERLY CG RASTERIZER (TRUE SMOOTH GRADIENT + AIRBRUSH)
# ==============================================================================

class StudioCGRasterizer:
    """
    Multi-pass painterly CG rasterizer built on top of SDL2/Pygame C primitives.
    Eliminates flat Adobe Flash polygon art by rendering every curved shape via:
      1. Smooth directional multi-stop color gradient shaders (bilinear smoothscale
         clipped cleanly to exact polygon silhouettes via BLEND_RGBA_MULT).
      2. Soft radial airbrush highlights, blush, velvet sheen, and ambient occlusion.
      3. Rim lighting along the Blood Moon vector (upper-right crimson glow).
      4. Variable-weight colored anime ink contours (fine warm ink on lit skin,
         deep dark wine-black ink in shadows).
    """

    def __init__(self) -> None:
        self._glow_cache: Dict[Tuple[int, RGB, int, bool], pygame.Surface] = {}
        self._grad_cache: Dict[Tuple[int, int, Tuple[RGB, ...], bool], pygame.Surface] = {}

    def get_radial_glow(
        self,
        radius: int,
        color: RGB,
        peak_alpha: int = 200,
        premul: bool = True,
    ) -> pygame.Surface:
        r = max(4, min(320, (int(radius) + 2) & ~3))
        pa = clamp_int((int(peak_alpha) + 8) & ~15, 16, 255)
        key = (r, color, pa, premul)
        cached = self._glow_cache.get(key)
        if cached is not None:
            return cached
        # Smooth Gaussian-squared radial kernel upscaled via C bilinear smoothscale!
        base_r = min(48, r)
        diam = base_r * 2
        buf = bytearray(diam * diam * 4)
        cr, cg, cb = color
        inv_r = 1.0 / float(max(1, base_r))
        pa_f = pa / 255.0
        idx = 0
        for y in range(diam):
            dy = (y - base_r + 0.5) * inv_r
            dy2 = dy * dy
            for x in range(diam):
                dx = (x - base_r + 0.5) * inv_r
                d2 = dx * dx + dy2
                if d2 < 1.0:
                    d = math.sqrt(d2)
                    # Smooth C2 Gaussian-like falloff reaching exact 0 at boundary!
                    w = (1.0 - d)
                    fall = w * w * (1.0 + 0.5 * w) * math.exp(-d2 * 1.45)
                    intensity = clamp(fall * pa_f, 0.0, 1.0)
                    if premul:
                        # Premultiplied RGB required by SDL BLEND_RGBA_ADD!
                        buf[idx] = int(cr * intensity)
                        buf[idx + 1] = int(cg * intensity)
                        buf[idx + 2] = int(cb * intensity)
                        buf[idx + 3] = int(255 * intensity)
                    else:
                        buf[idx] = cr
                        buf[idx + 1] = cg
                        buf[idx + 2] = cb
                        buf[idx + 3] = int(255 * intensity)
                idx += 4
        small = pygame.image.frombuffer(bytes(buf), (diam, diam), "RGBA").convert_alpha()
        out = pygame.transform.smoothscale(small, (r * 2, r * 2)) if r != base_r else small
        if len(self._glow_cache) > 768:
            self._glow_cache.clear()
        self._glow_cache[key] = out
        return out

    def blit_glow(
        self,
        surf: pygame.Surface,
        pos: Pt2,
        radius: float,
        color: RGB,
        alpha: int = 180,
        additive: bool = True,
    ) -> None:
        r = int(radius)
        if r < 3 or alpha <= 2:
            return
        g = self.get_radial_glow(r, color, alpha, premul=additive)
        flags = pygame.BLEND_RGBA_ADD if additive else 0
        surf.blit(g, (int(pos[0] - r), int(pos[1] - r)), special_flags=flags)

    def make_linear_gradient(
        self,
        w: int,
        h: int,
        colors: Sequence[RGB],
        vertical: bool = True,
    ) -> pygame.Surface:
        w = max(2, int(w))
        h = max(2, int(h))
        n = len(colors)
        if vertical:
            strip = pygame.Surface((1, n), pygame.SRCALPHA)
            for i, c in enumerate(colors):
                strip.set_at((0, i), (c[0], c[1], c[2], 255))
        else:
            strip = pygame.Surface((n, 1), pygame.SRCALPHA)
            for i, c in enumerate(colors):
                strip.set_at((i, 0), (c[0], c[1], c[2], 255))
        return pygame.transform.smoothscale(strip, (w, h))

    def fill_shaded_poly(
        self,
        target: pygame.Surface,
        pts: Sequence[Pt2],
        colors: Sequence[RGB],
        light_dir: Pt2 = (0.65, -0.76),
        spec_pos: Optional[Pt2] = None,
        spec_color: Optional[RGB] = None,
        spec_radius: float = 0.0,
        spec_alpha: int = 120,
        rim_color: Optional[RGB] = None,
        rim_width: float = 2.0,
        ink_color: Optional[RGB] = None,
        ink_width: float = 1.6,
        alpha: int = 255,
    ) -> None:
        """
        True painterly smooth-gradient shaded polygon renderer:
        Renders an oriented multi-stop smooth gradient + optional soft airbrush
        specular/blush/AO highlight clipped cleanly to the exact curved silhouette.
        """
        if len(pts) < 3:
            return
        x0, y0, bw, bh = poly_bbox(pts)
        pad = 3
        lw = bw + pad * 2
        lh = bh + pad * 2
        ox = x0 - pad
        oy = y0 - pad
        local_pts = [(p[0] - ox, p[1] - oy) for p in pts]

        # 1. Exact smooth polygon mask (pure white inside, transparent outside)
        mask = pygame.Surface((lw, lh), pygame.SRCALPHA)
        pygame.draw.polygon(mask, (255, 255, 255, alpha), local_pts)

        # 2. Smooth directional gradient texture (oriented along light_dir)
        # Fast exact 2D orientation using rotated smoothscale strip!
        lx, ly = v_norm(light_dir)
        diag = int(math.hypot(lw, lh)) + 6
        strip = pygame.Surface((len(colors), 1), pygame.SRCALPHA)
        for i, c in enumerate(colors):
            strip.set_at((i, 0), (c[0], c[1], c[2], 255))
        grad_big = pygame.transform.smoothscale(strip, (diag, diag))
        ang_deg = -math.degrees(math.atan2(ly, lx))
        if abs(ang_deg) > 1.0:
            grad_rot = pygame.transform.rotate(grad_big, ang_deg)
        else:
            grad_rot = grad_big
        shaded = pygame.Surface((lw, lh), pygame.SRCALPHA)
        gx = (lw - grad_rot.get_width()) // 2
        gy = (lh - grad_rot.get_height()) // 2
        shaded.blit(grad_rot, (gx, gy))

        # 3. Optional soft airbrush highlight / blush / shadow puff clipped inside shape!
        if spec_pos is not None and spec_color is not None and spec_radius >= 3.0:
            spos = (spec_pos[0] - ox, spec_pos[1] - oy)
            self.blit_glow(shaded, spos, spec_radius, spec_color, spec_alpha, additive=True)

        # 4. Optional inner crimson/moonlight rim bevel along light-facing edge
        if rim_color is not None and rim_width > 0.5:
            rim_mask = pygame.Surface((lw, lh), pygame.SRCALPHA)
            shifted = [(p[0] - lx * rim_width, p[1] - ly * rim_width) for p in local_pts]
            rc = (int(rim_color[0] * 0.58), int(rim_color[1] * 0.58), int(rim_color[2] * 0.58), 255)
            pygame.draw.polygon(rim_mask, rc, local_pts)
            pygame.draw.polygon(rim_mask, (0, 0, 0, 0), shifted)
            shaded.blit(rim_mask, (0, 0), special_flags=pygame.BLEND_RGB_ADD)

        # 5. Clip shaded painterly surface strictly to polygon alpha mask!
        shaded.blit(mask, (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
        target.blit(shaded, (ox, oy))

        # 6. Colored anti-aliased anime ink contour (variable weight by edge light dot!)
        if ink_color is not None and ink_width > 0.2:
            self.draw_variable_ink_contour(target, pts, ink_color, ink_width, light_dir, closed=True)

    def draw_variable_ink_contour(
        self,
        target: pygame.Surface,
        pts: Sequence[Pt2],
        ink_color: RGB,
        base_width: float = 1.8,
        light_dir: Pt2 = (0.65, -0.76),
        closed: bool = True,
    ) -> None:
        """
        Anime-grade variable-width ink lineart:
        Edges facing the light get delicate thin lines; shadow-side edges get
        richer dark calligraphic strokes (never uniform thick Flash strokes).
        """
        n = len(pts)
        if n < 2:
            return
        lx, ly = v_norm(light_dir)
        count = n if closed else n - 1
        # Crisp anti-aliased base pass first
        pygame.draw.aalines(target, ink_color, closed, [(p[0], p[1]) for p in pts])
        if base_width <= 1.25:
            return
        for i in range(count):
            p0 = pts[i]
            p1 = pts[(i + 1) % n]
            dx = p1[0] - p0[0]
            dy = p1[1] - p0[1]
            seg_len = math.hypot(dx, dy)
            if seg_len < 0.8:
                continue
            # Outward normal approximation
            nx = dy / seg_len
            ny = -dx / seg_len
            ndotl = nx * lx + ny * ly
            # Shadow edges are thicker, light-facing edges stay razor thin!
            w = base_width * (0.55 if ndotl > 0.25 else (1.18 if ndotl < -0.2 else 0.88))
            iw = max(1, int(round(w)))
            if iw >= 2:
                pygame.draw.line(target, ink_color, (int(p0[0]), int(p0[1])), (int(p1[0]), int(p1[1])), iw)

    def draw_soft_ellipse_airbrush(
        self,
        target: pygame.Surface,
        cx: float,
        cy: float,
        rx: float,
        ry: float,
        color: RGB,
        alpha: int = 120,
        additive: bool = False,
    ) -> None:
        irx = max(2, int(rx))
        iry = max(2, int(ry))
        g = self.get_radial_glow(max(irx, iry), color, alpha, premul=additive)
        scaled = pygame.transform.smoothscale(g, (irx * 2, iry * 2))
        flags = pygame.BLEND_RGBA_ADD if additive else 0
        target.blit(scaled, (int(cx - irx), int(cy - iry)), special_flags=flags)

    def draw_feathered_ribbon(
        self,
        target: pygame.Surface,
        outer_pts: Sequence[Pt2],
        inner_pts: Sequence[Pt2],
        colors: Sequence[RGB],
        alpha: int = 210,
        additive: bool = True,
    ) -> None:
        """Render a glowing multi-layered kinetic slash ribbon between two splines."""
        if len(outer_pts) < 3 or len(inner_pts) < 3:
            return
        # Layer 1: Wide soft outer aura
        rev_in = list(reversed(inner_pts))
        full_poly = list(outer_pts) + rev_in
        x0, y0, bw, bh = poly_bbox(full_poly)
        lw = bw + 8
        lh = bh + 8
        ox = x0 - 4
        oy = y0 - 4
        local_poly = [(p[0] - ox, p[1] - oy) for p in full_poly]

        layer = pygame.Surface((lw, lh), pygame.SRCALPHA)
        a_norm = clamp(alpha / 255.0, 0.0, 1.0)
        def prem(c: RGB, k: float) -> RGBA:
            if additive:
                f = clamp(a_norm * k, 0.0, 1.0)
                return (int(c[0] * f), int(c[1] * f), int(c[2] * f), clamp_int(int(255 * f), 0, 255))
            return (c[0], c[1], c[2], clamp_int(int(alpha * k), 0, 255))

        # Outer plasma aura
        c_out = colors[0]
        pygame.draw.polygon(layer, prem(c_out, 0.42), local_poly)

        # Mid crimson-scarlet kinetic body
        n = min(len(outer_pts), len(inner_pts))
        mid_in = [v_lerp(inner_pts[i], outer_pts[i], 0.36) for i in range(n)]
        mid_poly = [(p[0] - ox, p[1] - oy) for p in outer_pts[:n]] + [(p[0] - ox, p[1] - oy) for p in reversed(mid_in)]
        c_mid = colors[min(1, len(colors) - 1)]
        pygame.draw.polygon(layer, prem(c_mid, 0.72), mid_poly)

        # Blazing hot razor leading edge
        core_in = [v_lerp(inner_pts[i], outer_pts[i], 0.80) for i in range(n)]
        core_poly = [(p[0] - ox, p[1] - oy) for p in outer_pts[:n]] + [(p[0] - ox, p[1] - oy) for p in reversed(core_in)]
        c_core = colors[-1]
        pygame.draw.polygon(layer, prem(c_core, 0.95), core_poly)

        flags = pygame.BLEND_RGBA_ADD if additive else 0
        target.blit(layer, (ox, oy), special_flags=flags)

    def draw_calligraphy_stroke(
        self,
        target: pygame.Surface,
        pts: Sequence[Pt2],
        widths: Sequence[float],
        fill_color: RGB,
        glow_color: Optional[RGB] = None,
        rim_color: Optional[RGB] = None,
    ) -> None:
        poly = build_tapered_ribbon_poly(pts, widths)
        if len(poly) < 3:
            return
        if glow_color is not None:
            wide = build_tapered_ribbon_poly(pts, [w * 1.65 + 2.0 for w in widths])
            x0, y0, bw, bh = poly_bbox(wide)
            g = pygame.Surface((bw + 8, bh + 8), pygame.SRCALPHA)
            pygame.draw.polygon(g, (glow_color[0], glow_color[1], glow_color[2], 96), [(p[0] - x0 + 4, p[1] - y0 + 4) for p in wide])
            target.blit(g, (x0 - 4, y0 - 4), special_flags=pygame.BLEND_RGBA_ADD)
        pygame.draw.polygon(target, fill_color, poly)
        if rim_color is not None:
            pygame.draw.aalines(target, rim_color, True, poly)

