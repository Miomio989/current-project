    # ------------------------------------------------------------------ LLM logic
    def _llm_base(self) -> str:
        return (self.llm_url_edit.text() or "").strip().rstrip("/")

    def _llm_key(self) -> str:
        return (self.llm_key_edit.text() or "").strip()

    def _llm_model(self) -> str:
        return (self.llm_model_combo.currentText() or "").strip()

    def _llm_set_status(self, text: str, err: bool = False) -> None:
        self.llm_status.setText(text)
        self.llm_status.setProperty("error", bool(err))
        st = self.llm_status.style()
        st.unpolish(self.llm_status)
        st.polish(self.llm_status)

    def _llm_busy(self, on: bool) -> None:
        self.llm_forge_btn.setEnabled(not on)
        self.llm_models_btn.setEnabled(not on)

    def _llm_load_models(self) -> None:
        base = self._llm_base()
        if not base:
            self._llm_set_status("Set the API URL first (it must end with /v1).", err=True)
            return
        self._llm_busy(True)
        self._llm_set_status(f"Loading models from {base}/models \u2026")

        def job():
            try:
                return llm_list_models(base, self._llm_key())
            except LlmError as exc:
                raise HordeError(exc.message) from exc

        self._run_task(job, self._llm_models_done, self._llm_models_error)

    def _llm_models_done(self, models: List[str]) -> None:
        self._llm_busy(False)
        cur = self._llm_model()
        self.llm_model_combo.clear()
        if models:
            self.llm_model_combo.addItems(models)
        if cur:
            ix = self.llm_model_combo.findText(cur)
            if ix >= 0:
                self.llm_model_combo.setCurrentIndex(ix)
            else:
                self.llm_model_combo.setEditText(cur)
        if models:
            self._llm_set_status(f"{len(models)} model(s) available.")
            self.append_log(f"LLM: {len(models)} model(s) loaded from {self._llm_base()}/models")
        else:
            self._llm_set_status("The endpoint returned an empty model list - type a model id by hand.", err=True)

    def _llm_models_error(self, msg: str) -> None:
        self._llm_busy(False)
        self._llm_set_status(msg, err=True)
        self.append_log(f"LLM model list error: {msg}")

    def _llm_forge(self) -> None:
        base = self._llm_base()
        model = self._llm_model()
        user = self.llm_user_edit.toPlainText().strip()
        if not base:
            self._llm_set_status("Set the API URL first (it must end with /v1).", err=True)
            return
        if not model:
            self._llm_set_status("Choose or type a model first (LOAD MODELS helps).", err=True)
            return
        if not user:
            self._llm_set_status("Type a user request first.", err=True)
            return
        system = self.llm_sys_edit.toPlainText().strip()
        self._llm_busy(True)
        self._llm_set_status(f"Contacting {base}/chat/completions \u2026")

        def job():
            try:
                return llm_chat(base, self._llm_key(), model, system, user,
                                self.llm_temp_spin.value(), self.llm_topp_spin.value())
            except LlmError as exc:
                raise HordeError(exc.message) from exc

        self._run_task(job, self._llm_forge_done, self._llm_forge_error)

    def _llm_forge_done(self, text: str) -> None:
        self._llm_busy(False)
        prompts = llm_extract_prompts(text or "")
        self.llm_list.clear()
        for p in prompts:
            it = QListWidgetItem(elide(p, 96))
            it.setData(Qt.ItemDataRole.UserRole, p)
            it.setToolTip(p)
            self.llm_list.addItem(it)
        self.llm_count.setText(str(len(prompts)))
        if prompts:
            self.llm_list.setCurrentRow(0)
            self._llm_show_item(self.llm_list.currentItem())
            note = ("" if llm_reply_has_blocks(text or "")
                    else "  (no <prompt> blocks in the reply - the whole reply is shown as one entry)")
            self._llm_set_status(f"{len(prompts)} prompt(s) extracted{note}")
            self._flash_summary(f"LLM: {len(prompts)} prompt(s)")
            self.append_log(f"LLM: {len(prompts)} prompt(s) extracted via {self._llm_model()}")
        else:
            self._llm_set_status("The model returned an empty reply.", err=True)

    def _llm_forge_error(self, msg: str) -> None:
        self._llm_busy(False)
        self._llm_set_status(msg, err=True)
        self.append_log(f"LLM error: {msg}")

    def _llm_show_item(self, it: Optional[QListWidgetItem]) -> None:
        self.llm_preview.setPlainText(str(it.data(Qt.ItemDataRole.UserRole)) if it else "")

    def _llm_selected_prompt(self) -> Optional[str]:
        it = self.llm_list.currentItem()
        return str(it.data(Qt.ItemDataRole.UserRole)) if it else None

    def _llm_copy_selected(self) -> None:
        p = self._llm_selected_prompt()
        if not p:
            self._llm_set_status("Nothing selected.", err=True)
            return
        QApplication.clipboard().setText(p)
        self._flash_summary("Prompt copied to the clipboard")

    def _llm_copy_all(self) -> None:
        texts = [str(self.llm_list.item(i).data(Qt.ItemDataRole.UserRole))
                 for i in range(self.llm_list.count())]
        texts = [t for t in texts if t]
        if not texts:
            self._llm_set_status("No prompts to copy yet.", err=True)
            return
        QApplication.clipboard().setText("\n".join(texts))
        self._flash_summary(f"{len(texts)} prompt(s) copied")

    def _llm_to_prompt(self) -> None:
        p = self._llm_selected_prompt()
        if not p:
            self._llm_set_status("Nothing selected.", err=True)
            return
        self.prompt_edit.setPlainText(p)
        self.tabs.setCurrentIndex(0)
        self.prompt_edit.setFocus()
        self._flash_summary("Prompt loaded into the editor - Ctrl+Enter to generate")

    def _llm_clear(self) -> None:
        self.llm_list.clear()
        self.llm_preview.clear()
        self.llm_count.setText("0")
        self._llm_set_status("Idle.")

    def _llm_menu(self, pos: QPoint) -> None:
        it = self.llm_list.itemAt(pos)
        if it is None:
            return
        self.llm_list.setCurrentItem(it)
        m = QMenu(self)
        m.addAction("Copy", self._llm_copy_selected)
        m.addAction("Copy all", self._llm_copy_all)
        m.addSeparator()
        m.addAction("To prompt editor", self._llm_to_prompt)
        m.exec(self.llm_list.viewport().mapToGlobal(pos))

    # ------------------------------------------------------------------ LLM settings io
    def _apply_llm_settings(self) -> None:
        s = self.llm_settings
        self.llm_url_edit.setText(str(s.get("api_url", "")))
        self.llm_key_edit.setText(str(s.get("api_key", "")))
        self.llm_model_combo.clear()
        self.llm_model_combo.setEditText(str(s.get("model", "")))
        self.llm_temp_spin.setValue(float(s.get("temperature", 0.7)))
        self.llm_topp_spin.setValue(float(s.get("top_p", 0.9)))
        self.llm_sys_edit.setPlainText(str(s.get("system_prompt", DEFAULT_LLM_SETTINGS["system_prompt"])))
        self.llm_user_edit.setPlainText(str(s.get("user_input", "")))
        self.llm_sys_section.set_expanded(bool(s.get("system_visible", False)), emit=False)

    def collect_llm_settings(self) -> Dict[str, Any]:
        s = self.llm_settings
        s.update({
            "api_url": self._llm_base(),
            "api_key": (self.llm_key_edit.text() or "").strip(),
            "model": self._llm_model(),
            "temperature": round(self.llm_temp_spin.value(), 3),
            "top_p": round(self.llm_topp_spin.value(), 3),
            "system_prompt": self.llm_sys_edit.toPlainText(),
            "user_input": self.llm_user_edit.toPlainText(),
            "system_visible": self.llm_sys_section.is_expanded(),
        })
        return s

    def _llm_schedule_save(self) -> None:
        if not self._loading:
            self._llm_save_timer.start()

    def save_llm_now(self) -> None:
        if self._loading or not hasattr(self, "llm_url_edit"):
            return
        save_llm_settings(self.collect_llm_settings())

