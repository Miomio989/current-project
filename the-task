    def _adjust_scale(self, delta: float) -> None:
        ui = self.settings.setdefault("ui", {})
        cur = float(ui.get("font_scale") or 1.0)
        new = max(0.85, min(1.35, round(cur + delta, 2)))
        if abs(new - cur) < 1e-3:
            return
        ui["font_scale"] = new
        self._apply_theme_chrome(new)
        self._schedule_save()
        self._flash_summary(f"Font scale: {new:.2f}")

