_THEME_BACKDROP_CACHE: Dict[Tuple[str, int, int], QPixmap] = {}


def paint_theme_backdrop(painter: QPainter, rect: QRect, theme_key: Optional[str] = None) -> None:
    """Cached, zero-lag signature backdrop per design language:
    - SeeStation: authentic PS3 XMB luminous silk-ribbon aurora & soft bokeh dust
    - Sarif Gold: Deus Ex HR obsidian carbon micro-triangle hex lattice + HUD frame
    - Crimson Eclipse: Kuon / Blood-C urushi mirror lacquer + crimson mist & shrine lines
    """
    w, h = max(1, rect.width()), max(1, rect.height())
    k = theme_key or C.get("key", "seestation")
    ck = (k, w, h)
    pm = _THEME_BACKDROP_CACHE.get(ck)
    if pm is None:
        pm = QPixmap(w, h)
        p = QPainter(pm)
        p.setRenderHint(QPainter.RenderHint.Antialiasing, True)
        bg = QLinearGradient(0, 0, 0, h)
        if k == "seestation":
            bg.setColorAt(0.0, QColor("#061124"))
            bg.setColorAt(0.55, QColor("#040a17"))
            bg.setColorAt(1.0, QColor("#02060f"))
            p.fillRect(0, 0, w, h, bg)
            # Iconic Sony PS3 XMB translucent diagonal silk wave ribbons
            rad = QRadialGradient(w * 0.25, h * 0.18, max(w, h) * 0.72)
            rad.setColorAt(0.0, QColor(0, 112, 209, 52))
            rad.setColorAt(0.55, QColor(20, 75, 148, 20))
            rad.setColorAt(1.0, QColor(0, 0, 0, 0))
            p.fillRect(0, 0, w, h, rad)
            for idx, (y0, amp, alpha, lw) in enumerate((
                (0.36, 0.12, 34, 2.2),
                (0.44, 0.16, 22, 1.4),
                (0.54, 0.10, 18, 1.0),
                (0.66, 0.14, 15, 0.9),
            )):
                ribbon = QPainterPath()
                ribbon.moveTo(-20, h * y0)
                ribbon.cubicTo(
                    w * 0.28, h * (y0 - amp),
                    w * 0.68, h * (y0 + amp * 1.15),
                    w + 20, h * (y0 - amp * 0.45),
                )
                band = QPainterPath(ribbon)
                band.lineTo(w + 20, h * (y0 + 0.12))
                band.cubicTo(
                    w * 0.66, h * (y0 + amp * 1.45),
                    w * 0.28, h * (y0 - amp * 0.45),
                    -20, h * (y0 + 0.10),
                )
                band.closeSubpath()
                fg = QLinearGradient(0, h * (y0 - amp), 0, h * (y0 + amp + 0.14))
                fg.setColorAt(0.0, QColor(84, 188, 255, alpha))
                fg.setColorAt(0.55, QColor(0, 112, 209, int(alpha * 0.45)))
                fg.setColorAt(1.0, QColor(0, 70, 150, 0))
                p.setPen(Qt.PenStyle.NoPen)
                p.setBrush(fg)
                p.drawPath(band)
                p.setBrush(Qt.BrushStyle.NoBrush)
                p.setPen(QPen(QColor(186, 232, 255, alpha + 22), lw))
                p.drawPath(ribbon)
            # Subtle Vita/PS4 floating glass dust motes
            p.setPen(Qt.PenStyle.NoPen)
            for mx, my, mr, ma in (
                (0.14, 0.22, 2.1, 44), (0.31, 0.68, 1.6, 36), (0.58, 0.29, 2.4, 38),
                (0.77, 0.48, 1.8, 42), (0.86, 0.21, 2.2, 34), (0.44, 0.81, 1.5, 30),
                (0.22, 0.46, 1.3, 46), (0.69, 0.74, 2.0, 32),
            ):
                p.setBrush(QColor(196, 232, 255, ma))
                p.drawEllipse(QPointF(w * mx, h * my), mr, mr)
        elif k == "crimson":
            bg.setColorAt(0.0, QColor("#090406"))
            bg.setColorAt(0.55, QColor("#040203"))
            bg.setColorAt(1.0, QColor("#010101"))
            p.fillRect(0, 0, w, h, bg)
            # Kuon / Blood-C subtle crimson shrine mist + fine urushi slash
            mist = QRadialGradient(w * 0.72, h * 0.22, max(w, h) * 0.68)
            mist.setColorAt(0.0, QColor(180, 0, 22, 42))
            mist.setColorAt(0.55, QColor(85, 0, 12, 16))
            mist.setColorAt(1.0, QColor(0, 0, 0, 0))
            p.fillRect(0, 0, w, h, mist)
            p.setPen(QPen(QColor(255, 32, 52, 26), 1.0))
            p.drawLine(QPointF(14, 14), QPointF(w - 14, 14))
            p.drawLine(QPointF(14, h - 14), QPointF(w - 14, h - 14))
            p.setPen(QPen(QColor(220, 12, 32, 20), 1.4))
            p.drawLine(QPointF(w * 0.65, 0), QPointF(w * 0.92, h))
            p.drawLine(QPointF(w * 0.68, 0), QPointF(w * 0.95, h))
        else:
            bg.setColorAt(0.0, QColor("#0e0b06"))
            bg.setColorAt(0.55, QColor("#090704"))
            bg.setColorAt(1.0, QColor("#050402"))
            p.fillRect(0, 0, w, h, bg)
            # Deus Ex HR subtle triangular carbon-gold lattice
            glow = QRadialGradient(w * 0.5, h * 0.35, max(w, h) * 0.65)
            glow.setColorAt(0.0, QColor(218, 150, 26, 26))
            glow.setColorAt(1.0, QColor(0, 0, 0, 0))
            p.fillRect(0, 0, w, h, glow)
            step = 36
            p.setPen(QPen(QColor(215, 162, 52, 14), 0.8))
            for y in range(0, h + step, step):
                p.drawLine(0, y, w, y)
            for x in range(-h, w + h, step):
                p.drawLine(x, 0, x + h, h)
                p.drawLine(x, h, x + h, 0)
        p.end()
        _THEME_BACKDROP_CACHE[ck] = pm
        while len(_THEME_BACKDROP_CACHE) > 16:
            _THEME_BACKDROP_CACHE.pop(next(iter(_THEME_BACKDROP_CACHE)))
    painter.drawPixmap(rect.topLeft(), pm)


def set_theme(name: str) -> None:
    key = name if name in THEMES else "seestation"
    C.clear()
    C.update(THEMES[key])
    _THEME_BACKDROP_CACHE.clear()


def theme_name() -> str:
    return C["key"]


