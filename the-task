    def use_from_image(self, what: str, path: Optional[str] = None, meta: Optional[Dict[str, Any]] = None) -> None:
        if not isinstance(meta, dict) or not meta:
            if path is None:
                path = self._current_image()
            if not path:
                return
            meta = read_image_metadata(path)
        if what in ("prompt", "all"):
            raw = str(meta.get("raw_prompt") or meta.get("prompt") or "")
            self.prompt_edit.setPlainText(raw)
            if what == "all":
                neg = str(meta.get("negative") or "")
                self.neg_edit.setPlainText(neg)
            self.tabs.setCurrentIndex(TAB_PROMPT)
        if what in ("seed", "all"):
            seed = str(meta.get("seed_requested") or meta.get("seed") or "")
            self.seed_edit.setText(seed)
        if what == "all":
            mname = str(meta.get("model") or "")
            if mname in MODELS and mname != self.current_model():
                self.model_btns[mname].setChecked(True)
                self._on_model_changed()
            w = int(meta.get("width") or 0)
            h = int(meta.get("height") or 0)
            if w and h:
                matched = next((a["key"] for a in ASPECTS if a["w"] == w and a["h"] == h), None)
                if matched:
                    self.custom_size_check.setChecked(False)
                    self.aspect.set_current(matched)
                else:
                    self.custom_size_check.setChecked(True)
                    self.w_spin.setValue(w)
                    self.h_spin.setValue(h)
                    if hasattr(self, "aspect_custom_btn"):
                        self.aspect_custom_btn.setChecked(True)
                        self.cw_spin.setValue(w)
                        self.ch_spin.setValue(h)
            loras = meta.get("loras") or []
            if isinstance(loras, list) and model_supports(self.current_model(), "loras"):
                stack = self._current_lora_stack()
                folders = self._lora_stack_folders(self._active_model_key)
                matched_ids: Set[str] = set()
                for pl in loras:
                    if not isinstance(pl, dict):
                        continue
                    name = str(pl.get("name") or "")
                    if not name:
                        continue
                    matched_ids.add(name)
                    entry = next((e for e in stack if e.get("id") == name), None)
                    if entry is None:
                        entry = normalize_lora_entry({
                            "id": name,
                            "name": name,
                            "folder": folders[0] if folders else "Improve-Overall",
                        })
                        stack.append(entry)
                    entry["model"] = round(float(pl.get("model", 1.0)), 2)
                    entry["clip"] = round(float(pl.get("clip", 1.0)), 2)
                    entry["enabled"] = True
                for e in stack:
                    if e.get("id") and e.get("id") not in matched_ids:
                        e["enabled"] = False
                self._rebuild_lora_ui()
        self._update_preview()
        self._flash_summary(f"Loaded {what} from image")

