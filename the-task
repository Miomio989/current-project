            # Subtle premultiplied golden glow halo
            self.rast.paint_radial_bloom(surf, iris_c.x, iris_c.y, ir_r * 2.4, pal.eye_mid, alpha=75, additive=True)

            # Thick sculpted winged dark upper eyelash + subtle lower lash
            lash_pts = [
                (ec - fwd * (ew * 1.18) + up * (open_h * 0.22)).to_int_tuple(),
