    def _bake_bottom_crest(self, glow_col: RGB, is_sword: bool) -> pygame.Surface:
        """Ornate circular gothic medallion for bottom-left / bottom-right Super Gauge."""
        s = 68
        surf = pygame.Surface((s, s), pygame.SRCALPHA)
        c = s // 2
        self.rast.stamp_bloom(surf, c, c, 32, glow_col, alpha=140, additive=False)
        pygame.draw.circle(surf, (18, 8, 22), (c, c), 24)
        pygame.draw.circle(surf, scale_rgb(glow_col, 0.45), (c, c), 21)
        pygame.draw.circle(surf, glow_col, (c, c), 18, 2)
        # Gothic ornate filigree outer silver thorn ring!
        for k in range(8):
            ang = k * (math.tau / 8.0)
            p_in = (int(c + math.cos(ang) * 22), int(c + math.sin(ang) * 22))
            p_out = (int(c + math.cos(ang) * 31), int(c + math.sin(ang) * 31))
            pygame.draw.line(surf, (232, 220, 240), p_in, p_out, 2)
        pygame.draw.circle(surf, (226, 214, 236), (c, c), 25, 2)
        pygame.draw.circle(surf, (255, 246, 255), (c, c), 22, 1)
        # Central cursed sword / arcane rose crest emblem
        if is_sword:
            pygame.draw.line(surf, (255, 238, 246), (c - 10, c + 10), (c + 11, c - 11), 3)
            pygame.draw.line(surf, (255, 198, 224), (c - 7, c + 1), (c + 2, c + 10), 2)
        else:
            pygame.draw.polygon(surf, (255, 216, 255), [(c, c - 12), (c + 9, c + 2), (c, c + 12), (c - 9, c + 2)])
            pygame.draw.circle(surf, (255, 246, 255), (c, c), 4)
        return surf

