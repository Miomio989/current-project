            P(94, 174), P(164, 174), P(182, 212), P(176, 258), P(82, 258), P(76, 212),
        ]
        self.cg.fill_shaded_poly(
            surf, bodice,
            [pal.dress_black_sh, pal.dress_black_base, pal.dress_black_hi],
            light_dir=ldir,
            ink_color=pal.dress_black_sh, ink_width=2.0 * s,
