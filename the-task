def draw_beveled_gauge_bar(
    dest: pygame.Surface,
    rect: pygame.Rect,
    ratio: float,
    col_hi: RGB,
    col_mid: RGB,
    col_deep: RGB,
    trail_ratio: Optional[float] = None,
    trail_col: RGB = (255, 62, 54),
    right_to_left: bool = False,
    segments: int = 1,
    skew_px: int = 8,
    glow_pulse: float = 0.0,
) -> None:
    """
    Draw a Soulcalibur / mockup.jpg metallic beveled gothic energy/life bar
    with slanted gothic ends, specular glass gloss, delayed damage-burn trail,
    and silver filigree frame.
    """
    x, y, w, h = rect.x, rect.y, rect.w, rect.h
    r = clamp(ratio, 0.0, 1.0)
    sk = skew_px if not right_to_left else -skew_px

    def slant_poly(x0: float, x1: float, y0: float, y1: float) -> List[Tuple[int, int]]:
        return [
            (int(x0 + max(0, sk)), int(y0)),
            (int(x1 + max(0, sk)), int(y0)),
            (int(x1 + min(0, sk)), int(y1)),
            (int(x0 + min(0, sk)), int(y1)),
        ]

    # Dark recessed interior trough
    bg_poly = slant_poly(x, x + w, y, y + h)
    pygame.draw.polygon(dest, (16, 8, 18), bg_poly)

    # Delayed red damage-burn bar
    if trail_ratio is not None and trail_ratio > r + 0.002:
        tr = clamp(trail_ratio, 0.0, 1.0)
        if right_to_left:
            tx0 = x + w * (1.0 - tr)
            tx1 = x + w
        else:
            tx0 = x
            tx1 = x + w * tr
        pygame.draw.polygon(dest, trail_col, slant_poly(tx0, tx1, y + 1, y + h - 1))

    # Active multi-band luminous metallic fill
    if r > 0.001:
        if right_to_left:
            fx0 = x + w * (1.0 - r)
            fx1 = x + w
        else:
            fx0 = x
            fx1 = x + w * r
        # Lower deep fill
        pygame.draw.polygon(dest, col_deep, slant_poly(fx0, fx1, y + 1, y + h - 1))
        # Mid saturated body
        pygame.draw.polygon(dest, col_mid, slant_poly(fx0, fx1, y + 1, y + int(h * 0.72)))
        # Upper luminous gloss highlight strip
        hi_c = add_rgb(col_hi, (40, 30, 35), glow_pulse) if glow_pulse > 0.0 else col_hi
        pygame.draw.polygon(dest, hi_c, slant_poly(fx0, fx1, y + 1, y + max(3, int(h * 0.34))))
        # Leading edge bright flash line
        lead_x = fx0 if right_to_left else fx1
        pygame.draw.line(
            dest,
            (255, 246, 252),
            (int(lead_x + max(0, sk)), y + 1),
            (int(lead_x + min(0, sk)), y + h - 1),
            2,
        )

    # Optional segment notches (for 4-bar Curse Tension gauge)
    if segments > 1:
        for s in range(1, segments):
            sx = x + (w * s) / float(segments)
            pygame.draw.line(
                dest,
                (18, 10, 22),
                (int(sx + max(0, sk)), y),
                (int(sx + min(0, sk)), y + h),
                2,
            )
            pygame.draw.line(
                dest,
                (212, 198, 222),
                (int(sx + max(0, sk)) + 1, y),
                (int(sx + min(0, sk)) + 1, y + h),
                1,
            )

    # Ornate silver metallic outer bevel
    pygame.draw.polygon(dest, (218, 206, 226), bg_poly, 2)
    pygame.draw.line(
        dest,
        (255, 246, 255),
        bg_poly[0],
        bg_poly[1],
        1,
    )


