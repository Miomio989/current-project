class ComboTrialTracker:
    """Tracks live completion of Cecilia's Darkmoon Combo Trials inside Training Lab."""

    def __init__(self) -> None:
        self.active_trial_idx: int = -1  # -1 = Free Training (no trial pinned)
        self.current_step: int = 0
        self.completed_ids: Set[int] = set()
        self.clear_banner_timer: int = 0

    @property
    def current_trial(self) -> Optional[ComboTrial]:
        if 0 <= self.active_trial_idx < len(COMBO_TRIALS):
            return COMBO_TRIALS[self.active_trial_idx]
        return None

    def cycle_trial(self) -> None:
        self.active_trial_idx += 1
        if self.active_trial_idx >= len(COMBO_TRIALS):
            self.active_trial_idx = -1
        self.current_step = 0
        self.clear_banner_timer = 0

    def update(self, p1: Fighter, dummy: Fighter, audio: AudioManager) -> None:
        if self.clear_banner_timer > 0:
            self.clear_banner_timer -= 1
        trial = self.current_trial
        if trial is None:
            return
        if not dummy.is_in_hitstun and p1.combo_count == 0:
            self.current_step = 0
            return
        # Match prefix of p1.last_combo_moves against trial.steps
        matched = 0
        for st in p1.last_combo_moves:
            if matched < len(trial.steps) and st == trial.steps[matched]:
                matched += 1
        self.current_step = max(self.current_step, matched)
        if self.current_step >= len(trial.steps) and trial.trial_id not in self.completed_ids:
            self.completed_ids.add(trial.trial_id)
            self.clear_banner_timer = 110
            audio.play_sfx(SFXId.RANK_UP, vol_scale=1.0)


class TrainingLabOverlay:
    """Renders tournament-grade Hitboxes, Frame Data Bar, Input Tape & Trial HUD."""

    TIMELINE_COLORS: Dict[str, RGB] = {
        ".": (32, 24, 38),
        "S": (56, 188, 198),   # Startup — Teal
        "A": (244, 38, 64),    # Active — Crimson
        "R": (66, 114, 212),   # Recovery — Royal Blue
        "H": (246, 152, 46),   # Hitstun — Amber
        "B": (172, 72, 228),   # Blockstun — Violet
        "I": (252, 224, 96),   # Invulnerable — Gold
    }

    def __init__(self, fonts: FontManager) -> None:
        self.fonts = fonts
        self.trials = ComboTrialTracker()

    def apply_training_rules(
        self, p1: Fighter, dummy: Fighter, cfg: TrainingSettings, audio: AudioManager
    ) -> None:
        # Auto-regenerate HP cleanly once combo drops
        if cfg.auto_regen_hp:
            if not dummy.is_in_hitstun and dummy.hp < dummy.max_hp:
                dummy.hp = min(dummy.max_hp, dummy.hp + 180)
                dummy.blood_curse = max(0.0, dummy.blood_curse - 1.5)
            if not p1.is_in_hitstun and p1.hp < p1.max_hp:
                p1.hp = min(p1.max_hp, p1.hp + 180)
        if cfg.auto_max_super:
            p1.super_meter = MAX_SUPER_METER
        if cfg.auto_max_resonance and not p1.resonance_active:
            p1.resonance_gauge = MAX_RESONANCE
        self.trials.update(p1, dummy, audio)

    def render_world_boxes(
        self,
        target: pygame.Surface,
        f1: Fighter,
        f2: Fighter,
        vfx: VFXManager,
        cam: CameraDirector,
    ) -> None:
        """Draw crisp translucent Hitboxes, Hurtboxes, Pushboxes & Clashboxes in world space."""
        overlay = pygame.Surface((SCREEN_W, SCREEN_H), pygame.SRCALPHA)

        def draw_wbox(box: Tuple[float, float, float, float], col: RGB, fill_a: int = 58, width: int = 2) -> None:
            wx, wy, ww, wh = box
            sx, sy = cam.world_to_screen(wx, wy)
            rw = max(2, int(ww * cam.zoom))
            rh = max(2, int(wh * cam.zoom))
            r = pygame.Rect(int(sx), int(sy), rw, rh)
            pygame.draw.rect(overlay, with_alpha(col, fill_a), r)
            pygame.draw.rect(overlay, with_alpha(col, 230), r, width)

        for f in (f1, f2):
            # Pushbox (Amber)
            draw_wbox(f.get_pushbox_world(), (245, 196, 62), fill_a=28, width=1)
            # Hurtboxes (Emerald normally, Gold when strike-invulnerable!)
            hu_col = (255, 224, 92) if f.is_strike_invulnerable() else (48, 224, 138)
            for hu in f.get_hurtboxes_world():
                draw_wbox(hu, hu_col, fill_a=46, width=2)
            # Active Attack Hitboxes (Crimson) & Clashboxes (Cyan)
            for win in f.get_active_hit_windows():
                draw_wbox(win.hitbox.to_world(f.x, f.y, f.facing_right), (255, 36, 64), fill_a=84, width=2)
                if win.clashbox is not None:
                    draw_wbox(win.clashbox.to_world(f.x, f.y, f.facing_right), (72, 228, 255), fill_a=22, width=1)

        # Projectile Hitboxes
        for pr in vfx.projectiles:
            draw_wbox(pr.get_hitbox_world(), (255, 64, 128), fill_a=72, width=2)

        target.blit(overlay, (0, 0))

