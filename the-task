    def _tick_versus(self) -> None:
        self.versus_timer -= 1
        self.canvas.fill((12, 4, 8))
        # Diagonal Crimson-Gold Split Screen (GDD 8.2)
        pygame.draw.polygon(self.canvas, (98, 14, 24), [(0, 0), (INTERNAL_W // 2 + 120, 0), (INTERNAL_W // 2 - 120, INTERNAL_H), (0, INTERNAL_H)])
