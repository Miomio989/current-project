        # 2. Sleek fitted black lower sleeve (puff_end -> elbow -> wrist)
        self.rast.draw_shaded_capsule(
            surf,
            puff_end,
            el,
            r_a=5.6 * s,
            r_b=5.0 * s,
            shadow_col=pal.leather_shadow,
            base_col=pal.leather_base,
            light_col=pal.leather_gloss,
            outline_col=pal.ink_dark,
            outline_width=1,
        )
        self.rast.draw_shaded_capsule(
            surf,
            el,
            wr,
            r_a=5.1 * s,
            r_b=4.0 * s,
            shadow_col=pal.leather_shadow,
            base_col=pal.leather_base,
