def render_calligraphy_logo(
    width: int,
    height: int,
    rast: PainterlyRasterizer,
    ink_light: RGB = (255, 246, 248),
    ink_mid: RGB = (242, 212, 224),
    ink_shadow: RGB = (148, 22, 56),
    glow_color: RGB = (232, 24, 72),
    with_blood_slash: bool = True,
) -> pygame.Surface:
    """Procedurally paint the brush-calligraphy title emblem 「呪いの刃」."""
    surf = pygame.Surface((width, height), pygame.SRCALPHA)

    if with_blood_slash:
        slash_spine = sample_quad_bezier(
            Vec2(width * 0.02, height * 0.72),
            Vec2(width * 0.52, height * 0.45),
            Vec2(width * 0.98, height * 0.25),
            steps=18,
        )
        widths = [height * (0.02 + 0.13 * math.sin((i / 18.0) * math.pi)) for i in range(19)]
        rast.paint_soft_shadow_poly(surf, build_variable_ribbon(slash_spine, widths), (132, 8, 38), alpha=165)
        rast.paint_soft_shadow_poly(surf, build_variable_ribbon(slash_spine, [w * 0.44 for w in widths]), (255, 42, 96), alpha=175)

    glyph_specs = (
        (_KANJI_NOROI_STROKES, 0.04, 0.04, 0.29, 0.92),
        (_HIRAGANA_I_STROKES, 0.31, 0.24, 0.18, 0.64),
        (_HIRAGANA_NO_STROKES, 0.47, 0.22, 0.20, 0.68),
        (_KANJI_YAIBA_STROKES, 0.65, 0.02, 0.32, 0.96),
    )

    for _, gx, gy, gw, gh in glyph_specs:
        cx = (gx + gw * 0.5) * width
        cy = (gy + gh * 0.5) * height
        rast.paint_radial_bloom(surf, cx, cy, max(gw * width, gh * height) * 0.65, glow_color, alpha=135, additive=True)

    for shadow_pass in (True, False):
        ox = 3.0 if shadow_pass else 0.0
        oy = 4.0 if shadow_pass else 0.0
        for strokes, gx, gy, gw, gh in glyph_specs:
            scale_x = gw * width
            scale_y = gh * height
            x0 = gx * width + ox
            y0 = gy * height + oy
            base_w = min(scale_x, scale_y)
            for st in strokes:
                pts_world = [Vec2(x0 + p.x * scale_x, y0 + p.y * scale_y) for p in st.points]
                curve = sample_catmull_rom(pts_world, steps_per_seg=6)
                w_interp: List[float] = []
                m = len(curve)
                wn = len(st.widths)
                for k in range(m):
                    u = k / float(max(1, m - 1))
                    fi = u * (wn - 1)
                    i0 = int(fi)
                    i1 = min(wn - 1, i0 + 1)
                    wv = lerp(st.widths[i0], st.widths[i1], fi - i0)
                    w_interp.append(max(1.2, wv * base_w * (1.16 if shadow_pass else 1.0)))
                ribbon = build_variable_ribbon(curve, w_interp)
                if len(ribbon) >= 4:
                    if shadow_pass:
                        rast.paint_soft_shadow_poly(surf, ribbon, (24, 4, 14), alpha=225)
                    else:
                        rast.paint_shaded_poly(
                            surf, ribbon, ink_light, ink_mid, ink_shadow,
                            light_dir=(0.3, -0.95), rim_color=(255, 204, 218), rim_strength=0.45,
                            outline_color=(28, 6, 16), outline_width=1.4, cel_cut=0.38,
                        )

    for sp in range(18):
        sx = int(width * (0.05 + 0.90 * hash_2d(sp, 11, 503)))
        sy = int(height * (0.10 + 0.80 * hash_2d(sp, 29, 911)))
        sr = 1 if (sp % 3 != 0) else 2
        col = (255, 64, 108, 195) if (sp % 2 == 0) else (255, 224, 232, 165)
        pygame.draw.circle(surf, col, (sx, sy), sr)
    return surf


