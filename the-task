        def make_sound(samples_l: Sequence[float], samples_r: Optional[Sequence[float]] = None) -> pygame.mixer.Sound:
            buf = array.array("h")
            r_seq = samples_l if samples_r is None else samples_r
            for a, b in zip(samples_l, r_seq):
                buf.append(clamp_int(int(_soft_clip(a) * 30000.0), -32767, 32767))
                buf.append(clamp_int(int(_soft_clip(b) * 30000.0), -32767, 32767))
            return pygame.mixer.Sound(buffer=buf.tobytes())

        def synth_chime(freqs: Sequence[float], dur: float, decay: float, gain: float = 0.55) -> pygame.mixer.Sound:
            n = int(sr * dur)
            sl, sr_v = [], []
            for i in range(n):
                t = i / float(sr)
                env = min(1.0, t * 180.0) * math.exp(-t * decay)
                v = sum(math.sin(t * f * math.tau) for f in freqs) / max(1, len(freqs))
                sl.append(v * env * gain)
                sr_v.append(v * env * gain * (0.94 + 0.06 * math.sin(t * 22.0)))
            return make_sound(sl, sr_v)

        def synth_whoosh(f0: float, f1: float, dur: float, grit: float, gain: float) -> pygame.mixer.Sound:
            n = int(sr * dur)
            sl, sr_v = [], []
            lp = 0.0
            ph = 0.0
            for i in range(n):
                t = i / float(sr)
                u = t / dur
                env = math.sin(u * math.pi) ** 0.72
                wn = rng.uniform(-1.0, 1.0)
                fc = clamp(lerp(f0, f1, u) / (sr * 0.5), 0.02, 0.85)
                lp += fc * (wn - lp)
                ph += lerp(f0 * 0.35, f1 * 0.25, u) * math.tau / sr
                v = (lp * 0.72 + math.sin(ph) * grit) * env * gain
                sl.append(v * (1.1 - u * 0.3))
                sr_v.append(v * (0.8 + u * 0.3))
            return make_sound(sl, sr_v)

        def synth_slash_hit(base_f: float, dur: float, gore: float, punch: float) -> pygame.mixer.Sound:
            n = int(sr * dur)
            sl, sr_v = [], []
            ph = 0.0
            prev = 0.0
            for i in range(n):
                t = i / float(sr)
                f = base_f * math.exp(-t * 18.0) + 46.0
                ph += f * math.tau / sr
                thump = math.sin(ph) * math.exp(-t * 14.0) * punch
                wn = rng.uniform(-1.0, 1.0)
                hp = wn - prev * 0.65
                prev = wn
                slice_shing = math.sin(t * 2450.0 * math.tau) * math.exp(-t * 36.0) * 0.35
                flesh_rip = hp * math.exp(-t * 11.5) * gore * (0.7 + 0.3 * math.sin(t * 95.0))
                v = thump + slice_shing + flesh_rip
                sl.append(v * 0.96)
                sr_v.append(v * 0.92 + flesh_rip * 0.14)
            return make_sound(sl, sr_v)

        def synth_water(dur: float, brightness: float, gain: float) -> pygame.mixer.Sound:
