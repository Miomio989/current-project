    K_NONE = (0,) * 16

    S_BREAK_A = (0, 0, 0, 0, 1, 0, 0, 2, 0, 2, 0, 0, 1, 0, 0, 2)
    S_BREAK_B = (0, 0, 0, 0, 1, 0, 2, 0, 0, 2, 0, 1, 0, 0, 1, 2)
    S_TECHNO = (0, 0, 0, 0, 3, 0, 0, 0, 0, 0, 0, 0, 3, 0, 0, 2)
    S_ROLL_8 = (0, 0, 1, 0, 1, 0, 1, 0, 1, 1, 1, 1, 1, 1, 1, 1)
    S_FILL = (0, 0, 0, 0, 1, 0, 2, 1, 0, 1, 1, 2, 1, 1, 1, 1)
    S_NONE = (0,) * 16

    H_16TH = (1, 1, 2, 1, 1, 1, 2, 1, 1, 1, 2, 1, 1, 1, 2, 1)
    H_OFF = (0, 0, 2, 0, 0, 0, 2, 0, 0, 0, 2, 0, 0, 0, 2, 1)
    H_RIDE = (3, 1, 3, 2, 3, 1, 3, 1, 3, 1, 3, 2, 3, 1, 3, 2)
    H_SPARSE = (1, 0, 0, 1, 0, 0, 1, 0, 1, 0, 0, 1, 0, 0, 2, 0)
    H_NONE = (0,) * 16

