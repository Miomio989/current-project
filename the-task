class NoroiNoHaApp:
    """Top-level application managing Title Medallion, Character Select, Versus, Match, Relics & Options."""

    def __init__(self, force_software: bool = False) -> None:
        pygame.init()
        self.use_opengl = bool(HAS_OPENGL and not force_software)
        flags = (pg_locals.DOUBLEBUF | pg_locals.OPENGL) if self.use_opengl else pg_locals.DOUBLEBUF
        try:
            self.screen = pygame.display.set_mode((INTERNAL_W, INTERNAL_H), flags)
        except Exception:
            self.use_opengl = False
            self.screen = pygame.display.set_mode((INTERNAL_W, INTERNAL_H))
        pygame.display.set_caption(WINDOW_TITLE)
        self.canvas = pygame.Surface((INTERNAL_W, INTERNAL_H), pygame.SRCALPHA if self.use_opengl else 0)
        self.clock = pygame.time.Clock()

        self.textures = ProceduralTextureAtlas()
        self.audio = ProceduralAudioEngine()
        self._run_boot_synthesis_screen()

        self.renderer = Renderer3D(self.textures, use_opengl=self.use_opengl)
        if self.use_opengl:
            self.renderer.init_opengl_state()
        self.hud = OrnateHUDRenderer(self.textures)

        # App State
        self.mode: str = "title"  # title, select, versus, match, relics, options
        self.menu_cursor: int = 0
        self.select_p1_char: int = 0  # 0=cecilia, 1=kiri
        self.select_p2_char: int = 1
        self.select_p1_pal: int = 0
        self.select_p2_pal: int = 0
        self.select_vow: int = 0
        self.game_mode_type: str = "1p_cpu"  # 1p_cpu, 2p_vs, training, cpu_demo
        self.control_scheme: str = "ritual"
        self.photosafe: bool = False
        self.gore_level: int = 2
        self.pulse_enabled: bool = True
        self.show_hitboxes: bool = False
        self.versus_timer: int = 0
        self.relic_cursor: int = 0
        self.menu_rot: float = 0.0
        self.match: Optional[MatchSession] = None

    def _run_boot_synthesis_screen(self) -> None:
        font = pygame.font.SysFont("georgia", 24, bold=True)
        small = pygame.font.SysFont("consolas", 16)

        def show_progress(msg: str, frac: float) -> None:
            if self.use_opengl:
                return
            self.screen.fill((12, 5, 8))
            t = font.render(f"{GAME_TITLE_JP}  —  FORGING PROCEDURAL ASSETS", True, (242, 190, 72))
            m = small.render(msg, True, (226, 206, 190))
            self.screen.blit(t, (INTERNAL_W // 2 - t.get_width() // 2, INTERNAL_H // 2 - 64))
            self.screen.blit(m, (INTERNAL_W // 2 - m.get_width() // 2, INTERNAL_H // 2 - 14))
            bw = 540
            bx = INTERNAL_W // 2 - bw // 2
            by = INTERNAL_H // 2 + 26
            pygame.draw.rect(self.screen, (48, 20, 26), (bx, by, bw, 18))
            pygame.draw.rect(self.screen, (218, 34, 42), (bx + 2, by + 2, int((bw - 4) * clamp(frac, 0.0, 1.0)), 14))
            pygame.draw.rect(self.screen, (238, 186, 68), (bx, by, bw, 18), 2)
            pygame.display.flip()
            pygame.event.pump()

        self.textures.build_all(lambda m, f: show_progress(m, f * 0.6))
        self.audio.init_and_build(lambda m, f: show_progress(m, 0.6 + f * 0.4))

    def _start_match(self) -> None:
        c1 = "cecilia" if self.select_p1_char == 0 else "kiri"
        c2 = "cecilia" if self.select_p2_char == 0 else "kiri"
        p1 = Fighter(0, c1, self.select_p1_pal, self.select_vow, self.control_scheme, is_cpu=(self.game_mode_type == "cpu_demo"), cpu_level=3)
        p2 = Fighter(1, c2, self.select_p2_pal, 0, self.control_scheme, is_cpu=(self.game_mode_type in ("1p_cpu", "cpu_demo")), cpu_level=2)
        self.match = MatchSession(
            p1, p2, self.audio,
            training_mode=(self.game_mode_type == "training"),
            photosafe=self.photosafe,
            gore_level=self.gore_level,
            pulse_enabled=self.pulse_enabled,
        )
        self.mode = "versus"
        self.versus_timer = 85

    def _read_player_inputs(self, keys: Sequence[bool], pressed: set, slot: int) -> Dict[str, Any]:
        if slot == 0:
            left = keys[pg_locals.K_a]
            right = keys[pg_locals.K_d]
            down = keys[pg_locals.K_s]
            up_p = pg_locals.K_w in pressed
            l_p = pg_locals.K_j in pressed
            h_p = pg_locals.K_k in pressed
            h_h = keys[pg_locals.K_k]
            k_p = pg_locals.K_l in pressed
            c_p = pg_locals.K_u in pressed
            g_p = pg_locals.K_i in pressed
            g_h = keys[pg_locals.K_i]
            t_p = pg_locals.K_o in pressed
            m_p = pg_locals.K_p in pressed
        else:
            left = keys[pg_locals.K_LEFT]
            right = keys[pg_locals.K_RIGHT]
            down = keys[pg_locals.K_DOWN]
            up_p = pg_locals.K_UP in pressed
            l_p = (pg_locals.K_KP1 in pressed) or (pg_locals.K_f in pressed)
            h_p = (pg_locals.K_KP2 in pressed) or (pg_locals.K_g in pressed)
            h_h = keys[pg_locals.K_KP2] or keys[pg_locals.K_g]
            k_p = (pg_locals.K_KP3 in pressed) or (pg_locals.K_h in pressed)
            c_p = (pg_locals.K_KP4 in pressed) or (pg_locals.K_r in pressed)
            g_p = (pg_locals.K_KP5 in pressed) or (pg_locals.K_t in pressed)
            g_h = keys[pg_locals.K_KP5] or keys[pg_locals.K_t]
            t_p = (pg_locals.K_KP6 in pressed) or (pg_locals.K_y in pressed)
            m_p = (pg_locals.K_KP0 in pressed) or (pg_locals.K_v in pressed)
        return {
            "move_x": (1 if right else 0) - (1 if left else 0),
            "down": down,
            "jump_pressed": up_p,
            "light_pressed": l_p and not k_p,
            "heavy_pressed": h_p,
            "heavy_held": h_h,
            "kick_pressed": k_p and not l_p and not g_h,
            "curse_pressed": c_p,
            "guard_pressed": g_p,
            "guard_held": g_h,
            "trance_pressed": t_p,
            "seize_pressed": l_p and k_p,
            "roll_pressed": g_h and k_p,
            "maledict_pressed": m_p,
        }

    def run(self) -> None:
        running = True
        self.audio.start_music()
        while running:
            pressed = set()
            for ev in pygame.event.get():
                if ev.type == pg_locals.QUIT:
                    running = False
                elif ev.type == pg_locals.KEYDOWN:
                    pressed.add(ev.key)
                    if ev.key == pg_locals.K_F2:
                        self.show_hitboxes = not self.show_hitboxes
                    elif ev.key == pg_locals.K_m:
                        self.audio.muted = not self.audio.muted
                        self.audio._apply_mix()

            keys = pygame.key.get_pressed()
            self.menu_rot = (self.menu_rot + 0.35) % 360.0

            if self.mode == "title":
                self._tick_title(pressed)
            elif self.mode == "select":
                self._tick_select(pressed)
            elif self.mode == "versus":
                self._tick_versus()
            elif self.mode == "match":
                self._tick_match(keys, pressed)
            elif self.mode == "relics":
                self._tick_relics(pressed)
            elif self.mode == "options":
                self._tick_options(pressed)

            if self.use_opengl and self.mode == "match" and self.match is not None:
                self.renderer.render_opengl_frame(
                    self.canvas, self.match.camera, self.match.stage_area,
                    self.match.get_lighting_script_key(), self.match.beat_pulse, self.match.fighters
                )
            else:
                if self.use_opengl:
                    self.renderer.render_opengl_frame(
                        self.canvas, Camera3D(), 0, "prelude", 0.0, ()
                    )
                else:
                    self.screen.blit(self.canvas, (0, 0))
            pygame.display.flip()
            self.clock.tick(FPS)

        pygame.quit()

    def _tick_title(self, pressed: set) -> None:
        items = [
            ("DUEL — 1P vs CPU", "1p_cpu"),
            ("LOCAL VERSUS — 2P", "2p_vs"),
            ("TRAINING & METRONOME", "training"),
            ("CPU SHOWCASE", "cpu_demo"),
            ("RELICS LORE CODEX", "relics"),
            ("OPTIONS & ACCESSIBILITY", "options"),
        ]
        if pg_locals.K_UP in pressed or pg_locals.K_w in pressed:
            self.menu_cursor = (self.menu_cursor - 1) % len(items)
            self.audio.play_sfx("menu_move", 0.7)
        elif pg_locals.K_DOWN in pressed or pg_locals.K_s in pressed:
            self.menu_cursor = (self.menu_cursor + 1) % len(items)
            self.audio.play_sfx("menu_move", 0.7)
        elif pg_locals.K_RETURN in pressed or pg_locals.K_j in pressed or pg_locals.K_SPACE in pressed:
            self.audio.play_sfx("menu_confirm", 0.9)
            choice = items[self.menu_cursor][1]
            if choice == "relics":
                self.mode = "relics"
            elif choice == "options":
                self.mode = "options"
            else:
                self.game_mode_type = choice
                self.mode = "select"

        # Draw Hypnotic Rotating Red-and-Gold Radial Lotus-and-Gear Menu (GDD 8.2)
        self.canvas.blit(self.textures.sky_cache["eclipse"], (0, 0))
        pygame.draw.rect(self.canvas, (14, 5, 9), (0, int(INTERNAL_H * 0.56), INTERNAL_W, INTERNAL_H))
        med = pygame.transform.rotozoom(self.textures.surfaces["menu_medallion"], self.menu_rot, 1.0)
        self.canvas.blit(med, (INTERNAL_W // 2 - med.get_width() // 2, INTERNAL_H // 2 - med.get_height() // 2))

        title = self.hud.font_title.render(GAME_TITLE_JP, True, (255, 214, 88))
        sub = self.hud.font_hud.render(GAME_SUBTITLE, True, (242, 178, 128))
        self.canvas.blit(title, (INTERNAL_W // 2 - title.get_width() // 2, 74))
        self.canvas.blit(sub, (INTERNAL_W // 2 - sub.get_width() // 2, 154))

        for i, (label, _) in enumerate(items):
            sel = (i == self.menu_cursor)
            col = (255, 224, 108) if sel else (206, 178, 168)
            txt = self.hud.font_sub.render(("> " if sel else "  ") + label, True, col)
            self.canvas.blit(txt, (INTERNAL_W // 2 - txt.get_width() // 2, 260 + i * 52))

    def _tick_select(self, pressed: set) -> None:
