    def spawn_hit_sparks(
        self, x: float, y: float, pal: CeciliaPalette, weight: AttackWeight, blood_scale: float = 1.0
    ) -> None:
        """Spawn mockup.jpg dazzling electric magenta-white burst + R18+ visceral blood spray!"""
        cnt = 16 + weight.value * 7
        for _ in range(cnt):
            if len(self.particles) > 360:
                self.particles.pop(0)
            ang = random.uniform(0.0, math.tau)
            spd = random.uniform(140.0, 560.0) * (0.8 + weight.value * 0.22)
            col = random.choice((pal.aura_core, pal.aura_mid, (255, 255, 255), (255, 112, 178)))
            self.particles.append(
                VFXParticle(
                    x=x, y=y, vx=math.cos(ang) * spd, vy=math.sin(ang) * spd,
                    size=random.uniform(2.0, 4.5), life=0.0, max_life=random.uniform(0.16, 0.34),
                    color=col, gravity=0.0, additive=True, streak=True,
                )
            )
        # Visceral crimson blood droplets arcing out with gravity (R18+ realistic sword combat)
        n_blood = int((10 + weight.value * 6) * clamp(blood_scale, 0.0, 1.5))
        for _ in range(n_blood):
            if len(self.particles) > 380:
                self.particles.pop(0)
            ang = random.uniform(-math.pi * 0.85, -math.pi * 0.15)
            spd = random.uniform(90.0, 340.0)
            col = random.choice(((220, 16, 48), (168, 8, 32), (255, 42, 76)))
            self.particles.append(
                VFXParticle(
                    x=x, y=y, vx=math.cos(ang) * spd, vy=math.sin(ang) * spd,
                    size=random.uniform(2.2, 5.2), life=0.0, max_life=random.uniform(0.32, 0.62),
                    color=col, gravity=760.0, additive=False, streak=True,
