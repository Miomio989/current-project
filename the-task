        )

    def spawn_cataclysm_pillar(
        self, owner_id: int, x: float, delay_frames: int, damage: int, pal_idx: int
    ) -> None:
        self.pillars.append(CataclysmPillar(owner_id, x, delay_frames, damage, pal_idx))

    def update(self, dt: float) -> None:
        if self.super_freeze > 0:
            self.super_freeze -= 1
        if self.super_banner_timer > 0:
            self.super_banner_timer -= 1
            if self.super_banner_timer == 0:
                self.super_banner = None

        alive_p: List[VFXParticle] = []
        for p in self.particles:
            p.life += dt
            if p.life < p.max_life:
                p.x += p.vx * dt
                p.y += p.vy * dt
                p.vy += p.gravity * dt
                alive_p.append(p)
        self.particles = alive_p

        alive_r: List[ShockwaveRing] = []
        for r in self.rings:
            r.radius += (r.max_radius - r.radius) * min(1.0, dt * 15.0) + dt * 65.0
            r.alpha -= dt * 3.8
            if r.alpha > 0.04:
                alive_r.append(r)
        self.rings = alive_r

        alive_a: List[AfterimageGhost] = []
        for g in self.afterimages:
            g.alpha -= dt * 3.2
            if g.alpha > 0.05:
                alive_a.append(g)
        self.afterimages = alive_a

        alive_c: List[TacticalCallout] = []
        for c in self.callouts:
            c.life -= dt
            c.y -= 28.0 * dt
            if c.life > 0.0:
                alive_c.append(c)
        self.callouts = alive_c

        alive_pr: List[BloodMoonProjectile] = []
        for pr in self.projectiles:
            pr.x += pr.vx
            pr.life -= dt
            if pr.hit_cooldown > 0:
                pr.hit_cooldown -= 1
            if pr.life > 0.0 and pr.hits_left > 0 and 20.0 < pr.x < WORLD_W - 20.0:
                alive_pr.append(pr)
        self.projectiles = alive_pr

        alive_pil: List[CataclysmPillar] = []
        for pil in self.pillars:
            if pil.delay_frames > 0:
                pil.delay_frames -= 1
                alive_pil.append(pil)
            elif pil.active_frames > 0:
                pil.active_frames -= 1
                alive_pil.append(pil)
        self.pillars = alive_pil

