    def edit_set_source(self, path: Optional[str]) -> None:
        if path and not os.path.isfile(path):
            return
        if path and is_depth_image_path(path):
            self._flash_summary("Depth attachments cannot be edited - pick the source image.")
            return
        if not path:
            self.edit_source_path = None
            self.edit_base = None
            self.edit_undo_stack.clear()
            self.edit_undo_btn.setEnabled(False)
            self.edit_canvas.set_document(None)
            self.edit_source_caption.setText("Open an image (viewer, gallery context menu, OPEN\u2026, or drop it).")
            self._update_edit_stage()
            self._update_edit_buttons()
            return
        img = QImage(path)
        if img.isNull():
            self._flash_summary(f"Cannot decode {os.path.basename(path)}")
            return
        if img.width() * img.height() > IMG2IMG_MAX_SRC_MP:
            self._flash_summary("Image is too large for the editor (over 3072\u00d73072).")
            return
        self.edit_source_path = path
        self.edit_base = img
        self.edit_undo_stack.clear()
        self.edit_redo_stack.clear()
        self.edit_undo_btn.setEnabled(False)
        if hasattr(self, 'edit_redo_btn'):
            self.edit_redo_btn.setEnabled(False)
        # a fresh document starts clean: flares are view-relative decorations
        self.edit_flares = []
        self._edit_flare_sel = -1
        self._sync_flare_ui()
        # v4.2: fresh context-tool state (lasso / crop / tilt / eraser)
        self.edit_canvas.set_paint_erase(False)
        self.edit_paint_erase_btn.blockSignals(True)
        self.edit_paint_erase_btn.setChecked(False)
        self.edit_paint_erase_btn.setText("Eraser")
        self.edit_paint_erase_btn.blockSignals(False)
        self.edit_poly_feather_sl.blockSignals(True)
        self.edit_poly_feather_sl.setValue(0)
        self.edit_poly_feather_sl.blockSignals(False)
        self.edit_crop_aspect.blockSignals(True)
        self.edit_crop_aspect.setCurrentIndex(0)
        self.edit_crop_aspect.blockSignals(False)
        self.edit_canvas.set_crop_aspect("free")
        self.edit_rot_slider.blockSignals(True)
        self.edit_rot_slider.setValue(0)
        self.edit_rot_slider.blockSignals(False)
        self.edit_canvas.set_document(img)
        self._sync_paint_swatch()
        self._sync_poly_labels()
        self._on_edit_crop_changed()
        self.edit_source_caption.setText(
            f"Editing: {os.path.basename(path)}  ({img.width()}\u00d7{img.height()})\u2003"
            f"grade \u2192 optionally mask \u2192 APPLY \u2192 SAVE AS NEW"
        )
        if hasattr(self, "edit_stage_doc_lbl"):
            self.edit_stage_doc_lbl.setText(
                f"{os.path.basename(path)}  \u00b7  {img.width()}\u00d7{img.height()}"
            )
        self._update_split_info()
        self._edit_recompute_now()
        self.tabs.setCurrentIndex(TAB_EDIT)
        self._update_edit_stage()

    # ---- Edit stage visibility (full-size editor in the viewer area) --------
    def _on_left_tab_changed(self, idx: int) -> None:
