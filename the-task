    def _paint_dead_swamp_tree(
        self,
        surf: pygame.Surface,
        bx: int,
        by: int,
        height: int,
        rng: random.Random,
        col: RGBA,
        rim: RGBA,
    ) -> None:
        def branch(x0: float, y0: float, ang: float, length: float, thick: float, depth: int) -> None:
            if depth <= 0 or length < 8.0:
                return
            x1 = x0 + math.cos(ang) * length
            y1 = y0 + math.sin(ang) * length
            pygame.draw.line(surf, rim, (int(x0) + 1, int(y0)), (int(x1) + 1, int(y1)), max(1, int(thick)))
            pygame.draw.line(surf, col, (int(x0), int(y0)), (int(x1), int(y1)), max(1, int(thick)))
            # Hanging ghostly swamp moss strands
            if depth <= 2 and rng.random() < 0.58:
                ml = rng.randint(10, 26)
                pygame.draw.line(surf, (col[0] + 18, col[1] + 8, col[2] + 14, 150), (int(x1), int(y1)), (int(x1 + rng.uniform(-3, 3)), int(y1 + ml)), 1)
            splits = 2 if depth > 1 else 1
            for _ in range(splits):
                da = rng.uniform(-0.62, 0.62)
                branch(x1, y1, ang + da, length * rng.uniform(0.62, 0.78), max(1.0, thick * 0.66), depth - 1)

        branch(float(bx), float(by), -math.pi * 0.5 + rng.uniform(-0.14, 0.14), float(height) * 0.42, 8.5, 4)

    # --------------------------------------------------------------------------
    # LAYER 2: Monumental Ruined Romanesque-Gothic Cathedral + Glowing Rose Window
    # --------------------------------------------------------------------------

    def _bake_romanesque_cathedral(self) -> pygame.Surface:
        w, h = 1440, 500
        surf = pygame.Surface((w, h), pygame.SRCALPHA)
        cx = w // 2  # 720
        base_y = 456

        stone_dark = (22, 10, 20)
        stone_mid = (46, 22, 36)
        stone_lit = (98, 42, 58)
        stone_rim = (218, 52, 84)

        def draw_weathered_masonry(rect: pygame.Rect, lit_side: int = 1) -> None:
            pygame.draw.rect(surf, stone_dark, rect)
            # Painterly stone block courses with weathered variation
            row_h = 12
            for ry in range(rect.y, rect.bottom, row_h):
                row_idx = (ry - rect.y) // row_h
                x_off = (row_idx % 2) * 14
                for rx in range(rect.x - x_off, rect.right, 28):
                    bx = max(rect.x, rx)
                    bw = min(rect.right - bx, 26)
                    bh = min(rect.bottom - ry, row_h - 1)
                    if bw <= 2 or bh <= 2:
                        continue
                    nv = hash_2d(bx, ry, 555)
                    c = lerp_rgb(stone_dark, stone_mid, nv * 0.72)
                    if nv > 0.76:
                        c = lerp_rgb(c, stone_lit, 0.35)
                    pygame.draw.rect(surf, c, (bx, ry, bw, bh))
            # Crimson Blood-Moon rim along upper/outer masonry face
            rim_x = rect.right - 2 if lit_side > 0 else rect.x
            pygame.draw.line(surf, stone_rim, (rim_x, rect.y), (rim_x, rect.bottom), 2)
            pygame.draw.line(surf, stone_lit, (rect.x, rect.y), (rect.right, rect.y), 2)

        # 1. Flanking ruined Romanesque colonnade wings (left & right naves)
        for side in (-1, 1):
            for bay in range(4):
                bx = cx + side * (128 + bay * 72) - 34
                bh = 195 - bay * 20
                by = base_y - bh
                draw_weathered_masonry(pygame.Rect(bx, by, 68, bh), lit_side=side)
                # Crumbled jagged roof top
                for jag in range(4):
                    jx = bx + jag * 17
                    jh = (12 + ((bay * 7 + jag * 11) % 18))
                    pygame.draw.polygon(
                        surf, stone_dark,
                        [(jx, by), (jx + 8, by - jh), (jx + 17, by)],
                    )
                # Pointed/Romanesque arched window opening glowing faint crimson!
                arch_r = pygame.Rect(bx + 14, by + 34, 40, bh - 56)
                pygame.draw.rect(surf, (108, 16, 42), arch_r)
                pygame.draw.ellipse(surf, (132, 20, 48), (arch_r.x, arch_r.y - 18, arch_r.w, 36))
                # Mullion bars inside ruined arch
                pygame.draw.line(surf, stone_dark, (arch_r.centerx, arch_r.y - 16), (arch_r.centerx, arch_r.bottom), 3)
                pygame.draw.line(surf, stone_lit, (arch_r.x, arch_r.y), (arch_r.x, arch_r.bottom), 1)
                # Flying buttress arch connecting outer wings
                if bay < 3:
                    fb_a = (bx + (68 if side < 0 else 0), by + 30)
                    fb_b = (bx + (68 if side < 0 else 0) + side * 42, base_y - 40)
