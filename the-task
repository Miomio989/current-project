    def _on_lora_d_pref(self) -> None:
        entry = self._lora_detail_entry()
        if entry is None:
            return
        pm = round(float(entry.get("preferred_strength", 1.0)), 2)
        pc = round(float(entry.get("preferred_clip", pm)), 2)
