@dataclass(frozen=True)
class ReplayFrame:
    p1_dx: int
    p1_dy: int
    p1_btn: int
    p2_dx: int
    p2_dy: int
    p2_btn: int


class MatchReplayBuffer:
    """Deterministic frame-exact input recorder & playback theater."""

    def __init__(self) -> None:
        self.frames: List[ReplayFrame] = []
        self.saved_label: str = "No Match Recorded Yet"
        self.p1_pal: str = "CRIMSON_ORIGINAL"
        self.p2_pal: str = "MOONLIT_MIRABELLE"
        self.p2_name: str = "MIRABELLE (SHADOW)"
        self.playback_idx: int = 0

    def start_recording(self, p1_pal: str, p2_pal: str, p2_name: str, label: str) -> None:
        self.frames.clear()
        self.p1_pal = p1_pal
        self.p2_pal = p2_pal
        self.p2_name = p2_name
        self.saved_label = label
        self.playback_idx = 0

    def record(self, p1_dx: int, p1_dy: int, p1_btn: InputButton, p2_dx: int, p2_dy: int, p2_btn: InputButton) -> None:
        if len(self.frames) < 18000:  # Up to 5 full minutes at 60 FPS
            self.frames.append(ReplayFrame(p1_dx, p1_dy, int(p1_btn), p2_dx, p2_dy, int(p2_btn)))

    def next_playback_frame(self) -> Optional[ReplayFrame]:
        if self.playback_idx >= len(self.frames):
            return None
        fr = self.frames[self.playback_idx]
        self.playback_idx += 1
        return fr


class MatchDirector:
    """
    Orchestrates complete fighting-game match loops across all 6 modes:
      - ARCADE (6-stage gothic ladder culminating in Eclipse Cecilia & Epilogue)
      - VERSUS CPU & VERSUS 2P LOCAL
      - SURVIVAL (endless cursed gauntlet with partial vampiric recovery)
      - TRAINING LAB (infinite timer, instant reset, hitboxes, frame data, 12 trials)
      - REPLAY THEATER (frame-exact deterministic playback)
    """

    def __init__(
        self,
        rast: PainterlyRasterizer,
        bank: SpriteBank,
        stage: CursedCathedralStage,
        audio: AudioManager,
        fonts: FontManager,
        inputs: InputManager,
        settings: GameSettings,
    ) -> None:
        self.rast = rast
        self.bank = bank
        self.stage = stage
        self.audio = audio
        self.fonts = fonts
        self.inputs = inputs
        self.settings = settings
        self.tcfg = TrainingSettings()

        self.move_reg = build_move_registry()
        self.vfx = VFXManager(rast, bank, settings)
        self.cam = CameraDirector()
        self.hud = BattleHUDRenderer(rast, bank, fonts)
        self.training_lab = TrainingLabOverlay(fonts, self.tcfg)
        self.replay = MatchReplayBuffer()

        self.mode: GameMode = GameMode.ARCADE
        self.phase: RoundPhase = RoundPhase.INTRO
        self.phase_timer: int = 0
        self.round_num: int = 1
        self.timer_frames: int = DEFAULT_ROUND_TIME * TARGET_FPS
        self.arcade_stage_idx: int = 0
        self.survival_streak: int = 0
        self.super_freeze_frames: int = 0
        self.stats = MatchStats()

        self.active_rival: RivalPersona = ARCADE_LADDER[2]
        self.p1 = Fighter(0, CHARACTER_NAME, CHARACTER_TITLE, settings.p1_palette, self.move_reg, bank)
        self.p2 = Fighter(1, self.active_rival.name, self.active_rival.epithet, self.active_rival.palette_key, self.move_reg, bank)
        self.ai = ShadowCeciliaAI(self.active_rival)
        self.dummy_ctrl = TrainingDummyController(self.tcfg, self.ai)
        self.resolver = CombatResolver(self.move_reg, self.vfx, self.cam, self.stage, self.audio, self.stats, self.settings)
        self.resolver.on_move_hit_callback = self._on_training_move_hit

        self.banner_text: str = ""
        self.banner_sub: str = ""
        self.banner_alpha: float = 0.0
        self.match_finished_callback: Optional[Callable[[bool], None]] = None

    def _on_training_move_hit(self, player_id: int, state: FighterState) -> None:
        if self.mode == GameMode.TRAINING:
            cleared = self.training_lab.trials.on_move_hit(player_id, state)
            if cleared:
                self.vfx.add_callout("TRIAL CLEAR!", self.training_lab.trials.current.title, (255, 224, 96), -1, 1.8)
                self.audio.play_sfx(SFXId.RANK_UP)

    def start_new_mode(
        self,
        mode: GameMode,
        p1_pal: Optional[str] = None,
        p2_pal: Optional[str] = None,
        rival_idx: int = 2,
        ai_diff: Optional[AIDifficulty] = None,
        arcade_stage: int = 0,
    ) -> None:
        self.mode = mode
        self.arcade_stage_idx = clamp_int(arcade_stage, 0, len(ARCADE_LADDER) - 1)
        if mode == GameMode.ARCADE:
            rival = ARCADE_LADDER[self.arcade_stage_idx]
        elif mode == GameMode.SURVIVAL:
            rival = ARCADE_LADDER[self.survival_streak % len(ARCADE_LADDER)]
        else:
            base = ARCADE_LADDER[rival_idx % len(ARCADE_LADDER)]
            if ai_diff is not None:
                rival = dataclasses.replace(base, difficulty=ai_diff)
            else:
                rival = base

        self.active_rival = rival
        p1_pk = p1_pal or self.settings.p1_palette
        p2_pk = p2_pal or (rival.palette_key if mode in (GameMode.ARCADE, GameMode.SURVIVAL) else self.settings.p2_palette)
        p2_nm = "CECILIA (P2)" if mode == GameMode.VERSUS_2P else rival.name
        p2_ep = "Crimson Mirror" if mode == GameMode.VERSUS_2P else rival.epithet

        self.stats = MatchStats()
        self.p1 = Fighter(0, CHARACTER_NAME, CHARACTER_TITLE, p1_pk, self.move_reg, self.bank)
        self.p2 = Fighter(1, p2_nm, p2_ep, p2_pk, self.move_reg, self.bank)
        self.ai = ShadowCeciliaAI(rival)
        self.dummy_ctrl = TrainingDummyController(self.tcfg, self.ai)
        self.resolver.stats = self.stats

        self.round_num = 1
        self.p1.rounds_won = 0
        self.p2.rounds_won = 0
        self.stage.clear_decals()
        self.vfx.clear()
        self.cam.reset()

        if mode == GameMode.REPLAY:
            self.p1.palette_key = self.replay.p1_pal
            self.p2.palette_key = self.replay.p2_pal
            self.p2.name = self.replay.p2_name
            self.replay.playback_idx = 0
        elif mode != GameMode.TRAINING:
            self.replay.start_recording(p1_pk, p2_pk, p2_nm, f"{mode.value}: {CHARACTER_NAME} vs {p2_nm}")

        self._begin_round(keep_curse=False)
        # Switch to dynamic stage assault OST!
        if mode == GameMode.TRAINING:
            self.audio.play_bgm(OSTTrackId.TRAINING_ACID)
        else:
            self.audio.play_bgm(rival.ost_track)

    def _begin_round(self, keep_curse: bool = True) -> None:
        self.p1.reset_for_round(STAGE_CENTER_X - 165.0, facing_right=True, keep_curse=keep_curse)
        self.p2.reset_for_round(STAGE_CENTER_X + 165.0, facing_right=False, keep_curse=keep_curse)
        self.ai.reset_round()
        self.vfx.clear()
        self.cam.reset()
        self.super_freeze_frames = 0
        self.stage.target_eclipse_dim = 0.0

        if self.mode == GameMode.TRAINING:
            self.phase = RoundPhase.FIGHT
            self.timer_frames = -1
            self.p1.curse = MAX_CURSE
            self.banner_text = ""
            self.banner_alpha = 0.0
            return

        self.timer_frames = (-1 if self.settings.round_time < 0 else self.settings.round_time * TARGET_FPS)
        self.phase = RoundPhase.INTRO if self.round_num == 1 else RoundPhase.CALL_ROUND
        self.phase_timer = 64 if self.round_num == 1 else 58
        if self.round_num == 1:
            self.p1.enter_state(FighterState.INTRO_POSE)
            self.p2.enter_state(FighterState.INTRO_POSE)
            self.audio.play_sfx(SFXId.CATHEDRAL_BELL, volume=0.7)
        else:
            self.audio.play_sfx(SFXId.ROUND_CALL)
        # Escalate to Final Round Overdrive music when tied at match point!
        if self.p1.rounds_won == self.settings.rounds_to_win - 1 and self.p2.rounds_won == self.settings.rounds_to_win - 1:
            if self.mode != GameMode.TRAINING and self.active_rival.index < 5:
                self.audio.play_bgm(OSTTrackId.STAGE_ASSAULT_2)

    def reset_training_positions(self) -> None:
        self.p1.reset_for_round(STAGE_CENTER_X - 150.0, facing_right=True, keep_curse=False)
        self.p2.reset_for_round(STAGE_CENTER_X + 150.0, facing_right=False, keep_curse=False)
        self.p1.curse = MAX_CURSE
        self.vfx.clear()
        self.stage.clear_decals()
        self.training_lab.trials.reset_on_drop()

    def _trigger_super_if_needed(self, f: Fighter, new_state: FighterState) -> None:
        spec = self.move_reg.get(new_state)
        if spec is None or not spec.triggers_super_freeze:
            return
        self.super_freeze_frames = 44
        self.stage.target_eclipse_dim = 0.85
        jp_map = {
            FighterState.SUPER_REQUIEM: "CURSED ART — CRIMSON REQUIEM",
            FighterState.SUPER_CATACLYSM: "CURSED ART — BLOODMOON CATACLYSM",
            FighterState.FATAL_ASTRAL_EXEC: "ECLIPSE FATAL ART — ASTRAL EXECUTION",
        }
        self.vfx.trigger_super_cutin(
            f.player_id, f.palette_key, spec.display_name, jp_map.get(new_state, GAME_TITLE_JP),
            eclipse_mode=(new_state == FighterState.FATAL_ASTRAL_EXEC),
        )
        self.audio.play_sfx(SFXId.SUPER_FLASH)
        self.audio.play_sfx(SFXId.VOICE_SUPER)
        if f.player_id == 0:
            self.stats.p1_supers_used += 1
        else:
            self.stats.p2_supers_used += 1

    def tick(self, keys: Sequence[bool]) -> None:
        """Advance match logic by 1 deterministic 60 FPS frame."""
        beat = self.audio.update(FIXED_DT)
        if beat > 0.0:
            self.stage.trigger_beat_pulse(beat)
        self.stage.update(FIXED_DT)
        self.vfx.update(FIXED_DT)

        # Super Art Anime Cut-In Freeze suspends combat physics dramatically!
        if self.super_freeze_frames > 0:
            self.super_freeze_frames -= 1
            if self.super_freeze_frames == 0:
                self.stage.target_eclipse_dim = 0.45 if (self.p1.is_eclipse or self.p2.is_eclipse) else 0.0
            self.cam.update(self.p1.x, self.p2.x, self.p1.y, self.p2.y, FIXED_DT)
            return

        # Camera dramatic slow-motion gate on Lethal Counter / Parry / KO
        if not self.cam.should_tick_simulation():
            self.cam.update(self.p1.x, self.p2.x, self.p1.y, self.p2.y, FIXED_DT)
            return

        self.stats.total_frames += 1

        # Manage Round Phase banners & transitions
        can_control = (self.phase == RoundPhase.FIGHT)
        if self.phase == RoundPhase.INTRO:
            self.phase_timer -= 1
            self.banner_text = f"STAGE {self.arcade_stage_idx + 1}" if self.mode == GameMode.ARCADE else STAGE_NAME[:22]
            self.banner_sub = f"{self.p1.name}  VS  {self.p2.name}"
            self.banner_alpha = clamp(self.phase_timer / 20.0, 0.0, 1.0)
            if self.phase_timer <= 0:
                self.phase = RoundPhase.CALL_ROUND
                self.phase_timer = 56
                self.audio.play_sfx(SFXId.ROUND_CALL)
        elif self.phase == RoundPhase.CALL_ROUND:
            self.phase_timer -= 1
            if self.phase_timer > 24:
                is_final = (self.p1.rounds_won == self.settings.rounds_to_win - 1 and self.p2.rounds_won == self.settings.rounds_to_win - 1)
                self.banner_text = "FINAL ROUND" if is_final else f"ROUND {self.round_num}"
                self.banner_sub = "PREPARE YOUR BLADE"
                self.banner_alpha = 1.0
            else:
                if self.phase_timer == 24:
                    self.audio.play_sfx(SFXId.FIGHT_CALL)
                self.banner_text = "FIGHT!"
                self.banner_sub = "UNLEASH THE CURSED BLADE"
                self.banner_alpha = clamp(self.phase_timer / 22.0, 0.0, 1.0)
            if self.phase_timer <= 0:
                self.phase = RoundPhase.FIGHT
                self.banner_text = ""
                self.banner_alpha = 0.0
        elif self.phase == RoundPhase.KO_SLOWMO:
            self.phase_timer -= 1
            self.banner_alpha = min(1.0, self.banner_alpha + 0.08)
            if self.phase_timer <= 0:
                self.phase = RoundPhase.ROUND_OVER
                self.phase_timer = 86
                if self.p1.hp >= self.p2.hp:
                    self.p1.enter_state(FighterState.WIN_POSE)
                else:
                    self.p2.enter_state(FighterState.WIN_POSE)
        elif self.phase == RoundPhase.ROUND_OVER:
            self.phase_timer -= 1
            if self.phase_timer <= 0:
                p1_won_match = (self.p1.rounds_won >= self.settings.rounds_to_win)
                p2_won_match = (self.p2.rounds_won >= self.settings.rounds_to_win)
                if self.mode == GameMode.SURVIVAL:
                    p1_won_match = (self.p1.rounds_won >= 1)
                    p2_won_match = (self.p2.rounds_won >= 1)
                if p1_won_match or p2_won_match:
                    self.phase = RoundPhase.MATCH_OVER
                    if self.match_finished_callback is not None:
                        self.match_finished_callback(p1_won_match)
                    return
                self.round_num += 1
                self._begin_round(keep_curse=True)
                return

        # Poll inputs (Human / AI / Training Dummy / Replay)
        two_p_kb = (self.mode == GameMode.VERSUS_2P)
        p1_forced: Optional[FighterState] = None
        p2_forced: Optional[FighterState] = None

        if self.mode == GameMode.REPLAY:
            rfr = self.replay.next_playback_frame()
            if rfr is None:
                if self.match_finished_callback is not None:
                    self.match_finished_callback(True)
                return
            p1_dx, p1_dy, p1_btn = rfr.p1_dx, rfr.p1_dy, InputButton(rfr.p1_btn)
            p2_dx, p2_dy, p2_btn = rfr.p2_dx, rfr.p2_dy, InputButton(rfr.p2_btn)
        else:
            p1_dx, p1_dy, p1_btn = self.inputs.poll_player(0, keys, two_p_kb)
            if self.mode == GameMode.VERSUS_2P:
                p2_dx, p2_dy, p2_btn = self.inputs.poll_player(1, keys, True)
            elif self.mode == GameMode.TRAINING:
                p2_dx, p2_dy, p2_btn, p2_forced = self.dummy_ctrl.compute_action(self.p2, self.p1, self.vfx, can_control)
            else:
                p2_dx, p2_dy, p2_btn, p2_forced = self.ai.compute_action(self.p2, self.p1, self.vfx, can_control)

            if self.mode != GameMode.TRAINING and can_control:
                self.replay.record(p1_dx, p1_dy, p1_btn, p2_dx, p2_dy, p2_btn)

        # Interpret & apply state transitions
        nxt1 = self.p1.interpret_inputs(p1_dx, p1_dy, p1_btn, self.p2, can_control)
        if nxt1 is not None:
            self.p1.enter_state(nxt1)
            self._trigger_super_if_needed(self.p1, nxt1)

        if p2_forced is not None and can_control:
            self.p2.input_buf.push(p2_dx, p2_dy, p2_btn, self.p2.facing_right)
            if self.p2.can_cancel_into(p2_forced):
                self.p2.enter_state(p2_forced)
                self._trigger_super_if_needed(self.p2, p2_forced)
        else:
            nxt2 = self.p2.interpret_inputs(p2_dx, p2_dy, p2_btn, self.p1, can_control)
            if nxt2 is not None:
                self.p2.enter_state(nxt2)
                self._trigger_super_if_needed(self.p2, nxt2)

        # Advance fighter physics, keyframes, afterimages & splash triggers
        for f, opp in ((self.p1, self.p2), (self.p2, self.p1)):
            f.step_physics_and_animation(opp, self.stage, self.audio)
            kf = f.current_keyframe()
            if kf.afterimage_tint > 0.15 and f.state_frame % 3 == 0:
                self.vfx.spawn_afterimage(f)
            if kf.water_splash > 0.65 and f.kf_hold == 1 and f.is_grounded:
                self.vfx.spawn_water_splash_burst(f.x, kf.water_splash)
            if kf.camera_impulse != (0.0, 0.0) and f.kf_hold == 1:
                self.cam.add_shake(math.hypot(*kf.camera_impulse) * 0.65, self.settings.screen_shake)

        # Resolve combat collisions, Clash, Parry, Guard Crush & Hits
        if self.phase == RoundPhase.FIGHT:
            self.resolver.resolve_combat_frame(self.p1, self.p2)

        # Eclipse Overdrive ambient dimming
        if self.super_freeze_frames <= 0:
            self.stage.target_eclipse_dim = 0.28 if (self.p1.is_eclipse or self.p2.is_eclipse) else 0.0

        # Training Lab auto-refill & trial drop reset
        if self.mode == GameMode.TRAINING:
            if self.p2.combo_count == 0 and not self.p2.is_hitstun:
                self.training_lab.trials.reset_on_drop()
                if self.tcfg.auto_refill_hp:
                    self.p1.hp = min(MAX_HP, self.p1.hp + 240)
                    self.p2.hp = min(MAX_HP, self.p2.hp + 240)
            if self.tcfg.auto_refill_curse:
                self.p1.curse = min(MAX_CURSE, self.p1.curse + 12)
            if self.tcfg.infinite_eclipse:
                self.p1.eclipse_timer = max(self.p1.eclipse_timer, 300)
        elif self.phase == RoundPhase.FIGHT:
            # Round Timer & KO Check
            if self.timer_frames > 0:
                self.timer_frames -= 1
            time_out = (self.timer_frames == 0)
            if self.p1.hp <= 0 or self.p2.hp <= 0 or time_out:
                self.phase = RoundPhase.KO_SLOWMO
                self.phase_timer = 58
                if self.p1.hp <= 0 and self.p2.hp <= 0:
                    self.banner_text = "DOUBLE K.O."
                    self.banner_sub = "MUTUAL ANNIHILATION"
                elif self.p2.hp <= 0 or (time_out and self.p1.hp >= self.p2.hp):
                    self.p1.rounds_won += 1
                    perf = (self.p1.hp == MAX_HP)
                    self.banner_text = "PERFECT K.O.!" if perf else ("TIME OVER" if time_out else "BLOODMOON K.O.!")
                    self.banner_sub = f"{self.p1.name} CLAIMS THE ROUND"
                else:
                    self.p2.rounds_won += 1
                    self.banner_text = "TIME OVER" if time_out else "DEFEATED..."
                    self.banner_sub = f"{self.p2.name} CLAIMS THE ROUND"
                self.banner_alpha = 0.2

        self.cam.update(self.p1.x, self.p2.x, self.p1.y, self.p2.y, FIXED_DT)

    def render(self, canvas: pygame.Surface) -> None:
        """Render complete 800x600 battle scene with live water reflections, fighters, VFX & HUD."""
        self.stage.render_background(canvas, self.cam.x, self.cam.y + self.cam.shake_y, self.cam.zoom)

        # Render both fighters' LIVE RIPPLED SWAMP WATER REFLECTIONS first!
        draw_order = [self.p1, self.p2]
        if self.p1.is_attacking and not self.p2.is_attacking:
            draw_order = [self.p2, self.p1]

        sprites_cache: List[Tuple[Fighter, pygame.Surface, float, float, int]] = []
        for f in draw_order:
            spr = self.bank.get_sprite(f.palette_key, f.state, f.kf_idx, f.facing_right, f.is_eclipse)
            sx, sy = self.cam.world_to_screen(f.x, f.y)
            ax = SPRITE_ANCHOR_X if f.facing_right else (SPRITE_W - SPRITE_ANCHOR_X)
            g_sx, g_sy = self.cam.world_to_screen(f.x, GROUND_Y)
            self.stage.render_fighter_water_reflection(
                canvas, spr, sx, g_sy, ax, SPRITE_ANCHOR_Y, elevation=max(0.0, GROUND_Y - f.y)
            )
            sprites_cache.append((f, spr, sx, sy, ax))

        # World VFX behind/around fighters (afterimages, Cataclysm pillars, projectiles, sparks, blood)
        self.vfx.render_world_vfx(canvas, self.cam)

        # Render fighters cleanly with crisp impact flash feedback
        for f, spr, sx, sy, ax in sprites_cache:
            draw_s = spr
            if f.flash_crimson_frames > 0:
                draw_s = spr.copy()
                draw_s.fill((255, 118, 138, 255), special_flags=pygame.BLEND_RGBA_MULT)
            canvas.blit(draw_s, (int(sx - ax), int(sy - SPRITE_ANCHOR_Y)))

        # Training Mode Hitbox / Hurtbox / Pushbox World Overlay
        if self.mode == GameMode.TRAINING:
            self.training_lab.render_world_boxes(canvas, self.p1, self.p2, self.cam)

        # Foreground drifting mist, blood embers & silhouette cattails
        self.stage.render_foreground(canvas, self.cam.x, self.cam.y + self.cam.shake_y)

        # Screen-space Super Cut-In Anime CG Banner, Flashes & Tactical Callouts
        self.vfx.render_screen_overlays(canvas, self.fonts)

        # AAA Gothic Battle HUD (mockup.jpg faithful!)
        t_sec = -1 if self.timer_frames < 0 else max(0, (self.timer_frames + TARGET_FPS - 1) // TARGET_FPS)
        stage_lbl = f"STAGE {self.arcade_stage_idx + 1}" if self.mode == GameMode.ARCADE else (f"STREAK {self.survival_streak}" if self.mode == GameMode.SURVIVAL else "CATHEDRAL")
        self.hud.render(
            canvas, self.p1, self.p2, t_sec,
            mode_label=self.mode.value.replace("_", " "),
            stage_label=stage_lbl,
            rounds_to_win=1 if self.mode == GameMode.SURVIVAL else self.settings.rounds_to_win,
            time_sec=self.stage.time_sec,
            beat_pulse=self.stage.beat_pulse,
            banner_text=self.banner_text,
            banner_sub=self.banner_sub,
            banner_alpha=self.banner_alpha,
        )

        # Training Mode Lab Diagnostic Panels
        if self.mode == GameMode.TRAINING:
            self.training_lab.render_hud_panels(canvas, self.p1, self.p2, FIXED_DT)


