# ==============================================================================
# SECTION 02: VECTOR MATH, BEZIER/CATMULL-ROM SPLINES, COLOR & PROCEDURAL NOISE
# ==============================================================================

def clamp(val: float, lo: float, hi: float) -> float:
    if val < lo:
        return lo
    if val > hi:
        return hi
    return val


def clamp_int(val: int, lo: int, hi: int) -> int:
    if val < lo:
        return lo
    if val > hi:
        return hi
    return val


def lerp(a: float, b: float, t: float) -> float:
    return a + (b - a) * t


def inv_lerp(a: float, b: float, v: float) -> float:
    span = b - a
    if abs(span) < 1e-8:
        return 0.0
    return clamp((v - a) / span, 0.0, 1.0)


def smoothstep(t: float) -> float:
    t = clamp(t, 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def smootherstep(t: float) -> float:
    t = clamp(t, 0.0, 1.0)
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)


def ease_out_cubic(t: float) -> float:
    u = 1.0 - clamp(t, 0.0, 1.0)
    return 1.0 - u * u * u


def ease_in_cubic(t: float) -> float:
    u = clamp(t, 0.0, 1.0)
    return u * u * u


def ease_in_out_cubic(t: float) -> float:
    u = clamp(t, 0.0, 1.0)
    if u < 0.5:
        return 4.0 * u * u * u
    p = -2.0 * u + 2.0
    return 1.0 - (p * p * p) * 0.5


def ease_out_back(t: float, overshoot: float = 1.70158) -> float:
    u = clamp(t, 0.0, 1.0) - 1.0
    return 1.0 + (overshoot + 1.0) * (u ** 3) + overshoot * (u ** 2)


def ease_out_expo(t: float) -> float:
    u = clamp(t, 0.0, 1.0)
    return 1.0 if u >= 1.0 else 1.0 - (2.0 ** (-10.0 * u))


def angle_lerp_deg(a: float, b: float, t: float) -> float:
    diff = ((b - a + 180.0) % 360.0) - 180.0
    return a + diff * t


# ------------------------------------------------------------------------------
# Color Space & Painterly Light-Blending Utilities
# ------------------------------------------------------------------------------

def lerp_rgb(c1: RGB, c2: RGB, t: float) -> RGB:
    t = clamp(t, 0.0, 1.0)
    return (
        int(c1[0] + (c2[0] - c1[0]) * t),
        int(c1[1] + (c2[1] - c1[1]) * t),
        int(c1[2] + (c2[2] - c1[2]) * t),
    )


def lerp_rgba(c1: RGBA, c2: RGBA, t: float) -> RGBA:
    t = clamp(t, 0.0, 1.0)
    return (
        int(c1[0] + (c2[0] - c1[0]) * t),
        int(c1[1] + (c2[1] - c1[1]) * t),
        int(c1[2] + (c2[2] - c1[2]) * t),
        int(c1[3] + (c2[3] - c1[3]) * t),
    )


def sample_gradient(stops: Sequence[Tuple[float, RGB]], t: float) -> RGB:
    if not stops:
        return (0, 0, 0)
    if t <= stops[0][0]:
        return stops[0][1]
    if t >= stops[-1][0]:
        return stops[-1][1]
    for i in range(len(stops) - 1):
        t0, c0 = stops[i]
        t1, c1 = stops[i + 1]
        if t0 <= t <= t1:
            u = (t - t0) / max(1e-6, t1 - t0)
            return lerp_rgb(c0, c1, u)
    return stops[-1][1]


def scale_rgb(c: RGB, factor: float) -> RGB:
    return (
        clamp_int(int(c[0] * factor), 0, 255),
        clamp_int(int(c[1] * factor), 0, 255),
        clamp_int(int(c[2] * factor), 0, 255),
    )


def add_rgb(c1: RGB, c2: RGB, weight: float = 1.0) -> RGB:
    return (
        clamp_int(int(c1[0] + c2[0] * weight), 0, 255),
        clamp_int(int(c1[1] + c2[1] * weight), 0, 255),
        clamp_int(int(c1[2] + c2[2] * weight), 0, 255),
    )


def multiply_rgb(c1: RGB, c2: RGB) -> RGB:
    return (
        (c1[0] * c2[0]) // 255,
        (c1[1] * c2[1]) // 255,
        (c1[2] * c2[2]) // 255,
    )


def screen_rgb(c1: RGB, c2: RGB) -> RGB:
    return (
        255 - ((255 - c1[0]) * (255 - c2[0])) // 255,
        255 - ((255 - c1[1]) * (255 - c2[1])) // 255,
        255 - ((255 - c1[2]) * (255 - c2[2])) // 255,
    )


def with_alpha(c: RGB, alpha: int) -> RGBA:
    return (c[0], c[1], c[2], clamp_int(alpha, 0, 255))


# ------------------------------------------------------------------------------
# 2D & 2.5D Vector Primitives
# ------------------------------------------------------------------------------

class Vec2:
    __slots__ = ("x", "y")

    def __init__(self, x: float = 0.0, y: float = 0.0) -> None:
        self.x = float(x)
        self.y = float(y)

    def __add__(self, other: Vec2) -> Vec2:
        return Vec2(self.x + other.x, self.y + other.y)

    def __sub__(self, other: Vec2) -> Vec2:
        return Vec2(self.x - other.x, self.y - other.y)

    def __mul__(self, scalar: float) -> Vec2:
        return Vec2(self.x * scalar, self.y * scalar)

    def __rmul__(self, scalar: float) -> Vec2:
        return Vec2(self.x * scalar, self.y * scalar)

    def __neg__(self) -> Vec2:
        return Vec2(-self.x, -self.y)

    def dot(self, other: Vec2) -> float:
        return self.x * other.x + self.y * other.y

    def cross(self, other: Vec2) -> float:
        return self.x * other.y - self.y * other.x

    def length_sq(self) -> float:
        return self.x * self.x + self.y * self.y

    def length(self) -> float:
        return math.hypot(self.x, self.y)

    def normalized(self) -> Vec2:
        ln = math.hypot(self.x, self.y)
        if ln < 1e-7:
            return Vec2(1.0, 0.0)
        return Vec2(self.x / ln, self.y / ln)

    def perp(self) -> Vec2:
        return Vec2(-self.y, self.x)

    def rotated_rad(self, rad: float) -> Vec2:
        c = math.cos(rad)
        s = math.sin(rad)
        return Vec2(self.x * c - self.y * s, self.x * s + self.y * c)

    def rotated_deg(self, deg: float) -> Vec2:
        return self.rotated_rad(math.radians(deg))

    def lerp(self, other: Vec2, t: float) -> Vec2:
        return Vec2(self.x + (other.x - self.x) * t, self.y + (other.y - self.y) * t)

    def to_int_tuple(self) -> Tuple[int, int]:
        return (int(round(self.x)), int(round(self.y)))

    def to_tuple(self) -> Tuple[float, float]:
        return (self.x, self.y)


class Vec3:
    __slots__ = ("x", "y", "z")

    def __init__(self, x: float = 0.0, y: float = 0.0, z: float = 0.0) -> None:
        self.x = float(x)
        self.y = float(y)
        self.z = float(z)

    def __add__(self, other: Vec3) -> Vec3:
        return Vec3(self.x + other.x, self.y + other.y, self.z + other.z)

    def __sub__(self, other: Vec3) -> Vec3:
        return Vec3(self.x - other.x, self.y - other.y, self.z - other.z)

    def __mul__(self, scalar: float) -> Vec3:
        return Vec3(self.x * scalar, self.y * scalar, self.z * scalar)

    def dot(self, other: Vec3) -> float:
        return self.x * other.x + self.y * other.y + self.z * other.z

    def length(self) -> float:
        return math.sqrt(self.x * self.x + self.y * self.y + self.z * self.z)

    def normalized(self) -> Vec3:
        ln = self.length()
        if ln < 1e-7:
            return Vec3(0.0, 0.0, 1.0)
        return Vec3(self.x / ln, self.y / ln, self.z / ln)

    def project_2d(
        self,
        origin_x: float,
        origin_y: float,
        focal: float = 540.0,
        scale: float = 1.0,
    ) -> Tuple[Vec2, float]:
        """Weak-perspective 2.5D projection providing expressive anime foreshortening."""
        depth = max(160.0, focal - self.z)
        persp = (focal / depth) * scale
        return (Vec2(origin_x + self.x * persp, origin_y + self.y * persp), persp)


# ------------------------------------------------------------------------------
# Exact Bezier, Catmull-Rom & Variable-Width Calligraphic Ribbon Geometry
# ------------------------------------------------------------------------------

def eval_quad_bezier(p0: Vec2, p1: Vec2, p2: Vec2, t: float) -> Vec2:
    u = 1.0 - t
    return Vec2(
        u * u * p0.x + 2.0 * u * t * p1.x + t * t * p2.x,
        u * u * p0.y + 2.0 * u * t * p1.y + t * t * p2.y,
    )


def eval_cubic_bezier(p0: Vec2, p1: Vec2, p2: Vec2, p3: Vec2, t: float) -> Vec2:
    u = 1.0 - t
    u2 = u * u
    u3 = u2 * u
    t2 = t * t
    t3 = t2 * t
    return Vec2(
        u3 * p0.x + 3.0 * u2 * t * p1.x + 3.0 * u * t2 * p2.x + t3 * p3.x,
        u3 * p0.y + 3.0 * u2 * t * p1.y + 3.0 * u * t2 * p2.y + t3 * p3.y,
    )


def sample_quad_bezier(p0: Vec2, p1: Vec2, p2: Vec2, steps: int = 12) -> List[Vec2]:
    steps = max(2, steps)
    return [eval_quad_bezier(p0, p1, p2, i / float(steps)) for i in range(steps + 1)]


def sample_cubic_bezier(
    p0: Vec2, p1: Vec2, p2: Vec2, p3: Vec2, steps: int = 16
) -> List[Vec2]:
    steps = max(2, steps)
    return [
        eval_cubic_bezier(p0, p1, p2, p3, i / float(steps)) for i in range(steps + 1)
    ]


def sample_catmull_rom(
    pts: Sequence[Vec2], steps_per_seg: int = 6, closed: bool = False
) -> List[Vec2]:
    """Smooth C1 Catmull-Rom spline through artistically sculpted contour points."""
    n = len(pts)
    if n < 2:
        return list(pts)
    if n == 2:
        return [pts[0].lerp(pts[1], i / float(steps_per_seg)) for i in range(steps_per_seg + 1)]
    out: List[Vec2] = []
    seg_count = n if closed else (n - 1)
    for i in range(seg_count):
        if closed:
            p0 = pts[(i - 1) % n]
            p1 = pts[i % n]
            p2 = pts[(i + 1) % n]
            p3 = pts[(i + 2) % n]
        else:
            p0 = pts[max(0, i - 1)]
            p1 = pts[i]
            p2 = pts[min(n - 1, i + 1)]
            p3 = pts[min(n - 1, i + 2)]
        for s in range(steps_per_seg):
            t = s / float(steps_per_seg)
            t2 = t * t
            t3 = t2 * t
            x = 0.5 * (
                (2.0 * p1.x)
                + (-p0.x + p2.x) * t
                + (2.0 * p0.x - 5.0 * p1.x + 4.0 * p2.x - p3.x) * t2
                + (-p0.x + 3.0 * p1.x - 3.0 * p2.x + p3.x) * t3
            )
            y = 0.5 * (
                (2.0 * p1.y)
                + (-p0.y + p2.y) * t
                + (2.0 * p0.y - 5.0 * p1.y + 4.0 * p2.y - p3.y) * t2
                + (-p0.y + 3.0 * p1.y - 3.0 * p2.y + p3.y) * t3
            )
            out.append(Vec2(x, y))
    if not closed:
        out.append(pts[-1])
    return out


def build_variable_ribbon(
    spine: Sequence[Vec2],
    widths: Sequence[float],
    bias: float = 0.0,
) -> List[Vec2]:
    """Convert a spine polyline + per-sample half-widths into a closed smooth ribbon polygon."""
    n = len(spine)
    if n < 2:
        return []
    left_pts: List[Vec2] = []
    right_pts: List[Vec2] = []
    w_len = len(widths)
    for i in range(n):
        if i == 0:
            tan = (spine[1] - spine[0]).normalized()
        elif i == n - 1:
            tan = (spine[-1] - spine[-2]).normalized()
        else:
            tan = (spine[i + 1] - spine[i - 1]).normalized()
        nrm = Vec2(-tan.y, tan.x)
        w = widths[min(i, w_len - 1)]
        w_l = w * (1.0 + bias)
        w_r = w * (1.0 - bias)
        left_pts.append(spine[i] + nrm * w_l)
        right_pts.append(spine[i] - nrm * w_r)
    right_pts.reverse()
    return left_pts + right_pts


def build_crescent_arc_poly(
    outer_pts: Sequence[Vec2],
    inner_pts: Sequence[Vec2],
) -> List[Vec2]:
    """Assemble a crisp tapered crescent blade-slash polygon from outer & inner Bezier curves."""
    if len(outer_pts) < 2 or len(inner_pts) < 2:
        return []
    rev_inner = list(inner_pts)
    rev_inner.reverse()
    return list(outer_pts) + rev_inner


def build_sculpted_limb_poly(
    p0: Vec2,
    p1: Vec2,
    r0: float,
    r1: float,
    mid_bulge_l: float = 0.0,
    mid_bulge_r: float = 0.0,
    mid_t: float = 0.45,
    cap_steps: int = 5,
) -> List[Vec2]:
    """Generate an anatomically contoured limb silhouette (never a flat rectangle or stick)."""
    diff = p1 - p0
    ln = diff.length()
    if ln < 1e-4:
        return [
            Vec2(p0.x + math.cos(a) * r0, p0.y + math.sin(a) * r0)
            for a in [k * math.tau / 10.0 for k in range(10)]
        ]
    fwd = Vec2(diff.x / ln, diff.y / ln)
    nrm = Vec2(-fwd.y, fwd.x)
    base_ang = math.atan2(fwd.y, fwd.x)

    mid_p = p0.lerp(p1, mid_t)
    r_mid = lerp(r0, r1, mid_t)

    # Left anatomical curve (e.g., calf gastrocnemius / bicep / thigh quad)
    l_start = p0 + nrm * r0
    l_ctrl = mid_p + nrm * (r_mid + mid_bulge_l)
    l_end = p1 + nrm * r1
    left_side = sample_quad_bezier(l_start, l_ctrl, l_end, steps=7)

    # End cap around p1
    end_cap: List[Vec2] = []
    for k in range(1, cap_steps):
        ang = base_ang + math.pi * 0.5 - math.pi * (k / float(cap_steps))
        end_cap.append(Vec2(p1.x + math.cos(ang) * r1, p1.y + math.sin(ang) * r1))

    # Right anatomical curve
    r_start = p1 - nrm * r1
    r_ctrl = mid_p - nrm * (r_mid + mid_bulge_r)
    r_end = p0 - nrm * r0
    right_side = sample_quad_bezier(r_start, r_ctrl, r_end, steps=7)

    # Start cap around p0
    start_cap: List[Vec2] = []
    for k in range(1, cap_steps):
        ang = base_ang - math.pi * 0.5 - math.pi * (k / float(cap_steps))
        start_cap.append(Vec2(p0.x + math.cos(ang) * r0, p0.y + math.sin(ang) * r0))

    return left_side + end_cap + right_side + start_cap


def poly_bounds(pts: Sequence[Vec2]) -> Tuple[int, int, int, int]:
    """Return integer (min_x, min_y, max_x, max_y) bounding box for fast local surface rasterizing."""
    if not pts:
        return (0, 0, 0, 0)
    xs = [p.x for p in pts]
    ys = [p.y for p in pts]
    return (
        int(math.floor(min(xs))),
        int(math.floor(min(ys))),
        int(math.ceil(max(xs))),
        int(math.ceil(max(ys))),
    )


def rect_intersects(
    a: Tuple[float, float, float, float],
    b: Tuple[float, float, float, float],
) -> bool:
    return (
        a[0] < b[0] + b[2]
        and a[0] + a[2] > b[0]
        and a[1] < b[1] + b[3]
        and a[1] + a[3] > b[1]
    )


def rect_overlap_center(
    a: Tuple[float, float, float, float],
    b: Tuple[float, float, float, float],
) -> Tuple[float, float]:
    x0 = max(a[0], b[0])
    y0 = max(a[1], b[1])
    x1 = min(a[0] + a[2], b[0] + b[2])
    y1 = min(a[1] + a[3], b[1] + b[3])
    return ((x0 + x1) * 0.5, (y0 + y1) * 0.5)


# ------------------------------------------------------------------------------
# Fast Deterministic Procedural Noise (Stonework, Storm Clouds, Water Ripples)
# ------------------------------------------------------------------------------

def hash_2d(ix: int, iy: int, seed: int = 1337) -> float:
    n = (ix * 374761393 + iy * 668265263 + seed * 1442695041) & 0xFFFFFFFF
    n = ((n ^ (n >> 13)) * 1274126177) & 0xFFFFFFFF
    n = n ^ (n >> 16)
    return (n & 0xFFFFFF) / 16777215.0


def value_noise_2d(x: float, y: float, seed: int = 1337) -> float:
    ix = int(math.floor(x))
    iy = int(math.floor(y))
    fx = x - ix
    fy = y - iy
    ux = fx * fx * (3.0 - 2.0 * fx)
    uy = fy * fy * (3.0 - 2.0 * fy)
    v00 = hash_2d(ix, iy, seed)
    v10 = hash_2d(ix + 1, iy, seed)
    v01 = hash_2d(ix, iy + 1, seed)
    v11 = hash_2d(ix + 1, iy + 1, seed)
    vx0 = v00 + (v10 - v00) * ux
    vx1 = v01 + (v11 - v01) * ux
    return vx0 + (vx1 - vx0) * uy


def fbm_2d(x: float, y: float, octaves: int = 4, seed: int = 1337) -> float:
    val = 0.0
    amp = 0.5
    freq = 1.0
    norm = 0.0
    for oc in range(octaves):
        val += value_noise_2d(x * freq, y * freq, seed + oc * 97) * amp
        norm += amp
        amp *= 0.5
        freq *= 2.03
    return val / max(1e-6, norm)


def ridged_fbm_2d(x: float, y: float, octaves: int = 4, seed: int = 4242) -> float:
    """Ridged multifractal noise ideal for apocalyptic blood-red storm clouds & cracks."""
    val = 0.0
    amp = 0.55
    freq = 1.0
    norm = 0.0
    for oc in range(octaves):
        n = 1.0 - abs(value_noise_2d(x * freq, y * freq, seed + oc * 131) * 2.0 - 1.0)
        val += (n * n) * amp
        norm += amp
        amp *= 0.5
        freq *= 2.12
    return val / max(1e-6, norm)


def worley_2d(x: float, y: float, seed: int = 9001) -> float:
    """Cellular Worley noise for cathedral stone masonry weathering & water caustics."""
    ix = int(math.floor(x))
    iy = int(math.floor(y))
    best = 9.0
    for dy in (-1, 0, 1):
        for dx in (-1, 0, 1):
            cx = ix + dx + hash_2d(ix + dx, iy + dy, seed)
            cy = iy + dy + hash_2d(ix + dx, iy + dy, seed + 511)
            d = (cx - x) * (cx - x) + (cy - y) * (cy - y)
            if d < best:
                best = d
    return clamp(math.sqrt(best), 0.0, 1.0)


# ==============================================================================
# SECTION 03: PAINTERLY CG VECTOR RASTERIZER, CALLIGRAPHY & GOTHIC FILIGREE ART
# ==============================================================================

INK_COLOR: RGB = (18, 10, 24)
INK_WARM: RGB = (32, 12, 26)
INK_RIM_BLOOD: RGB = (232, 48, 96)


class PainterlyRasterizer:
    """
    Studio-grade procedural CG vector-to-raster shading engine.

    Transforms hand-crafted Bezier and Catmull-Rom contours into richly shaded,
    3D-voluminous anime/CG forms with smooth directional gradients, clipped cel
    shadows, true edge-only blood-moon crimson rim lighting, premultiplied
    cinematic optical blooms, gothic lace ruffles, engraved demonic steel,
    and painterly crescent slash waves.
    """

    def __init__(self) -> None:
        self._radial_add_cache: Dict[Tuple[int, RGB, int], pygame.Surface] = {}
        self._radial_alpha_cache: Dict[Tuple[int, RGB, int], pygame.Surface] = {}
        self._dither_tile: Optional[pygame.Surface] = None
        self._build_painterly_grain_tile()

    def _build_painterly_grain_tile(self) -> None:
        """Create a subtle 32x32 painterly canvas/brush grain overlay surface."""
        tile = pygame.Surface((32, 32), pygame.SRCALPHA)
        for y in range(32):
            for x in range(32):
                n = hash_2d(x, y, 7717)
                if n > 0.65:
                    a = int((n - 0.65) * 26.0)
                    tile.set_at((x, y), (255, 224, 232, a))
                elif n < 0.32:
                    a = int((0.32 - n) * 32.0)
                    tile.set_at((x, y), (14, 6, 18, a))
        self._dither_tile = tile

    # --------------------------------------------------------------------------
    # True Premultiplied Optical Bloom & Soft Airbrush Radial Stamps
    # --------------------------------------------------------------------------

    def get_radial_glow_additive(
        self, radius: int, color: RGB, max_alpha: int = 160
    ) -> pygame.Surface:
        """
        Generate a true premultiplied-RGB black-backed optical glow surface for
        seamless BLEND_RGB_ADD compositing with zero hard circular artifacts.
        """
        r = max(4, min(220, int(radius)))
        q_col = (color[0] & 0xF8, color[1] & 0xF8, color[2] & 0xF8)
        q_a = max_alpha & 0xF8
        key = (r, q_col, q_a)
        cached = self._radial_add_cache.get(key)
        if cached is not None:
            return cached
        d = r * 2
        surf = pygame.Surface((d, d))
        surf.fill((0, 0, 0))
        strength = q_a / 255.0
        rings = max(14, min(36, r))
        # Paint concentric premultiplied rings from outer (black) inward (bright core)
        for i in range(rings, 0, -1):
            t = i / float(rings)  # 1.0 at edge -> near 0 at center
            rad = max(1, int(round(r * t)))
            falloff = ((1.0 - t) ** 2.35) * strength
            c = (
                clamp_int(int(q_col[0] * falloff), 0, 255),
                clamp_int(int(q_col[1] * falloff), 0, 255),
                clamp_int(int(q_col[2] * falloff), 0, 255),
            )
            pygame.draw.circle(surf, c, (r, r), rad)
        if len(self._radial_add_cache) > 420:
            self._radial_add_cache.clear()
        self._radial_add_cache[key] = surf
        return surf

    def get_radial_glow_alpha(
        self, radius: int, color: RGB, max_alpha: int = 120
    ) -> pygame.Surface:
        """Generate a soft SRCALPHA airbrush dab (ideal for cheek blush & soft shadow)."""
        r = max(3, min(160, int(radius)))
        q_col = (color[0] & 0xF8, color[1] & 0xF8, color[2] & 0xF8)
        q_a = max_alpha & 0xF8
        key = (r, q_col, q_a)
        cached = self._radial_alpha_cache.get(key)
        if cached is not None:
            return cached
        d = r * 2
        surf = pygame.Surface((d, d), pygame.SRCALPHA)
        rings = max(8, min(22, r))
        for i in range(rings, 0, -1):
            t = i / float(rings)
            rad = max(1, int(round(r * t)))
            # Incremental per-ring alpha so cumulative alpha forms a silky bell curve
            a = clamp_int(int(q_a * ((1.0 - t) ** 1.6) * (2.6 / float(rings))), 1, 255)
            pygame.draw.circle(surf, (q_col[0], q_col[1], q_col[2], a), (r, r), rad)
        if len(self._radial_alpha_cache) > 320:
            self._radial_alpha_cache.clear()
        self._radial_alpha_cache[key] = surf
        return surf

    def paint_radial_bloom(
        self,
        dest: pygame.Surface,
        cx: float,
        cy: float,
        radius: float,
        color: RGB,
        alpha: int = 140,
        additive: bool = True,
    ) -> None:
        r = max(4, int(radius))
        if additive:
            stamp = self.get_radial_glow_additive(r, color, alpha)
            dest.blit(stamp, (int(cx) - r, int(cy) - r), special_flags=pygame.BLEND_RGB_ADD)
        else:
            stamp = self.get_radial_glow_alpha(r, color, alpha)
            dest.blit(stamp, (int(cx) - r, int(cy) - r))

    # --------------------------------------------------------------------------
    # Core Painterly Directional-Gradient & Cel-Shaded Polygon Renderer
    # --------------------------------------------------------------------------

    def paint_shaded_poly(
        self,
        dest: pygame.Surface,
        pts: Sequence[Vec2],
        color_light: RGB,
        color_mid: RGB,
        color_shadow: RGB,
        light_dir: Tuple[float, float] = (0.55, -0.83),
        rim_color: Optional[RGB] = None,
        rim_strength: float = 0.0,
        spec_color: Optional[RGB] = None,
        spec_pos: Optional[Tuple[float, float]] = None,
        spec_radius: float = 0.0,
        outline_color: Optional[RGB] = INK_COLOR,
        outline_width: float = 1.5,
        cel_cut: float = 0.44,
        alpha: int = 255,
        painterly_grain: bool = False,
    ) -> None:
        """
        Render a closed hand-drawn vector contour with full multi-tone CG shading:
          1. Smooth directional base gradient across exact cropped polygon bounds
          2. Soft-crisp anime cel-shadow terminator clipped strictly inside alpha mask
          3. True edge-only blood-moon directional rim-light (strictly 1.5-2.5px rim!)
          4. Optional airbrush specular highlight glaze
          5. Crisp dark-plum anime ink contour
        """
        if len(pts) < 3:
            return
        min_x, min_y, max_x, max_y = poly_bounds(pts)
        pad = 3
        bx = min_x - pad
        by = min_y - pad
        bw = (max_x - min_x) + pad * 2 + 1
        bh = (max_y - min_y) + pad * 2 + 1
        if bw <= 2 or bh <= 2 or bw > 920 or bh > 920:
            return

        local_pts = [(p.x - bx, p.y - by) for p in pts]
        int_pts = [(int(round(x)), int(round(y))) for x, y in local_pts]

        # Step 1: Crisp silhouette alpha mask
        mask_surf = pygame.Surface((bw, bh), pygame.SRCALPHA)
        pygame.draw.polygon(mask_surf, (255, 255, 255, alpha), int_pts)

        # Step 2: Smooth directional CG shading + anime cel shadow terminator
        grad_surf = pygame.Surface((bw, bh), pygame.SRCALPHA)
        lx, ly = light_dir
        llen = math.hypot(lx, ly)
        if llen < 1e-5:
            lx, ly = 0.5, -0.86
        else:
            lx, ly = lx / llen, ly / llen

        corners = ((0.0, 0.0), (float(bw), 0.0), (0.0, float(bh)), (float(bw), float(bh)))
        projs = [cx * lx + cy * ly for cx, cy in corners]
        p_min = min(projs)
        p_span = max(1.0, max(projs) - p_min)

        steps = max(10, min(42, int(math.hypot(bw, bh) / 2.8)))
        perp_x, perp_y = -ly, lx
        diag = math.hypot(bw, bh) * 0.72
        band_thick = max(3, int(math.ceil(p_span / float(steps))) + 2)
        cx0 = bw * 0.5
        cy0 = bh * 0.5
        c_proj = cx0 * lx + cy0 * ly

        for s in range(steps + 1):
            u = s / float(steps)
            if u < cel_cut - 0.07:
                t_col = lerp_rgb(color_shadow, color_mid, clamp(u / max(0.05, cel_cut), 0.0, 0.48))
            elif u < cel_cut + 0.05:
                blend = smoothstep((u - (cel_cut - 0.07)) / 0.12)
                c_lo = lerp_rgb(color_shadow, color_mid, 0.45)
                t_col = lerp_rgb(c_lo, color_mid, blend)
            else:
                hi_u = clamp((u - cel_cut) / max(0.1, 1.0 - cel_cut), 0.0, 1.0)
                t_col = lerp_rgb(color_mid, color_light, hi_u ** 0.88)

            proj_val = p_min + u * p_span
            delta = proj_val - c_proj
            mx = cx0 + lx * delta
            my = cy0 + ly * delta
            p_a = (int(mx - perp_x * diag), int(my - perp_y * diag))
            p_b = (int(mx + perp_x * diag), int(my + perp_y * diag))
            pygame.draw.line(grad_surf, (t_col[0], t_col[1], t_col[2], 255), p_a, p_b, band_thick)

        if painterly_grain and self._dither_tile is not None:
            for gy in range(0, bh, 32):
                for gx in range(0, bw, 32):
                    grad_surf.blit(self._dither_tile, (gx, gy))

        # Soft airbrush specular highlight inside polygon
        if spec_color is not None and spec_pos is not None and spec_radius > 2.0:
            sx = spec_pos[0] - bx
            sy = spec_pos[1] - by
            self.paint_radial_bloom(grad_surf, sx, sy, spec_radius, spec_color, alpha=135, additive=True)

        # Step 3: TRUE edge-only blood-moon rim light (strictly along lit outer silhouette!)
        if rim_color is not None and rim_strength > 0.02:
            rim_a = clamp_int(int(175 * clamp(rim_strength, 0.0, 1.0)), 10, 215)
            rim_surf = pygame.Surface((bw, bh), pygame.SRCALPHA)
            pygame.draw.polygon(rim_surf, (rim_color[0], rim_color[1], rim_color[2], rim_a), int_pts)
            # Carve out interior shifted away from light source using BLEND_RGBA_SUB
            shift_x = -lx * 2.2
            shift_y = -ly * 2.2
            inner_pts = [(int(round(x + shift_x)), int(round(y + shift_y))) for x, y in local_pts]
            punch = pygame.Surface((bw, bh), pygame.SRCALPHA)
            pygame.draw.polygon(punch, (0, 0, 0, 255), inner_pts)
            rim_surf.blit(punch, (0, 0), special_flags=pygame.BLEND_RGBA_SUB)
            # Regular alpha-blend onto grad_surf so ONLY the thin lit rim glows!
            grad_surf.blit(rim_surf, (0, 0))

        # Step 4: Clip strictly to silhouette alpha mask & composite
        grad_surf.blit(mask_surf, (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
        dest.blit(grad_surf, (bx, by))

        # Step 5: Crisp dark-plum anime ink contour
        if outline_color is not None and outline_width >= 0.8:
            world_int = [(int(round(p.x)), int(round(p.y))) for p in pts]
            w_int = max(1, int(round(outline_width)))
            pygame.draw.polygon(dest, outline_color, world_int, w_int)
            if w_int == 1:
                pygame.draw.aalines(dest, outline_color, True, world_int)

    def paint_soft_shadow_poly(
        self,
        dest: pygame.Surface,
        pts: Sequence[Vec2],
        color: RGB,
        alpha: int = 110,
    ) -> None:
        """Stamp an interior fold shadow or translucent veil polygon."""
        if len(pts) < 3:
            return
        min_x, min_y, max_x, max_y = poly_bounds(pts)
        bw = (max_x - min_x) + 4
        bh = (max_y - min_y) + 4
        if bw <= 2 or bh <= 2 or bw > 900 or bh > 900:
            return
        surf = pygame.Surface((bw, bh), pygame.SRCALPHA)
        local = [(int(round(p.x - min_x + 2)), int(round(p.y - min_y + 2))) for p in pts]
        pygame.draw.polygon(surf, (color[0], color[1], color[2], clamp_int(alpha, 0, 255)), local)
        dest.blit(surf, (min_x - 2, min_y - 2))

    # --------------------------------------------------------------------------
    # Painterly Anime Hair Lock & Ponytail Ribbon Renderer (Sharp Tapered Tips!)
    # --------------------------------------------------------------------------

    def paint_hair_ribbon(
        self,
        dest: pygame.Surface,
        spine: Sequence[Vec2],
        widths: Sequence[float],
        pal: CeciliaPalette,
        sheen_u: float = 0.34,
        rim_side: float = 1.0,
        outline_w: float = 1.3,
    ) -> None:
        """
        Render a sweeping hand-drawn anime hair lock tapering smoothly to a sharp
        tip, with obsidian/indigo volume, curved violet-blue CG specular halo
        sheen, silky internal hair streaks, and crisp blood-moon edge rim.
        """
        n = len(spine)
        if n < 3:
            return
        # Ensure tip tapers cleanly to razor 0.0 anime hair point!
        w_clean = list(widths[:n])
        while len(w_clean) < n:
            w_clean.append(w_clean[-1] * 0.5)
        w_clean[-1] = 0.0
        if n >= 4:
            w_clean[-2] = min(w_clean[-2], max(0.6, w_clean[-3] * 0.42))

        poly = build_variable_ribbon(spine, w_clean)
        if len(poly) < 4:
            return
        self.paint_shaded_poly(
            dest,
            poly,
            color_light=pal.hair_mid,
            color_mid=pal.hair_base,
            color_shadow=pal.hair_dark,
            light_dir=(0.65 * rim_side, -0.76),
            rim_color=pal.hair_rim,
            rim_strength=0.45,
            outline_color=INK_COLOR,
            outline_width=outline_w,
            cel_cut=0.54,
        )

        # Fine silky internal hair strand grooves
        if n >= 5:
            for frac, col in ((0.34, pal.hair_dark), (-0.24, pal.hair_mid)):
                strand_pts: List[Tuple[int, int]] = []
                for i in range(1, n - 1):
                    tan = (spine[min(n - 1, i + 1)] - spine[max(0, i - 1)]).normalized()
                    nrm = Vec2(-tan.y, tan.x)
                    w = w_clean[i]
                    if w > 0.6:
                        strand_pts.append((spine[i] + nrm * (w * frac)).to_int_tuple())
                if len(strand_pts) >= 2:
                    pygame.draw.aalines(dest, col, False, strand_pts)

            # Curved anime 'angel-ring' violet-blue hair sheen band
            idx = clamp_int(int(sheen_u * (n - 1)), 1, n - 3)
            p_prev = spine[max(0, idx - 1)]
            p_curr = spine[idx]
            p_next = spine[min(n - 1, idx + 1)]
            tan = (p_next - p_prev).normalized()
            nrm = Vec2(-tan.y, tan.x)
            w = w_clean[idx]
            if w >= 2.2:
                sheen_poly = [
                    p_curr - nrm * (w * 0.68) - tan * (w * 0.20),
                    p_curr - nrm * (w * 0.14) + tan * (w * 0.34),
                    p_curr + nrm * (w * 0.68) - tan * (w * 0.12),
                    p_curr + nrm * (w * 0.48) - tan * (w * 0.56),
                    p_curr - nrm * (w * 0.14) - tan * (w * 0.18),
                    p_curr - nrm * (w * 0.58) - tan * (w * 0.64),
                ]
                self.paint_soft_shadow_poly(dest, sheen_poly, pal.hair_sheen, alpha=145)

    # --------------------------------------------------------------------------
    # Gothic Lolita Ruffled Lace Scallop Generator
    # --------------------------------------------------------------------------

    def paint_lace_ruffle_strip(
        self,
        dest: pygame.Surface,
        top_curve: Sequence[Vec2],
        bottom_curve: Sequence[Vec2],
        color_deep: RGB,
        color_base: RGB,
        color_bright: RGB,
        trim_color: RGB,
        pleats: int = 8,
        scallop_amp: float = 3.5,
    ) -> None:
        """Render a multi-pleat 3D Gothic Lolita lace ruffle tier with scalloped hem."""
        n = min(len(top_curve), len(bottom_curve))
        if n < 2:
            return
        samples = max(14, pleats * 4)
        top_s: List[Vec2] = []
        bot_s: List[Vec2] = []
        for i in range(samples + 1):
            u = i / float(samples)
            f_idx = u * (n - 1)
            i0 = int(f_idx)
            i1 = min(n - 1, i0 + 1)
            frac = f_idx - i0
            tp = top_curve[i0].lerp(top_curve[i1], frac)
            bp = bottom_curve[i0].lerp(bottom_curve[i1], frac)
            wave = math.sin(u * pleats * math.pi)
            dir_v = (bp - tp).normalized()
            bp_sc = bp + dir_v * (abs(wave) * scallop_amp)
            top_s.append(tp)
            bot_s.append(bp_sc)

        full_poly = top_s + list(reversed(bot_s))
        self.paint_shaded_poly(
            dest,
            full_poly,
            color_light=color_bright,
            color_mid=color_base,
            color_shadow=color_deep,
            light_dir=(0.45, -0.89),
            rim_color=trim_color,
            rim_strength=0.22,
            outline_color=INK_COLOR,
            outline_width=1.4,
            cel_cut=0.44,
        )

        seg_step = max(1, samples // max(2, pleats))
        for p_idx in range(pleats):
            s0 = min(samples - 1, p_idx * seg_step)
            s1 = min(samples, s0 + max(1, seg_step // 2))
            s2 = min(samples, s0 + seg_step)
            if s1 > s0:
                self.paint_soft_shadow_poly(dest, [top_s[s0], top_s[s1], bot_s[s1], bot_s[s0]], color_deep, alpha=145)
            if s2 > s1:
                self.paint_soft_shadow_poly(dest, [top_s[s1], top_s[s2], bot_s[s2], bot_s[s1]], color_bright, alpha=85)
            pygame.draw.aaline(dest, INK_COLOR, top_s[s0].to_int_tuple(), bot_s[s0].to_int_tuple())

        trim_pts = [p.to_int_tuple() for p in bot_s]
        if len(trim_pts) >= 2:
            pygame.draw.lines(dest, trim_color, False, trim_pts, 2)
            pygame.draw.aalines(dest, INK_COLOR, False, trim_pts)

    # --------------------------------------------------------------------------
    # Leather Boot Strap & Silver Buckle Renderer
    # --------------------------------------------------------------------------

    def paint_leather_buckle_strap(
        self,
        dest: pygame.Surface,
        p_left: Vec2,
        p_right: Vec2,
        strap_h: float,
        pal: CeciliaPalette,
        buckle_u: float = 0.72,
    ) -> None:
        vec = p_right - p_left
        ln = vec.length()
        if ln < 4.0:
            return
        fwd = vec * (1.0 / ln)
        nrm = Vec2(-fwd.y, fwd.x)
        hh = strap_h * 0.5
        poly = [p_left - nrm * hh, p_right - nrm * hh, p_right + nrm * hh, p_left + nrm * hh]
        self.paint_shaded_poly(
            dest,
            poly,
            color_light=pal.leather_spec,
            color_mid=pal.leather_base,
            color_shadow=pal.leather_deep,
            light_dir=(0.3, -0.95),
            outline_color=INK_COLOR,
            outline_width=1.0,
            cel_cut=0.55,
        )
        bc = p_left.lerp(p_right, clamp(buckle_u, 0.15, 0.85))
        bw = max(3.0, strap_h * 1.15)
        bh = strap_h * 0.72
        b_poly = [
            bc - fwd * bw * 0.5 - nrm * bh,
            bc + fwd * bw * 0.5 - nrm * bh,
            bc + fwd * bw * 0.5 + nrm * bh,
            bc - fwd * bw * 0.5 + nrm * bh,
        ]
        b_int = [p.to_int_tuple() for p in b_poly]
        pygame.draw.polygon(dest, pal.silver_dark, b_int)
        pygame.draw.polygon(dest, pal.silver_bright, b_int, 2)
        pygame.draw.polygon(dest, INK_COLOR, b_int, 1)
        pygame.draw.line(
            dest,
            pal.silver_bright,
            (bc - fwd * bw * 0.42).to_int_tuple(),
            (bc + fwd * bw * 0.16).to_int_tuple(),
            1,
        )

    # --------------------------------------------------------------------------
    # Demonic Two-Handed Greatsword ("呪いの刃") Multi-Angle Painter
    # --------------------------------------------------------------------------

    def paint_cursed_greatsword(
        self,
        dest: pygame.Surface,
        hilt_pos: Vec2,
        tip_pos: Vec2,
        view: SwordView,
        pal: CeciliaPalette,
        aura_intensity: float = 1.0,
        eclipse_mode: bool = False,
        frame_seed: int = 0,
    ) -> None:
        if view == SwordView.HIDDEN:
            return
        axis = tip_pos - hilt_pos
        blade_len = axis.length()
        if blade_len < 12.0:
            return
        fwd = axis * (1.0 / blade_len)
        nrm = Vec2(-fwd.y, fwd.x)

        if view == SwordView.BROADSIDE:
            half_w = clamp(blade_len * 0.082, 7.0, 13.5)
            guard_span = half_w * 2.50
            show_runes = True
        elif view == SwordView.OBLIQUE:
            half_w = clamp(blade_len * 0.058, 5.2, 9.8)
            guard_span = half_w * 2.40
            show_runes = True
        elif view == SwordView.RAZOR_EDGE:
            half_w = clamp(blade_len * 0.025, 2.5, 4.4)
            guard_span = half_w * 3.0
            show_runes = False
        elif view == SwordView.THRUST_FORESHORTEN:
            half_w = clamp(blade_len * 0.098, 8.0, 15.5)
            guard_span = half_w * 2.10
            show_runes = True
        else:
            half_w = clamp(blade_len * 0.068, 6.0, 11.5)
            guard_span = half_w * 2.30
            show_runes = True

        grip_len = clamp(blade_len * 0.23, 22.0, 36.0)
        pommel_pos = hilt_pos - fwd * grip_len
        guard_pos = hilt_pos + fwd * 4.0

        # 1. Silky premultiplied optical cursed aura & curling flame wisps
        if aura_intensity > 0.05:
            aura_col = pal.aura_inner if not eclipse_mode else (255, 214, 76)
            flame_steps = 8
            for fi in range(flame_steps):
                u = 0.14 + (fi / float(flame_steps)) * 0.80
                bp = guard_pos.lerp(tip_pos, u)
                rad = (half_w * 2.4 + 10.0) * (1.12 - u * 0.30) * clamp(aura_intensity, 0.4, 1.6)
                self.paint_radial_bloom(
                    dest, bp.x, bp.y, rad, pal.aura_outer,
                    alpha=int(135 * clamp(aura_intensity, 0.2, 1.4)), additive=True,
                )
                side = 1.0 if (fi % 2 == 0) else -1.0
                ph = frame_seed * 0.37 + fi * 1.67
                wisp_start = bp + nrm * (side * half_w * 0.85)
                wisp_mid = bp + nrm * (side * (half_w + 5.0 + math.sin(ph) * 3.5)) + fwd * 8.0
                wisp_tip = wisp_mid + nrm * (side * (3.0 + math.cos(ph) * 2.5)) + fwd * (14.0 + math.sin(ph * 1.3) * 5.0)
                w_curve = sample_quad_bezier(wisp_start, wisp_mid, wisp_tip, steps=7)
                w_rib = build_variable_ribbon(w_curve, [2.4, 2.0, 1.5, 1.1, 0.7, 0.35, 0.15, 0.0])
                if len(w_rib) >= 4:
                    self.paint_soft_shadow_poly(dest, w_rib, aura_col, alpha=int(96 * clamp(aura_intensity, 0.3, 1.3)))

        # 2. Leather-wrapped two-handed grip & crimson-jeweled pommel
        grip_poly = [
            pommel_pos - nrm * 3.0,
            guard_pos - nrm * 3.2,
            guard_pos + nrm * 3.2,
            pommel_pos + nrm * 3.0,
        ]
        self.paint_shaded_poly(
            dest, grip_poly, pal.leather_spec, pal.leather_base, pal.leather_deep,
            outline_color=INK_COLOR, outline_width=1.2,
        )
        for wi in range(1, 6):
            gp = pommel_pos.lerp(guard_pos, wi / 6.0)
            pygame.draw.line(
                dest, pal.silver_dark,
                (gp - nrm * 2.8 - fwd * 1.2).to_int_tuple(),
                (gp + nrm * 2.8 + fwd * 1.2).to_int_tuple(), 1,
            )
        pom_poly = [
            pommel_pos - fwd * 8.0,
            pommel_pos - nrm * 4.8 - fwd * 1.5,
            pommel_pos + fwd * 2.8,
            pommel_pos + nrm * 4.8 - fwd * 1.5,
        ]
        self.paint_shaded_poly(
            dest, pom_poly, pal.rune_glow, pal.blade_guard, pal.blade_obsidian,
            outline_color=INK_COLOR, outline_width=1.2,
        )

        # 3. Sculpted demonic greatsword blade with gothic serrated contours
        p_base = guard_pos + fwd * 4.0
        p_notch1 = guard_pos.lerp(tip_pos, 0.18)
        p_mid = guard_pos.lerp(tip_pos, 0.56)
        p_taper = guard_pos.lerp(tip_pos, 0.84)

        w_base = half_w * 1.18
        w_notch = half_w * 0.88
        w_mid = half_w * 1.00
        w_taper = half_w * 0.70

        blade_outline = [
            p_base - nrm * w_base,
            p_notch1 - nrm * w_notch,
            p_mid - nrm * w_mid,
            p_taper - nrm * w_taper,
            tip_pos,
            p_taper + nrm * w_taper,
            p_mid + nrm * w_mid,
            p_notch1 + nrm * w_notch,
            p_base + nrm * w_base,
        ]
        self.paint_shaded_poly(
            dest,
            blade_outline,
            color_light=pal.blade_steel_edge,
            color_mid=pal.blade_steel_mid,
            color_shadow=pal.blade_obsidian,
            light_dir=(nrm.x * 0.75 + 0.25, nrm.y * 0.75 - 0.35),
            rim_color=pal.rune_glow,
            rim_strength=0.65 if not eclipse_mode else 0.95,
            outline_color=INK_COLOR,
            outline_width=1.5,
            cel_cut=0.50,
        )

        # Inner obsidian fuller channel
        fuller_w = half_w * 0.46
        fuller_end = guard_pos.lerp(tip_pos, 0.78)
        fuller_poly = [
            p_base + fwd * 4.0 - nrm * fuller_w,
            fuller_end - nrm * (fuller_w * 0.45),
            guard_pos.lerp(tip_pos, 0.86),
            fuller_end + nrm * (fuller_w * 0.45),
            p_base + fwd * 4.0 + nrm * fuller_w,
        ]
        self.paint_shaded_poly(
            dest, fuller_poly, pal.blade_guard, pal.blade_obsidian, (10, 4, 14),
            outline_color=pal.blade_steel_mid, outline_width=1.0,
        )

        # Razor metallic highlight bevel
        pygame.draw.aaline(
            dest, pal.blade_steel_edge,
            (p_base - nrm * (w_base * 0.88)).to_int_tuple(),
            (p_taper - nrm * (w_taper * 0.88)).to_int_tuple(),
        )
        pygame.draw.aaline(
            dest, pal.blade_steel_edge,
            (p_taper - nrm * (w_taper * 0.88)).to_int_tuple(),
            tip_pos.to_int_tuple(),
        )

        # 4. Glowing crimson-white eldritch runes along the central fuller
        if show_runes and blade_len >= 52.0:
            rune_count = clamp_int(int(blade_len / 14.0), 4, 9)
            r_glow = pal.rune_glow if not eclipse_mode else (255, 224, 96)
            for ri in range(rune_count):
                u = 0.14 + (ri / float(rune_count)) * 0.64
                rp = guard_pos.lerp(tip_pos, u)
                rw = max(1.5, fuller_w * 0.56)
                g_a = (rp - fwd * 2.5 - nrm * rw * 0.7).to_int_tuple()
                g_b = (rp + fwd * 2.5 + nrm * rw * 0.7).to_int_tuple()
                g_c = (rp - fwd * 0.8 + nrm * rw * 0.85).to_int_tuple()
                g_d = (rp + fwd * 1.4 - nrm * rw * 0.85).to_int_tuple()
                pygame.draw.line(dest, r_glow, g_a, g_b, 2)
                if ri % 2 == 0:
                    pygame.draw.line(dest, r_glow, g_c, g_d, 2)
                else:
                    pygame.draw.line(dest, r_glow, g_a, g_c, 2)
                pygame.draw.circle(dest, pal.rune_core, rp.to_int_tuple(), 1)

        # 5. Sculpted ornate Gothic Bat-Wing Crossguard with Faceted Ruby Core
        g_left_tip = guard_pos - nrm * guard_span + fwd * (half_w * 0.85)
        g_left_hook = guard_pos - nrm * (guard_span * 0.72) - fwd * (half_w * 0.45)
        g_right_tip = guard_pos + nrm * guard_span + fwd * (half_w * 0.85)
        g_right_hook = guard_pos + nrm * (guard_span * 0.72) - fwd * (half_w * 0.45)
        guard_poly = [
            guard_pos - fwd * 5.0,
            g_left_hook,
            g_left_tip,
            guard_pos - nrm * (half_w * 1.18) + fwd * (half_w * 1.05),
            guard_pos + fwd * (half_w * 1.42),
            guard_pos + nrm * (half_w * 1.18) + fwd * (half_w * 1.05),
            g_right_tip,
            g_right_hook,
        ]
        self.paint_shaded_poly(
            dest, guard_poly, pal.blade_steel_edge, pal.blade_guard, pal.blade_obsidian,
            rim_color=pal.rune_glow, rim_strength=0.60, outline_color=INK_COLOR, outline_width=1.4,
        )
        gem_c = guard_pos + fwd * 4.5
        gem_r = max(3.2, half_w * 0.54)
        gem_poly = [
            gem_c + fwd * (gem_r * 1.45),
            gem_c + nrm * (gem_r * 0.85),
            gem_c - fwd * (gem_r * 1.1),
            gem_c - nrm * (gem_r * 0.85),
        ]
        self.paint_shaded_poly(
            dest, gem_poly, pal.rune_core, pal.rune_glow, pal.aura_outer,
            outline_color=INK_COLOR, outline_width=1.0,
        )
        self.paint_radial_bloom(dest, gem_c.x, gem_c.y, gem_r * 3.2, pal.rune_glow, alpha=145, additive=True)

    # --------------------------------------------------------------------------
    # Painterly KoF XIII / Mockup-Style Crescent Sword Slash Arc Renderer
    # --------------------------------------------------------------------------

    def paint_painterly_slash_wave(
        self,
        dest: pygame.Surface,
        outer_ctrl: Sequence[Vec2],
        inner_ctrl: Sequence[Vec2],
        pal: CeciliaPalette,
        intensity: float = 1.0,
        eclipse_mode: bool = False,
        seed: int = 0,
    ) -> None:
        if len(outer_ctrl) < 3 or len(inner_ctrl) < 3:
            return
        outer_pts = sample_catmull_rom(outer_ctrl, steps_per_seg=8)
        inner_pts = sample_catmull_rom(inner_ctrl, steps_per_seg=8)
        n = min(len(outer_pts), len(inner_pts))
        if n < 4:
            return

        c_core = pal.slash_core
        c_mid = pal.slash_mid if not eclipse_mode else (255, 210, 72)
        c_edge = pal.slash_edge if not eclipse_mode else (255, 42, 118)
        c_dark = pal.slash_dark

        # Layer 1: Dark cursed ink-smoke wake
        wake_inner = [inner_pts[i] + (inner_pts[i] - outer_pts[i]) * 0.30 for i in range(n)]
        self.paint_soft_shadow_poly(
            dest, build_crescent_arc_poly(outer_pts, wake_inner), c_dark,
            alpha=int(145 * clamp(intensity, 0.3, 1.3)),
        )

        # Layer 2: Silky optical bloom aura along the plasma sweep
        for i in range(0, n, max(2, n // 8)):
            p = outer_pts[i].lerp(inner_pts[i], 0.28)
            rad = (outer_pts[i] - inner_pts[i]).length() * 1.15 + 18.0
            self.paint_radial_bloom(dest, p.x, p.y, rad, c_edge, alpha=int(135 * intensity), additive=True)

        # Layer 3: Multi-band gradient plasma crescent sweep
        band_specs = (
            (0.00, 1.00, c_edge, int(190 * clamp(intensity, 0.3, 1.2))),
            (0.00, 0.66, c_mid, int(220 * clamp(intensity, 0.3, 1.1))),
            (0.00, 0.32, lerp_rgb(c_mid, c_core, 0.58), int(235 * clamp(intensity, 0.3, 1.1))),
            (0.00, 0.13, c_core, int(250 * clamp(intensity, 0.4, 1.05))),
        )
        for u0, u1, col, al in band_specs:
            b_out = [outer_pts[i].lerp(inner_pts[i], u0) for i in range(n)]
            b_in = [outer_pts[i].lerp(inner_pts[i], u1) for i in range(n)]
            self.paint_soft_shadow_poly(dest, build_crescent_arc_poly(b_out, b_in), col, alpha=clamp_int(al, 0, 255))

        # Layer 4: Razor incandescent leading edge
        lead_int = [p.to_int_tuple() for p in outer_pts]
        pygame.draw.lines(dest, c_core, False, lead_int, 3)
        pygame.draw.aalines(dest, (255, 255, 255), False, lead_int)

        # Layer 5: Cursed energy filaments & sparkling streaks
        for i in range(2, n - 2, max(2, n // 7)):
            u = i / float(max(1, n - 1))
            p0 = outer_pts[i].lerp(inner_pts[i], 0.16 + 0.24 * hash_2d(i, seed, 313))
            tang = (outer_pts[min(n - 1, i + 1)] - outer_pts[max(0, i - 1)]).normalized()
            inward = (inner_pts[i] - outer_pts[i]).normalized()
            tail = p0 - tang * (16.0 + 18.0 * u) + inward * (8.0 + 10.0 * hash_2d(seed, i, 719))
            pygame.draw.aaline(dest, c_core, p0.to_int_tuple(), tail.to_int_tuple())
            pygame.draw.circle(dest, c_core, p0.to_int_tuple(), 2)


