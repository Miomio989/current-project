    def _bake_volumetric_blood_sky(self) -> None:
        """
        Domain-warped ridged fBM apocalyptic blood-red storm cloudscape (stage.jpg
        & graphics-mockup.jpg) rasterized at 260x114 and smoothscaled cleanly!
        """
        bw, bh = 260, 114
        buf = bytearray(bw * bh * 4)
        idx = 0
        # Glowing storm center slightly right-of-center behind distant cathedral!
        sun_x, sun_y = 0.56, 0.44
        for y in range(bh):
            v = y / float(bh - 1)
            # Horizon glow ramps warmer toward lower sky
            horiz = clamp(1.0 - abs(v - 0.62) * 1.55, 0.0, 1.0)
            for x in range(bw):
                u = x / float(bw - 1)
                # Domain warp for swirling gothic storm clouds
                wx = fbm2(u * 4.2, v * 2.8, octaves=3, seed=701)
                wy = fbm2(u * 4.2 + 5.3, v * 2.8 + 1.9, octaves=3, seed=733)
                cloud_r = ridged_fbm2(u * 5.2 + wx * 1.15, v * 3.8 + wy * 0.85, octaves=4, seed=777)
                cloud_b = fbm2(u * 3.1 - wx * 0.65, v * 2.6 + wy * 0.55, octaves=3, seed=811)

                # Radial volcanic crimson glow around eclipsed zenith
                dx = (u - sun_x) * 1.45
                dy = (v - sun_y)
                dist = math.sqrt(dx * dx + dy * dy)
                sky_rad = math.exp(-dist * dist * 2.4)

                # Blend dark storm bellies with fiery backlit blood-orange cloud edges!
                lit = clamp(cloud_r * 0.64 + sky_rad * 0.55 + horiz * 0.28 - (1.0 - v) * 0.16, 0.0, 1.0)
                storm_mask = smoothstep(clamp((cloud_b - 0.34) * 2.1, 0.0, 1.0))

                # Apocalyptic color ramp matching graphics-mockup.jpg!
                sky_col = sample_ramp(
                    (
                        (0.00, (14, 4, 10)),
                        (0.24, (58, 8, 16)),
                        (0.48, (146, 14, 20)),
                        (0.72, (226, 36, 22)),
                        (0.90, (255, 106, 42)),
                        (1.00, (255, 194, 118)),
                    ),
                    lit,
                )
                # Dark bruised charcoal-crimson cloud undersides
                belly = sample_ramp(((0.0, (24, 6, 14)), (0.6, (72, 12, 20)), (1.0, (132, 22, 24))), lit)
                r = int(lerp(sky_col[0], belly[0], storm_mask * 0.54))
                g = int(lerp(sky_col[1], belly[1], storm_mask * 0.58))
                b = int(lerp(sky_col[2], belly[2], storm_mask * 0.45))

                # Subtle diagonal crimson storm light shafts
                shaft = math.sin((u * 9.5 + v * 3.2) * math.pi) * 0.5 + 0.5
                shaft = (shaft ** 5) * sky_rad * 0.24
                r = clamp_int(r + int(255 * shaft), 0, 255)
                g = clamp_int(g + int(78 * shaft), 0, 255)
                b = clamp_int(b + int(42 * shaft), 0, 255)

                buf[idx] = r
                buf[idx + 1] = g
                buf[idx + 2] = b
                buf[idx + 3] = 255
                idx += 4

        small = pygame.image.frombuffer(bytes(buf), (bw, bh), "RGBA").convert()
        self.sky_surf = pygame.transform.smoothscale(small, (1040, 456))

        # Veiled Luminous Blood Moon glowing subtly through high crimson clouds!
        mx, my = 636, 134
        self.cg.blit_glow(self.sky_surf, (mx, my), 148, (242, 34, 28), 110, additive=True)
        self.cg.blit_glow(self.sky_surf, (mx, my), 84, (255, 118, 66), 95, additive=True)
        # Soft lunar disc with subtle crater fBM mottling
        moon_r = 46
        msurf = pygame.Surface((moon_r * 2 + 4, moon_r * 2 + 4), pygame.SRCALPHA)
        for py in range(moon_r * 2 + 4):
            for px in range(moon_r * 2 + 4):
                dd = math.hypot(px - moon_r - 2, py - moon_r - 2) / float(moon_r)
                if dd < 1.0:
                    cr = fbm2(px * 0.09, py * 0.09, 3, seed=911)
                    edge_a = int(205 * smoothstep(clamp((1.0 - dd) * 5.0, 0.0, 1.0)))
                    mc = lerp_rgb((204, 34, 38), (255, 178, 134), clamp(0.32 + cr * 0.65 - dd * 0.25, 0.0, 1.0))
                    msurf.set_at((px, py), (mc[0], mc[1], mc[2], edge_a))
        self.sky_surf.blit(msurf, (mx - moon_r - 2, my - moon_r - 2))

        # Drifting painterly storm cloud wisps partly veiling the Blood Moon
        for cy, cw, ch, col, a in (
            (142, 230, 32, (62, 10, 18), 145),
            (116, 190, 24, (92, 14, 22), 115),
            (166, 280, 36, (44, 8, 16), 135),
        ):
            self.cg.draw_soft_ellipse_airbrush(self.sky_surf, mx + 24, cy, cw, ch, col, a, additive=False)

