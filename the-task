    ) -> pygame.Surface:
        """Render a single CelKeyframePlate at 2x supersampling -> crisp sprite."""
        s = float(self._ss)
        sw = SPRITE_W * self._ss
        sh = SPRITE_H * self._ss
        canvas = pygame.Surface((sw, sh), pygame.SRCALPHA)
        ox = float(SPRITE_ANCHOR_X) * s
        oy = float(SPRITE_ANCHOR_Y) * s

        def pt(xy: Pt2) -> Vec2:
            return Vec2(ox + xy[0] * s, oy + xy[1] * s)

        pelvis = pt(kf.pelvis_xy)
        waist = pt(kf.waist_xy)
        chest = pt(kf.chest_xy)
        neck = pt(kf.neck_xy)
        head = pt(kf.head_xy)

        f_sh = pt(kf.far_shoulder)
