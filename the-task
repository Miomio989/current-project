    app.gallery.playing = False
    app.render_canvas()
    if dump_dir:
        pygame.image.save(app.canvas, os.path.join(dump_dir, "08_keyframe_gallery.png"))

    # 6. Verify 60 FPS Render Benchmark on cached battle frames
    app.screen = ScreenState.BATTLE
    t_fps0 = time.perf_counter()
    for _ in range(120):
        app.render_canvas()
    t_fps = time.perf_counter() - t_fps0
    render_fps = 120.0 / max(1e-4, t_fps)

    total_bars = sum(len(c.bars) for c in app.audio.scores.values())
    print(
        f"[QA PASS] {GAME_TITLE_JP} v{GAME_VERSION} | "
        f"Bake: {t_bake:.2f}s | 480f Sim: {t_sim:.2f}s | Render FPS: {render_fps:.1f} | "
