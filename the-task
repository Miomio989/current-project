    def _sfx_projectile_wave(self) -> Optional[pygame.mixer.Sound]:
        n = int(self.sr * 0.40)
        out = [0.0] * n
        inv_sr = 1.0 / float(self.sr)
        ph = 0.0
        lp = 0.0
        for i in range(n):
            t = i * inv_sr
            u = i / float(n)
            f = lerp(420.0, 1180.0, math.sin(u * math.pi))
            ph += f * inv_sr * _TWO_PI
            rn = self._noise_lut[(i * 3) & self._noise_mask]
            lp += 0.24 * (rn - lp)
            env = math.sin(u * math.pi) ** 0.7
            out[i] = _fast_tanh((math.sin(ph) * 0.55 + lp * 1.4) * env * 1.8) * 0.82
        return self._to_stereo_sound(out, gain=0.84)

    def _sfx_resonance_roar(self) -> Optional[pygame.mixer.Sound]:
        n = int(self.sr * 0.78)
        out = [0.0] * n
        inv_sr = 1.0 / float(self.sr)
        ph1 = ph2 = 0.0
        for i in range(n):
            t = i * inv_sr
            f1 = 58.0 + 260.0 * math.exp(-t * 7.0)
            f2 = 293.66 * (1.0 + 0.08 * math.sin(t * 24.0))
            ph1 += f1 * inv_sr * _TWO_PI
            ph2 += f2 * inv_sr * _TWO_PI
            roar = (math.sin(ph1) + 0.5 * math.sin(ph2) + 0.4 * math.sin(ph2 * 1.498)) * math.exp(-t * 2.8)
            wind = self._noise_lut[i & self._noise_mask] * math.exp(-t * 4.5) * 0.55
            out[i] = _fast_tanh((roar + wind) * 2.1) * 0.90
        return self._to_stereo_sound(out, gain=0.90)

    def _sfx_super_flash(self, short: bool = False) -> Optional[pygame.mixer.Sound]:
        dur = 0.42 if short else 0.72
        n = int(self.sr * dur)
        out = [0.0] * n
        inv_sr = 1.0 / float(self.sr)
        ph = 0.0
        for i in range(n):
            t = i * inv_sr
            u = i / float(n)
            # Sweeping anime laser-chime + heavy sub impact
            f = 340.0 + 1840.0 * (u ** 1.5)
            ph += f * inv_sr * _TWO_PI
            sweep = math.sin(ph) * (1.0 - u) * 0.48
            gong = math.sin(t * 146.8 * _TWO_PI) * math.exp(-t * 4.2) * 0.75
            shing = math.sin(t * 3200.0 * _TWO_PI) * math.exp(-t * 12.0) * 0.45
            out[i] = _fast_tanh((sweep + gong + shing) * 1.9) * 0.88
        return self._to_stereo_sound(out, gain=0.88)

    def _sfx_cathedral_gong(self, dur: float, base_hz: float) -> Optional[pygame.mixer.Sound]:
        n = int(self.sr * dur)
        out = [0.0] * n
        inv_sr = 1.0 / float(self.sr)
        partials = (1.0, 2.0, 2.42, 3.16, 4.18)
        amps = (0.58, 0.36, 0.28, 0.20, 0.14)
        for i in range(n):
            t = i * inv_sr
            v = 0.0
            for mult, a in zip(partials, amps):
                v += math.sin(t * base_hz * mult * _TWO_PI) * a * math.exp(-t * (1.6 + mult * 0.65))
            strike = self._noise_lut[i & self._noise_mask] * math.exp(-t * 45.0) * 0.4
            out[i] = _fast_tanh((v + strike) * 1.6) * 0.86
        return self._to_stereo_sound(out, gain=0.86)

    def _sfx_ko_impact(self) -> Optional[pygame.mixer.Sound]:
        n = int(self.sr * 0.85)
        out = [0.0] * n
        inv_sr = 1.0 / float(self.sr)
        ph = 0.0
        for i in range(n):
            t = i * inv_sr
            f = 34.0 + 210.0 * math.exp(-t * 14.0)
            ph += f * inv_sr * _TWO_PI
            boom = math.sin(ph) * math.exp(-t * 3.0) * 1.15
            blast = self._noise_lut[(i * 3) & self._noise_mask] * math.exp(-t * 6.5) * 0.72
            out[i] = _fast_tanh((boom + blast) * 2.2) * 0.94
        return self._to_stereo_sound(out, gain=0.92)

    def _sfx_thud(
        self, dur: float, f0: float, f1: float, vol: float = 0.78, noise_amt: float = 0.25
    ) -> Optional[pygame.mixer.Sound]:
        n = int(self.sr * dur)
        out = [0.0] * n
        inv_sr = 1.0 / float(self.sr)
        ph = 0.0
        for i in range(n):
            t = i * inv_sr
            u = i / float(max(1, n - 1))
            f = lerp(f0, f1, u)
            ph += f * inv_sr * _TWO_PI
            env = math.exp(-t * (3.5 / max(0.05, dur)))
            rn = self._noise_lut[i & self._noise_mask] * noise_amt
            out[i] = _fast_tanh((math.sin(ph) + rn) * env * 1.6) * vol
        return self._to_stereo_sound(out, gain=0.82)

    def _sfx_ui_blip(self, dur: float, f0: float, f1: float) -> Optional[pygame.mixer.Sound]:
        n = int(self.sr * dur)
        out = [0.0] * n
        inv_sr = 1.0 / float(self.sr)
        ph = 0.0
        for i in range(n):
            u = i / float(max(1, n - 1))
            f = lerp(f0, f1, u)
            ph += f * inv_sr * _TWO_PI
            env = math.sin(u * math.pi) ** 0.65
            out[i] = (math.sin(ph) + 0.35 * math.sin(ph * 2.0)) * env * 0.45
        return self._to_stereo_sound(out, gain=0.72)


class AudioManager:
    """Crash-safe adaptive audio host managing Techno/Breakbeat BGM and SFX."""

    def __init__(self, settings: GameSettings) -> None:
        self.settings = settings
        self.enabled: bool = False
        self.synth: Optional[ProceduralAudioSynth] = None
        self.bgm_tracks: Dict[BGMId, Optional[pygame.mixer.Sound]] = {}
        self.sfx_bank: Dict[SFXId, Optional[pygame.mixer.Sound]] = {}
        self.current_bgm: BGMId = BGMId.NONE
        self._bgm_channel: Optional[pygame.mixer.Channel] = None
        self._duck_factor: float = 1.0
        self._bake_stage: int = 0
        self._init_mixer()

    def _init_mixer(self) -> None:
        try:
            if not pygame.mixer.get_init():
                pygame.mixer.init(frequency=AUDIO_SR, size=-16, channels=2, buffer=512)
            pygame.mixer.set_num_channels(24)
            self._bgm_channel = pygame.mixer.Channel(0)
            self.synth = ProceduralAudioSynth(AUDIO_SR)
            self.enabled = True
        except Exception:
            self.enabled = False

    def step_bake(self) -> float:
        """Progressive audio synthesis during loading screen; returns [0..1]."""
        if not self.enabled or self.synth is None:
            self._bake_stage = 5
            return 1.0
        if self._bake_stage == 0:
            self.sfx_bank = self.synth.build_all_sfx()
        elif self._bake_stage == 1:
            self.bgm_tracks[BGMId.TITLE_THEME] = self.synth.build_bgm_track(BGMId.TITLE_THEME)
        elif self._bake_stage == 2:
            self.bgm_tracks[BGMId.BATTLE_ASSAULT_A] = self.synth.build_bgm_track(BGMId.BATTLE_ASSAULT_A)
        elif self._bake_stage == 3:
            self.bgm_tracks[BGMId.BATTLE_ASSAULT_B] = self.synth.build_bgm_track(BGMId.BATTLE_ASSAULT_B)
        elif self._bake_stage == 4:
            self.bgm_tracks[BGMId.VICTORY_THEME] = self.synth.build_bgm_track(BGMId.VICTORY_THEME)
        self._bake_stage = min(5, self._bake_stage + 1)
        return self._bake_stage / 5.0

    def ensure_baked(self) -> None:
        while self._bake_stage < 5:
            self.step_bake()

    def apply_volumes(self) -> None:
        if not self.enabled or self._bgm_channel is None:
            return
        bgm_v = clamp(self.settings.master_volume * self.settings.bgm_volume * self._duck_factor, 0.0, 1.0)
        self._bgm_channel.set_volume(bgm_v)

    def set_duck(self, factor: float) -> None:
        self._duck_factor = clamp(factor, 0.15, 1.0)
        self.apply_volumes()

    def play_bgm(self, bgm_id: BGMId, force_restart: bool = False) -> None:
        if not self.enabled or self._bgm_channel is None:
            return
        if bgm_id == self.current_bgm and not force_restart and self._bgm_channel.get_busy():
            return
        self.current_bgm = bgm_id
        if bgm_id == BGMId.NONE:
            self._bgm_channel.fadeout(240)
            return
        snd = self.bgm_tracks.get(bgm_id)
        if snd is not None:
            self._bgm_channel.play(snd, loops=-1, fade_ms=260)
            self.apply_volumes()

    def play_sfx(self, sfx_id: SFXId, vol_scale: float = 1.0, pan: float = 0.0) -> None:
        if not self.enabled:
            return
        snd = self.sfx_bank.get(sfx_id)
        if snd is None:
            return
        vol = clamp(self.settings.master_volume * self.settings.sfx_volume * vol_scale, 0.0, 1.0)
        if vol <= 0.005:
            return
        ch = pygame.mixer.find_channel(True)
        if ch is not None and ch is not self._bgm_channel:
            gl = vol * clamp(1.0 - pan * 0.45, 0.25, 1.0)
            gr = vol * clamp(1.0 + pan * 0.45, 0.25, 1.0)
            ch.set_volume(gl, gr)
            ch.play(snd)

