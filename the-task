@dataclass(frozen=True)
class BoxRect:
    """Fighter-local box relative to anchor (world_x, world_y).
    +x is forward (mirrored automatically when facing left), -y is upward.
    """
    x: float
    y: float
    w: float
    h: float

    def to_world(
        self, fx: float, fy: float, facing_right: bool
    ) -> Tuple[float, float, float, float]:
        if facing_right:
            return (fx + self.x, fy + self.y, self.w, self.h)
        return (fx - self.x - self.w, fy + self.y, self.w, self.h)


@dataclass(frozen=True)
class HitWindow:
    """Single active strike window within a move (enables multi-hit specials & supers)."""
    hit_id: int
    start_frame: int
    end_frame: int
    hitbox: BoxRect
    clashbox: Optional[BoxRect] = None
    damage_mult: float = 1.0
    knockback_x: Optional[float] = None
    launch_vy: Optional[float] = None
    hitstop_override: Optional[int] = None
    force_hard_kd: bool = False
    is_final_hit: bool = True


