    def _lora_folder_menu(self, folder: str) -> None:
        """Right-click menu on a folder chip: enable / rename / delete the folder."""
        if folder == "ALL":
            return
        m = QMenu(self)
        m.addAction(
            f"Enable all {len([e for e in self._browsed_lora_stack() if e.get('folder') == folder])} in '{folder}'",
            lambda: self.enable_folder_loras(folder),
        )
        m.addAction(f"Rename '{folder}'\u2026", lambda: self.rename_lora_folder(folder))
        m.addAction(
            f"Delete '{folder}' (move entries to first folder)",
            lambda: self.delete_lora_folder(folder),
        )
        m.exec(QCursor.pos())

    def rename_lora_folder(self, folder: str) -> None:
        key = self._lora_view_key()
        folders = self._lora_stack_folders(key)
        new, ok = QInputDialog.getText(self, "Rename LoRA folder", "New folder name:", text=folder)
        new = new.strip()
        if not ok or not new or new == folder or new in folders:
            return
        folders[folders.index(folder)] = new
        for entry in self._browsed_lora_stack():
            if entry.get("folder") == folder:
                entry["folder"] = new
        if self._lora_folder_filter == folder:
            self._lora_folder_filter = new
        save_lora_library(self.lora_lib)
        self._rebuild_lora_ui()

    def delete_lora_folder(self, folder: str) -> None:
        key = self._lora_view_key()
        folders = self._lora_stack_folders(key)
        if folder not in folders or len(folders) <= 1:
            return
        folders.remove(folder)
        fallback = folders[0]
        for entry in self._browsed_lora_stack():
            if entry.get("folder") == folder:
                entry["folder"] = fallback
        if self._lora_folder_filter == folder:
            self._lora_folder_filter = "ALL"
        save_lora_library(self.lora_lib)
        self._rebuild_lora_ui()

    def enable_folder_loras(self, folder: Optional[str] = None) -> None:
        """Enable every LoRA of a folder (or the current filter) capped at 5 active."""
        stack = self._browsed_lora_stack()
        folder = folder or self._lora_folder_filter
        now_enabled = sum(1 for e in stack if e.get("enabled") and e.get("id"))
        budget = max(0, MAX_ACTIVE_LORAS - now_enabled)
        flipped = 0
        for entry in stack:
            if budget <= 0:
                break
            if not entry.get("enabled") and entry.get("id"):
                if folder == "ALL" or entry.get("folder") == folder:
                    entry["enabled"] = True
                    flipped += 1
                    budget -= 1
        if flipped:
            save_lora_library(self.lora_lib)
            self._rebuild_lora_ui()
            self._flash_summary(f"Enabled {flipped} LoRA(s) (max {MAX_ACTIVE_LORAS} active)")
        else:
            self._flash_summary("Nothing to enable (folder empty or 5 already active)")

    def _select_lora_folder(self, folder: str) -> None:
        self._lora_folder_filter = folder
        self._rebuild_lora_ui()

    def _on_lora_search(self, text: str) -> None:
        self._lora_search = text or ""
        self._rebuild_lora_ui()

    def _on_lora_toggled(self, uid: str) -> None:
        self._on_lora_changed(uid)
        self._show_lora_details()

    def _on_lora_changed(self, _uid: str) -> None:
        self._schedule_save()
        self._update_deck_badges()
        self._refresh_lora_ghost()
        self._update_generate_subtext()

    def _on_prompt_slider_changed(self, uid: str, weight: float) -> None:
        for entry in self._current_lora_stack():
            if entry.get("uid") == uid:
                entry["model"] = round(weight, 2)
                if entry.get("link_clip", True):
                    entry["clip"] = round(weight, 2)
                break
        self._schedule_save()

    def _find_lora_by_uid(self, uid: str) -> Optional[Dict[str, Any]]:
        for entry in self._browsed_lora_stack():
            if entry.get("uid") == uid:
                return entry
        return None

    # ---- Details panel plumbing ----------------------------------------------
    def _lora_detail_uid(self) -> Optional[str]:
        if not hasattr(self, "lora_list"):
            return None
        it = self.lora_list.currentItem()
        if it is None:
            return None
        uid = it.data(Qt.ItemDataRole.UserRole)
        return str(uid) if uid else None

    def _lora_detail_entry(self) -> Optional[Dict[str, Any]]:
        uid = self._lora_detail_uid()
        return self._find_lora_by_uid(uid) if uid else None

    def _show_lora_details(self) -> None:
        entry = self._lora_detail_entry()
        self._lora_detail_syncing = True
        try:
            # The dock only takes vertical space while an entry is selected
            if hasattr(self, "lora_detail"):
                self.lora_detail.setVisible(entry is not None)
            if entry is None:
                self.lora_d_name.setText("No LoRA selected")
                self.lora_d_name.setStyleSheet("")
                self.lora_d_enabled.setChecked(False)
                self.lora_d_enabled.setEnabled(False)
                self.lora_d_folder.clear()
                self.lora_d_trigger.clear()
                self.lora_d_slider.setEnabled(False)
                self.lora_d_mspin.setEnabled(False)
                self.lora_d_cspin.setEnabled(False)
                self.lora_d_val.setText("\u2014")
                return
            self.lora_d_enabled.setEnabled(True)
            self.lora_d_slider.setEnabled(True)
            self.lora_d_mspin.setEnabled(True)
            self.lora_d_cspin.setEnabled(True)
            self.lora_d_name.setText(str(entry.get("name") or f"LoRA #{entry.get('id', '?')}"))
            self.lora_d_name.setStyleSheet("" if entry.get("enabled", True) else f"color: {C['dim']};")
            self.lora_d_enabled.setChecked(bool(entry.get("enabled", True)))
            self.lora_d_enabled.setText("ON" if entry.get("enabled", True) else "OFF")
            # Folder combo (move target)
            folders = self._lora_stack_folders()
            self.lora_d_folder.blockSignals(True)
            self.lora_d_folder.clear()
            self.lora_d_folder.addItems(folders)
            ix = self.lora_d_folder.findText(str(entry.get("folder") or "Improve-Overall"))
            self.lora_d_folder.setCurrentIndex(max(0, ix))
            self.lora_d_folder.blockSignals(False)
            # Weight slider + spins
            s_min = float(entry.get("slider_min", -2.0))
            s_max = float(entry.get("slider_max", 2.0))
            self.lora_d_slider.blockSignals(True)
            self.lora_d_slider.setRange(int(round(s_min * 20)), int(round(s_max * 20)))
            self.lora_d_slider.setValue(int(round(float(entry.get("model", 1.0)) * 20)))
            self.lora_d_slider.blockSignals(False)
            self.lora_d_val.setText(f"{float(entry.get('model', 1.0)):+.2f}")
            self.lora_d_mspin.blockSignals(True)
            self.lora_d_cspin.blockSignals(True)
            self.lora_d_mspin.setValue(float(entry.get("model", 1.0)))
            self.lora_d_cspin.setValue(float(entry.get("clip", 1.0)))
            self.lora_d_mspin.blockSignals(False)
            self.lora_d_cspin.blockSignals(False)
            self.lora_d_link.setChecked(bool(entry.get("link_clip", True)))
            pref = float(entry.get("preferred_strength", 1.0))
            self.lora_d_pref.setText(f"\u2605 {pref:+.2f}")
            # Trigger variant combo
            self.lora_d_trigger.blockSignals(True)
            self.lora_d_trigger.clear()
            for tv in entry.get("triggers") or []:
                self.lora_d_trigger.addItem(str(tv.get("label") or "Trigger"))
            try:
                self.lora_d_trigger.setCurrentIndex(max(0, int(entry.get("trigger_sel", 0))))
            except (TypeError, ValueError):
                self.lora_d_trigger.setCurrentIndex(0)
            self.lora_d_trigger.blockSignals(False)
            if not (entry.get("triggers") or []):
                self.lora_d_trigger.addItem("(no trigger words \u2014 use LOOKUP)")
        finally:
            self._lora_detail_syncing = False

    def _on_lora_d_enabled(self, on: bool) -> None:
        if getattr(self, "_lora_detail_syncing", False):
            return
        entry = self._lora_detail_entry()
        if entry is None:
            return
        entry["enabled"] = bool(on)
        self.lora_d_enabled.setText("ON" if on else "OFF")
        self.lora_d_name.setStyleSheet("" if on else f"color: {C['dim']};")
        save_lora_library(self.lora_lib)
        self.lora_list.viewport().update()
        self._on_lora_changed(str(entry.get("uid") or ""))

    def _on_lora_d_slider(self, val: int) -> None:
        if getattr(self, "_lora_detail_syncing", False):
            return
        entry = self._lora_detail_entry()
        if entry is None:
