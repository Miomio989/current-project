            self.theme_btn.setToolTip(f"Theme: {th['name']} - click to switch  (Ctrl+Shift+T)\n"
                                      f"{th['hint']}")
        for key, act in getattr(self, "theme_actions", {}).items():
            act.setChecked(key == name)

