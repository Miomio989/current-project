        # 4. Special Moves (Ground & Air)
        if not self.grounded and p_any_atk:
            # j.236 Falling Guillotine
            if (self.input_buf.match_motion((2, 3, 6), 14) or self.input_buf.match_motion((2, 6), 12) or (simple_mode and np == 2 and p_c)):
                if self.can_cancel_into(FighterState.SP_GUILLOTINE):
                    self._launch_attack(FighterState.SP_GUILLOTINE, audio, vfx)
