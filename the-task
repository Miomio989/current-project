class GalleryScreen:
    """Animation Keyframe Inspection Studio + Procedural 146 BPM OST & SFX Sound Test."""

    def __init__(
        self,
        fonts: FontManager,
        bank: SpriteBank,
        stage: CursedCathedralStage,
        audio: AudioManager,
        archive: DarkmoonArchive,
    ) -> None:
        self.fonts = fonts
        self.bank = bank
        self.stage = stage
        self.audio = audio
        self.archive = archive
        self.mode_tab: int = 0  # 0=Keyframe Studio, 1=OST & SFX Sound Test, 2=Darkmoon Lore Archive
        self.all_states: List[FighterState] = list(FighterState)
        self.state_idx: int = 0
        self.palette_idx: int = 0
        self.playing: bool = True
        self.frame_idx: int = 0
        self.tick_accum: int = 0
        self.resonance_preview: bool = False
        self.dossier_idx: int = 0

        # Sound test state
        self.bgm_list: List[BGMId] = [
            BGMId.TITLE_THEME, BGMId.BATTLE_ASSAULT_A, BGMId.BATTLE_ASSAULT_B, BGMId.VICTORY_THEME
        ]
        self.sfx_list: List[SFXId] = list(SFXId)
        self.sound_cursor: int = 0
        self.wave_phase: float = 0.0

    def handle_key(self, key: int) -> Optional[str]:
        if key == pygame.K_TAB:
            self.mode_tab = (self.mode_tab + 1) % 3
            self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)
            return None
        if key in (pygame.K_ESCAPE, pygame.K_BACKSPACE):
            self.audio.play_sfx(SFXId.UI_CANCEL, vol_scale=0.8)
            return "CLOSE"

        if self.mode_tab == 0:
            if key in (pygame.K_UP, pygame.K_w):
                self.state_idx = (self.state_idx - 1) % len(self.all_states)
                self.frame_idx = 0
                self.tick_accum = 0
                self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.7)
            elif key in (pygame.K_DOWN, pygame.K_s):
                self.state_idx = (self.state_idx + 1) % len(self.all_states)
                self.frame_idx = 0
                self.tick_accum = 0
                self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.7)
            elif key == pygame.K_SPACE:
                self.playing = not self.playing
                self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.7)
            elif key in (pygame.K_LEFT, pygame.K_a):
                self.playing = False
                kfs = self.bank.get_frame_list(self.all_states[self.state_idx])
                self.frame_idx = (self.frame_idx - 1) % len(kfs)
            elif key in (pygame.K_RIGHT, pygame.K_d):
                self.playing = False
                kfs = self.bank.get_frame_list(self.all_states[self.state_idx])
                self.frame_idx = (self.frame_idx + 1) % len(kfs)
            elif key == pygame.K_p:
                self.palette_idx = (self.palette_idx + 1) % len(CECILIA_PALETTES)
                self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.75)
            elif key == pygame.K_r:
                self.resonance_preview = not self.resonance_preview
                self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.75)
        elif self.mode_tab == 1:
            total = len(self.bgm_list) + len(self.sfx_list)
            if key in (pygame.K_UP, pygame.K_w):
                self.sound_cursor = (self.sound_cursor - 1) % total
                self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.65)
            elif key in (pygame.K_DOWN, pygame.K_s):
                self.sound_cursor = (self.sound_cursor + 1) % total
                self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.65)
            elif key in (pygame.K_RETURN, pygame.K_SPACE):
                if self.sound_cursor < len(self.bgm_list):
                    self.audio.play_bgm(self.bgm_list[self.sound_cursor], force_restart=True)
                else:
                    sfx_id = self.sfx_list[self.sound_cursor - len(self.bgm_list)]
                    self.audio.play_sfx(sfx_id, vol_scale=1.0)
        else:
            n_d = len(DARKMOON_LORE_DOSSIERS)
            if key in (pygame.K_UP, pygame.K_w):
                self.dossier_idx = (self.dossier_idx - 1) % n_d
                self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.75)
            elif key in (pygame.K_DOWN, pygame.K_s):
                self.dossier_idx = (self.dossier_idx + 1) % n_d
                self.audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.75)
        return None

