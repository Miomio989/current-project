    def _draw_kinetic_slash_smear(
        self,
        surf: pygame.Surface,
        sl: SlashSmearSpec,
        pal: CeciliaCGPalette,
        ax: float,
        ay: float,
        ss: float,
    ) -> None:
        out_pts = sample_cubic(
            (ax + sl.outer_p0[0] * ss, ay + sl.outer_p0[1] * ss),
            (ax + sl.outer_p1[0] * ss, ay + sl.outer_p1[1] * ss),
            (ax + sl.outer_p2[0] * ss, ay + sl.outer_p2[1] * ss),
            (ax + sl.outer_p3[0] * ss, ay + sl.outer_p3[1] * ss),
            16,
        )
        in_pts = sample_cubic(
            (ax + sl.inner_p0[0] * ss, ay + sl.inner_p0[1] * ss),
            (ax + sl.inner_p1[0] * ss, ay + sl.inner_p1[1] * ss),
            (ax + sl.inner_p2[0] * ss, ay + sl.inner_p2[1] * ss),
            (ax + sl.inner_p3[0] * ss, ay + sl.inner_p3[1] * ss),
            16,
        )
        c0 = lerp_rgb(pal.aura_outer, pal.aura_mid, 1.0 - sl.crimson_bias)
        c1 = lerp_rgb(pal.aura_mid, pal.rune_glow, 0.5)
        c2 = pal.aura_core
        self.cg.draw_feathered_ribbon(
            surf, out_pts, in_pts,
            [c0, c1, c2],
            alpha=clamp_int(int(235 * sl.intensity), 40, 250),
            additive=True,
        )
        # Razor kinetic speed-lines streaking along the slash curvature!
        for frac, col, w in ((0.92, pal.aura_core, 2.2), (0.64, pal.rune_glow, 1.6), (0.32, pal.aura_outer, 1.3)):
            arc = [v_lerp(in_pts[i], out_pts[i], frac) for i in range(len(out_pts))]
            pygame.draw.aalines(surf, col, False, arc)
            if w > 1.8:
                pygame.draw.lines(surf, col, False, arc[2:-1], max(1, int(w * ss * 0.7)))

        # Trailing glowing plasma embers & dark obsidian slash fragments
        rng = random.Random(sl.sparks_seed * 73 + 911)
        for _ in range(10):
            idx = rng.randint(2, len(out_pts) - 2)
            base_p = v_lerp(in_pts[idx], out_pts[idx], rng.uniform(0.35, 1.08))
            tang = v_norm(v_sub(out_pts[idx], out_pts[max(0, idx - 1)]))
            spk_len = rng.uniform(6.0, 18.0) * ss * sl.intensity
            sp_end = (base_p[0] - tang[0] * spk_len, base_p[1] - tang[1] * spk_len)
            pygame.draw.line(surf, pal.aura_core, base_p, sp_end, max(1, int(1.6 * ss)))
            self.cg.blit_glow(surf, base_p, 7.5 * ss * sl.intensity, pal.aura_mid, 145, additive=True)


