    def spawn_water_splash(
        self,
        world_x: float,
        intensity: float = 1.0,
        direction: float = 0.0,
        blood_tinted: bool = False,
    ) -> None:
        """Spawn mockup.jpg white-pink incandescent boot splash droplets + ripples!"""
        if len(self.ripples) > 48:
            self.ripples.pop(0)
        r_col = (248, 42, 92) if blood_tinted else (255, 188, 224)
        self.ripples.append(
            WaterRipple(
                world_x=clamp(world_x, STAGE_LEFT_WALL, STAGE_RIGHT_WALL),
                world_y=GROUND_Y + random.uniform(-4.0, 10.0),
                radius=6.0,
                max_radius=clamp(28.0 + 38.0 * intensity, 24.0, 108.0),
                alpha=clamp(0.92 * intensity, 0.45, 1.0),
                color=r_col,
            )
        )
        n_drops = clamp_int(int(8 + 14 * intensity), 6, 26)
        for _ in range(n_drops):
            if len(self.splashes) > 150:
                self.splashes.pop(0)
            spread_vx = random.uniform(-110.0, 110.0) * intensity + direction * 68.0
            up_vy = -random.uniform(90.0, 240.0) * clamp(intensity, 0.55, 1.45)
            col = (
                random.choice(((248, 36, 78), (255, 112, 148), (192, 16, 48)))
                if blood_tinted
                else random.choice(((255, 246, 252), (255, 206, 232), (242, 138, 196)))
            )
            self.splashes.append(
                WaterSplashPlume(
                    world_x=world_x + random.uniform(-16.0, 16.0),
                    world_y=GROUND_Y + random.uniform(-4.0, 4.0),
                    vx=spread_vx,
                    vy=up_vy,
                    size=random.uniform(1.8, 4.2) * clamp(intensity, 0.7, 1.3),
                    life=0.0,
                    max_life=random.uniform(0.24, 0.46),
                    color=col,
