def draw_gothic_panel(
    surf: pygame.Surface,
    rect: pygame.Rect,
    bg_alpha: int = 212,
    border_col: RGB = UI_BORDER_SILVER,
    accent_col: RGB = UI_CRIMSON_CORE,
    corner_cut: int = 14,
    ornate: bool = True,
) -> None:
    """Draw a Soulcalibur / DMC4 / Bayonetta sculpted obsidian-and-silver gothic frame."""
    x, y, w, h = rect.x, rect.y, rect.w, rect.h
    if w < 12 or h < 12:
        return
    c = min(corner_cut, w // 4, h // 4)
    pts = [
        (x + c, y),
        (x + w - c, y),
        (x + w, y + c),
        (x + w, y + h - c),
        (x + w - c, y + h),
        (x + c, y + h),
        (x, y + h - c),
        (x, y + c),
    ]

    # Vertical obsidian-to-burgundy gradient fill inside panel
    panel_s = pygame.Surface((w, h), pygame.SRCALPHA)
    local_pts = [(px - x, py - y) for (px, py) in pts]
    pygame.draw.polygon(panel_s, (16, 10, 20, bg_alpha), local_pts)

    # Top inner glass sheen & bottom crimson velvet tint (alpha-composited cleanly!)
    tint_layer = pygame.Surface((w, h), pygame.SRCALPHA)
    sheen_h = max(4, min(42, h // 4))
    for row in range(sheen_h):
        t = 1.0 - (row / float(sheen_h))
        alpha_r = int(38 * t * t)
        pygame.draw.line(tint_layer, (196, 186, 224, alpha_r), (2, row + 1), (w - 3, row + 1))

    tint_h = max(6, min(96, h // 3))
    for row in range(tint_h):
        t = row / float(tint_h)
        alpha_r = int(52 * t * t)
        ry = h - tint_h + row
        pygame.draw.line(
            tint_layer,
            (accent_col[0], accent_col[1], accent_col[2], alpha_r),
            (2, ry),
            (w - 3, ry),
        )
    panel_s.blit(tint_layer, (0, 0))

    # Mask corners cleanly
    mask_s = pygame.Surface((w, h), pygame.SRCALPHA)
    pygame.draw.polygon(mask_s, (255, 255, 255, 255), local_pts)
    panel_s.blit(mask_s, (0, 0), special_flags=pygame.BLEND_RGBA_MIN)
    surf.blit(panel_s, (x, y))

    # Double metallic gothic borders
    pygame.draw.polygon(surf, UI_BORDER_DARK, pts, 3)
    pygame.draw.polygon(surf, border_col, pts, 1)

    inner_c = max(2, c - 4)
    in_pts = [
        (x + inner_c + 4, y + 4),
        (x + w - inner_c - 4, y + 4),
        (x + w - 4, y + inner_c + 4),
        (x + w - 4, y + h - inner_c - 4),
        (x + w - inner_c - 4, y + h - 4),
        (x + inner_c + 4, y + h - 4),
        (x + 4, y + h - inner_c - 4),
        (x + 4, y + inner_c + 4),
    ]
    pygame.draw.polygon(surf, with_alpha(accent_col, 150), in_pts, 1)

    if ornate and w >= 60 and h >= 36:
        # Four faceted gothic corner jewels + silver thorn filigree wings
        corners = [
            (x + c, y + 2, 1, 1),
            (x + w - c, y + 2, -1, 1),
            (x + c, y + h - 2, 1, -1),
            (x + w - c, y + h - 2, -1, -1),
        ]
        for cx, cy, dx, dy in corners:
            gem = [(cx, cy - 4), (cx + 4, cy), (cx, cy + 4), (cx - 4, cy)]
            pygame.draw.polygon(surf, accent_col, gem)
            pygame.draw.polygon(surf, UI_BORDER_BRIGHT, gem, 1)
            # Filigree curl ticks
            pygame.draw.line(surf, border_col, (cx + dx * 6, cy), (cx + dx * 20, cy), 1)
            pygame.draw.line(
                surf,
                accent_col,
                (cx + dx * 8, cy + dy * 3),
                (cx + dx * 15, cy + dy * 3),
                1,
            )


def draw_gothic_diamond_gem(
    surf: pygame.Surface,
    cx: int,
    cy: int,
    radius: int,
    core_col: RGB,
    glow_col: RGB,
    lit: bool = True,
) -> None:
    """Draw a sculpted gothic diamond jewel (round orbs, resonance crystal, menu cursor)."""
    if lit:
        # Outer bloom halo
        halo = pygame.Surface((radius * 4, radius * 4), pygame.SRCALPHA)
        pygame.draw.circle(halo, with_alpha(glow_col, 48), (radius * 2, radius * 2), int(radius * 1.7))
        pygame.draw.circle(halo, with_alpha(glow_col, 95), (radius * 2, radius * 2), int(radius * 1.15))
        surf.blit(halo, (cx - radius * 2, cy - radius * 2))

    outer = [
        (cx, cy - radius),
        (cx + int(radius * 0.82), cy),
        (cx, cy + radius),
        (cx - int(radius * 0.82), cy),
    ]
    fill = core_col if lit else (28, 22, 34)
    pygame.draw.polygon(surf, fill, outer)

    if lit:
        top_facet = [
            (cx, cy - radius + 2),
            (cx + int(radius * 0.55), cy - 1),
            (cx, cy),
            (cx - int(radius * 0.55), cy - 1),
        ]
        pygame.draw.polygon(surf, lerp_color(core_col, (255, 255, 255), 0.58), top_facet)
        pygame.draw.circle(surf, (255, 250, 250), (cx - max(1, radius // 5), cy - max(1, radius // 3)), max(1, radius // 5))

    pygame.draw.polygon(surf, UI_BORDER_SILVER if lit else UI_BORDER_DARK, outer, 2)


def generate_arcane_sigil_surface(
    diameter: int,
    primary_col: RGB = (224, 24, 54),
    secondary_col: RGB = (255, 198, 118),
    alpha: int = 195,
) -> pygame.Surface:
    """Bake an intricate Bayonetta / DMC4 arcane gothic summoning ring surface."""
    surf = pygame.Surface((diameter, diameter), pygame.SRCALPHA)
    c = diameter * 0.5
    r_outer = diameter * 0.46
    r_mid = diameter * 0.37
    r_inner = diameter * 0.25

    col1 = with_alpha(primary_col, alpha)
    col2 = with_alpha(secondary_col, int(alpha * 0.9))
    col_glow = with_alpha(primary_col, int(alpha * 0.35))

    # Soft glow ring
    pygame.draw.circle(surf, col_glow, (int(c), int(c)), int(r_outer), max(3, diameter // 36))
    pygame.draw.circle(surf, col1, (int(c), int(c)), int(r_outer), 2)
    pygame.draw.circle(surf, col2, (int(c), int(c)), int(r_outer * 0.94), 1)
    pygame.draw.circle(surf, col1, (int(c), int(c)), int(r_mid), 2)
    pygame.draw.circle(surf, col2, (int(c), int(c)), int(r_inner), 1)

    # Interlocking 8-pointed gothic star (two rotated squares)
    for rot_deg in (0.0, 45.0):
        sq: List[Tuple[float, float]] = []
        for k in range(4):
            a = math.radians(rot_deg + k * 90.0)
            sq.append((c + math.cos(a) * r_mid, c + math.sin(a) * r_mid))
        pygame.draw.polygon(surf, col1, sq, 2)

    # Hexagram thorns inside inner circle
    for rot_deg in (0.0, 60.0):
        tri: List[Tuple[float, float]] = []
        for k in range(3):
            a = math.radians(rot_deg + k * 120.0)
            tri.append((c + math.cos(a) * r_inner, c + math.sin(a) * r_inner))
        pygame.draw.polygon(surf, col2, tri, 1)

    # 24 procedural demonic runic glyphs inscribed between outer and mid circles
    r_glyph = (r_outer * 0.94 + r_mid) * 0.5
    glyph_len = max(3.0, (r_outer - r_mid) * 0.36)
    for i in range(24):
        ang = (math.tau * i) / 24.0
        gx = c + math.cos(ang) * r_glyph
        gy = c + math.sin(ang) * r_glyph
        rx = math.cos(ang)
        ry = math.sin(ang)
        tx = -ry
        ty = rx
        # Radial spine
        p_a = (gx - rx * glyph_len, gy - ry * glyph_len)
        p_b = (gx + rx * glyph_len, gy + ry * glyph_len)
        pygame.draw.line(surf, col2, p_a, p_b, 1)
        # Angular glyph prongs varying by index
        pattern = i % 4
        if pattern == 0:
            pygame.draw.line(surf, col1, (gx, gy), (gx + (rx + tx) * glyph_len * 0.7, gy + (ry + ty) * glyph_len * 0.7), 1)
        elif pattern == 1:
            pygame.draw.line(surf, col1, (gx - tx * glyph_len * 0.6, gy - ty * glyph_len * 0.6), (gx + tx * glyph_len * 0.6, gy + ty * glyph_len * 0.6), 1)
        elif pattern == 2:
            pygame.draw.line(surf, col1, p_a, (gx + tx * glyph_len * 0.7, gy + ty * glyph_len * 0.7), 1)
            pygame.draw.line(surf, col1, p_b, (gx - tx * glyph_len * 0.7, gy - ty * glyph_len * 0.7), 1)
        else:
            pygame.draw.circle(surf, col2, (int(gx), int(gy)), max(1, int(glyph_len * 0.35)), 1)

    # Cardinal crescent spikes on outer edge
    for k in range(8):
        ang = math.radians(k * 45.0)
        tip = (c + math.cos(ang) * (r_outer * 1.07), c + math.sin(ang) * (r_outer * 1.07))
        l_pt = (c + math.cos(ang - 0.08) * (r_outer * 0.94), c + math.sin(ang - 0.08) * (r_outer * 0.94))
        r_pt = (c + math.cos(ang + 0.08) * (r_outer * 0.94), c + math.sin(ang + 0.08) * (r_outer * 0.94))
        pygame.draw.polygon(surf, col2, [tip, l_pt, r_pt])

    return surf


