def render_calligraphy_logo(
    width: int,
    height: int,
    glow_color: RGB = (224, 18, 48),
    core_color: RGB = (248, 240, 242),
    edge_color: RGB = (140, 12, 32),
    seed: int = 909,
) -> pygame.Surface:
    """Render high-budget calligraphic logo for '呪いの刃' with layered glow,
    bevelled ink texture, crimson slash accent, and flying dry-brush splatters.
    """
    surf = pygame.Surface((width, height), pygame.SRCALPHA)
    rng = random.Random(seed)

    # Subtle crimson sword-slash streak slashing horizontally behind the calligraphy
    slash_pts = [
        (width * 0.03, height * 0.58),
        (width * 0.34, height * 0.48),
        (width * 0.72, height * 0.43),
        (width * 0.98, height * 0.38),
        (width * 0.72, height * 0.50),
        (width * 0.32, height * 0.56),
        (width * 0.03, height * 0.62),
    ]
    glow_layer = pygame.Surface((width, height), pygame.SRCALPHA)
    pygame.draw.polygon(glow_layer, with_alpha(glow_color, 55), slash_pts)
    inner_slash = [
        (width * 0.08, height * 0.56),
        (width * 0.52, height * 0.47),
        (width * 0.94, height * 0.40),
        (width * 0.52, height * 0.51),
    ]
    pygame.draw.polygon(glow_layer, (255, 196, 196, 130), inner_slash)
    surf.blit(glow_layer, (0, 0))

    # Character slot layout: 呪 (large), の (slightly compact italic), 刃 (colossal)
    slots: List[Tuple[str, float, float, float, float]] = [
        ("呪", width * 0.08, height * 0.09, width * 0.28, height * 0.80),
        ("の", width * 0.38, height * 0.19, width * 0.22, height * 0.66),
        ("刃", width * 0.61, height * 0.05, width * 0.32, height * 0.88),
    ]

    # Pre-bake multi-pass strokes:
    # Pass 1: Wide diffused crimson curse aura glow
    # Pass 2: Deep obsidian shadow drop
    # Pass 3: Dark crimson metallic bevel rim
    # Pass 4: Pure calligraphic ivory/silver-tinted ink core + dry-brush fibers
    aura_surf = pygame.Surface((width, height), pygame.SRCALPHA)
    shadow_surf = pygame.Surface((width, height), pygame.SRCALPHA)
    bevel_surf = pygame.Surface((width, height), pygame.SRCALPHA)
    ink_surf = pygame.Surface((width, height), pygame.SRCALPHA)

    for ch, gx, gy, gw, gh in slots:
        strokes = CALLIGRAPHY_GLYPHS[ch]
        for s_idx, stroke in enumerate(strokes):
            ctrl = [Vec2(gx + px * gw, gy + py * gh) for (px, py) in stroke.points]
            sampled = sample_catmull_rom(ctrl, steps_per_seg=8)
            n = len(sampled)
            if n < 2:
                continue
            # Interpolate per-sample brush pressure widths
            w_scale = min(gw, gh)
            widths_core: List[float] = []
            widths_aura: List[float] = []
            widths_bevel: List[float] = []
            raw_w = stroke.widths
            for i in range(n):
                u = i / float(max(1, n - 1))
                pos_f = u * (len(raw_w) - 1)
                idx0 = int(math.floor(pos_f))
                idx1 = min(len(raw_w) - 1, idx0 + 1)
                frac = pos_f - idx0
                w_base = lerp(raw_w[idx0], raw_w[idx1], frac) * w_scale
                # Slight organic brush tremor
                wobble = 1.0 + 0.06 * math.sin(u * 19.0 + s_idx * 2.1)
                wc = max(1.8, w_base * wobble)
                widths_core.append(wc)
                widths_bevel.append(wc * 1.24 + 2.0)
                widths_aura.append(wc * 1.92 + 6.0)

            poly_aura = build_tapered_ribbon(sampled, widths_aura)
            poly_bevel = build_tapered_ribbon(sampled, widths_bevel)
            poly_core = build_tapered_ribbon(sampled, widths_core)

            if len(poly_aura) >= 3:
                pygame.draw.polygon(aura_surf, with_alpha(glow_color, 44), poly_aura)
                pygame.draw.polygon(
                    aura_surf,
                    with_alpha(glow_color, 72),
                    build_tapered_ribbon(sampled, [w * 1.48 + 3.0 for w in widths_core]),
                )

            if len(poly_bevel) >= 3:
                sh_poly = [(x + 4.5, y + 6.0) for (x, y) in poly_bevel]
                pygame.draw.polygon(shadow_surf, (8, 2, 8, 225), sh_poly)
                # For the piercing crimson dot on '刃', paint it blazing blood red!
                is_blade_dot = (ch == "刃" and s_idx == 2)
                bev_col = (255, 42, 64, 245) if is_blade_dot else with_alpha(edge_color, 245)
                pygame.draw.polygon(bevel_surf, bev_col, poly_bevel)

            if len(poly_core) >= 3:
                is_blade_dot = (ch == "刃" and s_idx == 2)
                c_fill = (255, 198, 190, 255) if is_blade_dot else with_alpha(core_color, 255)
                pygame.draw.polygon(ink_surf, c_fill, poly_core)

                # Inner top-left metallic highlight sheen ribbon
                hi_spine = [Vec2(p.x - 1.2, p.y - 1.4) for p in sampled]
                hi_widths = [max(0.8, w * 0.42) for w in widths_core]
                poly_hi = build_tapered_ribbon(hi_spine, hi_widths)
                if len(poly_hi) >= 3:
                    pygame.draw.polygon(ink_surf, (255, 252, 255, 165), poly_hi)

                # Dry-brush split bristle streaks near flick tails
                if stroke.dry_split and n > 6:
                    tail_start = int(n * 0.58)
                    for bristle in (-1, 1):
                        b_pts: List[Tuple[float, float]] = []
                        for k in range(tail_start, n):
                            p = sampled[k]
                            tang = (sampled[k] - sampled[k - 1]).normalized()
                            nrm = tang.perp()
                            offset = bristle * widths_core[k] * 1.15
                            b_pts.append((p.x + nrm.x * offset, p.y + nrm.y * offset))
                        if len(b_pts) >= 2:
                            pygame.draw.lines(ink_surf, with_alpha(edge_color, 180), False, b_pts, 2)

            # Organic calligraphy ink splatter droplets around rapid stroke ends
            if n >= 3:
                end_pt = sampled[-1]
                for _ in range(4):
                    ang = rng.uniform(0.0, math.tau)
                    dist = rng.uniform(4.0, 24.0) * (width / 640.0)
                    rad = rng.uniform(1.0, 3.2) * (width / 640.0)
                    sx = int(end_pt.x + math.cos(ang) * dist)
                    sy = int(end_pt.y + math.sin(ang) * dist)
                    c_drop = with_alpha(glow_color, rng.randint(130, 225))
                    pygame.draw.circle(aura_surf, c_drop, (sx, sy), max(1, int(rad)))

    surf.blit(aura_surf, (0, 0))
    surf.blit(shadow_surf, (0, 0))
    surf.blit(bevel_surf, (0, 0))
    surf.blit(ink_surf, (0, 0))
    return surf


