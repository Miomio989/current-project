        ]
        pygame.draw.polygon(mask, (255, 255, 255, 255), poly_m)
        surf.blit(mask, (0, 0), special_flags=pygame.BLEND_RGBA_MULT)

        # Ornate silver-thorn filigree frame around portrait
        pygame.draw.polygon(surf, (226, 214, 236), poly_m, 4)
        pygame.draw.polygon(surf, pal.hud_bar_mid, poly_m, 2)
        if not facing_right:
            surf = pygame.transform.flip(surf, True, False)
        return pygame.transform.smoothscale(surf, (size, size))

    def render_super_cutin_banner(
        self,
        pal: CeciliaPalette,
        super_name: str,
        facing_right: bool = True,
    ) -> pygame.Surface:
        """
