        seat = (
            f"<polygon points='5,1.2 19,1.2 22.8,5 22.8,19 19,22.8 5,22.8 1.2,19 1.2,5' "
            f"fill='url(#bodyLac)' stroke='{p['line_hi']}' stroke-opacity='0.5' stroke-width='0.8' opacity='0.52'/>"
