        ph = 0.0
        for i in range(n):
            t = i * inv_sr
            freq = 48.0 + 240.0 * math.exp(-t * 26.0)
            ph += freq * inv_sr * _TWO_PI
            boom = math.sin(ph) * math.exp(-t * 7.0)
            shatter = (math.sin(t * 9200.0) + math.sin(t * 13400.0)) * self._noise_lut[i & self._noise_mask] * math.exp(-t * 14.0) * 0.7
            out[i] = _fast_tanh((boom * 1.4 + shatter) * 2.1) * 0.90
        return self._to_stereo_sound(out, gain=0.90)

    def _sfx_curse_rupture(self) -> Optional[pygame.mixer.Sound]:
