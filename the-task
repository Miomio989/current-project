def run_qa_smoke_test(dump_dir: Optional[str] = None) -> int:
    """
    Headless publisher QA certification pass verifying:
      - Progressive stage & sprite pre-baking latency
      - All 60 animation states & 536+ hand-authored keyframes render crash-free
      - Audio DSP SFX bank (42/42) & full multi-movement non-looping OST synthesis
      - 480 frames of live battle simulation (AI, Clash/Parry, Super Cut-In, Blood VFX)
      - Training Lab (Hitboxes, Frame Data, Input Tape & Trials), Codex, Gallery & Lore
      - Locked 800x600 FPS throughput benchmark & optional PNG screenshot dumps!
    """
    os.environ.setdefault("SDL_VIDEODRIVER", "dummy")
    os.environ.setdefault("SDL_AUDIODRIVER", "dummy")
    if dump_dir:
        os.makedirs(dump_dir, exist_ok=True)

    app = NoroiNoYaibaApp(headless=True)
    t_bake = app.bake_all_blocking()

    # 1. Verify Title Screen & Main Menu
    app.screen = ScreenState.TITLE
    app.audio.play_bgm(OSTTrackId.TITLE_OVERTURE)
    app.render_canvas()
    if dump_dir:
        pygame.image.save(app.canvas, os.path.join(dump_dir, "01_title_screen.png"))

    app.screen = ScreenState.MAIN_MENU
    app.render_canvas()
    if dump_dir:
        pygame.image.save(app.canvas, os.path.join(dump_dir, "02_main_menu.png"))

    # 2. Verify VS Splash Screen
    app._launch_vs_and_battle(GameMode.VERSUS_CPU)
    app.vs_timer = 50
    app.render_canvas()
    if dump_dir:
        pygame.image.save(app.canvas, os.path.join(dump_dir, "03_vs_splash.png"))

    # 3. Verify 480-frame Live Combat Simulation + Action Slash + Super Cut-In!
    app.screen = ScreenState.BATTLE
    app.match.phase = RoundPhase.FIGHT
    app.match.p1.x = STAGE_CENTER_X - 88.0
    app.match.p2.x = STAGE_CENTER_X + 82.0
    app.match.p1.curse = 800
    app.match.p1.stylish.points = 2350.0
    app.match.p1.stylish._recalc_rank()
    app.match.p2.combo_count = 15
    app.match.p2.combo_damage = 4780

    empty_keys = [False] * 512
    t_sim0 = time.perf_counter()
    for fr in range(480):
        if fr == 40:
            app.match.p1.enter_state(FighterState.ATTACK_5H)
            app.match.p1.kf_idx = 8
            app.match.p2.enter_state(FighterState.HIT_STAND_HEAVY)
            app.match.p2.kf_idx = 4
            app.match.stage.spawn_water_ripple(app.match.p1.x, 1.3)
            app.match.stage.add_blood_splatter(app.match.p2.x, 1.3)
            app.match.vfx.spawn_hit_sparks_and_blood(
                app.match.p2.x - 16, GROUND_Y - 105, 1.0, AttackWeight.HEAVY, 1.4,
                PALETTES["CRIMSON_ORIGINAL"], app.match.stage, is_lethal=True,
            )
            app.render_canvas()
            if dump_dir:
                pygame.image.save(app.canvas, os.path.join(dump_dir, "04_battle_action_mockup_match.png"))
        elif fr == 180:
            app.match.p1.curse = 1000
            app.match.p1.enter_state(FighterState.SUPER_REQUIEM)
            app.match._trigger_super_if_needed(app.match.p1, FighterState.SUPER_REQUIEM)
        elif fr == 192:
            app.render_canvas()
            if dump_dir:
                pygame.image.save(app.canvas, os.path.join(dump_dir, "05_super_cutin_cg.png"))
        app.step_frame(empty_keys)
    t_sim = time.perf_counter() - t_sim0

    # 4. Verify Training Mode Lab
    app.match.start_new_mode(GameMode.TRAINING)
    app.match.p1.x = STAGE_CENTER_X - 74.0
    app.match.p2.x = STAGE_CENTER_X + 74.0
    app.match.p1.enter_state(FighterState.ATTACK_5M)
    for _ in range(9):
        app.match.tick(empty_keys)
    app.screen = ScreenState.BATTLE
    app.render_canvas()
    if dump_dir:
        pygame.image.save(app.canvas, os.path.join(dump_dir, "06_training_lab.png"))

    # 5. Verify Command Codex, Keyframe Gallery & Lore Archive
    app.screen = ScreenState.COMMAND_LIST
    app.render_canvas()
    if dump_dir:
        pygame.image.save(app.canvas, os.path.join(dump_dir, "07_command_codex.png"))

    app.screen = ScreenState.GALLERY
    app.gallery.tab = 0
    app.gallery.state_idx = app.gallery.states.index(FighterState.ATTACK_5H)
