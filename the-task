def _midi_hz(note: float) -> float:
    return 440.0 * (2.0 ** ((note - 69.0) / 12.0))


def _soft_clip(x: float) -> float:
    """Warm analog tape-style soft saturation limiting peaks cleanly."""
    if x > 1.35:
        return 0.96
    if x < -1.35:
        return -0.96
    x2 = x * x
    return x * (27.0 + x2) / (27.0 + 9.0 * x2)


@dataclass(frozen=True)
class BarSection:
    """
    A single 16-step musical bar specification inside a full-length OST score.
    Supports independent drum grooves, driving 16th-note acid/Reese basslines,
    hypnotic trance arpeggios, gothic cathedral organ/choir harmonies, soaring
    lead hooks, filter cutoff automation, and breakbeat fills!
    """
    bar_index: int
    section_name: str
    kick_steps: Tuple[int, ...]         # 0..15 (1=normal, 2=hard industrial)
    snare_steps: Tuple[int, ...]        # 0..15 (1=main, 2=ghost, 3=clap)
    hat_steps: Tuple[int, ...]          # 0..15 (1=closed, 2=open, 3=ride)
    perc_steps: Tuple[int, ...]         # 0..15 (1=anvil, 2=crash, 3=subdrop)
    bass_notes: Tuple[int, ...]         # 16 steps: MIDI note or 0=rest
    bass_accents: Tuple[int, ...]       # 16 steps: 0=norm, 1=accent, 2=slide
    arp_notes: Tuple[int, ...]          # 16 steps: MIDI note or 0=rest
    lead_notes: Tuple[int, ...]         # 16 steps: MIDI note or 0=rest
    pad_chord: Tuple[int, ...]          # Sustained gothic organ/choir triad
    cutoff_start: float                 # Acid SVF cutoff normalized 0.08..0.95
    cutoff_end: float
    resonance: float                    # 0.15..0.82
    energy: float                       # 0.2..1.0 mix intensity
    sidechain_depth: float              # 0.0..0.82 kick pumping


@dataclass(frozen=True)
class OSTComposition:
    track_id: OSTTrackId
    bpm: float
    key_name: str
    bars: Tuple[BarSection, ...]


class HyperBreakbeatDSP:
    """
    Pure-Python studio modular synthesizer engineered for hard, hypnotic
    high-BPM Techno & Breakbeat (Payday 2 Beta Assault / DMC3/4 dark-electro
    style) with zero aliasing, continuous bar-to-bar filter/delay state,
    velocity-layered percussion, and fast chunked background synthesis.
    """

    def __init__(self, sample_rate: int = AUDIO_SAMPLE_RATE) -> None:
        self.sr = sample_rate
        self.inv_sr = 1.0 / float(sample_rate)
        self.lut_n = 2048
        self.lut_mask = self.lut_n - 1

        self.wt_sin: List[float] = []
        self.wt_saw: List[float] = []
        self.wt_pulse: List[float] = []
        self.wt_acid: List[float] = []
        self.wt_organ: List[float] = []
        self.wt_choir: List[float] = []
        self._build_wavetables()

        # Pre-rendered studio Techno/Breakbeat drum one-shots
        self.d_kick: List[float] = []
        self.d_kick_hard: List[float] = []
        self.d_snare: List[float] = []
        self.d_snare_ghost: List[float] = []
        self.d_clap: List[float] = []
        self.d_hat_c: List[float] = []
        self.d_hat_o: List[float] = []
        self.d_ride: List[float] = []
        self.d_crash: List[float] = []
        self.d_anvil: List[float] = []
        self.d_subdrop: List[float] = []
        self._build_drums()

        # Persistent stereo ping-pong delay & multi-tap cathedral reverb state
        self._delay_len = int(self.sr * 0.375)
        self._dl_l = [0.0] * self._delay_len
        self._dl_r = [0.0] * self._delay_len
        self._dl_idx = 0

        # Persistent SVF & voice phase accumulators across bar boundaries
        self._reset_stream_state()

    def _reset_stream_state(self) -> None:
        self._bass_ph1 = 0.0
        self._bass_ph2 = 0.0
        self._bass_freq = _midi_hz(38)
        self._bass_svf_lp = 0.0
        self._bass_svf_bp = 0.0
        self._arp_ph = 0.0
        self._arp_svf_lp = 0.0
        self._arp_svf_bp = 0.0
        self._lead_ph1 = 0.0
        self._lead_ph2 = 0.0
        self._pad_phs = [0.0, 0.0, 0.0, 0.0]
        self._dl_idx = 0
        for i in range(self._delay_len):
            self._dl_l[i] = 0.0
            self._dl_r[i] = 0.0

    def _build_wavetables(self) -> None:
        n = self.lut_n
        sin_t = [math.sin(i * math.tau / n) for i in range(n)]
        self.wt_sin = sin_t
        saw_t = [0.0] * n
        pul_t = [0.0] * n
        acd_t = [0.0] * n
        org_t = [0.0] * n
        chr_t = [0.0] * n

        # Gibbs-smoothed additive synthesis prevents harsh aliasing!
        max_h = 20
        for h in range(1, max_h + 1):
            sig = math.sin(math.pi * h / (max_h + 1)) / (math.pi * h / (max_h + 1))
            a_saw = (2.0 / math.pi) * ((-1.0) ** (h + 1)) * (1.0 / h) * sig
            a_pul = ((4.0 / math.pi) * (1.0 / h) * sig) if (h % 2 == 1) else 0.0
            a_acd = a_saw * (1.28 if h in (1, 2, 3, 5, 7) else 0.72)
            a_org = {1: 0.54, 2: 0.44, 3: 0.28, 4: 0.25, 6: 0.16, 8: 0.11, 12: 0.06}.get(h, 0.0)
            a_chr = {1: 0.60, 2: 0.48, 3: 0.36, 4: 0.18, 5: 0.24, 7: 0.10}.get(h, 0.0)
            for i in range(n):
                s = sin_t[(i * h) & self.lut_mask]
                saw_t[i] += a_saw * s
                pul_t[i] += a_pul * s
                acd_t[i] += a_acd * s
                org_t[i] += a_org * s
                chr_t[i] += a_chr * s

        for tbl in (saw_t, pul_t, acd_t, org_t, chr_t):
            pk = max(1e-5, max(abs(v) for v in tbl))
            inv = 1.0 / pk
            for i in range(n):
                tbl[i] *= inv
        self.wt_saw = saw_t
        self.wt_pulse = pul_t
        self.wt_acid = acd_t
        self.wt_organ = org_t
        self.wt_choir = chr_t

    def _build_drums(self) -> None:
        sr = self.sr
        rng = random.Random(90909)

        # 1. Punchy 909 Club Kick
        n_k = int(sr * 0.26)
        ph = 0.0
        for i in range(n_k):
            t = i / float(sr)
            freq = 44.0 + 148.0 * math.exp(-t * 36.0)
            ph += freq * math.tau / sr
            click = math.exp(-t * 240.0) * math.sin(t * 2800.0) * 0.45
            body = math.sin(ph) * math.exp(-t * 10.5)
            self.d_kick.append(_soft_clip((body * 1.15 + click) * 1.15))

        # 2. Hard Industrial Assault Kick (Payday 2 Beta punch!)
        ph = 0.0
        for i in range(n_k):
            t = i / float(sr)
            freq = 40.0 + 185.0 * math.exp(-t * 42.0)
            ph += freq * math.tau / sr
            click = math.exp(-t * 180.0) * (rng.uniform(-1.0, 1.0) * 0.4 + math.sin(t * 3400.0) * 0.5)
            body = math.sin(ph) * math.exp(-t * 8.8)
            self.d_kick_hard.append(_soft_clip((body * 1.65 + click * 0.85) * 1.35))

        # 3. Crisp Chopped Breakbeat Snare (snappy crack + tight wire rattle)
        n_s = int(sr * 0.22)
        ph = 0.0
        hp_prev = 0.0
        for i in range(n_s):
            t = i / float(sr)
            f = 185.0 + 115.0 * math.exp(-t * 48.0)
            ph += f * math.tau / sr
            tone = math.sin(ph) * math.exp(-t * 22.0) * 0.72
            wn = rng.uniform(-1.0, 1.0)
            hp = wn - hp_prev * 0.72
            hp_prev = wn
            wires = hp * math.exp(-t * 17.5) * 0.85
            snap = math.exp(-t * 140.0) * 0.55 * wn
            self.d_snare.append(_soft_clip((tone + wires + snap) * 1.12))

        # 4. Breakbeat Ghost Snare
        n_sg = int(sr * 0.11)
        hp_prev = 0.0
        for i in range(n_sg):
            t = i / float(sr)
            wn = rng.uniform(-1.0, 1.0)
            hp = wn - hp_prev * 0.76
            hp_prev = wn
            v = (math.sin(t * 230.0 * math.tau) * 0.35 + hp * 0.65) * math.exp(-t * 34.0)
            self.d_snare_ghost.append(_soft_clip(v * 0.75))

        # 5. Gated Industrial Clap (3 staggered micro-bursts!)
        n_cl = int(sr * 0.21)
        lp_s = 0.0
        for i in range(n_cl):
            t = i / float(sr)
            burst = (
                math.exp(-((t - 0.000) * 210.0) ** 2)
                + 0.9 * math.exp(-((t - 0.011) * 210.0) ** 2)
                + 0.85 * math.exp(-((t - 0.022) * 190.0) ** 2)
                + 0.68 * (math.exp(-(t - 0.024) * 18.0) if t > 0.024 else 0.0)
            )
            wn = rng.uniform(-1.0, 1.0)
            lp_s = lp_s * 0.58 + wn * 0.42
            bp = wn - lp_s * 0.65
            self.d_clap.append(_soft_clip(bp * burst * 0.95))

        # 6. Metallic TR-808 Closed & Open Hi-Hats
        hat_ratios = (312.0, 468.0, 594.0, 742.0, 916.0, 1188.0)
        for is_open, dur, decay, target in (
            (False, 0.065, 62.0, self.d_hat_c),
            (True, 0.24, 12.5, self.d_hat_o),
        ):
            nh = int(sr * dur)
            prev = 0.0
            for i in range(nh):
                t = i / float(sr)
                metal = 0.0
                for fr in hat_ratios:
                    metal += 1.0 if math.sin(t * fr * math.tau) > 0.0 else -1.0
                raw = (metal / 6.0) * 0.52 + rng.uniform(-1.0, 1.0) * 0.48
                hp = raw - prev * 0.84
                prev = raw
                target.append(_soft_clip(hp * math.exp(-t * decay) * (0.48 if is_open else 0.44)))

        # 7. Crisp Techno Ride
        n_rd = int(sr * 0.28)
        prev = 0.0
        for i in range(n_rd):
            t = i / float(sr)
            bell = math.sin(t * 2840.0 * math.tau) * 0.32 + math.sin(t * 4390.0 * math.tau) * 0.24
            wn = rng.uniform(-1.0, 1.0)
            hp = wn - prev * 0.86
            prev = wn
            self.d_ride.append(_soft_clip((bell + hp * 0.55) * math.exp(-t * 10.5) * 0.52))

        # 8. Swept Noise Crash Cymbal
        n_cr = int(sr * 0.68)
        prev = 0.0
        for i in range(n_cr):
            t = i / float(sr)
            wn = rng.uniform(-1.0, 1.0)
            hp = wn - prev * 0.80
            prev = wn
            shimmer = math.sin(t * 3620.0 * math.tau) * 0.16 + math.sin(t * 5410.0 * math.tau) * 0.12
            self.d_crash.append(_soft_clip((hp * 0.78 + shimmer) * math.exp(-t * 4.2) * 0.62))

        # 9. Industrial Metallic Anvil Clang (Payday 2 / Gothic steel percussion!)
        n_an = int(sr * 0.32)
        for i in range(n_an):
            t = i / float(sr)
            v = (
                math.sin(t * 622.0 * math.tau) * 0.40
                + math.sin(t * 1492.0 * math.tau) * 0.34
                + math.sin(t * 2318.0 * math.tau) * 0.26
                + math.sin(t * 3784.0 * math.tau) * 0.18
            ) * math.exp(-t * 11.5)
            self.d_anvil.append(_soft_clip(v * 0.85))

        # 10. Cinematic Sub-Bass Drop
        n_sd = int(sr * 0.62)
        ph = 0.0
        for i in range(n_sd):
            t = i / float(sr)
            f = 34.0 + 78.0 * math.exp(-t * 4.5)
            ph += f * math.tau / sr
            self.d_subdrop.append(_soft_clip(math.sin(ph) * math.exp(-t * 3.2) * 1.1))

    def render_bar_pcm(self, bar: BarSection, bpm: float) -> bytes:
        """
        Synthesize 1 complete stereo 16-bit PCM bar with zero clicks,
        continuous SVF & ping-pong delay state, kick sidechain pumping,
        breakbeat drums, TB-303 acid/Reese bass, trance arp, gothic organ/choir
        pads, and lead melody!
        """
        sr = self.sr
        inv_sr = self.inv_sr
        lut_n = self.lut_n
        lut_mask = self.lut_mask
        wt_saw = self.wt_saw
        wt_acid = self.wt_acid
        wt_pulse = self.wt_pulse
        wt_organ = self.wt_organ
        wt_choir = self.wt_choir

        sec_per_step = 60.0 / (bpm * 4.0)
        step_samples = max(256, int(round(sec_per_step * sr)))
        total_samples = step_samples * 16

        mix_l = [0.0] * total_samples
        mix_r = [0.0] * total_samples
        sidechain_env = [1.0] * total_samples

        # 1. Layer Velocity-Weighted Breakbeat & Techno Drums + Kick Sidechain Envelope
        def add_drum(buf: List[float], start: int, gain_l: float, gain_r: float) -> None:
            end = min(total_samples, start + len(buf))
            for idx in range(start, end):
                v = buf[idx - start]
                mix_l[idx] += v * gain_l
                mix_r[idx] += v * gain_r

        sc_len = int(sr * 0.16)
        sc_depth = bar.sidechain_depth
        for st in range(16):
            pos = st * step_samples
            k_type = bar.kick_steps[st]
            if k_type == 1:
                add_drum(self.d_kick, pos, 0.72, 0.72)
            elif k_type == 2:
                add_drum(self.d_kick_hard, pos, 0.84, 0.84)
            if k_type > 0 and sc_depth > 0.02:
                sc_end = min(total_samples, pos + sc_len)
                inv_sc = 1.0 / float(max(1, sc_len))
                for idx in range(pos, sc_end):
                    u = (idx - pos) * inv_sc
                    duck = 1.0 - sc_depth * ((1.0 - u) ** 1.75)
                    if duck < sidechain_env[idx]:
                        sidechain_env[idx] = duck

            sn_type = bar.snare_steps[st]
            if sn_type == 1:
                add_drum(self.d_snare, pos, 0.64, 0.62)
            elif sn_type == 2:
                add_drum(self.d_snare_ghost, pos, 0.34, 0.42)
            elif sn_type == 3:
                add_drum(self.d_clap, pos, 0.52, 0.58)

            h_type = bar.hat_steps[st]
            if h_type == 1:
                add_drum(self.d_hat_c, pos, 0.30, 0.38)
            elif h_type == 2:
                add_drum(self.d_hat_o, pos, 0.38, 0.30)
            elif h_type == 3:
                add_drum(self.d_ride, pos, 0.40, 0.34)

            p_type = bar.perc_steps[st]
            if p_type == 1:
                add_drum(self.d_anvil, pos, 0.44, 0.28)
            elif p_type == 2:
                add_drum(self.d_crash, pos, 0.46, 0.48)
            elif p_type == 3:
                add_drum(self.d_subdrop, pos, 0.68, 0.68)

        # 2. Driving TB-303 Acid + Detuned Reese Sub-Bass (Chamberlin 2-pole Resonant SVF!)
        b_ph1 = self._bass_ph1
        b_ph2 = self._bass_ph2
        b_freq = self._bass_freq
        b_lp = self._bass_svf_lp
        b_bp = self._bass_svf_bp
        q_damp = clamp(1.15 - bar.resonance * 1.05, 0.16, 1.0)
        energy = bar.energy

        # 3. Trance Arp + Gothic Organ/Choir Pad + Screaming Lead Synth
        a_ph = self._arp_ph
        a_lp = self._arp_svf_lp
        a_bp = self._arp_svf_bp
        l_ph1 = self._lead_ph1
        l_ph2 = self._lead_ph2
        pad_freqs = [_midi_hz(n) for n in bar.pad_chord[:4]]
        pad_phs = self._pad_phs
        n_pad = len(pad_freqs)

        # Stereo Ping-Pong Delay state
        dl_l = self._dl_l
        dl_r = self._dl_r
        dl_len = self._delay_len
        dl_idx = self._dl_idx

        for st in range(16):
            st_start = st * step_samples
            st_end = st_start + step_samples
            bar_u = st / 16.0
            base_cut = lerp(bar.cutoff_start, bar.cutoff_end, bar_u)

            b_note = bar.bass_notes[st]
            b_acc = bar.bass_accents[st]
            b_target_f = _midi_hz(b_note) if b_note > 0 else b_freq
            if b_note > 0 and b_acc != 2:
                b_freq = b_target_f

            a_note = bar.arp_notes[st]
            a_freq = _midi_hz(a_note) if a_note > 0 else 0.0

            l_note = bar.lead_notes[st]
            l_freq = _midi_hz(l_note) if l_note > 0 else 0.0

            inv_st = 1.0 / float(step_samples)
            for idx in range(st_start, st_end):
                u = (idx - st_start) * inv_st
                sc = sidechain_env[idx]
                dry_l = 0.0
                dry_r = 0.0
                wet_send = 0.0

                # --- Acid / Reese Bass Voice ---
                if b_note > 0:
                    if b_acc == 2:
                        b_freq += (b_target_f - b_freq) * 0.008
                    b_ph1 = (b_ph1 + b_freq * inv_sr * lut_n) % lut_n
                    b_ph2 = (b_ph2 + b_freq * 1.0055 * inv_sr * lut_n) % lut_n
                    raw_b = (wt_acid[int(b_ph1) & lut_mask] * 0.65 + wt_saw[int(b_ph2) & lut_mask] * 0.35)
                    env_b = (1.0 - u * 0.62) * (1.25 if b_acc == 1 else 0.92)
                    cut_env = clamp(base_cut + (0.42 if b_acc == 1 else 0.24) * math.exp(-u * 6.5), 0.05, 0.88)
                    f_coef = min(0.85, 2.0 * math.sin(math.pi * cut_env * 0.38))
                    b_hp = raw_b - b_lp - q_damp * b_bp
                    b_bp += f_coef * b_hp
                    b_lp += f_coef * b_bp
                    b_out = _soft_clip((b_lp * 0.82 + b_bp * 0.32) * env_b * 1.18) * 0.42 * sc * energy
                    dry_l += b_out
                    dry_r += b_out

                # --- Hypnotic 16th-Note Gothic Acid Trance Arp ---
                if a_freq > 0.0:
                    a_ph = (a_ph + a_freq * inv_sr * lut_n) % lut_n
                    raw_a = wt_pulse[int(a_ph) & lut_mask] * 0.55 + wt_saw[int(a_ph * 2.0) & lut_mask] * 0.45
                    env_a = math.exp(-u * 5.2)
                    af = clamp(0.18 + base_cut * 0.55 + 0.26 * env_a, 0.08, 0.82)
                    a_hp = raw_a - a_lp - 0.52 * a_bp
                    a_bp += af * a_hp
                    a_lp += af * a_bp
                    a_out = a_lp * env_a * 0.24 * sc * energy
                    pan_l = 0.68 if (st % 2 == 0) else 0.32
                    dry_l += a_out * pan_l
                    dry_r += a_out * (1.0 - pan_l)
                    wet_send += a_out * 0.55

                # --- Soaring Gothic Dark-Electro Lead ---
                if l_freq > 0.0:
                    l_ph1 = (l_ph1 + l_freq * inv_sr * lut_n) % lut_n
                    l_ph2 = (l_ph2 + l_freq * 1.007 * inv_sr * lut_n) % lut_n
                    raw_l = (wt_saw[int(l_ph1) & lut_mask] + wt_pulse[int(l_ph2) & lut_mask]) * 0.5
                    env_l = min(1.0, u * 18.0) * (1.0 - u * 0.35)
                    l_out = _soft_clip(raw_l * 1.15) * env_l * 0.24 * (0.35 + 0.65 * sc) * energy
                    dry_l += l_out * 0.54
                    dry_r += l_out * 0.46
                    wet_send += l_out * 0.62

                # --- Atmospheric Cathedral Pipe Organ & Dark Choir Harmony ---
                if n_pad > 0:
                    p_sum = 0.0
                    for pi in range(n_pad):
                        pph = (pad_phs[pi] + pad_freqs[pi] * inv_sr * lut_n) % lut_n
                        pad_phs[pi] = pph
                        idx_p = int(pph) & lut_mask
                        p_sum += wt_choir[idx_p] * 0.56 + wt_organ[idx_p] * 0.44
                    p_out = (p_sum / float(n_pad)) * 0.19 * sc * (0.45 + 0.55 * energy)
                    dry_l += p_out * 0.52
                    dry_r += p_out * 0.48
                    wet_send += p_out * 0.28

                # Stereo Ping-Pong Delay Feedback (gives wide trance space!)
                d_out_l = dl_l[dl_idx]
                d_out_r = dl_r[dl_idx]
                dl_l[dl_idx] = _soft_clip(wet_send * 0.72 + d_out_r * 0.42)
                dl_r[dl_idx] = _soft_clip(d_out_l * 0.44)
                dl_idx += 1
                if dl_idx >= dl_len:
                    dl_idx = 0

                mix_l[idx] += dry_l + d_out_l * 0.36
                mix_r[idx] += dry_r + d_out_r * 0.36

        # Save persistent DSP state for seamless next-bar continuity
        self._bass_ph1 = b_ph1
        self._bass_ph2 = b_ph2
        self._bass_freq = b_freq
        self._bass_svf_lp = b_lp
        self._bass_svf_bp = b_bp
        self._arp_ph = a_ph
        self._arp_svf_lp = a_lp
        self._arp_svf_bp = a_bp
        self._lead_ph1 = l_ph1
        self._lead_ph2 = l_ph2
        self._dl_idx = dl_idx

        # Pack stereo 16-bit signed PCM with warm master limiter
        pcm = array.array("h")
        pcm_extend = pcm.append
        for i in range(total_samples):
            sl = int(_soft_clip(mix_l[i] * 0.86) * 30800.0)
            sr_v = int(_soft_clip(mix_r[i] * 0.86) * 30800.0)
            pcm_extend(sl)
            pcm_extend(sr_v)
        return pcm.tobytes()

