    def _edit_schedule_recompute(self) -> None:
        self._edit_preview_timer.start()

    def _edit_recompute_now(self) -> None:
        if self.edit_base is None or self.edit_base.isNull():
            return
        mask = None
        if self.edit_scope_mask.isChecked() or self.edit_scope_unmask.isChecked():
            mask = self.edit_canvas.effective_mask()
        preview, skipped = apply_edit_pipeline(
            self.edit_base, self.edit_adjust,
            mask=mask,
            invert_mask=self.edit_scope_unmask.isChecked(),
            max_side=960,
            lut_key=self.edit_lut_key,
            lut_intensity=self.edit_lut_intensity,
            flares=self.edit_flares,
        )
        if skipped and not self._edit_skipped_effects:
            self._edit_skipped_effects = list(skipped)
            STUDIO_LOG.warn("SYS", "Edit effects skipped (install Pillow): " + ", ".join(sorted(set(skipped))))
        self.edit_canvas.set_display(preview)
        self._update_edit_buttons()

    def _update_edit_buttons(self) -> None:
        has_doc = self.edit_base is not None and not self.edit_base.isNull()
        has_mask = self.edit_canvas.has_mask()
        self.edit_save_btn.setEnabled(has_doc)
        self.edit_inpaint_btn.setEnabled(has_doc and has_mask)
        self.edit_split_save_btn.setEnabled(has_doc)
        grade_active = (
            edit_adjustments_active(self.edit_adjust)
            or (bool(self.edit_lut_key) and self.edit_lut_intensity > 0)
            or bool(self.edit_flares)
            or self.edit_canvas.has_paint()
        )
        self.edit_apply_btn.setEnabled(
            has_doc and (self.edit_canvas.has_paint() or (grade_active and (self.edit_scope_full.isChecked() or has_mask)))
        )
        self.edit_compare_btn.setEnabled(has_doc)
        if hasattr(self, "edit_split_cmp_btn"):
            self.edit_split_cmp_btn.setEnabled(has_doc)

