    def _remove_lora_by_uid(self, uid: str) -> None:
        stack = self._browsed_lora_stack()
        for i, entry in enumerate(stack):
            if entry.get("uid") == uid:
                stack.pop(i)
                break
        save_lora_library(self.lora_lib)
        self._rebuild_lora_ui()

    def _duplicate_lora_by_uid(self, uid: str) -> None:
        stack = self._browsed_lora_stack()
        for i, entry in enumerate(stack):
            if entry.get("uid") == uid:
                clone = copy.deepcopy(entry)
                clone["uid"] = secrets.token_hex(6)
                clone["name"] = (clone.get("name") or "LoRA") + " (copy)"
                stack.insert(i + 1, clone)
                break
        save_lora_library(self.lora_lib)
        self._rebuild_lora_ui()

    def _lookup_lora_by_uid(self, uid: str) -> None:
        entry = self._find_lora_by_uid(uid)
        if entry is None:
            return
        ident = str(entry.get("id") or "").strip()
        if not ident:
            self.lora_status.setText("This entry has no Civitai ID to look up.")
            return
        self.lora_status.setText(f"Querying Civitai for {ident}\u2026")

        def _done(info: Dict[str, Any]) -> None:
            if info.get("name"):
                entry["name"] = str(info["name"])
            words = [str(w).strip() for w in (info.get("trained_words") or []) if str(w).strip()]
            if words:
                joined = ", ".join(words)
                if not any(t.get("text") == joined for t in entry.get("triggers") or []):
                    entry.setdefault("triggers", []).append({"label": "Civitai All", "text": joined})
            self.lora_status.setText(
                f"Found: {info.get('name', '?')}  (Base: {info.get('base') or '?'}, {len(words)} trigger word(s))"
            )
            save_lora_library(self.lora_lib)
            self._rebuild_lora_ui()

        def _err(msg: str) -> None:
            self.lora_status.setText(f"Lookup error: {msg}")

        self._run_task(lambda: self.api.civitai_lookup(ident, bool(entry.get("is_version"))), _done, _err)

