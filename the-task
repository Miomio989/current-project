    def _draw_head_and_face(
        self,
        surf: pygame.Surface,
        kf: PoseKeyframe,
        proj: Dict[str, Vec2],
        pscale: Dict[str, float],
        pal: CeciliaPalette,
        resonance_active: bool,
    ) -> None:
        """Render Cecilia's multi-angle anime head: neck, porcelain chin/cheek
        silhouette adapting smoothly across front/3-4/profile/back turns,
        vibrant golden-yellow eyes, noble expression, glossy black parted bangs,
        and cute face-framing sidelocks.
        """
        neck = proj["neck"]
        hc = proj["head"]
        s = pscale["head"]
        yaw = kf.head_yaw
        yaw_r = math.radians(yaw)
        roll_r = math.radians(kf.head_roll)
        facing_z = math.cos(yaw_r)  # +1 front, 0 profile, -1 turned away
        side_x = math.sin(yaw_r)    # >0 looking right, <0 looking left

        def local_pt(lx: float, ly: float) -> Vec2:
            cr, sr = math.cos(roll_r), math.sin(roll_r)
            rx = (lx * cr - ly * sr) * s
            ry = (lx * sr + ly * cr) * s
            return Vec2(hc.x + rx, hc.y + ry)

        # Graceful slender porcelain neck
        self.rast.draw_shaded_capsule(
            surf,
            neck + Vec2(0.0, 2.0 * s),
            local_pt(0.0, 9.0),
            r_a=5.2 * s,
            r_b=4.8 * s,
            shadow_col=pal.skin_shadow,
            base_col=pal.skin_base,
            light_col=pal.skin_light,
            outline_col=pal.ink_warm,
            outline_width=1,
        )

        # Back hair skull crown mass (gives head full 3D anime volume)
        skull_pts: List[Tuple[float, float]] = []
        for k in range(14):
            a = (math.tau * k) / 14.0
            rx = 16.5 - abs(side_x) * 1.4
            ry = 17.2
            p = local_pt(math.cos(a) * rx - side_x * 2.5, math.sin(a) * ry - 2.0)
            skull_pts.append((p.x, p.y))
        self.rast.fill_shaded_poly(
            surf,
            skull_pts,
            pal.hair_deep,
            pal.hair_base,
            pal.hair_mid,
            rim_col=pal.hair_rim,
            outline_col=pal.ink_dark,
            outline_width=2,
            horizontal_grad=True,
            cylindrical=True,
        )

        # Only draw face & eyes when head is not completely turned away (>115 deg)
        if facing_z > -0.35:
            # Anatomically cute V-tapered anime face contour adapting smoothly to yaw!
            nose_protrude = side_x * 3.8 * (1.0 - max(0.0, facing_z) * 0.65)
            chin_x = side_x * 5.2
            face_local = [
                (-12.5 + side_x * 2.0, -7.0),
                (12.5 + side_x * 2.0, -7.0),
                (13.2 + side_x * 3.2 + nose_protrude, 2.0),
                (9.2 + side_x * 4.6, 11.2),
                (chin_x, 16.4),
                (-9.2 + side_x * 2.5, 11.2),
                (-13.2 + side_x * 1.4, 2.0),
            ]
            face_pts = [local_pt(lx, ly).to_tuple() for (lx, ly) in face_local]
            self.rast.fill_shaded_poly(
                surf,
                face_pts,
                pal.skin_shadow,
                pal.skin_base,
                pal.skin_light,
                outline_col=pal.ink_warm,
                outline_width=1,
                horizontal_grad=True,
                cylindrical=True,
            )

            # Soft anime blush tint beneath cheeks
            blush_surf = pygame.Surface(surf.get_size(), pygame.SRCALPHA)
            for b_side in (-1.0, 1.0):
                bx_l = side_x * 6.5 + b_side * (7.2 * max(0.35, facing_z))
                bp = local_pt(bx_l, 5.2)
                pygame.draw.ellipse(
                    blush_surf,
                    with_alpha(pal.skin_blush, 55),
                    pygame.Rect(int(bp.x - 3.2 * s), int(bp.y - 1.6 * s), max(3, int(6.4 * s)), max(2, int(3.2 * s))),
                )
            surf.blit(blush_surf, (0, 0))

            # Facial expression parameters
            expr = kf.expression
            eye_open = 1.0
            fierce = 0.0
            mouth_open = 0.0
            smirk = 0.0
            if expr == ExpressionId.SERENE_NOBLE:
                eye_open, fierce, smirk = 0.92, 0.08, 0.25
            elif expr == ExpressionId.FOCUSED_GLARE:
                eye_open, fierce, smirk = 0.84, 0.55, 0.0
            elif expr == ExpressionId.BOLD_SMIRK:
                eye_open, fierce, smirk = 0.88, 0.35, 0.85
            elif expr == ExpressionId.FIERCE_STRIKE:
                eye_open, fierce, mouth_open = 0.96, 0.88, 0.72
            elif expr == ExpressionId.GRITTED_PAIN:
                eye_open, fierce, mouth_open = 0.42, 0.75, 0.48
            elif expr == ExpressionId.ECSTATIC_TRANCE:
                eye_open, fierce, smirk, mouth_open = 1.06, 0.48, 0.95, 0.38
            elif expr in (ExpressionId.CLOSED_EYES_CALM, ExpressionId.PARRY_ZEN):
                eye_open, fierce, smirk = 0.12, 0.15, 0.30

            # Vibrant golden-yellow anime eyes positioned according to head yaw perspective
            eye_y_l = 0.8
            gaze = Vec2(kf.gaze_x, kf.gaze_y)
            glow_eyes = kf.eye_glow or resonance_active or expr == ExpressionId.ECSTATIC_TRANCE
            eye_sep = 6.4 * clamp(facing_z, 0.22, 1.0)
            eye_center_x = side_x * 6.8

            # Far eye (narrowed by perspective, hidden on deep profile)
            if facing_z > 0.26:
                far_sign = -1.0 if side_x >= 0.0 else 1.0
                far_pos = local_pt(eye_center_x + far_sign * eye_sep, eye_y_l)
                far_w = 6.2 * s * clamp(facing_z * 1.15, 0.45, 1.0)
                self.rast.draw_anime_golden_eye(
                    surf,
                    far_pos,
                    width=far_w,
                    height=5.6 * s,
                    pal=pal,
                    facing_sign=far_sign,
                    gaze_offset=gaze,
                    openness=eye_open,
                    fierce=fierce,
                    glowing=glow_eyes,
                )

            # Near eye (full expressive anime golden eye)
            near_sign = 1.0 if side_x >= 0.0 else -1.0
            near_pos = local_pt(eye_center_x + near_sign * eye_sep * 0.78, eye_y_l)
            near_w = 6.8 * s * (0.82 if facing_z < 0.35 else 1.0)
            self.rast.draw_anime_golden_eye(
                surf,
                near_pos,
                width=near_w,
                height=5.8 * s,
                pal=pal,
                facing_sign=near_sign,
                gaze_offset=gaze,
                openness=eye_open,
                fierce=fierce,
                glowing=glow_eyes,
            )

            # Delicate anime nose dot / profile bridge
            nose_p = local_pt(side_x * 8.4, 5.2)
            pygame.draw.circle(surf, pal.skin_shadow, nose_p.to_int(), max(1, int(1.1 * s)))

            # Expressive noble mouth
            m_c = local_pt(side_x * 6.6, 10.6)
            if mouth_open > 0.25:
                mw = 3.2 * s * (0.7 + 0.5 * mouth_open)
                mh = 2.8 * s * mouth_open
