                    self.audio.play_sfx(SFXId.UI_MOVE)
            elif self.match.mode == GameMode.COMBO_TRIALS:
                if key == pygame.K_F1:
                    self.match.reset_training_positions()
                elif key == pygame.K_q:
                    self.match.active_trial_idx = (self.match.active_trial_idx - 1) % len(COMBO_TRIALS)
                    self.match.reset_training_positions()
                    self.audio.play_sfx(SFXId.UI_MOVE)
                elif key == pygame.K_e:
                    self.match.active_trial_idx = (self.match.active_trial_idx + 1) % len(COMBO_TRIALS)
                    self.match.reset_training_positions()
                    self.audio.play_sfx(SFXId.UI_MOVE)

        elif self.screen == ScreenState.PAUSE:
            if key in (pygame.K_UP, pygame.K_w):
                self.pause_cursor = (self.pause_cursor - 1) % 4
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_DOWN, pygame.K_s):
                self.pause_cursor = (self.pause_cursor + 1) % 4
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key == pygame.K_ESCAPE:
                self.screen = ScreenState.BATTLE
            elif key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_u):
                self.audio.play_sfx(SFXId.UI_CONFIRM)
                if self.pause_cursor == 0:
                    self.screen = ScreenState.BATTLE
                elif self.pause_cursor == 1:
                    self.screen = ScreenState.MOVE_LIST
                elif self.pause_cursor == 2:
                    self.match.start_match(self.match.mode, self.p1_pal_idx, self.p2_pal_idx, self.match.arcade_stage_idx)
                    self.screen = ScreenState.BATTLE
                else:
                    self.audio.play_ost(OSTTrackId.SANCTUM_OF_ASH)
                    self.screen = ScreenState.MAIN_MENU

        elif self.screen == ScreenState.MATCH_RESULT:
            if key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_u):
                self.audio.play_sfx(SFXId.UI_CONFIRM)
                if self.match.mode == GameMode.ARCADE and self.match.winner_slot == 0:
                    if self.match.arcade_stage_idx + 1 < len(ARCADE_RIVALS):
                        self.match.start_match(GameMode.ARCADE, self.p1_pal_idx, self.p2_pal_idx, self.match.arcade_stage_idx + 1)
                        self.vs_timer = 2.0
                        self.screen = ScreenState.VS_SPLASH
                    else:
                        self.audio.play_ost(OSTTrackId.CRIMSON_REQUIEM)
                        self.screen = ScreenState.ARCADE_ENDING
                elif self.match.mode == GameMode.SURVIVAL and self.match.winner_slot == 0:
                    self.match.survival_wave += 1
                    carry_hp = min(MAX_HEALTH, self.match.p1.hp + 2600 + self.match.p1.style.peak_rank.value[1] * 450)
                    self.match.start_match(GameMode.SURVIVAL, self.p1_pal_idx, self.p2_pal_idx)
                    self.match.p1.hp = carry_hp
                    self.match.p1.hp_trail = float(carry_hp)
