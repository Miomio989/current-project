class ModularAudioDSP:
    """
    Pure-Python studio-grade modular synthesizer & DSP effects engine.

    Features band-limited additive wavetables, Chamberlin State-Variable
    resonant filters, velocity-layered Techno/Breakbeat drums, sidechain
    pumping, stereo ping-pong delay, multi-tap cathedral reverb, and a
    brickwall soft limiter — engineered for fast real-time background streaming.
    """

    def __init__(self, sample_rate: int = AUDIO_SAMPLE_RATE) -> None:
        self.sr = sample_rate
        self.inv_sr = 1.0 / float(sample_rate)
        self.lut_n = 2048
        self.lut_mask = self.lut_n - 1

        # Pre-computed band-limited wavetables (zero ugly aliasing!)
        self.wt_sin: List[float] = []
        self.wt_saw: List[float] = []
        self.wt_sq: List[float] = []
        self.wt_acid: List[float] = []
        self.wt_organ: List[float] = []
        self.wt_choir: List[float] = []
        self._build_wavetables()

        # Pre-rendered velocity-layered Techno / Breakbeat percussion samples
        self.drum_kick: List[float] = []
        self.drum_kick_hard: List[float] = []
        self.drum_snare: List[float] = []
        self.drum_snare_ghost: List[float] = []
        self.drum_clap: List[float] = []
        self.drum_hat_c: List[float] = []
        self.drum_hat_o: List[float] = []
        self.drum_ride: List[float] = []
        self.drum_crash: List[float] = []
        self.drum_anvil: List[float] = []
        self.drum_subdrop: List[float] = []
        self._build_drum_kit()

    def _build_wavetables(self) -> None:
        n = self.lut_n
        sin_t = [math.sin(i * math.tau / n) for i in range(n)]
        self.wt_sin = sin_t

        saw_t = [0.0] * n
        sq_t = [0.0] * n
        acid_t = [0.0] * n
        org_t = [0.0] * n
        choir_t = [0.0] * n

        # Additive synthesis with Gibbs-smoothed spectral rolloff (clean warm analog tone!)
        max_h = 18
        for h in range(1, max_h + 1):
            sigma = math.sin(math.pi * h / (max_h + 1)) / (math.pi * h / (max_h + 1))
            amp_saw = (2.0 / math.pi) * ((-1.0) ** (h + 1)) * (1.0 / h) * sigma
            amp_sq = ((4.0 / math.pi) * (1.0 / h) * sigma) if (h % 2 == 1) else 0.0
            # Gothic pipe-organ harmonic drawbars (16' + 8' + 4' + 2 2/3' + 2' + brilliance)
            org_w = {1: 0.55, 2: 0.42, 3: 0.28, 4: 0.24, 6: 0.14, 8: 0.10}.get(h, 0.0)
            # Dark cathedral choir vowel "Ooh/Aah" formant envelope peaks around harmonics 1, 2, 3, 5
            ch_w = {1: 0.62, 2: 0.45, 3: 0.34, 4: 0.16, 5: 0.22, 7: 0.08}.get(h, 0.0)
            for i in range(n):
                s = sin_t[(i * h) & self.lut_mask]
                saw_t[i] += s * amp_saw
                if amp_sq != 0.0:
                    sq_t[i] += s * amp_sq
                if org_w > 0.0:
                    org_t[i] += s * org_w
                if ch_w > 0.0:
                    choir_t[i] += s * ch_w

        # Acid-303 hybrid waveform (70% warm saw + 30% punchy sub-square)
        for i in range(n):
            acid_t[i] = saw_t[i] * 0.72 + sq_t[i] * 0.34

        def normalize(tbl: List[float]) -> List[float]:
            pk = max(1e-5, max(abs(v) for v in tbl))
            return [v / pk for v in tbl]

        self.wt_saw = normalize(saw_t)
        self.wt_sq = normalize(sq_t)
        self.wt_acid = normalize(acid_t)
        self.wt_organ = normalize(org_t)
        self.wt_choir = normalize(choir_t)

    def _build_drum_kit(self) -> None:
        sr = self.sr
        inv_sr = self.inv_sr
        rng = random.Random(303909)

        # 1. Punchy 909/Techno Kick (deep pitch-swept sub + crisp transient beater click)
        def make_kick(dur_s: float, f_hi: float, f_lo: float, drive: float) -> List[float]:
            n = int(sr * dur_s)
            out = [0.0] * n
            ph = 0.0
            for i in range(n):
                t = i * inv_sr
                freq = f_lo + (f_hi - f_lo) * math.exp(-t * 36.0)
                ph += freq * inv_sr * math.tau
                env = math.exp(-t * 9.8) * (1.0 - math.exp(-t * 620.0))
                click = math.sin(t * 2800.0) * math.exp(-t * 210.0) * 0.45
                out[i] = _soft_sat((math.sin(ph) * env + click) * drive)
            return out

        self.drum_kick = make_kick(0.24, 185.0, 44.0, 1.35)
        self.drum_kick_hard = make_kick(0.27, 225.0, 40.0, 1.75)

        # 2. Crisp Breakbeat Snare (woody pitched shell + snappy bandpass wire rattle)
        def make_snare(dur_s: float, body_f: float, noise_mix: float) -> List[float]:
            n = int(sr * dur_s)
            out = [0.0] * n
            ph = 0.0
            lp = 0.0
            hp_prev = 0.0
            for i in range(n):
                t = i * inv_sr
                freq = body_f * (0.65 + 0.35 * math.exp(-t * 48.0))
                ph += freq * inv_sr * math.tau
                body = math.sin(ph) * math.exp(-t * 24.0) * 0.65
                w = rng.uniform(-1.0, 1.0)
                hp = w - 0.72 * hp_prev
                hp_prev = w
                lp += 0.38 * (hp - lp)
                wires = lp * math.exp(-t * 15.5) * noise_mix
                snap = math.sin(t * 1650.0) * math.exp(-t * 140.0) * 0.32
                out[i] = _soft_sat((body + wires + snap) * 1.25)
            return out

        self.drum_snare = make_snare(0.21, 205.0, 0.92)
        self.drum_snare_ghost = make_snare(0.11, 225.0, 0.56)

        # 3. Layered Industrial Techno Clap (triple micro-flam burst + wide crack)
        n_cl = int(sr * 0.22)
        clap = [0.0] * n_cl
        prev = 0.0
        for i in range(n_cl):
            t = i * inv_sr
            flam = (
                math.exp(-((t - 0.000) * 190.0) ** 2)
                + math.exp(-((t - 0.011) * 190.0) ** 2)
                + math.exp(-((t - 0.022) * 160.0) ** 2)
            ) * 0.7 + math.exp(-max(0.0, t - 0.022) * 19.0) * (1.0 if t > 0.020 else 0.0) * 0.65
            w = rng.uniform(-1.0, 1.0)
            bp = w - 0.85 * prev
            prev = w
            clap[i] = _soft_sat(bp * flam * 0.95)
        self.drum_clap = clap

        # 4. Metallic 909 / Breakbeat Closed & Open Hi-Hats + Ride + Crash
        def make_metallic(dur_s: float, decay: float, bright: float) -> List[float]:
            n = int(sr * dur_s)
            out = [0.0] * n
            freqs = (317.0, 463.0, 587.0, 811.0, 1123.0, 1549.0)
            prev_n = 0.0
            for i in range(n):
                t = i * inv_sr
                env = math.exp(-t * decay)
                metal = 0.0
                for fr in freqs:
                    metal += 1.0 if math.sin(t * fr * math.tau) > 0.0 else -1.0
                metal *= 0.12
                w = rng.uniform(-1.0, 1.0)
                hp = w - 0.88 * prev_n
                prev_n = w
                out[i] = _soft_sat((metal * 0.45 + hp * bright) * env * 0.85)
            return out

        self.drum_hat_c = make_metallic(0.055, 58.0, 0.72)
        self.drum_hat_o = make_metallic(0.24, 10.5, 0.78)
        self.drum_ride = make_metallic(0.32, 7.5, 0.55)
        self.drum_crash = make_metallic(0.85, 3.2, 0.88)

        # 5. Industrial Metallic Anvil Clang (signature gothic-techno accent!)
        n_anv = int(sr * 0.36)
        anv = [0.0] * n_anv
        for i in range(n_anv):
            t = i * inv_sr
            s = (
                math.sin(t * 782.0 * math.tau) * 0.45
                + math.sin(t * 1196.0 * math.tau) * 0.35
                + math.sin(t * 2145.0 * math.tau) * 0.25
                + math.sin(t * 3420.0 * math.tau) * 0.15
            )
            anv[i] = _soft_sat(s * math.exp(-t * 11.0) * 1.1)
        self.drum_anvil = anv

        # 6. Cinematic Assault Sub-Drop Boom
        n_sd = int(sr * 0.75)
        sd = [0.0] * n_sd
        ph = 0.0
        for i in range(n_sd):
            t = i * inv_sr
            f = 32.0 + 78.0 * math.exp(-t * 4.5)
            ph += f * inv_sr * math.tau
            sd[i] = _soft_sat(math.sin(ph) * math.exp(-t * 3.2) * 1.25)
        self.drum_subdrop = sd

    @staticmethod
    def _stamp_mono(
        buf_l: List[float],
        buf_r: List[float],
        sample: Sequence[float],
        pos: int,
        vol: float = 1.0,
        pan: float = 0.0,
    ) -> None:
        n_buf = len(buf_l)
        if pos >= n_buf or pos < 0:
            return
        gl = vol * clamp(1.0 - max(0.0, pan), 0.15, 1.0)
        gr = vol * clamp(1.0 + min(0.0, pan), 0.15, 1.0)
        end = min(n_buf, pos + len(sample))
        k = 0
        for idx in range(pos, end):
            v = sample[k]
            buf_l[idx] += v * gl
            buf_r[idx] += v * gr
            k += 1

    # --------------------------------------------------------------------------
    # Synthesize a Seamless Multi-Bar Phrase with Resonant SVF, Sidechain & FX!
    # --------------------------------------------------------------------------

    def render_bars_phrase(
        self,
        bars: Sequence[BarSectionSpec],
        bpm: float,
        gain: float = 0.78,
    ) -> Optional[pygame.mixer.Sound]:
        """
        Render a cohesive multi-bar phrase (typically 2 bars = 32 sixteenth steps)
        with full modular synthesis:
          - Velocity-layered Payday-2-style Techno/Breakbeat drums + fills
          - Resonant SVF Acid-303 / Neuro-Reese bassline with accent envelopes
          - Stereo detuned Supersaw lead & hypnotic gated synth arpeggios
          - Dark Gothic Cathedral pipe-organ & choir chords
          - Dynamic kick-triggered sidechain pumping
          - Tempo-synced dotted-eighth stereo ping-pong delay & subtle reverb
        """
        if not bars or not pygame.mixer.get_init():
            return None
        step_sec = 60.0 / bpm / 4.0
        bar_steps = 16
        total_steps = len(bars) * bar_steps
        n_samples = max(64, int(round(total_steps * step_sec * self.sr)))
        buf_l = [0.0] * n_samples
        buf_r = [0.0] * n_samples
        # Separate synth bus so kick triggers true pumping sidechain ducking!
        syn_l = [0.0] * n_samples
        syn_r = [0.0] * n_samples
        kick_env = [0.0] * n_samples

        wt_saw = self.wt_saw
        wt_acid = self.wt_acid
        wt_org = self.wt_organ
        wt_choir = self.wt_choir
        lut_n = self.lut_n
        mask = self.lut_mask
        inv_sr = self.inv_sr

        # Track kick positions for sidechain pump curve
        kick_steps_global: List[int] = []

        # --- 1. DRUM & BREAKBEAT PERCUSSION LAYER ---
        for b_idx, bar in enumerate(bars):
            st_off = b_idx * 16
            style = bar.drum_kit_style

            if style == "INTRO":
                k_steps = (0, 8)
                s_steps = ()
                g_steps = (14,)
                h_steps = (0, 4, 8, 12)
                ho_steps = ()
            elif style == "PULSE":
                k_steps = (0, 4, 8, 12)
                s_steps = (4, 12)
                g_steps = (7, 15)
                h_steps = tuple(range(0, 16, 2))
                ho_steps = (10,)
            elif style == "BUILD":
                k_steps = (0, 4, 8, 12)
                s_steps = (4, 12)
                g_steps = (6, 10, 14, 15)
                h_steps = tuple(range(16))
                ho_steps = (2, 6, 10, 14)
            elif style == "RISER":
                # Payday 2 assault build-up accelerating snare roll!
                k_steps = (0, 2, 4, 6, 8, 10, 12, 14)
                s_steps = (0, 2, 4, 6, 8, 9, 10, 11, 12, 13, 14, 15)
                g_steps = ()
                h_steps = tuple(range(16))
                ho_steps = (14,)
            elif style == "DROP_A":
                # Hard 4-on-floor + syncopated industrial breakbeat drive
                k_steps = (0, 3, 6, 8, 11, 14)
                s_steps = (4, 12)
                g_steps = (7, 9, 15)
                h_steps = tuple(range(16))
                ho_steps = (2, 10)
            elif style == "BREAKBEAT":
                # Classic chopped high-BPM Amen / Payday 2 assault breakbeat!
                k_steps = (0, 2, 10, 11)
                s_steps = (4, 12)
                g_steps = (7, 9, 15)
                h_steps = (0, 2, 4, 6, 8, 10, 12, 14)
                ho_steps = (6, 14)
            elif style == "DROP_B":
                # Maximum climax: relentless double-kick industrial techno-breakbeat!
                k_steps = (0, 2, 4, 7, 8, 10, 12, 14)
                s_steps = (4, 12)
                g_steps = (3, 6, 9, 15)
                h_steps = tuple(range(16))
                ho_steps = (2, 6, 10, 14)
            elif style == "ORGAN":
                # Gothic breakdown: sparse deep heartbeat kicks + ride shimmer
                k_steps = (0, 10)
                s_steps = ()
                g_steps = (14,)
                h_steps = (0, 4, 8, 12)
                ho_steps = ()
            elif style == "FILL":
                k_steps = (0, 6, 8, 12)
                s_steps = (4, 10, 12, 13, 14, 15)
                g_steps = (7, 9)
                h_steps = (0, 2, 4, 6, 8)
                ho_steps = (14,)
            else:  # OUTRO
                k_steps = (0, 8)
                s_steps = (12,)
                g_steps = ()
                h_steps = (0, 4, 8, 12)
                ho_steps = ()

            # Crash cymbal & sub-drop on bar 0 of high-energy drop bars
            if style in ("DROP_A", "DROP_B") and b_idx == 0:
                self._stamp_mono(buf_l, buf_r, self.drum_crash, 0, vol=0.46, pan=-0.18)
                self._stamp_mono(buf_l, buf_r, self.drum_subdrop, 0, vol=0.42, pan=0.0)

            for st in k_steps:
                g_st = st_off + st
                pos = int(round(g_st * step_sec * self.sr))
                kick_steps_global.append(pos)
                k_smp = self.drum_kick_hard if style in ("DROP_A", "DROP_B", "RISER") else self.drum_kick
                v_k = 0.86 if (st % 4 == 0) else 0.64
                self._stamp_mono(buf_l, buf_r, k_smp, pos, vol=v_k, pan=0.0)

            for st in s_steps:
                pos = int(round((st_off + st) * step_sec * self.sr))
                ramp = (0.45 + 0.55 * (st / 15.0)) if style == "RISER" else 1.0
                self._stamp_mono(buf_l, buf_r, self.drum_snare, pos, vol=0.72 * ramp, pan=0.06)
                if style in ("DROP_A", "DROP_B", "PULSE"):
                    self._stamp_mono(buf_l, buf_r, self.drum_clap, pos, vol=0.38 * ramp, pan=-0.10)

            for st in g_steps:
                pos = int(round((st_off + st) * step_sec * self.sr))
                self._stamp_mono(buf_l, buf_r, self.drum_snare_ghost, pos, vol=0.34, pan=0.14)

            for st in h_steps:
                pos = int(round((st_off + st) * step_sec * self.sr))
                # Subtle 16th-note groove accentuation
                hv = 0.24 if (st % 2 == 0) else 0.14
                self._stamp_mono(buf_l, buf_r, self.drum_hat_c, pos, vol=hv, pan=-0.26 if st % 2 else 0.22)

            for st in ho_steps:
                pos = int(round((st_off + st) * step_sec * self.sr))
                self._stamp_mono(buf_l, buf_r, self.drum_hat_o, pos, vol=0.28, pan=0.28)

            if style in ("DROP_B", "ORGAN"):
                for st in (0, 4, 8, 12):
                    pos = int(round((st_off + st) * step_sec * self.sr))
                    self._stamp_mono(buf_l, buf_r, self.drum_ride, pos, vol=0.22, pan=-0.30)

            if style in ("DROP_A", "DROP_B", "FILL"):
                pos_a = int(round((st_off + 14) * step_sec * self.sr))
                self._stamp_mono(buf_l, buf_r, self.drum_anvil, pos_a, vol=0.26, pan=0.34)

        # Build smooth kick sidechain ducking envelope
        sc_decay = int(self.sr * 0.13)
        for kp in kick_steps_global:
            end = min(n_samples, kp + sc_decay)
            for idx in range(kp, end):
                u = (idx - kp) / float(max(1, sc_decay))
                val = (1.0 - u) ** 1.7
                if val > kick_env[idx]:
                    kick_env[idx] = val

        # --- 2. MODULAR SYNTHESIS BUS (ACID-303 SVF BASS + SUPERSAW LEAD + ARP + GOTHIC PAD) ---
        b_ph = 0.0
        b_sub_ph = 0.0
        b_lp = 0.0
        b_bp = 0.0

        l_ph1 = l_ph2 = l_ph3 = 0.0
        l_lp = 0.0
        arp_ph = 0.0
        o_ph = [0.0, 0.0, 0.0]

        for b_idx, bar in enumerate(bars):
            c0, c1, c2 = bar.chord_midi
            cf0 = _midi_hz(c0) * inv_sr * lut_n
            cf1 = _midi_hz(c1) * inv_sr * lut_n
            cf2 = _midi_hz(c2) * inv_sr * lut_n
            q_inv = clamp(1.0 - bar.resonance * 0.82, 0.14, 0.88)

            for st in range(16):
                g_st = b_idx * 16 + st
                s0 = int(round(g_st * step_sec * self.sr))
                s1 = min(n_samples, int(round((g_st + 1) * step_sec * self.sr)))
                seg = max(1, s1 - s0)

                u_bar = st / 16.0
                base_cut = lerp(bar.cutoff_start, bar.cutoff_end, u_bar)

                b_note = bar.bass_pattern[st % len(bar.bass_pattern)]
                b_acc = bar.bass_accent[st % len(bar.bass_accent)]
                l_note = bar.lead_pattern[st % len(bar.lead_pattern)]
                a_note = bar.arp_pattern[st % len(bar.arp_pattern)]

                bf_inc = (_midi_hz(b_note) * inv_sr * lut_n) if b_note > 0 else 0.0
                bsub_inc = bf_inc * 0.5
                lf_base = (_midi_hz(l_note) * inv_sr * lut_n) if l_note > 0 else 0.0
                af_inc = (_midi_hz(a_note) * inv_sr * lut_n) if a_note > 0 else 0.0

                pad_g = bar.pad_gain
                lead_g = bar.lead_gain
                arp_g = bar.arp_gain
                sc_d = bar.sidechain_depth
                pan_arp = 0.42 if (st % 2 == 0) else -0.42

                for k in range(seg):
                    idx = s0 + k
                    u = k / float(seg)
                    sl = 0.0
                    sr_v = 0.0

                    # (A) Resonant Acid TB-303 / Neuro-Reese Bass with Chamberlin SVF!
                    if bf_inc > 0.0:
                        b_ph += bf_inc
                        b_sub_ph += bsub_inc
                        raw_b = wt_acid[int(b_ph) & mask]
                        sub_b = self.wt_sin[int(b_sub_ph) & mask]
                        amp_env = math.exp(-u * (3.2 if b_acc == 0 else 2.1))
                        filt_env = math.exp(-u * (7.5 if b_acc < 2 else 4.2))
                        cut = clamp(base_cut + filt_env * (0.26 + 0.16 * b_acc), 0.05, 0.78)
                        # Chamberlin SVF update
                        hp = raw_b - b_lp - q_inv * b_bp
                        b_bp += cut * hp
                        b_lp += cut * b_bp
                        acid_out = _soft_sat((b_lp * 1.35 + b_bp * 0.25 * b_acc) * 1.45) * amp_env
                        bass_tot = (acid_out * 0.44 + sub_b * amp_env * 0.28)
                        sl += bass_tot
                        sr_v += bass_tot

                    # (B) Detuned 3-Voice Stereo Supersaw Lead
                    if lf_base > 0.0 and lead_g > 0.01:
                        l_ph1 += lf_base * 0.994
                        l_ph2 += lf_base
                        l_ph3 += lf_base * 1.006
                        v1 = wt_saw[int(l_ph1) & mask]
                        v2 = wt_saw[int(l_ph2) & mask]
                        v3 = wt_saw[int(l_ph3) & mask]
                        l_env = math.exp(-u * 2.4) * (1.0 - math.exp(-u * 65.0))
                        # Gentle 1-pole bright smoothing
                        l_mid = (v1 + v2 + v3) * 0.33
                        l_lp += 0.42 * (l_mid - l_lp)
                        sl += (l_lp + v1 * 0.38) * l_env * lead_g * 0.36
                        sr_v += (l_lp + v3 * 0.38) * l_env * lead_g * 0.36

                    # (C) Hypnotic Stereo Gated Synth Arpeggio
                    if af_inc > 0.0 and arp_g > 0.01:
                        arp_ph += af_inc
                        a_val = wt_saw[int(arp_ph) & mask] * math.exp(-u * 6.2) * arp_g * 0.24
                        sl += a_val * (1.0 - max(0.0, pan_arp))
                        sr_v += a_val * (1.0 + min(0.0, pan_arp))

                    # (D) Dark Gothic Cathedral Pipe Organ & Haunted Choir Pad
                    if pad_g > 0.01:
                        o_ph[0] += cf0
                        o_ph[1] += cf1
                        o_ph[2] += cf2
                        p0 = wt_org[int(o_ph[0]) & mask]
                        p1 = wt_choir[int(o_ph[1]) & mask]
                        p2 = wt_org[int(o_ph[2]) & mask]
                        sl += (p0 * 0.42 + p1 * 0.34 + p2 * 0.22) * pad_g * 0.28
                        sr_v += (p0 * 0.38 + p2 * 0.36 + p1 * 0.24) * pad_g * 0.28

                    # Sidechain compression ducking on synth bus (instant hypnotic Payday 2 pump!)
                    duck = 1.0 - kick_env[idx] * sc_d
                    syn_l[idx] = sl * duck
                    syn_r[idx] = sr_v * duck

        # --- 3. STEREO PING-PONG DELAY (Dotted-Eighth Synced!) & LIGHT REVERB ---
        delay_samp = max(64, int(round(step_sec * 3.0 * self.sr)))
        rev_tap1 = max(32, int(self.sr * 0.031))
        rev_tap2 = max(48, int(self.sr * 0.053))
        for i in range(n_samples):
            dl = syn_r[i - delay_samp] * 0.28 if i >= delay_samp else 0.0
            dr = syn_l[i - delay_samp] * 0.24 if i >= delay_samp else 0.0
            rv_l = (syn_l[i - rev_tap1] * 0.14 if i >= rev_tap1 else 0.0) + (syn_r[i - rev_tap2] * 0.10 if i >= rev_tap2 else 0.0)
            rv_r = (syn_r[i - rev_tap1] * 0.14 if i >= rev_tap1 else 0.0) + (syn_l[i - rev_tap2] * 0.10 if i >= rev_tap2 else 0.0)
            buf_l[i] += syn_l[i] + dl + rv_l
            buf_r[i] += syn_r[i] + dr + rv_r

        return self._pack_stereo_sound(buf_l, buf_r, gain=gain)

    def _pack_stereo_sound(
        self,
        buf_l: Sequence[float],
        buf_r: Sequence[float],
        gain: float = 0.82,
    ) -> Optional[pygame.mixer.Sound]:
        if not pygame.mixer.get_init():
            return None
        n = min(len(buf_l), len(buf_r))
        pcm = array.array("h", [0]) * (n * 2)
        sc = 32767.0 * gain
        for i in range(n):
            lv = int(_soft_sat(buf_l[i]) * sc)
            rv = int(_soft_sat(buf_r[i]) * sc)
            if lv > 32767:
                lv = 32767
            elif lv < -32767:
                lv = -32767
            if rv > 32767:
                rv = 32767
            elif rv < -32767:
                rv = -32767
            pcm[i * 2] = lv
            pcm[i * 2 + 1] = rv
        return pygame.mixer.Sound(buffer=pcm.tobytes())


