    def _render_trial_panel(self, target: pygame.Surface) -> None:
        trial = self.trials.current_trial
        if trial is None:
            return
        panel = pygame.Rect(SCREEN_W - 318, 128, 302, 46 + len(trial.step_labels) * 28 + 38)
        draw_gothic_panel(target, panel, bg_alpha=204, accent_col=UI_GOLD_BRIGHT, corner_cut=10, ornate=True)
        stars = "*" * trial.difficulty_stars
        cleared = trial.trial_id in self.trials.completed_ids
        hdr = f"TRIAL {trial.trial_id}: {trial.title}"
        self.fonts.draw_text(target, hdr, (panel.x + 14, panel.y + 10), size=14, color=UI_GOLD_BRIGHT, outline_px=1, style="serif", bold=True)
        self.fonts.draw_text(
            target, "CLEARED!" if cleared else f"DIFFICULTY {stars}", (panel.right - 14, panel.y + 12), size=11,
            color=(86, 245, 146) if cleared else UI_CRIMSON_GLOW, outline_px=1, style="sans", bold=True, align="topright",
        )

        y = panel.y + 38
        for idx, lbl in enumerate(trial.step_labels):
            done = idx < self.trials.current_step or cleared
            active = idx == self.trials.current_step and not cleared
            col = (92, 246, 152) if done else (UI_GOLD_BRIGHT if active else UI_TEXT_IVORY)
            prefix = "[OK] " if done else (">> " if active else "   ")
            self.fonts.draw_text(target, prefix + lbl, (panel.x + 16, y), size=14, color=col, outline_px=1, style="sans", bold=active or done)
            y += 26

        self.fonts.draw_wrapped(target, trial.hint, pygame.Rect(panel.x + 14, y + 4, panel.w - 28, 38), size=11, color=UI_TEXT_MUTED, style="sans")

        if self.trials.clear_banner_timer > 0:
