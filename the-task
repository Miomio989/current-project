    def _bake_blood_sky(self) -> pygame.Surface:
        # Paint FBM apocalyptic clouds at 1/2 resolution (520x250) -> smooth upscale!
        lw, lh = 520, 250
        low = pygame.Surface((lw, lh))
        sky_ramp = (
            (0.00, (10, 2, 7)),
            (0.26, (38, 4, 14)),
            (0.52, (94, 10, 24)),
            (0.76, (158, 18, 34)),
            (0.91, (212, 42, 48)),
            (1.00, (244, 96, 78)),
        )
        for y in range(lh):
            v = y / float(lh - 1)
            base_h = clamp((v ** 1.15) * 0.88 + 0.08, 0.0, 1.0)
            for x in range(lw):
                u = x / float(lw - 1)
                n1 = fbm_2d(u * 6.4, v * 3.8, octaves=4, seed=1991)
                n2 = ridged_fbm_2d(u * 10.5 + 3.2, v * 5.2, octaves=3, seed=4096)
                cloud = clamp(base_h * 0.62 + n1 * 0.42 + n2 * 0.24 - 0.16, 0.0, 1.0)
                # Dark dramatic storm cloud underbellies
                if n1 < 0.44 and v < 0.72:
                    cloud *= 0.42 + 0.58 * (n1 / 0.44)
                col = sample_color_ramp(sky_ramp, cloud)
                low.set_at((x, y), col)

        surf = pygame.transform.smoothscale(low, (1040, 480))

        # Huge luminous textured BLOOD MOON (upper right behind cathedral, matching mockup.jpg!)
        moon_x, moon_y, moon_r = 718, 128, 66
        self.rast.stamp_bloom(surf, moon_x, moon_y, 185, (238, 28, 62), alpha=155, additive=True)
        self.rast.stamp_bloom(surf, moon_x, moon_y, 108, (255, 86, 112), alpha=135, additive=True)

        moon_surf = pygame.Surface((moon_r * 2 + 4, moon_r * 2 + 4), pygame.SRCALPHA)
        mc = moon_r + 2
        for dy in range(-moon_r, moon_r + 1):
            for dx in range(-moon_r, moon_r + 1):
                d2 = dx * dx + dy * dy
                if d2 <= moon_r * moon_r:
                    dist = math.sqrt(d2) / float(moon_r)
                    # Textured crimson lunar maria & craters!
                    m_noise = fbm_2d((dx + 120) * 0.045, (dy + 120) * 0.045, octaves=3, seed=666)
                    shade = clamp(1.0 - dist * 0.42 - (0.36 if m_noise < 0.48 else 0.0) * (1.0 - m_noise), 0.15, 1.0)
                    c = sample_color_ramp(
                        ((0.0, (124, 14, 34)), (0.45, (226, 44, 72)), (0.80, (255, 126, 138)), (1.0, (255, 224, 224))),
                        shade,
                    )
                    edge_a = clamp_int(int((1.0 - max(0.0, dist - 0.90) / 0.10) * 255), 0, 255)
                    moon_surf.set_at((mc + dx, mc + dy), (c[0], c[1], c[2], edge_a))
        surf.blit(moon_surf, (moon_x - mc, moon_y - mc))

        # Wispy blackened storm cloud streaks drifting across the face of the Blood Moon
        veil = pygame.Surface((1040, 480), pygame.SRCALPHA)
        for streak_y, w_span, thickness in ((98, 210, 14), (132, 260, 18), (168, 240, 12)):
            pts = [
                (moon_x - w_span // 2, streak_y + 8),
                (moon_x - w_span // 5, streak_y - thickness // 2),
                (moon_x + w_span // 4, streak_y + thickness // 3),
                (moon_x + w_span // 2, streak_y - 4),
                (moon_x + w_span // 4, streak_y + thickness),
                (moon_x - w_span // 4, streak_y + thickness + 4),
            ]
            pygame.draw.polygon(veil, (36, 4, 14, 118), pts)
        surf.blit(veil, (0, 0))

        # Soft multi-layered feathered apocalyptic crimson god-rays (zero hard edges!)
        rays = pygame.Surface((1040, 480), pygame.SRCALPHA)
        for rx, rw, tilt, peak_a in (
            (180, 74, -120, 18), (440, 110, -52, 24), (690, 132, 18, 28), (880, 76, 82, 18),
        ):
            for layer_i in range(4):
                pad_w = layer_i * 18
                a = max(4, peak_a // (layer_i + 2))
                poly = [
                    (rx - pad_w, 0), (rx + rw + pad_w, 0),
                    (rx + rw + tilt + 70 + pad_w, 480), (rx + tilt - 50 - pad_w, 480),
                ]
                pygame.draw.polygon(rays, (238, 44, 62, a), poly)
        surf.blit(rays, (0, 0))
        return surf

