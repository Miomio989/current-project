                                   tip="Write both XML files and reload them in the app"))
        lay.addLayout(btns)
        self._load_set()
        self._loading = False

    # ---------------------------------------------------------------- helpers
    def _templates(self) -> List[Dict[str, str]]:
        return self.data[self._set]

    def _load_set(self) -> None:
        self.set_btns[self._set].setChecked(True)
        self.file_label.setText(os.path.basename(TEMPLATE_FILES[self._set]))
        self.list.clear()
        for t in self._templates():
            it = QListWidgetItem(t["name"])
            it.setData(Qt.ItemDataRole.UserRole, t)
            it.setToolTip(t["body"])
            self.list.addItem(it)
        if self.list.count():
            self.list.setCurrentRow(0)
        self._load_form()

    def _switch_set(self, key: str) -> None:
        if key == self._set or key not in self.data:
            return
        self._set = key
        self._load_set()

    def _current(self) -> Optional[Dict[str, str]]:
        it = self.list.currentItem()
        return it.data(Qt.ItemDataRole.UserRole) if it else None

    def _load_form(self) -> None:
        t = self._current()
        self.name_edit.setText(t["name"] if t else "")
        self.body_edit.setPlainText(t["body"] if t else "")
        self.count_label.setText(f"{self.list.count()} template(s)")
        self._refresh_preview()

    def _refresh_preview(self) -> None:
        """Validation hint + live composed preview of the body being edited."""
        body = self.body_edit.toPlainText()
        if "{{insert}}" in body:
            self.valid_label.setText("\u2713 {{insert}} found \u2014 your prompt replaces it.")
            self.valid_label.setStyleSheet(f"color: {PAL['ok']};")
        else:
            self.valid_label.setText("\u26a0 no {{insert}} \u2014 the prompt is appended at the end.")
            self.valid_label.setStyleSheet(f"color: {PAL['warn']};")
        self.preview_edit.setPlainText(apply_template(body, "a beautiful sample scene, highly detailed, soft light"))

    def _commit_form(self) -> None:
        """Write the form back into the selected item (keeps list in sync)."""
        t = self._current()
        if t is None:
            return
        t["name"] = self.name_edit.text().strip() or "Template"
        t["body"] = " ".join(self.body_edit.toPlainText().split())
        it = self.list.currentItem()
        if it is not None:
            it.setText(t["name"])
            it.setToolTip(t["body"])

    def _selected_index(self) -> int:
        return self.list.currentRow()

    def _move(self, delta: int) -> None:
        """Reorder the template one slot up / down (persists on SAVE)."""
        self._commit_form()
        row = self.list.currentRow()
        if row < 0:
            return
        tgt = row + delta
        if tgt < 0 or tgt >= self.list.count():
            return
        lst = self._templates()
        lst[row], lst[tgt] = lst[tgt], lst[row]
        it = self.list.takeItem(row)
        self.list.insertItem(tgt, it)
        self.list.setCurrentRow(tgt)

    # ---------------------------------------------------------------- actions
    def _new(self) -> None:
        self._commit_form()
        t = {"name": "New template", "body": "{{insert}}"}
        self._templates().append(t)
        it = QListWidgetItem(t["name"])
        it.setData(Qt.ItemDataRole.UserRole, t)
        self.list.addItem(it)
        self.list.setCurrentItem(it)
        self.name_edit.setFocus()
        self.name_edit.selectAll()
        self._load_form()

    def _duplicate(self) -> None:
        self._commit_form()
        src = self._current()
        if src is None:
            return
        t = {"name": src["name"] + " copy", "body": src["body"]}
        self._templates().append(t)
        it = QListWidgetItem(t["name"])
        it.setData(Qt.ItemDataRole.UserRole, t)
        self.list.addItem(it)
        self.list.setCurrentItem(it)
        self._load_form()

    def _delete(self) -> None:
        row = self._selected_index()
        if row < 0:
            return
        t = self._current()
        if t is not None and self._templates():
            self._templates().remove(t)
        self.list.takeItem(row)
        row = min(row, self.list.count() - 1)
        if row >= 0:
            self.list.setCurrentRow(row)
        self._load_form()

    def _save_and_close(self) -> None:
        self._commit_form()
        for key, path in TEMPLATE_FILES.items():
            save_templates_file(path, self.data[key])
        self.accept()


