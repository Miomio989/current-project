class StylishMeter:
    """Devil May Cry 4 / Bayonetta Stylish Rank engine with move-variety bonus & decay."""

    def __init__(self) -> None:
        self.points: float = 0.0
        self.rank: StyleRank = StyleRank.NONE
        self.peak_rank: StyleRank = StyleRank.NONE
        self.recent_moves: Deque[FighterState] = collections.deque(maxlen=6)
        self.rank_flash_timer: float = 0.0
        self.style_bonus_total: int = 0

    def reset(self) -> None:
        self.points = 0.0
        self.rank = StyleRank.NONE
        self.recent_moves.clear()
        self.rank_flash_timer = 0.0

    def register_action(self, state: FighterState, base_pts: float, bonus_mult: float = 1.0) -> bool:
        """Award style points with freshness scaling (repeating the same move yields less!)."""
        repeats = sum(1 for m in self.recent_moves if m == state)
        variety_mult = max(0.32, 1.0 - repeats * 0.24)
        gained = base_pts * variety_mult * bonus_mult
        self.points = clamp(self.points + gained, 0.0, 2650.0)
        self.style_bonus_total += int(gained * 1.5)
        self.recent_moves.append(state)
        return self._recalc_rank()

    def register_damage_taken(self) -> None:
        self.points = max(0.0, self.points * 0.45 - 220.0)
        self._recalc_rank()

    def update(self, dt: float, in_combo: bool) -> None:
        self.rank_flash_timer = max(0.0, self.rank_flash_timer - dt)
        decay_rate = 38.0 if in_combo else (115.0 + self.rank.tier * 22.0)
        self.points = max(0.0, self.points - decay_rate * dt)
        self._recalc_rank()

    def _recalc_rank(self) -> bool:
        old = self.rank
        best = StyleRank.NONE
        for r in StyleRank:
            if self.points >= r.threshold:
                best = r
        self.rank = best
        if best.tier > self.peak_rank.tier:
            self.peak_rank = best
        if best.tier > old.tier:
            self.rank_flash_timer = 0.55
            return True
        return False


class Fighter:
    """
    Complete deterministic 60 FPS Fighter entity for Cecilia Darkmoon & Mirror Rivals.
    Manages animation playback, resources (HP, recoverable ghost HP, Curse Resonance,
    Poise/Guard integrity, Eclipse Overdrive), state transitions, cancel windows,
    and frame-exact hurtboxes/hitboxes.
    """

    def __init__(
        self,
        player_id: int,
        name: str,
        epithet: str,
        palette_key: str,
        move_reg: Dict[FighterState, MoveSpec],
        bank: SpriteBank,
    ) -> None:
        self.player_id = player_id
        self.name = name
        self.epithet = epithet
        self.palette_key = palette_key
        self.move_reg = move_reg
        self.bank = bank

        self.x: float = STAGE_CENTER_X - 180.0 if player_id == 0 else STAGE_CENTER_X + 180.0
        self.y: float = GROUND_Y
        self.vx: float = 0.0
        self.vy: float = 0.0
        self.facing_right: bool = (player_id == 0)

        self.hp: int = MAX_HP
        self.ghost_hp: float = float(MAX_HP)
        self.curse: int = 250
        self.poise: int = MAX_POISE
        self.eclipse_timer: int = 0
        self.rounds_won: int = 0

        self.state: FighterState = FighterState.IDLE
        self.state_frame: int = 0
        self.kf_idx: int = 0
        self.kf_hold: int = 0
        self.hitstop_frames: int = 0
        self.stun_frames: int = 0
        self.wakeup_invuln: int = 0
        self.parry_cooldown: int = 0
        self.counter_hit_flag: bool = False
        self.move_connected: bool = False
        self.move_blocked: bool = False
        self.hits_registered: Set[int] = set()
        self.has_spawned_proj: bool = False
        self.pillar_frames_fired: Set[int] = set()

        # Combo tracking
        self.combo_count: int = 0
        self.combo_damage: int = 0
        self.juggle_decay: int = 0
        self.flash_white_frames: int = 0
        self.flash_crimson_frames: int = 0

        self.input_buf = InputBuffer()
        self.stylish = StylishMeter()

    def reset_for_round(self, start_x: float, facing_right: bool, keep_curse: bool = True) -> None:
        self.x = start_x
        self.y = GROUND_Y
        self.vx = 0.0
        self.vy = 0.0
        self.facing_right = facing_right
        self.hp = MAX_HP
        self.ghost_hp = float(MAX_HP)
        if not keep_curse:
            self.curse = 250
        self.poise = MAX_POISE
        self.eclipse_timer = 0
        self.hitstop_frames = 0
        self.stun_frames = 0
        self.wakeup_invuln = 0
        self.parry_cooldown = 0
        self.combo_count = 0
        self.combo_damage = 0
        self.juggle_decay = 0
        self.stylish.reset()
        self.input_buf.clear()
        self.enter_state(FighterState.IDLE)

    @property
    def is_grounded(self) -> bool:
        return self.y >= GROUND_Y - 0.5

    @property
    def is_eclipse(self) -> bool:
        return self.eclipse_timer > 0

    @property
    def is_attacking(self) -> bool:
        return self.state in self.move_reg and self.state not in (FighterState.PARRY_STANCE, FighterState.SP_ABYSSAL_STANCE)

    @property
    def is_hitstun(self) -> bool:
        return self.state in (
            FighterState.HIT_STAND_LIGHT,
            FighterState.HIT_STAND_HEAVY,
            FighterState.HIT_CROUCH,
            FighterState.HIT_LAUNCH,
            FighterState.KNOCKDOWN,
            FighterState.KO_FALL,
            FighterState.GUARD_BREAK,
        )

    @property
    def is_guarding(self) -> bool:
        return self.state in (FighterState.GUARD_STAND, FighterState.GUARD_CROUCH, FighterState.GUARD_AIR)

    @property
    def is_crouching(self) -> bool:
        return self.state in (
            FighterState.CROUCH_ENTER, FighterState.CROUCH, FighterState.GUARD_CROUCH,
            FighterState.ATTACK_2L, FighterState.ATTACK_2M, FighterState.ATTACK_3H, FighterState.HIT_CROUCH,
        )

    @property
    def can_act_freely(self) -> bool:
        return self.state in (
            FighterState.IDLE, FighterState.WALK_FWD, FighterState.WALK_BACK,
            FighterState.CROUCH_ENTER, FighterState.CROUCH, FighterState.DASH_FWD,
            FighterState.DASH_STOP, FighterState.JUMP_RISE, FighterState.JUMP_APEX, FighterState.JUMP_FALL,
        )

    def current_keyframe(self) -> CelFrameData:
        frames = self.bank.get_keyframes(self.state)
        return frames[clamp_int(self.kf_idx, 0, len(frames) - 1)]

    def enter_state(self, new_state: FighterState) -> None:
        self.state = new_state
        self.state_frame = 0
        self.kf_idx = 0
        self.kf_hold = 0
        self.move_connected = False
        self.move_blocked = False
        self.hits_registered.clear()
        self.has_spawned_proj = False
        self.pillar_frames_fired.clear()
        if new_state == FighterState.ECLIPSE_BURST:
            self.eclipse_timer = 480  # 8 seconds of Crimson Eclipse Overdrive!
            self.curse = max(0, self.curse - 500)
        elif new_state in self.move_reg:
            spec = self.move_reg[new_state]
            if spec.curse_cost > 0:
                self.curse = max(0, self.curse - spec.curse_cost)
                if spec.requires_eclipse:
                    self.eclipse_timer = 0

    def is_invulnerable(self, attack_height: AttackHeight = AttackHeight.MID) -> bool:
        if self.wakeup_invuln > 0 or self.state in (FighterState.BACKDASH, FighterState.WAKEUP, FighterState.KO_FALL):
            if self.state == FighterState.BACKDASH:
                return self.state_frame < 12
            return True
        spec = self.move_reg.get(self.state)
        if spec is not None:
            i0, i1 = spec.invuln_frames
            if i0 <= self.state_frame < i1:
                return True
            u0, u1 = spec.upper_invuln_frames
            if u0 <= self.state_frame < u1 and attack_height == AttackHeight.HIGH:
                return True
        return False

    def is_parry_active(self) -> bool:
        if self.state == FighterState.PARRY_STANCE and 1 <= self.state_frame <= 10:
            return True
        if self.state == FighterState.SP_ABYSSAL_STANCE and 3 <= self.state_frame <= 24:
            return True
        return False

    def get_hurtboxes(self) -> Tuple[BoxRect, ...]:
        if self.state in (FighterState.KNOCKDOWN, FighterState.KO_FALL):
            return (BoxRect(-48, -32, 96, 30),)
        if self.is_crouching:
            return (BoxRect(-32, -112, 66, 110),)
        if not self.is_grounded:
            return (BoxRect(-30, -158, 62, 126),)
        return (BoxRect(-30, -166, 62, 164),)

    def get_active_hit_window(self) -> Optional[HitWindow]:
        spec = self.move_reg.get(self.state)
        if spec is None:
            return None
        for hw in spec.hit_windows:
            if hw.start_frame <= self.state_frame <= hw.end_frame:
                return hw
        return None

    def get_pushbox_world(self) -> Tuple[float, float, float, float]:
        h = 96.0 if self.is_crouching else 148.0
        return (self.x - FIGHTER_PUSH_HALF_W, self.y - h, FIGHTER_PUSH_HALF_W * 2.0, h)

    def can_cancel_into(self, target_state: FighterState) -> bool:
        """Evaluate authentic KoF XIII / BlazBlue fighting-game cancel routes."""
        if self.can_act_freely:
            return True
        if self.state == FighterState.PARRY_SUCCESS and self.state_frame >= 4:
            return target_state == FighterState.PARRY_RIPOSTE
        spec = self.move_reg.get(self.state)
        if spec is None or self.state_frame < spec.cancel_window_start:
            return False
        if not (self.move_connected or self.move_blocked) and target_state != FighterState.ECLIPSE_BURST:
            return False

        cf = spec.cancel_flags
        tgt = self.move_reg.get(target_state)
        if target_state == FighterState.ECLIPSE_BURST:
            return bool(cf & CancelFlag.ECLIPSE) and self.curse >= 500 and not self.is_eclipse
        if target_state in (FighterState.JUMP_SQUAT, FighterState.JUMP_RISE):
            return bool(cf & CancelFlag.JUMP) and self.move_connected
        if tgt is None:
            return False
        if tgt.category == "FATAL":
            return bool(cf & CancelFlag.SUPER) and self.curse >= 1000 and self.is_eclipse
        if tgt.category == "SUPER":
            return bool(cf & CancelFlag.SUPER) and self.curse >= tgt.curse_cost
        if self.state == FighterState.SP_REKKA_1 and target_state == FighterState.SP_REKKA_2:
            return bool(cf & CancelFlag.REKKA)
        if self.state == FighterState.SP_REKKA_2 and target_state == FighterState.SP_REKKA_3:
            return bool(cf & CancelFlag.REKKA)
        if tgt.category == "SPECIAL":
            return bool(cf & CancelFlag.SPECIAL)
        if tgt.category == "COMMAND":
            return bool(cf & CancelFlag.COMMAND)
        if target_state in (FighterState.ATTACK_5M, FighterState.ATTACK_2M, FighterState.ATTACK_JM):
            return bool(cf & CancelFlag.CHAIN_M)
        if target_state in (FighterState.ATTACK_5H, FighterState.ATTACK_2H, FighterState.ATTACK_3H, FighterState.ATTACK_JH, FighterState.ATTACK_J2H):
            return bool(cf & CancelFlag.CHAIN_H)
        return False

    def interpret_inputs(
        self,
        dx: int,
        dy: int,
        held: InputButton,
        opponent: Fighter,
        can_control: bool,
    ) -> Optional[FighterState]:
        """Translate raw player/AI inputs via the 24-frame arcade buffer into actions."""
        fr = self.input_buf.push(dx, dy, held, self.facing_right)
        if not can_control or self.is_hitstun or self.state in (
            FighterState.WAKEUP, FighterState.INTRO_POSE, FighterState.WIN_POSE, FighterState.THROW_EXEC
        ):
            return None

        num = dx_dy_to_numpad(dx, dy, self.facing_right)
        any_atk_p = bool(fr.pressed & (InputButton.LIGHT | InputButton.MEDIUM | InputButton.HEAVY))
        l_p = bool(fr.pressed & InputButton.LIGHT)
        m_p = bool(fr.pressed & InputButton.MEDIUM)
        h_p = bool(fr.pressed & InputButton.HEAVY)
        sp_p = bool(fr.pressed & InputButton.SPECIAL)
        ec_p = bool(fr.pressed & InputButton.ECLIPSE)
        taunt_p = bool(fr.pressed & InputButton.TAUNT)

        # 0. Instant Parry Riposte follow-up!
        if self.state == FighterState.PARRY_SUCCESS and (any_atk_p or sp_p) and self.can_cancel_into(FighterState.PARRY_RIPOSTE):
            return FighterState.PARRY_RIPOSTE

        # 1. Eclipse Overdrive Burst (Space / H+S)
        if (ec_p or (bool(held & InputButton.HEAVY) and sp_p)) and self.curse >= 500 and not self.is_eclipse:
            if self.can_cancel_into(FighterState.ECLIPSE_BURST):
                return FighterState.ECLIPSE_BURST

        # 2. Super Arts & Eclipse Fatal Execution (double quarter-circle OR intuitive shortcut!)
        if self.is_grounded:
            if self.is_eclipse and self.curse >= 1000 and (
                (self.input_buf.match_motion((2, 3, 6, 2, 3, 6), 22) and (h_p or sp_p))
                or (ec_p and bool(held & InputButton.HEAVY))
            ):
                if self.can_cancel_into(FighterState.FATAL_ASTRAL_EXEC):
                    return FighterState.FATAL_ASTRAL_EXEC

            if self.curse >= 500:
                if (self.input_buf.match_motion((2, 3, 6, 2, 3, 6), 20) and any_atk_p) or (
                    self.input_buf.match_motion((2, 3, 6), 14) and sp_p and bool(held & InputButton.MEDIUM)
                ):
                    if self.can_cancel_into(FighterState.SUPER_REQUIEM):
                        return FighterState.SUPER_REQUIEM
                if (self.input_buf.match_motion((2, 1, 4, 2, 1, 4), 20) and any_atk_p) or (
                    self.input_buf.match_motion((2, 1, 4), 14) and sp_p and bool(held & InputButton.HEAVY)
                ):
                    if self.can_cancel_into(FighterState.SUPER_CATACLYSM):
                        return FighterState.SUPER_CATACLYSM

        # 3. Rekka Chaining (214 Rekka I -> II -> III on button press!)
        if self.state == FighterState.SP_REKKA_1 and (any_atk_p or sp_p):
            if self.can_cancel_into(FighterState.SP_REKKA_2):
                return FighterState.SP_REKKA_2
        if self.state == FighterState.SP_REKKA_2 and (any_atk_p or sp_p):
            if self.can_cancel_into(FighterState.SP_REKKA_3):
                return FighterState.SP_REKKA_3

        # 4. Special Moves (classic arcade motions + accessible Special button directional shortcuts!)
        if not self.is_grounded:
            if (self.input_buf.match_motion((2, 1, 4), 14) and any_atk_p) or (sp_p and dy >= 0):
                if self.can_cancel_into(FighterState.SP_CATHEDRAL_DESCENT):
                    return FighterState.SP_CATHEDRAL_DESCENT
        else:
            if (self.input_buf.match_motion((4, 1, 2, 3, 6), 20) and h_p) or (sp_p and num == 6 and bool(held & InputButton.HEAVY)):
                if self.can_cancel_into(FighterState.SP_BLOOD_IMPALE):
                    return FighterState.SP_BLOOD_IMPALE
            if (self.input_buf.match_motion((6, 2, 3), 15) and any_atk_p) or (sp_p and num in (3, 9)):
                if self.can_cancel_into(FighterState.SP_VALKYRIE_FANG):
                    return FighterState.SP_VALKYRIE_FANG
            if (self.input_buf.match_motion((2, 3, 6), 14) and any_atk_p) or (sp_p and num == 6):
                if self.can_cancel_into(FighterState.SP_CRIMSON_CRESCENT):
                    return FighterState.SP_CRIMSON_CRESCENT
            if (self.input_buf.match_motion((2, 1, 4), 14) and any_atk_p) or (sp_p and num == 4):
                if self.can_cancel_into(FighterState.SP_REKKA_1):
                    return FighterState.SP_REKKA_1
            if (self.input_buf.match_motion((2, 5, 2), 14) and any_atk_p) or (sp_p and num == 2):
                if self.can_cancel_into(FighterState.SP_ABYSSAL_STANCE):
                    return FighterState.SP_ABYSSAL_STANCE

        # 5. Just-Parry / Blade Deflect (Neutral Special button on ground!)
        if self.is_grounded and sp_p and num == 5 and self.can_act_freely and self.parry_cooldown <= 0:
            self.parry_cooldown = 16
            return FighterState.PARRY_STANCE

        # 6. Throw (L + M pressed together on ground)
        if self.is_grounded and self.can_act_freely and (
            (l_p and bool(held & InputButton.MEDIUM)) or (m_p and bool(held & InputButton.LIGHT))
        ):
            return FighterState.THROW_ATTEMPT

        # 7. Aerial Normals
        if not self.is_grounded:
            if h_p and dy > 0 and self.can_cancel_into(FighterState.ATTACK_J2H):
                return FighterState.ATTACK_J2H
            if h_p and self.can_cancel_into(FighterState.ATTACK_JH):
                return FighterState.ATTACK_JH
            if m_p and self.can_cancel_into(FighterState.ATTACK_JM):
                return FighterState.ATTACK_JM
            if l_p and self.can_cancel_into(FighterState.ATTACK_JL):
                return FighterState.ATTACK_JL
            return None

        # 8. Ground Command & Base Normals
        if self.state == FighterState.DASH_FWD and (m_p or h_p):
            return FighterState.ATTACK_DASH
        if num == 3 and h_p and self.can_cancel_into(FighterState.ATTACK_3H):
            return FighterState.ATTACK_3H
        if num == 6 and m_p and self.can_cancel_into(FighterState.ATTACK_6M):
            return FighterState.ATTACK_6M
        if dy > 0:
            if h_p and self.can_cancel_into(FighterState.ATTACK_2H):
                return FighterState.ATTACK_2H
            if m_p and self.can_cancel_into(FighterState.ATTACK_2M):
                return FighterState.ATTACK_2M
            if l_p and self.can_cancel_into(FighterState.ATTACK_2L):
                return FighterState.ATTACK_2L
        else:
            if h_p and self.can_cancel_into(FighterState.ATTACK_5H):
                return FighterState.ATTACK_5H
            if m_p and self.can_cancel_into(FighterState.ATTACK_5M):
                return FighterState.ATTACK_5M
            if l_p and self.can_cancel_into(FighterState.ATTACK_5L):
                return FighterState.ATTACK_5L

        # 9. Taunt
        if taunt_p and self.can_act_freely:
            return FighterState.TAUNT

        # 10. Jump / Jump Cancel, Dash / Backdash, Crouch & Walk
        if dy < 0 and (self.can_act_freely or self.can_cancel_into(FighterState.JUMP_SQUAT)):
            return FighterState.JUMP_SQUAT
        if self.can_act_freely:
            if self.input_buf.has_double_tap(6, 11) and self.state != FighterState.DASH_FWD:
                return FighterState.DASH_FWD
            if self.input_buf.has_double_tap(4, 11) and self.state != FighterState.BACKDASH:
                return FighterState.BACKDASH
            if dy > 0:
                if self.state not in (FighterState.CROUCH_ENTER, FighterState.CROUCH):
                    return FighterState.CROUCH_ENTER
            elif num == 6:
                if self.state not in (FighterState.WALK_FWD, FighterState.DASH_FWD):
                    return FighterState.WALK_FWD
            elif num == 4:
                if self.state != FighterState.WALK_BACK:
                    return FighterState.WALK_BACK
            else:
                if self.state == FighterState.DASH_FWD:
                    return FighterState.DASH_STOP
                if self.state in (FighterState.WALK_FWD, FighterState.WALK_BACK, FighterState.CROUCH, FighterState.CROUCH_ENTER):
                    return FighterState.IDLE
        return None

    def step_physics_and_animation(
        self,
        opponent: Fighter,
        stage: CursedCathedralStage,
        audio: AudioManager,
    ) -> None:
        """Advance fighter physics, animation keyframes, resources, and triggers by 1/60s."""
        if self.flash_white_frames > 0:
            self.flash_white_frames -= 1
        if self.flash_crimson_frames > 0:
            self.flash_crimson_frames -= 1
        if self.wakeup_invuln > 0:
            self.wakeup_invuln -= 1
        if self.parry_cooldown > 0:
            self.parry_cooldown -= 1

        # Smooth trailing ghost HP drain
        if self.ghost_hp > self.hp:
            drain = max(24.0, (self.ghost_hp - self.hp) * 0.085)
            self.ghost_hp = max(float(self.hp), self.ghost_hp - drain)
        else:
            self.ghost_hp = float(self.hp)

        # Poise regenerates steadily when not actively blocking/guard-broken
        if not self.is_guarding and self.state != FighterState.GUARD_BREAK:
            self.poise = min(MAX_POISE, self.poise + 2)

        # Eclipse Overdrive countdown
        if self.eclipse_timer > 0:
            self.eclipse_timer -= 1

        self.stylish.update(FIXED_DT, in_combo=(opponent.combo_count > 0))

        # Hitstop freeze suspends motion & frame progression for crisp heavy impact feel!
        if self.hitstop_frames > 0:
            self.hitstop_frames -= 1
            return

        # Advance keyframe timing & trigger authored audio / swamp water splash cues
        frames = self.bank.get_keyframes(self.state)
        speed_boost = 1 if (self.is_eclipse and self.is_attacking and self.state_frame % 5 == 0) else 0
        self.state_frame += 1 + speed_boost
        self.kf_hold += 1 + speed_boost

        cur_kf = frames[clamp_int(self.kf_idx, 0, len(frames) - 1)]
        if self.kf_hold == 1:
            if cur_kf.water_splash > 0.05 and self.is_grounded:
                stage.spawn_water_ripple(self.x, intensity=cur_kf.water_splash)
            if cur_kf.sfx_cue is not None:
                pan = clamp((self.x - STAGE_CENTER_X) / 560.0, -0.8, 0.8)
                audio.play_sfx(cur_kf.sfx_cue, pan=pan)

        if self.kf_hold >= max(1, cur_kf.duration):
            self.kf_hold = 0
            if self.kf_idx + 1 < len(frames):
                self.kf_idx += 1
            else:
                # Loop cycling neutral states cleanly
                if self.state in (
                    FighterState.IDLE, FighterState.WALK_FWD, FighterState.WALK_BACK,
                    FighterState.CROUCH, FighterState.DASH_FWD, FighterState.JUMP_RISE,
                    FighterState.JUMP_APEX, FighterState.JUMP_FALL, FighterState.GUARD_STAND,
                    FighterState.GUARD_CROUCH, FighterState.GUARD_AIR, FighterState.WIN_POSE,
                ):
                    self.kf_idx = 0

        # Apply state velocity profiles
        facing_sign = 1.0 if self.facing_right else -1.0
        move_mult = 1.15 if self.is_eclipse else 1.0
        spec = self.move_reg.get(self.state)

        if self.state == FighterState.WALK_FWD:
            self.vx = facing_sign * WALK_FWD_SPEED * move_mult
        elif self.state == FighterState.WALK_BACK:
            self.vx = -facing_sign * WALK_BACK_SPEED * move_mult
        elif self.state == FighterState.DASH_FWD:
            self.vx = facing_sign * DASH_INIT_SPEED * move_mult
        elif self.state == FighterState.BACKDASH:
            if self.state_frame == 1:
                self.vx = facing_sign * BACKDASH_SPEED * move_mult
            else:
                self.vx *= 0.90
        elif self.state == FighterState.JUMP_SQUAT:
            self.vx *= 0.65
            if self.state_frame >= 4:
                _, latest_fr = self.input_buf.latest()
                self.vy = JUMP_VEL_Y
                if latest_fr.dx != 0:
                    self.vx = (JUMP_FWD_X if (latest_fr.dx * facing_sign > 0) else -JUMP_BACK_X) * (1.0 if latest_fr.dx > 0 else -1.0)
                else:
                    self.vx = 0.0
                self.enter_state(FighterState.JUMP_RISE)
        elif spec is not None and spec.vel_profile:
            applied = False
            for f0, f1, mvx, mvy in spec.vel_profile:
                if f0 <= self.state_frame <= f1:
                    self.vx = facing_sign * mvx * move_mult
                    if abs(mvy) > 0.01:
                        self.vy = mvy
                    applied = True
                    break
            if not applied and self.is_grounded:
                self.vx *= 0.80
        elif self.is_grounded:
            self.vx *= 0.80

        # Gravity & vertical motion
        if not self.is_grounded or self.vy < 0.0:
            self.vy = min(MAX_FALL_SPEED, self.vy + GRAVITY)
        self.x += self.vx
        self.y += self.vy

        # Clamp arena walls
        self.x = clamp(self.x, STAGE_LEFT_WALL, STAGE_RIGHT_WALL)

        # Ground landing transitions
        if self.y >= GROUND_Y:
            was_air = not self.is_grounded or self.vy > 2.5
            self.y = GROUND_Y
            if self.state == FighterState.HIT_LAUNCH:
                self.vy = 0.0
                self.vx *= 0.45
                if self.hp <= 0:
                    self.enter_state(FighterState.KO_FALL)
                else:
                    self.enter_state(FighterState.KNOCKDOWN)
                    self.stun_frames = 28
            elif self.state in (
                FighterState.JUMP_RISE, FighterState.JUMP_APEX, FighterState.JUMP_FALL,
                FighterState.GUARD_AIR, FighterState.ATTACK_JL, FighterState.ATTACK_JM,
                FighterState.ATTACK_JH, FighterState.ATTACK_J2H, FighterState.SP_CATHEDRAL_DESCENT,
            ):
                self.vy = 0.0
                self.vx *= 0.4
                self.enter_state(FighterState.LAND)
                stage.spawn_water_ripple(self.x, intensity=1.0)
            else:
                self.vy = 0.0
                if was_air and self.state == FighterState.SP_VALKYRIE_FANG and self.state_frame > 18:
                    self.enter_state(FighterState.LAND)

        # Airborne rise -> apex -> fall animation transitions
        if not self.is_grounded:
            if self.state == FighterState.JUMP_RISE and self.vy > -3.5:
                self.enter_state(FighterState.JUMP_APEX)
            elif self.state == FighterState.JUMP_APEX and self.vy > 2.5:
                self.enter_state(FighterState.JUMP_FALL)

        # Stun countdown & automatic state recovery
        if self.stun_frames > 0:
            self.stun_frames -= 1
            if self.stun_frames <= 0:
                if self.state == FighterState.KNOCKDOWN:
                    if self.hp <= 0:
                        self.enter_state(FighterState.KO_FALL)
                    else:
                        self.enter_state(FighterState.WAKEUP)
                        self.wakeup_invuln = 18
                elif self.state in (
                    FighterState.HIT_STAND_LIGHT, FighterState.HIT_STAND_HEAVY,
                    FighterState.HIT_CROUCH, FighterState.GUARD_STAND, FighterState.GUARD_CROUCH,
                    FighterState.GUARD_BREAK,
                ):
                    self.combo_count = 0
                    self.combo_damage = 0
                    self.juggle_decay = 0
                    self.enter_state(FighterState.CROUCH if self.state == FighterState.GUARD_CROUCH else FighterState.IDLE)

        # Attack / recovery completion transitions
        if spec is not None and self.state_frame >= spec.total_frames:
            if self.is_grounded:
                self.enter_state(FighterState.IDLE)
            else:
                self.enter_state(FighterState.JUMP_FALL)
        elif self.state in (
            FighterState.CROUCH_ENTER, FighterState.LAND, FighterState.DASH_STOP,
            FighterState.BACKDASH, FighterState.PARRY_SUCCESS, FighterState.CLASH_RECOIL,
            FighterState.THROW_TECH, FighterState.WAKEUP, FighterState.TAUNT, FighterState.INTRO_POSE,
        ):
            total_dur = sum(k.duration for k in frames)
            if self.state_frame >= total_dur:
                if self.state == FighterState.CROUCH_ENTER:
                    self.enter_state(FighterState.CROUCH)
                else:
                    self.enter_state(FighterState.IDLE)

        # Auto-face opponent whenever neutral on the ground
        if self.is_grounded and self.state in (FighterState.IDLE, FighterState.WALK_FWD, FighterState.WALK_BACK, FighterState.CROUCH):
            if abs(opponent.x - self.x) > 8.0:
                self.facing_right = (opponent.x >= self.x)


