class OptionsScreen:
    def __init__(self, settings: GameSettings, fonts: FontManager) -> None:
        self.settings = settings
        self.fonts = fonts
        self.cursor: int = 0
        self.rows: Tuple[str, ...] = (
            "MASTER VOLUME",
            "OST MUSIC VOLUME",
            "COMBAT SFX VOLUME",
            "WINDOW SCALE (800x600 PIXEL LOCK)",
            "FULLSCREEN MODE",
            "CRT SCANLINE FILTER",
            "R18+ BLOOD CHOREOGRAPHY",
            "SCREEN SHAKE & IMPACT",
            "SHOW FPS COUNTER",
            "ROUND TIMER",
        )

    def handle_key(self, key: int) -> Tuple[bool, bool]:
        """Returns (exit_screen, display_changed)."""
        disp_changed = False
        if key in (pygame.K_ESCAPE, pygame.K_BACKSPACE):
            return (True, False)
        if key in (pygame.K_UP, pygame.K_w):
            self.cursor = (self.cursor - 1) % len(self.rows)
        elif key in (pygame.K_DOWN, pygame.K_s):
            self.cursor = (self.cursor + 1) % len(self.rows)
        elif key in (pygame.K_LEFT, pygame.K_a, pygame.K_RIGHT, pygame.K_d, pygame.K_RETURN):
            d = -1 if key in (pygame.K_LEFT, pygame.K_a) else 1
            s = self.settings
            if self.cursor == 0:
                s.master_volume = round(clamp(s.master_volume + d * 0.1, 0.0, 1.0), 1)
            elif self.cursor == 1:
                s.bgm_volume = round(clamp(s.bgm_volume + d * 0.1, 0.0, 1.0), 1)
            elif self.cursor == 2:
                s.sfx_volume = round(clamp(s.sfx_volume + d * 0.1, 0.0, 1.0), 1)
            elif self.cursor == 3:
                s.window_scale = clamp_int(s.window_scale + d, 1, 2)
                disp_changed = True
            elif self.cursor == 4:
                s.fullscreen = not s.fullscreen
                disp_changed = True
            elif self.cursor == 5:
                s.crt_scanlines = not s.crt_scanlines
            elif self.cursor == 6:
                s.blood_intensity = round(clamp(s.blood_intensity + d * 0.25, 0.25, 1.5), 2)
            elif self.cursor == 7:
                s.screen_shake = not s.screen_shake
            elif self.cursor == 8:
                s.show_fps = not s.show_fps
            elif self.cursor == 9:
                choices = (60, 99, -1)
                idx = choices.index(s.round_time) if s.round_time in choices else 1
                s.round_time = choices[(idx + d) % len(choices)]
        return (False, disp_changed)

    def render(self, dest: pygame.Surface, stage: CursedCathedralStage) -> None:
        stage.render_background(dest, STAGE_CENTER_X, 0.0)
        veil = pygame.Surface((INTERNAL_W, INTERNAL_H), pygame.SRCALPHA)
        veil.fill((12, 4, 18, 208))
        dest.blit(veil, (0, 0))
        self.fonts.draw_text(dest, "SYSTEM OPTIONS & DISPLAY CONFIGURATION", 400, 22, size=22, color=(255, 228, 168), style="serif", bold=True, align="center")
        draw_gothic_filigree_panel(dest, pygame.Rect(88, 66, 624, 468), bg_alpha=215)

        s = self.settings
        vals = (
            f"{int(s.master_volume * 100)}%",
            f"{int(s.bgm_volume * 100)}%",
            f"{int(s.sfx_volume * 100)}%",
            f"{s.window_scale}x ({800 * s.window_scale}x{600 * s.window_scale} NEAREST)",
            "ON" if s.fullscreen else "OFF",
            "ON" if s.crt_scanlines else "OFF",
