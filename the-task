    def check_account(self) -> None:
        self.account_label.setText("Checking account\u2026")

        def done(u: Dict[str, Any]) -> None:
            kd = u.get("kudos", 0) or 0
            self.account_label.setText(f"{u.get('username', '?')}  \u2022  {kd:,.0f} kudos  \u2022  concurrency {u.get('concurrency', '?')}"
                                       + ("  \u2022  trusted" if u.get("trusted") else ""))
            self._set_horde_line(account=f"{u.get('username', '?')}  {kd:,.0f} kudos")

        self._run_task(self.api.find_user, done, lambda err: (self.account_label.setText(f"Account check failed: {err}"),
                                                              self._set_horde_line(account="key not accepted" if "401" in err or "Invalid" in err else "")))

    def refresh_horde(self) -> None:
        self.hb_label.setText("Contacting the Horde\u2026")

        def hb_done(d: Dict[str, Any]) -> None:
            txt = f"Horde {d.get('message', '?')}  \u2022  API v{d.get('version', '?')}  \u2022  {d.get('threads', '?')} threads  \u2022  queue {d.get('queue', '?')}"
            self.hb_label.setText(txt)
            self._set_horde_line(horde=f"HORDE {d.get('message', '?')}  v{d.get('version', '?')}")

        self._run_task(self.api.heartbeat, hb_done, lambda err: (self.hb_label.setText(f"Horde unreachable: {err}"), self._set_horde_line(horde="HORDE OFFLINE?")))

        def models_done(lst: List[Dict[str, Any]]) -> None:
            by_name = {m.get("name"): m for m in lst if isinstance(m, dict)}
            for name, lb in self.model_status_labels.items():
                m = by_name.get(name)
                if m:
                    lb.setText(f"{name}:  {m.get('count', 0)} worker(s)  \u2022  {int(m.get('jobs', 0))} jobs queued  \u2022  ETA {fmt_secs(m.get('eta'))}")
                    self.model_btns[name].setToolTip(f"{MODELS[name]['hint']}\n{m.get('count', 0)} worker(s) online, ETA {fmt_secs(m.get('eta'))}")
                else:
                    lb.setText(f"{name}:  no worker online right now")
                    self.model_btns[name].setToolTip(f"{MODELS[name]['hint']}\nNo worker online right now")

        self._run_task(self.api.models, models_done, lambda err: None)

    def _set_horde_line(self, horde: Optional[str] = None, account: Optional[str] = None) -> None:
        cur = getattr(self, "_horde_bits", {"horde": "", "account": ""})
        if horde is not None:
            cur["horde"] = horde
        if account is not None:
            cur["account"] = account
        self._horde_bits = cur
        self.horde_line.setText("   \u2022   ".join(b for b in (cur["horde"], cur["account"]) if b))

    def load_samplers(self) -> None:
        def done(doc: Dict[str, Any]) -> None:
            live = list((doc.get("samplers") or {}).keys())
            if not live:
                self.sampler_status.setText(f"{len(self.samplers)} samplers (built-in list) - live list empty")
                return
            rec = list((doc.get("presentation_tiers") or {}).get("recommended") or [])
            merged = [s for s in rec if s in live] + sorted(s for s in live if s not in rec)
            for s in SAMPLERS_BUILTIN:
                if s not in merged:
                    merged.append(s)
            self.samplers = merged
            cur = self.sampler_combo.currentText()
            self.sampler_combo.blockSignals(True)
            self.sampler_combo.clear()
            self.sampler_combo.addItems(self.samplers)
            self._select_combo(self.sampler_combo, cur)
            self.sampler_combo.blockSignals(False)
            self.sampler_status.setText(f"{len(live)} samplers loaded live from the Horde ({len(rec)} recommended first)")
            self.append_log(f"sampler list refreshed: {len(live)} samplers available")

        self._run_task(self.api.sampler_constraints, done,
                       lambda err: self.sampler_status.setText(f"{len(self.samplers)} samplers (built-in list) - live fetch failed: {err}"))

    def dry_run(self) -> None:
        final, _r, _n = self._compose()
        if not final:
            self.dry_label.setText("Type a prompt first.")
            return
        payload, _meta = self.build_payload(dry_run=True)
        self.dry_label.setText("Asking the Horde\u2026")

        def done(res: Dict[str, Any]) -> None:
            warn = "; ".join(w.get("message", "") for w in res.get("warnings", []) or [])
            self.dry_label.setText(f"Estimated cost: {res.get('kudos', '?')} kudos" + (f"  \u2022  {warn}" if warn else ""))

        self._run_task(lambda: self.api.submit(payload), done, lambda err: self.dry_label.setText(f"Dry run refused: {err}"))

    def reset_options(self) -> None:
        for k, cb in self.opt_checks.items():
