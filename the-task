class ElideLabel(QLabel):
    def __init__(self, text: str = "", parent: Optional[QWidget] = None) -> None:
        super().__init__(parent)
        self._full = text
        # v4 FIX: Preferred (not Ignored) - Ignored starved these labels to
        # their 12px minimum even with stretch, collapsing every section title
        # in the app to an ellipsis. Preferred lets them expand to the text
        # width when space allows, while minimumSizeHint() keeps them from
        # ever forcing a layout wider than its container (they elide instead).
        self.setSizePolicy(QSizePolicy.Policy.Preferred, QSizePolicy.Policy.Preferred)
        super().setText(text)

    def minimumSizeHint(self) -> QSize:  # noqa: N802
        """Never push a layout wider than needed — elide instead of forcing width."""
        fm = QFontMetrics(self.font())
        return QSize(12, fm.height() + 2)

    def setText(self, text: str) -> None:  # noqa: N802
        self._full = text or ""
        self._apply_elide()

    def full_text(self) -> str:
        return self._full

    def resizeEvent(self, event) -> None:  # noqa: N802
        super().resizeEvent(event)
        self._apply_elide()

    def _apply_elide(self) -> None:
        fm = QFontMetrics(self.font())
        avail = max(20, self.width() - 10)
        super().setText(fm.elidedText(self._full, Qt.TextElideMode.ElideRight, avail))


