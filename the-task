class Deck(QFrame):
    """Command deck: lacquer plate with faint scanlines (painted from the
    live theme palette, so it follows theme switches)."""

    def paintEvent(self, _e) -> None:  # noqa: N802
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5)
        g = QLinearGradient(0, r.top(), 0, r.bottom())
        g.setColorAt(0, QColor(PAL["deck_hi"]))
        g.setColorAt(1, QColor(PAL["deck_lo"]))
        p.setPen(QPen(QColor(PAL["deck_border"]), 1))
        p.setBrush(QBrush(g))
        p.drawRoundedRect(r, 7, 7)
        p.setPen(QPen(QColor(255, 255, 255, 14), 1))
        y = int(r.top()) + 4
        while y < r.bottom() - 2:
            p.drawLine(int(r.left()) + 6, y, int(r.right()) - 6, y)
            y += 3
        p.setPen(QPen(QColor(255, 255, 255, 48), 1))
        p.drawLine(int(r.left()) + 8, int(r.top()) + 1, int(r.right()) - 8, int(r.top()) + 1)
        p.end()


