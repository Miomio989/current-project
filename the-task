        except OSError:
            return None
        if isinstance(cache, tuple) and cache[0] == mtime and isinstance(cache[1], QImage):
            return cache[1]
        reader = QImageReader(path)
        reader.setAutoTransform(True)
        reader.setScaledSize(QSize(max(1, w), max(1, h)))
        img = reader.read()
        if img.isNull():
            return None
        t[key] = (mtime, img)
        return img

    def refresh(self) -> None:
        run = self._run
        if run is None or not run.get("plan"):
            return
        plan = run["plan"]
        avail = self.size() - QSize(12, 12)
        if avail.width() < 24 or avail.height() < 24:
            return
        pw, ph = avail.width(), avail.height()
        if plan["out_h"] * pw > plan["out_w"] * ph:
            pw = max(24, int(plan["out_w"] * ph / plan["out_h"]))
        else:
            ph = max(24, int(plan["out_h"] * pw / plan["out_w"]))
        img = QImage(pw, ph, QImage.Format.Format_ARGB32)
        # The neural base (single whole-image upscale) is laid under everything
        # once it exists; before that the canvas shows the purple placeholder.
        base_path = run.get("base_path") or ""
        base_thumb = None
        if base_path and os.path.exists(base_path):
            base_thumb = self._tile_thumb(run, "_thumb_base", base_path, pw, ph)
        if base_thumb is not None:
            img.fill(QColor(PAL["deep"]))
            p = QPainter(img)
            p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
            p.setOpacity(0.55)
            p.drawImage(QPointF(0, 0), base_thumb)
            p.setOpacity(1.0)
        else:
            img.fill(QColor(PAL["fill"]))                 # the purple
            p = QPainter(img)
            p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
        sx, sy = pw / max(1, plan["out_w"]), ph / max(1, plan["out_h"])
        for t in run.get("tiles") or []:
            if str(t.get("state")) != TILE_DONE:
                continue
            thumb = self._tile_thumb(t, "_thumb_done", t["tile_path"],
                                     max(1, int(t["w"] * sx)), max(1, int(t["h"] * sy)))
            if thumb is None:
                continue
            p.drawImage(QPointF(t["x"] * sx, t["y"] * sy), thumb)
        p.setOpacity(1.0)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        pen = QPen(QColor(255, 255, 255, 52), 1)
        pen.setStyle(Qt.PenStyle.DotLine)
        p.setPen(pen)
        for t in run.get("tiles") or []:
            p.drawRect(QRectF(t["x"] * sx, t["y"] * sy, t["w"] * sx, t["h"] * sy))
        p.end()
        self.setText("")
        self.setPixmap(QPixmap.fromImage(img))


class ElideLabel(QLabel):
    """QLabel that elides its text instead of clipping it."""

    def __init__(self, text: str = "", parent: Optional[QWidget] = None):
        super().__init__(parent)
        self._full = text
        self.setMinimumWidth(40)
        super().setText(text)

    def setText(self, text: str) -> None:  # noqa: N802
        self._full = text
        self._apply()

    def full_text(self) -> str:
        return self._full

    def resizeEvent(self, e) -> None:  # noqa: N802
        super().resizeEvent(e)
        self._apply()

    def sizeHint(self) -> QSize:  # noqa: N802
        base = super().sizeHint()
        want = self.fontMetrics().horizontalAdvance(self._full) + 26
        if self.maximumWidth() < 16777215:
            want = min(want, self.maximumWidth())
        return QSize(want, base.height())

    def minimumSizeHint(self) -> QSize:  # noqa: N802
        return QSize(40, super().minimumSizeHint().height())

    def _apply(self) -> None:
        m = self.contentsMargins()
        avail = max(10, self.width() - m.left() - m.right() - 20)
        super().setText(self.fontMetrics().elidedText(self._full, Qt.TextElideMode.ElideRight, avail))
        self.updateGeometry()


class SectionHeader(QWidget):
    """Glossy ribbon header with a warm diamond marker; optionally collapsible."""
    clicked = pyqtSignal()

    def __init__(self, title: str, collapsible: bool = False, parent: Optional[QWidget] = None):
        super().__init__(parent)
        self.title = title
        self.collapsible = collapsible
        self.expanded = True
        self.setFixedHeight(28)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
        if collapsible:
            self.setCursor(Qt.CursorShape.PointingHandCursor)
        self._lay = QHBoxLayout(self)
        self._lay.setSpacing(4)
        self._lay.addStretch()
        self._reserve_title()

    def _reserve_title(self) -> None:
        fm = QFontMetrics(_font(9.5, True, 1.2))
        left = 10 + (14 if self.collapsible else 0) + 16 + fm.horizontalAdvance(self.title.upper()) + 10
        self._lay.setContentsMargins(left, 2, 6, 2)

    def add_right(self, w: QWidget) -> None:
        self._lay.addWidget(w)

    def set_title(self, t: str) -> None:
        self.title = t
        self._reserve_title()
        self.update()

    def mousePressEvent(self, e) -> None:  # noqa: N802
        if self.collapsible and e.button() == Qt.MouseButton.LeftButton:
            self.clicked.emit()
        super().mousePressEvent(e)

    def paintEvent(self, _e) -> None:  # noqa: N802
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = self.rect().adjusted(0, 0, -1, -1)
        g = QLinearGradient(0, r.top(), 0, r.bottom())
        g.setColorAt(0.0, QColor(PAL["sh_g0"]))
        g.setColorAt(0.5, QColor(PAL["sh_g1"]))
        g.setColorAt(0.52, QColor(PAL["sh_g2"]))
        g.setColorAt(1.0, QColor(PAL["sh_g3"]))
        p.setPen(QPen(QColor(PAL["sh_border"]), 1))
        p.setBrush(QBrush(g))
        p.drawRoundedRect(QRectF(r).adjusted(0.5, 0.5, 0, 0), 4, 4)
        p.setPen(QPen(QColor(255, 255, 255, 38), 1))
        p.drawLine(r.left() + 4, r.top() + 1, r.right() - 4, r.top() + 1)
        # accent stripe at the bottom
        ag = QLinearGradient(r.left(), 0, r.right(), 0)
        ag.setColorAt(0.0, QColor(PAL["acc"]))
        ag.setColorAt(0.6, QColor(PAL["acc_lo"]))
        ag.setColorAt(1.0, QColor(0, 0, 0, 0))
        p.setPen(QPen(QBrush(ag), 2))
        p.drawLine(r.left() + 2, r.bottom(), r.right() - 2, r.bottom())
        x = 10
        if self.collapsible:
            path = QPainterPath()
            cy = r.center().y()
            if self.expanded:
                path.moveTo(x, cy - 3); path.lineTo(x + 8, cy - 3); path.lineTo(x + 4, cy + 3)
            else:
                path.moveTo(x, cy - 4); path.lineTo(x + 6, cy); path.lineTo(x, cy + 4)
            path.closeSubpath()
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QColor(PAL["sh_arrow"]))
            p.drawPath(path)
            x += 14
        # diamond marker
        cy = r.center().y()
        dia = QPainterPath()
        dia.moveTo(x + 4, cy - 5); dia.lineTo(x + 9, cy); dia.lineTo(x + 4, cy + 5); dia.lineTo(x - 1, cy)
        dia.closeSubpath()
        rg = QRadialGradient(x + 3, cy - 2, 7)
        rg.setColorAt(0, QColor(PAL["sh_diamond_hi"]))
        rg.setColorAt(1, QColor(PAL["acc_lo"]))
        p.setPen(QPen(QColor(PAL["acc_dk"]), 1))
        p.setBrush(QBrush(rg))
        p.drawPath(dia)
        x += 16
        p.setFont(_font(9.5, True, 1.2))
        p.setPen(QColor(0, 0, 0, 120))
        p.drawText(QRect(x + 1, r.top() + 1, r.width() - x, r.height() - 1), Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft, self.title.upper())
        p.setPen(QColor(PAL["sh_title"]))
        p.drawText(QRect(x, r.top(), r.width() - x, r.height() - 1), Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft, self.title.upper())
        p.end()


class Collapsible(QWidget):
