    def _on_bridge_port_changed(self) -> None:
        if self.bridge is not None and self.bridge.running:
            self._bridge_stop()
            self._bridge_start()
        self._update_server_status()
        self._schedule_save()

    def _bridge_start(self) -> None:
        if self.bridge is not None and self.bridge.running:
            if self.bridge.port == self.bridge_port_spin.value():
                return
            self._bridge_stop()
        token = getattr(self, "_bridge_token", "") or (self.settings.get("bridge", {}) or {}).get("token", "")
        if not token:
            token = secrets.token_hex(8)
            self._bridge_token = token
            self.settings.setdefault("bridge", {})["token"] = token
            self.bridge_token_edit.setText(token)
        bridge = BrowserBridge(self.bridge_port_spin.value(), token)
        if bridge.start():
            self.bridge = bridge
            self.api.bridge = bridge
            self.append_log(f"browser bridge listening on 127.0.0.1:{bridge.port} "
                            "(waiting for the Tampermonkey userscript to connect)")
        else:
            self.bridge = None
            self.api.bridge = None
            self.append_log(f"browser bridge could not start: {bridge.last_error}")
            self.bridge_check.blockSignals(True)
            self.bridge_check.setChecked(False)
            self.bridge_check.blockSignals(False)
            self.bridge_status.setText(f"Failed to start: {bridge.last_error}")

    def _bridge_stop(self) -> None:
        if self.bridge is not None:
            self.bridge.stop()
            self.append_log("browser bridge stopped - requests use the direct connection again")
        self.bridge = None
        self.api.bridge = None

    def _copy_bridge_token(self) -> None:
        QApplication.clipboard().setText(getattr(self, "_bridge_token", "") or self.bridge_token_edit.text())
        self._flash_summary("Bridge token copied")

