# SECTION 9: HIGH-SPEED PROGRESSIVE SPRITE BANK & PORTRAIT CACHE
# ==============================================================================


class SpriteBank:
    """
    Palette-aware LRU sprite cache backed by CeciliaMasterArtist.
    Pre-bakes core neutral/combat frames during boot loading so gameplay runs
    at locked 60 FPS, and lazily bakes exotic frames on demand in ~4-8ms.
    """

    def __init__(
        self,
        artist: CeciliaMasterArtist,
        atlas: Dict[FighterState, List[CelKeyframePlate]],
    ) -> None:
        self.artist = artist
        self.atlas = atlas
        self._cache: Dict[Tuple[int, str, bool, bool], pygame.Surface] = {}
        self._hud_portraits: Dict[Tuple[int, bool, ExpressionId], pygame.Surface] = {}
        self._cutins: Dict[Tuple[int, str, bool], pygame.Surface] = {}
        self._prebake_queue: List[Tuple[int, FighterState]] = []
        self._prebake_cursor: int = 0
        self._init_prebake_plan()

    def _init_prebake_plan(self) -> None:
        core_states = (
            FighterState.IDLE,
            FighterState.IDLE_BATTLE_BREATH,
            FighterState.WALK_FWD,
            FighterState.WALK_BACK,
            FighterState.CROUCH_HOLD,
            FighterState.DASH_FWD,
            FighterState.JUMP_RISE,
            FighterState.JUMP_FALL,
            FighterState.ATK_5A,
            FighterState.ATK_5B,
            FighterState.ATK_5C,
            FighterState.ATK_6B,
            FighterState.GUARD_STAND,
            FighterState.HIT_MID,
        )
        for st in core_states:
            if st in self.atlas:
                self._prebake_queue.append((0, st))

    def step_prebake(self, max_frames: int = 4) -> float:
        """Bake a small slice of core frames per loading tick; returns [0..1]."""
        if not self._prebake_queue:
            return 1.0
        baked_now = 0
        while self._prebake_cursor < len(self._prebake_queue) and baked_now < max_frames:
            pal_idx, st = self._prebake_queue[self._prebake_cursor]
            frames = self.atlas.get(st, [])
            for idx, kf in enumerate(frames):
                self.get_sprite(pal_idx, kf, facing_right=True, eclipse=False, frame_seed=idx)
                baked_now += 1
            self._prebake_cursor += 1
        # Also pre-bake P1 and Rival default HUD portraits at completion
        if self._prebake_cursor >= len(self._prebake_queue):
            self.get_hud_portrait(0, True, ExpressionId.SERENE)
            self.get_hud_portrait(1, False, ExpressionId.CONFIDENT_SMIRK)
            return 1.0
        return self._prebake_cursor / float(len(self._prebake_queue))

    def get_sprite(
        self,
        pal_idx: int,
        kf: CelKeyframePlate,
        facing_right: bool = True,
        eclipse: bool = False,
        frame_seed: int = 0,
    ) -> pygame.Surface:
        key = (pal_idx, kf.frame_id, facing_right, eclipse)
        surf = self._cache.get(key)
        if surf is not None:
            return surf

        # Render right-facing canonical version first & mirror cheaply for left!
        canon_key = (pal_idx, kf.frame_id, True, eclipse)
        canon = self._cache.get(canon_key)
        if canon is None:
            pal = CECILIA_PALETTES[pal_idx % len(CECILIA_PALETTES)]
            canon = self.artist.render_keyframe_sprite(kf, pal, eclipse_mode=eclipse, frame_seed=frame_seed)
            if len(self._cache) > 1600:
                # Evict oldest 300 entries to stay low-RAM laptop friendly
                for k_evict in list(self._cache.keys())[:300]:
                    del self._cache[k_evict]
            self._cache[canon_key] = canon

        if facing_right:
            return canon
        flipped = pygame.transform.flip(canon, True, False)
        self._cache[key] = flipped
        return flipped

    def get_hud_portrait(
        self,
        pal_idx: int,
        facing_right: bool = True,
        expr: ExpressionId = ExpressionId.SERENE,
        size: int = 74,
    ) -> pygame.Surface:
        key = (pal_idx, facing_right, expr)
        surf = self._hud_portraits.get(key)
        if surf is None:
            pal = CECILIA_PALETTES[pal_idx % len(CECILIA_PALETTES)]
            surf = self.artist.render_hud_portrait(pal, size=size, facing_right=facing_right, expr=expr)
            self._hud_portraits[key] = surf
        return surf

    def get_super_cutin(
        self, pal_idx: int, super_name: str, facing_right: bool = True
    ) -> pygame.Surface:
        key = (pal_idx, super_name, facing_right)
        surf = self._cutins.get(key)
        if surf is None:
            pal = CECILIA_PALETTES[pal_idx % len(CECILIA_PALETTES)]
            surf = self.artist.render_super_cutin_banner(pal, super_name, facing_right=facing_right)
            self._cutins[key] = surf
        return surf
