        )
        p_ws = [lerp(14.0 * sc, 2.0 * sc, i / 14.0) for i in range(15)]
        self.rast.paint_glossy_hair_strand(surf, p_curve, p_ws, pal, sheen_u=0.35, rim_side=1.0, ink_width=2.2)

        # High-collar gothic bodice shoulders + ruby brooch + crimson jabot
        sh_poly = [
            Vec2(cx - 42 * sc, cy + 56 * sc),
            Vec2(cx - 28 * sc, cy + 28 * sc),
            Vec2(cx - 10 * sc, cy + 20 * sc),
