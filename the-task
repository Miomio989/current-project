        # Fine socks and trainers: uppers are colored on the continuous base mesh.
        for y,z,r in ((.335,.17,.004),(.292,.19,.004)):
            meshes.append(curve_mesh("Sock rib",[(side*.22+u*.11,y,z+.02*math.sin(math.pi*(u+1)/2))
                                 for u in [-1,-.66,-.33,0,.33,.66,1]],r,(191,188,182),5,4))
        for n in range(3):
            yy=.192-n*.035
            lace=[(side*.22-.058,yy,.307+n*.004),(side*.22+.055,yy-.008,.307+n*.004)]
            meshes.append(curve_mesh("Sneaker lacing",lace,.0048,(88,91,102),5,5))
        meshes.append(curve_mesh("Sneaker side panel",bezier_points((side*.31,.19,.245),
                             (side*.36,.18,.25),(side*.365,.125,.26),(side*.31,.125,.33),12),
                             .005,(120,121,130),5,5))
    meshes.append(curve_mesh("Center neckline stitch",[(0,2.725,.241),(0,2.68,.248)],.003,(116,114,125),5,5))
    return meshes


class Rig:
    """A compact hierarchical joint rig with smooth weights at every attachment."""
    def __init__(self):
        self.pose=0
        self.time=0.0
        self.poses=["At ease","Wave","Look back","Runway"]

    def deform(self,p):
        x,y,z=p
        t=self.time
        wave=math.sin(t*3.0)*.12
        if y>3.18:
            w=smooth(3.18,3.44,y)
            angle=[.018,-.085,.13,-.08][self.pose]+math.sin(t*1.15)*.016
            q=rotate_z(p,angle,(0,3.28,0))
            return tuple(mix(p[i],q[i],w) for i in range(3))
        if abs(x)>.345 and 1.83<y<3.10:
            side=1 if x>0 else -1
            weight=smooth(.345,.48,abs(x))*smooth(1.83,2.04,y)
            shoulder=(side*.355,2.91,0)
            upper_angle=side*([.035,-.02,.14,-.16][self.pose]+wave*.08)
            if self.pose==1 and side==1: upper_angle=-2.45+wave
            q=rotate_z(p,upper_angle,shoulder)
            if y<2.51:
                elbow=rotate_z((side*.48,2.52,.01),upper_angle,shoulder)
                lower_angle=side*(.055 if self.pose!=1 else -.55)
                q2=rotate_z(q,lower_angle,elbow)
                q=tuple(mix(q[i],q2[i],smooth(2.54,2.43,y)) for i in range(3))
            return tuple(mix(p[i],q[i],weight) for i in range(3))
        if y<1.99 and abs(x)>.085:
            side=1 if x>0 else -1
            angle=side*[.003,.035,.035,.095][self.pose]
            q=rotate_z(p,angle,(side*.20,1.98,-.02))
            if y<1.12:
                knee=rotate_z((side*.21,1.12,-.02),angle,(side*.20,1.98,-.02))
                r=rotate_z(q,side*([0,0,.035,-.09][self.pose]),knee)
                q=tuple(mix(q[i],r[i],smooth(1.18,.98,y)) for i in range(3))
            weight=smooth(.085,.21,abs(x))*smooth(2.0,1.82,y)
            return tuple(mix(p[i],q[i],weight) for i in range(3))
        return p


class Renderer:
    def __init__(self,width=1100,height=800):
        self.width,self.height=width,height
        self.yaw=-.26
        self.pitch=-.035
        self.zoom=1.0
        self.target_y=2.05
        self.wire=False
        self.angle_speed=.25
        self.auto=True
        self.bg=None
        self.font=pygame.font.SysFont("arial",15)
        self.small=pygame.font.SysFont("arial",12)
        self.heading=pygame.font.SysFont("georgia",45)
        self.subtitle=pygame.font.SysFont("arial",13,bold=True)
        self._background()

    def _background(self):
        bg=pygame.Surface((self.width,self.height))
        for y in range(self.height):
            t=y/self.height
            color=mix_color((32,37,51),(14,19,30),t)
            pygame.draw.line(bg,color,(0,y),(self.width,y))
        center=(int(self.width*.51),int(self.height*.48))
        glow=pygame.Surface((self.width,self.height),pygame.SRCALPHA)
        for radius in range(390,20,-5):
            alpha=int(2.0*(1-radius/420))
            pygame.draw.circle(glow,(103,87,131,alpha),center,radius,5)
        bg.blit(glow,(0,0))
        self.bg=bg

    def camera(self,p):
        x,y,z=p
        c,s=math.cos(self.yaw),math.sin(self.yaw)
        x,z=c*x+s*z,-s*x+c*z
        y-=self.target_y
        c,s=math.cos(self.pitch),math.sin(self.pitch)
        y,z=c*y-s*z,s*y+c*z
        return (x,y,z)

    def project(self,p):
        x,y,z=p
        scale=min(self.width/3.6,self.height/4.85)*self.zoom
        perspective=5.8/(5.8-z)
        return (int(self.width*.51+x*scale*perspective),int(self.height*.51-y*scale*perspective))

    def ground(self,surface):
        cx=int(self.width*.51); cy=int(self.height*.51+2.05*min(self.width/3.6,self.height/4.85)*self.zoom)
        floor=pygame.Surface((self.width,self.height),pygame.SRCALPHA)
        for i in range(8,0,-1):
            pygame.draw.ellipse(floor,(7,9,17,6+i*2),(cx-155-i*13,cy-12-i*3,310+i*26,24+i*6))
        pygame.draw.ellipse(floor,(170,149,182,27),(cx-113,cy-20,226,40),1)
        surface.blit(floor,(0,0))

    def draw(self,surface,meshes,rig,ui=True):
        surface.blit(self.bg,(0,0))
        self.ground(surface)
        triangles=[]
        for mesh in meshes:
            coords=[self.camera(rig.deform(p)) for p in mesh.vertices]
            projected=[self.project(p) for p in coords]
            for face,color in zip(mesh.faces,mesh.colors):
                a,b,c=face
                p,q,r=coords[a],coords[b],coords[c]
                normal=cross(sub(q,p),sub(r,p))
                length=math.sqrt(dot(normal,normal))
                if length<1e-9: continue
                n=(normal[0]/length,normal[1]/length,normal[2]/length)
                if not mesh.double_sided and n[2]<-.08: continue
                if mesh.double_sided and n[2]<0: n=(-n[0],-n[1],-n[2])
                light=clamp(.82+.15*dot(n,unit((-.53,.73,.80)))+.04*n[2],.55,1.08)
                if color==WHITE or color==(255,252,255): light=max(light,.88)
                shaded=tuple(int(clamp(v*light,0,255)) for v in color)
                depth=(p[2]+q[2]+r[2])/3 + mesh.priority*.00012
                triangles.append((depth,shaded,(projected[a],projected[b],projected[c])))
        triangles.sort(key=lambda t:t[0])
        for _,color,poly in triangles:
            pygame.draw.polygon(surface,color,poly)
            if self.wire: pygame.draw.polygon(surface,(130,167,169),poly,1)
        if ui:self.draw_ui(surface,rig,len(triangles))

    def text(self,surface,text,pos,font,color):
        surface.blit(font.render(text,True,color),pos)

    def draw_ui(self,surface,rig,triangle_count):
        w,h=self.width,self.height
        pane=pygame.Surface((w,h),pygame.SRCALPHA)
        pygame.draw.rect(pane,(10,14,24,165),(28,27,303,158),border_radius=17)
        pygame.draw.rect(pane,(10,14,24,150),(w-287,27,258,153),border_radius=17)
        pygame.draw.rect(pane,(10,14,24,165),(28,h-86,w-56,58),border_radius=14)
        surface.blit(pane,(0,0))
        self.text(surface,"CHARACTER STUDY   /   001",(50,45),self.subtitle,(198,172,212))
        self.text(surface,"Hiroko",(47,65),self.heading,(249,241,234))
        self.text(surface,"A procedural portrait in three dimensions",(51,127),self.font,(200,197,205))
        self.text(surface,"CHARACTER   /   RIGGED",(w-265,49),self.subtitle,(198,172,212))
        self.text(surface,"01  /  GRAPHITE HAIR",(w-265,82),self.small,(222,220,228))
        self.text(surface,"02  /  VIOLET EYES",(w-265,106),self.small,(222,220,228))
        self.text(surface,"03  /  CONTINUOUS MESH",(w-265,130),self.small,(222,220,228))
        self.text(surface,f"{triangle_count:,} visible facets  ·  {rig.poses[rig.pose]}",(w-265,153),self.small,(157,153,168))
        self.text(surface,"DRAG  orbit     SCROLL  zoom     1–4  pose     SPACE  turntable     W  wireframe     S  capture     R  reset",
                  (48,h-65),self.small,(229,226,233))
        self.text(surface,"PYGAME  /  PROCEDURAL 3D",(48,h-45),self.small,(156,151,171))


def main():
    parser=argparse.ArgumentParser(description="Hiroko — procedural character portfolio viewer")
    parser.add_argument("--render-once",metavar="FILE",help="Render one PNG frame and exit (works with SDL_VIDEODRIVER=dummy)")
    parser.add_argument("--size",default="1100x800",help="Window dimensions, e.g. 1100x800")
    args=parser.parse_args()
    try:
        width,height=[int(v) for v in args.size.lower().split("x")]
        if width<500 or height<450: raise ValueError()
    except ValueError:
        parser.error("--size must be WIDTHxHEIGHT, at least 500x450")
    pygame.init()
    pygame.display.set_caption("HIROKO  /  Character Study")
    screen=pygame.display.set_mode((width,height),pygame.RESIZABLE)
    meshes=[make_body()]+make_hair()+make_face()+make_details()
    rig=Rig()
    renderer=Renderer(width,height)
    if args.render_once:
        renderer.draw(screen,meshes,rig)
        pygame.image.save(screen,args.render_once)
        print("Saved",args.render_once)
        pygame.quit()
        return
    clock=pygame.time.Clock()
    dragging=False
    running=True
    while running:
        dt=min(clock.tick(36)/1000,.07)
        rig.time+=dt
        if renderer.auto and not dragging: renderer.yaw+=renderer.angle_speed*dt
        for event in pygame.event.get():
            if event.type==pygame.QUIT: running=False
            elif event.type==pygame.VIDEORESIZE:
                width,height=max(500,event.w),max(450,event.h)
                screen=pygame.display.set_mode((width,height),pygame.RESIZABLE)
                renderer.width,renderer.height=width,height
                renderer._background()
            elif event.type==pygame.MOUSEBUTTONDOWN:
                if event.button==1: dragging=True
                if event.button==4: renderer.zoom=clamp(renderer.zoom*1.08,.55,2.1)
                if event.button==5: renderer.zoom=clamp(renderer.zoom/1.08,.55,2.1)
            elif event.type==pygame.MOUSEBUTTONUP and event.button==1: dragging=False
            elif event.type==pygame.MOUSEMOTION and dragging:
                renderer.yaw+=event.rel[0]*.007
                renderer.pitch=clamp(renderer.pitch+event.rel[1]*.005,-.65,.55)
            elif event.type==pygame.MOUSEWHEEL:
                renderer.zoom=clamp(renderer.zoom*(1.08**event.y),.55,2.1)
            elif event.type==pygame.KEYDOWN:
                if event.key==pygame.K_ESCAPE:running=False
                elif pygame.K_1<=event.key<=pygame.K_4:rig.pose=event.key-pygame.K_1
                elif event.key==pygame.K_SPACE:renderer.auto=not renderer.auto
                elif event.key==pygame.K_w:renderer.wire=not renderer.wire
                elif event.key==pygame.K_r:
                    renderer.yaw,renderer.pitch,renderer.zoom=-.26,-.035,1.0
                    rig.pose=0
                elif event.key==pygame.K_s:
                    name="hiroko_capture_%s.png"%time.strftime("%Y%m%d_%H%M%S")
                    pygame.image.save(screen,name)
                    print("Saved",name)
        renderer.draw(screen,meshes,rig)
        pygame.display.flip()
    pygame.quit()


if __name__=="__main__":
    main()
