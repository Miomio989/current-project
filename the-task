        if mode == 0:
            return (c0, c1, c2, c3, c2, c1, c0, c2, c0, c1, c2, c3, c2, c3, c2, c1)
        if mode == 1:
            return (c3, c2, c1, c0, c2, c1, c3, c2, c1, c0, c2, c3, c1, c2, c0, c1)
        return (c0, 0, c2, c1, c3, 0, c2, c1, c0, 0, c2, c3, c2, 0, c1, c2)

