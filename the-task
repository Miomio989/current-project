    def _strip_step(self, delta: int) -> None:
        """Move to the previous / next image: the temp strip on the viewer
        tab, the output-gallery grid on the GALLERY tab (wraps around)."""
        if self.right_tabs.currentIndex() == 1:
            lst = self.gallery_tab.list
            if not lst.count():
                return
            row = lst.currentRow()
            row = (row + delta) % lst.count()
            lst.setCurrentRow(row)
        else:
            if not self.gallery.count():
                return
            row = self.gallery.currentRow()
            row = (row + delta) % self.gallery.count()
            self.gallery.setCurrentRow(row)
            if row == 0 and delta > 0:
                self.gallery.scrollToItem(self.gallery.item(0))

