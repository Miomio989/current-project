        head_c = Vec2(cx + 2 * sc, cy - 6 * sc)
        neck_c = Vec2(cx, cy + 17 * sc)
        dummy_hair = HairFlowSpec(
            crown_anchor=(0, 0),
            main_tail=((0, 0), (0, 0), (0, 0), (0, 0)),
            upper_plume=((0, 0), (0, 0), (0, 0), (0, 0)),
            lower_plume=((0, 0), (0, 0), (0, 0), (0, 0)),
            sidelock_l_sway=-2.0,
            sidelock_r_sway=2.0,
            bangs_lift=0.0,
        )
        self._draw_anime_head(
            surf, head_c, neck_c, HeadAzimuth.THREE_QUARTER_FRONT,
            tilt_deg=-4.0, gaze_x=0.45, gaze_y=0.0, expr=expr,
            hair=dummy_hair, pal=pal, s=sc * 1.95, eclipse_mode=False,
        )

        # Clip portrait to an elegant gothic diamond-octagon medallion mask
        mask = pygame.Surface((ss, ss), pygame.SRCALPHA)
        poly_m = [
            (int(ss * 0.14), int(ss * 0.08)),
            (int(ss * 0.86), int(ss * 0.08)),
            (int(ss * 0.96), int(ss * 0.50)),
            (int(ss * 0.84), int(ss * 0.92)),
