@dataclass
class ReplayTick:
    p1_dx: int
    p1_dy: int
    p1_btn: int
    p2_dx: int
    p2_dy: int
    p2_btn: int


class MatchReplayRecorder:
    def __init__(self) -> None:
        self.frames: List[ReplayTick] = []
        self.p1_pal: int = 0
        self.p2_pal: int = 1
        self.p2_name: str = "CURSED WRAITH"
        self.cursor: int = 0

    def start_record(self, p1_pal: int, p2_pal: int, p2_name: str) -> None:
        self.frames.clear()
        self.p1_pal = p1_pal
        self.p2_pal = p2_pal
        self.p2_name = p2_name
        self.cursor = 0

    def record(self, p1_in: Tuple[int, int, InputButton], p2_in: Tuple[int, int, InputButton]) -> None:
        if len(self.frames) < 18000:
            self.frames.append(ReplayTick(p1_in[0], p1_in[1], int(p1_in[2]), p2_in[0], p2_in[1], int(p2_in[2])))

    def start_playback(self) -> bool:
        if not self.frames:
            return False
        self.cursor = 0
        return True

    def next_inputs(self) -> Optional[Tuple[Tuple[int, int, InputButton], Tuple[int, int, InputButton]]]:
        if self.cursor >= len(self.frames):
            return None
        t = self.frames[self.cursor]
        self.cursor += 1
        return ((t.p1_dx, t.p1_dy, InputButton(t.p1_btn)), (t.p2_dx, t.p2_dy, InputButton(t.p2_btn)))

