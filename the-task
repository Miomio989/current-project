class CombatResolver:
    """Resolves every 60Hz frame of swordplay between P1 and P2."""

    def __init__(
        self,
        settings: GameSettings,
        vfx: VFXManager,
        cam: CameraDirector,
        audio: AudioManager,
        stage: CursedCathedralStage,
    ) -> None:
        self.settings = settings
        self.vfx = vfx
        self.cam = cam
        self.audio = audio
        self.stage = stage

        self.hitstop_frames: int = 0
        self.super_freeze_frames: int = 0
        self.first_blood_awarded: bool = False
        self.fatal_execution_triggered: bool = False
        self.last_ko_was_fatal: bool = False

    def reset_round(self) -> None:
        self.hitstop_frames = 0
        self.super_freeze_frames = 0
        self.first_blood_awarded = False
        self.fatal_execution_triggered = False
        self.last_ko_was_fatal = False

    def on_move_started(self, attacker: Fighter, move_state: FighterState) -> None:
        """Handle cinematic freeze frames & gothic visual flare on Special/Super activation."""
        pal = CECILIA_PALETTES[attacker.palette_idx]
        if move_state == FighterState.SPECIAL_SHADOW_STEP:
            self.vfx.spawn_rose_petal_burst(attacker.x, attacker.y - 80.0, pal, count=22)
        elif move_state == FighterState.OVERDRIVE_ACTIVATE:
            self.super_freeze_frames = 22
            self.audio.play_sfx(SFXId.RESONANCE_ACTIVATE, vol_scale=1.0)
            self.vfx.spawn_rose_petal_burst(attacker.x, attacker.y - 90.0, pal, count=28)
            self.vfx.trigger_cut_in(
                attacker.player_idx,
                attacker.palette_idx,
                "CURSED RESONANCE",
                "OVERDRIVE AWAKENING",
                is_fatal=False,
                duration=28,
            )
            self.vfx.add_callout(attacker.player_idx, "CURSED RESONANCE!", pick_dramatic_quote("RESONANCE"), UI_CRIMSON_GLOW, 74)
            self.cam.trigger_dramatic_zoom(attacker.x, attacker.y - 140.0, 1.24, 24)
        elif move_state == FighterState.SUPER_ECLIPSE_REQUIEM:
            self.super_freeze_frames = 34
            self.audio.play_sfx(SFXId.SUPER_FLASH, vol_scale=1.0)
            self.vfx.trigger_cut_in(
                attacker.player_idx,
                attacker.palette_idx,
