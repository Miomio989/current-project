    """

    def __init__(self, cg: StudioCGRasterizer) -> None:
        self.cg = cg
        self._cache: Dict[Tuple[int, int, bool, ExpressionId, bool], pygame.Surface] = {}

    def render_portrait(
        self,
        pal: CeciliaCGPalette,
        pal_idx: int,
        size: int = 128,
        facing_right: bool = True,
        expr: ExpressionId = ExpressionId.SERENE,
        with_bg: bool = True,
    ) -> pygame.Surface:
        key = (pal_idx, size, facing_right, expr, with_bg)
        cached = self._cache.get(key)
        if cached is not None:
            return cached

        ss = 2
        W = size * ss
        H = size * ss
        s = W / 256.0  # Normalized 256x256 authoring space!
        surf = pygame.Surface((W, H), pygame.SRCALPHA)

        if with_bg:
            # Rich gothic crimson-obsidian vignette backdrop
            bg = self.cg.make_linear_gradient(
                W, H,
                [(18, 6, 14), (44, 10, 24), (24, 6, 16)],
                vertical=True,
            )
            surf.blit(bg, (0, 0))
            self.cg.blit_glow(surf, (132 * s, 108 * s), 110 * s, pal.aura_mid, 95, additive=True)
            self.cg.blit_glow(surf, (124 * s, 96 * s), 68 * s, pal.hair_rim, 58, additive=True)

        ldir = (0.58, -0.82)

        def P(x: float, y: float) -> Pt2:
            return (x * s, y * s)

        # ------------------------------------------------------------------
        # 1. BACK VOLUMINOUS HIGH PONYTAIL CASCADE (Behind head & shoulders)
        # ------------------------------------------------------------------
        # High ponytail dome behind crown
        pony_crown = (
            sample_cubic(P(116, 44), P(134, 6), P(182, 8), P(188, 56), 10)
            + sample_cubic(P(188, 56), P(206, 106), P(216, 186), P(192, 248), 10)
            + sample_cubic(P(192, 248), P(172, 224), P(162, 168), P(154, 118), 8)
            + [P(116, 44)]
        )
        self.cg.fill_shaded_poly(
            surf, pony_crown,
            [pal.hair_dark, pal.hair_base, pal.hair_sheen, pal.hair_base],
            light_dir=(0.75, -0.65),
            spec_pos=P(168, 44), spec_color=pal.hair_spec, spec_radius=30 * s, spec_alpha=55,
            rim_color=pal.hair_rim, rim_width=2.8 * s,
            ink_color=pal.hair_dark, ink_width=2.0 * s,
        )
        # Secondary left-side cascading ponytail tail behind left shoulder
        pony_left = (
            sample_cubic(P(98, 56), P(66, 98), P(44, 168), P(52, 244), 10)
            + sample_cubic(P(52, 244), P(74, 214), P(86, 166), P(104, 128), 8)
            + [P(98, 56)]
        )
        self.cg.fill_shaded_poly(
            surf, pony_left,
            [pal.hair_dark, pal.hair_base, pal.hair_dark],
            light_dir=(0.4, -0.9),
            ink_color=pal.hair_dark, ink_width=1.8 * s,
        )
        # Flowing individual silk hair locks inside ponytail
        for pts_spec, w0, wm, wt, sh in [
            ((P(156, 36), P(192, 58), P(214, 134), P(208, 228)), 13 * s, 11 * s, 2 * s, True),
            ((P(148, 38), P(178, 72), P(190, 152), P(176, 242)), 11 * s, 9 * s, 2 * s, False),
            ((P(164, 42), P(208, 86), P(228, 156), P(234, 216)), 7 * s, 6 * s, 1.4 * s, True),
        ]:
            sp = sample_cubic(pts_spec[0], pts_spec[1], pts_spec[2], pts_spec[3], 12)
            ws = [lerp(w0, wm, t * 2) if t < 0.5 else lerp(wm, wt, (t - 0.5) * 2) for t in [i / 12.0 for i in range(13)]]
            poly = build_tapered_ribbon_poly(sp, ws)
            self.cg.fill_shaded_poly(
                surf, poly,
                [pal.hair_dark, pal.hair_base, pal.hair_sheen if sh else pal.hair_base],
                light_dir=(0.8, -0.5),
                rim_color=pal.hair_rim if sh else None, rim_width=1.6 * s,
                ink_color=pal.hair_dark, ink_width=1.4 * s,
            )

        # Crimson ponytail tie ribbon peeking behind upper crown
        ribbon_pts = [P(128, 34), P(154, 26), P(166, 40), P(146, 52), P(124, 48)]
        self.cg.fill_shaded_poly(
