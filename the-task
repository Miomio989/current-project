class MatchSession:
    """
    Runs a full best-of-three ritual duel in The Sunken Pagoda with every GDD mechanic:
    Tempo, 172 BPM Pulse Sync Hits, Fester + Reap, Resolve + Stagger, Severance + Hush,
    Blade Lock RPS, Stage Break into The Hall, Possession + Backlash, Rites, and Final Round Eclipse.
    """

    def __init__(
        self,
        p1: Fighter,
        p2: Fighter,
        audio: ProceduralAudioEngine,
        training_mode: bool = False,
        photosafe: bool = False,
        gore_level: int = 2,
        pulse_enabled: bool = True,
    ) -> None:
        self.fighters: List[Fighter] = [p1, p2]
        self.audio = audio
        self.training_mode = training_mode
        self.photosafe = photosafe
        self.gore_level = gore_level
        self.pulse_enabled = pulse_enabled

        self.camera = Camera3D()
        self.round_num: int = 1
        self.timer: float = ROUND_TIME_SECONDS
        self.tempo: float = 0.0
        self.tempo_phase: str = "prelude"
        self.beat_clock: float = 0.0
        self.beat_pulse: float = 0.0
        self.frames_to_beat: float = 99.0
        self.world_t: float = 0.0

        self.hitstop_frames: int = 0
        self.impact_flash_frames: int = 0
        self.hush_visual_frames: int = 0
        self.rite_freeze_frames: int = 0
        self.rite_inkwash_frames: int = 0
        self.rite_cam_override: Optional[Tuple[float, float, float, float]] = None

        # Stage Break State (Area 0 = Exterior Swamp Pagoda -> Area 1 = The Hall)
        self.stage_area: int = 0
        self.stage_break_used: bool = False
        self.stage_break_frames: int = 0

        # Blade Lock Clash State
        self.blade_lock_frames: int = 0

        # Round Flow & Brush Banners
        self.phase: str = "intro"  # intro, fight, ko, round_end, match_end
        self.phase_timer: int = 95
        self.banner_title: str = "ROUND 1"
        self.banner_sub: str = "PRELUDE"
        self.banner_timer: int = 95
        self.callout_text: str = ""
        self.callout_color: Tuple[int, int, int] = (255, 220, 110)
        self.callout_timer: int = 0
        self.match_winner: Optional[int] = None

        self.particles: List[Particle3D] = []
        self.projectiles: List[Projectile3D] = []

        self.start_round(1, keep_trance=False)

    def start_round(self, num: int, keep_trance: bool = True) -> None:
        self.round_num = num
        self.timer = ROUND_TIME_SECONDS
        self.tempo = 0.0
        self.tempo_phase = "prelude"
        self.phase = "intro"
        self.phase_timer = 90
        self.blade_lock_frames = 0
        self.hitstop_frames = 0
        self.projectiles.clear()
        for f in self.fighters:
            f.reset_for_round(keep_trance=keep_trance)
        is_final = (self.fighters[0].rounds_won == 1 and self.fighters[1].rounds_won == 1) or num >= 3
        self.banner_title = "FINAL ROUND" if is_final else f"ROUND {num}"
        self.banner_sub = "ECLIPSE" if is_final else ("THE HALL" if self.stage_area == 1 else "PRELUDE")
        self.banner_timer = 95
        self.audio.set_tempo_phase("prelude")
        self.audio.start_music()

    def get_lighting_script_key(self) -> str:
        is_final = (self.fighters[0].rounds_won == 1 and self.fighters[1].rounds_won == 1) or self.round_num >= 3
        if is_final:
            return "eclipse"
        return self.tempo_phase

    def _post_callout(self, text: str, col: Tuple[int, int, int], dur: int = 58) -> None:
        self.callout_text = text
        self.callout_color = col
        self.callout_timer = dur

    def _raise_tempo(self, amount: float) -> None:
        self.tempo = clamp(self.tempo + amount, 0.0, TEMPO_MAX)
        prev = self.tempo_phase
        # Ratchets upward and never drops to a lower phase within the round (GDD 2.6)
        if self.tempo >= 67.0 or prev == "frenzy":
            self.tempo_phase = "frenzy"
            self.tempo = max(self.tempo, 67.0)
        elif self.tempo >= 34.0 or prev == "rupture":
            self.tempo_phase = "rupture"
            self.tempo = max(self.tempo, 34.0)
        else:
            self.tempo_phase = "prelude"
        if self.tempo_phase != prev:
            self.audio.set_tempo_phase(self.tempo_phase)
            self._post_callout(
                "TEMPO: FRENZY!" if self.tempo_phase == "frenzy" else "TEMPO: RUPTURE!",
                (255, 118, 48) if self.tempo_phase == "frenzy" else (255, 198, 72),
                66,
            )

    def _is_sync_window(self) -> bool:
        if not self.pulse_enabled:
            return False
        win = SYNC_HIT_WINDOW_FRAMES + (SYNC_HIT_RUPTURE_BONUS if self.tempo_phase != "prelude" else 0)
        return self.frames_to_beat <= win

    def _spawn_hit_fx(self, x: float, y: float, heavy: bool, sync: bool, blood: bool) -> None:
        # Flipbook ink slash burst
        self.particles.append(Particle3D(x, y, 0.25, 0.0, 0.0, 0.0, 0.24, 0.24, 1.35 if heavy else 0.95, (255, 224, 178), "flip_slash"))
        if sync:
            self.particles.append(Particle3D(x, y, 0.30, 0.0, 0.0, 0.0, 0.32, 0.32, 1.5, (255, 212, 92), "flip_seal"))
        count = 16 if heavy else 9
        for _ in range(count):
            ang = random.uniform(0.0, math.tau)
            spd = random.uniform(2.5, 9.5 if heavy else 6.0)
            col = (255, 216, 98) if sync else (255, 146, 72)
            self.particles.append(Particle3D(x, y, 0.2, math.cos(ang) * spd, math.sin(ang) * spd + 1.5, random.uniform(-1.0, 1.0), 0.36, 0.36, 5.0, col, "spark"))
        if blood and self.gore_level > 0:
            bcount = (14 if heavy else 7) * self.gore_level
            for _ in range(bcount):
                ang = random.uniform(-0.8, 2.4)
                spd = random.uniform(2.0, 8.8)
                self.particles.append(Particle3D(x, y, 0.15, math.cos(ang) * spd, math.sin(ang) * spd + 2.2, random.uniform(-0.6, 0.6), 0.55, 0.55, 7.0 if heavy else 4.5, (192, 12, 26), "blood"))

    def step(self, p1_actions: Dict[str, Any], p2_actions: Dict[str, Any]) -> None:
        """Advances the entire match simulation by exactly one 1/60s deterministic fighting frame."""
        dt = FIXED_DT
        self.world_t += dt
        self.audio.update(dt)

        # 172 BPM Beat Pulse Clock
        prev_beat = int(self.beat_clock)
        self.beat_clock += dt * BEATS_PER_SEC
        frac = self.beat_clock - math.floor(self.beat_clock)
        dist_beat = min(frac, 1.0 - frac)
        self.frames_to_beat = dist_beat * FRAMES_PER_BEAT
        self.beat_pulse = max(0.0, 1.0 - frac * 3.4) ** 2
        if int(self.beat_clock) > prev_beat and self.training_mode and self.pulse_enabled:
            self.audio.play_sfx("pulse_thump", 0.45)

        if self.banner_timer > 0:
            self.banner_timer -= 1
        if self.callout_timer > 0:
            self.callout_timer -= 1
        if self.impact_flash_frames > 0:
            self.impact_flash_frames -= 1
        if self.hush_visual_frames > 0:
            self.hush_visual_frames -= 1
        if self.rite_inkwash_frames > 0:
            self.rite_inkwash_frames -= 1

        # Stage Break 90-frame cinematic camera-swing transition into Area 2: The Hall
        if self.stage_break_frames > 0:
            self.stage_break_frames -= 1
            t = 1.0 - (self.stage_break_frames / float(STAGE_BREAK_TRANSITION_FRAMES))
            if self.stage_break_frames == STAGE_BREAK_TRANSITION_FRAMES // 2:
                self.stage_area = 1
                self.fighters[0].x = -2.8
                self.fighters[1].x = 2.8
            self.camera.update(dt, 0.0, 1.8, 0.0, 1.8, self.tempo / 100.0, self.beat_pulse, (0.0, 2.2, 8.8 - math.sin(t * math.pi) * 2.4, math.sin(t * math.pi) * 32.0))
            self._update_particles(dt)
            return

        # Hitstop Freeze Frames (GDD 2.11)
        if self.hitstop_frames > 0:
            self.hitstop_frames -= 1
            self.camera.update(dt, self.fighters[0].x, self.fighters[0].y, self.fighters[1].x, self.fighters[1].y, self.tempo / 100.0, self.beat_pulse, self.rite_cam_override)
            return

        # Blade Lock 20-Frame RPS Clash Window (GDD 2.9)
        if self.blade_lock_frames > 0:
            self._step_blade_lock(p1_actions, p2_actions)
            self.camera.update(dt, self.fighters[0].x, self.fighters[0].y, self.fighters[1].x, self.fighters[1].y, self.tempo / 100.0, self.beat_pulse, (0.0, 1.5, 6.2, 12.0))
            self._update_particles(dt)
            return

        # Round Phase Transitions
        if self.phase == "intro":
            self.phase_timer -= 1
            for f in self.fighters:
                f.update_skeleton(dt, self.beat_pulse, self.world_t)
            if self.phase_timer <= 0:
                self.phase = "fight"
                self.banner_title = "DUEL!"
                self.banner_sub = ""
                self.banner_timer = 38
                for f in self.fighters:
                    f.anim.play("idle", restart=True)
            self.camera.update(dt, self.fighters[0].x, self.fighters[0].y, self.fighters[1].x, self.fighters[1].y, self.tempo / 100.0, self.beat_pulse)
            return

        if self.phase in ("ko", "round_end", "match_end"):
            self.phase_timer -= 1
            for f in self.fighters:
                self._step_physics(f, dt)
                f.update_skeleton(dt, self.beat_pulse, self.world_t)
            self._update_particles(dt)
            self.camera.update(dt, self.fighters[0].x, self.fighters[0].y, self.fighters[1].x, self.fighters[1].y, self.tempo / 100.0, self.beat_pulse)
            if self.phase == "ko" and self.phase_timer <= 0:
                self._resolve_round_end()
            elif self.phase == "round_end" and self.phase_timer <= 0:
                self.start_round(self.round_num + 1, keep_trance=True)
            return

        # Active Fight Phase: Timer & Tempo Floors (40s -> Rupture, 20s -> Frenzy)
        if not self.training_mode:
            self.timer = max(0.0, self.timer - dt)
            if self.timer <= 40.0 and self.tempo < TEMPO_FLOOR_40S:
                self._raise_tempo(TEMPO_FLOOR_40S - self.tempo)
            if self.timer <= 20.0 and self.tempo < TEMPO_FLOOR_20S:
                self._raise_tempo(TEMPO_FLOOR_20S - self.tempo)
            if self.timer <= 0.0:
                self._trigger_timeout()
                return
        else:
            # Training Mode slowly regenerates Vitality when idle
            for f in self.fighters:
                if f.state == "idle" and f.combo_timer <= 0:
                    f.vitality = min(f.max_vitality, f.vitality + 4.5)
                    f.trance = min(MAX_TRANCE, f.trance + 1.2)

        # Gather CPU AI inputs if either fighter is AI-controlled
        actions = [p1_actions, p2_actions]
        for idx, f in enumerate(self.fighters):
            if f.is_cpu:
                actions[idx] = self._compute_cpu_ai(f, self.fighters[1 - idx])

        # Step both fighters
        for idx, f in enumerate(self.fighters):
            opp = self.fighters[1 - idx]
            self._step_fighter(f, opp, actions[idx], dt)

        # Prevent overlap pushbox
        dx = self.fighters[1].x - self.fighters[0].x
        min_sep = 1.05
        if abs(dx) < min_sep and abs(self.fighters[0].y - self.fighters[1].y) < 1.3:
            push = (min_sep - abs(dx)) * 0.5
            sign = 1.0 if dx >= 0.0 else -1.0
            self.fighters[0].x = clamp(self.fighters[0].x - sign * push, ARENA_MIN_X, ARENA_MAX_X)
            self.fighters[1].x = clamp(self.fighters[1].x + sign * push, ARENA_MIN_X, ARENA_MAX_X)

        # Resolve melee hits, Severances, Blade Lock Clashes & Projectiles
        self._resolve_combat_interactions()
        self._step_projectiles(dt)
        self._update_particles(dt)

        # Update 3D Camera
        if self.rite_freeze_frames > 0:
            self.rite_freeze_frames -= 1
            if self.rite_freeze_frames <= 0:
                self.rite_cam_override = None
        self.camera.update(
            dt,
            self.fighters[0].x, self.fighters[0].y,
            self.fighters[1].x, self.fighters[1].y,
            self.tempo / 100.0, self.beat_pulse, self.rite_cam_override,
        )

    def _step_fighter(self, f: Fighter, opp: Fighter, act: Dict[str, Any], dt: float) -> None:
        f.tick_buffer()
        f.state_frame += 1
        if f.invuln_frames > 0:
            f.invuln_frames -= 1
        if f.severance_frames > 0:
            f.severance_frames -= 1
        if f.combo_timer > 0:
            f.combo_timer -= 1
            if f.combo_timer <= 0:
                f.combo_count = 0
                f.combo_damage = 0.0
        if f.verse_buff_frames > 0:
            f.verse_buff_frames -= 1
        if f.mask_crack_flash > 0:
            f.mask_crack_flash -= 1

        # Possession countdown & 100-pt Backlash self-Fester at expiration (GDD 2.10)
        if f.possession_frames > 0:
            f.possession_frames -= 1
            if f.possession_frames == 0:
                backlash = POSSESSION_BACKLASH_FESTER * (1.30 if f.vow["id"] == "fester" else 1.0)
                f.inflict_fester(backlash)
                if f.char_id == "kiri":
                    f.mask_crack_flash = 12  # Single-frame eye glint & mask crack!
                self._post_callout(f"{f.name}: BACKLASH!", (192, 62, 255), 54)

        # Fester 5-Second (300f) Conversion Timer (GDD 2.5)
        if f.fester > 0.0:
            f.fester_timer -= 1
            if f.fester_timer <= 0:
                f.vitality = max(1.0, f.vitality - f.fester)
                f.fester = 0.0
                self.audio.play_sfx("fester_reap", 0.7)
                self._post_callout("FESTER CONSUMED!", (188, 66, 255), 42)

        # Queue pressed attack buttons into 5-frame input buffer
        for btn in ("light", "heavy", "kick", "curse", "trance", "seize", "roll", "maledict"):
            if act.get(btn + "_pressed"):
                f.buffer_input(btn)
        if act.get("guard_pressed") and f.can_act():
            # Tap Guard -> 8-frame Severance Just-Guard window (GDD 2.8)
            f.severance_frames = SEVERANCE_WINDOW_FRAMES
            self.audio.slam_from_hush()

        # Resolve regeneration when idle and not blocking
        f.guard_held = bool(act.get("guard_held", False))
        f.crouch_held = bool(act.get("down", False)) and f.grounded
        if f.state in ("idle", "walk", "crouch") and not f.guard_held:
            f.resolve = min(MAX_RESOLVE, f.resolve + RESOLVE_REGEN_PER_SEC * dt)

        # Face opponent when able to act
        if f.can_act() and f.grounded:
            f.facing = 1 if opp.x >= f.x else -1

        # Handle Hitstun, Stagger, Knockdown, Wakeup, Roll
        if f.state in ("hitstun", "stagger", "knockdown", "wakeup", "roll", "possession_act"):
            if f.stun_frames > 0:
                f.stun_frames -= 1
            if f.state == "roll":
                f.invuln_frames = 1 if 4 <= f.state_frame <= 16 else 0
                f.vx = f.facing * (7.2 if act.get("move_x", 0) * f.facing >= 0 else -6.4)
                if f.state_frame >= 20:
                    f.state = "idle"
                    f.anim.play("idle")
            elif f.state == "knockdown":
                if f.grounded and f.stun_frames <= 0:
                    f.state = "wakeup"
                    f.stun_frames = 18
                    f.invuln_frames = 18
                    f.anim.play("wakeup", restart=True)
            elif f.state == "stagger":
                if f.stun_frames <= 0:
                    f.resolve = RESOLVE_POST_STAGGER
                    f.state = "idle"
                    f.anim.play("idle")
            elif f.stun_frames <= 0:
                f.state = "idle"
                f.anim.play("idle")
            self._step_physics(f, dt)
            f.update_skeleton(dt, self.beat_pulse, self.world_t)
            return

        # Active Attack Execution + Curse Cancel (1 Trance Bead)
        if f.state == "attack" and f.current_move is not None:
            mv = f.current_move
            # Trance Curse Cancel: cancel any move back to neutral for 1 stock (GDD 2.4)
            if f.pop_buffered(("trance",)) and f.trance >= TRANCE_COST_CANCEL_EX and not mv.is_rite:
                f.trance -= TRANCE_COST_CANCEL_EX
                f.state = "idle"
                f.current_move = None
                f.anim.play("idle", restart=True)
                self.audio.play_sfx("sync_chime", 0.9)
                self._post_callout("CURSE CANCEL!", (224, 108, 255), 36)
                self._step_physics(f, dt)
                f.update_skeleton(dt, self.beat_pulse, self.world_t)
                return

            # Cecilia Hold-Heavy Delayable Phantom Arm Echo (up to 20 frames, GDD 3.2)
            if f.char_id == "cecilia" and mv.name == "heavy_slash" and f.state_frame == mv.startup:
                if act.get("heavy_held") and f.echo_charge_frames < 20:
                    f.echo_charge_frames += 1
                    f.state_frame -= 1  # Pause before release
                else:
                    delay = f.echo_charge_frames + (4 if f.possession_frames > 0 else 10)
                    f.echo_charge_frames = 0
                    if delay > 0 or f.possession_frames > 0:
                        self.projectiles.append(Projectile3D(
                            f.slot, f.x + f.facing * 2.1, f.y + 1.15, 0.0, f.facing * 0.5,
                            46.0 + f.umbra_stacks * 12.0, 26.0, 0.45, "phantom_echo",
                            (186, 62, 255), delay_frames=delay
                        ))

            # Projectile spawn (Kiri Fox-Fire Toss) & Teleport (Kiri Mist Step)
            if f.state_frame == mv.startup:
                if mv.spawns_projectile:
                    self.projectiles.append(Projectile3D(
                        f.slot, f.x + f.facing * 1.1, f.y + 1.15, 0.0, f.facing * 11.5,
                        mv.damage, mv.fester, 1.35, "foxfire", (128, 224, 255)
                    ))
                if mv.teleports_behind:
                    f.x = clamp(opp.x + opp.facing * 1.45, ARENA_MIN_X, ARENA_MAX_X)
                    f.facing = 1 if opp.x >= f.x else -1
                    self._spawn_hit_fx(f.x, f.y + 1.1, False, False, False)

            if mv.startup <= f.state_frame < mv.startup + mv.active:
                f.vx = mv.move_vel_x * f.facing * 0.45

            total = mv.startup + mv.active + mv.recovery
            # Chain cancel light_1 -> light_2 -> light_3 or Kiri Verse Free Cancel
            if f.move_hit_registered and f.state_frame >= mv.startup + 2:
                nxt = f.pop_buffered(("light", "heavy", "curse", "kick"))
                if nxt == "light" and mv.name == "light_1":
                    self._start_move(f, "light_2")
                elif nxt == "light" and mv.name == "light_2":
                    self._start_move(f, "light_3")
                elif nxt == "heavy" and mv.name in ("light_1", "light_2", "light_3"):
                    self._start_move(f, "heavy_slash")
                elif nxt == "curse" and (mv.name.startswith("light") or f.verse_buff_frames > 0):
                    self._start_move(f, "curse_art_1")

            if f.state_frame >= total:
                # Cecilia whiffing Heavy loses 1 Umbra stack (GDD 3.2)
                if f.char_id == "cecilia" and mv.is_heavy and not f.move_hit_registered:
                    f.umbra_stacks = max(0, f.umbra_stacks - 1)
                f.state = "idle"
                f.current_move = None
                f.anim.play("idle")

            self._step_physics(f, dt)
            f.update_skeleton(dt, self.beat_pulse, self.world_t)
            return

        # Free Action State: Check Guard, Roll, Seize, Trance (Rite/Possession), Attacks, Movement
        if f.guard_held and f.grounded:
            f.state = "guard"
            f.vx *= 0.6
            f.anim.play("guard_low" if f.crouch_held else "guard_high")
            self._step_physics(f, dt)
            f.update_skeleton(dt, self.beat_pulse, self.world_t)
            return
        elif f.state == "guard":
            f.state = "idle"

        # Check Roll (Guard + Kick, 20 Resolve)
        if f.pop_buffered(("roll",)) and f.grounded and f.resolve >= RESOLVE_COST_ROLL:
            f.resolve -= RESOLVE_COST_ROLL
            f.state = "roll"
            f.state_frame = 0
            f.anim.play("roll", restart=True)
            self._step_physics(f, dt)
            f.update_skeleton(dt, self.beat_pulse, self.world_t)
            return

        # Check Trance Spend: 3 Stocks -> Possession | 2 Stocks -> Rite
        if f.pop_buffered(("trance",)):
            if f.char_id == "kiri" and f.possession_frames > 0:
                # Nameless Dance of a Thousand Cuts (Possession-only Rite, 0 stocks, ends Possession!)
                self._start_move(f, "rite_2")
                self.rite_inkwash_frames = 54
                self.rite_freeze_frames = 28
                self.rite_cam_override = (f.x, 1.5, 6.2, 22.0 * f.facing)
                self.audio.play_sfx("rite_sting", 1.0)
                self._post_callout("NAMELESS DANCE OF A THOUSAND CUTS!", (242, 248, 255), 68)
                self._step_physics(f, dt)
                f.update_skeleton(dt, self.beat_pulse, self.world_t)
                return
            elif f.trance >= TRANCE_COST_POSSESSION and f.possession_frames <= 0:
                f.trance = 0.0
                f.possession_frames = POSSESSION_DURATION_FRAMES
                f.state = "possession_act"
                f.stun_frames = 22
                f.invuln_frames = 26
                f.anim.play("possession_act", restart=True)
                self.audio.play_sfx("possession", 1.0)
                self.camera.trigger_impact(f.x, f.y + 1.5, 0.30, 1.4)
                pname = "WAR-SPIRIT MANIFEST!" if f.char_id == "cecilia" else "NINE-TAIL MASQUERADE!"
                self._post_callout(f"POSSESSION: {pname}", (255, 208, 74), 72)
                self._step_physics(f, dt)
                f.update_skeleton(dt, self.beat_pulse, self.world_t)
                return
            elif f.trance >= TRANCE_COST_RITE:
                f.trance -= TRANCE_COST_RITE
                r_key = "rite_2" if (f.char_id == "cecilia" and f.umbra_stacks >= 3) else "rite_1"
                self._start_move(f, r_key)
                self.rite_freeze_frames = 24
                self.rite_cam_override = (f.x, 1.55, 6.4, -20.0 * f.facing)
                self.audio.play_sfx("rite_sting", 1.0)
                self._post_callout(f.moves[r_key].display_name.upper(), (255, 186, 64), 68)
                self._step_physics(f, dt)
                f.update_skeleton(dt, self.beat_pulse, self.world_t)
                return

        # Attack Inputs
        mv_btn = f.pop_buffered(("seize", "maledict", "curse", "heavy", "kick", "light"))
        if mv_btn is not None:
            self.audio.slam_from_hush()
            move_x = act.get("move_x", 0)
            if mv_btn == "seize":
                self._start_move(f, "seize_throw")
            elif mv_btn == "maledict":
                self._start_move(f, "maledict")
            elif not f.grounded:
                if mv_btn == "kick" and f.char_id == "kiri" and not f.air_dashed:
                    f.air_dashed = True
                    f.vx = f.facing * 9.8
                    f.vy = max(f.vy, 3.2)
                    f.anim.play("air_dash", restart=True)
                else:
                    self._start_move(f, "air_slash")
            elif mv_btn == "light":
                self._start_move(f, "light_1")
            elif mv_btn == "heavy":
                if f.resolve >= RESOLVE_COST_HEAVY_SLASH:
                    f.resolve -= RESOLVE_COST_HEAVY_SLASH
                    self._start_move(f, "heavy_slash")
                else:
                    self._start_move(f, "light_2")
            elif mv_btn == "kick":
                if f.crouch_held:
                    self._start_move(f, "kick_low_sweep")
                elif move_x * f.facing > 0:
                    self._start_move(f, "kick_launcher")
                else:
                    self._start_move(f, "kick_mid")
            elif mv_btn == "curse":
                if f.crouch_held:
                    if f.char_id == "kiri":
                        f.stance = "frost" if f.stance == "dew" else "dew"
                        self._post_callout(f"KIRI STANCE: {f.stance.upper()}", (142, 224, 255), 38)
                    self._start_move(f, "curse_art_2")
                elif move_x * f.facing < 0:
                    if not (f.char_id == "cecilia" and f.vow["disable_backdash"]):
                        self._start_move(f, "curse_art_3")
                    else:
                        self._start_move(f, "curse_art_1")
                else:
                    self._start_move(f, "curse_art_1")
            self._step_physics(f, dt)
            f.update_skeleton(dt, self.beat_pulse, self.world_t)
            return

        # Standard Movement (Walk, Jump, Crouch)
        move_x = act.get("move_x", 0)
        if act.get("jump_pressed") and f.grounded:
            f.vy = 14.8 if f.char_id == "kiri" else 13.4
            f.grounded = False
            f.air_dashed = False
            f.state = "jump"
            f.anim.play("jump_rise", restart=True)
        elif f.grounded:
            if f.crouch_held:
                f.state = "crouch"
                f.vx *= 0.65
                f.anim.play("crouch")
            elif move_x != 0:
                # Vow of Iron disables quick retreat if moving back
                spd = (6.4 if f.char_id == "kiri" else 4.9) * (1.12 if (f.char_id == "kiri" and f.stance == "dew") else 1.0)
                if move_x * f.facing < 0:
                    spd *= 0.72 if f.vow["disable_backdash"] else 0.85
                f.vx = move_x * spd
                f.state = "walk"
                f.anim.play("walk_fwd" if move_x * f.facing > 0 else "walk_back")
            else:
                f.vx *= 0.72
                f.state = "idle"
                f.anim.play("idle")
        else:
            f.vx = lerp(f.vx, move_x * 5.2, dt * 4.0)
            if f.vy < 0.0:
                f.anim.play("jump_fall")

        self._step_physics(f, dt)
        f.update_skeleton(dt, self.beat_pulse, self.world_t)

    def _start_move(self, f: Fighter, move_key: str) -> None:
        mv = f.moves[move_key]
        f.state = "attack"
        f.state_frame = 0
        f.current_move = mv
        f.move_hit_registered = False
        f.move_counter_triggered = False
        f.echo_charge_frames = 0
        f.anim.play(mv.anim, restart=True, blend_dur=0.04)
        self.audio.play_sfx("swing_heavy" if (mv.is_heavy or mv.is_rite or f.char_id == "cecilia") else "swing_light", 0.8)

    def _step_physics(self, f: Fighter, dt: float) -> None:
        f.x += f.vx * dt
        f.y += f.vy * dt
        if not f.grounded or f.y > 0.0:
            f.vy += GRAVITY * dt
            if f.y <= ARENA_GROUND_Y:
                f.y = ARENA_GROUND_Y
                f.vy = 0.0
                f.grounded = True
                if f.state == "jump":
                    f.state = "idle"
                    f.anim.play("idle")
        if f.grounded and f.state not in ("walk", "roll"):
            f.vx *= max(0.0, 1.0 - dt * 12.0)
        f.x = clamp(f.x, ARENA_MIN_X, ARENA_MAX_X)

    def _resolve_combat_interactions(self) -> None:
        f0, f1 = self.fighters[0], self.fighters[1]
        active = [False, False]
        for idx, f in enumerate((f0, f1)):
            if f.state == "attack" and f.current_move is not None and not f.move_hit_registered:
                mv = f.current_move
                if mv.startup <= f.state_frame < mv.startup + mv.active and not mv.is_counter:
                    active[idx] = True

        # Check Simultaneous Blade Lock Clash (GDD 2.9)
        if active[0] and active[1] and abs(f0.x - f1.x) <= max(f0.current_move.reach_x, f1.current_move.reach_x):
            self.blade_lock_frames = BLADE_LOCK_DECISION_FRAMES
            f0.blade_lock_pick = ""
            f1.blade_lock_pick = ""
            f0.move_hit_registered = True
            f1.move_hit_registered = True
            f0.anim.play("blade_lock", restart=True)
            f1.anim.play("blade_lock", restart=True)
            self.audio.play_sfx("blade_lock", 1.0)
            self._raise_tempo(8.0)
            self._post_callout("BLADE LOCK! PUSH / SLIP / PULL", (255, 224, 92), 45)
            self._spawn_hit_fx((f0.x + f1.x) * 0.5, 1.25, True, True, False)
            return

        # Resolve Individual Active Strikes
        for atk_i in (0, 1):
            if not active[atk_i]:
                continue
            atk = self.fighters[atk_i]
            dfn = self.fighters[1 - atk_i]
            mv = atk.current_move
            if mv is None or dfn.invuln_frames > 0:
                continue
            dx = (dfn.x - atk.x) * atk.facing
            if -0.35 <= dx <= mv.reach_x and (mv.hit_y_min <= dfn.y + 0.9 <= mv.hit_y_max + 0.8):
                atk.move_hit_registered = True
                self._apply_attack_hit(atk, dfn, mv)

    def _apply_attack_hit(self, atk: Fighter, dfn: Fighter, mv: MoveDef) -> None:
        hit_x = (atk.x + dfn.x) * 0.5
        hit_y = dfn.y + 1.18

        # 1. Counter Stance Absorb (Cecilia Black Eclipse / Kiri Decoy Twin)
        if dfn.state == "attack" and dfn.current_move is not None and dfn.current_move.is_counter:
            if dfn.current_move.startup <= dfn.state_frame < dfn.current_move.startup + dfn.current_move.active:
                dfn.move_counter_triggered = True
                self.audio.play_sfx("severance", 0.95)
                self._post_callout(f"{dfn.current_move.display_name.upper()} COUNTER!", (255, 212, 92), 52)
                self._apply_attack_hit(dfn, atk, dfn.current_move)
                return

        # 2. Severance Just-Guard (8-frame window — beats even Maledict!, GDD 2.8)
        if dfn.severance_frames > 0 and not mv.is_seize:
            dfn.severance_frames = 0
            dfn.stat_severances += 1
            dfn.clear_fester_chunk(full=True)
            dfn.add_trance(32.0, self.tempo_phase)
            atk.stun_frames = 18
            atk.state = "hitstun"
            atk.anim.play("hitstun_high", restart=True)
            atk.vx = -atk.facing * 4.2
            self.hush_visual_frames = HUSH_DURATION_FRAMES
            self.hitstop_frames = 10
            self._raise_tempo(9.0)
            self.audio.trigger_hush()
            self._spawn_hit_fx(hit_x, hit_y, True, True, False)
            self._post_callout("SEVERANCE! — HUSH", (255, 240, 142), 54)
            return

        # 3. Standard Blocking (checked against Tell: Overhead needs Stand, Low needs Crouch, Maledict Unblockable)
        blocked = False
        if dfn.state == "guard" and not mv.is_seize and mv.tell != TELL_MALEDICT:
            if mv.tell == TELL_OVERHEAD:
                blocked = not dfn.crouch_held
            elif mv.tell == TELL_LOW:
                blocked = dfn.crouch_held
            else:
                blocked = True

        if blocked:
            res_mult = (1.20 if self.tempo_phase == "frenzy" else 1.0) * dfn.vow["resolve_mult"]
            if dfn.char_id == "kiri" and dfn.stance == "frost":
                res_mult *= 0.78
            dfn.resolve = max(0.0, dfn.resolve - mv.resolve_dmg * res_mult)
            dfn.vx = atk.facing * mv.pushback * 1.3
            atk.add_trance(mv.trance_gain * 0.35, self.tempo_phase)
            self._raise_tempo(2.4)
            self.hitstop_frames = max(4, mv.hitstop - 3)
            self.audio.play_sfx("guard_block", 0.8)
            self._spawn_hit_fx(hit_x, hit_y, False, False, False)
            if dfn.resolve <= 0.0:
                dfn.state = "stagger"
                dfn.stun_frames = RESOLVE_STAGGER_FRAMES
                dfn.anim.play("stagger", restart=True)
                self._post_callout("RESOLVE SHATTERED — STAGGER!", (255, 92, 62), 62)
            return

        # 4. Clean Hit! Compute Counter-Hit, Sync Hit, Tempo Buff, Combo Scaling, Fester Reap
        is_counter = (dfn.state == "attack" and dfn.current_move is not None and dfn.state_frame < dfn.current_move.startup)
        is_sync = self._is_sync_window()
        dmg_mult = atk.vow["dmg_mult"]
        if self.tempo_phase == "rupture":
            dmg_mult *= 1.05
        elif self.tempo_phase == "frenzy":
            dmg_mult *= 1.10
        if atk.verse_buff_frames > 0:
            dmg_mult *= 1.16
        if is_counter:
            dmg_mult *= 1.25

        # Combo damage scaling (prevents infinites while preserving lethal 220-380 combos)
        atk.combo_count += 1
        atk.combo_timer = 72
        atk.stat_max_combo = max(atk.stat_max_combo, atk.combo_count)
        scale = max(0.42, 1.0 - (atk.combo_count - 1) * 0.09)
        total_dmg = mv.damage * dmg_mult * scale

        # Cecilia Umbra & Possession bonus damage/stacks
        if atk.char_id == "cecilia":
            if mv.is_curse:
                total_dmg += atk.umbra_stacks * 16.0 + (22.0 if atk.possession_frames > 0 else 0.0)
            if mv.is_heavy:
                atk.umbra_stacks = min(3, atk.umbra_stacks + 1)
                self.audio.play_sfx("umbra_hum", 0.65)
        elif atk.char_id == "kiri":
            if atk.register_kiri_bell_note(mv.bell_note_id, self.audio):
                self._post_callout("KIRI VERSE COMPLETE!", (142, 232, 255), 54)
            if mv.name == "rite_2":
                # Nameless Dance of a Thousand Cuts cancels Possession Backlash on hit!
                atk.possession_frames = 0

        # Fester Reap Detonation on Heavy Slash (GDD 2.5)
        if mv.reap_fester and dfn.fester > 0.0:
            reaped = dfn.fester * FESTER_REAP_CONVERT_RATIO
            dfn.fester = max(0.0, dfn.fester - reaped)
            total_dmg += reaped
            self.audio.play_sfx("fester_reap", 0.95)
            self.particles.append(Particle3D(hit_x, hit_y, 0.3, 0, 0, 0, 0.35, 0.35, 1.7, (224, 92, 255), "flip_seal"))
            self._post_callout("FESTER REAP!", (224, 98, 255), 44)

        # Attacker landing any hit cleans a chunk of their OWN Fester (GDD 2.5)
        atk.clear_fester_chunk(full=False)

        # Apply Damage & Inflict New Fester
        dfn.vitality = max(0.0, dfn.vitality - total_dmg)
        atk.combo_damage += total_dmg
        fester_amt = mv.fester * (1.25 if atk.vow["id"] == "fester" else 1.0)
        if fester_amt > 0.0 and dfn.vitality > 1.0:
            dfn.inflict_fester(fester_amt)

        # Trance & Tempo Gain + Sync Hit Bonus (GDD 2.7)
        trance_gain = mv.trance_gain * (1.50 if is_sync else 1.0)
        atk.add_trance(trance_gain, self.tempo_phase)
        dfn.add_trance(trance_gain * 0.45, self.tempo_phase)
        self._raise_tempo(6.5 if (mv.is_heavy or mv.is_rite) else 3.2)

        # Hitstop, Impact Frames, Camera Nudge, SFX
        hs = mv.hitstop + (4 if is_counter else 0) + (2 if is_sync else 0)
        self.hitstop_frames = hs
        if (mv.is_heavy or mv.is_rite or is_counter) and not self.photosafe:
            self.impact_flash_frames = 2  # Two-frame inverted ink flash (GDD 2.11)
        if is_sync:
            atk.stat_sync_hits += 1
            self.audio.play_sfx("sync_chime", 0.85)
            self._post_callout("SYNC HIT!", (255, 224, 108), 32)
        elif is_counter and mv.is_heavy:
            self._post_callout("DECISIVE CUT!", (255, 76, 54), 48)

        self.audio.play_sfx("hit_decisive" if (mv.is_rite or is_counter) else ("hit_heavy" if mv.is_heavy else "hit_light"), 0.9)
        self.camera.trigger_impact(hit_x, hit_y, 0.28 if (mv.is_heavy or mv.is_rite) else 0.11, 0.85 if mv.is_heavy else 0.25)
        self._spawn_hit_fx(hit_x, hit_y, mv.is_heavy or mv.is_rite, is_sync, True)

        # Knockback / Launch / Knockdown State
        dfn.vx = atk.facing * mv.pushback * 2.2
        if mv.launch_y > 0.0:
            dfn.vy = mv.launch_y
            dfn.grounded = False
        if mv.knockdown:
            dfn.state = "knockdown"
            dfn.stun_frames = 34
            dfn.anim.play("knockdown", restart=True)
        else:
            dfn.state = "hitstun"
            dfn.stun_frames = mv.hitstun
            dfn.anim.play("hitstun_low" if mv.tell == TELL_LOW else "hitstun_high", restart=True)

        # Check Stage Break at Edge of Sunken Pagoda Causeway (GDD 4.1)
        if (
            not self.stage_break_used
            and mv.stage_break_eligible
            and abs(dfn.x) >= STAGE_BREAK_EDGE_DIST
            and dfn.vitality > 0.0
        ):
            self.stage_break_used = True
            self.stage_break_frames = STAGE_BREAK_TRANSITION_FRAMES
            self.audio.play_sfx("stage_break", 1.0)
            self.banner_title = "STAGE BREAK!"
            self.banner_sub = "ENTERING THE HALL"
            self.banner_timer = 86
            for _ in range(28):
                self.particles.append(Particle3D(
                    dfn.x, 1.3, 0.0, random.uniform(-6.0, 6.0), random.uniform(2.0, 10.0), random.uniform(-2.0, 2.0),
                    1.2, 1.2, 10.0, (78, 56, 52), "debris"
                ))

        # Check KO
        if dfn.vitality <= 0.0:
            if self.training_mode:
                dfn.vitality = dfn.max_vitality
            else:
                dfn.vitality = 0.0
                dfn.state = "ko"
                dfn.anim.play("ko_defeat", restart=True)
                self.phase = "ko"
                self.phase_timer = 110
                self.hitstop_frames = 18
                self.banner_title = "K.O."
                self.banner_sub = "DECISIVE TOLL" if (mv.is_rite or is_counter) else f"{atk.name} WINS"
                self.banner_timer = 110
                atk.anim.play("victory", restart=True)

    def _step_blade_lock(self, a0: Dict[str, Any], a1: Dict[str, Any]) -> None:
        self.blade_lock_frames -= 1
        for idx, (f, act) in enumerate(((self.fighters[0], a0), (self.fighters[1], a1))):
            if not f.blade_lock_pick:
                if f.is_cpu:
                    f.blade_lock_pick = random.choice(("push", "slip", "pull"))
                elif act.get("heavy_pressed") or act.get("light_pressed"):
                    f.blade_lock_pick = "push"
                elif act.get("roll_pressed") or act.get("guard_pressed"):
                    f.blade_lock_pick = "slip"
                elif act.get("kick_pressed") or act.get("curse_pressed"):
                    f.blade_lock_pick = "pull"
        if self.blade_lock_frames <= 0:
            p0 = self.fighters[0].blade_lock_pick or "push"
            p1 = self.fighters[1].blade_lock_pick or "push"
            beats = {"push": "pull", "pull": "slip", "slip": "push"}
            if p0 == p1:
                # Tie broken by Pulse proximity / random micro-delta (GDD 2.9)
                winner = 0 if self.frames_to_beat < 5.0 else 1
                msg = f"BLADE LOCK TIE ({p0.upper()}) — PULSE FAVORS P{winner + 1}!"
            elif beats[p0] == p1:
                winner = 0
                msg = f"P1 WINS BLADE LOCK ({p0.upper()} > {p1.upper()})!"
            else:
                winner = 1
                msg = f"P2 WINS BLADE LOCK ({p1.upper()} > {p0.upper()})!"
            w = self.fighters[winner]
            l = self.fighters[1 - winner]
            l.state = "hitstun"
            l.stun_frames = 26
            l.vitality = max(1.0, l.vitality - 55.0)
            l.vx = w.facing * 5.8
            l.anim.play("hitstun_high", restart=True)
            w.state = "idle"
            w.add_trance(28.0, self.tempo_phase)
            self.audio.play_sfx("hit_heavy", 0.95)
            self._post_callout(msg, (255, 224, 96), 56)

    def _step_projectiles(self, dt: float) -> None:
        kept: List[Projectile3D] = []
        for p in self.projectiles:
            if p.delay_frames > 0:
                p.delay_frames -= 1
                kept.append(p)
                continue
            p.x += p.vx * dt
            p.life -= dt
            target = self.fighters[1 - p.owner_idx]
            owner = self.fighters[p.owner_idx]
            if not p.active_hit and abs(p.x - target.x) < 1.15 and abs(p.y - (target.y + 1.0)) < 1.35:
                p.active_hit = True
                if target.severance_frames > 0:
                    target.clear_fester_chunk(full=True)
                    target.add_trance(24.0, self.tempo_phase)
                    self.audio.trigger_hush()
                    self._post_callout("SEVERANCE DEFLECT!", (255, 240, 142), 40)
                elif target.state == "guard":
                    target.resolve = max(0.0, target.resolve - 10.0)
                    self.audio.play_sfx("guard_block", 0.7)
                else:
                    target.vitality = max(1.0, target.vitality - p.damage)
                    target.inflict_fester(p.fester)
                    target.state = "hitstun"
                    target.stun_frames = 16
                    target.anim.play("hitstun_high", restart=True)
                    owner.add_trance(14.0, self.tempo_phase)
                    if owner.char_id == "cecilia":
                        owner.umbra_stacks = min(3, owner.umbra_stacks + 1)
                    self.audio.play_sfx("hit_light", 0.85)
                    self._spawn_hit_fx(p.x, p.y, p.kind == "phantom_echo", False, True)
                continue
            if p.life > 0.0 and ARENA_MIN_X - 2.0 <= p.x <= ARENA_MAX_X + 2.0:
                kept.append(p)
        self.projectiles = kept

    def _update_particles(self, dt: float) -> None:
        kept: List[Particle3D] = []
        for p in self.particles:
            p.life -= dt
            if p.life <= 0.0:
                continue
            p.x += p.vx * dt
            p.y += p.vy * dt
            p.z += p.vz * dt
            if p.kind in ("blood", "debris", "spark"):
                p.vy -= 18.0 * dt
                if p.y < 0.02:
                    p.y = 0.02
                    p.vx *= 0.5
                    p.vy = 0.0
            kept.append(p)
        self.particles = kept[-220:]

    def _trigger_timeout(self) -> None:
        r0 = self.fighters[0].vitality / self.fighters[0].max_vitality
        r1 = self.fighters[1].vitality / self.fighters[1].max_vitality
        winner = 0 if r0 >= r1 else 1
        self.fighters[winner].anim.play("victory", restart=True)
        self.phase = "ko"
        self.phase_timer = 95
        self.banner_title = "TIME OVER"
        self.banner_sub = f"{self.fighters[winner].name} PREVAILS"
        self.banner_timer = 95

    def _resolve_round_end(self) -> None:
        r0 = self.fighters[0].vitality / self.fighters[0].max_vitality
        r1 = self.fighters[1].vitality / self.fighters[1].max_vitality
        winner = 0 if r0 >= r1 else 1
        self.fighters[winner].rounds_won += 1
        if self.fighters[winner].rounds_won >= ROUNDS_TO_WIN:
            self.phase = "match_end"
            self.match_winner = winner
            self.banner_title = "FISSURE SEALED"
            self.banner_sub = f"{self.fighters[winner].name} VICTORIOUS"
            self.banner_timer = 9999
        else:
            self.phase = "round_end"
            self.phase_timer = 45

    def _compute_cpu_ai(self, ai: Fighter, opp: Fighter) -> Dict[str, Any]:
        """4-Tier Fighting AI: spaces, anti-airs, blocks/Severances, Reaps Fester, chains Kiri Bell Notes."""
        out: Dict[str, Any] = {"move_x": 0}
        dx = opp.x - ai.x
        dist = abs(dx)
        dir_to_opp = 1 if dx >= 0 else -1
        agg = 0.25 + ai.cpu_level * 0.20

        # Defensive reaction: Guard or Severance against incoming attacks
        if opp.state == "attack" and opp.current_move is not None and dist < opp.current_move.reach_x + 0.6:
            if opp.current_move.tell == TELL_MALEDICT and random.random() < agg * 0.55:
                out["guard_pressed"] = True
                return out
            if random.random() < agg * 0.65:
                out["guard_held"] = True
                out["down"] = (opp.current_move.tell == TELL_LOW)
                if random.random() < agg * 0.16:
                    out["guard_pressed"] = True
                return out

        ai.ai_cooldown -= 1
        if ai.ai_cooldown > 0:
            if dist > 2.5:
                out["move_x"] = dir_to_opp
            return out

        ai.ai_cooldown = max(6, 26 - ai.cpu_level * 5 + random.randint(0, 8))

        # Spend Trance on Possession or Rite when advantageous
        if ai.trance >= TRANCE_COST_POSSESSION and random.random() < 0.35:
            out["trance_pressed"] = True
            return out
        if ai.trance >= TRANCE_COST_RITE and dist < 3.4 and random.random() < 0.30:
            out["trance_pressed"] = True
            return out

        # Offensive decisions by range
        if dist > 3.4:
            if ai.char_id == "kiri" and random.random() < 0.36:
                out["curse_pressed"] = True
            else:
                out["move_x"] = dir_to_opp
        elif dist > 1.8:
            r = random.random()
            if opp.fester > 35.0 and r < 0.55:
                out["heavy_pressed"] = True  # Actively Reap Fester!
            elif r < 0.35:
                out["heavy_pressed"] = True
            elif r < 0.65:
                out["curse_pressed"] = True
            elif r < 0.80:
                out["maledict_pressed"] = True
            else:
                out["move_x"] = dir_to_opp
        else:
            r = random.random()
            if r < 0.38:
                out["light_pressed"] = True
            elif r < 0.58:
                out["kick_pressed"] = True
                out["down"] = random.random() < 0.5
            elif r < 0.72:
                out["seize_pressed"] = True
            elif r < 0.85:
                out["heavy_pressed"] = True
            else:
                out["roll_pressed"] = True
        return out


