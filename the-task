    def _adjust_option(self, d: int) -> None:
        c = self.options_cursor
        if c == 0:
            self.settings.master_volume = clamp(round(self.settings.master_volume + d * 0.1, 2), 0.0, 1.0)
        elif c == 1:
            self.settings.bgm_volume = clamp(round(self.settings.bgm_volume + d * 0.1, 2), 0.0, 1.0)
        elif c == 2:
            self.settings.sfx_volume = clamp(round(self.settings.sfx_volume + d * 0.1, 2), 0.0, 1.0)
        elif c == 3:
            scales = (1.0, 1.5, 2.0)
            idx = (scales.index(self.settings.display_scale) + d) % len(scales) if self.settings.display_scale in scales else 0
            self.settings.display_scale = scales[idx]
            self.settings.fullscreen = False
            self.window = self._apply_video_mode()
        elif c == 4:
            self.settings.fullscreen = not self.settings.fullscreen
            self.window = self._apply_video_mode()
        elif c == 5:
            diffs = list(AIDifficulty)
            idx = (diffs.index(self.settings.ai_difficulty) + d) % len(diffs)
            self.settings.ai_difficulty = diffs[idx]

    def _activate_main_menu(self) -> None:
        c = self.menu_cursor
        if c == 0: self.sel_mode = GameMode.ARCADE; self.screen = ScreenState.CHAR_SELECT
        elif c == 1: self.sel_mode = GameMode.VERSUS_CPU; self.screen = ScreenState.CHAR_SELECT
        elif c == 2: self.sel_mode = GameMode.VERSUS_P2; self.screen = ScreenState.CHAR_SELECT
        elif c == 3: self.sel_mode = GameMode.TRAINING; self.screen = ScreenState.CHAR_SELECT
        elif c == 4: self.sel_mode = GameMode.COMBO_TRIALS; self.screen = ScreenState.CHAR_SELECT
        elif c == 5: self.sel_mode = GameMode.SURVIVAL; self.screen = ScreenState.CHAR_SELECT
        elif c == 6:
            if self.match.replay.frames:
                self.match.start_match(GameMode.REPLAY)
                self.screen = ScreenState.BATTLE
            else:
                self.audio.play_sfx(SFXId.UI_DENY)
        elif c == 7: self.screen = ScreenState.GALLERY
        elif c == 8: self.screen = ScreenState.CODEX
        elif c == 9: self.screen = ScreenState.JUKEBOX
        elif c == 10: self.screen = ScreenState.MOVE_LIST
        elif c == 11: self.screen = ScreenState.OPTIONS
        elif c == 12: self.running = False

    def _update_screen(self, dt: float) -> None:
        if self.screen == ScreenState.BATTLE:
            self.match.step_frame(self.inp_mgr)
            if self.match.match_finished:
                if self.match.mode == GameMode.REPLAY:
                    self.audio.play_ost(OSTTrackId.SANCTUM_OF_ASH)
                    self.screen = ScreenState.MAIN_MENU
                else:
                    if self.match.winner_slot == 0:
                        self.audio.play_ost(OSTTrackId.CRIMSON_REQUIEM)
                    self.screen = ScreenState.MATCH_RESULT
        elif self.screen == ScreenState.VS_SPLASH:
            self.stage.update(dt, overdrive_active=True)
            self.vs_timer -= dt
            if self.vs_timer <= 0.0:
                self.screen = ScreenState.BATTLE
        else:
            self.stage.update(dt, overdrive_active=(self.screen == ScreenState.TITLE))

    def _render_screen(self) -> None:
        c = self.canvas
        if self.screen == ScreenState.BATTLE:
            self.match.render(c)
            return
        if self.screen == ScreenState.PAUSE:
            self.match.render(c)
            self._render_pause_overlay(c)
            return

        # Animated panoramic cathedral background behind all menus!
        cam_pan = STAGE_CENTER_X + math.sin(self.ui_time * 0.25) * 180.0
        self.stage.render_background(c, cam_pan, 0.0)
        self.stage.render_foreground_and_particles(c, cam_pan, 0.0)

        if self.screen == ScreenState.TITLE:
            self._render_title_screen(c)
        elif self.screen == ScreenState.MAIN_MENU:
            self._render_main_menu(c)
        elif self.screen == ScreenState.CHAR_SELECT:
            self._render_char_select(c)
        elif self.screen == ScreenState.VS_SPLASH:
            self._render_vs_splash(c)
        elif self.screen == ScreenState.MATCH_RESULT:
            self._render_match_result(c)
        elif self.screen == ScreenState.ARCADE_ENDING:
            self._render_arcade_ending(c)
        elif self.screen == ScreenState.GALLERY:
            self._render_gallery(c)
        elif self.screen == ScreenState.CODEX:
            self._render_codex(c)
        elif self.screen == ScreenState.JUKEBOX:
            self._render_jukebox(c)
        elif self.screen == ScreenState.MOVE_LIST:
            self._render_movelist(c)
        elif self.screen == ScreenState.OPTIONS:
            self._render_options(c)
        elif self.screen == ScreenState.KEY_CONFIG:
            self._render_key_config(c)

