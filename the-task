        for i in range(n):
            t = i * inv_sr
            f = 55.0 + 380.0 * math.exp(-t * 12.0)
            ph += f * inv_sr * _TWO_PI
            sub = math.sin(ph) * math.exp(-t * 4.5)
            shriek = math.sin(t * 4200.0 * math.exp(-t * 2.2)) * math.exp(-t * 6.0) * 0.45
            burst = self._noise_lut[(i * 3) & self._noise_mask] * math.exp(-t * 9.0) * 0.65
            out[i] = _fast_tanh((sub + shriek + burst) * 2.0) * 0.92
