class FontManager:
    """Manages crisp gothic serif/sans fonts with cached outlined & gradient text."""

    def __init__(self) -> None:
        pygame.font.init()
        self._cache: Dict[Tuple[str, int, bool, bool], pygame.font.Font] = {}
        self._render_cache: Dict[Tuple[Any, ...], pygame.Surface] = {}
        self._serif_candidates = [
            "georgia",
            "garamond",
            "palatino",
            "dejavuserif",
            "liberationserif",
            "timesnewroman",
            "serif",
        ]
        self._sans_candidates = [
            "trebuchetms",
            "dejavusans",
            "liberationsans",
            "arial",
            "helvetica",
            "sans",
        ]
        self._mono_candidates = [
            "consolas",
            "dejavusansmono",
            "liberationmono",
            "couriernew",
            "monospace",
        ]
        self._resolved_serif = self._pick_font(self._serif_candidates)
        self._resolved_sans = self._pick_font(self._sans_candidates)
        self._resolved_mono = self._pick_font(self._mono_candidates)

    def _pick_font(self, candidates: Sequence[str]) -> Optional[str]:
        avail = set(pygame.font.get_fonts())
        for name in candidates:
            if name in avail:
                return name
        return None

    def get(
        self,
        style: str = "serif",
        size: int = 20,
        bold: bool = False,
        italic: bool = False,
    ) -> pygame.font.Font:
        key = (style, size, bold, italic)
        fnt = self._cache.get(key)
        if fnt is not None:
            return fnt
        if style == "serif":
            fam = self._resolved_serif
        elif style == "mono":
            fam = self._resolved_mono
        else:
            fam = self._resolved_sans

        if fam is not None:
            fnt = pygame.font.SysFont(fam, size, bold=bold, italic=italic)
        else:
            fnt = pygame.font.Font(None, size)
            fnt.set_bold(bold)
            fnt.set_italic(italic)
        self._cache[key] = fnt
        return fnt

    def render_outlined(
        self,
        text: str,
        size: int = 22,
        color: RGB = UI_TEXT_IVORY,
        outline_color: RGB = (10, 4, 12),
        outline_px: int = 2,
        style: str = "serif",
        bold: bool = True,
        italic: bool = False,
        shadow_offset: Tuple[int, int] = (2, 3),
    ) -> pygame.Surface:
        """Render sharp, highly readable AAA battle text with dark outline & drop shadow."""
        key = (text, size, color, outline_color, outline_px, style, bold, italic, shadow_offset)
        cached = self._render_cache.get(key)
        if cached is not None:
            return cached

        fnt = self.get(style, size, bold, italic)
        base = fnt.render(text, True, color)
        out = fnt.render(text, True, outline_color)
        pad = outline_px + max(abs(shadow_offset[0]), abs(shadow_offset[1])) + 2
        surf = pygame.Surface((base.get_width() + pad * 2, base.get_height() + pad * 2), pygame.SRCALPHA)

        if shadow_offset != (0, 0):
            sh = fnt.render(text, True, (4, 1, 6))
            sh.set_alpha(190)
            surf.blit(sh, (pad + shadow_offset[0], pad + shadow_offset[1]))

        if outline_px > 0:
            for ox in (-outline_px, 0, outline_px):
                for oy in (-outline_px, 0, outline_px):
                    if ox != 0 or oy != 0:
                        surf.blit(out, (pad + ox, pad + oy))

        surf.blit(base, (pad, pad))

        if len(self._render_cache) > 900:
            # Trim oldest third to stay memory-bounded
            drop_keys = list(self._render_cache.keys())[:300]
            for dk in drop_keys:
                del self._render_cache[dk]
        self._render_cache[key] = surf
        return surf

    def draw_text(
        self,
        target: pygame.Surface,
        text: str,
        pos: Tuple[int, int],
        size: int = 22,
        color: RGB = UI_TEXT_IVORY,
        outline_color: RGB = (10, 4, 12),
        outline_px: int = 2,
        style: str = "serif",
        bold: bool = True,
        italic: bool = False,
        align: str = "topleft",
    ) -> pygame.Rect:
        rendered = self.render_outlined(
            text=text,
            size=size,
            color=color,
            outline_color=outline_color,
            outline_px=outline_px,
            style=style,
            bold=bold,
            italic=italic,
        )
        r = rendered.get_rect()
        setattr(r, align, pos)
        target.blit(rendered, r)
        return r

    def draw_wrapped(
        self,
        target: pygame.Surface,
        text: str,
        rect: pygame.Rect,
        size: int = 17,
        color: RGB = UI_TEXT_IVORY,
        style: str = "sans",
        bold: bool = False,
        line_gap: int = 4,
    ) -> int:
        fnt = self.get(style, size, bold, False)
        words = text.split(" ")
        lines: List[str] = []
        cur = ""
        for w in words:
            test = (cur + " " + w).strip()
            if fnt.size(test)[0] <= rect.w or not cur:
                cur = test
            else:
                lines.append(cur)
                cur = w
        if cur:
            lines.append(cur)
        y = rect.y
        step = fnt.get_height() + line_gap
        for ln in lines:
            if y + step > rect.bottom + 4:
                break
            self.draw_text(
                target,
                ln,
                (rect.x, y),
                size=size,
                color=color,
                outline_px=1,
                style=style,
                bold=bold,
                align="topleft",
            )
            y += step
        return y


def draw_metallic_gradient_bar(
    surf: pygame.Surface,
    rect: pygame.Rect,
    fill_ratio: float,
    col_left: RGB,
    col_right: RGB,
    bg_col: RGB = (20, 12, 22),
    reverse: bool = False,
    sheen: bool = True,
    slant: int = 10,
) -> None:
    """Draw a slanted AAA fighting game gauge bar (HP / Soul / Guard) with
    smooth horizontal gradient, vertical specular glass bevel, and gothic border.
    """
    x, y, w, h = rect.x, rect.y, rect.w, rect.h
    if w <= 4 or h <= 2:
        return
    ratio = clamp(fill_ratio, 0.0, 1.0)
    s = min(slant, w // 4)

    def slanted_poly(rx: float, rw: float) -> List[Tuple[float, float]]:
        if not reverse:
            return [
                (rx + s, y),
                (rx + rw + s, y),
                (rx + rw, y + h),
                (rx, y + h),
            ]
        return [
            (rx, y),
            (rx + rw, y),
            (rx + rw + s, y + h),
            (rx + s, y + h),
        ]

    # Trough background
    bg_poly = slanted_poly(float(x), float(w - s))
    pygame.draw.polygon(surf, bg_col, bg_poly)

    # Filled gradient section
    fw = (w - s) * ratio
    if fw > 1.5:
        steps = max(4, min(28, int(fw // 10) + 1))
        seg_w = fw / float(steps)
        start_x = float(x) if not reverse else float(x + (w - s) - fw)
        for i in range(steps):
            t = i / float(max(1, steps - 1))
            c = lerp_color(col_left, col_right, t if not reverse else (1.0 - t))
            sx = start_x + i * seg_w
            poly = slanted_poly(sx, seg_w + 1.0)
            pygame.draw.polygon(surf, c, poly)

        if sheen and h >= 8:
            # Upper specular highlight strip for glossy PS4-era HUD feel
            sh_h = max(2, int(h * 0.36))
            sh_surf = pygame.Surface((w + 4, sh_h + 2), pygame.SRCALPHA)
            sh_start = 0.0 if not reverse else ((w - s) - fw)
            if not reverse:
                sp = [
                    (sh_start + s, 1),
                    (sh_start + fw + s, 1),
                    (sh_start + fw + s * 0.64, sh_h),
                    (sh_start + s * 0.64, sh_h),
                ]
            else:
                sp = [
                    (sh_start, 1),
                    (sh_start + fw, 1),
                    (sh_start + fw + s * 0.36, sh_h),
                    (sh_start + s * 0.36, sh_h),
                ]
            pygame.draw.polygon(sh_surf, (255, 250, 255, 84), sp)
            surf.blit(sh_surf, (x, y))

    # Crisp double metallic frame
    pygame.draw.polygon(surf, UI_BORDER_DARK, bg_poly, 3)
    pygame.draw.polygon(surf, UI_BORDER_SILVER, bg_poly, 1)


def draw_motion_arrow_icon(
    surf: pygame.Surface,
    cx: int,
    cy: int,
    direction: int,
    radius: int = 10,
    color: RGB = UI_TEXT_IVORY,
) -> None:
    """Draw a crisp arcade numpad directional arrow icon (1..9, 5=neutral dot)."""
    if direction == 5:
        pygame.draw.circle(surf, color, (cx, cy), max(2, radius // 3))
        pygame.draw.circle(surf, (14, 8, 16), (cx, cy), max(2, radius // 3), 1)
        return
    angles = {
        6: 0.0,
        3: 45.0,
        2: 90.0,
        1: 135.0,
        4: 180.0,
        7: 225.0,
        8: 270.0,
        9: 315.0,
    }
    deg = angles.get(direction, 0.0)
    r = math.radians(deg)
    ca, sa = math.cos(r), math.sin(r)

    def rot(px: float, py: float) -> Tuple[float, float]:
        return (cx + px * ca - py * sa, cy + px * sa + py * ca)

    arrow = [
        rot(radius, 0.0),
        rot(radius * 0.05, -radius * 0.72),
        rot(radius * 0.05, -radius * 0.30),
        rot(-radius * 0.85, -radius * 0.30),
        rot(-radius * 0.85, radius * 0.30),
        rot(radius * 0.05, radius * 0.30),
        rot(radius * 0.05, radius * 0.72),
    ]
    pygame.draw.polygon(surf, (12, 6, 16), [(x + 1, y + 1) for (x, y) in arrow])
    pygame.draw.polygon(surf, color, arrow)
    pygame.draw.polygon(surf, (24, 14, 28), arrow, 1)


