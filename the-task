def dx_dy_to_numpad(dx: int, dy: int, facing_right: bool) -> int:
    """Convert screen-space (dx, dy) to standard fighting game numpad 1..9."""
    rel_x = dx if facing_right else -dx
    col = 1 if rel_x < 0 else (3 if rel_x > 0 else 2)
    # dy > 0 is down (bottom row 1,2,3); dy < 0 is up (top row 7,8,9)
    if dy > 0:
        row_base = 0
    elif dy < 0:
        row_base = 6
    else:
        row_base = 3
    return row_base + col


class InputBuffer:
    """20-frame side-aware fighting game input buffer & arcade motion parser."""

    def __init__(self, player_idx: int) -> None:
        self.player_idx = player_idx
        self.frames: Deque[InputFrame] = collections.deque(maxlen=INPUT_BUFFER_LEN)
        self.tape: Deque[InputHistoryEntry] = collections.deque(maxlen=18)
        self._prev_held: InputButton = InputButton.NONE
        self._last_facing_right: bool = (player_idx == 0)
        # Seed neutral frame
        neutral = InputFrame(0, 0, 5, InputButton.NONE, InputButton.NONE, InputButton.NONE)
        self.frames.append(neutral)

    def reset(self) -> None:
        self.frames.clear()
        self.tape.clear()
        self._prev_held = InputButton.NONE
        self.frames.append(InputFrame(0, 0, 5, InputButton.NONE, InputButton.NONE, InputButton.NONE))

    def push_raw(
        self, raw_dx: int, raw_dy: int, held: InputButton, facing_right: bool
    ) -> InputFrame:
        self._last_facing_right = facing_right
        pressed = held & (~self._prev_held)
        released = self._prev_held & (~held)
        self._prev_held = held

        numpad = dx_dy_to_numpad(raw_dx, raw_dy, facing_right)
        frame = InputFrame(raw_dx, raw_dy, numpad, held, pressed, released)
        self.frames.append(frame)

        # Record condensed Training Mode input history tape
        if self.tape and self.tape[-1].numpad == numpad and self.tape[-1].buttons == held:
            self.tape[-1].hold_frames = min(999, self.tape[-1].hold_frames + 1)
        else:
            if numpad != 5 or held != InputButton.NONE or not self.tape:
                self.tape.append(InputHistoryEntry(numpad=numpad, buttons=held, hold_frames=1))
        return frame

    @property
    def current(self) -> InputFrame:
        return self.frames[-1]

    def was_pressed(self, btn: InputButton, window: int = 4) -> bool:
        """Return True if button had a rising edge within the last `window` frames."""
        n = len(self.frames)
        start = max(0, n - window)
        for i in range(start, n):
            if self.frames[i].pressed & btn:
                return True
        return False

    def was_any_attack_pressed(self, window: int = 4) -> Optional[InputButton]:
        """Check for recent L/M/H/C rising edge, returning highest priority button."""
        for btn in (InputButton.H, InputButton.C, InputButton.M, InputButton.L):
            if self.was_pressed(btn, window=window):
                return btn
        return None

    def is_holding_back(self) -> bool:
        return self.current.numpad in (1, 4, 7)

    def is_holding_down(self) -> bool:
        return self.current.numpad in (1, 2, 3)

    def is_holding_up(self) -> bool:
        return self.current.numpad in (7, 8, 9)

    def is_holding_forward(self) -> bool:
        return self.current.numpad in (3, 6, 9)

    def check_sequence(
        self, seq: Sequence[int], max_frames: int = 16, allow_diagonals: bool = True
    ) -> bool:
        """Lenient arcade motion recognizer scanning backward over `max_frames`.

        Matches `seq` in chronological order inside the rolling buffer while
        tolerating intermediate transition frames.
        """
        n = len(self.frames)
        if n == 0 or not seq:
            return False
        start = max(0, n - max_frames)
        target_idx = 0
        seq_len = len(seq)

        # Diagonal leniency map so 236 matches 2->3->6 OR 2->6 cleanly on keyboards
        equiv: Dict[int, Set[int]] = {
            2: {1, 2, 3},
            4: {1, 4, 7},
            6: {3, 6, 9},
            8: {7, 8, 9},
        }

        for i in range(start, n):
            np = self.frames[i].numpad
            want = seq[target_idx]
            matched = (np == want)
            if not matched and allow_diagonals and want in equiv:
                # Only allow diagonal leniency if it's not colliding with previous step
                if target_idx == 0 or seq[target_idx - 1] != np:
                    matched = np in equiv[want]
            if matched:
                target_idx += 1
                if target_idx >= seq_len:
                    return True
        return False

    def check_double_tap(self, direction: int, max_frames: int = 12) -> bool:
        """Detect crisp 6-5-6 (Dash), 4-5-4 (Backstep), or 2-5-2 (Eclipse Blink)."""
        n = len(self.frames)
        start = max(0, n - max_frames)
        stage = 0  # 0=want dir, 1=want neutral/non-dir, 2=want dir again
        for i in range(start, n):
            np = self.frames[i].numpad
            if stage == 0:
                if np == direction:
                    stage = 1
            elif stage == 1:
                if np != direction:
                    stage = 2
            elif stage == 2:
                if np == direction:
                    return True
        return False

    def detect_command_move(
        self,
        grounded: bool,
        super_meter: float,
        resonance_gauge: float,
        resonance_active: bool,
        current_state: FighterState,
        simple_mode: bool = False,
    ) -> Optional[Tuple[FighterState, bool]]:
        """Interpret motion commands + button presses into a (FighterState, is_ex) action.

        Priority order follows arcade fighting game standards:
        1. Cursed Resonance Overdrive (R button)
        2. Fatal Execution — Crimson Judgment (214214+Atk or C+S, 200% Meter)
        3. Super Art — Eclipse Requiem (236236+Atk or H+S, 100% Meter)
        4. Rekka Follow-ups (Nightmare Waltz II / III)
        5. Specials: Valhalla Ruin (623), Darkmoon Counter (421), Eclipse Blink (22),
           Blood Moon Wave (236), Nightmare Waltz I (214) + Simple Mode S-shortcuts!
        6. Throw (L+M simultaneous)
        7. Command & Standard Normals (6M, 2L/2M/2H, 5L/5M/5H/5C, j.L/j.M/j.H)
        """
        cur = self.current
        atk_btn = self.was_any_attack_pressed(window=4)
        s_pressed = self.was_pressed(InputButton.S, window=4)
        r_pressed = self.was_pressed(InputButton.R, window=4)
        is_ex_btn = bool(
            (cur.held & InputButton.S) and atk_btn is not None
        ) or (atk_btn == InputButton.C and super_meter >= 50.0)

        # 1. Cursed Resonance Overdrive Activation / Flash Cancel
        if r_pressed and grounded and (resonance_gauge >= MAX_RESONANCE or (resonance_active and super_meter >= 50.0)):
            return (FighterState.OVERDRIVE_ACTIVATE, False)

        # 2. Air Normals (when airborne)
        if not grounded:
            if self.was_pressed(InputButton.H, window=4) or self.was_pressed(InputButton.C, window=4):
                return (FighterState.ATTACK_JH, False)
            if self.was_pressed(InputButton.M, window=4):
                return (FighterState.ATTACK_JM, False)
            if self.was_pressed(InputButton.L, window=4):
                return (FighterState.ATTACK_JL, False)
            return None

        # 3. Fatal Execution — Crimson Judgment (200% Soul Meter)
        if super_meter >= 200.0:
            fatal_shortcut = (
                (self.was_pressed(InputButton.C, window=5) and bool(cur.held & InputButton.S))
                or (self.was_pressed(InputButton.S, window=5) and bool(cur.held & InputButton.C))
            )
            fatal_motion = (atk_btn is not None or s_pressed) and self.check_sequence((2, 1, 4, 2, 1, 4), max_frames=20, allow_diagonals=False)
            fatal_motion_alt = (atk_btn is not None or s_pressed) and self.check_sequence((2, 4, 2, 4), max_frames=18, allow_diagonals=True)
            if fatal_shortcut or fatal_motion or fatal_motion_alt:
                return (FighterState.FATAL_CRIMSON_JUDGMENT, False)

        # 4. Super Art — Eclipse Requiem (100% Soul Meter)
        if super_meter >= 100.0:
            super_shortcut = (
                (self.was_pressed(InputButton.H, window=5) and bool(cur.held & InputButton.S))
                or (self.was_pressed(InputButton.S, window=5) and bool(cur.held & InputButton.H))
            )
            super_motion = (atk_btn is not None or s_pressed) and self.check_sequence((2, 3, 6, 2, 3, 6), max_frames=20, allow_diagonals=False)
            super_motion_alt = (atk_btn is not None or s_pressed) and self.check_sequence((2, 6, 2, 6), max_frames=18, allow_diagonals=True)
            if super_shortcut or super_motion or super_motion_alt:
                return (FighterState.SUPER_ECLIPSE_REQUIEM, False)

        # 5. Rekka Follow-up Chain (Nightmare Waltz I -> II -> III)
        if current_state == FighterState.SPECIAL_PHANTOM_REKKA_1 and (atk_btn is not None or s_pressed):
            return (FighterState.SPECIAL_PHANTOM_REKKA_2, False)
        if current_state == FighterState.SPECIAL_PHANTOM_REKKA_2 and (atk_btn is not None or s_pressed):
            return (FighterState.SPECIAL_PHANTOM_REKKA_3, False)

        # 6. Special Move Motion Detection (Classic Arcade Motions)
        if atk_btn is not None:
            ex_flag = is_ex_btn and super_meter >= 50.0
            # 623 DP — Valhalla Ruin
            if self.check_sequence((6, 2, 3), max_frames=15, allow_diagonals=False) or self.check_sequence((6, 2, 6), max_frames=13, allow_diagonals=True):
                return (FighterState.SPECIAL_ABYSS_ASCENSION, ex_flag)
            # 421 Reverse DP — Darkmoon Counter Parry
            if self.check_sequence((4, 2, 1), max_frames=15, allow_diagonals=False) or self.check_sequence((4, 2, 4), max_frames=13, allow_diagonals=True):
                return (FighterState.SPECIAL_CURSED_PARRY, False)
            # 22 Down-Down — Eclipse Blink
            if self.check_double_tap(2, max_frames=12):
                return (FighterState.SPECIAL_SHADOW_STEP, False)
            # 236 QCF — Blood Moon Wave
            if self.check_sequence((2, 3, 6), max_frames=14, allow_diagonals=False) or self.check_sequence((2, 6), max_frames=11, allow_diagonals=True):
                return (FighterState.SPECIAL_CRESCENT_WAVE, ex_flag)
            # 214 QCB — Nightmare Waltz I
            if self.check_sequence((2, 1, 4), max_frames=14, allow_diagonals=False) or self.check_sequence((2, 4), max_frames=11, allow_diagonals=True):
                return (FighterState.SPECIAL_PHANTOM_REKKA_1, ex_flag)

        # 7. Dedicated Special Button (S) Directional Shortcuts (Always available + boosted in Simple Mode!)
        if s_pressed:
            np = cur.numpad
            ex_flag = bool(cur.held & InputButton.C) and super_meter >= 50.0
            if np in (6, 3):
                return (FighterState.SPECIAL_ABYSS_ASCENSION, ex_flag)
            if np in (4, 1):
                return (FighterState.SPECIAL_PHANTOM_REKKA_1, ex_flag)
            if np == 2:
                return (FighterState.SPECIAL_CURSED_PARRY, False)
            if np in (7, 8, 9):
                return (FighterState.SPECIAL_SHADOW_STEP, False)
            return (FighterState.SPECIAL_CRESCENT_WAVE, ex_flag)

        # 8. Throw (L + M simultaneous)
        if (self.was_pressed(InputButton.L, window=4) and bool(cur.held & InputButton.M)) or (
            self.was_pressed(InputButton.M, window=4) and bool(cur.held & InputButton.L)
        ):
            return (FighterState.THROW_START, False)

        # 9. Taunt
        if self.was_pressed(InputButton.TAUNT, window=3):
            return (FighterState.TAUNT, False)

        # 10. Command & Standing/Crouching Normals
        down_held = self.is_holding_down()
        fwd_held = self.is_holding_forward()
        if self.was_pressed(InputButton.C, window=4):
            return (FighterState.ATTACK_5C, False)
        if self.was_pressed(InputButton.H, window=4):
            return (FighterState.ATTACK_2H if down_held else FighterState.ATTACK_5H, False)
        if self.was_pressed(InputButton.M, window=4):
            if down_held:
                return (FighterState.ATTACK_2M, False)
            if fwd_held and not simple_mode:
                return (FighterState.ATTACK_6M, False)
            if fwd_held and simple_mode:
                return (FighterState.ATTACK_6M, False)
            return (FighterState.ATTACK_5M, False)
        if self.was_pressed(InputButton.L, window=4):
            return (FighterState.ATTACK_2L if down_held else FighterState.ATTACK_5L, False)

        return None


class InputManager:
    """Polls Keyboard (P1 & P2) and up to 2 USB/Bluetooth Gamepads cleanly."""

    def __init__(self) -> None:
        self.joysticks: List[pygame.joystick.Joystick] = []
        self.buffers: List[InputBuffer] = [InputBuffer(0), InputBuffer(1)]
        self._init_joysticks()

    def _init_joysticks(self) -> None:
        try:
            pygame.joystick.init()
            self.joysticks.clear()
            for i in range(min(2, pygame.joystick.get_count())):
                js = pygame.joystick.Joystick(i)
                js.init()
                self.joysticks.append(js)
        except Exception:
            self.joysticks = []

    def rescan_joysticks(self) -> None:
        self._init_joysticks()

    @staticmethod
    def _is_key_down(keys: Any, code: int) -> bool:
        if code == 0:
            return False
        try:
            return bool(keys[code])
        except (IndexError, KeyError, TypeError):
            return False

    def poll_human_player(
        self, player_idx: int, facing_right: bool, keys: Any
    ) -> InputFrame:
        binds = P1_KEYBINDS if player_idx == 0 else P2_KEYBINDS
        kd = self._is_key_down
        dx = 0
        dy = 0
        if kd(keys, binds.left):
            dx -= 1
        if kd(keys, binds.right):
            dx += 1
        if kd(keys, binds.up):
            dy -= 1
        if kd(keys, binds.down):
            dy += 1

        held = InputButton.NONE
        if kd(keys, binds.btn_l) or kd(keys, binds.alt_l):
            held |= InputButton.L
        if kd(keys, binds.btn_m) or kd(keys, binds.alt_m):
            held |= InputButton.M
        if kd(keys, binds.btn_h) or kd(keys, binds.alt_h):
            held |= InputButton.H
        if kd(keys, binds.btn_c) or kd(keys, binds.alt_c):
            held |= InputButton.C
        if kd(keys, binds.btn_s) or kd(keys, binds.alt_s):
            held |= InputButton.S
        if kd(keys, binds.btn_r) or kd(keys, binds.alt_r):
            held |= InputButton.R
        if kd(keys, binds.btn_dash):
            held |= InputButton.DASH
        if kd(keys, binds.btn_taunt):
            held |= InputButton.TAUNT

        # Merge Gamepad input if connected for this player slot
        if player_idx < len(self.joysticks):
            js = self.joysticks[player_idx]
            try:
                if js.get_numhats() > 0:
                    hx, hy = js.get_hat(0)
                    if hx != 0:
                        dx = hx
                    if hy != 0:
                        dy = -hy
                if js.get_numaxes() >= 2:
                    ax = js.get_axis(0)
                    ay = js.get_axis(1)
                    if abs(ax) > 0.42:
                        dx = -1 if ax < 0 else 1
                    if abs(ay) > 0.42:
                        dy = -1 if ay < 0 else 1
                nb = js.get_numbuttons()
                if nb > 0 and js.get_button(0):
                    held |= InputButton.L
                if nb > 1 and js.get_button(1):
                    held |= InputButton.M
                if nb > 2 and js.get_button(2):
                    held |= InputButton.H
                if nb > 3 and js.get_button(3):
                    held |= InputButton.C
                if nb > 4 and js.get_button(4):
                    held |= InputButton.S
                if nb > 5 and js.get_button(5):
                    held |= InputButton.R
                if nb > 6 and js.get_button(6):
                    held |= InputButton.DASH
            except Exception:
                pass

        return self.buffers[player_idx].push_raw(dx, dy, held, facing_right)

    def push_ai_command(
        self, player_idx: int, raw_dx: int, raw_dy: int, held: InputButton, facing_right: bool
    ) -> InputFrame:
        return self.buffers[player_idx].push_raw(raw_dx, raw_dy, held, facing_right)

