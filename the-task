    _register_atlas_part3(atlas)
    _register_atlas_part4(atlas)
    return atlas


class SpriteBank:
    """
    High-performance progressive sprite baking & LRU cache manager.

    Pre-bakes critical neutral/combat frames during the Gothic loading screen
    and lazily bakes remaining frames on demand with flipped mirrors cached for
    locked 60 FPS performance even on low-end laptops.
    """

    def __init__(self, rast: PainterlyRasterizer) -> None:
        self.rast = rast
        self.sculptor = CeciliaCelSculptor(rast)
        self.atlas: Dict[FighterState, List[CelFrameData]] = build_complete_animation_atlas()
        # Cache key: (palette_key, FighterState, frame_idx, facing_right, eclipse_mode)
        self._cache: "collections.OrderedDict[Tuple[str, FighterState, int, bool, bool], pygame.Surface]" = (
            collections.OrderedDict()
        )
        self._max_entries: int = 1600
        self._hud_portraits: Dict[Tuple[str, Tuple[int, int], bool], pygame.Surface] = {}
        self._cutin_cgs: Dict[Tuple[str, bool, bool], pygame.Surface] = {}
        self._vs_busts: Dict[Tuple[str, Tuple[int, int], bool], pygame.Surface] = {}
        self._prebake_queue: List[Tuple[str, FighterState, int]] = []
        self._prebake_total: int = 0
        self._prebake_done: int = 0

    def queue_prebake(self, pal_keys: Sequence[str]) -> None:
        """Schedule essential neutral & core combat cels for smooth loading screen bake."""
        core_states = (
            FighterState.IDLE,
            FighterState.WALK_FWD,
            FighterState.WALK_BACK,
            FighterState.CROUCH,
            FighterState.JUMP_RISE,
            FighterState.JUMP_FALL,
            FighterState.DASH_FWD,
            FighterState.GUARD_STAND,
            FighterState.ATTACK_5L,
            FighterState.ATTACK_5M,
            FighterState.ATTACK_5H,
            FighterState.HIT_STAND_LIGHT,
            FighterState.INTRO_POSE,
        )
        self._prebake_queue.clear()
        seen: Set[str] = set()
        for pk in pal_keys:
            if pk in seen:
                continue
            seen.add(pk)
            for st in core_states:
                frames = self.atlas.get(st, ())
                for idx in range(len(frames)):
                    self._prebake_queue.append((pk, st, idx))
        self._prebake_total = max(1, len(self._prebake_queue))
        self._prebake_done = 0

    def step_prebake(self, batch: int = 8) -> float:
        """Bake a small chunk of cels per frame during loading so UI animates smoothly."""
        for _ in range(batch):
            if not self._prebake_queue:
                break
            pk, st, idx = self._prebake_queue.pop(0)
            self.get_sprite(pk, st, idx, facing_right=True, eclipse_mode=False)
            self._prebake_done += 1
        return clamp(self._prebake_done / float(max(1, self._prebake_total)), 0.0, 1.0)

    def ensure_prebaked(self) -> None:
        while self._prebake_queue:
            self.step_prebake(batch=24)

    def get_keyframes(self, state: FighterState) -> List[CelFrameData]:
        return self.atlas.get(state, self.atlas[FighterState.IDLE])

    def total_authored_keyframes(self) -> int:
        return sum(len(v) for v in self.atlas.values())

    def get_sprite(
        self,
        palette_key: str,
        state: FighterState,
        frame_idx: int,
        facing_right: bool = True,
        eclipse_mode: bool = False,
    ) -> pygame.Surface:
        frames = self.get_keyframes(state)
        idx = clamp_int(frame_idx, 0, len(frames) - 1)
        key = (palette_key, state, idx, facing_right, eclipse_mode)
        surf = self._cache.get(key)
        if surf is not None:
            self._cache.move_to_end(key)
            return surf

        # If left-facing requested, render right-facing once and mirror instantaneously
        if not facing_right:
            right_surf = self.get_sprite(palette_key, state, idx, facing_right=True, eclipse_mode=eclipse_mode)
            flipped = pygame.transform.flip(right_surf, True, False)
            self._store_cache(key, flipped)
            return flipped

        pal = PALETTES.get(palette_key, PALETTES["CRIMSON_ORIGINAL"])
        kf = frames[idx]
        rendered = self.sculptor.render_cel(
            kf, pal, eclipse_mode=eclipse_mode, frame_seed=idx * 17 + len(kf.name)
        )
        if pygame.display.get_surface() is not None:
            rendered = rendered.convert_alpha()
        self._store_cache(key, rendered)
        return rendered

    def _store_cache(
        self,
        key: Tuple[str, FighterState, int, bool, bool],
        surf: pygame.Surface,
    ) -> None:
        self._cache[key] = surf
        if len(self._cache) > self._max_entries:
            self._cache.popitem(last=False)

    def get_hud_portrait(
        self, palette_key: str, size: Tuple[int, int] = (76, 64), facing_right: bool = True
    ) -> pygame.Surface:
        key = (palette_key, size, facing_right)
        s = self._hud_portraits.get(key)
        if s is None:
            pal = PALETTES.get(palette_key, PALETTES["CRIMSON_ORIGINAL"])
            s = self.sculptor.render_hud_portrait(pal, size=size, facing_right=facing_right)
            self._hud_portraits[key] = s
        return s

    def get_super_cutin(
        self, palette_key: str, facing_right: bool = True, eclipse_mode: bool = False
    ) -> pygame.Surface:
        key = (palette_key, facing_right, eclipse_mode)
        s = self._cutin_cgs.get(key)
        if s is None:
            pal = PALETTES.get(palette_key, PALETTES["CRIMSON_ORIGINAL"])
            s = self.sculptor.render_super_cutin_cg(pal, 800, 216, facing_right=facing_right, eclipse_mode=eclipse_mode)
            self._cutin_cgs[key] = s
        return s

    def get_vs_bust(
        self, palette_key: str, size: Tuple[int, int] = (320, 410), facing_right: bool = True
    ) -> pygame.Surface:
        key = (palette_key, size, facing_right)
        s = self._vs_busts.get(key)
        if s is None:
            pal = PALETTES.get(palette_key, PALETTES["CRIMSON_ORIGINAL"])
            s = self.sculptor.render_vs_bust_cg(pal, size=size, facing_right=facing_right)
            self._vs_busts[key] = s
        return s


