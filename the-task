        self.cg.blit_glow(surf, pom_tip, 9 * ss * persp_h, pal.rune_glow, 130, additive=True)

        # 3. Broad Forged Obsidian-Iron Two-Handed Greatsword Blade (True 3D Taper!)
        guard_c = v_add(hilt, v_mul(u_dir, 4.0 * ss * persp_h))
        shoulder = v_add(guard_c, v_mul(u_dir, L * 0.14))
        mid_b = v_add(guard_c, v_mul(u_dir, L * 0.56))
        taper_b = v_add(guard_c, v_mul(u_dir, L * 0.85))

        w_base = 11.4 * ss * persp_h * face_vis
        w_mid = 10.2 * ss * lerp(persp_h, persp_t, 0.55) * face_vis
        w_taper = 8.4 * ss * lerp(persp_h, persp_t, 0.85) * face_vis

        # Upper beveled half & lower beveled half shaded oppositely for razor 3D metallic crest!
        upper_bevel = [
            guard_c,
            v_add(shoulder, v_mul(nrm, w_base * 1.06)),
            v_add(mid_b, v_mul(nrm, w_mid)),
            v_add(taper_b, v_mul(nrm, w_taper)),
            tip,
        ]
        lower_bevel = [
            guard_c,
            tip,
            v_sub(taper_b, v_mul(nrm, w_taper)),
            v_sub(mid_b, v_mul(nrm, w_mid)),
            v_sub(shoulder, v_mul(nrm, w_base * 1.06)),
        ]
        self.cg.fill_shaded_poly(
            surf, upper_bevel,
            [pal.blade_core, pal.blade_steel, pal.blade_edge],
            light_dir=(nrm[0] * 0.8 + 0.2, nrm[1] * 0.8 - 0.2),
            rim_color=pal.aura_mid, rim_width=1.5 * ss,
            ink_color=pal.blade_dark, ink_width=1.4 * ss,
        )
        self.cg.fill_shaded_poly(
            surf, lower_bevel,
            [pal.blade_dark, pal.blade_core, pal.blade_steel],
            light_dir=(-nrm[0] * 0.8, -nrm[1] * 0.8),
            rim_color=pal.rune_glow, rim_width=1.1 * ss,
            ink_color=pal.blade_dark, ink_width=1.4 * ss,
        )

        # Recessed dark obsidian central fuller + intricate carved gothic filigree spine!
        if face_vis > 0.35:
            fw0 = w_base * 0.44
            fw1 = w_taper * 0.34
            f_start = v_add(guard_c, v_mul(u_dir, L * 0.10))
            f_end = v_add(guard_c, v_mul(u_dir, L * 0.80))
            fuller_poly = [
                v_add(f_start, v_mul(nrm, fw0)),
                v_add(f_end, v_mul(nrm, fw1)),
                v_add(f_end, v_mul(u_dir, L * 0.06)),
                v_sub(f_end, v_mul(nrm, fw1)),
                v_sub(f_start, v_mul(nrm, fw0)),
            ]
            pygame.draw.polygon(surf, pal.blade_dark, fuller_poly)
            pygame.draw.aalines(surf, pal.blade_steel, True, fuller_poly)

            # 7 Luminous Glowing Crimson Arcane Runes along the central fuller (char.jpg!)
            for ri in range(7):
                rt = 0.16 + ri * 0.095
                rp = v_lerp(guard_c, tip, rt)
                rsz = lerp(3.4 * persp_h, 2.2 * persp_t, rt) * ss * face_vis
                # Distinct arcane rune glyph strokes per slot
                r_a = v_add(rp, v_mul(nrm, rsz * 0.72))
                r_b = v_sub(rp, v_mul(nrm, rsz * 0.72))
                r_c = v_add(rp, v_mul(u_dir, rsz * 0.95))
                r_d = v_sub(rp, v_mul(u_dir, rsz * 0.95))
                if ri % 3 == 0:
                    g_pts = [r_d, r_a, r_c, r_b]
                elif ri % 3 == 1:
                    g_pts = [r_a, r_c, r_b, r_d]
                else:
