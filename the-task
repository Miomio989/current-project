    def load_tags(self) -> None:
        self.tag_folders, self.tags_by_folder = parse_tag_groups(TAGS_FILE)
        while self.tag_folder_row.count():
            item = self.tag_folder_row.takeAt(0)
            w = item.widget()
            if w is not None:
                w.deleteLater()
        self.tag_folder_btns: Dict[str, FolderChipButton] = {}
        folder = self._active_tag_folder()
        for i, fname in enumerate(self.tag_folders):
            chip = FolderChipButton(fname, tag_folder_color(fname))
            chip.setChecked(fname == folder)
            chip.clicked.connect(lambda _c=False, f=fname: self._select_tag_folder(f))
            self.tag_folder_group.addButton(chip)
            self.tag_folder_row.addWidget(chip, 1 if len(self.tag_folders) <= 4 else 0)
            self.tag_folder_btns[fname] = chip
        self._fill_tag_list(folder)

    def _active_tag_folder(self) -> str:
        folder = str((self.settings.get("ui") or {}).get("tag_folder") or "Artists")
        if folder not in self.tags_by_folder:
            folder = self.tag_folders[0] if self.tag_folders else "General"
        return folder

    def _select_tag_folder(self, folder: str) -> None:
        self.settings.setdefault("ui", {})["tag_folder"] = folder
        self._fill_tag_list(folder)

    def _on_tag_search(self, text: str) -> None:
        self._tag_search = text or ""
        self._fill_tag_list(self._active_tag_folder())

    def _fill_tag_list(self, folder: str) -> None:
        self.tag_list.clear()
        q = self._tag_search.strip().lower()
        fcol = tag_folder_color(folder)
        for g in self.tags_by_folder.get(folder, []):
            if q and q not in f"{g['label']} {g['text']}".lower():
                continue
            it = QListWidgetItem(f"\u25A0 {g['label']}")
            it.setForeground(QColor(fcol))
            it.setData(Qt.ItemDataRole.UserRole, g["text"])
            it.setData(Qt.ItemDataRole.UserRole + 1, folder)
            it.setToolTip(g["text"])
            self.tag_list.addItem(it)

