        # Crimson ruffled jabot
        jb_poly = [
            Vec2(cx - 4 * sc, cy + 24 * sc),
            Vec2(cx + 8 * sc, cy + 24 * sc),
            Vec2(cx + 16 * sc, cy + 48 * sc),
            Vec2(cx + 2 * sc, cy + 54 * sc),
            Vec2(cx - 10 * sc, cy + 46 * sc),
        ]
