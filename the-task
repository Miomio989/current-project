class CameraDirector:
    def __init__(self) -> None:
        self.x: float = STAGE_CENTER_X
        self.y: float = 0.0
        self.shake_mag: float = 0.0
        self.shake_x: float = 0.0
        self.shake_y: float = 0.0

    def add_shake(self, mag: float) -> None:
        self.shake_mag = max(self.shake_mag, min(22.0, mag))

    def update(self, p1: Fighter, p2: Fighter, dt: float, allow_shake: bool = True) -> None:
        mid_x = clamp((p1.x + p2.x) * 0.5, RENDER_W * 0.5, STAGE_WORLD_W - RENDER_W * 0.5)
        min_y = min(p1.y, p2.y)
        target_y = clamp((min_y - GROUND_Y) * 0.24, -64.0, 0.0)
        self.x += (mid_x - self.x) * min(1.0, dt * 10.0)
        self.y += (target_y - self.y) * min(1.0, dt * 8.0)

        if self.shake_mag > 0.2 and allow_shake:
            self.shake_x = random.uniform(-self.shake_mag, self.shake_mag)
            self.shake_y = random.uniform(-self.shake_mag * 0.7, self.shake_mag * 0.7)
            self.shake_mag *= 0.80
        else:
            self.shake_mag = 0.0
            self.shake_x = 0.0
            self.shake_y = 0.0


class VFXDirector:
    """Renders BlazBlue / DMC4 / KoF XIII kinetic hitsparks, projectiles, ghosts & Super Cut-Ins."""

    def __init__(self, cg: StudioCGRasterizer, bank: SpriteBank, port: CeciliaPortraitArtist, fonts: FontManager) -> None:
        self.cg = cg
        self.bank = bank
        self.port = port
        self.fonts = fonts
        self.sparks: List[VFXSpark] = []
        self.rings: List[VFXRing] = []
        self.ghosts: List[AfterimageGhost] = []
        self.projectiles: List[CursedProjectile] = []
        self.super_cutin_timer: float = 0.0
        self.super_cutin_pal_idx: int = 0
        self.super_cutin_facing: bool = True
        self.super_cutin_title: str = ""
        self.super_cutin_is_astral: bool = False
        self.hit_flash_alpha: float = 0.0
        self.hit_flash_color: RGB = (255, 62, 86)

    def clear(self) -> None:
        self.sparks.clear()
        self.rings.clear()
        self.ghosts.clear()
        self.projectiles.clear()
        self.super_cutin_timer = 0.0
        self.hit_flash_alpha = 0.0

    def trigger_super_cutin(self, fighter: Fighter, title: str, is_astral: bool = False) -> None:
        self.super_cutin_timer = 0.78 if is_astral else 0.56
        self.super_cutin_pal_idx = fighter.palette_idx
        self.super_cutin_facing = fighter.facing_right
        self.super_cutin_title = title
        self.super_cutin_is_astral = is_astral

    def trigger_flash(self, color: RGB, alpha: float = 110.0) -> None:
        self.hit_flash_color = color
        self.hit_flash_alpha = max(self.hit_flash_alpha, alpha)

    def spawn_shockwave(self, x: float, y: float, color: RGB, max_r: float = 110.0) -> None:
        self.rings.append(VFXRing(x=x, y=y, r=14.0, max_r=max_r, color=color, alpha=235.0, width=5))

    def spawn_slash_sparks(self, x: float, y: float, count: int = 18, color: RGB = (255, 62, 92), burst: bool = True) -> None:
        for _ in range(count):
            ang = random.uniform(0.0, math.tau)
            spd = random.uniform(140.0, 480.0 if burst else 280.0)
            c = color if random.random() < 0.65 else (255, 236, 206)
            self.sparks.append(VFXSpark(
                x=x, y=y, vx=math.cos(ang) * spd, vy=math.sin(ang) * spd,
                size=random.uniform(2.0, 5.2), color=c, life=0.0,
                max_life=random.uniform(0.18, 0.42), streak=True,
            ))

    def spawn_afterimage(self, f: Fighter) -> None:
        spr = self.bank.get_sprite(f.palette_idx, f.current_kf(), f.facing_right, f.overdrive_timer > 0.0)
        ghost = spr.copy()
        pal = CECILIA_PALETTES[f.palette_idx % len(CECILIA_PALETTES)]
        ghost.fill((pal.aura_mid[0], pal.aura_mid[1], pal.aura_mid[2], 255), special_flags=pygame.BLEND_RGBA_MULT)
        self.ghosts.append(AfterimageGhost(surf=ghost, x=f.x, y=f.y, alpha=148.0, tint=pal.aura_mid))
        if len(self.ghosts) > 22:
            self.ghosts.pop(0)

    def spawn_projectile(self, owner: Fighter, kind: str, spec: MoveSpec) -> None:
        pal = CECILIA_PALETTES[owner.palette_idx % len(CECILIA_PALETTES)]
        sgn = 1.0 if owner.facing_right else -1.0
        if kind == "SWAMP_SPIKE":
            # Cursed swamp eruption ahead of Cecilia!
            self.projectiles.append(CursedProjectile(
                owner.slot, kind, spec, owner.x + sgn * 142.0, GROUND_Y - 12.0,
                0.0, 0.0, owner.facing_right, 0.46, 1, 0, pal,
            ))
            self.spawn_slash_sparks(owner.x + sgn * 142.0, GROUND_Y - 30.0, 16, pal.aura_mid)
        elif kind == "AIR_CRESCENT":
            self.projectiles.append(CursedProjectile(
                owner.slot, kind, spec, owner.x + sgn * 56.0, owner.y - 94.0,
                sgn * 9.8, 5.4, owner.facing_right, 0.92, 1, 0, pal,
            ))
        elif kind == "CRESCENT_EX":
            self.projectiles.append(CursedProjectile(
                owner.slot, kind, spec, owner.x + sgn * 68.0, owner.y - 102.0,
                sgn * 13.4, 0.0, owner.facing_right, 1.25, 3, 0, pal,
            ))
        else:
            spd = 10.8 if kind == "CRESCENT_H" else 7.8
            self.projectiles.append(CursedProjectile(
                owner.slot, kind, spec, owner.x + sgn * 62.0, owner.y - 100.0,
                sgn * spd, 0.0, owner.facing_right, 1.20, 1, 0, pal,
            ))

    def update(self, dt: float) -> None:
        if self.super_cutin_timer > 0.0:
            self.super_cutin_timer = max(0.0, self.super_cutin_timer - dt)
        if self.hit_flash_alpha > 0.0:
            self.hit_flash_alpha = max(0.0, self.hit_flash_alpha - dt * 520.0)

        new_sp: List[VFXSpark] = []
        for s in self.sparks:
            s.life += dt
            s.x += s.vx * dt
            s.y += s.vy * dt
            s.vx *= 0.94
            s.vy = s.vy * 0.94 + 280.0 * dt
            if s.life < s.max_life:
                new_sp.append(s)
        self.sparks = new_sp

        new_r: List[VFXRing] = []
        for r in self.rings:
            r.r += (r.max_r - r.r) * min(1.0, dt * 14.0) + 120.0 * dt
            r.alpha -= 620.0 * dt
            if r.alpha > 4.0 and r.r < r.max_r:
                new_r.append(r)
        self.rings = new_r

        new_g: List[AfterimageGhost] = []
        for g in self.ghosts:
            g.alpha -= 540.0 * dt
            if g.alpha > 8.0:
                new_g.append(g)
        self.ghosts = new_g

        new_p: List[CursedProjectile] = []
        for p in self.projectiles:
            p.life -= dt
            p.x += p.vx
            p.y += p.vy
            if p.hit_cooldown > 0:
                p.hit_cooldown -= 1
            if p.life > 0.0 and p.hits_left > 0 and STAGE_LEFT_WALL - 80 < p.x < STAGE_RIGHT_WALL + 80 and p.y <= GROUND_Y + 12:
                new_p.append(p)
        self.projectiles = new_p

    def render_afterimages(self, surf: pygame.Surface, cam_x: float, cam_y: float) -> None:
        wx_off = RENDER_W * 0.5 - cam_x
        for g in self.ghosts:
            g.surf.set_alpha(clamp_int(int(g.alpha), 0, 180))
            surf.blit(g.surf, (int(g.x + wx_off - SPRITE_ANCHOR_X), int(g.y - cam_y - SPRITE_ANCHOR_Y)))

    def render_world_vfx(self, surf: pygame.Surface, cam_x: float, cam_y: float) -> None:
        wx_off = RENDER_W * 0.5 - cam_x
        cy = -cam_y

        # Projectiles (Glowing Cursed Blood Moon Crescent Waves & Swamp Spikes!)
        for p in self.projectiles:
            px = p.x + wx_off
            py = p.y + cy
            sgn = 1.0 if p.facing_right else -1.0
            if p.kind == "SWAMP_SPIKE":
                grow = clamp((0.46 - p.life) * 8.0, 0.2, 1.0)
                sh = 112.0 * grow
                pts = [(px - 28, py + 8), (px - 10, py - sh * 0.65), (px + sgn * 8, py - sh), (px + 22, py - sh * 0.5), (px + 30, py + 8)]
                self.cg.fill_shaded_poly(surf, pts, [p.pal.blade_dark, p.pal.aura_outer, p.pal.aura_mid, p.pal.aura_core], light_dir=(0.4, -0.9))
                self.cg.blit_glow(surf, (px, py - sh * 0.55), 54, p.pal.aura_mid, 145, additive=True)
            else:
                sz = 1.32 if p.kind == "CRESCENT_EX" else (1.12 if p.kind == "CRESCENT_H" else 0.88)
                outer = sample_cubic(
                    (px - sgn * 22 * sz, py - 58 * sz),
                    (px + sgn * 36 * sz, py - 24 * sz),
                    (px + sgn * 36 * sz, py + 24 * sz),
                    (px - sgn * 22 * sz, py + 58 * sz), 12,
                )
                inner = sample_cubic(
                    (px - sgn * 26 * sz, py - 52 * sz),
                    (px + sgn * 8 * sz, py - 18 * sz),
                    (px + sgn * 8 * sz, py + 18 * sz),
                    (px - sgn * 26 * sz, py + 52 * sz), 12,
                )
                self.cg.draw_feathered_ribbon(surf, outer, inner, [p.pal.aura_outer, p.pal.aura_mid, p.pal.aura_core], alpha=240, additive=True)
                self.cg.blit_glow(surf, (px + sgn * 10 * sz, py), 48 * sz, p.pal.aura_mid, 135, additive=True)

        # Expanding shockwave rings
        for r in self.rings:
            rx = int(r.x + wx_off)
            ry = int(r.y + cy)
            ir = max(4, int(r.r))
            rs = pygame.Surface((ir * 2 + 6, ir * 2 + 6), pygame.SRCALPHA)
            a = clamp_int(int(r.alpha), 0, 240)
            pygame.draw.circle(rs, (r.color[0], r.color[1], r.color[2], a), (ir + 3, ir + 3), ir, r.width)
            surf.blit(rs, (rx - ir - 3, ry - ir - 3), special_flags=pygame.BLEND_RGBA_ADD)

        # Kinetic slash impact sparks!
        for s in self.sparks:
            px = s.x + wx_off
            py = s.y + cy
            u = 1.0 - (s.life / max(0.05, s.max_life))
            if s.streak:
                tail = (px - s.vx * 0.032, py - s.vy * 0.032)
                pygame.draw.line(surf, s.color, (int(px), int(py)), (int(tail[0]), int(tail[1])), max(1, int(s.size * u)))
            pygame.draw.circle(surf, (255, 248, 236), (int(px), int(py)), max(1, int(s.size * 0.65 * u)))

    def render_screen_overlays(self, surf: pygame.Surface) -> None:
