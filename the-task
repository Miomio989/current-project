    def save_current(self) -> None:
        path = self._current_image()
        if not path:
            self._flash_summary("Nothing to save — no image open.")
            return
        if os.path.dirname(path) == OUTPUT_DIR:
            self._flash_summary("Already saved in outputs/.")
            return
        dest = self.store.save_to_output(path)
        self.gallery_tab.mark_dirty()
        self.refresh_gallery(select=dest)
        self.show_image(dest)
        self.toast.notify(f"Saved \u2192 {os.path.basename(dest)}", "ok")
        STUDIO_LOG.ok("SYS", f"Saved {os.path.basename(path)} into outputs/")

    def delete_current(self) -> None:
        """Delete the current render immediately — no confirmation dialog
        (v4.2: deletion is one deliberate click, Ctrl+Z-style second-guessing
        is intentionally left out of the workflow)."""
        path = self._current_image()
        if not path:
            return
        self.store.delete_file(path)
        self.gallery_tab.mark_dirty()
        remaining = self.store.list_recent()
        self.show_image(remaining[0] if remaining else None)
        self.refresh_gallery()
        self._flash_summary(f"Deleted {os.path.basename(path)}.")

