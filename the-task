@dataclass
class PlayerHabitProfile:
    """Tracks human opponent habits mid-match so AI genuinely adapts like a real rival!"""
    jump_rate: float = 0.20
    low_attack_rate: float = 0.25
    overhead_rate: float = 0.15
    throw_rate: float = 0.12
    projectile_rate: float = 0.15
    wakeup_mash_rate: float = 0.30
    samples: int = 0


class ShadowCeciliaAI:
    """
    True fighting-game tactical AI with:
      - Real-time spacing envelope evaluation (close, footsie-mid, greatsword-tip, zoning)
      - Hit-confirm branching across 12 handcrafted combo routes
      - Anti-air & whiff-punish reaction engine scaled cleanly by AIDifficulty
      - Live mid-match player-habit profiling & counter-adaptation!
    """

    def __init__(self, persona: RivalPersona) -> None:
        self.persona = persona
        self.diff = persona.difficulty
        self.habits = PlayerHabitProfile()
        self.decision_cd: int = 0
        self.combo_queue: Deque[FighterState] = collections.deque()
        self.desired_dx: int = 0
        self.desired_dy: int = 0
        self.block_timer: int = 0
        self.block_low: bool = False
        self.last_opp_state: FighterState = FighterState.IDLE

    def reset_round(self) -> None:
        self.combo_queue.clear()
        self.decision_cd = 12
        self.block_timer = 0
        self.desired_dx = 0
        self.desired_dy = 0

    def _observe_opponent(self, opp: Fighter) -> None:
        if opp.state == self.last_opp_state:
            return
        self.last_opp_state = opp.state
        lr = 0.16 * self.diff.adaptation_rate
        self.habits.samples += 1
        if opp.state == FighterState.JUMP_RISE:
            self.habits.jump_rate = lerp(self.habits.jump_rate, 1.0, lr)
        elif opp.state in (FighterState.ATTACK_2L, FighterState.ATTACK_2M, FighterState.ATTACK_3H):
            self.habits.low_attack_rate = lerp(self.habits.low_attack_rate, 1.0, lr)
        elif opp.state in (FighterState.ATTACK_6M, FighterState.ATTACK_JH, FighterState.SP_CATHEDRAL_DESCENT):
            self.habits.overhead_rate = lerp(self.habits.overhead_rate, 1.0, lr)
        elif opp.state == FighterState.THROW_ATTEMPT:
            self.habits.throw_rate = lerp(self.habits.throw_rate, 1.0, lr)
        elif opp.state == FighterState.SP_CRIMSON_CRESCENT:
            self.habits.projectile_rate = lerp(self.habits.projectile_rate, 1.0, lr)
        else:
            # Gentle decay toward neutral baseline
            self.habits.jump_rate *= 0.992
            self.habits.low_attack_rate *= 0.992

    def compute_action(
        self,
        ai: Fighter,
        opp: Fighter,
        vfx: VFXManager,
        can_control: bool,
    ) -> Tuple[int, int, InputButton, Optional[FighterState]]:
        """
        Return (dx, dy, held_buttons, forced_state_transition) for the AI fighter.
        """
        if not can_control:
            return (0, 0, InputButton.NONE, None)
        self._observe_opponent(opp)

        dist = abs(opp.x - ai.x)
        fwd = 1 if ai.facing_right else -1
        back = -fwd

        # 1. Instant Parry Riposte follow-up when AI lands a Just-Parry!
        if ai.state == FighterState.PARRY_SUCCESS and ai.can_cancel_into(FighterState.PARRY_RIPOSTE):
            return (0, 0, InputButton.HEAVY, FighterState.PARRY_RIPOSTE)

        # 2. Execute queued hit-confirm combo step seamlessly!
        if self.combo_queue and (ai.move_connected or ai.can_act_freely):
            nxt = self.combo_queue[0]
            if ai.can_cancel_into(nxt):
                self.combo_queue.popleft()
                return (fwd, 0, InputButton.NONE, nxt)
        elif not ai.is_attacking and not ai.can_act_freely:
            self.combo_queue.clear()

        # 3. Defensive Threat Detection (incoming melee strike or Bloodmoon projectile!)
        incoming_proj = any(
            pr.owner_id != ai.player_id and abs(pr.x - ai.x) < 165.0 for pr in vfx.projectiles
        )
        opp_attacking = opp.is_attacking and dist < 245.0
        if (opp_attacking or incoming_proj) and ai.can_act_freely and self.block_timer <= 0:
            # Check adaptive Just-Parry opportunity!
            if ai.is_grounded and ai.parry_cooldown <= 0 and random.random() < (self.persona.parry_bias * self.diff.defense_rate * 0.24):
                ai.parry_cooldown = 28
                return (0, 0, InputButton.SPECIAL, FighterState.PARRY_STANCE)
            # Check smart High/Low guard
            if random.random() < self.diff.defense_rate:
                self.block_timer = random.randint(10, 18)
                opp_spec = ai.move_reg.get(opp.state)
                if opp_spec is not None and opp_spec.hit_windows:
                    h_type = opp_spec.hit_windows[0].height
                    if h_type == AttackHeight.LOW:
                        self.block_low = True
                    elif h_type == AttackHeight.HIGH:
                        self.block_low = False
                    else:
                        self.block_low = (random.random() < self.habits.low_attack_rate)
                else:
                    self.block_low = False

        if self.block_timer > 0:
            self.block_timer -= 1
            return (back, 1 if self.block_low else 0, InputButton.NONE, None)

        # 4. Reaction-gated tactical decisions
        if self.decision_cd > 0:
            self.decision_cd -= 1
            return (self.desired_dx, self.desired_dy, InputButton.NONE, None)

        self.decision_cd = max(4, self.diff.reaction_frames + random.randint(-2, 4))

        # 4a. Airborne attack decisions
        if not ai.is_grounded:
            if dist < 175.0 and ai.vy > -1.0:
                choice = random.choice((FighterState.ATTACK_JH, FighterState.ATTACK_JM, FighterState.SP_CATHEDRAL_DESCENT))
                if ai.can_cancel_into(choice):
                    return (fwd, 0, InputButton.NONE, choice)
            return (fwd if dist > 110.0 else 0, 0, InputButton.NONE, None)

        # 4b. Anti-Air Reaction against jumping human opponent!
        if not opp.is_grounded and dist < 175.0 and random.random() < (0.55 + self.habits.jump_rate * 0.4) * self.diff.defense_rate:
            aa = FighterState.SP_VALKYRIE_FANG if random.random() < 0.55 else FighterState.ATTACK_2H
            if ai.can_cancel_into(aa):
                return (fwd, 0, InputButton.NONE, aa)

        # 4c. Activate Eclipse Overdrive or unleash Eclipse Fatal / Super Arts!
        if ai.curse >= 550 and not ai.is_eclipse and ai.hp < MAX_HP * 0.58 and random.random() < 0.25:
            return (0, 0, InputButton.ECLIPSE, FighterState.ECLIPSE_BURST)
        if ai.is_eclipse and ai.curse >= 1000 and dist < 210.0 and random.random() < 0.35 * self.diff.combo_rate:
            return (fwd, 0, InputButton.NONE, FighterState.FATAL_ASTRAL_EXEC)
        if ai.curse >= 500 and dist < 195.0 and (opp.is_attacking or random.random() < 0.14 * self.persona.aggression):
            sup = FighterState.SUPER_REQUIEM if dist < 165.0 else FighterState.SUPER_CATACLYSM
            return (fwd, 0, InputButton.NONE, sup)

        # 4d. Range-based Footsies, Mixups & Hit-Confirm Combos!
        roll = random.random()
        if dist < 86.0:
            # Point-blank pressure: Throw mixup, 2L low confirm, 5L frame-trap, or 6M overhead
            if roll < 0.22:
                return (fwd, 0, InputButton.NONE, FighterState.THROW_ATTEMPT)
            if roll < 0.50:
                if random.random() < self.diff.combo_rate:
                    self.combo_queue.extend((FighterState.ATTACK_2M, FighterState.SP_REKKA_1, FighterState.SP_REKKA_2, FighterState.SP_REKKA_3))
                return (0, 1, InputButton.NONE, FighterState.ATTACK_2L)
            if roll < 0.72:
                if random.random() < self.diff.combo_rate:
                    self.combo_queue.extend((FighterState.ATTACK_5M, FighterState.ATTACK_5H, FighterState.SP_CRIMSON_CRESCENT))
                return (0, 0, InputButton.NONE, FighterState.ATTACK_5L)
            if roll < 0.88:
                return (fwd, 0, InputButton.NONE, FighterState.ATTACK_6M)
            return (back, 0, InputButton.NONE, FighterState.BACKDASH)

        if dist < 192.0:
            # Prime Greatsword Footsie Sweetspot!
            if roll < 0.28 * self.persona.footsies_bias:
                if random.random() < self.diff.combo_rate:
                    self.combo_queue.extend((FighterState.ATTACK_5H, FighterState.SP_REKKA_1, FighterState.SP_REKKA_2, FighterState.SP_REKKA_3))
                return (0, 0, InputButton.NONE, FighterState.ATTACK_5M)
            if roll < 0.48:
                if random.random() < self.diff.combo_rate:
                    self.combo_queue.append(FighterState.SP_CRIMSON_CRESCENT)
                return (0, 0, InputButton.NONE, FighterState.ATTACK_5H)
            if roll < 0.64:
                if random.random() < self.diff.combo_rate:
                    self.combo_queue.extend((FighterState.SP_REKKA_2, FighterState.SP_REKKA_3))
                return (0, 0, InputButton.NONE, FighterState.SP_REKKA_1)
            if roll < 0.78:
                return (0, 1, InputButton.NONE, FighterState.ATTACK_3H)
            if roll < 0.88:
                return (fwd, 0, InputButton.NONE, FighterState.SP_BLOOD_IMPALE)
            self.desired_dx = fwd if random.random() < self.persona.aggression else back
            self.desired_dy = 0
            return (self.desired_dx, 0, InputButton.NONE, None)

        # Far spacing (>192px): Projectile zoning, Dash-in Skewer, or Jump-in pressure
        if roll < self.persona.projectile_bias * 0.52:
            return (0, 0, InputButton.NONE, FighterState.SP_CRIMSON_CRESCENT)
        if roll < 0.66:
            return (fwd, 0, InputButton.NONE, FighterState.DASH_FWD)
        if roll < 0.80:
            return (fwd, -1, InputButton.NONE, FighterState.JUMP_SQUAT)
        self.desired_dx = fwd
        self.desired_dy = 0
        return (fwd, 0, InputButton.NONE, None)


class TrainingDummyController:
    """Configurable Training Lab dummy behavior controller."""

    def __init__(self, settings: TrainingSettings, spar_ai: ShadowCeciliaAI) -> None:
        self.tcfg = settings
        self.spar_ai = spar_ai

    def compute_action(
        self, dummy: Fighter, p1: Fighter, vfx: VFXManager, can_control: bool
    ) -> Tuple[int, int, InputButton, Optional[FighterState]]:
        mode = self.tcfg.dummy_mode
        if mode == DummyMode.CPU_SPAR:
            return self.spar_ai.compute_action(dummy, p1, vfx, can_control)
        back = -1 if dummy.facing_right else 1
        if mode == DummyMode.CROUCH:
            return (0, 1, InputButton.NONE, None)
        if mode == DummyMode.JUMP:
            return (0, -1 if dummy.is_grounded else 0, InputButton.NONE, None)
        if mode == DummyMode.GUARD_ALL:
            opp_spec = dummy.move_reg.get(p1.state)
            low = bool(opp_spec and opp_spec.hit_windows and opp_spec.hit_windows[0].height == AttackHeight.LOW)
            return (back, 1 if low else 0, InputButton.NONE, None)
        if mode == DummyMode.GUARD_AFTER_FIRST:
            if dummy.combo_count >= 1 or dummy.is_guarding:
                return (back, 0, InputButton.NONE, None)
            return (0, 0, InputButton.NONE, None)
        if mode == DummyMode.COUNTER_HIT:
            if dummy.can_act_freely and dummy.state_frame % 26 == 0:
                return (0, 0, InputButton.NONE, FighterState.ATTACK_5H)
            return (0, 0, InputButton.NONE, None)
        if mode == DummyMode.REVERSAL_PARRY:
            if p1.is_attacking and dummy.can_act_freely and dummy.parry_cooldown <= 0:
                dummy.parry_cooldown = 24
                return (0, 0, InputButton.SPECIAL, FighterState.PARRY_STANCE)
            return (0, 0, InputButton.NONE, None)
        return (0, 0, InputButton.NONE, None)


