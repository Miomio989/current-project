@dataclass
class PlayerHabitProfile:
    jump_rate: float = 0.20
    low_attack_rate: float = 0.25
    aggression_rate: float = 0.50
    throw_rate: float = 0.12
    whiff_count: int = 0


class DarkmoonTacticalAI:
    """
    Tournament-caliber adaptive fighting-game AI for Shadow Cecilia / Arcade
    Rival Personas. Evaluates spacing zones, reads opponent habits, executes
    footsies, anti-airs, whiff punishes, Just-Guards, multi-hit cancel combos,
    and Eclipse Overdrive / Super finishers calibrated cleanly to difficulty.
    """

    def __init__(
        self,
        difficulty: AIDifficulty = AIDifficulty.HUNTER,
        persona: Optional[RivalPersona] = None,
    ) -> None:
        self.difficulty = difficulty
        self.persona = persona
        self.habits = PlayerHabitProfile()
        self._decision_cd: int = 0
        self._queued_inputs: Deque[InputFrame] = collections.deque()
        self._block_hold: int = 0
        self._walk_dir: int = 5
        self._rng = random.Random(66601)

    def configure(self, difficulty: AIDifficulty, persona: Optional[RivalPersona]) -> None:
        self.difficulty = difficulty
        self.persona = persona
        self._queued_inputs.clear()
        self._decision_cd = 8
        self._block_hold = 0

    def observe_opponent(self, opp: Fighter) -> None:
        alpha = 0.025
        self.habits.jump_rate = lerp(self.habits.jump_rate, 0.0 if opp.grounded else 1.0, alpha)
        self.habits.aggression_rate = lerp(self.habits.aggression_rate, 1.0 if opp.is_attacking() else 0.0, alpha)
        if opp.state in (FighterState.ATK_2A, FighterState.ATK_2B, FighterState.ATK_2D):
            self.habits.low_attack_rate = lerp(self.habits.low_attack_rate, 1.0, alpha * 2.0)
        if opp.state == FighterState.THROW_ATTEMPT:
            self.habits.throw_rate = lerp(self.habits.throw_rate, 1.0, alpha * 3.0)

    def next_input(self, me: Fighter, opp: Fighter) -> InputFrame:
        self.observe_opponent(opp)

        if self._queued_inputs:
            return self._queued_inputs.popleft()

        dist = abs(opp.x - me.x)
        d = self.difficulty
        aggr = d.aggression * (0.7 + 0.6 * (self.persona.aggression_bias if self.persona else 0.55))
        zone_b = self.persona.zoning_bias if self.persona else 0.50
        air_b = self.persona.aerial_bias if self.persona else 0.50
        parry_b = self.persona.parry_bias if self.persona else 0.45

        # 1. Active Defensive Reaction vs Incoming Strikes / Projectiles
        if opp.is_attacking() and dist < 215.0 and not me.is_hitstun():
            if self._block_hold > 0:
                self._block_hold -= 1
                is_low = opp.state in (FighterState.ATK_2A, FighterState.ATK_2B, FighterState.ATK_2D)
                return InputFrame(numpad=1 if is_low else 4)

            if self._rng.random() < (0.35 + d.parry_rate * 0.55):
                # High-tier personas occasionally unleash Darkmoon Riposte or Invincible Ascension!
                if dist < 135.0 and me.grounded and self._rng.random() < (d.parry_rate * parry_b * 0.35):
                    self._enqueue_motion((4, 2, 1), InputButton.D)
                    return self._queued_inputs.popleft()
                if dist < 115.0 and not opp.grounded and self._rng.random() < (d.combo_rate * 0.45):
                    self._enqueue_motion((6, 2, 3), InputButton.B)
                    return self._queued_inputs.popleft()
                self._block_hold = self._rng.randint(6, 16)
                is_low = opp.state in (FighterState.ATK_2A, FighterState.ATK_2B, FighterState.ATK_2D)
                return InputFrame(numpad=1 if is_low else 4)

        # 2. Hit-Confirm Combo Extensions!
        if me.is_attacking() and me.has_hit_this_move and self._rng.random() < d.combo_rate:
            if me.state in (FighterState.ATK_5A, FighterState.ATK_2A):
                return InputFrame(numpad=5, pressed=InputButton.B, held=InputButton.B)
            if me.state == FighterState.ATK_5B:
                if self._rng.random() < 0.55:
                    return InputFrame(numpad=6, pressed=InputButton.B, held=InputButton.B)
                return InputFrame(numpad=5, pressed=InputButton.C, held=InputButton.C)
            if me.state in (FighterState.ATK_5C, FighterState.ATK_6B):
                if me.curse_meter >= 5000 and self._rng.random() < (0.38 * d.combo_rate):
                    self._enqueue_motion((2, 6, 2, 6), InputButton.C)
                    return self._queued_inputs.popleft()
                if self._rng.random() < 0.52:
                    self._enqueue_motion((2, 1, 4), InputButton.B)
                    return self._queued_inputs.popleft()
                self._enqueue_motion((2, 3, 6), InputButton.B)
                return self._queued_inputs.popleft()

        # 3. Wakeup Tech when Knocked Down
        if me.state == FighterState.KNOCKDOWN_LIE and me.state_elapsed >= 18:
            roll_dir = self._rng.choice((4, 5, 6))
            return InputFrame(numpad=roll_dir, pressed=InputButton.A, held=InputButton.A)

        # 4. Airborne Attack Selection
        if not me.grounded:
            if dist < 135.0 and me.y > GROUND_Y - 170.0 and self._rng.random() < 0.40:
                if self._rng.random() < 0.35 * air_b:
                    self._enqueue_motion((2, 3, 6), InputButton.B)
                    return self._queued_inputs.popleft()
                btn = self._rng.choice((InputButton.B, InputButton.C))
                return InputFrame(numpad=5, pressed=btn, held=btn)
            return InputFrame(numpad=6 if dist > 90.0 else 5)

        if self._decision_cd > 0:
            self._decision_cd -= 1
            return InputFrame(numpad=self._walk_dir)

        self._decision_cd = max(4, d.reaction_frames + self._rng.randint(2, 10))

        # 5. Eclipse Overdrive Activation when low HP & meter ready
        if me.curse_meter >= 5000 and me.eclipse_timer <= 0.0 and me.health < 5500 and self._rng.random() < 0.16:
            return InputFrame(numpad=5, pressed=InputButton.ECLIPSE, held=InputButton.ECLIPSE)

        # 6. Anti-Air Punish when Opponent Jumps In
        if not opp.grounded and dist < 175.0 and self._rng.random() < (0.35 + d.combo_rate * 0.50):
            if self._rng.random() < 0.55:
                return InputFrame(numpad=2, pressed=InputButton.C, held=InputButton.C)
            self._enqueue_motion((6, 2, 3), InputButton.C)
            return self._queued_inputs.popleft()

        # 7. Spacing-Zone Neutral & Offense Decision Tree
        roll = self._rng.random()
        if dist < 88.0:
            # Close Scramble: Light confirm, low/overhead mixup, or Throw!
            if roll < 0.22 * aggr:
                return InputFrame(numpad=5, pressed=InputButton.THROW, held=InputButton.THROW)
            if roll < 0.48 * aggr:
                return InputFrame(numpad=2 if self._rng.random() < 0.55 else 5, pressed=InputButton.A, held=InputButton.A)
            if roll < 0.72 * aggr:
                return InputFrame(numpad=6, pressed=InputButton.A, held=InputButton.A)
            if roll < 0.85:
                self._walk_dir = 4
                return InputFrame(numpad=4)
            return InputFrame(numpad=5, pressed=InputButton.B, held=InputButton.B)

        elif dist < 195.0:
            # Mid-Range Sword Footsies (Cecilia's signature lethal zone!)
            if me.curse_meter >= 10000 and opp.health < 4200 and roll < 0.24 * d.combo_rate:
                self._enqueue_motion((2, 6, 2, 6), InputButton.D)
                return self._queued_inputs.popleft()
            if roll < 0.24 * aggr:
                return InputFrame(numpad=6, pressed=InputButton.B, held=InputButton.B)
            if roll < 0.46 * aggr:
                return InputFrame(numpad=5, pressed=InputButton.B, held=InputButton.B)
            if roll < 0.64 * aggr:
                return InputFrame(numpad=2, pressed=InputButton.B, held=InputButton.B)
            if roll < 0.78 * aggr:
                return InputFrame(numpad=5, pressed=InputButton.C, held=InputButton.C)
            if roll < 0.88 * aggr:
                self._enqueue_motion((2, 1, 4), InputButton.B)
                return self._queued_inputs.popleft()
            self._walk_dir = 6 if self._rng.random() < 0.6 else 4
            return InputFrame(numpad=self._walk_dir)

        else:
            # Far Range: Crimson Crescent wave, Cathedral Sigil, Dash-In, or Jump-In!
            if roll < 0.34 * zone_b:
                btn = InputButton.C if (me.curse_meter >= 5000 and self._rng.random() < 0.32) else InputButton.B
                self._enqueue_motion((2, 3, 6), btn)
                return self._queued_inputs.popleft()
            if roll < 0.52 * zone_b:
                self._enqueue_motion((2, 5, 2), InputButton.B)
                return self._queued_inputs.popleft()
            if roll < 0.68 * air_b:
                return InputFrame(numpad=9)
            if roll < 0.86:
                self._enqueue_double_tap(6)
                return self._queued_inputs.popleft()
            self._walk_dir = 6
            return InputFrame(numpad=6)

    def _enqueue_motion(self, seq: Sequence[int], btn: InputButton) -> None:
        for i, d in enumerate(seq):
            if i == len(seq) - 1:
                self._queued_inputs.append(InputFrame(numpad=d, pressed=btn, held=btn))
            else:
                self._queued_inputs.append(InputFrame(numpad=d))

    def _enqueue_double_tap(self, direction: int) -> None:
        self._queued_inputs.append(InputFrame(numpad=direction))
        self._queued_inputs.append(InputFrame(numpad=5))
        self._queued_inputs.append(InputFrame(numpad=direction))


class TrainingDummyController:
    """Controls the Training Lab dummy (Stand, Crouch, Jump, Guard, Counter, CPU)."""

    def __init__(self, ai: DarkmoonTacticalAI) -> None:
        self.ai = ai

    def next_input(self, dummy: Fighter, player: Fighter, cfg: TrainingSettings) -> InputFrame:
        m = cfg.dummy_mode
        if m == DummyMode.CPU_SPAR:
            return self.ai.next_input(dummy, player)
        if m == DummyMode.CROUCH:
            return InputFrame(numpad=2)
        if m == DummyMode.JUMP:
            return InputFrame(numpad=8 if dummy.grounded else 5)
        if m == DummyMode.GUARD_ALL:
            is_low = player.state in (FighterState.ATK_2A, FighterState.ATK_2B, FighterState.ATK_2D)
            return InputFrame(numpad=1 if is_low else 4)
        if m == DummyMode.GUARD_AFTER_FIRST:
            if dummy.combo_received >= 1 or dummy.is_guarding_state():
                is_low = player.state in (FighterState.ATK_2A, FighterState.ATK_2B, FighterState.ATK_2D)
                return InputFrame(numpad=1 if is_low else 4)
            return InputFrame(numpad=5)
        if m == DummyMode.COUNTER_HIT_FORCE:
            if dummy.is_free_actionable() and abs(dummy.x - player.x) < 220.0:
                return InputFrame(numpad=5, pressed=InputButton.A, held=InputButton.A)
        return InputFrame(numpad=5)


