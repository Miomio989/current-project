class BattleHUDRenderer:
    """
    Renders the complete Soulcalibur / DMC4 / Bayonetta / mockup.jpg Battle HUD:
      - Top-left calligraphic 「呪いの刃」 emblem + ornate Gothic portrait frames
      - Angled metallic crimson/magenta health gauges + recoverable white/gold drain
      - Poise/Guard Integrity sub-bars + glowing Gothic diamond round-win gems
      - Top-center ornate silver-filigree Gothic crest timer medallion
      - Mid-left/right DMC4/Bayonetta beveled Stylish Rank badge + Hit/Damage/Bonus
      - Bottom-corner circular Gothic Curse Resonance jewel orbs + segmented super bars
    """

    def __init__(self, rast: PainterlyRasterizer, bank: SpriteBank, fonts: FontManager) -> None:
        self.rast = rast
        self.bank = bank
        self.fonts = fonts
        self.mini_logo = render_calligraphy_logo(94, 34, rast, with_blood_slash=True)
        self.rank_emblems = bake_stylish_rank_emblems(rast)
        self.orb_ring = generate_arcane_sigil_surface(68, (236, 224, 248), (255, 68, 138))
        self.orb_ring_p2 = generate_arcane_sigil_surface(68, (236, 224, 248), (196, 82, 255))

    def _draw_ornate_portrait_box(
        self, dest: pygame.Surface, x: int, y: int, pal_key: str, facing_right: bool, is_eclipse: bool
    ) -> None:
        w, h = 76, 64
        rect = pygame.Rect(x, y, w, h)
        port = self.bank.get_hud_portrait(pal_key, facing_right=facing_right)
        dest.blit(port, (x, y))
        pal = PALETTES.get(pal_key, PALETTES["CRIMSON_ORIGINAL"])
        if is_eclipse:
            pygame.draw.rect(dest, (255, 212, 76), rect.inflate(4, 4), 2)
        # Ornate silver-filigree Gothic diamond/winged border matching mockup.jpg
        pygame.draw.rect(dest, (16, 6, 18), rect.inflate(4, 4), 3)
        pygame.draw.rect(dest, (226, 218, 238), rect, 2)
        pygame.draw.rect(dest, pal.hud_gem, rect.inflate(-4, -4), 1)
        # Corner Gothic spire accents
        for cx, cy in ((x, y), (x + w, y), (x, y + h), (x + w, y + h)):
            draw_gothic_diamond_gem(dest, cx, cy, 4, pal.hud_gem, lit=True)

    def _draw_curse_medallion(
        self,
        dest: pygame.Surface,
        cx: int,
        cy: int,
        fighter: Fighter,
        rot_deg: float,
        is_p1: bool,
    ) -> None:
        pal = PALETTES.get(fighter.palette_key, PALETTES["CRIMSON_ORIGINAL"])
        ratio = clamp(fighter.curse / float(MAX_CURSE), 0.0, 1.0)
        eclipse = fighter.is_eclipse

        # Rotating subtle silver arcane filigree outer ring
        base_ring = self.orb_ring if is_p1 else self.orb_ring_p2
        rot_surf = pygame.transform.rotate(base_ring, rot_deg if is_p1 else -rot_deg)
        rr = rot_surf.get_rect(center=(cx, cy))
        dest.blit(rot_surf, rr.topleft)

        # Dark obsidian metallic orb socket
        r = 25
        pygame.draw.circle(dest, (18, 8, 22), (cx, cy), r + 3)
        pygame.draw.circle(dest, (34, 12, 34), (cx, cy), r)

        # Glowing jewel fill rising smoothly with Curse Resonance
        gem_col = (255, 206, 62) if eclipse else pal.hud_gem
        if ratio > 0.02:
            fill_r = max(4, int(r * (0.35 + 0.65 * ratio)))
            pygame.draw.circle(dest, scale_rgb(gem_col, 0.55), (cx, cy), r - 2)
            pygame.draw.circle(dest, gem_col, (cx, cy), fill_r)
            self.rast.paint_radial_bloom(dest, cx, cy, r * 1.45, gem_col, alpha=int(120 * ratio + 30), additive=True)
            # Specular crystal crescent inside jewel
            pygame.draw.circle(dest, (255, 242, 248), (cx - 7, cy - 8), 5)

        # Metallic silver gothic bezel + 4 cardinal thorn spikes
        pygame.draw.circle(dest, (232, 224, 244), (cx, cy), r + 1, 2)
        for dx, dy in ((0, -1), (0, 1), (-1, 0), (1, 0)):
            tip = (cx + dx * (r + 9), cy + dy * (r + 9))
            side_a = (cx + dx * (r - 1) - dy * 4, cy + dy * (r - 1) + dx * 4)
            side_b = (cx + dx * (r - 1) + dy * 4, cy + dy * (r - 1) - dx * 4)
            pygame.draw.polygon(dest, (226, 218, 238), [tip, side_a, side_b])

        pct_str = "ECL" if eclipse else f"{int(ratio * 100)}"
        self.fonts.draw_text(dest, pct_str, cx, cy - 7, size=12, color=(255, 248, 244), style="mono", bold=True, align="center")

    def render(
        self,
        dest: pygame.Surface,
        p1: Fighter,
        p2: Fighter,
        timer_sec: int,
        mode_label: str,
        stage_label: str,
        rounds_to_win: int,
        time_sec: float,
        beat_pulse: float,
        banner_text: str = "",
        banner_sub: str = "",
        banner_alpha: float = 0.0,
    ) -> None:
        p1_pal = PALETTES.get(p1.palette_key, PALETTES["CRIMSON_ORIGINAL"])
        p2_pal = PALETTES.get(p2.palette_key, PALETTES["MOONLIT_MIRABELLE"])

        # Top subtle dark gradient vignette so HUD typography pops at 100% readability
        top_v = pygame.Surface((INTERNAL_W, 86), pygame.SRCALPHA)
        for y in range(86):
            pygame.draw.line(top_v, (10, 4, 14, int(175 * (1.0 - y / 86.0))), (0, y), (INTERNAL_W, y))
        dest.blit(top_v, (0, 0))

        # Top-left calligraphy 「呪いの刃」 emblem + P1 Portrait + Symmetric P2 Portrait
        dest.blit(self.mini_logo, (4, 6))
        self._draw_ornate_portrait_box(dest, 100, 10, p1.palette_key, facing_right=True, is_eclipse=p1.is_eclipse)
        self._draw_ornate_portrait_box(dest, INTERNAL_W - 86, 10, p2.palette_key, facing_right=False, is_eclipse=p2.is_eclipse)

        # Symmetrical high-visibility angled metallic HP bars (both 186px wide, draining toward center!)
        p1_bar = pygame.Rect(182, 34, 184, 17)
        p2_bar = pygame.Rect(434, 34, 274, 17)
        # Keep exact visual symmetry between P1 & P2 portraits by spanning cleanly to each portrait edge
        p1_ratio = clamp(p1.hp / float(MAX_HP), 0.0, 1.0)
        p1_ghost = clamp(p1.ghost_hp / float(MAX_HP), 0.0, 1.0)
        p2_ratio = clamp(p2.hp / float(MAX_HP), 0.0, 1.0)
        p2_ghost = clamp(p2.ghost_hp / float(MAX_HP), 0.0, 1.0)

        draw_metallic_gauge_bar(dest, p1_bar, p1_ratio, p1_ghost, p1_pal.hud_bar_hi, p1_pal.hud_bar_lo, flip_right=True, skew=9)
        draw_metallic_gauge_bar(dest, p2_bar, p2_ratio, p2_ghost, p2_pal.hud_bar_hi, p2_pal.hud_bar_lo, flip_right=False, skew=9)

        # Thin Poise / Guard Integrity Bars directly beneath each HP bar (Soulcalibur/Dark Souls mechanic!)
        p1_poise_r = clamp(p1.poise / float(MAX_POISE), 0.0, 1.0)
        p2_poise_r = clamp(p2.poise / float(MAX_POISE), 0.0, 1.0)
        draw_metallic_gauge_bar(
            dest, pygame.Rect(186, 54, 176, 5), p1_poise_r, p1_poise_r,
            (182, 226, 255) if p1_poise_r > 0.3 else (255, 76, 86), (62, 118, 178), flip_right=True, skew=4, border_color=(148, 140, 168),
        )
        draw_metallic_gauge_bar(
            dest, pygame.Rect(438, 54, 266, 5), p2_poise_r, p2_poise_r,
            (182, 226, 255) if p2_poise_r > 0.3 else (255, 76, 86), (62, 118, 178), flip_right=False, skew=4, border_color=(148, 140, 168),
        )

        # Character Names, Gothic Crosses (+), Mode & Stage Tags (zero overlap!)
        self.fonts.draw_text(dest, f"+ {p1.name}", 186, 11, size=13, color=(252, 242, 248), style="serif", bold=True)
        self.fonts.draw_text(dest, p1.epithet[:28], 186, 24, size=9, color=(212, 174, 192), style="sans")
        p2_short = p2.name[:18]
        self.fonts.draw_text(dest, f"{p2_short} +", INTERNAL_W - 94, 11, size=13, color=(252, 242, 248), style="serif", bold=True, align="right")
        self.fonts.draw_text(dest, p2.epithet[:28], INTERNAL_W - 94, 24, size=9, color=(212, 174, 192), style="sans", align="right")

        self.fonts.draw_text(dest, stage_label, 362, 2, size=9, color=(218, 184, 198), style="mono", bold=True, align="right")
        self.fonts.draw_text(dest, mode_label, 438, 2, size=9, color=(218, 184, 198), style="mono", bold=True, align="left")

        # Glowing Round-Win Gothic Diamond Gems directly below Poise bars!
        for ri in range(rounds_to_win):
            draw_gothic_diamond_gem(dest, 194 + ri * 18, 68, 6, p1_pal.hud_gem, lit=(ri < p1.rounds_won))
            draw_gothic_diamond_gem(dest, INTERNAL_W - 98 - ri * 18, 68, 6, p2_pal.hud_gem, lit=(ri < p2.rounds_won))

        # --- TOP-CENTER ORNATE GOTHIC CREST TIMER MEDALLION ---
        tcx, tcy = INTERNAL_W // 2, 36
        crest_pts = [
            (tcx, tcy - 30), (tcx + 30, tcy - 14), (tcx + 34, tcy + 4),
            (tcx + 18, tcy + 26), (tcx, tcy + 34), (tcx - 18, tcy + 26),
            (tcx - 34, tcy + 4), (tcx - 30, tcy - 14),
        ]
        pygame.draw.polygon(dest, (20, 6, 22), crest_pts)
        pygame.draw.polygon(dest, (164, 20, 56), [(tcx, tcy - 24), (tcx + 24, tcy - 10), (tcx + 26, tcy + 4), (tcx, tcy + 26), (tcx - 26, tcy + 4), (tcx - 24, tcy - 10)], 2)
        pygame.draw.polygon(dest, (232, 224, 244), crest_pts, 2)
        t_col = (255, 86, 98) if timer_sec <= 15 else (255, 244, 248)
        t_str = "INF" if timer_sec < 0 else f"{timer_sec:02d}"
        self.fonts.draw_text(dest, t_str, tcx, tcy - 15, size=26, color=t_col, style="serif", bold=True, align="center")

        # --- MID-LEFT / MID-RIGHT DMC4 / BAYONETTA STYLISH RANK & COMBO COUNTER! ---
        for idx, (atk, dfn, rx, align) in enumerate(((p1, p2, 16, "left"), (p2, p1, INTERNAL_W - 174, "right"))):
            show_style = (atk.stylish.rank != StyleRank.NONE or dfn.combo_count >= 2)
            if not show_style:
                continue
            rank = atk.stylish.rank
            if rank != StyleRank.NONE and rank in self.rank_emblems:
                emb = self.rank_emblems[rank]
                # Pop scale pulse on fresh rank-up!
                if atk.stylish.rank_flash_timer > 0.0:
                    sc = 1.0 + atk.stylish.rank_flash_timer * 0.35
                    ew, eh = int(emb.get_width() * sc), int(emb.get_height() * sc)
                    emb_s = pygame.transform.scale(emb, (ew, eh))
                    dest.blit(emb_s, (rx - (ew - emb.get_width()) // 2, 92 - (eh - emb.get_height()) // 2))
                else:
                    dest.blit(emb, (rx, 92))
                tx = rx + (14 if align == "left" else 142)
                self.fonts.draw_text(dest, rank.label, tx, 152, size=14, color=rank.color, style="serif", bold=True, italic=True, align=align)

            if dfn.combo_count >= 2:
                tx = rx + (14 if align == "left" else 142)
                self.fonts.draw_text(dest, f"{dfn.combo_count} Hits", tx, 172, size=22, color=(255, 242, 246), style="serif", bold=True, italic=True, align=align)
                self.fonts.draw_text(dest, f"Damage  {dfn.combo_damage}", tx, 198, size=12, color=(232, 206, 222), style="mono", bold=True, align=align)
                self.fonts.draw_text(dest, f"Style Bonus  +{atk.stylish.style_bonus_total}", tx, 214, size=11, color=(255, 204, 134), style="mono", align=align)

        # --- BOTTOM-CORNER CURSE RESONANCE JEWEL MEDALLIONS & SEGMENTED SUPER BARS ---
        rot = time_sec * 42.0
        self._draw_curse_medallion(dest, 40, INTERNAL_H - 42, p1, rot, is_p1=True)
        self._draw_curse_medallion(dest, INTERNAL_W - 40, INTERNAL_H - 42, p2, rot, is_p1=False)

        c1_r = clamp(p1.curse / float(MAX_CURSE), 0.0, 1.0)
        c2_r = clamp(p2.curse / float(MAX_CURSE), 0.0, 1.0)
        c1_hi = (255, 224, 96) if p1.is_eclipse else (255, 92, 186)
        c1_lo = (204, 118, 22) if p1.is_eclipse else (138, 26, 168)
        c2_hi = (255, 224, 96) if p2.is_eclipse else (216, 118, 255)
        c2_lo = (204, 118, 22) if p2.is_eclipse else (106, 26, 178)

        draw_metallic_gauge_bar(dest, pygame.Rect(74, INTERNAL_H - 40, 178, 12), c1_r, c1_r, c1_hi, c1_lo, flip_right=False, skew=8, segments=2)
        draw_metallic_gauge_bar(dest, pygame.Rect(INTERNAL_W - 252, INTERNAL_H - 40, 178, 12), c2_r, c2_r, c2_hi, c2_lo, flip_right=True, skew=8, segments=2)

        # Ready badges over Curse meters
        if p1.is_eclipse:
            self.fonts.draw_text(dest, "ECLIPSE OVERDRIVE", 78, INTERNAL_H - 56, size=11, color=(255, 224, 96), style="sans", bold=True)
        elif p1.curse >= 500:
            self.fonts.draw_text(dest, "SUPER / ECLIPSE READY", 78, INTERNAL_H - 56, size=10, color=(255, 168, 214), style="sans", bold=True)

        if p2.is_eclipse:
            self.fonts.draw_text(dest, "ECLIPSE OVERDRIVE", INTERNAL_W - 78, INTERNAL_H - 56, size=11, color=(255, 224, 96), style="sans", bold=True, align="right")
        elif p2.curse >= 500:
            self.fonts.draw_text(dest, "SUPER / ECLIPSE READY", INTERNAL_W - 78, INTERNAL_H - 56, size=10, color=(216, 168, 255), style="sans", bold=True, align="right")

        # Sleek Bottom-Center Control Hints Bar (faithful to mockup.jpg!)
        hint_bar = pygame.Surface((286, 20), pygame.SRCALPHA)
        hint_bar.fill((12, 4, 16, 168))
        pygame.draw.rect(hint_bar, (124, 86, 118, 180), (0, 0, 286, 20), 1)
        dest.blit(hint_bar, (INTERNAL_W // 2 - 143, INTERNAL_H - 24))
        self.fonts.draw_text(
            dest, "[U/I/O] Slash   [P] Parry/Sp   [Space] Eclipse   [Esc] Pause",
            INTERNAL_W // 2, INTERNAL_H - 20, size=10, color=(228, 212, 226), style="sans", align="center", shadow=False, outline_color=None,
        )

        # --- CENTER CINEMATIC ROUND / FIGHT / KO BANNER ---
        if banner_text and banner_alpha > 0.02:
            al = clamp_int(int(240 * banner_alpha), 0, 255)
            band = pygame.Surface((INTERNAL_W, 88), pygame.SRCALPHA)
            band.fill((14, 4, 18, int(al * 0.78)))
            pygame.draw.line(band, (255, 56, 112, al), (0, 2), (INTERNAL_W, 2), 2)
            pygame.draw.line(band, (255, 56, 112, al), (0, 85), (INTERNAL_W, 85), 2)
            dest.blit(band, (0, 238))
            self.fonts.draw_text(dest, banner_text, INTERNAL_W // 2, 248, size=38, color=(255, 236, 188), style="serif", bold=True, italic=True, align="center")
            if banner_sub:
                self.fonts.draw_text(dest, banner_sub, INTERNAL_W // 2, 294, size=15, color=(255, 116, 158), style="sans", bold=True, align="center")


