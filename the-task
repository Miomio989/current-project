        # Full-Width BlazBlue/Persona Anime Super Art Cut-In Banner!
        if self.cutin is not None:
            ci = self.cutin
            u = 1.0 - (ci.timer / float(max(1, ci.max_timer)))
            slide_in = ease_out_expo(min(1.0, u * 4.5))
            slide_out = 1.0 - ease_in_cubic(max(0.0, (u - 0.78) / 0.22))
            vis = min(slide_in, slide_out)
            banner = self.bank.get_super_cutin(ci.palette_key, facing_right=(ci.player_id == 0), eclipse_mode=ci.eclipse_mode)
            by = int(186 + (1.0 - vis) * 44)
            bx = int((1.0 - slide_in) * (-260 if ci.player_id == 0 else 260))
            banner_draw = banner.copy()
            banner_draw.set_alpha(clamp_int(int(255 * vis), 0, 255))
            dest.blit(banner_draw, (bx, by))
            # Dramatic move title & Japanese art calligraphy text on right/left of banner
            tx = 592 if ci.player_id == 0 else 208
            fonts.draw_text(dest, ci.move_title.upper(), tx, by + 68, size=19, color=(255, 238, 178), style="serif", bold=True, italic=True, align="center")
            fonts.draw_text(dest, ci.move_jp, tx, by + 102, size=14, color=(255, 134, 178), style="mono", bold=True, align="center")

        # Tactical Callouts (COUNTER!, LETHAL HIT!, JUST PARRY!, BLADE CLASH!, GUARD CRUSH!)
        for idx, c in enumerate(self.callouts):
            u = c.life / max(0.01, c.max_life)
            cy = 186 + idx * 36
            cx = 128 if c.player_id == 0 else (672 if c.player_id == 1 else 400)
            align = "left" if c.player_id == 0 else ("right" if c.player_id == 1 else "center")
            fonts.draw_text(dest, c.text, cx, cy, size=22, color=c.color, style="serif", bold=True, italic=True, align=align)
            if c.subtext:
                fonts.draw_text(dest, c.subtext, cx, cy + 22, size=13, color=(244, 226, 236), style="sans", bold=True, align=align)


