    def copy_image(self) -> None:
        """Copy the image pixels themselves to the clipboard."""
        p = self._current_path()
        if not p or not os.path.exists(p):
            self.main._flash_summary("Select an image first.")
            return
        img = QImage(p)
        if img.isNull():
            self.main._flash_summary("Cannot decode that image.")
            return
        QApplication.clipboard().setImage(img)
        self.main._flash_summary(f"Copied {os.path.basename(p)} to the clipboard")

    def copy_path(self) -> None:
        sel = [it.data(self.ROLE_PATH) for it in self.list.selectedItems()]
        sel = [p for p in sel if p]
        if not sel:
            self.main._flash_summary("Select an image first.")
            return
        QApplication.clipboard().setText("\n".join(sel))
        self.main._flash_summary("Path copied" if len(sel) == 1 else f"{len(sel)} paths copied")

