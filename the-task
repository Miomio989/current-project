class ComboTrialTracker:
    def __init__(self) -> None:
        self.trial_idx: int = 0
        self.step_progress: int = 0
        self.completed_trials: Set[int] = set()
        self.clear_flash: float = 0.0

    @property
    def current(self) -> ComboTrial:
        return COMBO_TRIALS[self.trial_idx % len(COMBO_TRIALS)]

    def cycle_trial(self, delta: int = 1) -> None:
        self.trial_idx = (self.trial_idx + delta) % len(COMBO_TRIALS)
        self.step_progress = 0
        self.clear_flash = 0.0

    def on_move_hit(self, player_id: int, state: FighterState) -> bool:
        if player_id != 0:
            return False
        tr = self.current
        expected = tr.steps[self.step_progress]
        if state == expected:
            self.step_progress += 1
            if self.step_progress >= len(tr.steps):
                self.completed_trials.add(tr.index)
                self.clear_flash = 2.4
                self.step_progress = 0
                return True
        elif state == tr.steps[0]:
            self.step_progress = 1
        return False

    def reset_on_drop(self) -> None:
        self.step_progress = 0


class TrainingLabOverlay:
    """Professional fighting-game Training Mode diagnostics & interactive trial HUD."""

    def __init__(self, fonts: FontManager, tcfg: TrainingSettings) -> None:
        self.fonts = fonts
        self.tcfg = tcfg
        self.trials = ComboTrialTracker()

    def render_world_boxes(self, dest: pygame.Surface, p1: Fighter, p2: Fighter, cam: CameraDirector) -> None:
        if not self.tcfg.show_hitboxes:
            return
        for f in (p1, p2):
            # Pushbox (Amber Gold)
            pb = f.get_pushbox_world()
            sx, sy = cam.world_to_screen(pb[0], pb[1])
            pygame.draw.rect(dest, (242, 198, 72), pygame.Rect(int(sx), int(sy), int(pb[2]), int(pb[3])), 1)

            # Hurtboxes (Translucent Cyan)
            for hb in f.get_hurtboxes():
                wb = hb.to_world(f.x, f.y, f.facing_right)
                hsx, hsy = cam.world_to_screen(wb[0], wb[1])
                box_s = pygame.Surface((int(wb[2]), int(wb[3])), pygame.SRCALPHA)
                box_s.fill((42, 196, 255, 42))
                dest.blit(box_s, (int(hsx), int(hsy)))
                pygame.draw.rect(dest, (64, 218, 255), pygame.Rect(int(hsx), int(hsy), int(wb[2]), int(wb[3])), 1)

            # Active Attack Hitboxes (Vibrant Crimson!)
            hw = f.get_active_hit_window()
            if hw is not None:
                for ab in hw.boxes:
                    wb = ab.to_world(f.x, f.y, f.facing_right)
                    asx, asy = cam.world_to_screen(wb[0], wb[1])
                    ab_s = pygame.Surface((int(wb[2]), int(wb[3])), pygame.SRCALPHA)
                    ab_s.fill((255, 36, 86, 92))
                    dest.blit(ab_s, (int(asx), int(asy)))
                    pygame.draw.rect(dest, (255, 76, 118), pygame.Rect(int(asx), int(asy), int(wb[2]), int(wb[3])), 2)

    def render_hud_panels(self, dest: pygame.Surface, p1: Fighter, p2: Fighter, dt: float) -> None:
        if self.trials.clear_flash > 0.0:
            self.trials.clear_flash = max(0.0, self.trials.clear_flash - dt)

        # 1. Left Scrolling Arcade Input History Tape
        if self.tcfg.show_input_tape:
            tape_rect = pygame.Rect(8, 232, 92, 246)
            draw_gothic_filigree_panel(dest, tape_rect, bg_alpha=178, ornate_corners=False)
            self.fonts.draw_text(dest, "INPUT TAPE", 54, 237, size=10, color=(255, 168, 198), style="mono", bold=True, align="center")
            dir_arrows = {1: "DL", 2: "D", 3: "DR", 4: "L", 5: "N", 6: "R", 7: "UL", 8: "U", 9: "UR"}
            entries = list(p1.input_buf.tape)[-12:]
            for idx, (num, btn, cnt) in enumerate(reversed(entries)):
                ey = 254 + idx * 18
                tags = []
                if btn & InputButton.LIGHT:
                    tags.append("L")
                if btn & InputButton.MEDIUM:
                    tags.append("M")
                if btn & InputButton.HEAVY:
                    tags.append("H")
                if btn & InputButton.SPECIAL:
                    tags.append("S")
                if btn & InputButton.ECLIPSE:
                    tags.append("EC")
                btn_str = "+".join(tags) if tags else "-"
                self.fonts.draw_text(
                    dest, f"{dir_arrows.get(num, 'N'):2s} {btn_str:5s} {cnt:2d}",
                    14, ey, size=11, color=(236, 224, 240), style="mono", shadow=False, outline_color=None,
                )

        # 2. Bottom Frame-Data Live Timeline Bar (Startup / Active / Recovery!)
        if self.tcfg.show_frame_data:
            fd_rect = pygame.Rect(112, 488, 576, 54)
            draw_gothic_filigree_panel(dest, fd_rect, bg_alpha=192, ornate_corners=False)
            spec = p1.move_reg.get(p1.state)
            if spec is not None:
                info = (
                    f"MOVE: {spec.display_name} ({spec.command_notation}) | "
                    f"START:{spec.startup}f  ACT:{spec.active}f  REC:{spec.recovery}f  "
                    f"ON-HIT:{spec.on_hit_adv_label}  ON-BLK:{spec.on_block_adv_label}"
                )
            else:
                info = f"STATE: {p1.state.value} (f.{p1.state_frame}) | DUMMY: {self.tcfg.dummy_mode.value} [F1-F5: Lab Shortcuts]"
            self.fonts.draw_text(dest, info, 122, 494, size=11, color=(248, 232, 240), style="mono", bold=True, shadow=False, outline_color=None)

            # Visual color-coded 48-frame meter strip
            strip_x, strip_y = 122, 514
            cell_w = 11
            for fi in range(48):
                col = (34, 22, 40)
                if spec is not None and fi < spec.total_frames:
                    if fi < spec.startup:
                        col = (58, 146, 236)   # Startup: Ice Blue
                    elif fi < spec.startup + spec.active:
                        col = (242, 42, 88)    # Active: Crimson
                    else:
                        col = (68, 198, 126)   # Recovery: Emerald
                r = pygame.Rect(strip_x + fi * cell_w, strip_y, cell_w - 2, 16)
                pygame.draw.rect(dest, col, r)
                if spec is not None and fi == p1.state_frame:
                    pygame.draw.rect(dest, (255, 248, 168), r, 2)

        # 3. Top-Center/Right Interactive Combo Trial Card!
        tr = self.trials.current
        tr_rect = pygame.Rect(INTERNAL_W - 284, 84, 276, 86)
        draw_gothic_filigree_panel(dest, tr_rect, bg_alpha=196, ornate_corners=False)
        done_tag = " [CLEAR!]" if tr.index in self.trials.completed_trials else ""
        self.fonts.draw_text(dest, f"{tr.title}{done_tag}", tr_rect.x + 10, tr_rect.y + 7, size=11, color=(255, 214, 108), style="sans", bold=True)
        hint_cut = tr.hint if len(tr.hint) <= 44 else (tr.hint[:41] + "...")
        self.fonts.draw_text(dest, hint_cut, tr_rect.x + 10, tr_rect.y + 23, size=9, color=(216, 196, 212), style="sans")

        sx = tr_rect.x + 10
        for idx, lbl in enumerate(tr.step_labels):
            lit = idx < self.trials.step_progress or self.trials.clear_flash > 0.0
            bg_c = (198, 28, 76) if lit else (42, 22, 48)
            pill = pygame.Rect(sx, tr_rect.y + 42, max(38, len(lbl) * 7 + 10), 22)
            pygame.draw.rect(dest, bg_c, pill, border_radius=3)
            pygame.draw.rect(dest, (242, 228, 240) if lit else (126, 98, 134), pill, 1, border_radius=3)
            self.fonts.draw_text(dest, lbl, pill.centerx, pill.y + 4, size=10, color=(255, 248, 250), style="mono", bold=True, align="center", shadow=False, outline_color=None)
            sx += pill.w + 5
