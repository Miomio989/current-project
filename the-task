    def _on_aspect_tile_changed(self, _key: str = "") -> None:
        if self.aspect_custom_btn.isChecked():
            self.aspect_custom_btn.blockSignals(True)
            self.aspect_custom_btn.setChecked(False)
            self.aspect_custom_btn.blockSignals(False)
        if self.custom_size_check.isChecked():
            self.custom_size_check.setChecked(False)
        self.custom_size_row.setVisible(False)
        self._on_size_changed()

    def _on_aspect_custom_toggled(self, on: bool) -> None:
        if on:
            if not self.custom_size_check.isChecked():
                self.custom_size_check.setChecked(True)
        else:
            if self.custom_size_check.isChecked():
                self.custom_size_check.setChecked(False)
            if not self.aspect.current():
                return
        self.custom_size_row.setVisible(on)
        if on:
            self._sync_custom_spins(True)
        self._on_size_changed()

    def _snap_custom_spin(self, sp: QSpinBox) -> None:
        """Round the typed value to the NEAREST multiple of 64 (up or down,
        whichever is closer) - the AI Horde dimension requirement."""
        snapped = snap64_nearest(sp.value())
        if snapped != sp.value():
            sp.setValue(snapped)
        self._on_size_changed()

    def _sync_custom_spins(self, from_w: bool) -> None:
        """Mirror the Prompt-tab CUSTOM row with the Horde-tab W/H spins."""
        src_sp, dst_sp = (self.cw_spin, self.w_spin) if from_w else (self.ch_spin, self.h_spin)
        if src_sp.value() != dst_sp.value():
            dst_sp.setValue(src_sp.value())
        if self.custom_size_row.isVisible() or self.aspect_custom_btn.isChecked():
            self.custom_size_row.setVisible(True)
        self._on_size_changed()

    # ------------------------------------------------------------------ img2img mask plumbing
    def _set_img2img_mask(self, path: Optional[str]) -> None:
        if path and not os.path.isfile(path):
            path = None
        self.img2img_mask = path
        self.i2i_clear_mask_btn.setVisible(bool(path))
        self._update_i2i_caption()
        self._update_generate_subtext()

    def _clear_img2img_mask(self) -> None:
        self._set_img2img_mask(None)
        self._i2i_edit_mode = False

    def _update_i2i_caption(self) -> None:
        if not self.img2img_source:
            self.i2i_caption.setText("No source set - GENERATE runs pure text-to-image.")
            return
        img = QImage(self.img2img_source)
        dim = f"{img.width()}\u00d7{img.height()}" if not img.isNull() else "?"
        if self.img2img_mask:
            mode = "SIDE-BY-SIDE EDIT (right half repainted)" if self._i2i_edit_mode else "INPAINTING (white mask area repainted)"
            self.i2i_caption.setText(
                f"Source: {os.path.basename(self.img2img_source)} ({dim}) - {mode}."
            )
        else:
            self.i2i_caption.setText(
                f"Source: {os.path.basename(self.img2img_source)} ({dim}) - GENERATE now runs img2img."
            )

    def edit_via_side_by_side(self, path: Optional[str]) -> None:
        """The img2img EDIT workaround: double the image into a left / right
        composition, mask the right half for inpainting and set a request size
        that keeps the 2:1 aspect under the 1 MP budget."""
        if not path or not os.path.isfile(path):
            return
        img = QImage(path)
        if img.isNull():
            self._flash_summary("Cannot decode the image for the EDIT request.")
            return
        canvas, mask, out_w, out_h = build_side_by_side_edit(img)
        ensure_dirs()
        stamp = time.strftime("%Y%m%d_%H%M%S")
        comp_path = os.path.join(SCRATCH_DIR, f"sbys_{stamp}.png")
        mask_path = os.path.join(SCRATCH_DIR, f"sbys_{stamp}_mask.png")
        if not canvas.save(comp_path, "PNG"):
            self._flash_summary("Could not write the EDIT composition.")
            return
        with open(mask_path, "wb") as fh:
            fh.write(mask_to_inpaint_png(mask, out_w, out_h))
        self._set_img2img_source(comp_path)
        self._set_img2img_mask(mask_path)
        self._i2i_edit_mode = True
        self.custom_size_check.setChecked(True)
        self.w_spin.setValue(out_w)
        self.h_spin.setValue(out_h)
        self.tabs.setCurrentIndex(TAB_PROMPT)
        self.i2i_section.set_expanded(True)
        self._flash_summary(
            f"EDIT request armed: {out_w}\u00d7{out_h} (2:1, \u22641 MP) - describe the FULL edited picture; "
            "the left half stays locked."
        )
        STUDIO_LOG.info(
            "SYS", f"Side-by-side EDIT: source {img.width()}x{img.height()} -> {out_w}x{out_h} inpaint"
        )

