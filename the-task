            sub = math.sin(t * 420.0 * math.exp(-t * 8.0)) * math.exp(-t * 6.0)
            out[i] = _fast_tanh((glass * 0.9 + sub * 1.1) * 1.8) * 0.88
        return self._to_stereo_sound(out, gain=0.88)

    def _sfx_parry_trigger(self) -> Optional[pygame.mixer.Sound]:
