    def _sfx_metal_ring(
        self, dur: float, f1: float, f2: float, grit: float = 0.4, chime: bool = False
    ) -> Optional[pygame.mixer.Sound]:
        n = int(self.sr * dur)
        out = [0.0] * n
        inv_sr = 1.0 / float(self.sr)
        for i in range(n):
            t = i * inv_sr
            ring = (
                math.sin(t * f1 * _TWO_PI) * 0.55
                + math.sin(t * f2 * _TWO_PI) * 0.42
                + math.sin(t * (f1 * 1.498) * _TWO_PI) * (0.38 if chime else 0.20)
            ) * math.exp(-t * (6.5 if chime else 13.0))
            clash = self._noise_lut[(i * 5) & self._noise_mask] * math.exp(-t * 42.0) * grit
            out[i] = _fast_tanh((ring + clash) * 1.7) * 0.84
        return self._to_stereo_sound(out, gain=0.84)

