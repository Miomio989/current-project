    def _update_summary(self) -> None:
        c = self.queue.counts()
        eta = self.queue.eta()
        if self.queue.paused:
            text = "QUEUE  paused"
        elif c["active"] or c["queued"]:
            bits = []
            if c["active"]:
                bits.append(f"{c['active']} active")
            if c["queued"]:
                bits.append(f"{c['queued']} waiting")
            if c["upscales"]:
                bits.append(f"{c['upscales']} upscale")
            if eta is not None:
                bits.append(f"ETA {fmt_secs(eta)}")
            text = "QUEUE  " + " \u2022 ".join(bits)
        else:
            text = "QUEUE  idle"
            if c["done"] or c["failed"]:
                text += f"  ({c['done']} done, {c['failed']} failed)"
        self.summary_label.setText(text)
        self.gen_btn.set_in_flight(c["active"])
        self.queue_progress.setValue(int(self.queue.overall_progress() * 100))
        self.queue_progress.setVisible(bool(c["active"] or c["queued"]))

    def _flash_summary(self, text: str) -> None:
        self.summary_label.setText(text)
        QTimer.singleShot(2600, self._update_summary)

    # ---- In-memory diagnostic console ----
    def _log_matches_filters(self, rec: LogRecord) -> bool:
        ch = self.log_filter_combo.currentText()
        if ch != "ALL" and rec.channel != ch:
            return False
        lv = self.log_level_combo.currentText()
        if lv != "ALL" and rec.level != lv:
            return False
        q = self.log_search_edit.text().strip().lower()
        if q and q not in rec.message.lower():
            return False
        return True

    def _on_log_record(self, rec: LogRecord) -> None:
        try:
            if not self._log_matches_filters(rec):
                return
            level_colors = {
                "OK": C["ok"], "ERROR": C["err"], "WARN": C["warn"],
                "NET": C["info"], "INFO": C["muted"],
            }
            self.log_edit.appendHtml(rec.format_html(level_colors, C["dim"]))
            if self.log_autoscroll_btn.isChecked():
                sb = self.log_edit.verticalScrollBar()
                sb.setValue(sb.maximum())
        except RuntimeError:
            pass  # widgets already destroyed during interpreter shutdown

    def _refresh_log_console(self) -> None:
        level_colors = {
            "OK": C["ok"], "ERROR": C["err"], "WARN": C["warn"],
            "NET": C["info"], "INFO": C["muted"],
        }
        records = STUDIO_LOG.records(
            self.log_filter_combo.currentText(),
            self.log_level_combo.currentText(),
        )
        q = self.log_search_edit.text().strip().lower()
        parts: List[str] = []
        for rec in records[-800:]:
            if q and q not in rec.message.lower():
                continue
            parts.append(rec.format_html(level_colors, C["dim"]))
        self.log_edit.clear()
        if parts:
            self.log_edit.appendHtml("<br>".join(parts))
            sb = self.log_edit.verticalScrollBar()
            sb.setValue(sb.maximum())

    def _clear_logs(self) -> None:
        STUDIO_LOG.clear()
        self.log_edit.clear()

    # ------------------------------------------------------------------ Results, Toasts & Aesthetics
    def on_image_ready(self, path: str, meta: Dict[str, Any]) -> None:
        # Depth-map attachments: show + refresh badges; no aesthetic scoring
        if meta.get("depth_job"):
            self.show_image(path)
            self.gallery_tab.mark_dirty()
            self.gallery.refresh(self.store.list_recent())
            self._update_summary()
            self.toast.notify(
                f"Depth map ready \u2014 {os.path.basename(path)}",
                "ok",
                payload=path,
                on_click=lambda p: self._open_from_gallery_tab(p),
            )
            SOUNDS.play("done")
            return
        self.show_image(path)
        self.gallery_tab.mark_dirty()
        self.gallery.refresh(self.store.list_recent())
        self._update_summary()
        if self.aesthetic_check.isChecked() and not meta.get("tile_job"):
            self._queue_aesthetic(path)
        if meta.get("tile_job"):
            return
        # Side-by-side EDIT results: auto-extract the useful right half
        if meta.get("edit_side_by_side"):
            split_note = ""
            img = QImage(path)
            if not img.isNull() and img.width() >= 128 and img.height() >= 64:
                right = img.copy(img.width() // 2, 0, img.width() - img.width() // 2, img.height())
                rmeta = dict(meta)
                rmeta.update({
                    "width": right.width(),
                    "height": right.height(),
                    "edit_split_crop": True,
                })
                rmeta.pop("edit_side_by_side", None)
                rdata = image_to_png_bytes(right)
                try:
                    if self.queue.save_direct:
                        rpath = self.store.save_direct(rdata, rmeta)
                    else:
                        rpath = self.store.save_temp(rdata, rmeta)
                    self.show_image(rpath)
                    self.gallery.refresh(self.store.list_recent())
                    split_note = " \u2014 right half extracted"
                    STUDIO_LOG.ok("SYS", f"EDIT result split: {os.path.basename(rpath)}")
                except Exception as exc:  # noqa: BLE001
                    STUDIO_LOG.warn("SYS", f"EDIT result split failed: {exc}")
            self.toast.notify(
                f"EDIT render ready{split_note} \u2014 {os.path.basename(path)}",
                "ok",
                payload=path,
                on_click=lambda p: self._open_from_gallery_tab(p),
            )
            SOUNDS.play("done")
            return
        self.toast.notify(
            f"Render ready \u2014 {os.path.basename(path)}",
            "ok",
            payload=path,
            on_click=lambda p: self._open_from_gallery_tab(p),
        )
        SOUNDS.play("done")

    def _queue_aesthetic(self, path: str) -> None:
        if path not in self._aesthetic_pending and not any(w.path == path for w in self._aesthetic_workers):
            self._aesthetic_pending.append(path)
        self._pump_aesthetics()

    def _pump_aesthetics(self) -> None:
        while self._aesthetic_pending and len(self._aesthetic_workers) < 2:
            path = self._aesthetic_pending.pop(0)
            w = AestheticWorker(self.api, path, self)
            w.scored.connect(self._on_aesthetic_scored)
            w.finished.connect(lambda t=w: self._aesthetic_done(t))
            self._aesthetic_workers.append(w)
            w.start()

    def _aesthetic_done(self, w: AestheticWorker) -> None:
        if w in self._aesthetic_workers:
            self._aesthetic_workers.remove(w)
        w.deleteLater()
        self._pump_aesthetics()

    def _on_aesthetic_scored(self, path: str, score: float) -> None:
        meta = update_image_metadata(path, {"aesthetic": round(float(score), 2)})
        if self.viewer.path == path:
            self.viewer.set_image(path)
            self._sync_caption()
        self.gallery_tab.on_meta_changed(path)
        STUDIO_LOG.ok("HORDE", f"Aesthetic {score:.2f} — {os.path.basename(path)}")

