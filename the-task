class Fighter:
    """
    Complete fighting-game actor implementing Cecilia Darkmoon and Kiri, their unique widgets
    (Umbra + delayable Phantom Arms; Bell Notes + Verse + Dew/Frost stances), Fester, Resolve,
    Trance, Severance, Possession + Backlash, Verlet cloth/hair physics, and 3D skeletal pose.
    """

    def __init__(
        self,
        slot: int,
        char_id: str,
        palette_idx: int = 0,
        vow_idx: int = 0,
        control_scheme: str = "ritual",
        is_cpu: bool = False,
        cpu_level: int = 2,
    ) -> None:
        self.slot = slot
        self.char_id = char_id
        self.palette_idx = palette_idx
        self.vow = VOWS[vow_idx % len(VOWS)]
        self.control_scheme = control_scheme
        self.is_cpu = is_cpu
        self.cpu_level = cpu_level

        self.name = "CECILIA DARKMOON" if char_id == "cecilia" else "KIRI"
        self.title = (
            "The Eclipse-Crowned Queen of Six Hands" if char_id == "cecilia" else "The Nameless Masked Dancer"
        )
        self.palettes = CECILIA_PALETTES if char_id == "cecilia" else KIRI_PALETTES
        self.palette = self.palettes[palette_idx % len(self.palettes)]
        self.moves = MOVE_TABLES[char_id]

        # Physics & Spatial State
        self.x: float = -3.1 if slot == 0 else 3.1
        self.y: float = 0.0
        self.z: float = 0.0
        self.vx: float = 0.0
        self.vy: float = 0.0
        self.facing: int = 1 if slot == 0 else -1
        self.grounded: bool = True
        self.air_dashed: bool = False

        # Core GDD Resources
        self.max_vitality: float = (MAX_VITALITY if char_id == "cecilia" else 920.0) * self.vow["vitality_mult"]
        self.vitality: float = self.max_vitality
        self.fester: float = 0.0
        self.fester_timer: int = 0
        self.resolve: float = MAX_RESOLVE
        self.trance: float = self.vow["start_trance"]
        self.rounds_won: int = 0

        # Combat Action State
        self.state: str = "idle"  # idle, walk, crouch, jump, attack, guard, severance, hitstun, stagger, knockdown, wakeup, roll, blade_lock, possession_act, ko
        self.state_frame: int = 0
        self.stun_frames: int = 0
        self.invuln_frames: int = 0
        self.severance_frames: int = 0
        self.guard_held: bool = False
        self.crouch_held: bool = False

        self.current_move: Optional[MoveDef] = None
        self.move_hit_registered: bool = False
        self.move_counter_triggered: bool = False
        self.auto_combo_step: int = 0
        self.combo_count: int = 0
        self.combo_timer: int = 0
        self.combo_damage: float = 0.0
        self.input_buffer: List[Tuple[str, int]] = []

        # Possession State (GDD 2.10)
        self.possession_frames: int = 0
        self.mask_crack_flash: int = 0

        # Character-Unique Mechanics (GDD 3.2 & 3.3)
        # Cecilia: Umbra (0..3 stacks) + Delayable Phantom Arms (hold Heavy 0..20f)
        self.umbra_stacks: int = 0
        self.echo_charge_frames: int = 0
        self.pending_echo_delay: int = 0
        # Kiri: Bell Notes (ascending 5-note pentatonic chain -> Verse buff) + Dew/Frost stance
        self.bell_chain: List[str] = []
        self.verse_buff_frames: int = 0
        self.stance: str = "dew"  # "dew" (offense speed) or "frost" (counter/resolve)

        # Blade Lock choice ("push", "slip", "pull", or "")
        self.blade_lock_pick: str = ""

        # Match Telemetry
        self.stat_sync_hits: int = 0
        self.stat_severances: int = 0
        self.stat_max_combo: int = 0

        # 3D Skeleton, Animation & Secondary Verlet Cloth/Hair Chains
        bind = CECILIA_BIND_OFFSETS if char_id == "cecilia" else KIRI_BIND_OFFSETS
        self.skeleton = SkeletonPose(bind)
        self.anim = AnimationPlayer(char_id)
        self.hair_chain = SecondarySpringChain((6, 7, 8, 9), stiffness=30.0, damping=5.8, gravity_bias=-12.0)
        self.cloth_chain = SecondarySpringChain((20, 21, 22, 23), stiffness=24.0, damping=4.8, gravity_bias=-14.0)
        self.smear_history: List[Tuple[float, float, float]] = []
        self.ai_cooldown: int = 12
        self.ai_intent: str = "approach"
        self.update_skeleton(FIXED_DT, 0.0, 0.0)

    def reset_for_round(self, keep_trance: bool = True) -> None:
        self.x = -3.1 if self.slot == 0 else 3.1
        self.y = 0.0
        self.vx = 0.0
        self.vy = 0.0
        self.facing = 1 if self.slot == 0 else -1
        self.grounded = True
        self.air_dashed = False
        self.vitality = self.max_vitality
        self.fester = 0.0
        self.fester_timer = 0
        self.resolve = MAX_RESOLVE
        if not keep_trance:
            self.trance = self.vow["start_trance"]
        else:
            self.trance = max(self.trance, self.vow["start_trance"])
        self.state = "idle"
        self.state_frame = 0
        self.stun_frames = 0
        self.invuln_frames = 0
        self.severance_frames = 0
        self.current_move = None
        self.move_hit_registered = False
        self.combo_count = 0
        self.combo_timer = 0
        self.possession_frames = 0
        self.mask_crack_flash = 0
        self.umbra_stacks = 0
        self.bell_chain.clear()
        self.verse_buff_frames = 0
        self.blade_lock_pick = ""
        self.smear_history.clear()
        self.anim.play("intro", restart=True, blend_dur=0.0)

    def buffer_input(self, action: str) -> None:
        self.input_buffer.append((action, INPUT_BUFFER_FRAMES))

    def pop_buffered(self, actions: Sequence[str]) -> Optional[str]:
        for idx, (act, _) in enumerate(self.input_buffer):
            if act in actions:
                self.input_buffer.pop(idx)
                return act
        return None

    def tick_buffer(self) -> None:
        self.input_buffer = [(a, t - 1) for (a, t) in self.input_buffer if t > 1]

    def can_act(self) -> bool:
        return self.state in ("idle", "walk", "crouch", "jump")

    def add_trance(self, amount: float, tempo_phase: str) -> None:
        if self.possession_frames > 0:
            return  # GDD 2.4: Trance does not fill during Possession
        mult = self.vow["trance_mult"] * (1.25 if tempo_phase == "frenzy" else 1.0)
        self.trance = clamp(self.trance + amount * mult, 0.0, MAX_TRANCE)

    def inflict_fester(self, amount: float) -> None:
        if amount <= 0.0:
            return
        self.fester = min(self.vitality - 1.0, self.fester + amount)
        self.fester_timer = FESTER_DURATION_FRAMES

    def clear_fester_chunk(self, full: bool = False) -> float:
        if self.fester <= 0.0:
            return 0.0
        cleared = self.fester if full else self.fester * FESTER_HIT_CLEAR_RATIO
        self.fester = max(0.0, self.fester - cleared)
        if self.fester <= 0.5:
            self.fester = 0.0
            self.fester_timer = 0
        return cleared

    def register_kiri_bell_note(self, note_id: str, audio: ProceduralAudioEngine) -> bool:
        """Kiri Bell Notes: 5 unique attacks in sequence ring ascending pentatonic scale -> Verse buff!"""
        if self.char_id != "kiri" or not note_id:
            return False
        if note_id in self.bell_chain:
            self.bell_chain = [note_id]
        else:
            self.bell_chain.append(note_id)
        idx = min(len(self.bell_chain) - 1, len(KIRI_BELL_NOTES) - 1)
        audio.play_sfx(f"bell_{idx}", 0.85)
        if len(self.bell_chain) >= 5:
            self.bell_chain.clear()
            self.verse_buff_frames = 360  # 6 seconds of Verse damage + free cancel buff
            return True
        return False

    def get_active_palette(self) -> Dict[str, Any]:
        """Possession visual transformation palette shift (Cecilia: black/gold/crimson)."""
        if self.possession_frames > 0 and self.char_id == "cecilia":
            return {
                **self.palette,
                "dress_outer": (16, 10, 16),
                "dress_inner": (218, 24, 38),
                "gold": (255, 218, 92),
                "aura": (255, 58, 42),
                "sword_vein": (255, 208, 72),
            }
        return self.palette

    def update_skeleton(self, dt: float, beat_pulse: float, world_t: float) -> None:
        prev_vx = self.vx
        self.anim.step(dt, speed=1.12 if self.possession_frames > 0 else 1.0)
        eulers = self.anim.evaluate()
        self.hair_chain.step(dt, self.vx - prev_vx * 0.5, self.vy, self.facing, beat_pulse, world_t)
        self.cloth_chain.step(dt, self.vx * 0.65, self.vy, self.facing, beat_pulse, world_t + 1.4)
        self.hair_chain.apply_to_pose(eulers)
        self.cloth_chain.apply_to_pose(eulers)
        scale = 1.03 if self.char_id == "cecilia" else 0.96
        root_pos = (
            self.x + self.anim.root_dx * self.facing,
            self.y + max(-0.32, self.anim.root_dy),
            self.z,
        )
        self.skeleton.solve(root_pos, self.facing, eulers, scale=scale)
        # Track weapon tip position for painterly smear ribbon trails
        wx, wy, wz = self.skeleton.world_pos[18]
        if self.anim.smear_active:
            self.smear_history.append((wx, wy, wz))
            if len(self.smear_history) > 8:
                self.smear_history.pop(0)
        elif self.smear_history:
            self.smear_history.pop(0)


