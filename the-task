# SECTION 9: DUAL-BACKEND 3D RENDERER (OPENGL 1.5/2.0 HARDWARE + SOFTWARE 3D)
# ==============================================================================

class Renderer3D:
    """
    Dual-backend 3D cel-shaded renderer designed for PS2/PSP stylized AAA quality:
      * Hardware Backend: OpenGL 1.5/2.0 fixed-function pipeline (Mobile Intel 4 Series safe)
      * Software Backend: Built-in Pure-Pygame 3D cel-shaded polygon rasterizer (zero extra deps)
    """

    def __init__(self, textures: ProceduralTextureAtlas, use_opengl: bool = False) -> None:
        self.textures = textures
        self.use_opengl = bool(use_opengl and HAS_OPENGL)
        self.gl_initialized = False
        self.gl_hud_tex: int = 0
        self.stage_cache_surf: Optional["pygame.Surface"] = None
        self.stage_cache_key: Tuple[Any, ...] = ()

    def init_opengl_state(self) -> None:
        if not self.use_opengl or gl is None or glu is None:
            return
        try:
            gl.glViewport(0, 0, INTERNAL_W, INTERNAL_H)
            gl.glEnable(gl.GL_DEPTH_TEST)
            gl.glDepthFunc(gl.GL_LEQUAL)
            gl.glEnable(gl.GL_CULL_FACE)
            gl.glCullFace(gl.GL_BACK)
            gl.glShadeModel(gl.GL_SMOOTH)
            gl.glEnable(gl.GL_BLEND)
            gl.glBlendFunc(gl.GL_SRC_ALPHA, gl.GL_ONE_MINUS_SRC_ALPHA)
            self.gl_hud_tex = int(gl.glGenTextures(1))
            self.gl_initialized = True
        except Exception:
            self.use_opengl = False
            self.gl_initialized = False

    @staticmethod
    def _stage_material_color(mat_id: int, script: Dict[str, Any], beat: float) -> Tuple[int, int, int]:
        if mat_id == 0:
            return (46, 32, 36)
        if mat_id == 1:
            return (64, 44, 48)
        if mat_id == 2:
            return (34, 24, 30)
        if mat_id == 3:
            return (138, 26, 30)
        if mat_id == 4:
            return scale_color(script["moon_window"], 0.85 + 0.35 * beat)
        if mat_id == 5:
            return (112, 88, 52)
        if mat_id == 6:
            return (36, 28, 30)
        if mat_id == 7:
            return (156, 22, 28)
        if mat_id == 8:
            return scale_color(script["sigil_glow"], 0.8 + 0.45 * beat)
        if mat_id == 9:
            return lerp_color((24, 10, 16), script["sky_mid"], 0.25)
        if mat_id == 10:
            return (255, 226, 92) if beat > 0.4 else (255, 96, 48)
        return (26, 18, 22)

    @staticmethod
    def _fighter_material_color(fighter: Fighter, mat_id: int) -> Tuple[int, int, int]:
        p = fighter.get_active_palette()
        if fighter.char_id == "cecilia":
            table = (
                p["skin"], p["hair"], p["dress_outer"], p["dress_inner"], p["gold"],
                p["ribbon"], p["stockings"], p["sword_iron"], p["sword_vein"], p["aura"], p["skin"]
            )
        else:
            table = (
                p["skin"], p["hair"], p["mask"], p["mask_mark"], p["gold"],
                p["jacket"], p["skirt"], p["ribbon"], p["stockings"], p["geta"], p["blade"], p["foxfire"]
            )
        return table[mat_id % len(table)]

    def _cel_shade(
        self,
        base_col: Tuple[int, int, int],
        nx: float, ny: float, nz: float,
        script: Dict[str, Any],
        rim_col: Tuple[float, float, float],
        emissive: bool = False,
    ) -> Tuple[int, int, int]:
        """PS2/PSP-era high-craft two-tone anime cel shading with warm key light and crisp rim light."""
        if emissive:
            return base_col
        lx, ly, lz = script["key_light_dir"]
        ndotl = nx * lx + ny * ly + nz * lz
        # Crisp two-tone cel ramp with soft mid-band
        tone = 1.06 if ndotl > 0.14 else (0.78 if ndotl > -0.18 else 0.52)
        kr, kg, kb = script["key_light_col"]
        ar, ag, ab = script["ambient_col"]
        rim = max(0.0, 1.0 - abs(nz)) ** 2.4 * 0.42
        r = clamp(base_col[0] * (tone * kr + ar * 0.45) + rim * rim_col[0] * 145.0, 0, 255)
        g = clamp(base_col[1] * (tone * kg + ag * 0.45) + rim * rim_col[1] * 145.0, 0, 255)
        b = clamp(base_col[2] * (tone * kb + ab * 0.45) + rim * rim_col[2] * 145.0, 0, 255)
        return (int(r), int(g), int(b))

    def render_stage_software(
        self,
        target: "pygame.Surface",
        cam: Camera3D,
        stage_area: int,
        script_key: str,
        beat_pulse: float,
        world_t: float,
        fighters: Sequence[Fighter],
    ) -> None:
        """Renders sky dome, cached 3D Sunken Pagoda architecture, floor Pulse sigil, hitodama & crows."""
        script = LIGHTING_SCRIPTS[script_key]
        # 1. Painted blood-red storm sky dome + eclipsed black sun
        sky = self.textures.sky_cache[script_key]
        target.fill(script["fog"])
        target.blit(sky, (0, 0))

        # 2. Cached 3D Architectural Stage Mesh (re-renders smoothly when camera moves or beat shifts)
        cache_key = (stage_area, script_key, round(cam.pos_x, 1), round(cam.pos_z, 1), int(beat_pulse * 3))
        if self.stage_cache_surf is None or self.stage_cache_key != cache_key:
            surf = pygame.Surface((INTERNAL_W, INTERNAL_H), pygame.SRCALPHA)
            verts = MESH_STAGE_AREA1_VERTS if stage_area == 0 else MESH_STAGE_AREA2_VERTS
            tris = MESH_STAGE_AREA1_TRIS if stage_area == 0 else MESH_STAGE_AREA2_TRIS
            half_w, half_h = INTERNAL_W * 0.5, INTERNAL_H * 0.5
            proj: List[Optional[Tuple[float, float, float]]] = [
                cam.project(v[0], v[1], v[2], half_w, half_h) for v in verts
            ]
            draw_list: List[Tuple[float, Tuple[int, int, int], Tuple[Tuple[int, int], ...]]] = []
            # Adaptive stride = 2 keeps software 3D stage crisp and silky-fast while rendering every structure
            for ti in range(0, len(tris), 2):
                i0, i1, i2, mat = tris[ti]
                p0, p1, p2 = proj[i0], proj[i1], proj[i2]
                if p0 is None or p1 is None or p2 is None:
                    continue
                # Screen-space backface culling
                ax, ay = p1[0] - p0[0], p1[1] - p0[1]
                bx, by = p2[0] - p0[0], p2[1] - p0[1]
                if (ax * by - ay * bx) > 0.0 and mat not in (4, 8):
                    continue
                depth = (p0[2] + p1[2] + p2[2]) * 0.333
                v0 = verts[i0]
                base = self._stage_material_color(mat, script, beat_pulse)
                emissive = mat in (4, 8, 10)
                col = self._cel_shade(base, v0[3], v0[4], v0[5], script, (0.85, 0.28, 0.22), emissive)
                # Atmospheric swamp depth fog
                fog_t = clamp((depth - 9.0) / 18.0, 0.0, script["fog_alpha"])
                if not emissive:
                    col = lerp_color(col, script["fog"], fog_t)
                draw_list.append((depth, col, ((int(p0[0]), int(p0[1])), (int(p1[0]), int(p1[1])), (int(p2[0]), int(p2[1])))))
            draw_list.sort(key=lambda item: item[0], reverse=True)
            for _, col, pts in draw_list:
                pygame.draw.polygon(surf, col, pts)
            self.stage_cache_surf = surf
            self.stage_cache_key = cache_key

        target.blit(self.stage_cache_surf, (0, 0))

        # 3. Glowing Crimson Moon-Window Rose Medallion billboard + Crimson Shafts
        half_w, half_h = INTERNAL_W * 0.5, INTERNAL_H * 0.5
        mw_pos = cam.project(0.0, 4.95 if stage_area == 0 else 6.4, -7.3 if stage_area == 0 else -10.5, half_w, half_h)
        if mw_pos is not None:
            mw_sz = int(clamp(2350.0 / mw_pos[2], 90, 320))
            mw_img = pygame.transform.smoothscale(self.textures.surfaces["tex_moon_window"], (mw_sz, mw_sz))
            target.blit(mw_img, (int(mw_pos[0] - mw_sz * 0.5), int(mw_pos[1] - mw_sz * 0.5)))

        # 4. Perspective-Projected Glowing Eclipse-Lotus Floor Pulse Sigil (172 BPM Beat Reactive!)
        sig_center = cam.project(0.0, 0.03, 0.0, half_w, half_h)
        if sig_center is not None:
            sc_w = int(clamp((4800.0 / sig_center[2]) * (1.0 + beat_pulse * 0.08), 260, 740))
            sc_h = int(sc_w * 0.24)
            sig_img = pygame.transform.smoothscale(self.textures.surfaces["pulse_sigil"], (sc_w, sc_h))
            sig_img.set_alpha(int(175 + beat_pulse * 80))
            target.blit(sig_img, (int(sig_center[0] - sc_w * 0.5), int(sig_center[1] - sc_h * 0.5)))

        # 5. Drifting Green-Gold Hitodama Soul-Lights & Wheeling Swamp Crows (GDD 4.1)
        h_col = script["hitodama"]
        for hi in range(7):
            hx = -8.4 + hi * 2.8 + math.sin(world_t * 1.4 + hi) * 0.45
            hy = 1.2 + (hi % 3) * 0.95 + math.sin(world_t * 2.3 + hi * 1.7) * 0.35
            hz = -2.8 - (hi % 2) * 2.2
            hp = cam.project(hx, hy, hz, half_w, half_h)
            if hp is not None:
                rad = int(clamp((65.0 / hp[2]) * (1.0 + beat_pulse * 0.35), 4, 18))
                glow = pygame.Surface((rad * 4, rad * 4), pygame.SRCALPHA)
                pygame.draw.circle(glow, (*h_col, 70), (rad * 2, rad * 2), rad * 2)
                pygame.draw.circle(glow, (*h_col, 160), (rad * 2, rad * 2), rad)
                pygame.draw.circle(glow, (250, 255, 228, 240), (rad * 2, rad * 2), max(2, rad // 2))
                target.blit(glow, (int(hp[0] - rad * 2), int(hp[1] - rad * 2)))

        # Guardian Statue Eyes Tracking the Midpoint of the Fighters!
        if stage_area == 0 and fighters:
            mid_fx = sum(f.x for f in fighters) / len(fighters)
            eye_shift = clamp(mid_fx * 0.03, -0.14, 0.14)
            for side in (-1.0, 1.0):
                ep = cam.project(side * 3.1 + eye_shift, 5.25, -5.1, half_w, half_h)
                if ep is not None:
                    pygame.draw.circle(target, (255, 68, 42), (int(ep[0]) - 5, int(ep[1])), 4)
                    pygame.draw.circle(target, (255, 68, 42), (int(ep[0]) + 5, int(ep[1])), 4)

    def render_fighter_software(
        self,
        target: "pygame.Surface",
        cam: Camera3D,
        fighter: Fighter,
        script_key: str,
        beat_pulse: float,
    ) -> None:
        """
        Renders an articulated 3D fighter mesh with skeletal skinning, two-tone cel shading,
        thin inked silhouette contour, planar ground shadow, spectral Possession deity/tails,
        and colorblind-safe Attack Tell glints!
        """
        script = LIGHTING_SCRIPTS[script_key]
        rim = script["rim_p1"] if fighter.slot == 0 else script["rim_p2"]
        half_w, half_h = INTERNAL_W * 0.5, INTERNAL_H * 0.5

        # 1. Projected Planar Ground Shadow
        sh_p = cam.project(fighter.x, 0.02, fighter.z, half_w, half_h)
        if sh_p is not None:
            sw = int(clamp((920.0 / sh_p[2]) * (1.0 - min(0.45, fighter.y * 0.12)), 42, 165))
            sh = max(12, int(sw * 0.22))
            shadow_s = pygame.Surface((sw, sh), pygame.SRCALPHA)
            pygame.draw.ellipse(shadow_s, (8, 2, 6, 155), (0, 0, sw, sh))
            target.blit(shadow_s, (int(sh_p[0] - sw * 0.5), int(sh_p[1] - sh * 0.5)))

        # 2. Possession Spectral Backdrop Entity (War-Spirit Manifest or Nine-Tail Masquerade!)
        if fighter.possession_frames > 0:
            self._render_static_attached_entity(
                target, cam, fighter,
                MESH_WAR_SPIRIT_VERTS if fighter.char_id == "cecilia" else MESH_NINE_TAIL_VERTS,
                MESH_WAR_SPIRIT_TRIS if fighter.char_id == "cecilia" else MESH_NINE_TAIL_TRIS,
                (255, 68, 48) if fighter.char_id == "cecilia" else (128, 224, 255),
                beat_pulse,
            )

        # 3. Skinned 3D Character Mesh (Cecilia Darkmoon or Kiri)
        verts = MESH_CECILIA_VERTS if fighter.char_id == "cecilia" else MESH_KIRI_VERTS
        tris = MESH_CECILIA_TRIS if fighter.char_id == "cecilia" else MESH_KIRI_TRIS
        wpos = fighter.skeleton.world_pos
        wmat = fighter.skeleton.world_mat3
        scale = 1.03 if fighter.char_id == "cecilia" else 0.96

        # Transform all character vertices via their bound skeletal bone
        proj: List[Optional[Tuple[float, float, float]]] = [None] * len(verts)
        wnorm: List[Tuple[float, float, float]] = [(0.0, 1.0, 0.0)] * len(verts)
        for vi, v in enumerate(verts):
            vx, vy, vz, nx, ny, nz, _, _, b_idx = v
            px, py, pz = wpos[b_idx]
            m = wmat[b_idx]
            vx *= scale
            vy *= scale
            vz *= scale
            wx = px + m[0] * vx + m[1] * vy + m[2] * vz
            wy = py + m[3] * vx + m[4] * vy + m[5] * vz
            wz = pz + m[6] * vx + m[7] * vy + m[8] * vz
            proj[vi] = cam.project(wx, wy, wz, half_w, half_h)
            wnorm[vi] = (
                m[0] * nx + m[1] * ny + m[2] * nz,
                m[3] * nx + m[4] * ny + m[5] * nz,
                m[6] * nx + m[7] * ny + m[8] * nz,
            )

        draw_tris: List[Tuple[float, Tuple[int, int, int], bool, Tuple[Tuple[int, int], ...]]] = []
        show_phantom_arms = (fighter.char_id == "cecilia") and (fighter.umbra_stacks > 0 or fighter.possession_frames > 0)
        for ti in range(0, len(tris), 2):
            i0, i1, i2, mat = tris[ti]
            if fighter.char_id == "cecilia" and verts[i0][8] == 19 and not show_phantom_arms:
                continue
            p0, p1, p2 = proj[i0], proj[i1], proj[i2]
            if p0 is None or p1 is None or p2 is None:
                continue
            ax, ay = p1[0] - p0[0], p1[1] - p0[1]
            bx, by = p2[0] - p0[0], p2[1] - p0[1]
            if (ax * by - ay * bx) > 0.0 and mat not in (5, 9, 11):
                continue
            depth = (p0[2] + p1[2] + p2[2]) * 0.333
            base_col = self._fighter_material_color(fighter, mat)
            emissive = (mat in (4, 8, 9)) if fighter.char_id == "cecilia" else (mat in (4, 11))
            n0 = wnorm[i0]
            col = self._cel_shade(base_col, n0[0], n0[1], n0[2], script, rim, emissive)
            if fighter.state == "hitstun" and fighter.state_frame % 4 < 2:
                col = lerp_color(col, (255, 220, 220), 0.55)
            elif fighter.severance_frames > 0:
                col = lerp_color(col, (255, 232, 132), 0.45)
            draw_tris.append((depth, col, emissive, ((int(p0[0]), int(p0[1])), (int(p1[0]), int(p1[1])), (int(p2[0]), int(p2[1])))))

        draw_tris.sort(key=lambda item: item[0], reverse=True)
        for _, col, emissive, pts in draw_tris:
            pygame.draw.polygon(target, col, pts)
            if not emissive:
                pygame.draw.polygon(target, (18, 8, 14), pts, 1)

        # 4. Weapon Smear Arc Ribbon (GDD 2.11)
        if len(fighter.smear_history) >= 3:
            smear_pts = []
            for sx, sy, sz in fighter.smear_history:
                sp = cam.project(sx, sy, sz, half_w, half_h)
                if sp is not None:
                    smear_pts.append((int(sp[0]), int(sp[1])))
            if len(smear_pts) >= 2:
                scol = (224, 52, 198) if fighter.char_id == "cecilia" else (142, 232, 255)
                pygame.draw.lines(target, scol, False, smear_pts, 10)
                pygame.draw.lines(target, (255, 244, 212), False, smear_pts, 4)

        # 5. Colorblind-Safe Attack Tell Glint at Weapon Tip during Startup (GDD 2.3)
        if fighter.state == "attack" and fighter.current_move is not None:
            mv = fighter.current_move
            if 1 <= fighter.state_frame <= mv.startup and mv.tell != TELL_NONE:
                w_tip = fighter.skeleton.world_pos[18]
                tp = cam.project(w_tip[0], w_tip[1] + 0.35, w_tip[2], half_w, half_h)
                if tp is not None:
                    self._draw_tell_shape(target, int(tp[0]), int(tp[1]), mv.tell, fighter.state_frame)

    def _render_static_attached_entity(
        self,
        target: "pygame.Surface",
        cam: Camera3D,
        fighter: Fighter,
        verts: Sequence[Tuple[Any, ...]],
        tris: Sequence[Tuple[int, int, int, int]],
        tint: Tuple[int, int, int],
        beat_pulse: float,
    ) -> None:
        half_w, half_h = INTERNAL_W * 0.5, INTERNAL_H * 0.5
        overlay = pygame.Surface((INTERNAL_W, INTERNAL_H), pygame.SRCALPHA)
        proj = [
            cam.project(
                fighter.x + v[0] * fighter.facing,
                fighter.y + v[1] + math.sin(beat_pulse * math.pi) * 0.08,
                fighter.z + v[2],
                half_w, half_h,
            )
            for v in verts
        ]
        for ti in range(0, len(tris), 3):
            i0, i1, i2, mat = tris[ti]
            p0, p1, p2 = proj[i0], proj[i1], proj[i2]
            if p0 is None or p1 is None or p2 is None:
                continue
            col = (*tint, 92 if mat != 4 else 148)
            pygame.draw.polygon(overlay, col, ((int(p0[0]), int(p0[1])), (int(p1[0]), int(p1[1])), (int(p2[0]), int(p2[1]))))
        target.blit(overlay, (0, 0))

    @staticmethod
    def _draw_tell_shape(target: "pygame.Surface", cx: int, cy: int, tell: int, frame: int) -> None:
        meta = TELL_META[tell]
        col = meta["color"]
        shape = meta["shape"]
        rad = 18 + (frame % 4) * 2
        if shape == "circle":
            pygame.draw.circle(target, col, (cx, cy), rad, 3)
            pygame.draw.circle(target, (255, 255, 255), (cx, cy), 6)
        elif shape == "diamond":
            pts = [(cx, cy - rad), (cx + rad, cy), (cx, cy + rad), (cx - rad, cy)]
            pygame.draw.polygon(target, col, pts, 3)
            pygame.draw.circle(target, (255, 248, 210), (cx, cy), 5)
        elif shape == "wedge":
            pts = [(cx - rad, cy - rad // 2), (cx + rad, cy - rad // 2), (cx, cy + rad)]
            pygame.draw.polygon(target, col, pts, 3)
        elif shape == "jagged":
            pts = []
            for k in range(12):
                ang = k * (math.tau / 12.0)
                rr = rad * (1.35 if k % 2 == 0 else 0.55)
                pts.append((cx + int(math.cos(ang) * rr), cy + int(math.sin(ang) * rr)))
            pygame.draw.polygon(target, col, pts, 3)
            pygame.draw.circle(target, (255, 232, 180), (cx, cy), 6)

    def render_opengl_frame(
        self,
        hud_surf: "pygame.Surface",
        cam: Camera3D,
        stage_area: int,
        script_key: str,
        beat_pulse: float,
        fighters: Sequence[Fighter],
    ) -> None:
        """
        Hardware OpenGL 1.5/2.0 Fixed-Function 3D Render Path (compatible with legacy
        Mobile Intel 4 Series Express Chipset & older laptops at 30-60 FPS!).
        """
        if not self.gl_initialized or gl is None or glu is None:
            return
        script = LIGHTING_SCRIPTS[script_key]
        sky = script["sky_mid"]
        gl.glClearColor(sky[0] / 255.0, sky[1] / 255.0, sky[2] / 255.0, 1.0)
        gl.glClear(gl.GL_COLOR_BUFFER_BIT | gl.GL_DEPTH_BUFFER_BIT)

        gl.glMatrixMode(gl.GL_PROJECTION)
        gl.glLoadIdentity()
        glu.gluPerspective(cam.fov_deg, float(INTERNAL_W) / float(INTERNAL_H), 0.25, 95.0)
        gl.glMatrixMode(gl.GL_MODELVIEW)
        gl.glLoadIdentity()
        ex, ey, ez = cam.eye
        glu.gluLookAt(ex, ey, ez, cam.target_x, cam.target_y, cam.target_z, 0.0, 1.0, 0.0)

        # Draw Stage 3D Architecture
        verts = MESH_STAGE_AREA1_VERTS if stage_area == 0 else MESH_STAGE_AREA2_VERTS
        tris = MESH_STAGE_AREA1_TRIS if stage_area == 0 else MESH_STAGE_AREA2_TRIS
        gl.glBegin(gl.GL_TRIANGLES)
        for i0, i1, i2, mat in tris:
            v0, v1, v2 = verts[i0], verts[i1], verts[i2]
            base = self._stage_material_color(mat, script, beat_pulse)
            col = self._cel_shade(base, v0[3], v0[4], v0[5], script, (0.9, 0.3, 0.25), mat in (4, 8, 10))
            gl.glColor3ub(col[0], col[1], col[2])
            gl.glVertex3f(v0[0], v0[1], v0[2])
            gl.glVertex3f(v1[0], v1[1], v1[2])
            gl.glVertex3f(v2[0], v2[1], v2[2])
        gl.glEnd()

        # Draw Skinned 3D Fighters
        for f in fighters:
            fverts = MESH_CECILIA_VERTS if f.char_id == "cecilia" else MESH_KIRI_VERTS
            ftris = MESH_CECILIA_TRIS if f.char_id == "cecilia" else MESH_KIRI_TRIS
            wpos = f.skeleton.world_pos
            wmat = f.skeleton.world_mat3
            scale = 1.03 if f.char_id == "cecilia" else 0.96
            rim = script["rim_p1"] if f.slot == 0 else script["rim_p2"]
            tverts = []
            for vx, vy, vz, nx, ny, nz, _, _, b_idx in fverts:
                px, py, pz = wpos[b_idx]
                m = wmat[b_idx]
                vx *= scale
                vy *= scale
                vz *= scale
                tverts.append((
                    px + m[0] * vx + m[1] * vy + m[2] * vz,
                    py + m[3] * vx + m[4] * vy + m[5] * vz,
                    pz + m[6] * vx + m[7] * vy + m[8] * vz,
                    m[0] * nx + m[1] * ny + m[2] * nz,
                    m[3] * nx + m[4] * ny + m[5] * nz,
                    m[6] * nx + m[7] * ny + m[8] * nz,
                    b_idx,
                ))
            gl.glBegin(gl.GL_TRIANGLES)
            for i0, i1, i2, mat in ftris:
                v0, v1, v2 = tverts[i0], tverts[i1], tverts[i2]
                base = self._fighter_material_color(f, mat)
                col = self._cel_shade(base, v0[3], v0[4], v0[5], script, rim, mat in (4, 8, 9, 11))
                gl.glColor3ub(col[0], col[1], col[2])
                gl.glVertex3f(v0[0], v0[1], v0[2])
                gl.glVertex3f(v1[0], v1[1], v1[2])
                gl.glVertex3f(v2[0], v2[1], v2[2])
            gl.glEnd()

        # Composite 2D Ornate HUD & VFX Overlay Quad over OpenGL framebuffer
        gl.glMatrixMode(gl.GL_PROJECTION)
        gl.glLoadIdentity()
        gl.glOrtho(0, INTERNAL_W, INTERNAL_H, 0, -1, 1)
        gl.glMatrixMode(gl.GL_MODELVIEW)
        gl.glLoadIdentity()
        gl.glDisable(gl.GL_DEPTH_TEST)
        gl.glEnable(gl.GL_TEXTURE_2D)
        gl.glBindTexture(gl.GL_TEXTURE_2D, self.gl_hud_tex)
        raw = pygame.image.tostring(hud_surf, "RGBA", False)
        gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, gl.GL_LINEAR)
        gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, gl.GL_LINEAR)
        gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, gl.GL_RGBA, INTERNAL_W, INTERNAL_H, 0, gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, raw)
        gl.glColor4f(1.0, 1.0, 1.0, 1.0)
        gl.glBegin(gl.GL_QUADS)
        gl.glTexCoord2f(0.0, 0.0); gl.glVertex2f(0, 0)
        gl.glTexCoord2f(1.0, 0.0); gl.glVertex2f(INTERNAL_W, 0)
        gl.glTexCoord2f(1.0, 1.0); gl.glVertex2f(INTERNAL_W, INTERNAL_H)
        gl.glTexCoord2f(0.0, 1.0); gl.glVertex2f(0, INTERNAL_H)
        gl.glEnd()
        gl.glDisable(gl.GL_TEXTURE_2D)
        gl.glEnable(gl.GL_DEPTH_TEST)


