                spark = rng.uniform(-1.0, 1.0) * math.exp(-t * 58.0) * 0.55
                v = (ring + spark) * gain
                sl.append(v)
                sr_v.append(v * 0.94 + ring * 0.08)
            return make_sound(sl, sr_v)

