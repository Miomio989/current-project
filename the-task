    def _init_ambient_entities(self) -> None:
        rng = random.Random(1666)
        for _ in range(36):
            self.embers.append(StageEmber(
                x=rng.uniform(0, STAGE_WORLD_W),
                y=rng.uniform(80, RENDER_H),
                vx=rng.uniform(-16, 22),
                vy=rng.uniform(-48, -16),
                size=rng.uniform(1.5, 3.6),
                life=rng.uniform(0.0, 4.0),
                max_life=rng.uniform(2.5, 5.5),
                bright=rng.random() < 0.45,
            ))
        for _ in range(8):
            self.bats.append(CathedralBat(
                x=rng.uniform(80, STAGE_WORLD_W - 80),
                y=rng.uniform(48, 220),
                vx=rng.uniform(34, 72) * (1 if rng.random() < 0.5 else -1),
                vy=rng.uniform(-8, 8),
                wing_phase=rng.uniform(0, math.tau),
                scale=rng.uniform(0.65, 1.25),
            ))

    def spawn_water_splash(self, world_x: float, intensity: float = 1.0, crimson: bool = False) -> None:
        self.ripples.append(WaterRipple(
            x=world_x, y=GROUND_Y + 4,
            rx=10.0 * intensity, ry=3.0 * intensity,
            max_r=54.0 * intensity + 18.0, alpha=210.0, tinted_red=crimson,
        ))
        n_drops = clamp_int(int(8 * intensity), 4, 18)
        for i in range(n_drops):
            ang = lerp(-math.pi * 0.85, -math.pi * 0.15, (i + 0.5) / float(n_drops))
            spd = random.uniform(75.0, 210.0) * intensity
            self.splashes.append(WaterSplashDrop(
                x=world_x + random.uniform(-12, 12),
                y=GROUND_Y + 2,
                vx=math.cos(ang) * spd,
                vy=math.sin(ang) * spd,
                size=random.uniform(2.0, 4.8) * min(1.4, intensity),
                alpha=225.0,
                crimson=crimson or (random.random() < 0.35),
            ))

    def trigger_lightning(self, strength: float = 1.0) -> None:
        self.lightning_flash = max(self.lightning_flash, clamp(strength, 0.2, 1.0))

    def update(self, dt: float, overdrive_active: bool = False) -> None:
        self.time_s += dt
        target_ec = 1.0 if overdrive_active else 0.0
        self.eclipse_amount += (target_ec - self.eclipse_amount) * min(1.0, dt * 4.5)
        if self.lightning_flash > 0.0:
            self.lightning_flash = max(0.0, self.lightning_flash - dt * 3.8)
        elif overdrive_active and random.random() < dt * 0.65:
            self.lightning_flash = 0.72

        for e in self.embers:
            e.life += dt
            e.x += (e.vx + math.sin(self.time_s * 2.2 + e.y * 0.02) * 14.0) * dt
            e.y += e.vy * dt
            if e.life >= e.max_life or e.y < -16:
                e.x = random.uniform(40, STAGE_WORLD_W - 40)
                e.y = random.uniform(WATER_HORIZON_Y, RENDER_H + 10)
                e.life = 0.0

        for b in self.bats:
            b.x += b.vx * dt
            b.y += (b.vy + math.sin(self.time_s * 5.0 + b.wing_phase) * 14.0) * dt
            b.wing_phase += dt * 11.5
            if b.x < -60:
                b.x = STAGE_WORLD_W + 40
            elif b.x > STAGE_WORLD_W + 60:
                b.x = -40

        alive_rip: List[WaterRipple] = []
        for r in self.ripples:
            r.rx += 76.0 * dt
            r.ry += 22.0 * dt
            r.alpha -= 240.0 * dt
            if r.alpha > 4.0 and r.rx < r.max_r:
                alive_rip.append(r)
        self.ripples = alive_rip

        alive_sp: List[WaterSplashDrop] = []
        for sp in self.splashes:
            sp.x += sp.vx * dt
            sp.y += sp.vy * dt
            sp.vy += 640.0 * dt
            sp.alpha -= 360.0 * dt
            if sp.alpha > 4.0 and sp.y < GROUND_Y + 34:
                alive_sp.append(sp)
        self.splashes = alive_sp

    def render_background(self, surf: pygame.Surface, cam_x: float, cam_y: float = 0.0) -> None:
        """Render Layers 0-5 (Sky, Far Abbey, Cathedral, Columns, Iron Fences, Swamp Water)."""
        # Normalized camera offset around stage center (-320 .. +320)
        cam_norm = (cam_x - STAGE_CENTER_X) / float(STAGE_WORLD_W - RENDER_W)
        cy = int(-cam_y)

        # Layer 0: Volcanic Blood-Red Storm Sky (0.08x parallax)
        sx0 = int(-120 - cam_norm * 90)
        surf.blit(self.sky_surf, (sx0, cy))

        # Eclipse / Red Lightning flash tint over sky!
        if self.eclipse_amount > 0.02:
            ec = pygame.Surface((RENDER_W, WATER_HORIZON_Y), pygame.SRCALPHA)
            ec.fill((72, 6, 22, int(92 * self.eclipse_amount)))
            surf.blit(ec, (0, cy))
        if self.lightning_flash > 0.02:
            fl = pygame.Surface((RENDER_W, WATER_HORIZON_Y), pygame.SRCALPHA)
            fl.fill((255, 118, 96, int(135 * self.lightning_flash)))
            surf.blit(fl, (0, cy), special_flags=pygame.BLEND_RGBA_ADD)

        # Flying Silhouetted Cathedral Bats crossing the Blood Moon!
        for b in self.bats:
            bx = int(b.x * 0.55 - cam_x * 0.25 + 220)
            by = int(b.y + cy)
            if -30 <= bx <= RENDER_W + 30:
                flap = math.sin(b.wing_phase) * 7.5 * b.scale
                bw = 10.5 * b.scale
                pts = [
                    (bx - bw, by - flap),
                    (bx - bw * 0.4, by - 2 * b.scale),
                    (bx, by + 2 * b.scale),
                    (bx + bw * 0.4, by - 2 * b.scale),
                    (bx + bw, by - flap),
                    (bx, by + 4.5 * b.scale),
                ]
                pygame.draw.polygon(surf, (18, 6, 12), pts)

        # Layer 1: Distant Hilltop Gothic Abbey (0.20x parallax)
        sx1 = int(-160 - cam_norm * 180)
        surf.blit(self.far_abbey_surf, (sx1, cy))

        # Layer 2: Mid-Ground Ruined Romanesque-Gothic Cathedral Nave (0.42x parallax)
        sx2 = int(-220 - cam_norm * 320)
        surf.blit(self.mid_cathedral_surf, (sx2, cy))

        # Drifting atmospheric mist behind columns
        mist_x = int((self.time_s * 18.0) % RENDER_W)
        surf.blit(self.mist_band_surf, (-mist_x, WATER_HORIZON_Y - 82 + cy))
        surf.blit(self.mist_band_surf, (RENDER_W - mist_x, WATER_HORIZON_Y - 82 + cy))

        # Layer 3: Tilted Mossy Fluted Stone Columns & Gnarled Trees (0.68x parallax)
        sx3 = int(-280 - cam_norm * 460)
        surf.blit(self.near_columns_surf, (sx3, cy))

        # Layer 4: Crooked Wrought-Iron Fences & Flickering Votive Candles (0.88x parallax)
        sx4 = int(-320 - cam_norm * 580)
        surf.blit(self.fence_surf, (sx4, cy))
        for cd in self.candles:
            fx = cd.x + sx4
            if -40 <= fx <= RENDER_W + 40:
                fy = cd.y - 12 + cy
                flick = 0.85 + 0.25 * math.sin(self.time_s * 14.0 + cd.phase)
                self.cg.blit_glow(surf, (fx, fy), 26 * flick * cd.scale, (255, 134, 48), int(125 * flick), additive=True)
                pygame.draw.ellipse(surf, (255, 242, 168), (int(fx - 2), int(fy - 5), 4, 7))

        # Layer 5: Swamp Water Plane (1.00x world coordinates)
        wx_off = int(RENDER_W * 0.5 - cam_x)
        surf.blit(self.water_base_surf, (wx_off, WATER_HORIZON_Y + cy))

    def render_fighter_water_reflection(
        self,
        surf: pygame.Surface,
        refl_sq: pygame.Surface,
        world_x: float,
        world_y: float,
        cam_x: float,
        cam_y: float = 0.0,
    ) -> None:
        """
        Real-time wavy mirror reflection of Cecilia & her glowing crimson sword
        slashes shimmering across the flooded gothic swamp (zero per-frame alloc!).
        """
        sx = int(world_x - cam_x + RENDER_W * 0.5)
        sy = int(GROUND_Y - cam_y)
        height_above = max(0.0, GROUND_Y - world_y)
        rw, rh = refl_sq.get_size()
        refl_sq.set_alpha(clamp_int(int(92 - height_above * 0.28), 22, 96))

        dst_x0 = sx - SPRITE_ANCHOR_X
        dst_y0 = sy + int(height_above * 0.42) - int((SPRITE_H - SPRITE_ANCHOR_Y) * 0.52)
        strip_h = 10
        for ry in range(0, rh, strip_h):
            wy = dst_y0 + ry
            if wy < WATER_HORIZON_Y or wy > RENDER_H:
                continue
            wave_dx = int(math.sin(self.time_s * 4.8 + ry * 0.24) * (2.5 + ry * 0.04))
            surf.blit(refl_sq, (dst_x0 + wave_dx, wy), area=pygame.Rect(0, ry, rw, strip_h))

    def render_foreground_and_particles(self, surf: pygame.Surface, cam_x: float, cam_y: float = 0.0) -> None:
        """Render interactive swamp water ripples, splashes, rising embers & foreground frame."""
        wx_off = RENDER_W * 0.5 - cam_x
        cy = -cam_y

        # Expanding concentric water ripples
        for r in self.ripples:
            rx = int(r.x + wx_off)
            ry = int(r.y + cy)
            a = clamp_int(int(r.alpha), 0, 220)
            col = (242, 92, 108, a) if r.tinted_red else (218, 198, 184, a)
            rs = pygame.Surface((int(r.rx * 2 + 4), int(r.ry * 2 + 4)), pygame.SRCALPHA)
            pygame.draw.ellipse(rs, col, (2, 2, int(r.rx * 2), int(r.ry * 2)), 2)
            surf.blit(rs, (int(rx - r.rx - 2), int(ry - r.ry - 2)))

        # Dynamic boot-splash water droplets
        for sp in self.splashes:
            px = int(sp.x + wx_off)
            py = int(sp.y + cy)
            col = (255, 118, 134) if sp.crimson else (228, 222, 214)
            pygame.draw.circle(surf, col, (px, py), max(1, int(sp.size)))

        # Rising glowing volcanic ash embers
        for e in self.embers:
            ex = e.x + wx_off
            if -16 <= ex <= RENDER_W + 16:
                ey = e.y + cy
                a = math.sin((e.life / max(0.1, e.max_life)) * math.pi)
                col = (255, 178, 86) if e.bright else (246, 52, 68)
                pygame.draw.circle(surf, col, (int(ex), int(ey)), max(1, int(e.size)))
                if e.bright:
                    self.cg.blit_glow(surf, (ex, ey), e.size * 4.5, col, int(120 * a), additive=True)

        # Layer 6: Foreground gnarled moss branch (left) & Weeping Angel (right) (1.16x parallax)
        cam_norm = (cam_x - STAGE_CENTER_X) / float(STAGE_WORLD_W - RENDER_W)
        sx6 = int(-400 - cam_norm * 720)
        surf.blit(self.fg_frame_surf, (sx6, int(cy)))


