    def _build_sky_domes(self) -> None:
        """Generates rich painterly blood-red storm sky canvases for Prelude, Rupture, Frenzy, Eclipse."""
        w, h = 640, 260
        for key, script in LIGHTING_SCRIPTS.items():
            surf = pygame.Surface((w, h))
            top = script["sky_top"]
            mid = script["sky_mid"]
            hor = script["sky_horizon"]
            cor = script["corona"]
            # Vertical painterly gradient + diagonal storm cloud noise bands
            px = pygame.PixelArray(surf)
            for y in range(h):
                ty = y / float(h - 1)
                base_col = lerp_color(top, mid, ty * 2.0) if ty < 0.5 else lerp_color(mid, hor, (ty - 0.5) * 2.0)
                for x in range(0, w, 2):
                    nx = x * 0.014 + ty * 1.4
                    ny = y * 0.022
                    cloud = self.noise.fbm(nx, ny, 3)
                    ridge = self.noise.ridged(nx * 1.35 + 4.1, ny * 1.15, 3)
                    flare = clamp((cloud * 0.65 + ridge * 0.45) - 0.36, 0.0, 1.0)
                    col = lerp_color(base_col, cor, flare * (0.62 if key != "eclipse" else 0.78))
                    rgb_val = (col[0] << 16) | (col[1] << 8) | col[2]
                    px[x, y] = rgb_val
                    if x + 1 < w:
                        px[x + 1, y] = rgb_val
            del px

            # Paint swirling diagonal impasto storm streaks
            streak_layer = pygame.Surface((w, h), pygame.SRCALPHA)
            for si in range(22):
                sx = (si * 47) % w
                sy = 18 + (si * 29) % (h - 48)
                pts = BrushVectorRasterizer.bezier_quad(
                    (sx - 70, sy + 22), (sx, sy - 10), (sx + 85, sy - 26), 12
                )
                sc = (*cor, 34 if si % 2 == 0 else 20)
                BrushVectorRasterizer.draw_brush_stroke(streak_layer, pts, sc, 16.0, True, True, 4, si + 10)
            surf.blit(streak_layer, (0, 0))

            # Eclipsed Black Sun with Blazing Fiery Corona (left of central pagoda spire, as in art ref)
            sun_x, sun_y = int(w * 0.365), int(h * 0.145)
            corona_surf = pygame.Surface((w, h), pygame.SRCALPHA)
            for rad, alpha in ((62, 24), (44, 48), (30, 96), (22, 185), (18, 245)):
                pygame.draw.circle(corona_surf, (*cor, alpha), (sun_x, sun_y), rad)
            # Jagged eclipse corona tendrils
            for ray in range(16):
                ang = ray * (math.tau / 16.0)
                r_end = 26 + (ray % 3) * 11
                pygame.draw.line(
                    corona_surf, (*cor, 130),
                    (sun_x + int(math.cos(ang) * 15), sun_y + int(math.sin(ang) * 15)),
                    (sun_x + int(math.cos(ang) * r_end), sun_y + int(math.sin(ang) * r_end)),
                    2,
                )
            # Obsidian moon disc eclipsing the sun
            pygame.draw.circle(corona_surf, (12, 4, 8, 255), (sun_x + 2, sun_y + 1), 16)
            pygame.draw.circle(corona_surf, (255, 224, 132, 210), (sun_x, sun_y), 17, 2)
            surf.blit(corona_surf, (0, 0))

            self.sky_cache[key] = pygame.transform.smoothscale(surf, (INTERNAL_W, int(INTERNAL_H * 0.58)))

