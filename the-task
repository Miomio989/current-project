class CeciliaKeyframeIllustrator:
    """
    2x-supersampled KoF XIII / Pixiv-grade full-body keyframe sculptor.
    Every HandCraftedKeyframe plate renders genuine multi-layer volumetric CG
    shading with:
      - True 3D torso/head yaw perspective & anime facial anatomy
      - Multi-ribbon flowing high ponytail + cheek-framing sidelocks
      - High-collar scarlet jabot, ruby brooch, puffed Juliet sleeves, wide
        silver-buckled leather corset belt
      - 9-pleat dynamic 3D flared gothic-lolita tiered skirt with ruffles
      - Anatomical zettai-ryouiki thighs & glossy 5-buckle thigh-high boots
      - True 3D perspective-projected demonic rune-etched two-handed greatsword
        with thorny bat-wing crossguard, glowing crimson flame aura, and multi-
        layer kinetic slash-smear arc ribbons!
    """

    def __init__(self, cg: StudioCGRasterizer) -> None:
        self.cg = cg

    def render_keyframe(
        self,
        kf: HandCraftedKeyframe,
        pal: CeciliaCGPalette,
        facing_right: bool = True,
        overdrive: bool = False,
    ) -> pygame.Surface:
        ss = SPRITE_SSAA
        W = SPRITE_W * ss
        H = SPRITE_H * ss
        ax = SPRITE_ANCHOR_X * ss
        ay = SPRITE_ANCHOR_Y * ss
        surf = pygame.Surface((W, H), pygame.SRCALPHA)

        def to_s(pt: Pt2) -> Pt2:
            return (ax + pt[0] * ss, ay + pt[1] * ss)

        ldir = (0.66, -0.75)

        # ------------------------------------------------------------------
        # LAYER 0: ECLIPSE OVERDRIVE AURA BACKDROP (When Overdrive active)
        # ------------------------------------------------------------------
        if overdrive:
            c_pel = to_s(kf.pelvis)
            self.cg.blit_glow(surf, (c_pel[0], c_pel[1] - 32 * ss), 96 * ss, pal.aura_outer, 115, additive=True)
            self.cg.blit_glow(surf, (c_pel[0], c_pel[1] - 26 * ss), 56 * ss, pal.aura_mid, 125, additive=True)

        # ------------------------------------------------------------------
        # LAYER 1: BACK HAIR PONYTAIL RIBBONS (layer == -1)
        # ------------------------------------------------------------------
        for hr in kf.hair_ribbons:
            if hr.layer < 0:
                self._draw_hair_ribbon(surf, hr, pal, ax, ay, ss, ldir)

        # ------------------------------------------------------------------
        # LAYER 2: SWORD BEHIND BODY (blade_layer < 0)
        # ------------------------------------------------------------------
        if kf.sword.visible and kf.sword.blade_layer < 0:
            self._draw_demonic_sword_3d(surf, kf.sword, pal, ax, ay, ss, overdrive)

        # ------------------------------------------------------------------
        # LAYER 3: BACK ARM (Juliet puff + tight forearm + cuff + hand)
        # ------------------------------------------------------------------
        self._draw_arm(surf, to_s(kf.sh_b), to_s(kf.elb_b), to_s(kf.hand_b), pal, ss, ldir, is_front=False)

        # ------------------------------------------------------------------
        # LAYER 4: BACK LEG (Anatomical thigh + 5-buckle thigh-high boot)
        # ------------------------------------------------------------------
        self._draw_leg_and_boot(
            surf, to_s(kf.hip_b), to_s(kf.knee_b), to_s(kf.ankle_b), to_s(kf.toe_b),
            pal, ss, ldir, is_front=False,
        )

        # ------------------------------------------------------------------
        # LAYER 5: FRONT LEG (Anatomical thigh + glossy 5-buckle leather boot)
        # ------------------------------------------------------------------
        self._draw_leg_and_boot(
            surf, to_s(kf.hip_f), to_s(kf.knee_f), to_s(kf.ankle_f), to_s(kf.toe_f),
            pal, ss, ldir, is_front=True,
        )

        # ------------------------------------------------------------------
        # LAYER 6: DYNAMIC 3D MULTI-TIERED GOTHIC LOLITA SKIRT (9 Pleats!)
        # ------------------------------------------------------------------
        self._draw_gothic_skirt(surf, kf.skirt, kf.torso_yaw, pal, ax, ay, ss, ldir)

        # ------------------------------------------------------------------
        # LAYER 7: TAILORED BODICE, HIGH COLLAR, JABOT, RUBY BROOCH & BELT
        # ------------------------------------------------------------------
        self._draw_bodice_and_belt(surf, kf, pal, ax, ay, ss, ldir)

        # ------------------------------------------------------------------
        # LAYER 8: ANIME HEAD, EXPRESSIVE FACE, GOLDEN EYES & SIDELOCKS
        # ------------------------------------------------------------------
        self._draw_head_and_face(surf, kf, pal, ax, ay, ss, ldir)

        # ------------------------------------------------------------------
        # LAYER 9: MID & FOREGROUND HAIR RIBBONS (layer >= 0)
        # ------------------------------------------------------------------
        for hr in kf.hair_ribbons:
            if hr.layer >= 0:
                self._draw_hair_ribbon(surf, hr, pal, ax, ay, ss, ldir)

        # ------------------------------------------------------------------
        # LAYER 10: MID SWORD (blade_layer == 0) + FRONT ARM
        # ------------------------------------------------------------------
        if kf.sword.visible and kf.sword.blade_layer == 0:
            self._draw_demonic_sword_3d(surf, kf.sword, pal, ax, ay, ss, overdrive)

        self._draw_arm(surf, to_s(kf.sh_f), to_s(kf.elb_f), to_s(kf.hand_f), pal, ss, ldir, is_front=True)

        # ------------------------------------------------------------------
        # LAYER 11: FOREGROUND SWORD (blade_layer > 0) & KINETIC SLASH SMEAR!
        # ------------------------------------------------------------------
        if kf.sword.visible and kf.sword.blade_layer > 0:
            self._draw_demonic_sword_3d(surf, kf.sword, pal, ax, ay, ss, overdrive)

        if kf.slash.active and kf.slash.intensity > 0.05:
            self._draw_kinetic_slash_smear(surf, kf.slash, pal, ax, ay, ss)

        # Downsample 2x supersampled CG painting to crisp sprite resolution!
        out = pygame.transform.smoothscale(surf, (SPRITE_W, SPRITE_H))
        if not facing_right:
            out = pygame.transform.flip(out, True, False)
        return out

    def _draw_hair_ribbon(
        self,
        surf: pygame.Surface,
        hr: HairRibbonSpec,
        pal: CeciliaCGPalette,
        ax: float,
        ay: float,
        ss: float,
        ldir: Pt2,
    ) -> None:
        p0 = (ax + hr.p0[0] * ss, ay + hr.p0[1] * ss)
        p1 = (ax + hr.p1[0] * ss, ay + hr.p1[1] * ss)
        p2 = (ax + hr.p2[0] * ss, ay + hr.p2[1] * ss)
        p3 = (ax + hr.p3[0] * ss, ay + hr.p3[1] * ss)
        steps = 12
        pts = sample_cubic(p0, p1, p2, p3, steps)
        ws: List[float] = []
        for i in range(steps + 1):
            t = i / float(steps)
            w = lerp(hr.w_root, hr.w_mid, t * 2.0) if t < 0.5 else lerp(hr.w_mid, hr.w_tip, (t - 0.5) * 2.0)
            ws.append(max(0.6, w * ss))
        poly = build_tapered_ribbon_poly(pts, ws)
        is_rim = hr.layer >= 0 or hr.sheen_t > 0.25
        colors = (
            [pal.hair_dark, pal.hair_base, pal.hair_sheen]
            if hr.layer >= 0
            else [pal.hair_dark, pal.hair_base, pal.hair_sheen, pal.hair_base]
        )
        sheen_idx = clamp_int(int(hr.sheen_t * steps), 1, steps - 1)
        spec_pt = pts[sheen_idx]
        self.cg.fill_shaded_poly(
            surf, poly, colors,
            light_dir=ldir,
            spec_pos=spec_pt,
            spec_color=pal.hair_spec,
            spec_radius=max(6.0, hr.w_mid * 2.4 * ss),
            spec_alpha=46 if hr.layer >= 0 else 30,
            rim_color=pal.hair_rim if is_rim else None,
            rim_width=1.4 * ss,
            ink_color=pal.hair_dark,
            ink_width=1.3 * ss,
        )

    def _draw_leg_and_boot(
        self,
        surf: pygame.Surface,
        hip: Pt2,
        knee: Pt2,
        ankle: Pt2,
        toe: Pt2,
        pal: CeciliaCGPalette,
        ss: float,
        ldir: Pt2,
        is_front: bool,
    ) -> None:
        # 1. Anatomical porcelain thigh (Zettai Ryouiki!) from hip down to upper boot cuff (68% to knee)
        cuff_pt = v_lerp(hip, knee, 0.72)
        thigh_poly = build_anatomical_limb(
            hip, v_lerp(hip, knee, 0.82),
            10.2 * ss, 9.4 * ss,
            9.6 * ss, 8.6 * ss,
            7.4 * ss, 6.8 * ss,
            mid_t=0.42, steps=8,
        )
        skin_cols = (
            [pal.skin_shadow, pal.skin_mid, pal.skin_base, pal.skin_hi]
            if is_front
            else [scale_rgb(pal.skin_shadow, 0.85), pal.skin_shadow, pal.skin_mid, pal.skin_base]
        )
        self.cg.fill_shaded_poly(
            surf, thigh_poly, skin_cols,
            light_dir=ldir,
            spec_pos=v_lerp(hip, knee, 0.45),
            spec_color=pal.skin_hi,
            spec_radius=12 * ss,
            spec_alpha=58 if is_front else 24,
            ink_color=pal.skin_ink,
            ink_width=1.25 * ss,
        )

        # 2. Thigh-high glossy black leather boot upper (above-knee cuff -> knee)
        boot_up = build_anatomical_limb(
            cuff_pt, knee,
            8.2 * ss, 7.6 * ss,
            7.9 * ss, 7.2 * ss,
            7.2 * ss, 6.6 * ss,
            mid_t=0.5, steps=6,
        )
        boot_cols = (
            [pal.leather_sh, pal.leather_sh, pal.leather_base, lerp_rgb(pal.leather_base, pal.leather_spec, 0.45)]
            if is_front
            else [pal.leather_sh, pal.leather_sh, scale_rgb(pal.leather_base, 0.78)]
        )
        self.cg.fill_shaded_poly(
            surf, boot_up, boot_cols,
            light_dir=ldir,
            spec_pos=v_lerp(cuff_pt, knee, 0.5),
            spec_color=pal.leather_spec,
            spec_radius=11 * ss,
            spec_alpha=90 if is_front else 42,
            ink_color=pal.leather_sh,
            ink_width=1.35 * ss,
        )

        # 3. Sculpted leather calf (graceful feminine calf taper from knee -> slim ankle!)
        calf_poly = build_anatomical_limb(
            knee, ankle,
            7.1 * ss, 6.8 * ss,
            7.5 * ss, 6.2 * ss,   # Distinct anatomical calf swell on back, crisp shin front!
            4.5 * ss, 4.2 * ss,
            mid_t=0.38, steps=9,
        )
        self.cg.fill_shaded_poly(
            surf, calf_poly, boot_cols,
            light_dir=ldir,
            spec_pos=v_lerp(knee, ankle, 0.40),
            spec_color=pal.leather_spec,
            spec_radius=13 * ss,
            spec_alpha=105 if is_front else 52,
            rim_color=pal.hair_rim if is_front else None,
            rim_width=1.1 * ss,
            ink_color=pal.leather_sh,
            ink_width=1.4 * ss,
        )

        # 4. Gothic heeled leather boot foot & sculpted block heel!
        ft_dir = v_norm(v_sub(toe, ankle))
        ft_nrm = (-ft_dir[1], ft_dir[0])
        if ft_nrm[1] > 0:
            ft_nrm = (-ft_nrm[0], -ft_nrm[1])
        heel_back = (ankle[0] - ft_dir[0] * 5.2 * ss, ankle[1] + 5.8 * ss)
        heel_tip = (ankle[0] - ft_dir[0] * 4.2 * ss, toe[1] + 1.5 * ss)
        heel_in = (ankle[0] + ft_dir[0] * 0.8 * ss, toe[1] + 1.5 * ss)
        arch = (lerp(ankle[0], toe[0], 0.45), toe[1] - 1.0 * ss)
        sole_front = (toe[0] + ft_dir[0] * 3.0 * ss, toe[1] + 1.2 * ss)
        toe_top = (toe[0] + ft_dir[0] * 2.2 * ss + ft_nrm[0] * 4.4 * ss, toe[1] + ft_nrm[1] * 4.4 * ss)
        instep = (ankle[0] + ft_dir[0] * 4.8 * ss + ft_nrm[0] * 5.8 * ss, ankle[1] + ft_nrm[1] * 5.8 * ss)

        foot_poly = [heel_back, heel_tip, heel_in, arch, sole_front, toe_top, instep]
        self.cg.fill_shaded_poly(
            surf, foot_poly, boot_cols,
            light_dir=ldir,
            spec_pos=instep, spec_color=pal.leather_spec, spec_radius=9 * ss, spec_alpha=95,
            ink_color=pal.leather_sh, ink_width=1.4 * ss,
        )

        # 5. Five Iconic Wrapped Leather Straps + Gleaming Silver Rectangular Buckles (char.jpg!)
        strap_specs = [
            (v_lerp(cuff_pt, knee, 0.22), v_norm(v_sub(knee, cuff_pt)), 8.1 * ss),
            (v_lerp(knee, ankle, 0.20), v_norm(v_sub(ankle, knee)), 7.5 * ss),
            (v_lerp(knee, ankle, 0.40), v_norm(v_sub(ankle, knee)), 7.2 * ss),
            (v_lerp(knee, ankle, 0.60), v_norm(v_sub(ankle, knee)), 6.1 * ss),
            (v_lerp(knee, ankle, 0.80), v_norm(v_sub(ankle, knee)), 5.0 * ss),
        ]
        for sp, tang, hw in strap_specs:
            nrm = (-tang[1], tang[0])
            s_a = (sp[0] - nrm[0] * hw, sp[1] - nrm[1] * hw)
            s_b = (sp[0] + nrm[0] * hw, sp[1] + nrm[1] * hw)
            pygame.draw.line(surf, pal.leather_sh, s_a, s_b, max(1, int(1.9 * ss)))
            pygame.draw.line(surf, pal.leather_base, (s_a[0], s_a[1] - ss * 0.5), (s_b[0], s_b[1] - ss * 0.5), max(1, int(0.8 * ss)))
            # Silver rectangular buckle nestled cleanly on outer leg face!
            bx = sp[0] + nrm[0] * (hw * 0.34 if is_front else -hw * 0.24)
            by = sp[1] + nrm[1] * (hw * 0.34 if is_front else -hw * 0.24)
            bw = 2.0 * ss
            bh = 1.6 * ss
            brect = [
                (bx - nrm[0] * bw - tang[0] * bh, by - nrm[1] * bw - tang[1] * bh),
                (bx + nrm[0] * bw - tang[0] * bh, by + nrm[1] * bw - tang[1] * bh),
                (bx + nrm[0] * bw + tang[0] * bh, by + nrm[1] * bw + tang[1] * bh),
                (bx - nrm[0] * bw + tang[0] * bh, by - nrm[1] * bw + tang[1] * bh),
            ]
            pygame.draw.polygon(surf, pal.metal_mid, brect)
            pygame.draw.aalines(surf, pal.metal_hi, True, brect)

    def _draw_gothic_skirt(
        self,
        surf: pygame.Surface,
        sk: SkirtPleatArc,
        torso_yaw: float,
        pal: CeciliaCGPalette,
        ax: float,
        ay: float,
        ss: float,
        ldir: Pt2,
    ) -> None:
        wx = ax + sk.waist_x * ss
        wy = ay + sk.waist_y * ss
        ww = sk.waist_w * ss
        hx_c = wx + sk.hem_dx * ss
        hy_c = ay + sk.hem_y * ss
        fl_l = sk.flare_l * ss
        fl_r = sk.flare_r * ss
        bl_l = sk.billow_l * ss
        bl_r = sk.billow_r * ss

        # 1. Dark inner petticoat underside lining (gives rich 3D depth under skirt!)
        under_pts = [
            (wx - ww * 0.85, wy + 2 * ss),
            (wx + ww * 0.85, wy + 2 * ss),
            (hx_c + fl_r * 0.94, hy_c + 5 * ss - sk.ruffle_lift * ss),
            (hx_c, hy_c + 10 * ss),
            (hx_c - fl_l * 0.94, hy_c + 5 * ss - sk.ruffle_lift * ss),
        ]
        pygame.draw.polygon(surf, (10, 6, 14, 245), under_pts)

        # 2. Lower vibrant Scarlet Silk pleated ruffle tier (peek beneath black skirt!)
        n_pleats = 9
        hem_pts_low: List[Pt2] = []
        hem_pts_mid: List[Pt2] = []
        hem_pts_up: List[Pt2] = []
        waist_pts: List[Pt2] = []

        for i in range(n_pleats + 1):
            u = i / float(n_pleats)  # 0.0 (left) -> 1.0 (right)
            su = u * 2.0 - 1.0       # -1.0 -> +1.0
            # Waist anchor along subtle curved arc
            wpx = wx + su * ww
            wpy = wy + (1.0 - su * su) * 2.4 * ss
            waist_pts.append((wpx, wpy))

            # Hem position with organic 3D arc + dynamic wind billow + pleat wave!
            wave = math.sin(u * math.pi * 6.0 + sk.twist_phase) * 2.6 * ss
            hx = hx_c + (su * fl_r if su >= 0 else su * fl_l) + (bl_r * u + bl_l * (1.0 - u)) * 0.35
            arch_drop = (1.0 - su * su) * 9.5 * ss - abs(su) * sk.ruffle_lift * ss
            hy_low = hy_c + arch_drop + wave
            hem_pts_low.append((hx, hy_low))
            hem_pts_mid.append((lerp(wpx, hx, 0.84), lerp(wpy, hy_low, 0.84) - 1.5 * ss))
            hem_pts_up.append((lerp(wpx, hx, 0.68), lerp(wpy, hy_low, 0.68) - 1.0 * ss))

        # Draw bottom black scalloped lace trim fringe below scarlet tier
        lace_bot = [(p[0], p[1] + 3.6 * ss + (2.0 * ss if i % 2 == 0 else 0.0)) for i, p in enumerate(hem_pts_low)]
        lace_poly = hem_pts_mid + list(reversed(lace_bot))
        self.cg.fill_shaded_poly(
            surf, lace_poly,
            [pal.dress_black_sh, pal.dress_black_base, pal.dress_black_hi],
            light_dir=ldir, ink_color=pal.dress_black_sh, ink_width=1.2 * ss,
        )

        # Draw bold crimson lower pleated tier (char.jpg!)
        red_tier_poly = hem_pts_up + list(reversed(hem_pts_low))
        self.cg.fill_shaded_poly(
            surf, red_tier_poly,
            [pal.dress_red_sh, pal.dress_red_base, pal.dress_red_hi],
            light_dir=ldir,
            spec_pos=hem_pts_mid[min(n_pleats - 1, int(n_pleats * 0.62))],
            spec_color=pal.dress_red_hi,
            spec_radius=20 * ss, spec_alpha=95,
            ink_color=pal.dress_red_sh, ink_width=1.2 * ss,
        )

        # Draw individual 3D pleated upper skirt panels (obsidian velvet + scarlet center gore!)
        red_center_u = clamp(0.55 + sk.red_panel_shift + torso_yaw * 0.16, 0.18, 0.84)
        for i in range(n_pleats):
            u_mid = (i + 0.5) / float(n_pleats)
            is_red_panel = abs(u_mid - red_center_u) < 0.14
            # Curved pleat side edges for genuine flowing silk/velvet drape!
            w0, w1 = waist_pts[i], waist_pts[i + 1]
            m0, m1 = hem_pts_mid[i], hem_pts_mid[i + 1]
            c0 = (lerp(w0[0], m0[0], 0.5) + (bl_l if u_mid < 0.5 else bl_r) * 0.16, lerp(w0[1], m0[1], 0.5))
            c1 = (lerp(w1[0], m1[0], 0.5) + (bl_l if u_mid < 0.5 else bl_r) * 0.16, lerp(w1[1], m1[1], 0.5))
            s_left = sample_quad(w0, c0, m0, 5)
            s_right = sample_quad(w1, c1, m1, 5)
            pleat_poly = s_left + list(reversed(s_right))

            if is_red_panel:
                cols = [pal.dress_red_sh, pal.dress_red_base, pal.dress_red_hi]
                ink = pal.dress_red_sh
            else:
                shade_k = 0.82 if i % 2 == 0 else 1.0
                cols = [
                    pal.dress_black_sh,
                    scale_rgb(pal.dress_black_base, shade_k),
                    scale_rgb(pal.dress_black_hi, shade_k),
                ]
                ink = pal.dress_black_sh

            self.cg.fill_shaded_poly(
                surf, pleat_poly, cols,
                light_dir=ldir,
                rim_color=pal.hair_rim if i == n_pleats - 1 else None,
                rim_width=1.4 * ss,
                ink_color=ink, ink_width=1.15 * ss,
            )

        # Flowing scalloped crimson lace ruffle ribbon along upper skirt tier (char.jpg!)
        ruf_top: List[Pt2] = []
        ruf_bot: List[Pt2] = []
        for i in range(n_pleats * 2 + 1):
            idx_f = i * 0.5
            i0 = min(n_pleats - 1, int(idx_f))
            frac = idx_f - i0
            pt = v_lerp(hem_pts_up[i0], hem_pts_up[i0 + 1], frac)
            scallop = (2.6 * ss) if (i % 2 == 1) else (0.4 * ss)
            ruf_top.append((pt[0], pt[1] - 2.2 * ss))
            ruf_bot.append((pt[0], pt[1] + 2.2 * ss + scallop))
        ruf_poly = ruf_top + list(reversed(ruf_bot))
        self.cg.fill_shaded_poly(
            surf, ruf_poly,
            [pal.dress_red_sh, pal.dress_red_base, pal.dress_red_hi],
            light_dir=ldir, ink_color=pal.dress_red_sh, ink_width=0.95 * ss,
        )

    def _draw_bodice_and_belt(
        self,
        surf: pygame.Surface,
        kf: HandCraftedKeyframe,
        pal: CeciliaCGPalette,
        ax: float,
        ay: float,
        ss: float,
        ldir: Pt2,
    ) -> None:
        waist = (ax + kf.waist[0] * ss, ay + kf.waist[1] * ss)
        chest = (ax + kf.chest[0] * ss, ay + kf.chest[1] * ss)
        neck = (ax + kf.neck[0] * ss, ay + kf.neck[1] * ss)
        sh_b = (ax + kf.sh_b[0] * ss, ay + kf.sh_b[1] * ss)
        sh_f = (ax + kf.sh_f[0] * ss, ay + kf.sh_f[1] * ss)

        spine = v_norm(v_sub(chest, waist))
        right = (-spine[1], spine[0])
        if right[0] < 0:
            right = (-right[0], -right[1])

        # Hourglass tailored black velvet bodice contour
        w_hw = (9.8 - abs(kf.torso_yaw) * 1.4) * ss
        c_hw = (13.4 - abs(kf.torso_yaw) * 1.8) * ss
        w_l = (waist[0] - right[0] * w_hw, waist[1] - right[1] * w_hw)
        w_r = (waist[0] + right[0] * w_hw, waist[1] + right[1] * w_hw)
        c_l = (chest[0] - right[0] * c_hw, chest[1] - right[1] * c_hw)
        c_r = (chest[0] + right[0] * c_hw, chest[1] + right[1] * c_hw)

        side_l = sample_quad(w_l, v_lerp(w_l, c_l, 0.45), sh_b, 6)
        side_r = sample_quad(sh_f, v_lerp(w_r, c_r, 0.55), w_r, 6)
        bodice_poly = side_l + [neck] + side_r
        self.cg.fill_shaded_poly(
            surf, bodice_poly,
            [pal.dress_black_sh, pal.dress_black_base, pal.dress_black_hi],
            light_dir=ldir,
            spec_pos=v_lerp(chest, sh_f, 0.35),
            spec_color=pal.dress_black_hi, spec_radius=14 * ss, spec_alpha=105,
            rim_color=pal.hair_rim, rim_width=1.4 * ss,
            ink_color=pal.dress_black_sh, ink_width=1.5 * ss,
        )

        # Vertical crimson pleated corset bib front (shifts smoothly with 3D torso_yaw!)
        bib_shift = clamp(kf.torso_yaw * 4.2 + 2.2, -5.5, 6.2) * ss
        bib_hw_t = 4.6 * ss
        bib_hw_b = 3.2 * ss
        b_top = (chest[0] + right[0] * bib_shift, chest[1] + right[1] * bib_shift - 2 * ss)
        b_bot = (waist[0] + right[0] * bib_shift * 0.78, waist[1] + right[1] * bib_shift * 0.78)
        bib_poly = [
            (b_top[0] - right[0] * bib_hw_t, b_top[1] - right[1] * bib_hw_t),
            (b_top[0] + right[0] * bib_hw_t, b_top[1] + right[1] * bib_hw_t),
            (b_bot[0] + right[0] * bib_hw_b, b_bot[1] + right[1] * bib_hw_b),
            (b_bot[0] - right[0] * bib_hw_b, b_bot[1] - right[1] * bib_hw_b),
        ]
        self.cg.fill_shaded_poly(
            surf, bib_poly,
            [pal.dress_red_sh, pal.dress_red_base, pal.dress_red_hi],
            light_dir=ldir, ink_color=pal.dress_red_sh, ink_width=1.0 * ss,
        )

        # High black gothic collar + crimson jabot + glowing ruby brooch!
        col_w = 5.6 * ss
        col_h = 5.4 * ss
        col_poly = [
            (neck[0] - right[0] * col_w, neck[1] - col_h * 0.4),
            (neck[0] + right[0] * col_w, neck[1] - col_h * 0.4),
            (neck[0] + right[0] * (col_w + 1.2 * ss), neck[1] + col_h * 0.7),
