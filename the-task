        # 3. Flared crimson ruffled wrist cuff
        fa_dir = (wr - el).normalized()
        fa_nrm = fa_dir.perp()
        cuff_base = wr - fa_dir * (3.5 * s)
        cuff_poly = [
            (cuff_base.x - fa_nrm.x * 4.5 * s, cuff_base.y - fa_nrm.y * 4.5 * s),
            (cuff_base.x + fa_nrm.x * 4.5 * s, cuff_base.y + fa_nrm.y * 4.5 * s),
            (wr.x + fa_dir.x * 2.5 * s + fa_nrm.x * 7.8 * s, wr.y + fa_dir.y * 2.5 * s + fa_nrm.y * 7.8 * s),
            (wr.x + fa_dir.x * 4.2 * s, wr.y + fa_dir.y * 4.2 * s),
            (wr.x + fa_dir.x * 2.5 * s - fa_nrm.x * 7.8 * s, wr.y + fa_dir.y * 2.5 * s - fa_nrm.y * 7.8 * s),
