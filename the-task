    def __init__(self, fonts: FontManager, bank: SpriteBank, stage: CursedCathedralStage) -> None:
        self.fonts = fonts
        self.bank = bank
        self.stage = stage
        self.tab_idx: int = 0
        self.row_idx: int = 0
        self.preview_tick: int = 0
        self.return_to_pause: bool = False

    def _get_tab_moves(self) -> List[MoveSpec]:
        if self.tab_idx == 0:
            states = [
                FighterState.ATTACK_5L, FighterState.ATTACK_5M, FighterState.ATTACK_5H,
                FighterState.ATTACK_5C, FighterState.ATTACK_2L, FighterState.ATTACK_2M, FighterState.ATTACK_2H,
            ]
        elif self.tab_idx == 1:
            states = [
                FighterState.ATTACK_6M, FighterState.THROW_START,
                FighterState.ATTACK_JL, FighterState.ATTACK_JM, FighterState.ATTACK_JH,
            ]
        elif self.tab_idx == 2:
            states = [
                FighterState.SPECIAL_CRESCENT_WAVE, FighterState.SPECIAL_ABYSS_ASCENSION,
                FighterState.SPECIAL_PHANTOM_REKKA_1, FighterState.SPECIAL_PHANTOM_REKKA_2,
                FighterState.SPECIAL_PHANTOM_REKKA_3, FighterState.SPECIAL_CURSED_PARRY,
                FighterState.SPECIAL_PARRY_COUNTER, FighterState.SPECIAL_SHADOW_STEP,
            ]
        elif self.tab_idx == 3:
            states = [
                FighterState.OVERDRIVE_ACTIVATE,
                FighterState.SUPER_ECLIPSE_REQUIEM,
                FighterState.FATAL_CRIMSON_JUDGMENT,
            ]
        else:
            return []
        return [MOVE_REGISTRY[s] for s in states if s in MOVE_REGISTRY]

    def handle_key(self, key: int, audio: AudioManager) -> Optional[str]:
        if key in (pygame.K_LEFT, pygame.K_a):
            self.tab_idx = (self.tab_idx - 1) % len(self.TABS)
            self.row_idx = 0
            self.preview_tick = 0
            audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)
        elif key in (pygame.K_RIGHT, pygame.K_d):
            self.tab_idx = (self.tab_idx + 1) % len(self.TABS)
            self.row_idx = 0
            self.preview_tick = 0
            audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)
        elif key in (pygame.K_UP, pygame.K_w):
            count = len(self.MECHANICS_DOCS) if self.tab_idx == 4 else len(self._get_tab_moves())
            if count > 0:
                self.row_idx = (self.row_idx - 1) % count
                self.preview_tick = 0
                audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.75)
        elif key in (pygame.K_DOWN, pygame.K_s):
            count = len(self.MECHANICS_DOCS) if self.tab_idx == 4 else len(self._get_tab_moves())
            if count > 0:
                self.row_idx = (self.row_idx + 1) % count
                self.preview_tick = 0
                audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.75)
        elif key in (pygame.K_ESCAPE, pygame.K_BACKSPACE):
            audio.play_sfx(SFXId.UI_CANCEL, vol_scale=0.8)
            return "CLOSE"
        return None

