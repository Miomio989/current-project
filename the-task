@dataclass
class AIProfile:
    reaction_frames: int
    block_rate: float
    just_guard_rate: float
    parry_rate: float
    anti_air_rate: float
    combo_depth: int
    aggression: float
    zoning: float
    super_rate: float
    decision_interval: int


AI_PROFILES: Dict[AIDifficulty, AIProfile] = {
    AIDifficulty.NOVICE: AIProfile(22, 0.28, 0.04, 0.04, 0.16, 2, 0.36, 0.28, 0.18, 22),
    AIDifficulty.ADEPT: AIProfile(15, 0.48, 0.10, 0.10, 0.36, 3, 0.50, 0.40, 0.34, 15),
    AIDifficulty.HUNTER: AIProfile(10, 0.66, 0.18, 0.18, 0.56, 4, 0.62, 0.48, 0.52, 10),
    AIDifficulty.NIGHTMARE: AIProfile(6, 0.80, 0.28, 0.28, 0.74, 5, 0.74, 0.56, 0.68, 7),
    AIDifficulty.ABYSSAL: AIProfile(3, 0.90, 0.40, 0.38, 0.88, 6, 0.84, 0.64, 0.82, 5),
}


@dataclass
class QueuedAIAction:
    frames_left: int
    rel_dx: int       # Facing-relative: +1 fwd, -1 back, 0 neutral
    raw_dy: int       # -1 up, +1 down, 0 neutral
    buttons: InputButton
    direct_state: Optional[FighterState] = None
    is_ex: bool = False


class ShadowCeciliaAI:
    """Tactical fighting-game AI with footsies, hit-confirm combos, anti-airs,
    Blood Moon Wave zoning, Darkmoon Counter parries, and Resonance awakenings.
    """

    def __init__(
        self,
        difficulty: AIDifficulty = AIDifficulty.HUNTER,
        persona: Optional[RivalPersona] = None,
    ) -> None:
        self.difficulty = difficulty
        self.persona = persona
        self.profile = self._build_profile()
        self.rng = random.Random(int(time.time() * 1000) & 0xFFFF)
        self.decision_cd: int = 0
        self.block_hold_timer: int = 0
        self.block_crouch: bool = False
        self.action_queue: Deque[QueuedAIAction] = collections.deque()
        self.move_intent_dx: int = 0
        self.move_intent_timer: int = 0
        self.wants_direct_state: Optional[Tuple[FighterState, bool]] = None

    def _build_profile(self) -> AIProfile:
        base = AI_PROFILES[self.difficulty]
        if self.persona is None:
            return base
        return AIProfile(
            reaction_frames=base.reaction_frames,
            block_rate=base.block_rate,
            just_guard_rate=base.just_guard_rate,
            parry_rate=clamp(self.persona.ai_parry_rate, 0.04, 0.50),
            anti_air_rate=base.anti_air_rate,
            combo_depth=base.combo_depth,
            aggression=clamp(self.persona.ai_aggression, 0.30, 0.92),
            zoning=clamp(self.persona.ai_zoning, 0.25, 0.80),
            super_rate=base.super_rate,
            decision_interval=base.decision_interval,
        )

    def reset(self) -> None:
        self.decision_cd = 12
        self.block_hold_timer = 0
        self.block_crouch = False
        self.action_queue.clear()
        self.move_intent_dx = 0
        self.move_intent_timer = 0
        self.wants_direct_state = None

    def compute_frame_input(
        self,
        me: Fighter,
        opp: Fighter,
        projectiles: Sequence[BloodMoonProjectile],
    ) -> Tuple[int, int, InputButton, Optional[Tuple[FighterState, bool]]]:
        """Return (raw_dx, raw_dy, held_buttons, optional_direct_special_command)."""
        self.wants_direct_state = None
        if not me.alive or me.in_throw_lock:
            return (0, 0, InputButton.NONE, None)

        face_sign = 1 if me.facing_right else -1
        dist_x = abs(opp.x - me.x)

        # 1. Execute queued multi-hit combo / cancel steps first!
        if self.action_queue:
            top = self.action_queue[0]
            top.frames_left -= 1
            raw_dx = top.rel_dx * face_sign
            raw_dy = top.raw_dy
            btns = top.buttons
            direct = (top.direct_state, top.is_ex) if top.direct_state is not None else None
            if top.frames_left <= 0:
                self.action_queue.popleft()
            return (raw_dx, raw_dy, btns, direct)

        # 2. Active combo hit-confirm follow-up while attacking!
        if me.is_attacking and me.move_has_connected:
            follow = self._choose_combo_extension(me, opp, dist_x)
            if follow is not None:
                return follow

        # 3. Wakeup reversal or roll defense
        if me.state == FighterState.KNOCKDOWN and me.knockdown_timer == 6:
            if self.rng.random() < 0.45:
                rel = -1 if self.rng.random() < 0.65 else 1
                return (rel * face_sign, 0, InputButton.NONE, None)

        # 4. Active Blocking sustain
        if self.block_hold_timer > 0:
            self.block_hold_timer -= 1
            dy = 1 if self.block_crouch else 0
            return (-face_sign, dy, InputButton.NONE, None)

        # 5. Incoming Projectile Defense / Eclipse Blink
        for pr in projectiles:
            if pr.owner_idx == me.player_idx:
                continue
            p_dist = abs(pr.x - me.x)
            approaching = (pr.vx > 0 and pr.x < me.x) or (pr.vx < 0 and pr.x > me.x)
            if approaching and p_dist < 250.0 and me.grounded:
                r = self.rng.random()
                if r < self.profile.parry_rate * 0.7 and me.is_neutral_movable:
                    return (0, 0, InputButton.NONE, (FighterState.SPECIAL_SHADOW_STEP, False))
                if r < self.profile.block_rate:
                    self.block_hold_timer = 14
                    self.block_crouch = False
                    return (-face_sign, 0, InputButton.NONE, None)
                if r < self.profile.block_rate + 0.14 and p_dist > 110.0:
                    return (face_sign, -1, InputButton.NONE, None)

        # 6. Incoming Enemy Strike Threat Evaluation (Block / Just Guard / Parry!)
        opp_spec = opp.current_move
        if opp_spec is not None and dist_x < 245.0 and me.is_neutral_movable:
            frames_to_hit = opp_spec.startup - opp.state_tick
            if 0 <= frames_to_hit <= max(4, 16 - self.profile.reaction_frames // 2):
                r = self.rng.random()
                # Darkmoon Counter Parry instinct on heavy predictable swings!
                if (
                    opp_spec.attack_level.value >= AttackLevel.MEDIUM.value
                    and opp_spec.hit_height != HitHeight.THROW
                    and r < self.profile.parry_rate * 0.45
                ):
                    return (0, 0, InputButton.NONE, (FighterState.SPECIAL_CURSED_PARRY, False))
                # Invincible Valhalla Ruin reversal against aggressive pressure
                if dist_x < 135.0 and r < self.profile.parry_rate * 0.25 and me.hp < me.max_hp * 0.65:
                    return (0, 0, InputButton.NONE, (FighterState.SPECIAL_ABYSS_ASCENSION, me.super_meter >= 100.0))
                # Guard (with accurate High/Low recognition on higher difficulties!)
                if r < self.profile.block_rate:
                    smart_guard = self.rng.random() < (0.45 + self.difficulty.value * 0.11)
                    if opp_spec.hit_height == HitHeight.LOW:
                        self.block_crouch = smart_guard
                    elif opp_spec.hit_height == HitHeight.OVERHEAD:
                        self.block_crouch = not smart_guard
                    else:
                        self.block_crouch = self.rng.random() < 0.35
                    # Time back-hold crisply for Just Guard on higher tiers
                    if self.rng.random() < self.profile.just_guard_rate and frames_to_hit > 3:
                        return (0, 0, InputButton.NONE, None)
                    self.block_hold_timer = clamp_int(opp_spec.active + 10, 8, 22)
                    return (-face_sign, 1 if self.block_crouch else 0, InputButton.NONE, None)

        # 7. Anti-Air Intercept against jumping opponent!
        if not opp.grounded and opp.y < GROUND_Y - 55.0 and dist_x < 185.0 and me.is_neutral_movable:
            if self.rng.random() < self.profile.anti_air_rate * 0.28:
                if self.rng.random() < 0.55:
                    return (0, 0, InputButton.NONE, (FighterState.SPECIAL_ABYSS_ASCENSION, False))
                return (0, 1, InputButton.H, None)

        # 8. Aerial attack execution when AI is airborne
        if not me.grounded and me.is_air_movable and dist_x < 170.0 and me.vy > -4.0:
            r = self.rng.random()
            if r < 0.14:
                btn = self.rng.choice([InputButton.L, InputButton.M, InputButton.H])
                return (0, 0, btn, None)

        # 9. Periodic Neutral / Footsies / Offense Decision Tick
        if self.decision_cd > 0:
            self.decision_cd -= 1
        elif me.is_neutral_movable:
            self.decision_cd = self.rng.randint(
                max(3, self.profile.decision_interval - 3),
                self.profile.decision_interval + 6,
            )
            chosen = self._decide_neutral_action(me, opp, dist_x)
            if chosen is not None:
                return chosen

        # Continue smooth footsies movement intention
        if self.move_intent_timer > 0:
            self.move_intent_timer -= 1
            return (self.move_intent_dx * face_sign, 0, InputButton.NONE, None)
        return (0, 0, InputButton.NONE, None)

    def _choose_combo_extension(
        self, me: Fighter, opp: Fighter, dist_x: float
    ) -> Optional[Tuple[int, int, InputButton, Optional[Tuple[FighterState, bool]]]]:
        if me.combo_count >= self.profile.combo_depth + 2:
            return None
        r = self.rng.random()
        # Lethal Crimson Judgment execution confirm when 200% meter & opp low!
        if (
            me.super_meter >= 200.0
            and opp.hp < opp.max_hp * 0.45
            and me.can_cancel_into(FighterState.FATAL_CRIMSON_JUDGMENT)
            and r < self.profile.super_rate * 0.55
        ):
            return (0, 0, InputButton.NONE, (FighterState.FATAL_CRIMSON_JUDGMENT, False))

        # Eclipse Requiem Super Art confirm!
        if (
            me.super_meter >= 100.0
            and me.combo_count >= 2
            and me.can_cancel_into(FighterState.SUPER_ECLIPSE_REQUIEM)
            and r < self.profile.super_rate * 0.45
        ):
            return (0, 0, InputButton.NONE, (FighterState.SUPER_ECLIPSE_REQUIEM, False))

        # Rekka chain continuation: Nightmare Waltz I -> II -> III
        if me.state == FighterState.SPECIAL_PHANTOM_REKKA_1 and r < 0.72:
            return (0, 0, InputButton.NONE, (FighterState.SPECIAL_PHANTOM_REKKA_2, False))
        if me.state == FighterState.SPECIAL_PHANTOM_REKKA_2 and r < 0.68:
            return (0, 0, InputButton.NONE, (FighterState.SPECIAL_PHANTOM_REKKA_3, False))

        # Normal Gatling routing
        if me.state in (FighterState.ATTACK_5L, FighterState.ATTACK_2L) and r < 0.65:
            nxt = self.rng.choice([FighterState.ATTACK_5M, FighterState.ATTACK_2M])
            return (0, 0, InputButton.NONE, (nxt, False))

        if me.state == FighterState.ATTACK_5M and r < 0.62:
            options: List[FighterState] = [
                FighterState.ATTACK_2H,
                FighterState.ATTACK_5C,
                FighterState.SPECIAL_PHANTOM_REKKA_1,
                FighterState.ATTACK_5H,
            ]
            nxt = self.rng.choice(options)
            return (0, 0, InputButton.NONE, (nxt, me.super_meter >= 150.0 and self.rng.random() < 0.25))

        if me.state == FighterState.ATTACK_2M and r < 0.55:
            return (0, 0, InputButton.NONE, (FighterState.SPECIAL_CRESCENT_WAVE, me.super_meter >= 150.0 and self.rng.random() < 0.3))

        if me.state == FighterState.ATTACK_2H and r < 0.55:
            # Jump cancel into air rave!
            face_sign = 1 if me.facing_right else -1
            self.action_queue.append(QueuedAIAction(8, 1, -1, InputButton.NONE))
            self.action_queue.append(QueuedAIAction(4, 0, 0, InputButton.M))
            self.action_queue.append(QueuedAIAction(6, 0, 0, InputButton.H))
            return (face_sign, -1, InputButton.NONE, None)

        if me.state == FighterState.ATTACK_5C and dist_x < 175.0 and r < 0.50:
            return (0, 0, InputButton.NONE, (FighterState.SPECIAL_ABYSS_ASCENSION, False))

        return None

    def _decide_neutral_action(
        self, me: Fighter, opp: Fighter, dist_x: float
    ) -> Optional[Tuple[int, int, InputButton, Optional[Tuple[FighterState, bool]]]]:
        face_sign = 1 if me.facing_right else -1
        r = self.rng.random()

        # Activate Cursed Resonance when full and pressured or ready to dominate!
        if me.resonance_gauge >= MAX_RESONANCE and not me.resonance_active:
            if (me.hp < me.max_hp * 0.60 or dist_x < 220.0) and r < 0.38:
                return (0, 0, InputButton.NONE, (FighterState.OVERDRIVE_ACTIVATE, False))

        # Point-blank range (< 115px): Fast 5L / 2L / Throw / 6M Overhead / Backstep
        if dist_x < 115.0:
            if r < 0.22 * self.profile.aggression:
                return (0, 0, InputButton.L, None)
            if r < 0.40 * self.profile.aggression:
                return (0, 1, InputButton.L, None)
            if r < 0.54 * self.profile.aggression:
                return (0, 0, InputButton.NONE, (FighterState.THROW_START, False))
            if r < 0.68 * self.profile.aggression:
                return (0, 0, InputButton.NONE, (FighterState.ATTACK_6M, False))
            if r < 0.78:
                return (0, 0, InputButton.NONE, (FighterState.SPECIAL_PHANTOM_REKKA_1, False))
            # Create space with crisp backstep
            self.move_intent_dx = -1
            self.move_intent_timer = 14
            return (-face_sign, 0, InputButton.DASH, None)

        # Footsies / Mid Sword Range (115..235px): 5M, 2M, 5C, 5H whiff punish, Rekka
        if dist_x < 235.0:
            if r < 0.26 * self.profile.aggression:
                return (0, 0, InputButton.M, None)
            if r < 0.44 * self.profile.aggression:
                return (0, 1, InputButton.M, None)
            if r < 0.60 * self.profile.aggression:
                return (0, 0, InputButton.C, None)
            if r < 0.72 * self.profile.aggression:
                return (0, 0, InputButton.H, None)
            if r < 0.84 * self.profile.aggression:
                return (0, 0, InputButton.NONE, (FighterState.SPECIAL_PHANTOM_REKKA_1, False))
            if r < 0.90:
                # Forward hop jump-in
                return (face_sign, -1, InputButton.NONE, None)
            self.move_intent_dx = 1 if self.rng.random() < 0.58 else -1
            self.move_intent_timer = self.rng.randint(10, 22)
            return (self.move_intent_dx * face_sign, 0, InputButton.NONE, None)

        # Long Range (>= 235px): Blood Moon Wave zoning, Eclipse Blink gap-close, Dash Sprint
        if r < 0.34 * self.profile.zoning:
            use_ex = me.super_meter >= 150.0 and self.rng.random() < 0.35
            return (0, 0, InputButton.NONE, (FighterState.SPECIAL_CRESCENT_WAVE, use_ex))
        if r < 0.54 * self.profile.aggression:
            return (0, 0, InputButton.NONE, (FighterState.SPECIAL_SHADOW_STEP, False))
        if r < 0.82:
            # Aggressive dash sprint forward
            self.action_queue.append(QueuedAIAction(14, 1, 0, InputButton.DASH))
            return (face_sign, 0, InputButton.DASH, None)

        self.move_intent_dx = 1
        self.move_intent_timer = 18
        return (face_sign, 0, InputButton.NONE, None)


class TrainingDummyController:
    """Controls the Training Lab opponent dummy according to TrainingSettings."""

    def __init__(self) -> None:
        self.ai = ShadowCeciliaAI(AIDifficulty.HUNTER)
        self.was_hit_recently: int = 0
        self.jump_cd: int = 0

    def reset(self) -> None:
        self.ai.reset()
        self.was_hit_recently = 0
        self.jump_cd = 0

    def compute_frame_input(
        self,
        dummy: Fighter,
        player: Fighter,
        settings: TrainingSettings,
        projectiles: Sequence[BloodMoonProjectile],
    ) -> Tuple[int, int, InputButton, Optional[Tuple[FighterState, bool]]]:
        mode = settings.dummy_mode
        if mode == DummyMode.CPU_ACTIVE:
            if self.ai.difficulty != settings.dummy_cpu_difficulty:
                self.ai = ShadowCeciliaAI(settings.dummy_cpu_difficulty)
            return self.ai.compute_frame_input(dummy, player, projectiles)

        face_sign = 1 if dummy.facing_right else -1
        if dummy.is_in_hitstun:
            self.was_hit_recently = 42
        elif self.was_hit_recently > 0:
            self.was_hit_recently -= 1

        if mode == DummyMode.STAND:
            return (0, 0, InputButton.NONE, None)
        if mode == DummyMode.CROUCH:
            return (0, 1, InputButton.NONE, None)
        if mode == DummyMode.JUMP:
            if dummy.grounded:
                if self.jump_cd <= 0:
                    self.jump_cd = 18
                    return (0, -1, InputButton.NONE, None)
                self.jump_cd -= 1
            return (0, 0, InputButton.NONE, None)
        if mode == DummyMode.GUARD_ALL:
            opp_spec = player.current_move
            crouch = opp_spec is not None and opp_spec.hit_height == HitHeight.LOW
            return (-face_sign, 1 if crouch else 0, InputButton.NONE, None)
        if mode == DummyMode.GUARD_AFTER_FIRST:
            if self.was_hit_recently > 0:
                opp_spec = player.current_move
                crouch = opp_spec is not None and opp_spec.hit_height == HitHeight.LOW
                return (-face_sign, 1 if crouch else 0, InputButton.NONE, None)
            return (0, 0, InputButton.NONE, None)
        if mode == DummyMode.AUTO_COUNTER:
            if dummy.is_neutral_movable and abs(player.x - dummy.x) < 175.0 and dummy.state_tick % 32 == 16:
                return (0, 0, InputButton.L, None)
            return (0, 0, InputButton.NONE, None)
        return (0, 0, InputButton.NONE, None)

