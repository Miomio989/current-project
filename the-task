        n_sh = pt(kf.near_shoulder)
        n_el = pt(kf.near_elbow)
        n_ha = pt(kf.near_hand)

        f_hip = pt(kf.far_hip)
        f_kn = pt(kf.far_knee)
        f_an = pt(kf.far_ankle)
        f_hl = pt(kf.far_heel)
        f_to = pt(kf.far_toe)

        n_hip = pt(kf.near_hip)
        n_kn = pt(kf.near_knee)
        n_an = pt(kf.near_ankle)
        n_hl = pt(kf.near_heel)
        n_to = pt(kf.near_toe)

        # 0. Eclipse Overdrive battle trance aura behind silhouette
        if eclipse_mode:
            self.rast.stamp_bloom(
                canvas, chest.x, chest.y + 12.0 * s, 94.0 * s, pal.aura_mid, alpha=145, additive=True
            )
            self.rast.stamp_bloom(
                canvas, waist.x, waist.y + 8.0 * s, 64.0 * s, (255, 206, 78), alpha=95, additive=True
            )

        # 1. Background crescent slash waves
        for sr in kf.slash_ribbons:
            if sr.behind_body:
                self.rast.paint_crimson_slash_arc(
                    canvas,
                    [pt(p) for p in sr.outer_pts],
                    [pt(p) for p in sr.inner_pts],
                    pal,
                    intensity=sr.intensity,
                    electric_sparks=sr.electric_sparks,
                    hue_shift=sr.hue_shift,
                )

        # 2. Flowing high-ponytail back plume (behind torso/shoulders)
        self._draw_ponytail_plume(canvas, kf.hair, pal, s, ox, oy, back_pass=True)

        # 3. Sword behind body if layer_order < 0
        if kf.sword.layer_order < 0:
            self._draw_cursed_greatsword(canvas, kf.sword, pal, s, ox, oy, eclipse_mode, frame_seed)

        # 4. Far Juliet-sleeve arm (if behind torso)
        self._draw_juliet_arm(
            canvas, f_sh, f_el, f_ha, kf.sleeve_puff_far, pal, s, is_far=True
        )

        # 5. Sculpted Legs & Thigh-High Buckled Black Leather Heeled Boots
        if kf.near_leg_in_front:
            self._draw_sculpted_leg_boot(
                canvas, f_hip, f_kn, f_an, f_hl, f_to, pal, s, is_far=True
            )
            self._draw_sculpted_leg_boot(
                canvas, n_hip, n_kn, n_an, n_hl, n_to, pal, s, is_far=False
            )
        else:
            self._draw_sculpted_leg_boot(
                canvas, n_hip, n_kn, n_an, n_hl, n_to, pal, s, is_far=False
            )
            self._draw_sculpted_leg_boot(
                canvas, f_hip, f_kn, f_an, f_hl, f_to, pal, s, is_far=True
            )

        # 6. Multi-tiered 7-pleat Gothic Lolita Miniskirt (overlaps thigh tops!)
        self._draw_tiered_lolita_skirt(
            canvas, waist, pelvis, kf.skirt, kf.torso_yaw_deg, pal, s
        )

        # 7. Sculpted Gothic Bodice, Scarlet Ruffled Plastron, High Collar, Ruby Brooch & Belt
        self._draw_gothic_bodice(
            canvas, waist, chest, neck, kf.torso_yaw_deg, kf.torso_lean_deg, pal, s
        )

        # 8. Sword mid-plane (resting across waist/body before near arm)
        if kf.sword.layer_order == 0:
            self._draw_cursed_greatsword(canvas, kf.sword, pal, s, ox, oy, eclipse_mode, frame_seed)

        # 9. Sculpted Multi-Azimuth Anime Head, Golden Eyes, Bangs & Cheek Sidelocks
        self._draw_anime_head(
            canvas, head, neck, kf.head_azimuth, kf.head_tilt_deg,
            kf.eye_gaze_x, kf.eye_gaze_y, kf.expression, kf.hair, pal, s, eclipse_mode
        )

        # 10. Upper ponytail crown knot & front wind-whipped locks
        self._draw_ponytail_plume(canvas, kf.hair, pal, s, ox, oy, back_pass=False)

        # 11. Sword foreground plane (horizontal slash across camera / thrust!)
        if kf.sword.layer_order > 0:
            self._draw_cursed_greatsword(canvas, kf.sword, pal, s, ox, oy, eclipse_mode, frame_seed)

        # 12. Near Juliet-sleeve arm & sculpted hand gripping hilt
        self._draw_juliet_arm(
            canvas, n_sh, n_el, n_ha, kf.sleeve_puff_near, pal, s, is_far=False
        )
        # Clasped anime hand overlay on sword hilt for two-handed grips
        if kf.two_hand_grip:
            self._draw_grip_hand(canvas, f_ha, pal, s, is_far=True)
        self._draw_grip_hand(canvas, n_ha, pal, s, is_far=False)

        # 13. Foreground electric crimson-magenta crescent slash arcs!
        for sr in kf.slash_ribbons:
            if not sr.behind_body:
                self.rast.paint_crimson_slash_arc(
                    canvas,
                    [pt(p) for p in sr.outer_pts],
                    [pt(p) for p in sr.inner_pts],
                    pal,
                    intensity=sr.intensity,
                    electric_sparks=sr.electric_sparks,
                    hue_shift=sr.hue_shift,
                )

        # Downscale 2x -> 1x with smoothscale for crisp painterly CG antialiasing
        # (internal 800x600 display still scales nearest-neighbor to window!)
        out = pygame.transform.smoothscale(canvas, (SPRITE_W, SPRITE_H))
        return out

    # --------------------------------------------------------------------------
    # 7-Strand Glossy High Ponytail & Crimson Crown Ribbon
    # --------------------------------------------------------------------------

    def _draw_ponytail_plume(
        self,
        surf: pygame.Surface,
        hair: HairFlowSpec,
        pal: CeciliaPalette,
        s: float,
        ox: float,
        oy: float,
        back_pass: bool,
    ) -> None:
        def hpt(xy: Pt2) -> Vec2:
            return Vec2(ox + xy[0] * s, oy + xy[1] * s)

        def width_profile(steps: int, w_base: float, w_belly: float) -> List[float]:
            out: List[float] = []
            for i in range(steps + 1):
                u = i / float(steps)
                if i == steps:
                    out.append(0.3 * s)
                else:
                    swell = (math.sin(clamp(u * 1.12, 0.0, 1.0) * math.pi * 0.85) ** 0.70)
                    taper = (1.0 - u) ** 0.88
                    out.append(s * (w_base * (1.0 - u) + w_belly * swell * taper))
            return out

        m0, m1, m2, m3 = (hpt(p) for p in hair.main_tail)
        u0, u1, u2, u3 = (hpt(p) for p in hair.upper_plume)
        l0, l1, l2, l3 = (hpt(p) for p in hair.lower_plume)

        if back_pass:
            # 5 lush layered cascading locks fanning into sharp anime tips
            back_specs = (
                (l0, l1, l2, l3, 4.4, 9.6, 0.28, -0.8, 2.0),
                (m0 + Vec2(-2 * s, 3 * s), m1 + Vec2(-8 * s, 10 * s), m2 + Vec2(-12 * s, 14 * s), m3 + Vec2(-10 * s, 10 * s), 4.0, 8.8, 0.34, 0.6, 1.8),
                (m0, m1, m2, m3, 5.4, 12.2, 0.36, 1.0, 2.2),
                (u0, u1, u2, u3, 3.4, 7.6, 0.40, 1.0, 1.8),
                (u0 + Vec2(0, -2 * s), u1 + Vec2(-5 * s, -9 * s), u2 + Vec2(-12 * s, -12 * s), u3 + Vec2(-16 * s, -4 * s), 2.2, 4.6, 0.44, 1.0, 1.6),
            )
            for p0, p1, p2, p3, wb, wp, su, rside, iw in back_specs:
                sp = sample_cubic_bezier(p0, p1, p2, p3, steps=16)
                ws = width_profile(16, wb, wp)
                self.rast.paint_glossy_hair_strand(
                    surf, sp, ws, pal, sheen_u=su, rim_side=rside, ink_width=iw
                )
        else:
            # Crown hair-tie gather & gothic crimson satin ribbon knot
            kn = hpt(hair.crown_anchor)
            # Crown hair puff above tie
            puff_poly = [
                kn + Vec2(-6.5 * s, -5.0 * s),
                kn + Vec2(1.5 * s, -8.5 * s),
                kn + Vec2(6.0 * s, -2.0 * s),
                kn + Vec2(4.5 * s, 4.5 * s),
                kn + Vec2(-4.5 * s, 5.5 * s),
            ]
            self.rast.paint_cg_poly(
                surf, puff_poly, pal.hair_mid, pal.hair_base, pal.hair_deep,
                light_dir=(0.4, -0.9), rim_color=pal.hair_rim, rim_strength=0.45,
                ink_color=INK_OBSIDIAN, ink_width=1.8,
            )
            # Crimson gothic tie ribbon
            band_poly = [
                kn + Vec2(-4.8 * s, -4.0 * s),
                kn + Vec2(4.0 * s, -4.6 * s),
                kn + Vec2(4.8 * s, 3.8 * s),
                kn + Vec2(-3.8 * s, 4.4 * s),
            ]
            self.rast.paint_cg_poly(
                surf, band_poly, pal.cloth_red_hi, pal.cloth_red_mid, pal.cloth_red_deep,
                light_dir=(0.5, -0.85), ink_color=INK_CRIMSON, ink_width=1.6,
            )

