    def _on_lora_d_spins(self) -> None:
        if getattr(self, "_lora_detail_syncing", False):
            return
        entry = self._lora_detail_entry()
        if entry is None:
            return
        entry["model"] = round(self.lora_d_mspin.value(), 2)
        entry["clip"] = round(self.lora_d_cspin.value(), 2)
