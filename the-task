    def _bake_volumetric_fog(self) -> pygame.Surface:
        """Seamless horizontal drifting translucent swamp mist ribbon."""
        w, h = 1280, 180
        lo = pygame.Surface((160, 24), pygame.SRCALPHA)
        for y in range(24):
            vy = y / 23.0
            vert_env = math.sin(vy * math.pi)
            for x in range(160):
                # Periodic horizontal noise so tile wraps seamlessly
                ang = (x / 160.0) * math.tau
                n = fbm_noise_2d(math.cos(ang) * 1.4 + 2.0, math.sin(ang) * 1.4 + vy * 2.4, octaves=3, seed=717)
                al = int(clamp((n - 0.32) * 1.65, 0.0, 1.0) * vert_env * 88)
                if al > 2:
                    lo.set_at((x, y), (196, 72, 76, al))
        return pygame.transform.smoothscale(lo, (w, h))

    # --------------------------------------------------------------------------
    # REAL-TIME UPDATE & MULTI-LAYER PARALLAX RENDERING
    # --------------------------------------------------------------------------
    def update(self, dt: float, resonance_any: bool = False, eclipse_target: float = 0.0) -> None:
        self.time_sec += dt
        target_storm = 1.0 if resonance_any else 0.0
        self.resonance_storm = lerp(self.resonance_storm, target_storm, min(1.0, dt * 3.5))
        self.eclipse_dim = lerp(self.eclipse_dim, eclipse_target, min(1.0, dt * 8.5))
        self.lightning_flash = max(0.0, self.lightning_flash - dt * 3.2)

        if resonance_any and random.random() < dt * 0.45:
            self.lightning_flash = 0.72

        for e in self.embers:
            e.x += (e.vx + math.sin(self.time_sec * 2.2 + e.phase) * 14.0) * dt
            e.y += e.vy * dt * (1.45 if resonance_any else 1.0)
            if e.y < -12.0:
                e.y = SCREEN_H + 10.0
                e.x = random.uniform(0.0, float(SCREEN_W))
            if e.x < -12.0:
                e.x = SCREEN_W + 10.0
            elif e.x > SCREEN_W + 12.0:
                e.x = -10.0

    def render_background(
        self,
        target: pygame.Surface,
        cam_x: float,
        cam_y: float,
        cam_zoom: float,
        shake_x: float = 0.0,
        shake_y: float = 0.0,
    ) -> None:
        """Render Sky -> Far Ruins -> Cathedral Ruins -> Swamp/Fences -> Fog -> Causeway & Decals."""
        self.ensure_baked()
        cam_off_x = cam_x - STAGE_CENTER_X
        cam_off_y = cam_y - (GROUND_Y - 190.0)

        # Layer 0: Apocalyptic Blood Sky (0.08x parallax)
        if self._sky_surf is not None:
            sx = int(-120 - cam_off_x * 0.08 + shake_x * 0.15)
            sy = int(-16 - cam_off_y * 0.06 + shake_y * 0.15)
            target.blit(self._sky_surf, (sx, sy))

        # Resonance crimson lightning sky boost
        if self.resonance_storm > 0.02 or self.lightning_flash > 0.02:
            boost_a = clamp_int(int(self.resonance_storm * 38 + self.lightning_flash * 120), 0, 165)
            if boost_a > 2:
                flash = pygame.Surface((SCREEN_W, 520), pygame.SRCALPHA)
                flash.fill((255, 28, 36, boost_a))
                target.blit(flash, (0, 0), special_flags=pygame.BLEND_RGBA_ADD)

        # Layer 1: Far Horizon Hills & Aqueducts (0.24x parallax)
        if self._far_ruins_surf is not None:
            fx = int(-240 - cam_off_x * 0.24 + shake_x * 0.30)
            fy = int(148 - cam_off_y * 0.16 + shake_y * 0.30)
            target.blit(self._far_ruins_surf, (fx, fy))

        # Layer 2: Centerpiece Monumental Romanesque Cathedral Ruins (0.45x parallax)
        if self._cathedral_surf is not None:
            cx_b = int(-320 - cam_off_x * 0.45 + shake_x * 0.50)
            cy_b = int(38 - cam_off_y * 0.30 + shake_y * 0.50)
            target.blit(self._cathedral_surf, (cx_b, cy_b))

            # Pulsing eerie demonic crimson glow inside the cathedral's central archway
            arch_sx = cx_b + 960
            arch_sy = cy_b + 430
            pulse = 0.65 + 0.35 * math.sin(self.time_sec * 3.1)
            self.rast.draw_soft_glow(
                target,
                (arch_sx, arch_sy),
                86.0 * (1.0 + 0.15 * pulse),
                (236, 24, 42),
                peak_alpha=int(55 * pulse + 35 * self.resonance_storm),
                rings=4,
            )

        # Layer 3: Midground Gnarled Dead Trees & Broken Wrought-Iron Fences (0.72x parallax)
        if self._mid_swamp_surf is not None:
            mx = int(-480 - cam_off_x * 0.72 + shake_x * 0.75)
            my = int(124 - cam_off_y * 0.55 + shake_y * 0.75)
            target.blit(self._mid_swamp_surf, (mx, my))

        # Volumetric drifting swamp mist behind fighting plane
        if self._fog_strip is not None:
            scroll = int((self.time_sec * 24.0 + cam_off_x * 0.60) % SCREEN_W)
            fy = int(430 - cam_off_y * 0.70 + shake_y * 0.7)
            target.blit(self._fog_strip, (-scroll, fy))
            target.blit(self._fog_strip, (SCREEN_W - scroll, fy))

        # Super Art / Fatal Execution Eclipse Silhouette Blackout Backdrop
        if self.eclipse_dim > 0.02:
            dim = pygame.Surface((SCREEN_W, SCREEN_H), pygame.SRCALPHA)
            dim.fill((12, 2, 8, clamp_int(int(self.eclipse_dim * 205), 0, 225)))
            target.blit(dim, (0, 0))
            # Dramatic crimson eclipse ring shining behind the battle during Supers!
            if self.eclipse_dim > 0.25:
                er = int(148 + 18 * math.sin(self.time_sec * 6.0))
                ec = (HALF_W, int(SCREEN_H * 0.36))
                self.rast.draw_soft_glow(target, ec, er * 1.45, (235, 16, 44), peak_alpha=int(130 * self.eclipse_dim), rings=5)
                pygame.draw.circle(target, (10, 2, 6), ec, er - 6)
                pygame.draw.circle(target, (255, 58, 62), ec, er, 3)

        # Layer 4: Wet Gothic Flagstone Causeway & Swamp Mire (1.0x world space)
        if self._ground_surf is not None:
            gx = int(HALF_W + (0.0 - cam_x) * cam_zoom + shake_x)
            gy = int(HALF_H + (510.0 - cam_y) * cam_zoom + shake_y)
            if abs(cam_zoom - 1.0) > 0.015:
                # Crop visible world slice first for blazing fast scaling on low-end laptops!
                vis_l = clamp_int(int(cam_x - (HALF_W / cam_zoom) - 32), 0, int(STAGE_WIDTH) - 2)
                vis_r = clamp_int(int(cam_x + (HALF_W / cam_zoom) + 32), vis_l + 2, int(STAGE_WIDTH))
                sub = self._ground_surf.subsurface((vis_l, 0, vis_r - vis_l, self._ground_surf.get_height()))
                sw = max(2, int((vis_r - vis_l) * cam_zoom))
                sh = max(2, int(self._ground_surf.get_height() * cam_zoom))
                scaled = pygame.transform.scale(sub, (sw, sh))
                sx = int(HALF_W + (vis_l - cam_x) * cam_zoom + shake_x)
                target.blit(scaled, (sx, gy))
            else:
                target.blit(self._ground_surf, (gx, gy))

        # Persistent battle decals (stone cracks + arterial blood pools on causeway)
        self._render_floor_decals(target, cam_x, cam_y, cam_zoom, shake_x, shake_y)

    def _render_floor_decals(
        self,
        target: pygame.Surface,
        cam_x: float,
        cam_y: float,
        cam_zoom: float,
        shake_x: float,
        shake_y: float,
    ) -> None:
        for d in self.decals:
            sx = HALF_W + (d.world_x - cam_x) * cam_zoom + shake_x
            sy = HALF_H + (d.world_y - cam_y) * cam_zoom + shake_y
            if sx < -80 or sx > SCREEN_W + 80:
                continue
            r = d.radius * cam_zoom
            if d.kind == "BLOOD":
                rx = max(4, int(r * 1.45))
                ry = max(2, int(r * 0.42))
                b_surf = pygame.Surface((rx * 2 + 4, ry * 2 + 4), pygame.SRCALPHA)
                pygame.draw.ellipse(b_surf, (108, 6, 18, d.alpha), (2, 2, rx * 2, ry * 2))
                pygame.draw.ellipse(b_surf, (172, 14, 28, int(d.alpha * 0.8)), (int(rx * 0.35), int(ry * 0.35), int(rx * 1.2), int(ry * 1.1)))
                target.blit(b_surf, (int(sx - rx - 2), int(sy - ry - 2)))
            else:
                # Radial jagged stone crack lines
                rng_c = random.Random(d.seed)
                for k in range(5):
                    ang = (math.tau * k) / 5.0 + rng_c.uniform(-0.3, 0.3)
                    ex = sx + math.cos(ang) * r * 1.25
                    ey = sy + math.sin(ang) * r * 0.36
                    mx = (sx + ex) * 0.5 + rng_c.uniform(-6, 6)
                    my = (sy + ey) * 0.5 + rng_c.uniform(-3, 3)
                    pygame.draw.lines(target, (12, 4, 8), False, [(sx, sy), (mx, my), (ex, ey)], 2)

    def render_fighter_water_reflection(
        self,
        target: pygame.Surface,
        sprite: pygame.Surface,
        screen_x: float,
        ground_screen_y: float,
        zoom: float,
    ) -> None:
        """Render realistic rippled inverted reflection of fighter in wet swamp causeway!"""
        if ground_screen_y > SCREEN_H + 60:
            return
        w = max(8, int(sprite.get_width() * zoom))
        h = max(8, int(sprite.get_height() * zoom * 0.42))
        flipped = pygame.transform.flip(sprite, False, True)
        ref = pygame.transform.scale(flipped, (w, h))
        ref.set_alpha(44)
        # Subtle water ripple horizontal offset
        rip = math.sin(self.time_sec * 4.5 + screen_x * 0.02) * 3.0
        ax = int(screen_x - SPRITE_ANCHOR_X * zoom + rip)
        ay = int(ground_screen_y - (SPRITE_H - SPRITE_ANCHOR_Y) * zoom * 0.42 + 4)
        target.blit(ref, (ax, ay))

    def render_foreground(
        self,
        target: pygame.Surface,
        cam_x: float,
        cam_y: float,
        shake_x: float = 0.0,
        shake_y: float = 0.0,
    ) -> None:
        """Render foreground mist wisps, glowing ash embers, and framing iron gates."""
        self.ensure_baked()
        cam_off_x = cam_x - STAGE_CENTER_X

        # Foreground drifting swamp mist along lower edge
        if self._fog_strip is not None:
            scroll = int((self.time_sec * 42.0 + cam_off_x * 1.15) % SCREEN_W)
            fg_fog = self._fog_strip.copy()
            fg_fog.set_alpha(120)
            target.blit(fg_fog, (-scroll, SCREEN_H - 125))
            target.blit(fg_fog, (SCREEN_W - scroll, SCREEN_H - 125))

        # Glowing floating ash embers drifting across the crimson haze
        ember_surf = pygame.Surface((SCREEN_W, SCREEN_H), pygame.SRCALPHA)
        for e in self.embers:
            flicker = 0.65 + 0.35 * math.sin(self.time_sec * 5.0 + e.phase)
            al = clamp_int(int(e.alpha * flicker), 25, 255)
            pygame.draw.circle(ember_surf, with_alpha(e.color, al), (int(e.x), int(e.y)), max(1, int(e.size)))
        target.blit(ember_surf, (0, 0), special_flags=pygame.BLEND_RGBA_ADD)

        # Extreme-edge silhouetted iron gates & overhanging branches (1.26x parallax)
        if self._fg_frame_surf is not None:
            fx = int(-680 - cam_off_x * 1.26 + shake_x * 1.2)
            target.blit(self._fg_frame_surf, (fx, int(shake_y * 0.8)))

        # Subtle smooth gothic blood-vignette via SRCALPHA surface (never solid black!)
        vig_h = 46
        vig_top = pygame.Surface((SCREEN_W, vig_h), pygame.SRCALPHA)
        vig_bot = pygame.Surface((SCREEN_W, vig_h), pygame.SRCALPHA)
        for i in range(vig_h):
            t = 1.0 - i / float(vig_h)
            al = clamp_int(int(105 * t * t), 0, 255)
            pygame.draw.line(vig_top, (8, 1, 6, al), (0, i), (SCREEN_W, i))
            pygame.draw.line(vig_bot, (8, 1, 6, al), (0, vig_h - 1 - i), (SCREEN_W, vig_h - 1 - i))
        target.blit(vig_top, (0, 0))
        target.blit(vig_bot, (0, SCREEN_H - vig_h))

