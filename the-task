AUDIO_SR: int = 22050
_TWO_PI: float = math.tau


def _midi_to_hz(note: float) -> float:
    return 440.0 * (2.0 ** ((note - 69.0) / 12.0))


def _fast_tanh(x: float) -> float:
    """Fast smooth overdrive waveshaper for punchy Payday-2 industrial techno grit."""
    if x > 2.6:
        return 1.0
    if x < -2.6:
        return -1.0
    x2 = x * x
    return x * (27.0 + x2) / (27.0 + 9.0 * x2)


class ProceduralAudioSynth:
    """Pure-Python stdlib PCM synthesizer generating high-BPM hypnotic
    Techno / Breakbeat tracks and crisp AAA fighting game SFX.
    """

    def __init__(self, sr: int = AUDIO_SR) -> None:
        self.sr = sr
        # Precomputed 4096-entry sine & white-noise lookup tables for speed
        self._lut_n = 4096
        self._lut_mask = self._lut_n - 1
        self._sin_lut = [math.sin((_TWO_PI * i) / self._lut_n) for i in range(self._lut_n)]
        rng = random.Random(2026)
        self._noise_lut = [rng.uniform(-1.0, 1.0) for _ in range(self._lut_n * 4)]
        self._noise_mask = len(self._noise_lut) - 1

        # Pre-baked industrial techno / breakbeat drum kit one-shots
        self._kick_hard = self._synth_techno_kick(0.32, punch=1.55, drive=2.6)
        self._kick_sub = self._synth_techno_kick(0.38, punch=1.15, drive=1.5)
        self._snare_break = self._synth_breakbeat_snare(0.22, crisp=1.35)
        self._snare_ghost = self._synth_breakbeat_snare(0.11, crisp=0.75)
        self._hat_closed = self._synth_hihat(0.055, open_decay=False)
        self._hat_open = self._synth_hihat(0.19, open_decay=True)
        self._clap_ind = self._synth_industrial_clap(0.18)

    def _to_stereo_sound(
        self, left: Sequence[float], right: Optional[Sequence[float]] = None, gain: float = 0.85
    ) -> Optional[pygame.mixer.Sound]:
        """Pack float samples [-1..1] into interleaved 16-bit stereo pygame.mixer.Sound."""
        n = len(left)
        if n == 0:
            return None
        r_buf = left if right is None else right
        pcm = array.array("h", [0]) * (n * 2)
        scale = 32760.0 * gain
        for i in range(n):
            lv = left[i]
            rv = r_buf[i]
            if lv > 1.0:
                lv = 1.0
            elif lv < -1.0:
                lv = -1.0
            if rv > 1.0:
                rv = 1.0
            elif rv < -1.0:
                rv = -1.0
            pcm[i * 2] = int(lv * scale)
            pcm[i * 2 + 1] = int(rv * scale)
        try:
            return pygame.mixer.Sound(buffer=pcm.tobytes())
        except Exception:
            return None

    # --------------------------------------------------------------------------
    # INDUSTRIAL TECHNO / AMEN BREAKBEAT DRUM KIT ONE-SHOTS
    # --------------------------------------------------------------------------
    def _synth_techno_kick(self, dur: float, punch: float = 1.4, drive: float = 2.2) -> List[float]:
        n = int(self.sr * dur)
        out = [0.0] * n
        phase = 0.0
        inv_sr = 1.0 / float(self.sr)
        lut = self._sin_lut
        lut_n = self._lut_n
        mask = self._lut_mask
        for i in range(n):
            t = i * inv_sr
            # Rapid pitch drop 185Hz -> 46Hz for pounding club/Payday assault kick
            freq = 45.0 + 145.0 * math.exp(-t * 34.0 * punch)
            phase += freq * inv_sr * lut_n
            body = lut[int(phase) & mask]
            click = self._noise_lut[i & self._noise_mask] * math.exp(-t * 240.0) * 0.45
            env = math.exp(-t * 9.8)
            out[i] = _fast_tanh((body * 1.15 + click) * env * drive) * 0.92
        return out

    def _synth_breakbeat_snare(self, dur: float, crisp: float = 1.2) -> List[float]:
        n = int(self.sr * dur)
        out = [0.0] * n
        phase = 0.0
        inv_sr = 1.0 / float(self.sr)
        lut = self._sin_lut
        lut_n = self._lut_n
        mask = self._lut_mask
        hp_prev = 0.0
        for i in range(n):
            t = i * inv_sr
            freq = 175.0 + 130.0 * math.exp(-t * 48.0)
            phase += freq * inv_sr * lut_n
            tone = lut[int(phase) & mask] * math.exp(-t * 22.0) * 0.65
            raw_n = self._noise_lut[(i * 3) & self._noise_mask]
            hp = raw_n - hp_prev * 0.72
            hp_prev = raw_n
            wire = hp * math.exp(-t * 14.5) * 0.85 * crisp
            out[i] = _fast_tanh((tone + wire) * 1.8) * 0.78
        return out

    def _synth_hihat(self, dur: float, open_decay: bool = False) -> List[float]:
        n = int(self.sr * dur)
        out = [0.0] * n
        inv_sr = 1.0 / float(self.sr)
        decay = 15.0 if open_decay else 58.0
        prev = 0.0
        for i in range(n):
            t = i * inv_sr
            # Metallic FM hash + high-passed noise
            rn = self._noise_lut[(i * 7 + 19) & self._noise_mask]
            metal = math.sin(t * 21300.0) * math.sin(t * 31900.0) * 0.38
            hp = (rn + metal) - prev * 0.86
            prev = rn
            out[i] = hp * math.exp(-t * decay) * 0.42
        return out

    def _synth_industrial_clap(self, dur: float) -> List[float]:
        n = int(self.sr * dur)
        out = [0.0] * n
        inv_sr = 1.0 / float(self.sr)
        prev = 0.0
        for i in range(n):
            t = i * inv_sr
            burst = 0.0
            for d_ms in (0.0, 0.011, 0.022, 0.034):
                if t >= d_ms:
                    burst += math.exp(-(t - d_ms) * 65.0)
            rn = self._noise_lut[(i * 5 + 101) & self._noise_mask]
            bp = rn - prev * 0.65
            prev = rn
            out[i] = _fast_tanh(bp * burst * 0.95) * 0.55
        return out

    def _stamp(
        self,
        buf_l: List[float],
        buf_r: List[float],
        sample: Sequence[float],
        start_idx: int,
        vol: float = 1.0,
        pan: float = 0.0,
    ) -> None:
        """Fast add-mix of a drum/hit one-shot into stereo loop buffer with wrap-around."""
        n_buf = len(buf_l)
        gl = vol * (1.0 - max(0.0, pan))
        gr = vol * (1.0 + min(0.0, pan))
        for i, v in enumerate(sample):
            idx = (start_idx + i) % n_buf
            buf_l[idx] += v * gl
            buf_r[idx] += v * gr

    # --------------------------------------------------------------------------
    # HIGH-BPM HYPNOTIC TECHNO / BREAKBEAT ASSAULT OST COMPOSER (146 BPM!)
    # --------------------------------------------------------------------------
    def build_bgm_track(self, bgm_id: BGMId) -> Optional[pygame.mixer.Sound]:
        if bgm_id == BGMId.BATTLE_ASSAULT_A:
            return self._compose_assault_ost(intense=False)
        if bgm_id == BGMId.BATTLE_ASSAULT_B:
            return self._compose_assault_ost(intense=True)
        if bgm_id == BGMId.TITLE_THEME:
            return self._compose_title_ost()
        if bgm_id == BGMId.VICTORY_THEME:
            return self._compose_victory_ost()
        return None

    def _compose_assault_ost(self, intense: bool = False) -> Optional[pygame.mixer.Sound]:
        """Compose a relentless, hypnotic 146 BPM Payday-2-Beta-style
        Techno + Breakbeat Assault fighting track in D Phrygian Dominant!
        4 bars = 64 sixteenth steps (~6.57s seamless razor-tight loop).
        """
        bpm = 146.0 if not intense else 150.0
        step_sec = 60.0 / bpm / 4.0  # 16th-note duration
        total_steps = 64             # 4 full driving bars
        total_samples = int(round(total_steps * step_sec * self.sr))
        buf_l = [0.0] * total_samples
        buf_r = [0.0] * total_samples

        # 1. DRUMS: Hybrid 4-on-the-floor Hard Techno Kick + Sliced Amen Breakbeat!
        # Step index 0..15 within each bar
        kick_steps_a = {0, 4, 8, 12, 14}
        kick_steps_b = {0, 3, 4, 8, 10, 12, 14, 15}
        snare_steps = {4, 12}
        ghost_steps = {7, 9, 15} if not intense else {2, 7, 9, 11, 14, 15}

        for bar in range(4):
            for st in range(16):
                g_step = bar * 16 + st
                pos = int(round(g_step * step_sec * self.sr))
                is_fill_bar = (bar == 3 and st >= 12)

                # Hard Techno Kick
                k_set = kick_steps_b if intense else kick_steps_a
                if st in k_set or (is_fill_bar and st in (12, 14)):
                    v = 0.96 if (st % 4 == 0) else 0.72
                    self._stamp(buf_l, buf_r, self._kick_hard, pos, vol=v, pan=0.0)

                # Breakbeat Snare + Claps
                if st in snare_steps or (is_fill_bar and st in (13, 15)):
                    self._stamp(buf_l, buf_r, self._snare_break, pos, vol=0.88, pan=-0.06)
                    if st == 4 or st == 12:
                        self._stamp(buf_l, buf_r, self._clap_ind, pos, vol=0.52, pan=0.10)
                elif st in ghost_steps:
                    self._stamp(buf_l, buf_r, self._snare_ghost, pos, vol=0.44, pan=0.14 if st % 2 else -0.14)

                # Hypnotic sizzling 16th hi-hats with offbeat open accents
                if st % 4 == 2:
                    self._stamp(buf_l, buf_r, self._hat_open, pos, vol=0.52 if intense else 0.42, pan=0.18)
                else:
                    vel = 0.34 if (st % 2 == 0) else 0.22
                    self._stamp(buf_l, buf_r, self._hat_closed, pos, vol=vel, pan=-0.16)

        # 2. ACID 303 RESONANT BASSLINE (D Phrygian Dominant: D2, Eb2, F#2, G2, A2, Bb2, C3, D3)
        # MIDI notes: D2=38, Eb2=39, F#2=42, G2=43, A2=45, Bb2=46, C3=48, D3=50
        bass_pat_a = [
            38, 38, 50, 38, 39, 38, 45, 38, 38, 50, 46, 45, 39, 38, 42, 43,
            38, 38, 50, 38, 45, 38, 46, 38, 39, 39, 51, 39, 45, 43, 42, 39,
            38, 38, 50, 38, 39, 38, 45, 38, 46, 46, 50, 46, 45, 43, 42, 38,
            43, 43, 50, 43, 45, 45, 50, 45, 46, 45, 43, 42, 39, 38, 45, 50,
        ]
        # Resonant 1-pole + feedback acid filter state
        lp1 = 0.0
        lp2 = 0.0
        bp_fb = 0.0
        b_phase = 0.0
        sub_phase = 0.0
        inv_sr = 1.0 / float(self.sr)
        lut = self._sin_lut
        lut_n = self._lut_n
        mask = self._lut_mask

        # 3. HYPNOTIC TRANCE / DARK GOTHIC LEAD ARPEGGIO (Staccato supersaw + square)
        lead_pat = [
            62, 0, 69, 62, 70, 0, 69, 66, 62, 0, 63, 62, 69, 66, 63, 0,
            62, 69, 74, 69, 70, 69, 66, 62, 63, 0, 70, 69, 66, 63, 62, 0,
            62, 0, 74, 70, 69, 0, 66, 69, 70, 74, 75, 74, 70, 69, 66, 63,
            67, 0, 74, 69, 70, 0, 74, 75, 77, 75, 74, 70, 69, 66, 63, 62,
        ]
        l_phase1 = 0.0
        l_phase2 = 0.0
        l_phase3 = 0.0
        # Dark cathedral choir/organ fifth drone chord per bar (D, Eb, Bb, A)
        pad_roots = [50, 51, 46, 45]
        p_ph1 = 0.0
        p_ph2 = 0.0

        step_samples = max(1, int(round(step_sec * self.sr)))
        for st in range(total_steps):
            s0 = int(round(st * step_sec * self.sr))
            s1 = min(total_samples, int(round((st + 1) * step_sec * self.sr)))
            b_freq = _midi_to_hz(bass_pat_a[st])
            b_accent = 1.35 if (st % 4 in (0, 2) or (intense and st % 2 == 1)) else 0.85

            lead_midi = lead_pat[st]
            l_active = lead_midi > 0
            l_freq = _midi_to_hz(lead_midi + (12 if (intense and st % 8 in (0, 4)) else 0)) if l_active else 0.0

            pad_f1 = _midi_to_hz(pad_roots[st // 16])
            pad_f2 = _midi_to_hz(pad_roots[st // 16] + 7)

            # LFO sweeps the 303 cutoff across all 4 bars for hypnotic ecstatic trance!
            bar_lfo = 0.5 + 0.5 * math.sin((st / float(total_steps)) * _TWO_PI)
            cutoff_base = 0.14 + 0.24 * bar_lfo + (0.12 if intense else 0.0)
            res = 0.58 if intense else 0.48

            seg_len = max(1, s1 - s0)
            for k in range(seg_len):
                idx = s0 + k
                u = k / float(seg_len)
                # Sidechain ducking on quarter-note kicks for massive club pump!
                sc_step = st % 4
                sc_t = (sc_step + u) * 0.25
                sidechain = clamp(0.30 + sc_t * 1.85, 0.30, 1.0)

                # Acid 303 sawtooth + tight sub-sine
                b_phase = (b_phase + b_freq * inv_sr) % 1.0
                sub_phase += (b_freq * 0.5) * inv_sr * lut_n
                saw = (b_phase * 2.0 - 1.0)
                sub = lut[int(sub_phase) & mask] * 0.42
                env_b = math.exp(-u * 3.6) * b_accent
                cut = clamp(cutoff_base + env_b * 0.34, 0.06, 0.86)
                inp = saw - bp_fb * res
                lp1 += cut * (inp - lp1)
                lp2 += cut * (lp1 - lp2)
                bp_fb = lp1 - lp2
                acid = _fast_tanh((lp2 * 2.1 + sub) * 1.45) * 0.44 * sidechain

                # Supersaw hypnotic trance stab lead
                lead_l = 0.0
                lead_r = 0.0
                if l_active:
                    l_phase1 = (l_phase1 + l_freq * inv_sr) % 1.0
                    l_phase2 = (l_phase2 + l_freq * 1.006 * inv_sr) % 1.0
                    l_phase3 = (l_phase3 + l_freq * 0.994 * inv_sr) % 1.0
                    l_env = math.exp(-u * (4.2 if not intense else 3.2))
                    s1_v = l_phase1 * 2.0 - 1.0
                    s2_v = l_phase2 * 2.0 - 1.0
                    s3_v = l_phase3 * 2.0 - 1.0
                    vol_l = 0.22 if intense else 0.16
                    lead_l = (s1_v + s2_v * 0.85) * l_env * vol_l * sidechain
                    lead_r = (s1_v + s3_v * 0.85) * l_env * vol_l * sidechain

                # Gothic organ/choir fifth pad underpinning the dark atmosphere
                p_ph1 += pad_f1 * inv_sr * lut_n
                p_ph2 += pad_f2 * inv_sr * lut_n
                pad_v = (lut[int(p_ph1) & mask] + 0.7 * lut[int(p_ph2) & mask] + 0.35 * lut[int(p_ph1 * 2.0) & mask]) * 0.065 * sidechain

                buf_l[idx] += acid + lead_l + pad_v
                buf_r[idx] += acid + lead_r + pad_v

        # 4. Crisp rhythmic 3/16 stereo techno delay echo on lead & percussion energy
        delay_samp = int(round(step_sec * 3.0 * self.sr))
        for i in range(total_samples):
            src = (i - delay_samp) % total_samples
            buf_l[i] = _fast_tanh((buf_l[i] + buf_r[src] * 0.16) * 0.92)
            buf_r[i] = _fast_tanh((buf_r[i] + buf_l[src] * 0.16) * 0.92)

        return self._to_stereo_sound(buf_l, buf_r, gain=0.80)

    def _compose_title_ost(self) -> Optional[pygame.mixer.Sound]:
        """Dark gothic cathedral organ + pulsing sub-bass + hypnotic minor techno arp (130 BPM)."""
        bpm = 130.0
        step_sec = 60.0 / bpm / 4.0
        total_steps = 64
        n = int(round(total_steps * step_sec * self.sr))
        buf_l = [0.0] * n
        buf_r = [0.0] * n

        # Deep heartbeat sub-kick pulse on beat 1 & 3
        for bar in range(4):
            for st in (0, 8, 14):
                pos = int(round((bar * 16 + st) * step_sec * self.sr))
                self._stamp(buf_l, buf_r, self._kick_sub, pos, vol=0.68 if st != 14 else 0.42)
            for st in range(0, 16, 2):
                pos = int(round((bar * 16 + st) * step_sec * self.sr))
                self._stamp(buf_l, buf_r, self._hat_closed, pos, vol=0.16, pan=0.22 if st % 4 else -0.22)

        arp_notes = [
            50, 57, 62, 65, 69, 65, 62, 57, 50, 58, 62, 67, 70, 67, 62, 58,
            46, 53, 58, 62, 65, 62, 58, 53, 45, 52, 57, 61, 64, 61, 57, 52,
        ] * 2
        chords = [(38, 45, 53), (38, 46, 55), (34, 41, 50), (33, 40, 49)]

        inv_sr = 1.0 / float(self.sr)
        lut = self._sin_lut
        lut_n = self._lut_n
        mask = self._lut_mask
        o1 = o2 = o3 = a_ph = 0.0

        for st in range(total_steps):
            s0 = int(round(st * step_sec * self.sr))
            s1 = min(n, int(round((st + 1) * step_sec * self.sr)))
            c0, c1, c2 = chords[st // 16]
            f1, f2, f3 = _midi_to_hz(c0), _midi_to_hz(c1), _midi_to_hz(c2)
            af = _midi_to_hz(arp_notes[st])
            seg = max(1, s1 - s0)
            for k in range(seg):
                idx = s0 + k
                u = k / float(seg)
                o1 += f1 * inv_sr * lut_n
                o2 += f2 * inv_sr * lut_n
                o3 += f3 * inv_sr * lut_n
                # Pipe-organ harmonic blend (fundamental + octave + twelfth)
                org = (
                    lut[int(o1) & mask] * 0.45
                    + lut[int(o1 * 2.0) & mask] * 0.22
                    + lut[int(o2) & mask] * 0.30
                    + lut[int(o3) & mask] * 0.25
                ) * 0.34
                a_ph = (a_ph + af * inv_sr) % 1.0
                arp = (a_ph * 2.0 - 1.0) * math.exp(-u * 5.2) * 0.16
                pan = 0.35 if (st % 2 == 0) else -0.35
                buf_l[idx] += org + arp * (1.0 - pan)
                buf_r[idx] += org + arp * (1.0 + pan)

        return self._to_stereo_sound(buf_l, buf_r, gain=0.72)

    def _compose_victory_ost(self) -> Optional[pygame.mixer.Sound]:
        """Atmospheric dark breakbeat victory cooldown with cathedral tolling bell."""
        bpm = 136.0
        step_sec = 60.0 / bpm / 4.0
        total_steps = 32
        n = int(round(total_steps * step_sec * self.sr))
        buf_l = [0.0] * n
        buf_r = [0.0] * n
        for bar in range(2):
            for st in (0, 10):
                self._stamp(buf_l, buf_r, self._kick_sub, int(round((bar * 16 + st) * step_sec * self.sr)), vol=0.75)
            for st in (4, 12):
                self._stamp(buf_l, buf_r, self._snare_break, int(round((bar * 16 + st) * step_sec * self.sr)), vol=0.58)
            for st in range(0, 16, 2):
                self._stamp(buf_l, buf_r, self._hat_closed, int(round((bar * 16 + st) * step_sec * self.sr)), vol=0.22)

        inv_sr = 1.0 / float(self.sr)
        lut = self._sin_lut
        lut_n = self._lut_n
        mask = self._lut_mask
        p1 = p2 = bell_p = 0.0
        f_root = _midi_to_hz(38)
        f_fifth = _midi_to_hz(45)
        f_bell = _midi_to_hz(62)
        for i in range(n):
            t = i * inv_sr
            p1 += f_root * inv_sr * lut_n
            p2 += f_fifth * inv_sr * lut_n
            bell_p += f_bell * inv_sr * lut_n
            pad = (lut[int(p1) & mask] * 0.5 + lut[int(p2) & mask] * 0.35) * 0.25
            # Tolling gothic bell at start of loop
            bell = (lut[int(bell_p) & mask] + 0.5 * lut[int(bell_p * 2.41) & mask]) * math.exp(-t * 1.45) * 0.26
            buf_l[i] = _fast_tanh(buf_l[i] + pad + bell)
            buf_r[i] = _fast_tanh(buf_r[i] + pad + bell)
        return self._to_stereo_sound(buf_l, buf_r, gain=0.75)

