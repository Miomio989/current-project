class CursedCathedralStage:
    """
    Seven-layer parallax Cursed Romanesque Cathedral Swamp stage modeled on
    Gothic horror & action classics (DMC3, Ghosts'n'Goblins, Castlevania),
    complete with real-time sine-rippled fighter water reflections, glowing
    crimson rose window, weeping stone saint & angel statues, iron fences,
    flickering votive candles, living bats, embers, wisps, rain, and eclipse FX.
    """

    def __init__(self, rast: PainterlyRasterizer) -> None:
        self.rast = rast
        self._baked_steps: int = 0
        self._total_steps: int = 7
        self._sky_surf: Optional[pygame.Surface] = None
        self._far_horizon_surf: Optional[pygame.Surface] = None
        self._cathedral_surf: Optional[pygame.Surface] = None
        self._statues_fences_surf: Optional[pygame.Surface] = None
        self._water_floor_surf: Optional[pygame.Surface] = None
        self._fg_reeds_surf: Optional[pygame.Surface] = None
        self._fog_strip_surf: Optional[pygame.Surface] = None

        self.time_sec: float = 0.0
        self.beat_pulse: float = 0.0
        self.eclipse_dim: float = 0.0
        self.target_eclipse_dim: float = 0.0
        self.lightning_flash: float = 0.0
        self.next_lightning_t: float = 5.5
        self.lightning_bolt_pts: List[Tuple[int, int]] = []

        self.embers: List[StageEmber] = []
        self.bats: List[CathedralBat] = []
        self.wisps: List[SwampWisp] = []
        self.ripples: List[WaterRipple] = []
        self.decals: List[SwampDecal] = []
        self.candles: List[VotiveCandle] = []
        self._init_living_atmosphere()

    def _init_living_atmosphere(self) -> None:
        rng = random.Random(1666)
        # Rising crimson & gold cursed embers
        for _ in range(54):
            self.embers.append(
                StageEmber(
                    x=rng.uniform(40.0, WORLD_W - 40.0),
                    y=rng.uniform(120.0, 560.0),
                    vx=rng.uniform(-22.0, 18.0),
                    vy=rng.uniform(-42.0, -14.0),
                    size=rng.uniform(1.4, 3.4),
                    life=rng.uniform(0.2, 4.5),
                    max_life=rng.uniform(2.8, 5.6),
                    color=rng.choice(((255, 76, 86), (255, 168, 72), (236, 44, 118), (255, 224, 152))),
                    phase=rng.uniform(0.0, math.tau),
                )
            )
        # Silhouette cathedral bats circling upper nave & blood moon
        for _ in range(14):
            self.bats.append(
                CathedralBat(
                    x=rng.uniform(120.0, WORLD_W - 120.0),
                    y=rng.uniform(76.0, 275.0),
                    vx=rng.uniform(26.0, 64.0) * rng.choice((-1.0, 1.0)),
                    vy=rng.uniform(-12.0, 12.0),
                    wing_phase=rng.uniform(0.0, math.tau),
                    scale=rng.uniform(0.65, 1.35),
                    depth=rng.uniform(0.35, 0.78),
                )
            )
        # Ghostly drifting swamp will-o'-wisps
        for idx in range(12):
            self.wisps.append(
                SwampWisp(
                    base_x=130.0 + idx * 116.0 + rng.uniform(-35.0, 35.0),
                    base_y=rng.uniform(370.0, 466.0),
                    phase=rng.uniform(0.0, math.tau),
                    speed=rng.uniform(0.85, 1.85),
                    radius=rng.uniform(14.0, 26.0),
                    color=rng.choice(((255, 58, 132), (186, 72, 255), (255, 134, 78))),
                )
            )
        # Flickering votive candles perched along the ruined graveyard walls & iron fences
        candle_clusters = (210, 224, 242, 420, 434, 446, 560, 574, 946, 962, 1084, 1098, 1114, 1296, 1312)
        for idx, cx in enumerate(candle_clusters):
            self.candles.append(
                VotiveCandle(
                    world_x=float(cx),
                    y=446.0 + (idx % 3) * 4.0,
                    height=10.0 + (idx % 4) * 3.0,
                    phase=rng.uniform(0.0, math.tau),
                )
            )

    def step_bake(self) -> float:
        """Progressive 7-step stage baking during loading screen; returns [0..1]."""
        if self._baked_steps == 0:
            self._sky_surf = self._bake_blood_sky()
        elif self._baked_steps == 1:
            self._far_horizon_surf = self._bake_far_horizon()
        elif self._baked_steps == 2:
            self._cathedral_surf = self._bake_romanesque_cathedral()
        elif self._baked_steps == 3:
            self._statues_fences_surf = self._bake_statues_fences_trees()
        elif self._baked_steps == 4:
            self._water_floor_surf = self._bake_swamp_water_floor()
        elif self._baked_steps == 5:
            self._fg_reeds_surf = self._bake_foreground_cattails()
        elif self._baked_steps == 6:
            self._fog_strip_surf = self._bake_volumetric_fog()
        self._baked_steps = min(self._total_steps, self._baked_steps + 1)
        return self._baked_steps / float(self._total_steps)

    def ensure_baked(self) -> None:
        while self._baked_steps < self._total_steps:
            self.step_bake()

    # --------------------------------------------------------------------------
    # Interactive Water Ripples, Blood Pools & Ground Cracks
    # --------------------------------------------------------------------------

    def spawn_water_ripple(
        self,
        world_x: float,
        intensity: float = 1.0,
        blood_tinted: bool = False,
    ) -> None:
        if len(self.ripples) > 48:
            self.ripples.pop(0)
        col = (242, 42, 92) if blood_tinted else (238, 178, 208)
        self.ripples.append(
            WaterRipple(
                world_x=clamp(world_x, STAGE_LEFT_WALL, STAGE_RIGHT_WALL),
                world_y=GROUND_Y + random.uniform(-4.0, 12.0),
                radius=6.0,
                max_radius=clamp(28.0 + 36.0 * intensity, 22.0, 96.0),
                alpha=clamp(0.85 * intensity, 0.4, 1.0),
                color=col,
            )
        )

    def add_blood_splatter(self, world_x: float, intensity: float = 1.0) -> None:
        if len(self.decals) > 90:
            self.decals.pop(0)
        self.decals.append(
            SwampDecal(
                world_x=clamp(world_x + random.uniform(-28.0, 28.0), STAGE_LEFT_WALL, STAGE_RIGHT_WALL),
                world_y=GROUND_Y + random.uniform(-6.0, 26.0),
                kind="BLOOD",
                radius=random.uniform(14.0, 32.0) * clamp(intensity, 0.5, 1.8),
                seed=random.randint(1, 99999),
                alpha=clamp_int(int(180 * intensity), 100, 230),
            )
        )
        self.spawn_water_ripple(world_x, intensity=intensity * 0.9, blood_tinted=True)

    def add_stone_crack(self, world_x: float, intensity: float = 1.0) -> None:
        if len(self.decals) > 90:
            self.decals.pop(0)
        self.decals.append(
            SwampDecal(
                world_x=clamp(world_x, STAGE_LEFT_WALL, STAGE_RIGHT_WALL),
                world_y=GROUND_Y + random.uniform(-2.0, 10.0),
                kind="CRACK",
                radius=random.uniform(24.0, 44.0) * clamp(intensity, 0.6, 1.6),
                seed=random.randint(1, 99999),
                alpha=210,
            )
        )
        self.spawn_water_ripple(world_x, intensity=intensity * 1.4, blood_tinted=False)

    def clear_decals(self) -> None:
        self.decals.clear()
        self.ripples.clear()

    def trigger_beat_pulse(self, strength: float = 1.0) -> None:
        self.beat_pulse = max(self.beat_pulse, clamp(strength, 0.0, 1.2))

    # --------------------------------------------------------------------------
    # LAYER 0: APOCALYPTIC BLOOD-RED SKY, SWIRLING CLOUDS & GIANT BLOOD MOON
    # --------------------------------------------------------------------------

    def _bake_blood_sky(self) -> pygame.Surface:
        w, h = 1120, 490
        surf = pygame.Surface((w, h))

        # Deep fiery blood-red apocalyptic sky gradient (inspired by stage.jpg & mockup.jpg)
        sky_stops = (
            (0.00, (16, 2, 8)),
            (0.24, (64, 6, 16)),
            (0.50, (148, 12, 22)),
            (0.76, (214, 30, 30)),
            (0.92, (244, 72, 46)),
            (1.00, (166, 22, 32)),
        )
        for y in range(h):
            c = sample_gradient(sky_stops, y / float(max(1, h - 1)))
            pygame.draw.line(surf, c, (0, y), (w, y))

        # Painterly swirling crimson storm clouds using low-res ridged FBM upscaled smoothly
        cw, ch = 224, 98
        cloud_small = pygame.Surface((cw, ch), pygame.SRCALPHA)
        for cy in range(ch):
            v = cy / float(ch)
            for cx in range(cw):
                u = cx / float(cw)
                # Diagonal storm shear for dramatic painterly cloud movement
                n1 = ridged_fbm_2d(u * 6.2 + v * 1.4, v * 4.4, octaves=4, seed=401)
                n2 = fbm_2d(u * 10.5 - v * 0.9, v * 6.5, octaves=3, seed=919)
                if n1 > 0.44:
                    dens = smoothstep((n1 - 0.44) / 0.46)
                    # Dark obsidian cloud bellies with fiery blood-crimson rims
                    if n2 > 0.56:
                        col = lerp_rgb((198, 22, 34), (255, 108, 76), (n2 - 0.56) * 2.2)
                        al = int(175 * dens)
                    else:
                        col = lerp_rgb((22, 4, 12), (96, 8, 22), n2 * 1.6)
                        al = int(205 * dens)
                    cloud_small.set_at((cx, cy), (col[0], col[1], col[2], clamp_int(al, 0, 255)))
        cloud_big = pygame.transform.smoothscale(cloud_small, (w, h))
        surf.blit(cloud_big, (0, 0))

        # Giant Blood Moon positioned upper-right of the cathedral rose window (exact mockup.jpg!)
        moon_x, moon_y, moon_r = int(w * 0.68), 118, 56
        self.rast.paint_radial_bloom(surf, moon_x, moon_y, 195, (232, 24, 48), alpha=155, additive=True)
        self.rast.paint_radial_bloom(surf, moon_x, moon_y, 96, (255, 92, 82), alpha=165, additive=True)

        # Textured moon disc with subtle dark scarlet craters
        moon_disc = pygame.Surface((moon_r * 2 + 4, moon_r * 2 + 4), pygame.SRCALPHA)
        mc = moon_r + 2
        for dy in range(-moon_r, moon_r + 1):
            for dx in range(-moon_r, moon_r + 1):
                d2 = dx * dx + dy * dy
                if d2 <= moon_r * moon_r:
                    dist_n = math.sqrt(d2) / float(moon_r)
                    crater = fbm_2d((dx + 80) * 0.065, (dy + 80) * 0.065, octaves=3, seed=666)
                    edge_dark = 1.0 - (dist_n ** 2.6) * 0.35
                    base_c = lerp_rgb((186, 22, 38), (255, 134, 118), clamp(crater * 1.15 * edge_dark, 0.0, 1.0))
                    # Smooth spherical blood-moon specular rim glow
                    rim_f = smoothstep((dist_n - 0.72) / 0.28) * clamp((-dx * 0.7 - dy * 0.7) / float(moon_r), 0.0, 1.0)
                    if rim_f > 0.01:
                        base_c = lerp_rgb(base_c, (255, 214, 186), rim_f * 0.52)
                    moon_disc.set_at((mc + dx, mc + dy), (base_c[0], base_c[1], base_c[2], 255))
        surf.blit(moon_disc, (moon_x - mc, moon_y - mc))

        # Dramatic volumetric crimson god-rays slanting down from the blood moon
        ray_surf = pygame.Surface((w, h), pygame.SRCALPHA)
        for ri in range(7):
            rx0 = moon_x - 36 + ri * 14
            spread = 95 + ri * 46
            tx0 = rx0 - 260 + ri * 85
            poly = [
                (rx0, moon_y + 10),
                (rx0 + 24, moon_y + 10),
                (tx0 + spread, h),
                (tx0, h),
            ]
            pygame.draw.polygon(ray_surf, (255, 62, 74, 16 if ri % 2 == 0 else 10), poly)
        surf.blit(ray_surf, (0, 0))
        return surf

    # --------------------------------------------------------------------------
    # LAYER 1: DISTANT CURSED HORIZON, RUINED AQUEDUCTS & DEAD TREES
    # --------------------------------------------------------------------------

    def _bake_far_horizon(self) -> pygame.Surface:
        w, h = 1280, 490
        surf = pygame.Surface((w, h), pygame.SRCALPHA)

        # Jagged obsidian horizon mountain ridge bathed in red mist
        ridge: List[Tuple[int, int]] = [(0, h)]
        for x in range(0, w + 16, 16):
            n = fbm_2d(x * 0.0045, 2.3, octaves=4, seed=709)
            ry = int(312 + n * 105 - abs(math.sin(x * 0.0055)) * 38)
            ridge.append((x, ry))
        ridge.append((w, h))
        pygame.draw.polygon(surf, (46, 10, 22, 235), ridge)

        # Distant ruined Gothic towers & crumbling stone arches on left/right horizon
        for bx, bh, bw in ((110, 96, 48), (220, 74, 38), (980, 108, 54), (1120, 82, 42)):
            base_y = 432
            pygame.draw.rect(surf, (38, 8, 20, 240), (bx, base_y - bh, bw, bh))
            # Pointed broken gable & arched window slit
            pygame.draw.polygon(surf, (38, 8, 20, 240), [(bx - 3, base_y - bh), (bx + bw // 2, base_y - bh - 26), (bx + bw + 3, base_y - bh)])
            pygame.draw.ellipse(surf, (192, 34, 46, 185), (bx + bw // 2 - 6, base_y - bh + 22, 12, 24))

        # Distant crimson haze band softly unifying horizon with blood sky
        haze = pygame.Surface((w, 120), pygame.SRCALPHA)
        for y in range(120):
            al = int(125 * math.sin((y / 120.0) * math.pi))
            pygame.draw.line(haze, (182, 32, 48, al), (0, y), (w, y))
        surf.blit(haze, (0, 368))
        return surf

    # --------------------------------------------------------------------------
    # LAYER 2: COLOSSAL CURSED ROMANESQUE CATHEDRAL & GLOWING ROSE WINDOW
    # --------------------------------------------------------------------------

    def _draw_stone_masonry_rect(
        self,
        surf: pygame.Surface,
        rect: pygame.Rect,
        base_col: RGB,
        hi_col: RGB,
        dark_col: RGB,
        seed: int,
    ) -> None:
        """Paint weathered gothic stone masonry blocks with crimson moonlight rim."""
        pygame.draw.rect(surf, base_col, rect)
        bh = 10
        row = 0
        for y in range(rect.top, rect.bottom, bh):
            offset = (row % 2) * 11
            for x in range(rect.left - offset, rect.right, 22):
                bx0 = max(rect.left, x)
                bx1 = min(rect.right, x + 21)
                by1 = min(rect.bottom, y + bh - 1)
                if bx1 - bx0 < 3:
                    continue
                h_v = hash_2d(bx0, y, seed)
                col = lerp_rgb(dark_col, hi_col, h_v * 0.85)
                pygame.draw.rect(surf, col, (bx0, y, bx1 - bx0, by1 - y))
                # Subtle crimson moonlight upper brick highlight
                if h_v > 0.62:
                    pygame.draw.line(surf, lerp_rgb(hi_col, (218, 56, 78), 0.35), (bx0, y), (bx1 - 1, y), 1)
            row += 1
        pygame.draw.rect(surf, dark_col, rect, 1)

    def _bake_romanesque_cathedral(self) -> pygame.Surface:
        """
        Sculpt the towering ruined Romanesque cathedral centerpiece faithful to
        stage.jpg and mockup.jpg: giant crimson-backlit stained-glass rose
        window, shattered nave arches, twin bell towers, gargoyles & banners!
        """
        w, h = 1380, 500
        surf = pygame.Surface((w, h), pygame.SRCALPHA)
        cx = w // 2
        base_y = 478

        stone_dark = (22, 10, 22)
        stone_mid = (54, 28, 44)
        stone_hi = (106, 54, 72)

        # Glowing fiery crimson interior furnace illumination shining through cathedral ruins!
        self.rast.paint_radial_bloom(surf, cx, 232, 225, (238, 22, 68), alpha=185, additive=True)
        self.rast.paint_radial_bloom(surf, cx, 305, 165, (255, 68, 92), alpha=150, additive=True)

        # 1. Flanking ruined Romanesque cloister wings & broken flying buttresses
        for side in (-1, 1):
            for bi in range(4):
                wx = cx + side * (162 + bi * 66)
                wh = 246 - bi * 34
                rect = pygame.Rect(wx - 28, base_y - wh, 56, wh)
                self._draw_stone_masonry_rect(surf, rect, stone_mid, stone_hi, stone_dark, seed=300 + bi * 17)
                # Shattered jagged ruin top edge
                jag = [
                    (rect.left, rect.top),
                    (rect.left + 12, rect.top - 18 - (bi % 2) * 12),
                    (rect.left + 26, rect.top - 6),
                    (rect.left + 40, rect.top - 22),
