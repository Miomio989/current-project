                    self.invuln_frames = 11
                    self._launch_attack(FighterState.SP_ASCENSION, audio, vfx)
                    return

            # 421D Darkmoon Riposte Stance
            if p_d and (self.input_buf.match_motion((4, 2, 1), 15) or self.input_buf.match_motion((2, 4), 12) or (simple_mode and np == 4)):
                if self.can_cancel_into(FighterState.SP_RIPOSTE_STANCE):
                    self._launch_attack(FighterState.SP_RIPOSTE_STANCE, audio, vfx)
                    return

            # 236 Crimson Crescent (A / B / EX C)
            if (p_a or p_b or p_c) and (self.input_buf.match_motion((2, 3, 6), 14) or self.input_buf.match_motion((2, 6), 12)):
                st = (
                    FighterState.SP_CRESCENT_EX
                    if (p_c and self.curse_meter >= 2500)
                    else (FighterState.SP_CRESCENT_B if (p_b or p_c) else FighterState.SP_CRESCENT_A)
                )
                if self.can_cancel_into(st):
                    self._launch_attack(st, audio, vfx)
                    return

            # 214 Nightmare Fang (Horizontal Shadow Blitz!)
            if (p_a or p_b or p_c) and (self.input_buf.match_motion((2, 1, 4), 14) or self.input_buf.match_motion((2, 4), 12)):
                if self.can_cancel_into(FighterState.SP_NIGHTMARE_FANG):
                    self._launch_attack(FighterState.SP_NIGHTMARE_FANG, audio, vfx)
                    return

            # 22 Cathedral Sigil
            if (p_a or p_b or p_c or p_d) and self.input_buf.detect_double_tap(2, 14):
                if self.can_cancel_into(FighterState.SP_CATHEDRAL_SIGIL):
                    self._launch_attack(FighterState.SP_CATHEDRAL_SIGIL, audio, vfx)
                    return

        # 5. Throw Attempt (A+D or K)
        want_throw = bool(inp.pressed & InputButton.THROW) or (
            (inp.held & InputButton.A) and (inp.held & InputButton.D) and (p_a or p_d)
        )
        if want_throw and self.grounded and self.is_free_actionable():
            self.enter_state(FighterState.THROW_ATTEMPT)
            audio.play_sfx(SFXId.SWING_LIGHT, self._pan())
            return

        # 6. Ground & Aerial Normals + Command Normals
        if p_any_atk:
            chosen: Optional[FighterState] = None
            if not self.grounded:
                chosen = (
                    FighterState.ATK_JC if p_c
                    else (FighterState.ATK_JB if p_b else (FighterState.ATK_JD if p_d else FighterState.ATK_JA))
                )
            else:
                if np == 6 and p_c:
                    chosen = FighterState.ATK_6C
                elif np == 3 and p_c:
                    chosen = FighterState.ATK_3C
                elif np == 6 and p_b:
                    chosen = FighterState.ATK_6B
                elif np == 6 and p_a:
                    chosen = FighterState.ATK_6A
                elif np in (1, 2, 3):
                    chosen = (
                        FighterState.ATK_2C if p_c
                        else (FighterState.ATK_2B if p_b else (FighterState.ATK_2D if p_d else FighterState.ATK_2A))
                    )
                else:
                    chosen = (
                        FighterState.ATK_5C if p_c
                        else (FighterState.ATK_5B if p_b else (FighterState.ATK_5D if p_d else FighterState.ATK_5A))
                    )
            if chosen is not None and self.can_cancel_into(chosen):
                self._launch_attack(chosen, audio, vfx)
                return

        # 7. Taunt
        if (inp.pressed & InputButton.TAUNT) and self.grounded and self.is_free_actionable():
            self.enter_state(FighterState.TAUNT_NOBLE)
            self.stylish.on_stylish_event(160)
            audio.play_sfx(SFXId.BLADE_DRAW_SHING, self._pan())
            return

        # 8. Movement, Dashes, Jumps & Air-Dashes
        if self.is_free_actionable() or (
            self.is_attacking() and self.has_hit_this_move and (self.moves[self.state].cancels & CancelFlag.JUMP)
        ):
            # Jump / Double Jump
            if np in (7, 8, 9):
                if self.grounded:
                    self.enter_state(FighterState.JUMP_SQUAT)
                    return
                elif self.air_actions_left > 0 and self.state_elapsed >= 5:
                    prev_np = self.input_buf.frames[-2].numpad if len(self.input_buf.frames) >= 2 else 5
                    if prev_np not in (7, 8, 9):
                        self.air_actions_left -= 1
                        self.vy = -14.8
                        self.vx = (6.8 if np == 9 else (-5.8 if np == 7 else 0.0)) * (1.0 if self.facing_right else -1.0)
                        self.enter_state(FighterState.DOUBLE_JUMP)
                        audio.play_sfx(SFXId.JUMP_WHOOSH, self._pan())
                        return

        if not self.is_free_actionable():
            return

        if not self.grounded:
            # BlazBlue / KoF Air Dash!
            if self.air_actions_left > 0 and self.state_elapsed >= 4:
                if self.input_buf.detect_double_tap(6, 10):
                    self.air_actions_left -= 1
                    self.vx = 11.5 * (1.0 if self.facing_right else -1.0)
                    self.vy = -1.2
                    self.enter_state(FighterState.AIR_DASH_FWD)
                    audio.play_sfx(SFXId.AIR_DASH_SNAP, self._pan())
                    return
                if self.input_buf.detect_double_tap(4, 10):
                    self.air_actions_left -= 1
                    self.vx = -9.8 * (1.0 if self.facing_right else -1.0)
                    self.vy = -1.2
                    self.enter_state(FighterState.AIR_DASH_BACK)
                    audio.play_sfx(SFXId.AIR_DASH_SNAP, self._pan())
                    return
            return

        # Ground Dashes
        if self.state not in (FighterState.DASH_FWD, FighterState.RUN_LOOP):
            if self.input_buf.detect_double_tap(6, 11):
                self.enter_state(FighterState.DASH_FWD)
                audio.play_sfx(SFXId.DASH_WATER_SPLASH, self._pan())
                return
            if self.input_buf.detect_double_tap(4, 11):
                self.enter_state(FighterState.BACKDASH)
                self.invuln_frames = 9
                audio.play_sfx(SFXId.AIR_DASH_SNAP, self._pan())
                return

        # Ground Walk / Crouch / Run Hold
        if np in (1, 2, 3):
            if self.state not in (FighterState.CROUCH_ENTER, FighterState.CROUCH_HOLD):
                self.enter_state(FighterState.CROUCH_ENTER)
            self.vx *= 0.65
        elif np == 6:
            if self.state == FighterState.RUN_LOOP:
                self.vx = 8.4 * (1.0 if self.facing_right else -1.0)
            else:
                if self.state != FighterState.WALK_FWD:
                    self.enter_state(FighterState.WALK_FWD)
                self.vx = 4.6 * (1.0 if self.facing_right else -1.0)
        elif np == 4:
            if self.state != FighterState.WALK_BACK:
                self.enter_state(FighterState.WALK_BACK)
            self.vx = -3.6 * (1.0 if self.facing_right else -1.0)
        else:
            if self.state == FighterState.RUN_LOOP:
                self.enter_state(FighterState.RUN_STOP)
            elif self.state not in (FighterState.IDLE, FighterState.IDLE_BATTLE_BREATH, FighterState.RUN_STOP):
                self.enter_state(FighterState.IDLE)
            self.vx *= 0.72

    def _launch_attack(
        self, st: FighterState, audio: AudioEngine, vfx: "VFXDirector"
    ) -> None:
        mv = self.moves[st]
        if mv.meter_cost > 0:
            self.curse_meter = max(0, self.curse_meter - mv.meter_cost)
        self.curse_meter = min(BASE_MAX_CURSE_METER, self.curse_meter + mv.meter_gain_whiff)
        self.enter_state(st)
        audio.play_sfx(mv.swing_sfx, self._pan())
        if mv.super_freeze_frames > 0:
            vfx.trigger_super_cutin(self, mv.name, mv.super_freeze_frames)

    def _pan(self) -> float:
        return clamp((self.x - WORLD_W * 0.5) / (WORLD_W * 0.45), -0.85, 0.85)

    def step_physics_and_animation(
        self,
        opponent: "Fighter",
        stage: CursedCathedralStage,
        audio: AudioEngine,
        vfx: "VFXDirector",
        allow_auto_face: bool = True,
    ) -> None:
        """Advance 1 logical 60Hz frame for this fighter."""
        # Smooth gauge recovery & trails
        if self.display_health_trail > float(self.health):
            self.display_health_trail = max(float(self.health), self.display_health_trail - 28.0)
        else:
            self.display_health_trail = float(self.health)

        if self.eclipse_timer > 0.0:
            self.eclipse_timer = max(0.0, self.eclipse_timer - FIXED_DT)
            # Eclipse Overdrive smoothly regenerates grey recoverable HP!
            if self.health < int(self.recoverable_hp):
                self.health = min(int(self.recoverable_hp), self.health + 4)

        if self.shadow_slow_timer > 0.0:
            self.shadow_slow_timer = max(0.0, self.shadow_slow_timer - FIXED_DT)
            if int(self.shadow_slow_timer * 60) % 2 == 1:
                return  # Smooth 50% time dilation!

        if self.just_guard_window > 0:
            self.just_guard_window -= 1
        if self.invuln_frames > 0:
            self.invuln_frames -= 1
        if not self.is_guarding_state():
            self.guard_gauge = min(BASE_MAX_GUARD_GAUGE, self.guard_gauge + 1.4)
        if not self.is_hitstun():
            self.poise = min(BASE_MAX_POISE, self.poise + 0.45)

        self.stylish.update(FIXED_DT, opponent.combo_received > 0)

        if self.hitstop > 0:
            self.hitstop -= 1
            return

        # Auto-face opponent on neutral ground
        if allow_auto_face and self.grounded and self.is_free_actionable():
            if abs(opponent.x - self.x) > 8.0:
                self.facing_right = opponent.x > self.x

        # Apply keyframe triggers on first tick of each animation plate
        kf = self.current_keyframe()
        if self.frame_tick == 0:
            fdir = 1.0 if self.facing_right else -1.0
            if abs(kf.impulse_vx) > 0.01:
                self.vx = kf.impulse_vx * fdir * (1.14 if self.eclipse_timer > 0.0 else 1.0)
            if abs(kf.impulse_vy) > 0.01:
                self.vy = kf.impulse_vy
                if kf.impulse_vy < 0.0:
                    self.grounded = False
            if kf.splash_intensity > 0.05 and self.grounded:
                stage.spawn_water_splash(self.x, kf.splash_intensity, direction=fdir)
            if kf.sfx_cue is not None:
                audio.play_sfx(kf.sfx_cue, self._pan())
            if kf.camera_shake > 0.05:
                vfx.cam.add_shake(kf.camera_shake)

            # Spawn special move projectiles & cathedral pillars on active keyframe!
            if self.state in self.moves and self.frame_idx == 2:
                mv = self.moves[self.state]
                if mv.spawns_projectile:
                    count = 2 if self.state == FighterState.SP_CRESCENT_EX else 1
                    for c_i in range(count):
                        vfx.spawn_blood_crescent(
                            owner_id=self.player_id,
                            x=self.x + fdir * (76.0 + c_i * 42.0),
                            y=self.y - 104.0,
                            vx=fdir * (12.8 if self.state != FighterState.SP_CRESCENT_A else 15.2),
                            damage=mv.damage // count,
                            pal_idx=self.pal_idx,
                            is_ex=(self.state == FighterState.SP_CRESCENT_EX),
                        )
                if mv.spawns_pillar:
                    if self.state == FighterState.SUPER_ECLIPSE_CATACLYSM:
                        for p_i in range(5):
                            vfx.spawn_cataclysm_pillar(
                                owner_id=self.player_id,
                                x=clamp(self.x + fdir * (110.0 + p_i * 96.0), STAGE_LEFT_WALL + 20, STAGE_RIGHT_WALL - 20),
                                delay_frames=p_i * 7,
                                damage=620,
                                pal_idx=self.pal_idx,
                            )
                    else:
                        tx = clamp(opponent.x, STAGE_LEFT_WALL + 30, STAGE_RIGHT_WALL - 30)
                        vfx.spawn_cataclysm_pillar(
                            owner_id=self.player_id,
                            x=tx,
                            delay_frames=10,
                            damage=mv.damage,
                            pal_idx=self.pal_idx,
                        )

        # Spawn sleek motion afterimages during dashes, blitzes, supers & Eclipse Overdrive!
        if (
            self.eclipse_timer > 0.0
            or self.state in (
                FighterState.DASH_FWD, FighterState.BACKDASH, FighterState.AIR_DASH_FWD,
                FighterState.AIR_DASH_BACK, FighterState.SP_NIGHTMARE_FANG,
                FighterState.SP_RIPOSTE_COUNTER, FighterState.SUPER_SCARLET_REQUIEM,
                FighterState.ASTRAL_DARKMOON_JUDGE, FighterState.SHADOW_CANCEL,
            )
        ) and (self.state_elapsed % 3 == 0):
            vfx.spawn_afterimage(self)

        # Integrate position & gravity
        self.x += self.vx
        self.y += self.vy
        if not self.grounded:
            grav = BASE_GRAVITY * (0.45 if self.state in (FighterState.AIR_DASH_FWD, FighterState.AIR_DASH_BACK) else 1.0)
            self.vy += grav
        else:
            if self.state not in (FighterState.WALK_FWD, FighterState.WALK_BACK, FighterState.RUN_LOOP, FighterState.DASH_FWD):
                self.vx *= 0.80

        # Stage Corner Wall Bounds + Dramatic Wall Bounce!
        if self.x < STAGE_LEFT_WALL:
            self.x = STAGE_LEFT_WALL
            if self.state in (FighterState.HIT_LAUNCH, FighterState.HIT_AIR_TUMBLE) and not self.did_wall_bounce and abs(self.vx) > 6.0:
                self.did_wall_bounce = True
                self.vx = 5.4
                self.vy = -10.5
                self.enter_state(FighterState.HIT_WALL_BOUNCE)
                audio.play_sfx(SFXId.WALL_BOUNCE_THUD, -0.8)
                vfx.cam.add_shake(10.0)
                vfx.spawn_shockwave(self.x, self.y - 96.0, (255, 86, 134), 86.0)
        elif self.x > STAGE_RIGHT_WALL:
            self.x = STAGE_RIGHT_WALL
            if self.state in (FighterState.HIT_LAUNCH, FighterState.HIT_AIR_TUMBLE) and not self.did_wall_bounce and abs(self.vx) > 6.0:
                self.did_wall_bounce = True
                self.vx = -5.4
                self.vy = -10.5
                self.enter_state(FighterState.HIT_WALL_BOUNCE)
                audio.play_sfx(SFXId.WALL_BOUNCE_THUD, 0.8)
                vfx.cam.add_shake(10.0)
                vfx.spawn_shockwave(self.x, self.y - 96.0, (255, 86, 134), 86.0)

        # Landing on the Swamp Water Floor!
        if self.y >= GROUND_Y:
            was_air = not self.grounded
            self.y = GROUND_Y
            self.grounded = True
            self.air_actions_left = 1
            if was_air:
                stage.spawn_water_splash(self.x, 1.05, blood_tinted=self.is_hitstun())
                if self.state in (FighterState.HIT_LAUNCH, FighterState.HIT_AIR_TUMBLE, FighterState.HIT_WALL_BOUNCE):
                    if self.vy > 11.0 and not self.did_ground_bounce and self.health > 0:
                        self.did_ground_bounce = True
                        self.grounded = False
                        self.vy = -10.2
                        self.vx *= 0.55
                        self.enter_state(FighterState.HIT_GROUND_BOUNCE)
                        audio.play_sfx(SFXId.GROUND_BOUNCE_SPLASH, self._pan())
                        vfx.cam.add_shake(8.5)
                    elif self.health <= 0:
                        self.vy = 0.0
                        self.vx *= 0.35
                        self.enter_state(FighterState.KO_COLLAPSE)
                        audio.play_sfx(SFXId.KNOCKDOWN_SPLASH, self._pan())
                    else:
                        self.vy = 0.0
                        self.vx *= 0.35
                        self.enter_state(FighterState.KNOCKDOWN_LIE)
                        audio.play_sfx(SFXId.KNOCKDOWN_SPLASH, self._pan())
                elif self.state == FighterState.HIT_GROUND_BOUNCE:
                    self.vy = 0.0
                    self.vx *= 0.3
                    self.enter_state(FighterState.KNOCKDOWN_LIE if self.health > 0 else FighterState.KO_COLLAPSE)
                    audio.play_sfx(SFXId.KNOCKDOWN_SPLASH, self._pan())
                else:
                    self.vy = 0.0
                    self.vx *= 0.45
                    self.enter_state(FighterState.LAND_RECOVERY)
                    audio.play_sfx(SFXId.LAND_WATER_PLUNGE, self._pan())

        # Hitstun & Blockstun Countdown
        if self.hitstun_left > 0:
            self.hitstun_left -= 1
            if self.hitstun_left == 0 and self.grounded and self.state in (
                FighterState.HIT_HIGH, FighterState.HIT_MID, FighterState.HIT_LOW,
                FighterState.HIT_HEAVY, FighterState.HIT_CRUMPLE, FighterState.GUARD_CRUSH,
            ):
                self.combo_received = 0
                self.combo_scaling = 1.0
                self.did_wall_bounce = False
                self.did_ground_bounce = False
                opponent.stylish.end_combo()
                self.enter_state(FighterState.IDLE)

        if self.blockstun_left > 0:
            self.blockstun_left -= 1
            if self.blockstun_left == 0 and self.is_guarding_state():
                self.enter_state(FighterState.IDLE if self.grounded else FighterState.JUMP_FALL)

        # Advance Keyframe Plate Timer
        self.state_elapsed += 1
        self.frame_tick += 1
        if self.frame_tick >= max(1, kf.duration):
            self.frame_tick = 0
            frames = self.current_frames()
            if self.frame_idx + 1 < len(frames):
                self.frame_idx += 1
            else:
                self._on_animation_complete(audio)

    def _on_animation_complete(self, audio: AudioEngine) -> None:
        st = self.state
        # Looping states
        if st in (
            FighterState.IDLE, FighterState.IDLE_BATTLE_BREATH,
            FighterState.WALK_FWD, FighterState.WALK_BACK,
            FighterState.CROUCH_HOLD, FighterState.RUN_LOOP,
            FighterState.JUMP_FALL, FighterState.HIT_AIR_TUMBLE,
        ):
            self.frame_idx = 0
            return
        if st in (FighterState.KO_COLLAPSE, FighterState.ROUND_WIN, FighterState.MATCH_VICTORY):
            self.frame_idx = len(self.current_frames()) - 1
            return
        if st == FighterState.CROUCH_ENTER:
            self.enter_state(FighterState.CROUCH_HOLD)
            return
        if st == FighterState.DASH_FWD:
            if self.input_buf.latest().numpad == 6:
                self.enter_state(FighterState.RUN_LOOP)
            else:
                self.enter_state(FighterState.RUN_STOP)
            return
        if st == FighterState.JUMP_SQUAT:
            np = self.input_buf.latest().numpad
            fdir = 1.0 if self.facing_right else -1.0
            self.vy = -17.4
            self.vx = (6.2 if np == 9 else (-5.2 if np == 7 else 0.0)) * fdir
            self.grounded = False
            self.enter_state(FighterState.JUMP_RISE)
            audio.play_sfx(SFXId.JUMP_WHOOSH, self._pan())
            return
        if st in (FighterState.JUMP_RISE, FighterState.DOUBLE_JUMP):
            self.enter_state(FighterState.JUMP_APEX)
            return
        if st in (FighterState.JUMP_APEX, FighterState.AIR_DASH_FWD, FighterState.AIR_DASH_BACK):
            self.enter_state(FighterState.JUMP_FALL)
            return
        if st == FighterState.KNOCKDOWN_LIE:
            self.combo_received = 0
            self.combo_scaling = 1.0
            self.did_wall_bounce = False
            self.did_ground_bounce = False
            self.invuln_frames = 14
            self.enter_state(FighterState.WAKEUP_NEUTRAL)
            return
        # Default recovery back to neutral
        self.enter_state(FighterState.IDLE if self.grounded else FighterState.JUMP_FALL)


