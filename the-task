    def _draw_vitality_side(self, surf: "pygame.Surface", f: Fighter, left: bool, world_t: float, beat: float) -> None:
        bar_w = 456
        bar_h = 26
        x0 = 122 if left else INTERNAL_W - 122 - bar_w
        y0 = 36

        # Curved blade-frame black lacquer outline + gold filigree bevel
        poly = (
            [(x0, y0), (x0 + bar_w, y0 + 2), (x0 + bar_w - 18, y0 + bar_h), (x0 + 8, y0 + bar_h)]
            if left else
            [(x0, y0 + 2), (x0 + bar_w, y0), (x0 + bar_w - 8, y0 + bar_h), (x0 + 18, y0 + bar_h)]
        )
        pygame.draw.polygon(surf, (16, 8, 12), poly)

        # Crimson Vitality Fill
        vit_ratio = clamp(f.vitality / max(1.0, f.max_vitality), 0.0, 1.0)
        fill_w = int((bar_w - 14) * vit_ratio)
        if fill_w > 0:
            fx = (x0 + bar_w - 10 - fill_w) if left else (x0 + 10)
            pygame.draw.rect(surf, (206, 20, 26), (fx, y0 + 4, fill_w, bar_h - 8))
            pygame.draw.rect(surf, (255, 92, 52), (fx, y0 + 5, fill_w, 5))

            # Crawling Violet Fester Segment inside Vitality bar (GDD 2.5)
            if f.fester > 0.5:
                fest_ratio = clamp(f.fester / max(1.0, f.max_vitality), 0.0, vit_ratio)
                fw = int((bar_w - 14) * fest_ratio)
                if fw > 2:
                    fex = fx if left else (fx + fill_w - fw)
                    strip = self.textures.surfaces["tex_fester_strip"]
                    off = int(world_t * 60) % 128
                    crop = strip.subsurface(pygame.Rect(off, 4, min(fw, 128), bar_h - 8))
                    surf.blit(pygame.transform.scale(crop, (fw, bar_h - 8)), (fex, y0 + 4))

        pygame.draw.polygon(surf, (238, 186, 68), poly, 3)

        # Thin Silver Fraying Resolve Thread underneath Vitality bar (GDD 2.4)
        res_ratio = clamp(f.resolve / MAX_RESOLVE, 0.0, 1.0)
        ry = y0 + bar_h + 7
        rw = int((bar_w - 40) * res_ratio)
        rx = (x0 + bar_w - 20 - rw) if left else (x0 + 20)
        res_col = (232, 238, 248) if res_ratio > 0.28 else (255, 112, 72)
        pygame.draw.line(surf, (46, 36, 44), (x0 + 20, ry), (x0 + bar_w - 20, ry), 3)
        if rw > 0:
            pygame.draw.line(surf, res_col, (rx, ry), (rx + rw, ry), 3)

        # Fighter Name + Moon-Phase Round Counters (GDD 8.1)
        nt = self.font_hud.render(f.name, True, (248, 232, 198))
        nx = x0 + 18 if left else (x0 + bar_w - 18 - nt.get_width())
        surf.blit(nt, (nx, y0 + bar_h + 15))
        for ri in range(ROUNDS_TO_WIN):
            mx = (INTERNAL_W // 2 - 96 - ri * 38) if left else (INTERNAL_W // 2 + 96 + ri * 38)
            my = y0 + bar_h + 26
            won = f.rounds_won > ri
            pygame.draw.circle(surf, (255, 232, 146) if won else (24, 14, 18), (mx, my), 13)
            pygame.draw.circle(surf, (238, 186, 68), (mx, my), 13, 2)
            if not won:
                pygame.draw.arc(surf, (220, 198, 134), (mx - 10, my - 10, 20, 20), 0.6, 2.6, 2)

    def _draw_trance_beads(self, surf: "pygame.Surface", f: Fighter, left: bool, beat: float) -> None:
        base_x = 68 if left else INTERNAL_W - 196
        base_y = INTERNAL_H - 54
        pygame.draw.line(surf, (232, 182, 64), (base_x - 24, base_y + 12), (base_x + 150, base_y + 12), 3)
