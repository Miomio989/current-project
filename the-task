    def open_setup(self, mode: GameMode) -> None:
        self.setup_target_mode = mode
        self.setup_cursor = 0

    def handle_setup_key(self, key: int, audio: AudioManager) -> Optional[str]:
        # Rows: 0=P1 Palette, 1=P2 Palette, 2=CPU Diff, 3=Rounds, 4=Timer, 5=Simple P1, 6=START MATCH
        rows = 7
        if key in (pygame.K_UP, pygame.K_w):
            self.setup_cursor = (self.setup_cursor - 1) % rows
            audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)
        elif key in (pygame.K_DOWN, pygame.K_s):
            self.setup_cursor = (self.setup_cursor + 1) % rows
            audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)
        elif key in (pygame.K_LEFT, pygame.K_a, pygame.K_RIGHT, pygame.K_d):
            delta = -1 if key in (pygame.K_LEFT, pygame.K_a) else 1
            audio.play_sfx(SFXId.UI_MOVE, vol_scale=0.8)
            n_pal = len(CECILIA_PALETTES)
            if self.setup_cursor == 0:
                self.settings.p1_palette_idx = (self.settings.p1_palette_idx + delta) % n_pal
            elif self.setup_cursor == 1:
                self.settings.p2_palette_idx = (self.settings.p2_palette_idx + delta) % n_pal
            elif self.setup_cursor == 2:
                diffs = list(AIDifficulty)
                i = (diffs.index(self.settings.cpu_difficulty) + delta) % len(diffs)
                self.settings.cpu_difficulty = diffs[i]
            elif self.setup_cursor == 3:
                opts = [1, 2, 3]
                i = (opts.index(self.settings.rounds_to_win) + delta) % len(opts)
                self.settings.rounds_to_win = opts[i]
            elif self.setup_cursor == 4:
                opts_t = [60, 99, 0]
                i = (opts_t.index(self.settings.round_timer_sec) + delta) % len(opts_t)
                self.settings.round_timer_sec = opts_t[i]
            elif self.setup_cursor == 5:
                self.settings.simple_inputs_p1 = not self.settings.simple_inputs_p1
        elif key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_u):
            audio.play_sfx(SFXId.UI_CONFIRM, vol_scale=0.95)
            return "START_MATCH"
        elif key == pygame.K_ESCAPE:
            audio.play_sfx(SFXId.UI_CANCEL, vol_scale=0.8)
            return "BACK_MENU"
        return None

