    def _build_vfx_flipbooks(self) -> None:
        """Rasterizes 6-frame animated flipbooks for ink-brush slashes, blood ribbons, lotus petals, and seal-bursts."""
        # Ink Slash Arc Flipbook
        slash_frames: List["pygame.Surface"] = []
        for fi in range(6):
            s = pygame.Surface((160, 160), pygame.SRCALPHA)
            t = fi / 5.0
            a0 = -1.2 + t * 0.9
            a1 = 0.8 + t * 0.8
            pts = []
            for k in range(14):
                ang = lerp(a0, a1, k / 13.0)
                rad = 52 + 12 * math.sin(k * 0.3)
                pts.append((80 + math.cos(ang) * rad, 80 + math.sin(ang) * rad))
            alpha = int(255 * (1.0 - t * 0.72))
            BrushVectorRasterizer.draw_brush_stroke(s, pts, (255, 226, 178, alpha), 18.0 * (1.0 - t * 0.4), True, True, 6, fi + 31)
            BrushVectorRasterizer.draw_brush_stroke(s, pts, (228, 32, 54, alpha), 9.0 * (1.0 - t * 0.4), True, True, 4, fi + 99)
            slash_frames.append(s)
        self.vfx_flipbooks["ink_slash"] = slash_frames

        # Seal-Burst Flipbook (Fester Reap & Sync Hit Lotus Burst)
        burst_frames: List["pygame.Surface"] = []
        for fi in range(6):
            s = pygame.Surface((160, 160), pygame.SRCALPHA)
            t = fi / 5.0
            r_in = 14 + t * 34
            r_out = 30 + t * 48
            alpha = int(250 * (1.0 - t * 0.85))
            BrushVectorRasterizer.draw_lotus_ring(s, 80, 80, r_in, r_out, 8, (255, 198, 92, alpha), (225, 42, 168, alpha // 3), t * 0.8, 2)
            pygame.draw.circle(s, (255, 236, 174, alpha), (80, 80), int(r_out), 2)
            burst_frames.append(s)
        self.vfx_flipbooks["seal_burst"] = burst_frames

