# DETERMINISTIC COMBAT RESOLVER (CLASH, PARRY, GUARD CRUSH, LETHAL COUNTER)
# ==============================================================================

class CombatResolver:
    """Authoritative fighting-game collision, Clash, Parry, Poise & Combo resolver."""

    def __init__(
        self,
        move_reg: Dict[FighterState, MoveSpec],
        vfx: VFXManager,
        cam: CameraDirector,
        stage: CursedCathedralStage,
        audio: AudioManager,
        stats: MatchStats,
        settings: GameSettings,
    ) -> None:
        self.move_reg = move_reg
        self.vfx = vfx
        self.cam = cam
        self.stage = stage
        self.audio = audio
        self.stats = stats
        self.settings = settings
        self.on_move_hit_callback: Optional[Callable[[int, FighterState], None]] = None

    def resolve_pushboxes(self, p1: Fighter, p2: Fighter) -> None:
        if p1.state in (FighterState.THROW_EXEC, FighterState.KO_FALL) or p2.state in (FighterState.THROW_EXEC, FighterState.KO_FALL):
            return
        b1 = p1.get_pushbox_world()
        b2 = p2.get_pushbox_world()
        if not rect_intersects(b1, b2):
            return
        min_sep = FIGHTER_PUSH_HALF_W * 2.0
        dx = p2.x - p1.x
        overlap = min_sep - abs(dx)
        if overlap > 0.0:
            sign = 1.0 if dx >= 0.0 else -1.0
            half = overlap * 0.52
            p1.x = clamp(p1.x - sign * half, STAGE_LEFT_WALL, STAGE_RIGHT_WALL)
            p2.x = clamp(p2.x + sign * half, STAGE_LEFT_WALL, STAGE_RIGHT_WALL)

    def resolve_combat_frame(self, p1: Fighter, p2: Fighter) -> None:
        """Resolve weapon clashes, strike hits, throws, parries, and projectiles cleanly."""
        self.resolve_pushboxes(p1, p2)

        # Spawn projectiles & Cataclysm pillars on exact authored move frames
        for f in (p1, p2):
            spec = self.move_reg.get(f.state)
            if spec is not None:
                if spec.spawns_projectile_frame == f.state_frame and not f.has_spawned_proj:
                    f.has_spawned_proj = True
                    self.vfx.spawn_projectile(f)
                if f.state_frame in spec.spawns_pillars_frames and f.state_frame not in f.pillar_frames_fired:
                    f.pillar_frames_fired.add(f.state_frame)
                    idx = spec.spawns_pillars_frames.index(f.state_frame)
                    self.vfx.spawn_cataclysm_pillar(f, 80.0 + idx * 105.0)
                    self.cam.add_shake(12.0, self.settings.screen_shake)
                    self.stage.add_stone_crack(f.x + (1.0 if f.facing_right else -1.0) * (80.0 + idx * 105.0), 1.3)

        # 1. Check Blade-on-Blade WEAPON CLASH!
        hw1 = p1.get_active_hit_window()
        hw2 = p2.get_active_hit_window()
        if hw1 is not None and hw2 is not None and hw1.height != AttackHeight.THROW and hw2.height != AttackHeight.THROW:
            if hw1.hit_id not in p1.hits_registered and hw2.hit_id not in p2.hits_registered:
                clashed = False
                cx, cy = (p1.x + p2.x) * 0.5, min(p1.y, p2.y) - 105.0
                for b1 in hw1.boxes:
                    w1 = b1.to_world(p1.x, p1.y, p1.facing_right)
                    for b2 in hw2.boxes:
                        w2 = b2.to_world(p2.x, p2.y, p2.facing_right)
                        if rect_intersects(w1, w2):
                            cx, cy = rect_overlap_center(w1, w2)
                            clashed = True
                            break
                    if clashed:
                        break
                if clashed:
                    p1.hits_registered.add(hw1.hit_id)
                    p2.hits_registered.add(hw2.hit_id)
                    p1.enter_state(FighterState.CLASH_RECOIL)
                    p2.enter_state(FighterState.CLASH_RECOIL)
                    p1.hitstop_frames = 14
                    p2.hitstop_frames = 14
                    p1.vx = -8.0 if p1.facing_right else 8.0
                    p2.vx = -8.0 if p2.facing_right else 8.0
                    p1.curse = min(MAX_CURSE, p1.curse + 90)
                    p2.curse = min(MAX_CURSE, p2.curse + 90)
                    self.stats.p1_clashes += 1
                    self.vfx.spawn_guard_or_parry_sparks(cx, cy, is_clash=True)
                    self.vfx.trigger_screen_flash((255, 232, 138), 145.0)
                    self.vfx.add_callout("BLADE CLASH!", "+90 CURSE", (255, 224, 96), -1, 1.05)
                    self.cam.add_shake(13.0, self.settings.screen_shake)
                    self.audio.play_sfx(SFXId.BLADE_CLASH)
                    return

        # 2. Check melee strikes & throws both directions
        self._check_melee_attack(p1, p2)
        self._check_melee_attack(p2, p1)

        # 3. Check Bloodmoon Crescent Projectiles
        for pr in self.vfx.projectiles:
            if pr.hit_already:
                continue
            atk = p1 if pr.owner_id == 0 else p2
            dfn = p2 if pr.owner_id == 0 else p1
            if dfn.is_invulnerable(AttackHeight.MID):
                continue
            pbox = (pr.x - pr.radius_x, pr.y - pr.radius_y, pr.radius_x * 2.0, pr.radius_y * 2.0)
            for hb in dfn.get_hurtboxes():
                if rect_intersects(pbox, hb.to_world(dfn.x, dfn.y, dfn.facing_right)):
                    pr.hit_already = True
                    hw_proj = HitWindow(
                        99, 0, 1, (), pr.damage, pr.chip_damage, pr.poise_damage,
                        AttackHeight.MID, AttackWeight.SPECIAL, 22, 16, 8, 7.5,
                        curse_gain_hit=55, curse_gain_block=25, blood_scale=1.15, hit_sfx=SFXId.HIT_HEAVY,
                    )
                    self._apply_impact(atk, dfn, hw_proj, pr.x, pr.y, is_projectile=True)
                    break

    def _check_melee_attack(self, atk: Fighter, dfn: Fighter) -> None:
        hw = atk.get_active_hit_window()
        if hw is None or hw.hit_id in atk.hits_registered:
            return
        if dfn.is_invulnerable(hw.height):
            return

        # Check overlap between any active hitbox and any defender hurtbox
        hit_pos: Optional[Tuple[float, float]] = None
        for ab in hw.boxes:
            wb = ab.to_world(atk.x, atk.y, atk.facing_right)
            for hb in dfn.get_hurtboxes():
                wh = hb.to_world(dfn.x, dfn.y, dfn.facing_right)
                if rect_intersects(wb, wh):
                    hit_pos = rect_overlap_center(wb, wh)
                    break
            if hit_pos is not None:
                break
        if hit_pos is None:
            return

        # Handle Throw Attempt & Throw Tech!
        if hw.height == AttackHeight.THROW:
            if not dfn.is_grounded or dfn.is_hitstun:
                return
            atk.hits_registered.add(hw.hit_id)
            if dfn.state == FighterState.THROW_ATTEMPT and dfn.state_frame <= 9:
                atk.enter_state(FighterState.THROW_TECH)
                dfn.enter_state(FighterState.THROW_TECH)
                atk.vx = -7.5 if atk.facing_right else 7.5
                dfn.vx = -7.5 if dfn.facing_right else 7.5
                self.vfx.spawn_guard_or_parry_sparks(hit_pos[0], hit_pos[1], is_clash=True)
                self.vfx.add_callout("THROW TECH!", "", (142, 226, 255), -1, 0.9)
                return
            atk.enter_state(FighterState.THROW_EXEC)
            dfn.enter_state(FighterState.HIT_LAUNCH)
            dfn.hp = max(0, dfn.hp - 1350)
            dfn.vx = (7.2 if atk.facing_right else -7.2)
            dfn.vy = -10.5
            dfn.stun_frames = 36
            atk.curse = min(MAX_CURSE, atk.curse + 110)
            atk.stylish.register_action(FighterState.THROW_EXEC, 280.0, 1.15)
            self.vfx.spawn_hit_sparks_and_blood(
                hit_pos[0], hit_pos[1], 1.0 if atk.facing_right else -1.0,
                AttackWeight.HEAVY, 1.65, PALETTES[atk.palette_key], self.stage, is_lethal=False,
            )
            self.audio.play_sfx(SFXId.THROW_IMPALE)
            self.cam.add_shake(10.0, self.settings.screen_shake)
            return

        atk.hits_registered.add(hw.hit_id)
        self._apply_impact(atk, dfn, hw, hit_pos[0], hit_pos[1], is_projectile=False)

    def _is_blocking(self, dfn: Fighter, height: AttackHeight) -> bool:
        if height in (AttackHeight.UNBLOCKABLE, AttackHeight.THROW):
            return False
        if not (dfn.can_act_freely or dfn.is_guarding):
            return False
        num, _ = dfn.input_buf.latest()
        holding_back = num in (4, 1, 7)
        if not holding_back:
            return False
        if not dfn.is_grounded:
            return True
        if height == AttackHeight.LOW:
            return num == 1  # Must crouch-block lows!
        if height == AttackHeight.HIGH:
            return num in (4, 7)  # Must stand-block overheads!
        return True

    def _apply_impact(
        self,
        atk: Fighter,
        dfn: Fighter,
        hw: HitWindow,
        hx: float,
        hy: float,
        is_projectile: bool,
    ) -> None:
        facing_sign = 1.0 if atk.facing_right else -1.0
        pal_atk = PALETTES.get(atk.palette_key, PALETTES["CRIMSON_ORIGINAL"])

        # 1. JUST-PARRY / BLADE DEFLECT / ABYSSAL COUNTER STANCE!
        if dfn.is_parry_active() and hw.height != AttackHeight.THROW:
            dfn.enter_state(FighterState.PARRY_SUCCESS)
            dfn.hitstop_frames = 10
            atk.hitstop_frames = 16
            dfn.curse = min(MAX_CURSE, dfn.curse + 165)
            dfn.poise = min(MAX_POISE, dfn.poise + 240)
            if dfn.player_id == 0:
                self.stats.p1_parries += 1
            else:
                self.stats.p2_parries += 1
            ranked_up = dfn.stylish.register_action(FighterState.PARRY_SUCCESS, 360.0, 1.35)
            if ranked_up:
                self.audio.play_sfx(SFXId.RANK_UP)
            self.vfx.spawn_guard_or_parry_sparks(hx, hy, is_parry=True)
            self.vfx.trigger_screen_flash((255, 224, 108), 160.0)
            self.vfx.add_callout("JUST PARRY!", "RIPOSTE READY!", (255, 228, 96), dfn.player_id, 1.2)
            self.cam.trigger_dramatic_slowmo(14, factor=2, zoom=1.08)
            self.cam.add_shake(9.0, self.settings.screen_shake)
            self.audio.play_sfx(SFXId.PARRY_CLANG)
            return

        # 2. GUARD & POISE / GUARD CRUSH!
        if self._is_blocking(dfn, hw.height):
            atk.move_blocked = True
            dfn.poise = max(0, dfn.poise - hw.poise_damage)
            chip = hw.chip_damage
            if chip > 0 and dfn.hp > 1:
                dfn.hp = max(1, dfn.hp - chip)
            atk.curse = min(MAX_CURSE, atk.curse + hw.curse_gain_block)
            dfn.curse = min(MAX_CURSE, dfn.curse + int(hw.curse_gain_block * 0.7))

            # Check Guard Crush (Soulcalibur / Dark Souls stance break!)
            if dfn.poise <= 0:
                dfn.poise = MAX_POISE
                dfn.enter_state(FighterState.GUARD_BREAK)
                dfn.stun_frames = 38
                dfn.vx = facing_sign * 7.5
                atk.hitstop_frames = 14
                dfn.hitstop_frames = 14
                self.vfx.spawn_guard_or_parry_sparks(hx, hy, is_clash=True)
                self.vfx.trigger_screen_flash((255, 76, 108), 165.0)
                self.vfx.add_callout("GUARD CRUSH!", "STANCE SHATTERED", (255, 74, 112), atk.player_id, 1.35)
                self.cam.trigger_dramatic_slowmo(18, factor=2, zoom=1.09)
                self.cam.add_shake(13.0, self.settings.screen_shake)
                self.audio.play_sfx(SFXId.GUARD_BREAK)
                return

            if not dfn.is_grounded:
                dfn.enter_state(FighterState.GUARD_AIR)
            elif dfn.input_buf.latest()[0] == 1:
                dfn.enter_state(FighterState.GUARD_CROUCH)
            else:
                dfn.enter_state(FighterState.GUARD_STAND)
            dfn.stun_frames = hw.blockstun
            hs = max(3, int(hw.hitstop * 0.78 * self.settings.hitstop_scale))
            atk.hitstop_frames = hs
            dfn.hitstop_frames = hs
            self._apply_pushback(atk, dfn, hw.pushback_x * 0.85, facing_sign)
            self.vfx.spawn_guard_or_parry_sparks(hx, hy, is_parry=False)
            self.audio.play_sfx(SFXId.GUARD_HEAVY if hw.weight.value >= 3 else SFXId.GUARD_LIGHT)
            return

        # 3. CLEAN HIT / COUNTER-HIT / LETHAL COUNTER!
        atk.move_connected = True
        is_counter = dfn.is_attacking and dfn.get_active_hit_window() is None
        is_lethal = is_counter and hw.lethal_on_counter

        dfn.combo_count += 1
        # Authentic fighting-game combo proration scaling (prevents infinite 100% loops while rewarding crisp combos!)
        scale = max(0.28, 1.0 - (dfn.combo_count - 1) * 0.11)
        if is_lethal:
            scale *= 1.25
        elif is_counter:
            scale *= 1.12
        if atk.is_eclipse:
            scale *= 1.15
        if hw.weight in (AttackWeight.SUPER, AttackWeight.FATAL):
            scale = max(scale, 0.55)

        dmg = max(80, int(hw.damage * scale))
        dfn.hp = max(0, dfn.hp - dmg)
        dfn.combo_damage += dmg
        atk.curse = min(MAX_CURSE, atk.curse + hw.curse_gain_hit)
        dfn.curse = min(MAX_CURSE, dfn.curse + int(hw.curse_gain_hit * 0.45))

        # Update match stats & stylish rank
        if atk.player_id == 0:
            self.stats.p1_damage_dealt += dmg
            self.stats.p1_max_combo = max(self.stats.p1_max_combo, dfn.combo_count)
            self.stats.score += dmg + dfn.combo_count * 120
        else:
            self.stats.p2_damage_dealt += dmg
            self.stats.p2_max_combo = max(self.stats.p2_max_combo, dfn.combo_count)

        spec = self.move_reg.get(atk.state)
        base_style = spec.style_points if spec is not None else 150.0
        bonus_m = 1.65 if is_lethal else (1.28 if is_counter else 1.0)
        if not atk.is_grounded:
            bonus_m *= 1.20
        ranked_up = atk.stylish.register_action(atk.state, base_style, bonus_m)
        dfn.stylish.register_damage_taken()
        if atk.player_id == 0:
            self.stats.p1_peak_rank = atk.stylish.peak_rank
        else:
            self.stats.p2_peak_rank = atk.stylish.peak_rank
        if ranked_up:
            self.audio.play_sfx(SFXId.RANK_UP)

        if self.on_move_hit_callback is not None:
            self.on_move_hit_callback(atk.player_id, atk.state)

        # Hitstop & hitflash
        hs_base = hw.hitstop + (6 if is_lethal else (3 if is_counter else 0))
        hs = max(4, int(hs_base * self.settings.hitstop_scale))
        atk.hitstop_frames = hs
        dfn.hitstop_frames = hs
        dfn.flash_crimson_frames = 5

        # Determine victim hit reaction state (KO, Launch, Knockdown, Heavy, Crouch, Light)
        if dfn.hp <= 0:
            dfn.enter_state(FighterState.KO_FALL)
            dfn.vx = facing_sign * 7.8
            dfn.vy = -10.4
            self.cam.trigger_dramatic_slowmo(32, factor=3, zoom=1.10)
            self.vfx.trigger_screen_flash((255, 42, 76), 190.0)
            self.audio.play_sfx(SFXId.KO_BOOM)
            self.audio.play_sfx(SFXId.VOICE_KO)
        elif hw.launch_vy < -1.0 or not dfn.is_grounded or hw.knockdown or is_lethal:
            dfn.enter_state(FighterState.HIT_LAUNCH)
            dfn.juggle_decay += 1
            juggle_mult = max(0.55, 1.0 - dfn.juggle_decay * 0.08)
            dfn.vx = facing_sign * max(3.0, hw.launch_vx)
            dfn.vy = (hw.launch_vy if hw.launch_vy < -1.0 else -9.8) * juggle_mult
            dfn.stun_frames = max(24, hw.hitstun)
        elif dfn.is_crouching:
            dfn.enter_state(FighterState.HIT_CROUCH)
            dfn.stun_frames = hw.hitstun + (4 if is_counter else 0)
            self._apply_pushback(atk, dfn, hw.pushback_x, facing_sign)
        elif hw.weight.value >= 3:
            dfn.enter_state(FighterState.HIT_STAND_HEAVY)
            dfn.stun_frames = hw.hitstun + (5 if is_counter else 0)
            self._apply_pushback(atk, dfn, hw.pushback_x, facing_sign)
        else:
            dfn.enter_state(FighterState.HIT_STAND_LIGHT)
            dfn.stun_frames = hw.hitstun + (3 if is_counter else 0)
            self._apply_pushback(atk, dfn, hw.pushback_x, facing_sign)

        # Dramatic callouts, camera zoom & VFX choreography
        if is_lethal:
            self.vfx.add_callout("LETHAL COUNTER!", f"+{dmg} DMG", (255, 48, 96), atk.player_id, 1.35)
            self.vfx.trigger_screen_flash((255, 36, 78), 165.0)
            self.cam.trigger_dramatic_slowmo(22, factor=3, zoom=1.11)
            self.cam.add_shake(15.0, self.settings.screen_shake)
            self.audio.play_sfx(SFXId.HIT_LETHAL)
        elif is_counter:
            self.vfx.add_callout("COUNTER!", "ADVANTAGE+", (255, 178, 72), atk.player_id, 0.95)
            self.cam.add_shake(7.5 + hw.weight.value * 1.5, self.settings.screen_shake)
            self.audio.play_sfx(hw.hit_sfx)
        else:
            self.cam.add_shake(3.0 + hw.weight.value * 2.2, self.settings.screen_shake)
            self.audio.play_sfx(hw.hit_sfx)

        if hw.blood_scale >= 0.95:
            self.audio.play_sfx(SFXId.BLOOD_SPRAY, volume=0.75)
        if hw.weight.value >= 3 and dfn.hp > 0:
            self.audio.play_sfx(SFXId.VOICE_HURT, volume=0.65)

        self.vfx.spawn_hit_sparks_and_blood(
            hx, hy, facing_sign, hw.weight, hw.blood_scale, pal_atk, self.stage, is_lethal=is_lethal
        )

    @staticmethod
    def _apply_pushback(atk: Fighter, dfn: Fighter, push: float, facing_sign: float) -> None:
        """Apply corner-aware pushback (pushing attacker back cleanly when defender is cornered!)."""
        near_right = dfn.x >= STAGE_RIGHT_WALL - CORNER_PUSH_MARGIN and facing_sign > 0
        near_left = dfn.x <= STAGE_LEFT_WALL + CORNER_PUSH_MARGIN and facing_sign < 0
        if near_right or near_left:
            atk.vx = -facing_sign * push * 0.85
            dfn.vx = facing_sign * push * 0.15
        else:
            dfn.vx = facing_sign * push


