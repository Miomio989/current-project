        hip: Vec2,
        knee: Vec2,
        ankle: Vec2,
        heel: Vec2,
        toe: Vec2,
        pal: CeciliaPalette,
        s: float,
        is_far: bool,
    ) -> None:
        dim = 0.84 if is_far else 1.0
        sk_hi = scale_rgb(pal.skin_hi, dim)
        sk_mid = scale_rgb(pal.skin_mid, dim)
        sk_sh = scale_rgb(pal.skin_shadow, dim)

        # Bare porcelain upper thigh visible above thigh-high boot cuff
        boot_cuff = hip.lerp(knee, 0.56)
        thigh_dir = (knee - hip).normalized()
        thigh_poly = build_anatomical_contour(
            hip,
            boot_cuff + thigh_dir * (4.5 * s),
            w0=10.8 * s,
            w1=8.2 * s,
            bulge_l=1.8 * s,
            bulge_r=1.3 * s,
            bulge_t=0.42,
            steps=10,
        )
        self.rast.paint_cg_poly(
            surf, thigh_poly, sk_hi, sk_mid, sk_sh,
            light_dir=(0.58, -0.81),
            rim_color=pal.hair_rim if not is_far else None,
            rim_strength=0.22,
            bounce_color=(188, 42, 78),
            bounce_strength=0.18,
            ink_color=INK_SKIN,
            ink_width=1.6,
            cel_cut=0.44,
            volume_curve=0.35,
        )

        # Leather palette scaled by depth
        l_sp = scale_rgb(pal.leather_spec, dim)
        l_hi = scale_rgb(pal.leather_hi, dim)
        l_mid = scale_rgb(pal.leather_mid, dim)
        l_dp = scale_rgb(pal.leather_deep, dim)

        # Upper thigh boot sleeve (boot cuff -> knee)
        upper_boot = build_anatomical_contour(
            boot_cuff, knee,
            w0=8.9 * s, w1=7.2 * s,
            bulge_l=0.6 * s, bulge_r=0.5 * s,
            steps=8,
        )
        self.rast.paint_cg_poly(
            surf, upper_boot, l_hi, l_mid, l_dp,
            light_dir=(0.64, -0.76),
            rim_color=pal.hair_rim if not is_far else None,
            rim_strength=0.30,
            spec_pos=boot_cuff.lerp(knee, 0.45) + Vec2(2.4 * s, 0),
            spec_color=l_sp,
            spec_radius=6.5 * s,
            ink_color=INK_OBSIDIAN,
            ink_width=1.8,
            volume_curve=0.42,
        )

        # Sculpted calf boot (knee -> ankle) with sleek feminine calf curve
        calf_boot = build_anatomical_contour(
            knee, ankle,
            w0=7.4 * s, w1=4.4 * s,
            bulge_l=1.1 * s, bulge_r=2.1 * s,
            bulge_t=0.34,
            pinch_t=0.84,
            pinch_amt=0.6 * s,
            steps=10,
        )
        self.rast.paint_cg_poly(
            surf, calf_boot, l_hi, l_mid, l_dp,
            light_dir=(0.66, -0.75),
            rim_color=pal.hair_rim if not is_far else None,
            rim_strength=0.36,
            spec_pos=knee.lerp(ankle, 0.36) + Vec2(2.2 * s, 0),
            spec_color=l_sp,
            spec_radius=7.0 * s,
            ink_color=INK_OBSIDIAN,
            ink_width=1.8,
            volume_curve=0.44,
        )

        # High-gloss specular leather highlight ribbon running along the shin
        shin_n = (ankle - knee).normalized().perp()
        shin_pts = [
            (knee.lerp(ankle, u) + shin_n * (2.6 * s)).as_int()
            for u in (0.12, 0.32, 0.56, 0.78)
        ]
        pygame.draw.lines(surf, with_alpha(l_sp, 140), False, shin_pts, max(1, int(1.8 * s)))

        # Sculpted gothic heeled boot foot (ankle -> heel -> arch -> pointed toe)
        foot_fwd = (toe - ankle).normalized()
        foot_up = Vec2(0.0, -1.0)
        foot_poly = [
            ankle + Vec2(-3.8 * s, -2.5 * s),
            ankle + Vec2(4.2 * s, -2.0 * s),
            ankle.lerp(toe, 0.58) + foot_up * (2.6 * s),
            toe + Vec2(1.5 * s, -1.2 * s),
            toe + Vec2(0.5 * s, 2.2 * s),
            ankle.lerp(toe, 0.45) + Vec2(0.0, 3.0 * s),
            heel + Vec2(2.2 * s, 3.4 * s),
            heel + Vec2(-3.4 * s, 3.4 * s),
            heel + Vec2(-4.2 * s, -1.5 * s),
        ]
        self.rast.paint_cg_poly(
            surf, foot_poly, l_hi, l_mid, l_dp,
            light_dir=(0.55, -0.84),
            rim_color=pal.hair_rim if not is_far else None,
            rim_strength=0.25,
            ink_color=INK_OBSIDIAN,
            ink_width=1.8,
            volume_curve=0.35,
        )

        # 6 iconic buckled leather straps with gleaming silver buckles (char.jpg!)
        b_hi = scale_rgb(pal.buckle_hi, dim)
        b_mid = scale_rgb(pal.buckle_mid, dim)
        b_sh = scale_rgb(pal.buckle_shadow, dim)
        strap_locs = (
            (boot_cuff.lerp(knee, 0.16), (knee - boot_cuff).normalized(), 8.8 * s),
            (knee.lerp(ankle, 0.14), (ankle - knee).normalized(), 7.6 * s),
            (knee.lerp(ankle, 0.34), (ankle - knee).normalized(), 7.1 * s),
            (knee.lerp(ankle, 0.54), (ankle - knee).normalized(), 6.3 * s),
            (knee.lerp(ankle, 0.72), (ankle - knee).normalized(), 5.5 * s),
            (knee.lerp(ankle, 0.88), (ankle - knee).normalized(), 4.9 * s),
        )
        for center, axis, half_w in strap_locs:
            nrm = axis.perp()
            band_h = 1.6 * s
            p_l = center - nrm * half_w
            p_r = center + nrm * half_w
            strap_poly = [
                p_l - axis * band_h,
                p_r - axis * band_h,
                p_r + axis * band_h,
                p_l + axis * band_h,
            ]
            pygame.draw.polygon(surf, l_dp, [p.as_int() for p in strap_poly])
            pygame.draw.line(surf, l_hi, (p_l - axis * (band_h * 0.5)).as_int(), (p_r - axis * (band_h * 0.5)).as_int(), max(1, int(s)))
            # Refined sleek silver gothic side-buckle hugging the outer leather edge
            bc = center + nrm * (half_w * 0.56)
            bw = 1.45 * s
            bh = 1.35 * s
            b_rect = [
                (bc - nrm * bw - axis * bh).as_int(),
                (bc + nrm * bw - axis * bh).as_int(),
                (bc + nrm * bw + axis * bh).as_int(),
                (bc - nrm * bw + axis * bh).as_int(),
            ]
            pygame.draw.polygon(surf, b_sh, b_rect)
            pygame.draw.polygon(surf, b_mid, b_rect, max(1, int(1.0 * s)))
            pygame.draw.line(surf, b_hi, b_rect[0], b_rect[1], max(1, int(0.9 * s)))

    # --------------------------------------------------------------------------
    # Multi-Tiered 7-Pleat Gothic Lolita Miniskirt (Black + Scarlet + Lace)
    # --------------------------------------------------------------------------

    def _draw_tiered_lolita_skirt(
        self,
        surf: pygame.Surface,
        waist: Vec2,
        pelvis: Vec2,
        sk: SkirtPleatProfile,
        torso_yaw_deg: float,
        pal: CeciliaPalette,
        s: float,
    ) -> None:
        w_half = 11.5 * s * max(0.55, abs(math.cos(math.radians(torso_yaw_deg * 0.65))))
        w_l = waist + Vec2(-w_half, 1.5 * s)
        w_r = waist + Vec2(w_half, 1.5 * s)

        # Compute 7 explicit sculpted hem control points from SkirtPleatProfile
        hem_pts: List[Vec2] = []
        n_pleats = 7
        for i in range(n_pleats):
            u = i / float(n_pleats - 1)  # 0 (left) -> 1 (right)
            hx = waist.x + lerp(-sk.hem_spread_l, sk.hem_spread_r, u) * s + sk.sway_x * s
            lift = lerp(sk.lift_l, sk.lift_r, u) * s
            bell_arc = math.sin(u * math.pi) * (5.2 * s)
            wave = sk.pleat_wave[i] * (4.2 * s)
            hy = waist.y + sk.hem_drop * s + bell_arc - lift + wave
            hem_pts.append(Vec2(hx, hy))

        # Tier 4 (deepest under-layer): Dark scalloped lace petticoat protruding below hem
        petti_pts = [p + Vec2(0.0, 5.2 * s) for p in hem_pts]
        self.rast.paint_ruffle_strip(
            surf, petti_pts, depth=4.4 * s,
            col_hi=pal.cloth_black_hi, col_mid=pal.cloth_black_mid, col_deep=pal.cloth_black_deep,
            ink_color=INK_OBSIDIAN, scallops=9, down_dir=Vec2(0.0, 1.0),
        )

        # Tier 3: Glowing crimson inner scalloped ruffle hem (exact char.jpg double-tier!)
        inner_red_pts = [p + Vec2(0.0, 1.5 * s) for p in hem_pts]
        self.rast.paint_ruffle_strip(
            surf, inner_red_pts, depth=6.2 * s,
            col_hi=pal.cloth_red_hi, col_mid=pal.cloth_red_mid, col_deep=pal.cloth_red_deep,
            ink_color=INK_CRIMSON, scallops=10, down_dir=Vec2(0.0, 1.0),
        )

        # Tier 2: Black pleated ruffle overhang above crimson hem
        mid_blk_pts = [w_l.lerp(w_r, i / float(n_pleats - 1)).lerp(hem_pts[i], 0.80) for i in range(n_pleats)]
        self.rast.paint_ruffle_strip(
            surf, mid_blk_pts, depth=6.6 * s,
            col_hi=pal.cloth_black_hi, col_mid=pal.cloth_black_mid, col_deep=pal.cloth_black_deep,
            ink_color=INK_OBSIDIAN, scallops=9, down_dir=Vec2(0.0, 1.0),
        )

        # Tier 1: Sculpted bell-shaped black velvet upper box pleats with crimson center wedge!
        skirt_poly = [w_l, w_r] + list(reversed(mid_blk_pts))
        self.rast.paint_cg_poly(
            surf, skirt_poly,
            col_hi=pal.cloth_black_hi, col_mid=pal.cloth_black_mid, col_shadow=pal.cloth_black_deep,
            light_dir=(0.55, -0.83),
            rim_color=pal.hair_rim,
            rim_strength=0.30,
            bounce_color=(196, 26, 62),
            bounce_strength=0.20,
            ink_color=INK_OBSIDIAN,
            ink_width=1.8,
            volume_curve=0.38,
        )

        # Luminous crimson center wedge panel (char.jpg front/3-quarter iconic red insert!)
        c_u = clamp(0.5 + sk.center_panel_shift * 0.28, 0.22, 0.78)
        u_l = clamp(c_u - 0.17, 0.05, 0.85)
        u_r = clamp(c_u + 0.17, 0.15, 0.95)
        def sample_hem(pts_list: List[Vec2], u_val: float) -> Vec2:
            f = u_val * (len(pts_list) - 1)
            i0 = min(len(pts_list) - 2, int(f))
            return pts_list[i0].lerp(pts_list[i0 + 1], f - i0)

        wedge_poly = [
            w_l.lerp(w_r, clamp(c_u - 0.10, 0.1, 0.9)),
            w_l.lerp(w_r, clamp(c_u + 0.10, 0.1, 0.9)),
            sample_hem(mid_blk_pts, u_r),
            sample_hem(mid_blk_pts, c_u) + Vec2(0.0, 2.2 * s),
            sample_hem(mid_blk_pts, u_l),
        ]
        self.rast.paint_cg_poly(
            surf, wedge_poly,
            col_hi=pal.cloth_red_hi, col_mid=pal.cloth_red_mid, col_shadow=pal.cloth_red_deep,
            light_dir=(0.5, -0.86),
            ink_color=INK_CRIMSON,
            ink_width=1.4,
            volume_curve=0.30,
        )

        # Dimensional box-pleat crease lines radiating down from waist
        for i in range(1, n_pleats - 1):
            u = i / float(n_pleats - 1)
            top_p = w_l.lerp(w_r, u)
            bot_p = mid_blk_pts[i]
            pygame.draw.line(surf, with_alpha(pal.cloth_black_deep, 200), top_p.as_int(), bot_p.as_int(), max(1, int(1.3 * s)))
            pygame.draw.line(surf, with_alpha(pal.cloth_black_hi, 110), (top_p + Vec2(1.4 * s, 0)).as_int(), (bot_p + Vec2(1.8 * s, 0)).as_int(), 1)

        # Scarlet upper ruffle ribbon bordering the upper skirt edge
        upper_red_pts = [w_l.lerp(w_r, i / float(n_pleats - 1)).lerp(hem_pts[i], 0.68) for i in range(n_pleats)]
        self.rast.paint_ruffle_strip(
            surf, upper_red_pts, depth=4.6 * s,
            col_hi=pal.cloth_red_hi, col_mid=pal.cloth_red_mid, col_deep=pal.cloth_red_deep,
            ink_color=INK_CRIMSON, scallops=9, down_dir=Vec2(0.0, 1.0),
        )

    # --------------------------------------------------------------------------
    # Gothic Lolita Corset Bodice, Scarlet Plastron, High Collar, Ruby & Belt
    # --------------------------------------------------------------------------

    def _draw_gothic_bodice(
        self,
        surf: pygame.Surface,
        waist: Vec2,
        chest: Vec2,
        neck: Vec2,
        torso_yaw_deg: float,
        torso_lean_deg: float,
        pal: CeciliaPalette,
        s: float,
    ) -> None:
        yaw_rad = math.radians(torso_yaw_deg)
        yaw_cos = max(0.36, abs(math.cos(yaw_rad)))
        yaw_sin = math.sin(yaw_rad)
        spine = (chest - waist).normalized()
        right = Vec2(-spine.y, spine.x)

        w_w = 10.6 * s * max(0.55, yaw_cos)
        c_w = 13.8 * s * max(0.58, yaw_cos)
        bust_fwd = yaw_sin * (4.2 * s)

        # Sculpted hourglass gothic corset silhouette
        bodice_poly = [
            waist - right * w_w,
            chest - right * (c_w * 0.94),
            neck - right * (6.2 * s * yaw_cos),
            neck + right * (6.2 * s * yaw_cos),
            chest + right * (c_w + max(0.0, bust_fwd * 0.35)),
            waist.lerp(chest, 0.42) + right * (w_w * 0.88 + max(0.0, bust_fwd * 0.2)),
            waist + right * w_w,
        ]
        self.rast.paint_cg_poly(
            surf, bodice_poly,
            col_hi=pal.cloth_black_hi, col_mid=pal.cloth_black_mid, col_shadow=pal.cloth_black_deep,
            light_dir=(0.56, -0.82),
            rim_color=pal.hair_rim,
            rim_strength=0.34,
            ink_color=INK_OBSIDIAN,
            ink_width=1.8,
            volume_curve=0.40,
        )

        # Front vertical scarlet ruffled plastron (visible unless turned full back!)
        if abs(torso_yaw_deg) < 118.0:
            shift = right * (yaw_sin * 5.6 * s)
            p_w = 5.4 * s * max(0.32, yaw_cos)
            plastron = [
                waist + shift - right * (p_w * 0.72),
                chest + shift - right * p_w,
                neck + shift - right * (p_w * 0.75),
                neck + shift + right * (p_w * 0.75),
                chest + shift + right * p_w,
                waist + shift + right * (p_w * 0.72),
            ]
            self.rast.paint_cg_poly(
                surf, plastron,
                col_hi=pal.cloth_red_hi, col_mid=pal.cloth_red_mid, col_shadow=pal.cloth_red_deep,
                light_dir=(0.48, -0.88),
                ink_color=INK_CRIMSON,
                ink_width=1.3,
                volume_curve=0.30,
            )
            # Decorative gothic bodice buttons / lacing ticks down center plastron
            for k in range(1, 5):
                bp = waist.lerp(chest, k / 5.0) + shift
                pygame.draw.circle(surf, pal.cloth_red_deep, bp.as_int(), max(1, int(1.3 * s)))
                pygame.draw.circle(surf, pal.cloth_red_hi, (bp + Vec2(0.5 * s, -0.5 * s)).as_int(), max(1, int(0.6 * s)))

            # Cascading pleated scarlet jabot cravat at upper chest!
            j_top = neck + shift + spine * (-1.5 * s)
            j_bot = chest + shift + spine * (-1.5 * s)
            jabot_poly = [
                j_top - right * (2.6 * s),
                j_top + right * (2.6 * s),
                j_bot + right * (6.2 * s * max(0.45, yaw_cos)),
                j_bot + spine * (-3.2 * s),
                j_bot - right * (6.2 * s * max(0.45, yaw_cos)),
            ]
            self.rast.paint_cg_poly(
                surf, jabot_poly,
                col_hi=pal.cloth_red_hi, col_mid=pal.cloth_red_mid, col_shadow=pal.cloth_red_deep,
                light_dir=(0.42, -0.90),
                ink_color=INK_CRIMSON,
                ink_width=1.4,
            )
            # Jabot pleat lines
            for jf in (-0.45, 0.0, 0.45):
                pygame.draw.line(
                    surf, pal.cloth_red_deep,
                    j_top.as_int(),
                    (j_bot + right * (jf * 5.2 * s)).as_int(),
                    1,
                )

        # High gothic mandarin stand collar + crimson frill trim + oval RUBY BROOCH
        col_w = 5.8 * s * max(0.55, yaw_cos)
        col_h = 5.4 * s
        collar_poly = [
            neck - right * col_w - spine * (1.2 * s),
            neck + right * col_w - spine * (1.2 * s),
            neck + right * (col_w * 0.92) + spine * col_h,
            neck - right * (col_w * 0.92) + spine * col_h,
        ]
        self.rast.paint_cg_poly(
            surf, collar_poly,
            col_hi=pal.cloth_black_hi, col_mid=pal.cloth_black_mid, col_shadow=pal.cloth_black_deep,
            ink_color=INK_OBSIDIAN, ink_width=1.5,
        )
        # Scarlet top frill edge on collar
        pygame.draw.line(
            surf, pal.cloth_red_hi,
            (neck - right * col_w + spine * col_h).as_int(),
            (neck + right * col_w + spine * col_h).as_int(),
            max(1, int(1.6 * s)),
        )
        # Glowing oval ruby brooch in silver bezel at throat!
        if abs(torso_yaw_deg) < 110.0:
            gem_c = neck + right * (yaw_sin * 4.2 * s) + spine * (1.2 * s)
            pygame.draw.circle(surf, pal.buckle_hi, gem_c.as_int(), max(2, int(2.7 * s)))
            pygame.draw.circle(surf, pal.gem_mid, gem_c.as_int(), max(1, int(2.0 * s)))
            pygame.draw.circle(surf, pal.gem_hi, (gem_c + Vec2(-0.6 * s, -0.6 * s)).as_int(), max(1, int(0.9 * s)))

        # Wide cinched black leather waist belt with polished silver buckle!
        b_h = 3.8 * s
        belt_poly = [
            waist - right * (w_w * 1.06) + spine * b_h,
            waist + right * (w_w * 1.06) + spine * b_h,
            waist + right * (w_w * 1.08) - spine * (b_h * 0.75),
            waist - right * (w_w * 1.08) - spine * (b_h * 0.75),
        ]
        self.rast.paint_cg_poly(
            surf, belt_poly,
            col_hi=pal.leather_hi, col_mid=pal.leather_mid, col_shadow=pal.leather_deep,
            spec_pos=waist + right * (w_w * 0.3),
            spec_color=pal.leather_spec,
            spec_radius=5.0 * s,
            ink_color=INK_OBSIDIAN,
            ink_width=1.6,
        )
        if abs(torso_yaw_deg) < 115.0:
            bk_c = waist + right * (yaw_sin * 4.5 * s) + spine * (0.4 * s)
            bw, bh = 3.6 * s, 2.8 * s
            bk_poly = [
                (bk_c - right * bw + spine * bh).as_int(),
                (bk_c + right * bw + spine * bh).as_int(),
                (bk_c + right * bw - spine * bh).as_int(),
                (bk_c - right * bw - spine * bh).as_int(),
            ]
            pygame.draw.polygon(surf, pal.buckle_shadow, bk_poly)
            pygame.draw.polygon(surf, pal.buckle_hi, bk_poly, max(1, int(1.5 * s)))

    # --------------------------------------------------------------------------
    # Sculpted Juliet Sleeves (Puffed Upper Sleeve + Fitted Forearm + Scarlet Cuff)
    # --------------------------------------------------------------------------

    def _draw_juliet_arm(
        self,
        surf: pygame.Surface,
        shoulder: Vec2,
        elbow: Vec2,
        hand: Vec2,
        puff_scale: float,
        pal: CeciliaPalette,
        s: float,
        is_far: bool,
    ) -> None:
        dim = 0.85 if is_far else 1.0
        b_hi = scale_rgb(pal.cloth_black_hi, dim)
        b_mid = scale_rgb(pal.cloth_black_mid, dim)
        b_dp = scale_rgb(pal.cloth_black_deep, dim)
        r_hi = scale_rgb(pal.cloth_red_hi, dim)
        r_mid = scale_rgb(pal.cloth_red_mid, dim)
        r_dp = scale_rgb(pal.cloth_red_deep, dim)

        # Fitted tapered black forearm sleeve (elbow -> wrist)
        wrist = elbow.lerp(hand, 0.84)
        forearm_poly = build_anatomical_contour(
            elbow, wrist,
            w0=4.6 * s, w1=3.2 * s,
            bulge_l=0.6 * s, bulge_r=0.4 * s,
            steps=8,
        )
        self.rast.paint_cg_poly(
            surf, forearm_poly, b_hi, b_mid, b_dp,
            light_dir=(0.55, -0.84),
            rim_color=pal.hair_rim if not is_far else None,
            rim_strength=0.28,
            ink_color=INK_OBSIDIAN,
            ink_width=1.6,
            volume_curve=0.38,
        )

        # Flared scarlet pleated wrist cuff framing the hand (char.jpg exact!)
        f_dir = (hand - elbow).normalized()
        f_nrm = f_dir.perp()
        cuff_base = wrist - f_dir * (1.8 * s)
        cuff_tip = wrist + f_dir * (4.2 * s)
        cuff_poly = [
            cuff_base - f_nrm * (3.6 * s),
            cuff_base + f_nrm * (3.6 * s),
            cuff_tip + f_nrm * (6.2 * s),
            cuff_tip + f_dir * (1.5 * s),
            cuff_tip - f_nrm * (6.2 * s),
        ]
        self.rast.paint_cg_poly(
            surf, cuff_poly, r_hi, r_mid, r_dp,
            light_dir=(0.5, -0.86),
            ink_color=INK_CRIMSON,
            ink_width=1.5,
        )

        # Voluminous gothic-lolita Juliet puffed upper sleeve (shoulder -> mid-upper-arm)
        mid_upper = shoulder.lerp(elbow, 0.62)
        u_dir = (elbow - shoulder).normalized()
        u_nrm = u_dir.perp()
        puff_w = 8.4 * s * clamp(puff_scale, 0.72, 1.35)
        puff_poly = build_anatomical_contour(
            shoulder - u_dir * (2.0 * s),
            mid_upper,
            w0=5.2 * s,
            w1=4.4 * s,
            bulge_l=puff_w * 0.74,
            bulge_r=puff_w * 0.88,
            bulge_t=0.48,
            steps=12,
        )
        self.rast.paint_cg_poly(
            surf, puff_poly, b_hi, b_mid, b_dp,
            light_dir=(0.58, -0.81),
            rim_color=pal.cloth_red_hi if not is_far else pal.hair_rim,
            rim_strength=0.38,
            spec_pos=shoulder.lerp(mid_upper, 0.35) + u_nrm * (2.5 * s),
            spec_color=scale_rgb(pal.cloth_red_hi, 0.45),
            spec_radius=7.5 * s,
            ink_color=INK_OBSIDIAN,
            ink_width=1.8,
            volume_curve=0.46,
        )
        # Buckled leather upper-arm band cinching the Juliet puff!
        band_a = mid_upper - u_nrm * (4.8 * s)
        band_b = mid_upper + u_nrm * (4.8 * s)
        pygame.draw.line(surf, pal.leather_deep, band_a.as_int(), band_b.as_int(), max(2, int(2.6 * s)))
        pygame.draw.circle(surf, pal.buckle_hi, (mid_upper + u_nrm * (1.8 * s)).as_int(), max(1, int(1.3 * s)))

        # Crimson ruffled shoulder seam trim
        sh_a = shoulder - u_nrm * (5.2 * s)
        sh_b = shoulder + u_nrm * (5.2 * s)
        pygame.draw.line(surf, r_hi, sh_a.as_int(), sh_b.as_int(), max(1, int(2.0 * s)))

    def _draw_grip_hand(
        self, surf: pygame.Surface, hand: Vec2, pal: CeciliaPalette, s: float, is_far: bool
    ) -> None:
        dim = 0.86 if is_far else 1.0
        r = 3.8 * s
        pts = [
            hand + Vec2(-r, -r * 0.65),
            hand + Vec2(r * 0.85, -r * 0.85),
            hand + Vec2(r * 1.1, r * 0.35),
            hand + Vec2(r * 0.35, r * 0.95),
            hand + Vec2(-r * 0.85, r * 0.72),
        ]
        self.rast.paint_cg_poly(
            surf, pts,
            scale_rgb(pal.skin_hi, dim),
            scale_rgb(pal.skin_mid, dim),
            scale_rgb(pal.skin_shadow, dim),
            ink_color=INK_SKIN,
            ink_width=1.4,
        )

    # --------------------------------------------------------------------------
    # Multi-Azimuth Anime Head, Golden Eyes, Bangs & Cheek-Framing Sidelocks
    # --------------------------------------------------------------------------

    def _draw_anime_head(
        self,
        surf: pygame.Surface,
        head: Vec2,
        neck: Vec2,
        azimuth: HeadAzimuth,
        tilt_deg: float,
        gaze_x: float,
        gaze_y: float,
        expr: ExpressionId,
        hair: HairFlowSpec,
        pal: CeciliaPalette,
        s: float,
        eclipse_mode: bool,
    ) -> None:
        # Slender porcelain neck with delicate chin cast shadow
        neck_poly = build_anatomical_contour(neck, head + Vec2(0.0, 5.2 * s), 3.3 * s, 2.9 * s, steps=5)
        self.rast.paint_cg_poly(
            surf, neck_poly, pal.skin_mid, pal.skin_shadow, scale_rgb(pal.skin_shadow, 0.80),
            ink_color=INK_SKIN, ink_width=1.2,
        )

        rad = math.radians(tilt_deg)
        hx = Vec2(math.cos(rad), math.sin(rad))
        hy = Vec2(-math.sin(rad), math.cos(rad))

        def hp(lx: float, ly: float) -> Vec2:
            return head + hx * (lx * s) + hy * (ly * s)

        # Lush smooth rounded anime hair crown dome behind face
        skull_ctrl = [
            hp(-12.8, -10.5), hp(-7.2, -16.2), hp(1.5, -17.2), hp(9.8, -14.2),
            hp(13.6, -6.5), hp(12.2, 4.5), hp(4.5, 11.2), hp(-6.8, 10.6), hp(-13.4, 2.0),
        ]
        skull_poly = sample_catmull_rom(skull_ctrl, steps_per_seg=4, closed=True)
        self.rast.paint_cg_poly(
            surf, skull_poly, pal.hair_mid, pal.hair_base, pal.hair_deep,
            light_dir=(0.42, -0.90), rim_color=pal.hair_rim, rim_strength=0.42,
            ink_color=INK_OBSIDIAN, ink_width=1.6, volume_curve=0.42,
        )

        if azimuth == HeadAzimuth.BACK:
            back_dome = sample_catmull_rom(
                [hp(-12.5, -10.0), hp(0.0, -17.0), hp(12.5, -10.0), hp(13.0, 3.5), hp(6.5, 11.8), hp(-6.5, 11.8), hp(-13.0, 3.5)],
                steps_per_seg=4, closed=True,
            )
            self.rast.paint_cg_poly(
                surf, back_dome, pal.hair_mid, pal.hair_base, pal.hair_deep,
                spec_pos=hp(0.0, -7.5), spec_color=pal.hair_sheen, spec_radius=8.5 * s,
                rim_color=pal.hair_rim, rim_strength=0.48,
                ink_color=INK_OBSIDIAN, ink_width=1.6,
            )
            return

        # Smooth Catmull-Rom Pixiv/Danbooru anime oval chin & delicate cheek contour!
        if azimuth == HeadAzimuth.PROFILE:
            face_ctrl = [
                hp(-7.2, -9.8), hp(6.4, -9.8), hp(9.8, -2.5), hp(11.6, 1.8),
                hp(9.8, 4.4), hp(9.9, 7.6), hp(6.2, 11.4), hp(-1.8, 10.8), hp(-8.0, 3.5),
            ]
            face_shift = 4.2
        elif azimuth == HeadAzimuth.FRONT:
            face_ctrl = [
                hp(-9.8, -9.2), hp(0.0, -10.8), hp(9.8, -9.2), hp(10.0, 1.6),
                hp(6.8, 8.6), hp(0.0, 12.2), hp(-6.8, 8.6), hp(-10.0, 1.6),
            ]
            face_shift = 0.0
        elif azimuth == HeadAzimuth.THREE_QUARTER_BACK:
            face_ctrl = [
                hp(-3.5, -9.0), hp(8.2, -8.8), hp(10.8, -0.5),
                hp(9.8, 6.8), hp(5.0, 11.4), hp(-3.2, 9.2),
            ]
            face_shift = 5.0
        else:
            v_off = -1.4 if azimuth == HeadAzimuth.TILTED_UP else (1.6 if azimuth == HeadAzimuth.TILTED_DOWN else 0.0)
            face_ctrl = [
                hp(-9.2, -9.4 + v_off), hp(0.4, -10.6 + v_off), hp(9.0, -9.0 + v_off),
                hp(10.8, -0.4 + v_off), hp(9.6, 5.8 + v_off), hp(4.6, 11.6 + v_off),
                hp(-2.4, 10.8 + v_off), hp(-8.6, 5.4 + v_off), hp(-9.6, -1.2 + v_off),
            ]
            face_shift = 2.4

        face_poly = sample_catmull_rom(face_ctrl, steps_per_seg=4, closed=True)
        self.rast.paint_cg_poly(
            surf, face_poly, pal.skin_hi, pal.skin_mid, pal.skin_shadow,
            light_dir=(0.54, -0.84),
            rim_color=pal.hair_rim,
            rim_strength=0.16,
            ink_color=INK_SKIN,
            ink_width=1.35,
            cel_cut=0.38,
            volume_curve=0.28,
        )

        # Delicate rosy anime cheek blush airbrush
        blush_c = hp(face_shift + 3.4, 4.4)
        self.rast.stamp_bloom(surf, blush_c.x, blush_c.y, 4.2 * s, pal.skin_blush, alpha=72, additive=False)
        if azimuth == HeadAzimuth.FRONT:
            blush_l = hp(-5.2, 4.4)
            self.rast.stamp_bloom(surf, blush_l.x, blush_l.y, 4.2 * s, pal.skin_blush, alpha=72, additive=False)

        # Vibrant almond-shaped serene GOLDEN-YELLOW ANIME EYES (char.jpg!)
        eye_y = 0.2 + (-1.3 if azimuth == HeadAzimuth.TILTED_UP else (1.3 if azimuth == HeadAzimuth.TILTED_DOWN else 0.0))
        if azimuth == HeadAzimuth.FRONT:
            eye_specs = ((hp(-4.6, eye_y), 3.1, 0.96, -1.0), (hp(4.6, eye_y), 3.1, 0.96, 1.0))
        elif azimuth in (HeadAzimuth.PROFILE, HeadAzimuth.THREE_QUARTER_BACK):
            eye_specs = ((hp(face_shift + 2.6, eye_y), 2.5, 0.72, 1.0),)
        else:
            eye_specs = (
                (hp(face_shift - 3.6, eye_y), 2.65, 0.84, -1.0),
                (hp(face_shift + 4.0, eye_y), 3.05, 0.96, 1.0),
            )

        for ec, ew, aspect, side_sign in eye_specs:
            self._draw_golden_anime_eye(
                surf, ec, ew * s, aspect, side_sign, gaze_x, gaze_y, expr, pal, s, eclipse_mode
            )

        # Tiny delicate anime nose shadow fleck
        nose_p = hp(face_shift + 1.8, 3.6)
        pygame.draw.line(
            surf, pal.skin_shadow,
            nose_p.as_int(), (nose_p + hy * (1.2 * s) - hx * (0.4 * s)).as_int(),
            max(1, int(0.9 * s)),
        )

        # Serene delicate rose-tinted anime lips / expressive mouth
        mouth_c = hp(face_shift + 1.2, 7.6)
        lip_col = (182, 88, 106)
        if expr == ExpressionId.FIERCE_CRY:
            m_poly = [
                (mouth_c + hx * (-2.4 * s) + hy * (-0.7 * s)).as_int(),
                (mouth_c + hx * (2.4 * s) + hy * (-0.7 * s)).as_int(),
                (mouth_c + hx * (1.7 * s) + hy * (2.3 * s)).as_int(),
                (mouth_c + hx * (-1.7 * s) + hy * (2.3 * s)).as_int(),
            ]
            pygame.draw.polygon(surf, (132, 26, 48), m_poly)
            pygame.draw.line(surf, (255, 248, 250), m_poly[0], m_poly[1], max(1, int(0.9 * s)))
        elif expr == ExpressionId.GRITTED_TEETH:
            m_poly = [
                (mouth_c + hx * (-2.2 * s) + hy * (-0.5 * s)).as_int(),
                (mouth_c + hx * (2.2 * s) + hy * (-0.5 * s)).as_int(),
                (mouth_c + hx * (1.9 * s) + hy * (1.1 * s)).as_int(),
                (mouth_c + hx * (-1.9 * s) + hy * (1.1 * s)).as_int(),
            ]
            pygame.draw.polygon(surf, (255, 248, 250), m_poly)
            pygame.draw.polygon(surf, INK_SKIN, m_poly, 1)
        elif expr == ExpressionId.STUNNED_PAIN:
            pygame.draw.ellipse(surf, (136, 36, 58), (int(mouth_c.x - 1.8 * s), int(mouth_c.y - 1.2 * s), max(2, int(3.6 * s)), max(2, int(2.6 * s))))
        elif expr in (ExpressionId.CONFIDENT_SMIRK, ExpressionId.NOBLE_VICTORY):
            pts_m = [
                (mouth_c + hx * (-2.0 * s) + hy * (0.2 * s)).as_int(),
                (mouth_c + hx * (0.2 * s) + hy * (0.7 * s)).as_int(),
                (mouth_c + hx * (2.4 * s) + hy * (-0.6 * s)).as_int(),
            ]
            pygame.draw.lines(surf, lip_col, False, pts_m, max(1, int(1.0 * s)))
        else:
            # Subtle graceful serene anime lip curve with gentle shadow
            pts_m = [
                (mouth_c + hx * (-1.8 * s) + hy * (0.1 * s)).as_int(),
                (mouth_c + hx * (0.0 * s) + hy * (0.4 * s)).as_int(),
                (mouth_c + hx * (1.8 * s) + hy * (0.0 * s)).as_int(),
            ]
            pygame.draw.lines(surf, lip_col, False, pts_m, max(1, int(1.0 * s)))
            pygame.draw.circle(surf, pal.skin_blush, (mouth_c + hy * (1.0 * s)).as_int(), max(1, int(0.8 * s)))

        # Seamless lush glossy anime crown hair cap covering upper forehead (char.jpg!)
        crown_poly = sample_catmull_rom(
            [
                hp(-11.4, -7.8), hp(-9.8, -14.0), hp(-2.5, -16.6),
                hp(4.8, -15.6), hp(10.6, -11.4), hp(11.4, -5.8),
                hp(6.8, -8.0), hp(0.5, -8.8), hp(-6.4, -8.0),
            ],
            steps_per_seg=4, closed=True,
        )
        self.rast.paint_cg_poly(
            surf, crown_poly, pal.hair_mid, pal.hair_base, pal.hair_deep,
            light_dir=(0.45, -0.88), rim_color=pal.hair_rim, rim_strength=0.38,
            spec_pos=hp(-1.0, -11.5), spec_color=pal.hair_sheen, spec_radius=7.0 * s,
            ink_color=INK_OBSIDIAN, ink_width=1.4, volume_curve=0.38,
        )

        # Silky feathered anime forehead bangs curving organically around eyes (char.jpg!)
        bl = hair.bangs_lift * s
        bang_specs = (
            (hp(-9.8, -12.6), hp(-11.4, -5.4), hp(-9.2, 1.8 - bl), 2.8),
            (hp(-6.2, -13.8), hp(-7.2, -6.2), hp(-5.2, 0.2 - bl), 2.6),
            (hp(-2.0, -14.6), hp(-1.8, -6.8), hp(-0.4, 0.8 - bl), 2.9),
            (hp(2.6, -14.4), hp(3.8, -6.8), hp(4.2, -0.4 - bl), 2.5),
            (hp(6.8, -13.2), hp(9.4, -6.2), hp(10.0, 0.8 - bl), 2.6),
        )
        for b0, b1, b2, bw in bang_specs:
            sp = sample_quad_bezier(b0, b1, b2, steps=10)
            ws = [lerp(bw * s, 0.25 * s, (i / 10.0) ** 1.15) for i in range(11)]
            self.rast.paint_glossy_hair_strand(
                surf, sp, ws, pal, sheen_u=0.38, rim_side=1.0, ink_width=1.2, internal_strands=1
            )

        # Iconic cute silky cheek-framing sidelocks curving inward past jaw (char.jpg!)
        sl_l = sample_cubic_bezier(
            hp(-10.2, -8.8),
            hp(-13.6 + hair.sidelock_l_sway * 0.35, 1.5),
            hp(-12.2 + hair.sidelock_l_sway * 0.75, 12.2),
            hp(-7.8 + hair.sidelock_l_sway * 1.05, 22.8),
            steps=12,
        )
        ws_sl = [lerp(2.8 * s, 0.25 * s, (i / 12.0) ** 0.92) for i in range(13)]
        self.rast.paint_glossy_hair_strand(
            surf, sl_l, ws_sl, pal, sheen_u=0.36, rim_side=-0.8, ink_width=1.3, internal_strands=1
        )
        if azimuth != HeadAzimuth.PROFILE:
            sl_r = sample_cubic_bezier(
                hp(9.8, -8.2),
                hp(12.6 + hair.sidelock_r_sway * 0.35, 1.8),
                hp(11.4 + hair.sidelock_r_sway * 0.75, 11.8),
                hp(7.4 + hair.sidelock_r_sway * 1.0, 21.5),
                steps=12,
            )
            self.rast.paint_glossy_hair_strand(
                surf, sl_r, ws_sl, pal, sheen_u=0.38, rim_side=0.9, ink_width=1.3, internal_strands=1
            )

    def _draw_golden_anime_eye(
        self,
        surf: pygame.Surface,
        center: Vec2,
        w: float,
        aspect: float,
        side_sign: float,
        gaze_x: float,
        gaze_y: float,
        expr: ExpressionId,
        pal: CeciliaPalette,
        s: float,
        eclipse_mode: bool,
    ) -> None:
        """
        True Pixiv/Danbooru serene almond anime eye:
          - Graceful arched winged dark upper eyelash & delicate lower lash
          - Smooth vertical-oval golden-yellow iris clipped cleanly under eyelid
          - Deep warm amber upper iris shadow, luminous gold body, bright lemon lower arc
          - Crisp twin white catchlights & delicate slender curved anime eyebrow!
        """
        h = w * 0.68  # Elegant almond height (NOT circular bug-eyes!)
        cx, cy = center.x, center.y
        if expr == ExpressionId.CLOSED_EYES_CALM:
            pts = [
                (int(cx - w * aspect), int(cy)),
                (int(cx), int(cy + h * 0.36)),
                (int(cx + w * aspect), int(cy - h * 0.12)),
            ]
            pygame.draw.lines(surf, INK_OBSIDIAN, False, pts, max(1, int(1.4 * s)))
            return

        # Dedicated small eye patch so iris clips cleanly inside the almond eyelid!
        ew_i = max(8, int(w * aspect * 2.6))
        eh_i = max(8, int(h * 3.0))
        eye_s = pygame.Surface((ew_i, eh_i), pygame.SRCALPHA)
        mask_s = pygame.Surface((ew_i, eh_i), pygame.SRCALPHA)
        ecx, ecy = ew_i * 0.5, eh_i * 0.52

        almond = [
            (int(ecx - w * aspect), int(ecy + h * 0.08)),
            (int(ecx - w * 0.42 * aspect), int(ecy - h * 0.78)),
            (int(ecx + w * 0.48 * aspect), int(ecy - h * 0.74)),
            (int(ecx + w * aspect), int(ecy + h * 0.02)),
            (int(ecx + w * 0.55 * aspect), int(ecy + h * 0.68)),
            (int(ecx - w * 0.52 * aspect), int(ecy + h * 0.68)),
        ]
        pygame.draw.polygon(mask_s, (255, 255, 255, 255), almond)
        # Soft shaded porcelain-white sclera with delicate upper eyelid shadow tint
        pygame.draw.polygon(eye_s, (252, 248, 252, 255), almond)
        pygame.draw.rect(eye_s, (218, 206, 224, 115), (0, 0, ew_i, int(ecy - h * 0.18)))

        # Oval golden-yellow anime iris filling ~70% of almond aperture (char.jpg!)
        ix = ecx + clamp(gaze_x, -0.55, 0.55) * w * 0.22
        iy = ecy + clamp(gaze_y, -0.4, 0.4) * h * 0.16 + h * 0.04
        irx = max(2, int(w * 0.62 * aspect))
        iry = max(2, int(h * 0.86))
        pygame.draw.ellipse(eye_s, pal.eye_iris_dark, (int(ix - irx), int(iy - iry), irx * 2, iry * 2))
        pygame.draw.ellipse(eye_s, pal.eye_iris_mid, (int(ix - irx * 0.86), int(iy - iry * 0.68), max(2, int(irx * 1.72)), max(2, int(iry * 1.56))))
        pygame.draw.ellipse(eye_s, pal.eye_iris_hi, (int(ix - irx * 0.76), int(iy - iry * 0.25), max(2, int(irx * 1.52)), max(2, int(iry * 1.15))))
        # Luminous lemon-gold lower crescent reflection!
        pygame.draw.ellipse(eye_s, pal.eye_glow, (int(ix - irx * 0.54), int(iy + iry * 0.12), max(2, int(irx * 1.08)), max(2, int(iry * 0.62))))
        # Crisp dark pupil & upper iris shadow arc
        pr = max(1, int(irx * 0.36))
        pygame.draw.circle(eye_s, (36, 16, 20), (int(ix), int(iy)), pr)
        # Twin bright white anime catchlights
        pygame.draw.circle(eye_s, (255, 255, 255), (int(ix - irx * 0.42), int(iy - iry * 0.32)), max(1, int(irx * 0.30)))
        pygame.draw.circle(eye_s, (255, 252, 240), (int(ix + irx * 0.34), int(iy + iry * 0.34)), max(1, int(irx * 0.16)))

        # Clip iris cleanly inside almond eye opening!
        eye_s.blit(mask_s, (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
        surf.blit(eye_s, (int(cx - ecx), int(cy - ecy)))

        if eclipse_mode or expr == ExpressionId.ECLIPSE_TRANCE:
            self.rast.stamp_bloom(surf, cx, cy, w * 1.8, pal.eye_iris_hi, alpha=125, additive=True)

        # Graceful tapered winged dark anime upper eyelash + subtle lower lash
        tilt = 0.22 if expr in (ExpressionId.FIERCE_CRY, ExpressionId.FOCUSED_BATTLE, ExpressionId.GRITTED_TEETH) else 0.0
        upper_lash = [
            (int(cx - w * 1.06 * aspect), int(cy - h * (0.04 - tilt))),
            (int(cx - w * 0.38 * aspect), int(cy - h * (0.86 - tilt * 0.4))),
            (int(cx + w * 0.46 * aspect), int(cy - h * (0.82 + tilt * 0.2))),
            (int(cx + w * 1.18 * aspect), int(cy - h * (0.22 + tilt * 0.2))),
        ]
        pygame.draw.lines(surf, INK_OBSIDIAN, False, upper_lash, max(2, int(1.65 * s)))
        # Delicate lower lid crease
        pygame.draw.line(
            surf, (96, 54, 68),
            (int(cx - w * 0.48 * aspect), int(cy + h * 0.72)),
            (int(cx + w * 0.56 * aspect), int(cy + h * 0.70)),
            max(1, int(0.8 * s)),
        )
        # Slender, refined curved anime eyebrow (NOT a heavy black rectangle!)
        brow_y = cy - h * 1.48
        b_ang = h * (0.34 if expr in (ExpressionId.FIERCE_CRY, ExpressionId.GRITTED_TEETH) else -0.14) * side_sign
        brow_pts = [
            (int(cx - w * 0.85 * aspect), int(brow_y + b_ang)),
            (int(cx), int(brow_y - h * 0.22)),
            (int(cx + w * 0.92 * aspect), int(brow_y - b_ang * 0.65)),
        ]
        pygame.draw.lines(surf, pal.hair_deep, False, brow_pts, max(1, int(0.95 * s)))

    # --------------------------------------------------------------------------
    # True 3D-Perspective Demonic Two-Handed Cursed Greatsword (char.jpg & mockup.jpg!)
    # --------------------------------------------------------------------------

    def _draw_cursed_greatsword(
        self,
        surf: pygame.Surface,
        sw: SwordPose3D,
        pal: CeciliaPalette,
        s: float,
        ox: float,
        oy: float,
        eclipse_mode: bool,
        frame_seed: int,
    ) -> None:
        def sp(xy: Pt2) -> Vec2:
            return Vec2(ox + xy[0] * s, oy + xy[1] * s)

        hilt = sp(sw.hilt_xy)
        guard = sp(sw.guard_xy)
        mid = sp(sw.mid_xy)
        tip = sp(sw.tip_xy)

        blade_vec = tip - guard
        blade_len = blade_vec.length()
        if blade_len < 4.0:
            return
        b_fwd = blade_vec / blade_len
        b_nrm = b_fwd.perp()

        # True 3D-foreshortened widths along base -> belly -> spear-tip!
        w_base = max(1.8, sw.blade_width_base * s)
        w_mid = max(2.2, sw.blade_width_mid * s)
        w_tip = max(1.5, sw.blade_width_tip * s)
        vis = clamp(sw.flat_face_vis, 0.08, 1.0)
        aura = sw.aura_intensity * (1.35 if eclipse_mode else 1.0)

        # 0. Swirling cursed dark-crimson aura flames around the blade (char.jpg!)
        if aura > 0.12:
            self.rast.stamp_bloom(
                surf, mid.x, mid.y, max(24.0 * s, blade_len * 0.34),
                pal.aura_mid, alpha=clamp_int(int(95 * aura), 24, 175), additive=True
            )
            self.rast.stamp_bloom(
                surf, tip.x, tip.y, 20.0 * s,
                pal.rune_glow, alpha=clamp_int(int(105 * aura), 24, 185), additive=True
            )
            # Painterly flickering cursed smoke/flame tendrils curling off blade edges
            for t_idx in range(4):
                u = 0.20 + t_idx * 0.21
                anchor = eval_quad_bezier(guard, mid, tip, u)
                side = 1.0 if (t_idx % 2 == 0) else -1.0
                wave = math.sin(frame_seed * 0.45 + t_idx * 1.9) * 5.0 * s
                p1 = anchor + b_nrm * (side * (w_mid + 6.0 * s)) + Vec2(wave, -6.0 * s)
                p2 = anchor + b_nrm * (side * (w_mid + 12.0 * s)) + b_fwd * (12.0 * s) + Vec2(-wave, -14.0 * s)
                f_curve = sample_quad_bezier(anchor, p1, p2, steps=7)
                f_ws = [lerp(4.2 * s * aura, 0.3 * s, k / 7.0) for k in range(8)]
                _, _, f_poly = build_tapered_ribbon(f_curve, f_ws)
                if len(f_poly) >= 3:
                    pygame.draw.polygon(surf, with_alpha(pal.aura_outer, clamp_int(int(130 * aura), 25, 195)), [p.as_int() for p in f_poly])
                    pygame.draw.lines(surf, with_alpha(pal.aura_mid, clamp_int(int(180 * aura), 35, 240)), False, [p.as_int() for p in f_curve], max(1, int(1.6 * s)))

        # 1. Curved 3D-foreshortened greatsword blade spine (allows horizontal perspective bend!)
        spine_pts = sample_quad_bezier(guard, mid, tip, steps=12)
        left_edge: List[Vec2] = []
        right_edge: List[Vec2] = []
        for i, p in enumerate(spine_pts):
            u = i / 12.0
            if i == 0:
                tan = (spine_pts[1] - spine_pts[0]).normalized()
            elif i == 12:
                tan = (spine_pts[-1] - spine_pts[-2]).normalized()
            else:
                tan = (spine_pts[i + 1] - spine_pts[i - 1]).normalized()
            nrm = tan.perp()
            if u < 0.45:
                w = lerp(w_base, w_mid, smoothstep(u / 0.45))
            elif u < 0.84:
                w = lerp(w_mid, w_tip, smoothstep((u - 0.45) / 0.39))
            else:
                # Sharp demonic tapered spear tip!
                w = lerp(w_tip, 0.4 * s, smoothstep((u - 0.84) / 0.16))
            # Subtle gothic notched waist indent near guard (char.jpg sword silhouette!)
            if 0.08 < u < 0.18:
                w *= 0.82
            left_edge.append(p + nrm * w)
            right_edge.append(p - nrm * w)

        blade_poly = left_edge + [tip + b_fwd * (2.5 * s)] + list(reversed(right_edge))
        # Outer luminous razor-edged crimson-rimmed obsidian steel!
        self.rast.paint_cg_poly(
            surf, blade_poly,
            col_hi=pal.blade_edge,
            col_mid=pal.blade_mid,
            col_shadow=pal.blade_obsidian,
            light_dir=(b_nrm.x * 0.7 + 0.3, b_nrm.y * 0.7 - 0.5),
            rim_color=pal.rune_glow,
            rim_strength=0.68,
            ink_color=INK_OBSIDIAN,
            ink_width=1.8,
            cel_cut=0.52,
            volume_curve=0.25,
        )

        # Inner dark obsidian fuller & glowing crimson engraved demonic runes!
        if vis > 0.22:
            inner_l = [spine_pts[i].lerp(left_edge[i], 0.58) for i in range(1, 11)]
            inner_r = [spine_pts[i].lerp(right_edge[i], 0.58) for i in range(1, 11)]
            fuller_poly = inner_l + list(reversed(inner_r))
            self.rast.paint_cg_poly(
                surf, fuller_poly,
                col_hi=pal.blade_mid,
                col_mid=pal.blade_obsidian,
                col_shadow=(12, 5, 16),
                ink_color=pal.rune_glow,
                ink_width=1.1,
            )
            # Glowing arcane runes running down the central fuller!
            rg = clamp(sw.rune_glow, 0.2, 2.0)
            rune_a = clamp_int(int(210 * min(1.2, rg)), 60, 255)
            center_line = [p.as_int() for p in spine_pts[1:11]]
            pygame.draw.lines(surf, with_alpha(pal.rune_glow, rune_a), False, center_line, max(2, int(2.6 * s * vis)))
            pygame.draw.lines(surf, with_alpha(pal.rune_core, rune_a), False, center_line, max(1, int(1.2 * s * vis)))
            # Intricate stylized demonic arcane runes etched down the obsidian fuller!
            for k in range(2, 10):
                rp = spine_pts[k]
                tn = (spine_pts[k + 1] - spine_pts[k - 1]).normalized()
                rn = tn.perp() * (w_mid * 0.28 * vis)
                # Alternating angular Eldritch/Shinto seal strokes
                if k % 2 == 0:
                    g_pts = [
                        (rp - tn * (2.6 * s) - rn * 0.6).as_int(),
                        (rp + rn * 0.7).as_int(),
                        (rp + tn * (2.2 * s) - rn * 0.4).as_int(),
                    ]
                else:
                    g_pts = [
                        (rp - tn * (2.2 * s) + rn * 0.5).as_int(),
                        (rp - rn * 0.7).as_int(),
                        (rp + tn * (2.4 * s) + rn * 0.6).as_int(),
                    ]
                pygame.draw.lines(surf, with_alpha(pal.rune_core, rune_a), False, g_pts, max(1, int(1.1 * s)))

        # Bright metallic gleam along razor cutting edge
        pygame.draw.lines(surf, with_alpha(pal.blade_edge, 225), False, [p.as_int() for p in left_edge], max(1, int(1.4 * s)))
        pygame.draw.lines(surf, with_alpha(pal.rune_glow, 185), False, [p.as_int() for p in right_edge], max(1, int(1.2 * s)))

        # 2. Elongated leather-wrapped two-handed hilt & crimson crystal pommel!
        hilt_axis = (guard - hilt)
        if hilt_axis.length() > 2.0:
            h_poly = build_anatomical_contour(hilt, guard, 2.4 * s, 2.9 * s, steps=5)
            self.rast.paint_cg_poly(
                surf, h_poly, pal.guard_hi, pal.leather_mid, pal.leather_deep,
                ink_color=INK_OBSIDIAN, ink_width=1.4,
            )
            # Diamond hilt grip wrapping cross-hatch
            h_nrm = hilt_axis.normalized().perp()
            for k in range(1, 5):
                hp_c = hilt.lerp(guard, k / 5.0)
                pygame.draw.line(
                    surf, pal.cloth_red_mid,
                    (hp_c - h_nrm * (2.4 * s)).as_int(),
                    (hp_c + h_nrm * (2.4 * s)).as_int(),
                    max(1, int(1.1 * s)),
                )
            # Pointed crimson demonic crystal pommel
            h_back = -hilt_axis.normalized()
            pom_poly = [
                hilt + h_nrm * (3.6 * s),
                hilt + h_back * (6.2 * s),
                hilt - h_nrm * (3.6 * s),
                hilt - h_back * (2.0 * s),
            ]
            self.rast.paint_cg_poly(
                surf, pom_poly, pal.gem_hi, pal.gem_mid, pal.gem_deep,
                ink_color=INK_OBSIDIAN, ink_width=1.4,
            )

        # 3. Ornate Demonic Bat-Wing / Thorn-Scroll Crossguard (char.jpg exact!)
        g_vec = Vec2(sw.guard_span_x * s, sw.guard_span_y * s)
        if g_vec.length() < 3.0 * s:
            g_vec = b_nrm * (15.0 * s)
        guard_poly = [
            guard - g_vec * 1.15 - b_fwd * (2.2 * s),
            guard - g_vec * 0.65 + b_fwd * (7.2 * s),
            guard + b_fwd * (9.5 * s),
            guard + g_vec * 0.65 + b_fwd * (7.2 * s),
            guard + g_vec * 1.15 - b_fwd * (2.2 * s),
            guard + g_vec * 0.72 - b_fwd * (5.2 * s),
            guard - b_fwd * (3.2 * s),
            guard - g_vec * 0.72 - b_fwd * (5.2 * s),
        ]
        self.rast.paint_cg_poly(
            surf, guard_poly,
            col_hi=pal.guard_hi, col_mid=pal.guard_mid, col_shadow=pal.guard_deep,
            rim_color=pal.rune_glow,
            rim_strength=0.55,
            ink_color=INK_OBSIDIAN,
            ink_width=1.6,
        )
        # Blazing crimson diamond core jewel embedded in crossguard center!
        core_d = [
            (guard + b_fwd * (4.8 * s)).as_int(),
            (guard + g_vec * 0.24).as_int(),
            (guard - b_fwd * (3.2 * s)).as_int(),
            (guard - g_vec * 0.24).as_int(),
        ]
        pygame.draw.polygon(surf, pal.gem_mid, core_d)
        pygame.draw.polygon(surf, pal.gem_hi, core_d, max(1, int(1.1 * s)))

