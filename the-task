def _midi_to_hz(note: float) -> float:
    return 440.0 * (2.0 ** ((note - 69.0) / 12.0))


def _tanh_sat(x: float) -> float:
    # Fast smooth tape-warm soft-clipper
    if x > 2.8:
        return 0.992
    if x < -2.8:
        return -0.992
    return math.tanh(x)


def _pcm_add_inplace(dst: bytearray, offset_bytes: int, src: bytes, gain: float = 1.0) -> None:
    """
    C-accelerated stereo 16-bit PCM mixing via stdlib audioop (with pure-Python
    array('h') fallback for Python 3.13+). Guarantees zero clicks & blazing speed.
    """
    n_dst = len(dst)
    if offset_bytes >= n_dst or gain <= 0.002:
        return
    avail = min(len(src), n_dst - offset_bytes)
    avail -= avail & 3  # Strictly align to 4-byte stereo 16-bit frame boundary!
    if avail <= 0:
        return
    chunk = src[:avail]
    if _audioop is not None:
        if abs(gain - 1.0) > 0.01:
            chunk = _audioop.mul(chunk, 2, gain)
        dst[offset_bytes:offset_bytes + avail] = _audioop.add(
            bytes(dst[offset_bytes:offset_bytes + avail]), chunk, 2
        )
    else:
        a_dst = array.array("h")
        a_dst.frombytes(dst[offset_bytes:offset_bytes + avail])
        a_src = array.array("h")
        a_src.frombytes(chunk)
        for i in range(len(a_dst)):
            v = int(a_dst[i] + a_src[i] * gain)
            a_dst[i] = 32767 if v > 32767 else (-32768 if v < -32768 else v)
        dst[offset_bytes:offset_bytes + avail] = a_dst.tobytes()


def _pcm_scale_slice(dst: bytearray, offset_bytes: int, length_bytes: int, factor: float) -> None:
    n_dst = len(dst)
    if offset_bytes >= n_dst:
        return
    avail = min(length_bytes, n_dst - offset_bytes)
    avail -= avail & 3
    if avail <= 0:
        return
    if _audioop is not None:
        dst[offset_bytes:offset_bytes + avail] = _audioop.mul(
            bytes(dst[offset_bytes:offset_bytes + avail]), 2, factor
        )
    else:
        a = array.array("h")
        a.frombytes(dst[offset_bytes:offset_bytes + avail])
        for i in range(len(a)):
            a[i] = int(a[i] * factor)
        dst[offset_bytes:offset_bytes + avail] = a.tobytes()


def _floats_to_stereo_pcm(left: Sequence[float], right: Sequence[float], master_gain: float = 0.88) -> bytes:
    n = min(len(left), len(right))
    out = array.array("h", [0]) * (n * 2)
    scale = 32760.0 * master_gain
    for i in range(n):
        vl = int(_tanh_sat(left[i]) * scale)
        vr = int(_tanh_sat(right[i]) * scale)
        out[i * 2] = 32767 if vl > 32767 else (-32768 if vl < -32768 else vl)
        out[i * 2 + 1] = 32767 if vr > 32767 else (-32768 if vr < -32768 else vr)
    return out.tobytes()


def _wrap_pcm_as_wav(pcm_bytes: bytes, sample_rate: int = AUDIO_SAMPLE_RATE) -> bytes:
    bio = io.BytesIO()
    with wave.open(bio, "wb") as wf:
        wf.setnchannels(2)
        wf.setsampwidth(2)
        wf.setframerate(sample_rate)
        wf.writeframes(pcm_bytes)
    return bio.getvalue()


