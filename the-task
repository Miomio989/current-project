class CeciliaCelSculptor:
    """
    Hand-crafted multi-angle anime cel sculptor for Cecilia Darkmoon.
    Renders high-budget KoF XIII / BlazBlue / Danbooru-caliber CG sprites and
    full-resolution anime CG portraits entirely from procedural vector curves.
    """

    def __init__(self, rast: PainterlyRasterizer) -> None:
        self.rast = rast

    def render_cel(
        self,
        kf: CelFrameData,
        pal: CeciliaPalette,
        eclipse_mode: bool = False,
        frame_seed: int = 0,
        scale: float = 1.0,
    ) -> pygame.Surface:
        surf = pygame.Surface((SPRITE_W, SPRITE_H), pygame.SRCALPHA)
        ox = float(SPRITE_ANCHOR_X)
        oy = float(SPRITE_ANCHOR_Y)

        def pt(xy: Tuple[float, float]) -> Vec2:
            return Vec2(ox + xy[0] * scale, oy + xy[1] * scale)

        hip = pt(kf.hip_xy)
        waist = pt(kf.waist_xy)
        chest = pt(kf.chest_xy)
        head = pt(kf.head_xy)

        l_sh = pt(kf.l_shoulder)
        l_el = pt(kf.l_elbow)
        l_ha = pt(kf.l_hand)
        r_sh = pt(kf.r_shoulder)
        r_el = pt(kf.r_elbow)
        r_ha = pt(kf.r_hand)

        yaw_rad = math.radians(kf.torso_yaw_deg)
        hip_spread = 9.5 * scale * max(0.38, abs(math.cos(yaw_rad)))
        l_hip = Vec2(hip.x - hip_spread, hip.y + 3.0 * scale)
        r_hip = Vec2(hip.x + hip_spread, hip.y + 3.0 * scale)

        l_kn = pt(kf.l_knee)
        l_an = pt(kf.l_ankle)
        l_to = pt(kf.l_toe)
        r_kn = pt(kf.r_knee)
        r_an = pt(kf.r_ankle)
        r_to = pt(kf.r_toe)

        s_hilt = pt(kf.sword_hilt)
        s_tip = pt(kf.sword_tip)

        # 0. Eclipse Overdrive crimson-gold battle aura
        if eclipse_mode:
            self.rast.paint_radial_bloom(
                surf, chest.x, chest.y + 12.0 * scale, 96.0 * scale, (218, 24, 78), alpha=135, additive=True
            )
            self.rast.paint_radial_bloom(
                surf, waist.x, waist.y, 62.0 * scale, (255, 198, 64), alpha=95, additive=True
            )

        # 1. Background slash waves
        for sw in kf.slash_waves:
            if sw.behind_body:
                self.rast.paint_painterly_slash_wave(
                    surf,
                    [pt(p) for p in sw.outer_pts],
                    [pt(p) for p in sw.inner_pts],
                    pal,
                    intensity=sw.intensity,
                    eclipse_mode=eclipse_mode,
                    seed=frame_seed,
                )

        # 2. High flowing black ponytail (5 tapering silky anime strands)
        self._draw_ponytail_back(surf, kf, head, pal, scale)

        # 3. Sword behind body if sword_layer < 0
        if kf.sword_layer < 0:
            self.rast.paint_cursed_greatsword(
                surf, s_hilt, s_tip, kf.sword_view, pal,
                aura_intensity=kf.sword_aura * (1.45 if eclipse_mode else 1.0),
                eclipse_mode=eclipse_mode,
                frame_seed=frame_seed,
            )

        # 4. Far/back arm
        back_is_left = kf.torso_yaw_deg >= -15.0
        if back_is_left:
            self._draw_juliet_arm(surf, l_sh, l_el, l_ha, pal, scale, is_far=True)
        else:
            self._draw_juliet_arm(surf, r_sh, r_el, r_ha, pal, scale, is_far=True)

        # 5. Depth-sorted thighs & above-knee buckled leather boots
        left_leg_back = (l_kn.x <= r_kn.x + 8.0 * scale)
        if left_leg_back:
            self._draw_leg_and_boot(surf, l_hip, l_kn, l_an, l_to, pal, scale, is_far=True)
            self._draw_leg_and_boot(surf, r_hip, r_kn, r_an, r_to, pal, scale, is_far=False)
        else:
            self._draw_leg_and_boot(surf, r_hip, r_kn, r_an, r_to, pal, scale, is_far=True)
            self._draw_leg_and_boot(surf, l_hip, l_kn, l_an, l_to, pal, scale, is_far=False)

        # 6. Tiered Gothic Lolita pleated bell skirt
        self._draw_gothic_lolita_skirt(surf, kf, waist, hip, pal, scale)

        # 7. Fitted Gothic Lolita bodice (collar, ruby brooch, jabot, leather belt)
        self._draw_gothic_bodice(surf, kf, waist, chest, l_sh, r_sh, pal, scale)

        # 8. Sword at mid-depth
        if kf.sword_layer == 0:
            self.rast.paint_cursed_greatsword(
                surf, s_hilt, s_tip, kf.sword_view, pal,
                aura_intensity=kf.sword_aura * (1.45 if eclipse_mode else 1.0),
                eclipse_mode=eclipse_mode,
                frame_seed=frame_seed,
            )

        # 9. Sculpted cute noble anime face, glowing yellow eyes, bangs & sidelocks
        self._draw_head_and_face(surf, kf, chest, head, pal, scale)

        # 10. Foreground Juliet-sleeve arm
        if back_is_left:
            self._draw_juliet_arm(surf, r_sh, r_el, r_ha, pal, scale, is_far=False)
        else:
            self._draw_juliet_arm(surf, l_sh, l_el, l_ha, pal, scale, is_far=False)

        # 11. Foreground demonic greatsword
        if kf.sword_layer > 0:
            self.rast.paint_cursed_greatsword(
                surf, s_hilt, s_tip, kf.sword_view, pal,
                aura_intensity=kf.sword_aura * (1.45 if eclipse_mode else 1.0),
                eclipse_mode=eclipse_mode,
                frame_seed=frame_seed,
            )

        # 12. Foreground gripping fingers over hilt
        self._draw_hand_grip_overlay(surf, r_ha, pal, scale)
        if (l_ha - s_hilt).length() < 32.0 * scale:
            self._draw_hand_grip_overlay(surf, l_ha, pal, scale * 0.92)

        # 13. Foreground painterly crescent slash waves
        for sw in kf.slash_waves:
            if not sw.behind_body:
                self.rast.paint_painterly_slash_wave(
                    surf,
                    [pt(p) for p in sw.outer_pts],
                    [pt(p) for p in sw.inner_pts],
                    pal,
                    intensity=sw.intensity,
                    eclipse_mode=eclipse_mode,
                    seed=frame_seed,
                )

        return surf

    # --------------------------------------------------------------------------
    # Sculpted High Ponytail (5 Razor-Tapered Flowing Anime Strands)
    # --------------------------------------------------------------------------

    def _draw_ponytail_back(
        self,
        surf: pygame.Surface,
        kf: CelFrameData,
        head: Vec2,
        pal: CeciliaPalette,
        scale: float,
    ) -> None:
        ox = float(SPRITE_ANCHOR_X)
        oy = float(SPRITE_ANCHOR_Y)
        c0 = Vec2(ox + kf.ponytail_ctrl[0][0] * scale, oy + kf.ponytail_ctrl[0][1] * scale)
        c1 = Vec2(ox + kf.ponytail_ctrl[1][0] * scale, oy + kf.ponytail_ctrl[1][1] * scale)
        c2 = Vec2(ox + kf.ponytail_ctrl[2][0] * scale, oy + kf.ponytail_ctrl[2][1] * scale)
        c3 = Vec2(ox + kf.ponytail_ctrl[3][0] * scale, oy + kf.ponytail_ctrl[3][1] * scale)

        def hair_profile(steps: int, base_w: float, peak_w: float) -> List[float]:
            out: List[float] = []
            for i in range(steps + 1):
                u = i / float(steps)
                if i == steps:
                    out.append(0.0)
                else:
                    belly = math.sin(clamp(u * 1.15, 0.0, 1.0) * math.pi * 0.85) ** 0.72
                    taper = (1.0 - u) ** 0.92
                    out.append(scale * (base_w * (1.0 - u) + peak_w * belly * taper))
            return out

        # 5 layered organic hair locks fanning gracefully into tapered anime tips!
        strand_specs = (
            ((-3, 6), (-12, 18), (-18, 28), (-22, 24), 4.5, 9.8, 0.30, -0.7, 1.2),
            ((-1, 2), (-4, 8), (-6, 12), (-10, 10), 4.2, 8.2, 0.34, 0.6, 1.2),
            ((0, 0), (0, 0), (0, 0), (0, 0), 5.2, 11.4, 0.36, 1.0, 1.4),
            ((1, -3), (4, -10), (8, -14), (-6, -18), 3.0, 6.2, 0.40, 1.0, 1.1),
            ((0, -2), (-6, -15), (-14, -22), (-26, -14), 2.2, 4.4, 0.42, 1.0, 1.0),
        )
        for d0, d1, d2, d3, bw, pw, su, rside, ow in strand_specs:
            sp = sample_cubic_bezier(
                c0 + Vec2(d0[0] * scale, d0[1] * scale),
                c1 + Vec2(d1[0] * scale, d1[1] * scale),
                c2 + Vec2(d2[0] * scale, d2[1] * scale),
                c3 + Vec2(d3[0] * scale, d3[1] * scale),
                steps=16,
            )
            ws = hair_profile(16, bw, pw)
            self.rast.paint_hair_ribbon(surf, sp, ws, pal, sheen_u=su, rim_side=rside, outline_w=ow)

        # High-ponytail gathered hair-knot & gothic crimson hair ribbon
        knot_poly = [
            c0 + Vec2(-5.5 * scale, -4.5 * scale),
            c0 + Vec2(4.5 * scale, -5.5 * scale),
            c0 + Vec2(5.5 * scale, 4.5 * scale),
            c0 + Vec2(-4.5 * scale, 5.5 * scale),
        ]
        self.rast.paint_shaded_poly(
            surf, knot_poly, pal.dress_red_bright, pal.dress_red_base, pal.dress_red_deep,
            outline_color=INK_COLOR, outline_width=1.2,
        )

    # --------------------------------------------------------------------------
    # Sculpted Thighs & Above-Knee Buckled Black Leather Heeled Boots
    # --------------------------------------------------------------------------

    def _draw_leg_and_boot(
        self,
        surf: pygame.Surface,
        hip: Vec2,
        knee: Vec2,
        ankle: Vec2,
        toe: Vec2,
        pal: CeciliaPalette,
        scale: float,
        is_far: bool = False,
    ) -> None:
        dim = 0.85 if is_far else 1.0
        sk_l = scale_rgb(pal.skin_light, dim)
        sk_m = scale_rgb(pal.skin_mid, dim)
        sk_s = scale_rgb(pal.skin_shadow, dim)

        boot_top = hip.lerp(knee, 0.56)
        thigh_poly = build_sculpted_limb_poly(
            hip,
            boot_top + (knee - hip).normalized() * (5.0 * scale),
            r0=11.2 * scale,
            r1=8.4 * scale,
            mid_bulge_l=1.6 * scale,
            mid_bulge_r=1.2 * scale,
            mid_t=0.46,
        )
        self.rast.paint_shaded_poly(
            surf, thigh_poly, sk_l, sk_m, sk_s,
            light_dir=(0.62, -0.78),
            rim_color=pal.hair_rim if not is_far else None,
            rim_strength=0.18,
            outline_color=INK_COLOR,
            outline_width=1.3,
            cel_cut=0.44,
        )

        l_hi = scale_rgb(pal.leather_spec, dim)
        l_mid = scale_rgb(pal.leather_base, dim)
        l_dp = scale_rgb(pal.leather_deep, dim)

        upper_boot_poly = build_sculpted_limb_poly(
            boot_top, knee, r0=9.2 * scale, r1=7.4 * scale,
            mid_bulge_l=0.9 * scale, mid_bulge_r=0.8 * scale,
        )
        self.rast.paint_shaded_poly(
            surf, upper_boot_poly, l_hi, l_mid, l_dp,
            light_dir=(0.75, -0.65),
            rim_color=pal.hair_rim if not is_far else None,
            rim_strength=0.35,
            outline_color=INK_COLOR,
            outline_width=1.4,
            cel_cut=0.58,
        )

        calf_poly = build_sculpted_limb_poly(
            knee, ankle, r0=7.4 * scale, r1=4.7 * scale,
            mid_bulge_l=1.0 * scale, mid_bulge_r=2.4 * scale, mid_t=0.36,
        )
        self.rast.paint_shaded_poly(
            surf, calf_poly, l_hi, l_mid, l_dp,
            light_dir=(0.78, -0.62),
            rim_color=pal.hair_rim if not is_far else None,
            rim_strength=0.38,
            outline_color=INK_COLOR,
            outline_width=1.4,
            cel_cut=0.60,
        )

        foot_vec = toe - ankle
        f_fwd = foot_vec.normalized() if foot_vec.length() > 1.0 else Vec2(1.0, 0.0)
        f_up = Vec2(-f_fwd.y, f_fwd.x)
        if f_up.y > 0.0:
            f_up = -f_up
        heel_base = ankle - f_fwd * (4.4 * scale) - f_up * (5.0 * scale)
        heel_tip = heel_base - f_up * (5.4 * scale)
        arch_mid = ankle.lerp(toe, 0.45) - f_up * (2.4 * scale)
        instep = ankle.lerp(toe, 0.42) + f_up * (4.6 * scale)
        sole_ball = toe - f_fwd * (3.4 * scale) - f_up * (2.5 * scale)
        boot_foot_poly = [
            ankle - f_fwd * (4.0 * scale) + f_up * (2.5 * scale),
            instep, toe + f_up * (1.2 * scale), toe - f_up * (2.2 * scale),
            sole_ball, arch_mid,
            heel_base + f_fwd * (3.8 * scale) - f_up * (4.4 * scale),
            heel_tip + f_fwd * (3.1 * scale), heel_tip, heel_base,
        ]
        self.rast.paint_shaded_poly(
            surf, boot_foot_poly, l_hi, l_mid, l_dp,
            light_dir=(0.6, -0.8), outline_color=INK_COLOR, outline_width=1.4, cel_cut=0.58,
        )

        # Glossy leather highlight strip along front shin
        shin_dir = (ankle - knee).normalized()
        shin_n = Vec2(-shin_dir.y, shin_dir.x)
        if shin_n.x < 0.0:
            shin_n = -shin_n
        pygame.draw.line(
            surf,
            lerp_rgb(pal.leather_spec, (255, 240, 252), 0.42),
            (knee.lerp(ankle, 0.14) + shin_n * (3.0 * scale)).to_int_tuple(),
            (knee.lerp(ankle, 0.78) + shin_n * (1.9 * scale)).to_int_tuple(),
            max(1, int(1.8 * scale)),
        )

        # 5 signature leather straps + polished silver buckles (exact char.jpg detail!)
        up_dir = (knee - boot_top).normalized()
        up_n = Vec2(-up_dir.y, up_dir.x)
        cuff_c = boot_top + up_dir * (3.4 * scale)
        self.rast.paint_leather_buckle_strap(
            surf, cuff_c - up_n * (9.2 * scale), cuff_c + up_n * (9.2 * scale),
            strap_h=3.2 * scale, pal=pal, buckle_u=0.68,
        )
        c_dir = (ankle - knee).normalized()
        c_n = Vec2(-c_dir.y, c_dir.x)
        for u_st, w_st in ((0.22, 8.0), (0.44, 7.4), (0.65, 6.2), (0.84, 5.2)):
            sc = knee.lerp(ankle, u_st)
            self.rast.paint_leather_buckle_strap(
                surf, sc - c_n * (w_st * scale), sc + c_n * (w_st * scale),
                strap_h=2.8 * scale, pal=pal, buckle_u=0.72,
            )

    # --------------------------------------------------------------------------
    # Tiered Gothic Lolita Bell Minidress Skirt
    # --------------------------------------------------------------------------

    def _draw_gothic_lolita_skirt(
        self,
        surf: pygame.Surface,
        kf: CelFrameData,
        waist: Vec2,
        hip: Vec2,
        pal: CeciliaPalette,
        scale: float,
    ) -> None:
        sway = kf.skirt_sway_x * scale
        flare = clamp(kf.skirt_flare, 0.72, 1.55)
        lift_l = kf.skirt_lift_l * scale
        lift_r = kf.skirt_lift_r * scale

        w_half = 11.2 * scale
        hem_half = 36.5 * scale * flare
        skirt_len = 37.5 * scale

        waist_l = Vec2(waist.x - w_half, waist.y + 2.0 * scale)
        waist_r = Vec2(waist.x + w_half, waist.y + 2.0 * scale)

        hem_y_base = waist.y + skirt_len
        hem_l = Vec2(hip.x - hem_half + sway * 0.75, hem_y_base - lift_l)
        hem_m = Vec2(hip.x + sway * 0.45, hem_y_base + 5.5 * scale - (lift_l + lift_r) * 0.35)
        hem_r = Vec2(hip.x + hem_half + sway * 0.75, hem_y_base - lift_r)

        under_pts = [
            hem_l + Vec2(4.0 * scale, -2.0 * scale),
            hem_m + Vec2(0.0, 4.5 * scale),
            hem_r + Vec2(-4.0 * scale, -2.0 * scale),
            hip + Vec2(0.0, 4.0 * scale),
        ]
        self.rast.paint_soft_shadow_poly(surf, under_pts, (10, 4, 14), alpha=215)

        tier2_top = sample_quad_bezier(
            waist_l.lerp(hem_l, 0.70), waist.lerp(hem_m, 0.72), waist_r.lerp(hem_r, 0.70), steps=10
        )
        tier2_bot = sample_quad_bezier(hem_l, hem_m, hem_r, steps=10)
        self.rast.paint_lace_ruffle_strip(
            surf, tier2_top, tier2_bot,
            pal.dress_red_deep, pal.dress_red_base, pal.dress_red_bright, pal.dress_black_deep,
            pleats=9, scallop_amp=3.4 * scale,
        )

        tier1_top = sample_quad_bezier(
            waist_l.lerp(hem_l, 0.50), waist.lerp(hem_m, 0.54), waist_r.lerp(hem_r, 0.50), steps=10
        )
        tier1_bot = sample_quad_bezier(
            waist_l.lerp(hem_l, 0.76), waist.lerp(hem_m, 0.79), waist_r.lerp(hem_r, 0.76), steps=10
        )
        self.rast.paint_lace_ruffle_strip(
            surf, tier1_top, tier1_bot,
            pal.dress_black_deep, pal.dress_black_base, pal.dress_black_hi, pal.lace_trim,
            pleats=8, scallop_amp=3.0 * scale,
        )

        upper_l_mid = waist_l.lerp(tier1_top[0], 0.52) + Vec2(-5.5 * scale * flare, -1.5 * scale)
        upper_r_mid = waist_r.lerp(tier1_top[-1], 0.52) + Vec2(5.5 * scale * flare, -1.5 * scale)
        side_l = sample_quad_bezier(waist_l, upper_l_mid, tier1_top[0], steps=7)
        side_r = sample_quad_bezier(tier1_top[-1], upper_r_mid, waist_r, steps=7)
        overskirt_poly = side_l + tier1_top[1:-1] + side_r
        self.rast.paint_shaded_poly(
            surf, overskirt_poly, pal.dress_black_hi, pal.dress_black_base, pal.dress_black_deep,
            light_dir=(0.55, -0.82), rim_color=pal.dress_red_bright, rim_strength=0.25,
            outline_color=INK_COLOR, outline_width=1.5, cel_cut=0.48,
        )

        yaw_vis = math.cos(math.radians(clamp(kf.torso_yaw_deg, -80.0, 80.0)))
        shift_x = math.sin(math.radians(clamp(kf.torso_yaw_deg, -80.0, 80.0))) * 12.0 * scale
        if yaw_vis > 0.15:
            pw_top = 4.6 * scale * yaw_vis
            pw_bot = 12.5 * scale * flare * yaw_vis
            p_top_c = Vec2(waist.x + shift_x * 0.45, waist.y + 2.0 * scale)
            p_bot_c = Vec2(tier1_top[5].x + shift_x * 0.95, tier1_top[5].y + 1.5 * scale)
            panel_poly = [
                Vec2(p_top_c.x - pw_top, p_top_c.y),
                Vec2(p_top_c.x + pw_top, p_top_c.y),
                Vec2(p_bot_c.x + pw_bot, p_bot_c.y),
                Vec2(p_bot_c.x, p_bot_c.y + 3.0 * scale),
                Vec2(p_bot_c.x - pw_bot, p_bot_c.y),
            ]
            self.rast.paint_shaded_poly(
                surf, panel_poly, pal.dress_red_bright, pal.dress_red_base, pal.dress_red_deep,
                light_dir=(0.5, -0.86), outline_color=INK_COLOR, outline_width=1.2, cel_cut=0.44,
            )

        for pi in range(1, 8):
            u = pi / 8.0
            a = waist_l.lerp(waist_r, u)
            b = tier1_top[min(len(tier1_top) - 1, int(u * (len(tier1_top) - 1)))]
            pygame.draw.aaline(surf, pal.dress_black_deep, a.to_int_tuple(), b.to_int_tuple())

        trim_band = [
            tier1_top[i] + Vec2(0.0, -2.5 * scale + (1.4 * scale if i % 2 == 0 else -1.4 * scale))
            for i in range(len(tier1_top))
        ]
        pygame.draw.lines(surf, pal.dress_red_bright, False, [p.to_int_tuple() for p in trim_band], max(1, int(2.2 * scale)))

    # --------------------------------------------------------------------------
    # Fitted Gothic Lolita Bodice, High Collar, Ruby Brooch & Leather Belt
    # --------------------------------------------------------------------------

    def _draw_gothic_bodice(
        self,
        surf: pygame.Surface,
        kf: CelFrameData,
        waist: Vec2,
        chest: Vec2,
        l_sh: Vec2,
        r_sh: Vec2,
        pal: CeciliaPalette,
        scale: float,
    ) -> None:
        spine_up = (chest - waist).normalized()
        spine_r = Vec2(-spine_up.y, spine_up.x)
        if spine_r.x < 0.0:
            spine_r = -spine_r

        yaw_rad = math.radians(clamp(kf.torso_yaw_deg, -85.0, 85.0))
        front_shift = math.sin(yaw_rad) * 7.2 * scale
        width_scale = max(0.55, abs(math.cos(yaw_rad)) * 0.45 + 0.55)

        waist_hw = 10.2 * scale * width_scale
        bust_hw = 14.0 * scale * width_scale
        collar_pos = chest + spine_up * (10.5 * scale)

        bust_c = waist.lerp(chest, 0.62) + spine_r * (front_shift * 0.35)
        bodice_poly = [
            waist - spine_r * waist_hw,
            bust_c - spine_r * (bust_hw * 0.96),
            l_sh + Vec2(2.0 * scale, 2.0 * scale),
            collar_pos - spine_r * (5.2 * scale),
            collar_pos + spine_r * (5.2 * scale),
            r_sh + Vec2(-2.0 * scale, 2.0 * scale),
            bust_c + spine_r * (bust_hw * 1.04),
            waist + spine_r * waist_hw,
        ]
        self.rast.paint_shaded_poly(
            surf, bodice_poly, pal.dress_black_hi, pal.dress_black_base, pal.dress_black_deep,
            light_dir=(0.6, -0.8), rim_color=pal.hair_rim, rim_strength=0.25,
            outline_color=INK_COLOR, outline_width=1.5, cel_cut=0.48,
        )

        pl_top = collar_pos + spine_r * (front_shift * 0.62) - spine_up * (2.5 * scale)
        pl_bot = waist + spine_r * (front_shift * 0.55)
        pl_w_top = 6.0 * scale * max(0.4, abs(math.cos(yaw_rad)))
        pl_w_bot = 4.0 * scale * max(0.4, abs(math.cos(yaw_rad)))
        plastron_poly = [
            pl_top - spine_r * pl_w_top,
            pl_top + spine_r * pl_w_top,
            pl_bot + spine_r * pl_w_bot,
            pl_bot - spine_r * pl_w_bot,
        ]
        self.rast.paint_shaded_poly(
            surf, plastron_poly, pal.dress_red_bright, pal.dress_red_base, pal.dress_red_deep,
            light_dir=(0.55, -0.82), outline_color=INK_COLOR, outline_width=1.2,
        )
        for bi in range(1, 5):
            bp = pl_top.lerp(pl_bot, bi / 5.0)
            pygame.draw.circle(surf, pal.dress_black_deep, bp.to_int_tuple(), max(1, int(1.3 * scale)))

        jabot_c = collar_pos + spine_r * (front_shift * 0.68) - spine_up * (5.5 * scale)
        jabot_poly = [
            collar_pos + spine_r * (front_shift * 0.68),
            jabot_c + spine_r * (7.0 * scale) - spine_up * (3.4 * scale),
            jabot_c + spine_r * (3.0 * scale) - spine_up * (6.0 * scale),
            jabot_c - spine_up * (4.4 * scale),
            jabot_c - spine_r * (3.0 * scale) - spine_up * (6.0 * scale),
            jabot_c - spine_r * (7.0 * scale) - spine_up * (3.4 * scale),
        ]
        self.rast.paint_shaded_poly(
            surf, jabot_poly, pal.dress_red_hi, pal.dress_red_bright, pal.dress_red_deep,
            outline_color=INK_COLOR, outline_width=1.1,
        )

        # High Gothic Victorian Collar with crimson trim & ruby brooch
        col_l = collar_pos - spine_r * (5.6 * scale)
        col_r = collar_pos + spine_r * (5.6 * scale)
        collar_poly = [
            col_l - spine_up * (2.2 * scale),
            col_l + spine_up * (5.2 * scale),
            col_r + spine_up * (5.2 * scale),
            col_r - spine_up * (2.2 * scale),
        ]
        self.rast.paint_shaded_poly(
            surf, collar_poly, pal.dress_black_hi, pal.dress_black_base, pal.dress_black_deep,
            outline_color=INK_COLOR, outline_width=1.3,
        )
        pygame.draw.line(
            surf, pal.dress_red_bright,
            (col_l + spine_up * (4.8 * scale)).to_int_tuple(),
            (col_r + spine_up * (4.8 * scale)).to_int_tuple(),
            max(1, int(1.8 * scale)),
        )
        brooch_c = collar_pos + spine_r * (front_shift * 0.72) + spine_up * (1.2 * scale)
        pygame.draw.circle(surf, pal.silver_bright, brooch_c.to_int_tuple(), max(2, int(3.0 * scale)))
        pygame.draw.circle(surf, pal.brooch_gem, brooch_c.to_int_tuple(), max(1, int(2.1 * scale)))

        self.rast.paint_leather_buckle_strap(
            surf,
            waist - spine_r * (waist_hw * 1.08),
            waist + spine_r * (waist_hw * 1.08),
            strap_h=5.2 * scale,
            pal=pal,
            buckle_u=clamp(0.5 + math.sin(yaw_rad) * 0.25, 0.25, 0.75),
        )

    # --------------------------------------------------------------------------
    # Puffed Gothic Juliet Sleeves & Hands
    # --------------------------------------------------------------------------

    def _draw_juliet_arm(
        self,
        surf: pygame.Surface,
        shoulder: Vec2,
        elbow: Vec2,
        hand: Vec2,
        pal: CeciliaPalette,
        scale: float,
        is_far: bool = False,
    ) -> None:
        dim = 0.84 if is_far else 1.0
        b_hi = scale_rgb(pal.dress_black_hi, dim)
        b_mid = scale_rgb(pal.dress_black_base, dim)
        b_dp = scale_rgb(pal.dress_black_deep, dim)

        puff_end = shoulder.lerp(elbow, 0.68)
        puff_poly = build_sculpted_limb_poly(
            shoulder, puff_end, r0=7.4 * scale, r1=5.0 * scale,
            mid_bulge_l=5.2 * scale, mid_bulge_r=4.6 * scale, mid_t=0.45,
        )
        self.rast.paint_shaded_poly(
            surf, puff_poly, b_hi, b_mid, b_dp,
            light_dir=(0.6, -0.8),
            rim_color=pal.hair_rim if not is_far else None,
            rim_strength=0.25,
            outline_color=INK_COLOR,
            outline_width=1.4,
            cel_cut=0.50,
        )
        sh_dir = (elbow - shoulder).normalized()
        sh_n = Vec2(-sh_dir.y, sh_dir.x)
        pygame.draw.line(
            surf, scale_rgb(pal.dress_red_bright, dim),
            (shoulder - sh_n * (6.2 * scale)).to_int_tuple(),
            (shoulder + sh_n * (6.2 * scale)).to_int_tuple(),
            max(2, int(2.6 * scale)),
        )

        wrist = elbow.lerp(hand, 0.84)
        self.rast.paint_shaded_poly(
            surf, build_sculpted_limb_poly(puff_end, elbow, r0=4.8 * scale, r1=4.2 * scale),
            b_hi, b_mid, b_dp, outline_color=INK_COLOR, outline_width=1.2,
        )
        self.rast.paint_shaded_poly(
            surf,
            build_sculpted_limb_poly(elbow, wrist, r0=4.4 * scale, r1=3.4 * scale, mid_bulge_l=0.6 * scale),
            b_hi, b_mid, b_dp, light_dir=(0.6, -0.8), outline_color=INK_COLOR, outline_width=1.3,
        )

        fa_dir = (hand - elbow).normalized()
        fa_n = Vec2(-fa_dir.y, fa_dir.x)
        cuff_poly = [
            wrist - fa_n * (3.5 * scale) - fa_dir * (2.4 * scale),
            wrist + fa_n * (3.5 * scale) - fa_dir * (2.4 * scale),
            wrist + fa_n * (6.2 * scale) + fa_dir * (3.0 * scale),
            wrist + fa_dir * (4.0 * scale),
            wrist - fa_n * (6.2 * scale) + fa_dir * (3.0 * scale),
        ]
        self.rast.paint_shaded_poly(
            surf, cuff_poly,
            scale_rgb(pal.dress_red_hi, dim),
            scale_rgb(pal.dress_red_bright, dim),
            scale_rgb(pal.dress_red_deep, dim),
            outline_color=INK_COLOR, outline_width=1.1,
        )

        hand_poly = [
            wrist - fa_n * (2.7 * scale),
            hand + fa_dir * (3.0 * scale) - fa_n * (2.1 * scale),
            hand + fa_dir * (4.6 * scale),
            hand + fa_dir * (2.5 * scale) + fa_n * (2.9 * scale),
            wrist + fa_n * (2.8 * scale),
        ]
        self.rast.paint_shaded_poly(
            surf, hand_poly,
            scale_rgb(pal.skin_light, dim),
            scale_rgb(pal.skin_mid, dim),
            scale_rgb(pal.skin_shadow, dim),
            outline_color=INK_COLOR, outline_width=1.1,
        )

    def _draw_hand_grip_overlay(
        self, surf: pygame.Surface, hand: Vec2, pal: CeciliaPalette, scale: float
    ) -> None:
        r = max(2, int(3.3 * scale))
        pygame.draw.circle(surf, pal.skin_mid, hand.to_int_tuple(), r)
        pygame.draw.circle(surf, pal.skin_light, (int(hand.x - 1), int(hand.y - 1)), max(1, r - 1))
        pygame.draw.circle(surf, INK_COLOR, hand.to_int_tuple(), r, 1)

    # --------------------------------------------------------------------------
    # Cute Noble Anime Head, Face, Luminous Yellow Eyes, Bangs & Sidelocks
    # --------------------------------------------------------------------------

    def _draw_head_and_face(
        self,
        surf: pygame.Surface,
        kf: CelFrameData,
        chest: Vec2,
        head: Vec2,
        pal: CeciliaPalette,
        scale: float,
    ) -> None:
        tilt_rad = math.radians(kf.head_tilt_deg)
        up = Vec2(-math.sin(tilt_rad), -math.cos(tilt_rad))
        fwd = Vec2(math.cos(tilt_rad), -math.sin(tilt_rad))

        # 1. Short graceful anime neck tucked into the high Victorian collar
        neck_base = chest + Vec2(0.0, -13.0 * scale)
        neck_top = head - up * (7.2 * scale)
        neck_poly = build_sculpted_limb_poly(neck_base, neck_top, r0=3.9 * scale, r1=3.5 * scale)
        self.rast.paint_shaded_poly(
            surf, neck_poly, pal.skin_mid, pal.skin_shadow, pal.skin_deep,
            outline_color=INK_COLOR, outline_width=1.1,
        )

        # 2. Lush rounded jet-black anime hair dome crowning her head (faithful to char.jpg!)
        crown_pts = [
            head - fwd * (14.2 * scale) + up * (2.0 * scale),
            head - fwd * (13.6 * scale) + up * (13.5 * scale),
            head - fwd * (4.5 * scale) + up * (18.8 * scale),
            head + fwd * (6.8 * scale) + up * (17.5 * scale),
            head + fwd * (13.8 * scale) + up * (10.2 * scale),
            head + fwd * (12.2 * scale) - up * (1.5 * scale),
            head - fwd * (11.5 * scale) - up * (5.5 * scale),
        ]
        crown_smooth = sample_catmull_rom(crown_pts, steps_per_seg=4, closed=True)
        self.rast.paint_shaded_poly(
            surf, crown_smooth, pal.hair_mid, pal.hair_base, pal.hair_dark,
            light_dir=(0.6, -0.8), rim_color=pal.hair_rim, rim_strength=0.45,
            outline_color=INK_COLOR, outline_width=1.4,
        )

        # 3. Soft cute Danbooru/Pixiv anime jawline & cheek contour per view angle
        is_profile = (kf.angle in (BodyAngle.SIDE_PROFILE, BodyAngle.LOW_LUNGE) or abs(kf.torso_yaw_deg) >= 62.0)
        is_front = (kf.angle == BodyAngle.FRONT or abs(kf.torso_yaw_deg) <= 18.0)

        if is_profile:
            face_pts = [
                head + fwd * (9.2 * scale) + up * (8.2 * scale),
                head + fwd * (11.4 * scale) + up * (1.8 * scale),
                head + fwd * (13.2 * scale) - up * (1.4 * scale),     # cute small anime nose
                head + fwd * (11.2 * scale) - up * (5.0 * scale),     # delicate lips
                head + fwd * (9.8 * scale) - up * (9.4 * scale),      # soft chin
                head + fwd * (1.2 * scale) - up * (10.6 * scale),     # jawline
                head - fwd * (7.2 * scale) - up * (3.5 * scale),
                head - fwd * (5.5 * scale) + up * (9.0 * scale),
            ]
        elif is_front:
            face_pts = [
                head - fwd * (10.6 * scale) + up * (7.2 * scale),
                head + fwd * (10.6 * scale) + up * (7.2 * scale),
                head + fwd * (11.0 * scale) - up * (2.6 * scale),     # soft cute cheek
                head + fwd * (6.6 * scale) - up * (8.6 * scale),
                head - up * (11.4 * scale),                           # delicate cute chin
                head - fwd * (6.6 * scale) - up * (8.6 * scale),
                head - fwd * (11.0 * scale) - up * (2.6 * scale),
            ]
        else:
            # Classic anime 3/4 view matching char.jpg center!
            face_pts = [
                head - fwd * (9.8 * scale) + up * (7.8 * scale),
                head + fwd * (9.0 * scale) + up * (8.0 * scale),
                head + fwd * (11.6 * scale) + up * (0.4 * scale),     # soft far cheek
                head + fwd * (10.8 * scale) - up * (5.0 * scale),
                head + fwd * (4.8 * scale) - up * (11.0 * scale),     # cute tapered 3/4 chin
                head - fwd * (4.6 * scale) - up * (9.2 * scale),
                head - fwd * (10.0 * scale) - up * (2.4 * scale),
            ]

        face_smooth = sample_catmull_rom(face_pts, steps_per_seg=3, closed=True)
        self.rast.paint_shaded_poly(
            surf, face_smooth, pal.skin_light, pal.skin_mid, pal.skin_shadow,
            light_dir=(0.68, -0.73), outline_color=INK_COLOR, outline_width=1.25, cel_cut=0.38,
        )

        # 4. Luminous Vibrant Yellow Anime Eyes & Expression
        self._draw_anime_eyes_and_expression(surf, kf, head, fwd, up, pal, scale, is_profile, is_front)

        # 5. Silky Crown Hair Cap + Feathered Anime Bangs + Cute Face-Framing Sidelocks
        sway = kf.sidelock_sway * scale
        # Angel-ring curved hair highlight across her bangs/crown
        crown_sheen = [
            head - fwd * (9.5 * scale) + up * (11.5 * scale),
            head + fwd * (1.0 * scale) + up * (14.2 * scale),
            head + fwd * (9.5 * scale) + up * (10.5 * scale),
            head + fwd * (8.0 * scale) + up * (7.8 * scale),
            head + fwd * (0.5 * scale) + up * (11.2 * scale),
            head - fwd * (8.2 * scale) + up * (8.5 * scale),
        ]
        self.rast.paint_soft_shadow_poly(surf, crown_sheen, pal.hair_sheen, alpha=130)

        # Far-cheek cute framing sidelock
        far_sl = sample_quad_bezier(
            head + fwd * (9.0 * scale) + up * (7.5 * scale),
            head + fwd * (11.2 * scale + sway * 0.45) - up * (4.5 * scale),
            head + fwd * (8.0 * scale + sway * 0.9) - up * (18.0 * scale),
            steps=8,
        )
        self.rast.paint_hair_ribbon(
            surf, far_sl,
            [scale * 2.8 * (1.0 - (i / 8.0) ** 1.15) for i in range(9)],
            pal, sheen_u=0.32, outline_w=1.0,
        )

        # Layered tapered anime bangs sweeping gracefully down to brow line (leaving yellow eyes vivid!)
        # Seamless forehead fringe cap uniting crown & bangs
        cap_poly = [
            head - fwd * (12.0 * scale) + up * (6.5 * scale),
            head - fwd * (10.5 * scale) + up * (15.0 * scale),
            head + fwd * (1.0 * scale) + up * (17.2 * scale),
            head + fwd * (11.5 * scale) + up * (13.0 * scale),
            head + fwd * (11.2 * scale) + up * (5.5 * scale),
            head + fwd * (4.0 * scale) + up * (7.5 * scale),
            head - fwd * (4.0 * scale) + up * (7.5 * scale),
        ]
        self.rast.paint_shaded_poly(
            surf, cap_poly, pal.hair_mid, pal.hair_base, pal.hair_dark,
            light_dir=(0.55, -0.83), outline_color=None, cel_cut=0.52,
        )
        bang_specs = (
            (-10.5, 13.8, -9.6, 5.2, -7.2, 3.6),
            (-5.2, 15.2, -3.8, 6.2, -1.8, 3.3),
            (0.4, 15.6, 2.4, 6.5, 4.0, 3.4),
            (5.4, 14.4, 8.4, 5.8, 10.2, 2.9),
        )
        for bx0, by0, bx1, by1, bx2, bw in bang_specs:
            b_sp = sample_quad_bezier(
                head + fwd * (bx0 * scale) + up * (by0 * scale),
                head + fwd * (bx1 * scale) + up * (by1 * scale),
                head + fwd * (bx2 * scale) + up * ((by1 - 4.2) * scale),
                steps=7,
            )
            self.rast.paint_hair_ribbon(
                surf, b_sp,
                [scale * bw * (1.0 - (i / 7.0) ** 1.2) for i in range(8)],
                pal, sheen_u=0.40, outline_w=1.0,
            )

        # Near-cheek signature long face-framing sidelock (exact char.jpg cuteness!)
        near_sl = sample_quad_bezier(
            head - fwd * (8.8 * scale) + up * (9.5 * scale),
            head - fwd * (11.2 * scale - sway * 0.45) - up * (5.5 * scale),
            head - fwd * (6.8 * scale - sway) - up * (23.0 * scale),
            steps=10,
        )
        self.rast.paint_hair_ribbon(
            surf, near_sl,
            [scale * 4.2 * (1.0 - (i / 10.0) ** 1.15) for i in range(11)],
            pal, sheen_u=0.35, outline_w=1.15,
        )

    def _draw_anime_eyes_and_expression(
        self,
        surf: pygame.Surface,
        kf: CelFrameData,
        head: Vec2,
        fwd: Vec2,
        up: Vec2,
        pal: CeciliaPalette,
        scale: float,
        is_profile: bool,
        is_front: bool,
    ) -> None:
        expr = kf.expression
        gaze = kf.head_look_x * 1.2 * scale

        if is_profile:
            eye_specs = ((head + fwd * (6.6 * scale) - up * (0.4 * scale), 3.6 * scale, 4.4 * scale),)
            mouth_p = head + fwd * (9.2 * scale) - up * (6.2 * scale)
        elif is_front:
            eye_specs = (
                (head - fwd * (5.0 * scale) - up * (0.4 * scale), 4.4 * scale, 4.2 * scale),
                (head + fwd * (5.0 * scale) - up * (0.4 * scale), 4.4 * scale, 4.2 * scale),
            )
            mouth_p = head - up * (6.8 * scale)
        else:
            eye_specs = (
                (head + fwd * (0.8 * scale) - up * (0.4 * scale), 4.5 * scale, 4.3 * scale),
                (head + fwd * (8.4 * scale) - up * (0.4 * scale), 2.9 * scale, 4.1 * scale),
            )
            mouth_p = head + fwd * (5.4 * scale) - up * (6.4 * scale)

        # Soft airbrush cheek blush (alpha-only, never additive white blob!)
        for ec, ew, eh in eye_specs:
            blush_c = ec - up * (3.8 * scale)
            self.rast.paint_radial_bloom(surf, blush_c.x, blush_c.y, 4.8 * scale, pal.blush, alpha=68, additive=False)

