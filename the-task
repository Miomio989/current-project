    def llm_generate(self) -> None:
        user = self.llm_user_edit.toPlainText().strip()
        if not user:
            self.llm_status.setText("Describe your concept first.")
            return
        self._llm_sys_prompts[self._llm_tpl_key] = self.llm_sys_edit.toPlainText()
        self.llm_run_btn.setEnabled(False)
        self.llm_status.setText("Forging prompts\u2026 (errors & timing are logged)")
        t0 = time.monotonic()

        def _job() -> str:
            return llm_chat(
                self.llm_url_edit.text().strip(),
                self.llm_key_edit.text().strip(),
                self.llm_model_combo.currentText().strip(),
                self._llm_sys_prompts[self._llm_tpl_key],
                user,
                self.llm_temp_spin.value(),
                self.llm_topp_spin.value(),
            )

        def _done(reply: str) -> None:
            self.llm_run_btn.setEnabled(True)
            dt = time.monotonic() - t0
            prompts = llm_extract_prompts(reply)
            self.llm_out_list.clear()
            for p in prompts:
                it = QListWidgetItem(elide(p, 160))
                it.setToolTip(p)
                it.setData(Qt.ItemDataRole.UserRole, p)
                self.llm_out_list.addItem(it)
            self.llm_status.setText(
                f"{len(prompts)} prompt(s) forged in {dt:.1f}s."
                + ("" if llm_reply_has_blocks(reply) else "  (fell back to line splitting — model ignored XML tags)")
            )
            if not prompts:
                STUDIO_LOG.warn("LLM", "LLM returned no usable prompts")

        def _err(msg: str) -> None:
            self.llm_run_btn.setEnabled(True)
            self.llm_status.setText(f"LLM error: {msg}")

        self._run_task(_job, _done, _err)

    def _llm_out_append(self, prompt: str, tag: str = "") -> None:
        """Add one prompt row to the forged list, removing the rest-state hint.
        Motion prompts carry a [MOTION] tag in the display line; the full
        multi-line text stays in the item data & tooltip."""
        for i in range(self.llm_out_list.count()):
            it = self.llm_out_list.item(i)
            if it is not None and not (it.flags() & Qt.ItemFlag.ItemIsEnabled):
                self.llm_out_list.takeItem(i)
                break
        first_line = prompt.splitlines()[0] if prompt.splitlines() else prompt
        display = f"[{tag}] {elide(first_line, 150)}" if tag else elide(prompt, 160)
        it = QListWidgetItem(display)
        it.setToolTip(prompt)
        it.setData(Qt.ItemDataRole.UserRole, prompt)
        self.llm_out_list.addItem(it)
        self.llm_out_list.scrollToBottom()

    def _selected_llm_prompt(self) -> Optional[str]:
        it = self.llm_out_list.currentItem()
        if it is None and self.llm_out_list.count() > 0:
            it = self.llm_out_list.item(0)
        return str(it.data(Qt.ItemDataRole.UserRole) or "") if it else None

    def _llm_send_to_prompt(self, append: bool = False) -> None:
        txt = self._selected_llm_prompt()
        if not txt:
            return
        if append and self.prompt_edit.toPlainText().strip():
            self._insert_highlighted_snippet(txt, C["acc_hi"], False, "llm")
        else:
            self.prompt_edit.setPlainText(txt)
        self.tabs.setCurrentIndex(TAB_PROMPT)
        self._update_preview()

    def _llm_copy_selected(self) -> None:
        txt = self._selected_llm_prompt()
        if txt:
            QApplication.clipboard().setText(txt)

    def _all_forged_prompts(self) -> List[str]:
        """Every forged / extracted prompt in the list, each as a clean single
        line WITHOUT any XML tags — directly compatible with the Batch Prompt
        Queue and any other line-oriented tool."""
        out: List[str] = []
        for i in range(self.llm_out_list.count()):
            it = self.llm_out_list.item(i)
            txt = " ".join(str(it.data(Qt.ItemDataRole.UserRole) or "").split())
            if txt:
                out.append(txt)
        return out

    def _llm_copy_all(self) -> None:
        """Copy the entire forged sequence as single lines (no XML tags) — the
        exact format Batch Prompt Queue expects on the clipboard."""
        lines = self._all_forged_prompts()
        if not lines:
            self._flash_summary("No forged prompts to copy yet.")
            return
        QApplication.clipboard().setText("\n".join(lines))
        self._flash_summary(f"Copied {len(lines)} single-line prompt(s) — paste into BATCH… (Ctrl+Shift+V)")

    def _llm_queue_selected(self) -> None:
        txt = self._selected_llm_prompt()
        if not txt:
            return
        payload, meta = self.build_payload(prompt_override=txt, n_override=1)
        job = self.queue.enqueue(payload, meta)
        self.mini_queue.setVisible(True)
        self.mini_queue.scrollToBottom()
        self._flash_summary(f"Queued forged prompt (job #{job.local_id})")

    def _llm_queue_all(self) -> None:
        """Batch-queue the entire forged sequence through the active pipeline
        (template, negative prompt, LoRAs, wildcards)."""
        lines = self._all_forged_prompts()
        if not lines:
            self._flash_summary("No forged prompts to queue yet.")
            return
        n = self.batch_submit(lines)
        if n:
            self.toast.notify(f"Forged sequence — {n} job(s) queued", "ok")

    def _llm_out_menu(self, pos: QPoint) -> None:
        it = self.llm_out_list.itemAt(pos)
        if it is None:
            m = QMenu(self)
            m.addAction("Copy ALL as single lines (batch-ready)", self._llm_copy_all)
            m.addAction("Batch-queue ALL on AI Horde", self._llm_queue_all)
            m.exec(self.llm_out_list.viewport().mapToGlobal(pos))
            return
        if not it.isSelected():
            self.llm_out_list.clearSelection()
            it.setSelected(True)
        txt = self._selected_llm_prompt() or ""
        m = QMenu(self)
        m.addAction("\u2192 Replace Prompt", lambda: self._llm_send_to_prompt(False))
        m.addAction("+ Append to Prompt", lambda: self._llm_send_to_prompt(True))
        m.addAction("Queue on AI Horde", self._llm_queue_selected)
        m.addSeparator()
        m.addAction("Copy", lambda: QApplication.clipboard().setText(txt))
        m.addAction("Copy ALL as single lines (batch-ready)", self._llm_copy_all)
        m.addAction("Batch-queue ALL on AI Horde", self._llm_queue_all)
        m.exec(self.llm_out_list.viewport().mapToGlobal(pos))

