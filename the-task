class CameraDirector:
    """Smooth dynamic fighting-game camera with tracking, impact hitshake & dramatic zoom."""

    def __init__(self) -> None:
        self.x: float = STAGE_CENTER_X
        self.y: float = 0.0
        self.zoom: float = 1.0
        self.target_zoom: float = 1.0
        self.shake_mag: float = 0.0
        self.shake_x: float = 0.0
        self.shake_y: float = 0.0
        self.slowmo_timer: int = 0
        self.slowmo_factor: int = 1  # 1 normal, 2 half-speed, 3 dramatic lethal-hit!
        self._slowmo_accum: int = 0

    def reset(self) -> None:
        self.x = STAGE_CENTER_X
        self.y = 0.0
        self.zoom = 1.0
        self.target_zoom = 1.0
        self.shake_mag = 0.0
        self.shake_x = 0.0
        self.shake_y = 0.0
        self.slowmo_timer = 0
        self.slowmo_factor = 1
        self._slowmo_accum = 0

    def add_shake(self, magnitude: float, enabled: bool = True) -> None:
        if enabled:
            self.shake_mag = max(self.shake_mag, clamp(magnitude, 0.0, 22.0))

    def trigger_dramatic_slowmo(self, frames: int, factor: int = 2, zoom: float = 1.08) -> None:
        self.slowmo_timer = max(self.slowmo_timer, frames)
        self.slowmo_factor = max(self.slowmo_factor, factor)
        self.target_zoom = max(self.target_zoom, zoom)

    def should_tick_simulation(self) -> bool:
        if self.slowmo_timer <= 0:
            self.slowmo_factor = 1
            return True
        self.slowmo_timer -= 1
        self._slowmo_accum += 1
        if self._slowmo_accum >= max(1, self.slowmo_factor):
            self._slowmo_accum = 0
            return True
        return False

    def update(self, p1_x: float, p2_x: float, p1_y: float, p2_y: float, dt: float) -> None:
        mid_x = (p1_x + p2_x) * 0.5
        min_cam = INTERNAL_W * 0.5
        max_cam = WORLD_W - INTERNAL_W * 0.5
        target_x = clamp(mid_x, min_cam, max_cam)
        self.x += (target_x - self.x) * clamp(dt * 11.0, 0.0, 1.0)

        # Gentle vertical lift when both/either fighter leaps high
        top_y = min(p1_y, p2_y)
        target_y = clamp((GROUND_Y - top_y) * 0.24, 0.0, 56.0)
        self.y += (target_y - self.y) * clamp(dt * 8.5, 0.0, 1.0)

        # Relax zoom back toward 1.0 smoothly
        if self.slowmo_timer <= 0:
            self.target_zoom = 1.0
        self.zoom += (self.target_zoom - self.zoom) * clamp(dt * 9.0, 0.0, 1.0)

        # Decaying directional hitshake
        if self.shake_mag > 0.25:
            ang = random.uniform(0.0, math.tau)
            self.shake_x = math.cos(ang) * self.shake_mag
            self.shake_y = math.sin(ang) * self.shake_mag
            self.shake_mag *= 0.80
        else:
            self.shake_mag = 0.0
            self.shake_x = 0.0
            self.shake_y = 0.0

    def world_to_screen(self, wx: float, wy: float) -> Tuple[float, float]:
        sx = wx - (self.x - INTERNAL_W * 0.5) + self.shake_x
        sy = wy + self.y + self.shake_y
        return (sx, sy)


class VFXManager:
    """
    AAA Gothic Combat VFX Engine:
      - Explicit R18+ multi-stage arterial blood arcs, fine mist & persistent pools
      - Luminous crimson/magenta steel sparks, parry gold rings & clash shockwaves
      - Interactive swamp water splash geysers
      - Translucent afterimages, Bloodmoon projectiles & Cataclysm flame pillars
      - Full-width Anime Super Cut-In banner & tactical callouts
    """

    def __init__(self, rast: PainterlyRasterizer, bank: SpriteBank, settings: GameSettings) -> None:
        self.rast = rast
        self.bank = bank
        self.settings = settings

        self.particles: List[VFXParticle] = []
        self.rings: List[ShockwaveRing] = []
        self.afterimages: List[AfterimageGhost] = []
        self.callouts: List[TacticalCallout] = []
        self.projectiles: List[BloodMoonProjectile] = []
        self.pillars: List[CataclysmPillar] = []
        self.cutin: Optional[SuperCutInBanner] = None
        self.flash_screen_alpha: float = 0.0
        self.flash_screen_color: RGB = (255, 232, 240)
        self.arcane_sigil_red = generate_arcane_sigil_surface(164, (255, 42, 108), (255, 212, 134))
        self.arcane_sigil_violet = generate_arcane_sigil_surface(164, (198, 72, 255), (242, 224, 255))
        self.sigil_rot: float = 0.0

    def clear(self) -> None:
        self.particles.clear()
        self.rings.clear()
        self.afterimages.clear()
        self.callouts.clear()
        self.projectiles.clear()
        self.pillars.clear()
        self.cutin = None
        self.flash_screen_alpha = 0.0

    def trigger_screen_flash(self, color: RGB = (255, 226, 236), alpha: float = 160.0) -> None:
        self.flash_screen_color = color
        self.flash_screen_alpha = max(self.flash_screen_alpha, clamp(alpha, 0.0, 235.0))

    def trigger_super_cutin(
        self, player_id: int, palette_key: str, move_title: str, move_jp: str, eclipse_mode: bool
    ) -> None:
        self.cutin = SuperCutInBanner(
            player_id=player_id,
            palette_key=palette_key,
            move_title=move_title,
            move_jp=move_jp,
            eclipse_mode=eclipse_mode,
            timer=46,
            max_timer=46,
        )
        self.trigger_screen_flash((255, 42, 108) if not eclipse_mode else (255, 218, 78), 185.0)

    def add_callout(self, text: str, subtext: str, color: RGB, player_id: int = -1, dur: float = 1.15) -> None:
        if len(self.callouts) > 6:
            self.callouts.pop(0)
        self.callouts.append(TacticalCallout(text, subtext, color, player_id, dur, dur))

    def spawn_afterimage(self, fighter: Fighter, tint: Optional[RGB] = None) -> None:
        if len(self.afterimages) > 26:
            self.afterimages.pop(0)
        spr = self.bank.get_sprite(
            fighter.palette_key, fighter.state, fighter.kf_idx, fighter.facing_right, fighter.is_eclipse
        )
        pal = PALETTES.get(fighter.palette_key, PALETTES["CRIMSON_ORIGINAL"])
        ax = SPRITE_ANCHOR_X if fighter.facing_right else (SPRITE_W - SPRITE_ANCHOR_X)
        self.afterimages.append(
            AfterimageGhost(
                sprite=spr,
                world_x=fighter.x,
                world_y=fighter.y,
                anchor_x=ax,
                anchor_y=SPRITE_ANCHOR_Y,
                tint=tint if tint is not None else pal.slash_mid,
                alpha=145.0,
                decay=460.0,
            )
        )

    def spawn_hit_sparks_and_blood(
        self,
        wx: float,
        wy: float,
        facing_sign: float,
        weight: AttackWeight,
        blood_scale: float,
        pal: CeciliaPalette,
        stage: CursedCathedralStage,
        is_lethal: bool = False,
    ) -> None:
        """Spawn layered steel-cleave impact sparks + explicit R18+ arterial blood choreography!"""
        # 1. Razor luminous impact slash streaks & shockwave ring
        ring_r = 42.0 + weight.value * 18.0 + (45.0 if is_lethal else 0.0)
        self.rings.append(ShockwaveRing(wx, wy, 10.0, ring_r, 4.5, pal.slash_mid, 0.24, 0.24))
        if is_lethal:
            self.rings.append(ShockwaveRing(wx, wy, 14.0, ring_r * 1.48, 3.0, (255, 224, 112), 0.36, 0.36))

        spark_n = 10 + weight.value * 4
        for _ in range(spark_n):
            ang = random.uniform(-math.pi, math.pi)
            spd = random.uniform(180.0, 520.0 + weight.value * 60.0)
            self.particles.append(
                VFXParticle(
                    x=wx, y=wy,
                    vx=math.cos(ang) * spd + facing_sign * 90.0,
                    vy=math.sin(ang) * spd - 60.0,
                    gravity=380.0, radius=random.uniform(1.8, 3.8),
                    color=pal.slash_mid, core_color=pal.slash_core,
                    life=random.uniform(0.14, 0.34), max_life=0.34,
                    kind="SLASH_STREAK", angle=ang, length=random.uniform(14.0, 34.0),
                )
            )

        # 2. R18+ Explicit Arterial Blood Spray Choreography (scaled by settings.blood_intensity)
        b_mult = clamp(self.settings.blood_intensity * blood_scale, 0.0, 3.0)
        if b_mult > 0.05:
            drop_n = int((14 + weight.value * 7 + (22 if is_lethal else 0)) * b_mult)
            drop_n = min(68, drop_n)
            for _ in range(drop_n):
                spread = random.uniform(-0.85, 0.85)
                base_ang = (-0.32 if facing_sign > 0 else (math.pi + 0.32)) + spread
                spd = random.uniform(140.0, 480.0) * (1.25 if is_lethal else 1.0)
                col = random.choice(((196, 12, 34), (232, 22, 48), (138, 6, 22), (255, 42, 74)))
                self.particles.append(
                    VFXParticle(
                        x=wx + random.uniform(-8, 8),
                        y=wy + random.uniform(-10, 10),
                        vx=math.cos(base_ang) * spd,
                        vy=math.sin(base_ang) * spd - random.uniform(40.0, 140.0),
                        gravity=760.0,
                        radius=random.uniform(2.0, 5.2),
                        color=col, core_color=None,
                        life=random.uniform(0.32, 0.72), max_life=0.72,
                        kind="BLOOD",
                    )
                )
            if weight.value >= 2:
                stage.add_blood_splatter(wx + facing_sign * 22.0, intensity=b_mult)

    def spawn_guard_or_parry_sparks(
        self, wx: float, wy: float, is_parry: bool = False, is_clash: bool = False
    ) -> None:
        col_main = (255, 224, 92) if (is_parry or is_clash) else (152, 206, 255)
        col_core = (255, 252, 236)
        r_max = 128.0 if (is_parry or is_clash) else 56.0
        self.rings.append(ShockwaveRing(wx, wy, 8.0, r_max, 5.0 if is_parry else 3.0, col_main, 0.28, 0.28))
        n = 28 if (is_parry or is_clash) else 12
        for _ in range(n):
            ang = random.uniform(0.0, math.tau)
            spd = random.uniform(220.0, 620.0 if is_parry else 340.0)
            self.particles.append(
                VFXParticle(
                    x=wx, y=wy, vx=math.cos(ang) * spd, vy=math.sin(ang) * spd,
                    gravity=340.0, radius=2.4, color=col_main, core_color=col_core,
                    life=random.uniform(0.18, 0.40), max_life=0.40,
                    kind="SLASH_STREAK", angle=ang, length=random.uniform(16.0, 38.0),
                )
            )

    def spawn_water_splash_burst(self, wx: float, intensity: float = 1.0) -> None:
        n = clamp_int(int(12 * intensity), 6, 26)
        for _ in range(n):
            self.particles.append(
                VFXParticle(
                    x=wx + random.uniform(-18, 18), y=GROUND_Y - 2.0,
                    vx=random.uniform(-125.0, 125.0) * intensity,
                    vy=random.uniform(-240.0, -90.0) * intensity,
                    gravity=720.0, radius=random.uniform(1.8, 3.6),
                    color=(244, 178, 212), core_color=(255, 240, 250),
                    life=random.uniform(0.24, 0.48), max_life=0.48,
                    kind="WATER",
                )
            )

    def spawn_projectile(self, owner: Fighter) -> None:
        sign = 1.0 if owner.facing_right else -1.0
        self.projectiles.append(
            BloodMoonProjectile(
                owner_id=owner.player_id,
                x=owner.x + sign * 74.0,
                y=owner.y - 94.0,
                vx=sign * (11.5 if owner.is_eclipse else 9.6),
                facing_right=owner.facing_right,
                palette_key=owner.palette_key,
                damage=920,
                chip_damage=130,
                poise_damage=165,
                life=72,
            )
        )

    def spawn_cataclysm_pillar(self, owner: Fighter, offset_x: float) -> None:
        sign = 1.0 if owner.facing_right else -1.0
        px = clamp(owner.x + sign * offset_x, STAGE_LEFT_WALL + 20, STAGE_RIGHT_WALL - 20)
        pal = PALETTES.get(owner.palette_key, PALETTES["CRIMSON_ORIGINAL"])
        self.pillars.append(
            CataclysmPillar(
                owner_id=owner.player_id,
                world_x=px,
                height=24.0,
                max_height=340.0,
                width=82.0,
                color_inner=pal.slash_core,
                color_outer=pal.slash_mid,
                life=0.46,
                max_life=0.46,
            )
        )

    def update(self, dt: float) -> None:
        self.sigil_rot = (self.sigil_rot + dt * 54.0) % 360.0
        self.flash_screen_alpha = max(0.0, self.flash_screen_alpha - dt * 520.0)

        if self.cutin is not None:
            self.cutin.timer -= 1
            if self.cutin.timer <= 0:
                self.cutin = None

        alive_p: List[VFXParticle] = []
        for p in self.particles:
            p.life -= dt
            if p.life <= 0.0:
                continue
            p.vy += p.gravity * dt
            p.x += p.vx * dt
            p.y += p.vy * dt
            if p.y > GROUND_Y + 6.0 and p.kind in ("BLOOD", "WATER"):
                p.y = GROUND_Y + 6.0
                p.vx *= 0.35
                p.vy *= -0.18
            alive_p.append(p)
        if len(alive_p) > 260:
            alive_p = alive_p[-260:]
        self.particles = alive_p

        alive_r: List[ShockwaveRing] = []
        for r in self.rings:
            r.life -= dt
            if r.life <= 0.0:
                continue
            u = 1.0 - (r.life / max(0.01, r.max_life))
            r.radius = lerp(10.0, r.max_radius, ease_out_cubic(u))
            alive_r.append(r)
        self.rings = alive_r

        alive_ai: List[AfterimageGhost] = []
        for ai in self.afterimages:
            ai.alpha -= ai.decay * dt
            if ai.alpha > 8.0:
                alive_ai.append(ai)
        self.afterimages = alive_ai

        alive_c: List[TacticalCallout] = []
        for c in self.callouts:
            c.life -= dt
            if c.life > 0.0:
                alive_c.append(c)
        self.callouts = alive_c

        alive_proj: List[BloodMoonProjectile] = []
        for pr in self.projectiles:
            pr.x += pr.vx
            pr.life -= 1
            if pr.life > 0 and STAGE_LEFT_WALL - 80 <= pr.x <= STAGE_RIGHT_WALL + 80 and not pr.hit_already:
                alive_proj.append(pr)
        self.projectiles = alive_proj

        alive_pil: List[CataclysmPillar] = []
        for pil in self.pillars:
            pil.life -= dt
            if pil.life <= 0.0:
                continue
            u = 1.0 - (pil.life / max(0.01, pil.max_life))
            pil.height = pil.max_height * (ease_out_expo(min(1.0, u * 3.0)) if u < 0.6 else max(0.0, (1.0 - u) * 2.5))
            alive_pil.append(pil)
        self.pillars = alive_pil

    def render_world_vfx(self, dest: pygame.Surface, cam: CameraDirector) -> None:
        """Render afterimages, Cataclysm pillars, Bloodmoon projectiles, shockwaves & blood particles."""
        # 1. Translucent crimson/violet motion afterimages
        for ai in self.afterimages:
            sx, sy = cam.world_to_screen(ai.world_x, ai.world_y)
            ghost = ai.sprite.copy()
            ghost.fill((ai.tint[0], ai.tint[1], ai.tint[2], 255), special_flags=pygame.BLEND_RGBA_MULT)
            ghost.set_alpha(clamp_int(int(ai.alpha), 0, 200))
            dest.blit(ghost, (int(sx - ai.anchor_x), int(sy - ai.anchor_y)))

        # 2. Towering Bloodmoon Cataclysm flame pillars
        for pil in self.pillars:
            sx, sy = cam.world_to_screen(pil.world_x, GROUND_Y)
            u = pil.life / max(0.01, pil.max_life)
            w_cur = max(6, int(pil.width * (0.4 + 0.7 * u)))
            h_cur = max(12, int(pil.height))
            rect = pygame.Rect(int(sx - w_cur // 2), int(sy - h_cur), w_cur, h_cur)
            p_surf = pygame.Surface((w_cur, h_cur), pygame.SRCALPHA)
            pygame.draw.rect(p_surf, with_alpha(pil.color_outer, int(195 * u)), (0, 0, w_cur, h_cur))
            core_w = max(4, w_cur // 3)
            pygame.draw.rect(p_surf, with_alpha(pil.color_inner, int(235 * u)), (w_cur // 2 - core_w // 2, 0, core_w, h_cur))
            dest.blit(p_surf, rect.topleft)
            self.rast.paint_radial_bloom(dest, sx, sy - 16, w_cur * 1.4, pil.color_outer, alpha=int(160 * u), additive=True)

        # 3. Flying Bloodmoon Crescent projectiles
        for pr in self.projectiles:
            sx, sy = cam.world_to_screen(pr.x, pr.y)
            pal = PALETTES.get(pr.palette_key, PALETTES["CRIMSON_ORIGINAL"])
            sign = 1.0 if pr.facing_right else -1.0
            outer = [
                Vec2(sx - sign * 24, sy - 66),
                Vec2(sx + sign * 26, sy - 42),
                Vec2(sx + sign * 48, sy),
                Vec2(sx + sign * 26, sy + 42),
                Vec2(sx - sign * 24, sy + 66),
            ]
            inner = [
                Vec2(sx - sign * 32, sy - 54),
                Vec2(sx + sign * 2, sy - 30),
                Vec2(sx + sign * 18, sy),
                Vec2(sx + sign * 2, sy + 30),
                Vec2(sx - sign * 32, sy + 54),
            ]
            self.rast.paint_painterly_slash_wave(dest, outer, inner, pal, intensity=1.35, seed=pr.life)

        # 4. Expanding Shockwave Rings
        for r in self.rings:
            sx, sy = cam.world_to_screen(r.x, r.y)
            u = r.life / max(0.01, r.max_life)
            rad = max(4, int(r.radius))
            rs = pygame.Surface((rad * 2 + 6, rad * 2 + 6), pygame.SRCALPHA)
            pygame.draw.circle(rs, with_alpha(r.color, int(225 * u)), (rad + 3, rad + 3), rad, max(1, int(r.thickness * u)))
            dest.blit(rs, (int(sx - rad - 3), int(sy - rad - 3)))

        # 5. Sparks, Arterial Blood Droplets & Water Sprays
        for p in self.particles:
            sx, sy = cam.world_to_screen(p.x, p.y)
            if -40 <= sx <= INTERNAL_W + 40 and -40 <= sy <= INTERNAL_H + 40:
                u = clamp(p.life / max(0.01, p.max_life), 0.0, 1.0)
                if p.kind == "SLASH_STREAK":
                    vel_v = Vec2(p.vx, p.vy).normalized()
                    p0 = (int(sx), int(sy))
                    p1 = (int(sx - vel_v.x * p.length * u), int(sy - vel_v.y * p.length * u))
                    pygame.draw.line(dest, p.color, p0, p1, max(1, int(p.radius * 1.4)))
                    if p.core_color is not None:
                        pygame.draw.line(dest, p.core_color, p0, p1, 1)
                elif p.kind == "BLOOD":
                    rad = max(1, int(p.radius * (0.55 + 0.45 * u)))
                    pygame.draw.circle(dest, p.color, (int(sx), int(sy)), rad)
                    # Motion droplet tail
                    tail_x = int(sx - p.vx * 0.014)
                    tail_y = int(sy - p.vy * 0.014)
                    pygame.draw.line(dest, p.color, (int(sx), int(sy)), (tail_x, tail_y), max(1, rad))
                else:
                    rad = max(1, int(p.radius * u))
                    pygame.draw.circle(dest, p.color, (int(sx), int(sy)), rad)

    def render_screen_overlays(self, dest: pygame.Surface, fonts: FontManager) -> None:
        """Render Super Cut-In Anime CG Banner, screen flashes & tactical battle callouts."""
        if self.flash_screen_alpha > 4.0:
            fl = pygame.Surface((INTERNAL_W, INTERNAL_H), pygame.SRCALPHA)
            fl.fill(with_alpha(self.flash_screen_color, int(self.flash_screen_alpha)))
