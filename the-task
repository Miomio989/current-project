class StylishRankTracker:
    """
    Devil May Cry 4 / Bayonetta / mockup.jpg Stylish Rank Engine (D -> SSS).
    Rewards move variety, clean combos, Just-Guard Soul Deflects, Clashes,
    Shadow Cancels, and Super finishes while gently penalizing spam!
    """

    def __init__(self) -> None:
        self.points: float = 0.0
        self.rank: StyleRank = StyleRank.NONE
        self.combo_hits: int = 0
        self.combo_damage: int = 0
        self.style_bonus: int = 0
        self.recent_moves: Deque[FighterState] = collections.deque(maxlen=4)
        self.display_timer: float = 0.0
        self.rank_flash: float = 0.0

    def reset_round(self) -> None:
        self.points = 0.0
        self.rank = StyleRank.NONE
        self.combo_hits = 0
        self.combo_damage = 0
        self.style_bonus = 0
        self.recent_moves.clear()
        self.display_timer = 0.0
        self.rank_flash = 0.0

    def on_hit_landed(
        self, state: FighterState, base_pts: int, dmg: int, is_counter: bool = False
    ) -> bool:
        """Returns True if Stylish Rank leveled up!"""
        self.combo_hits += 1
        self.combo_damage += dmg
        repeats = sum(1 for m in self.recent_moves if m == state)
        variety_mul = 1.0 if repeats == 0 else (0.55 if repeats == 1 else 0.25)
        gain = base_pts * variety_mul * (1.35 if is_counter else 1.0)
        self.points = min(2800.0, self.points + gain)
        self.style_bonus += int(gain * 1.45)
        self.recent_moves.append(state)
        self.display_timer = 3.2
        return self._recalc_rank()

    def on_stylish_event(self, bonus_pts: float) -> bool:
        self.points = min(2800.0, self.points + bonus_pts)
        self.style_bonus += int(bonus_pts * 1.6)
        self.display_timer = 3.2
        return self._recalc_rank()

    def on_damaged(self) -> None:
        self.points = max(0.0, self.points * 0.45 - 180.0)
        self.combo_hits = 0
        self.combo_damage = 0
        self._recalc_rank()

    def end_combo(self) -> None:
        self.combo_hits = 0
        self.combo_damage = 0

    def update(self, dt: float, in_combo: bool) -> None:
        if self.rank_flash > 0.0:
            self.rank_flash = max(0.0, self.rank_flash - dt * 3.0)
        decay = 38.0 if in_combo else 115.0
        if self.points > 0.0:
            self.points = max(0.0, self.points - decay * dt)
            self._recalc_rank()
        if self.display_timer > 0.0 and not in_combo:
            self.display_timer = max(0.0, self.display_timer - dt)

    def _recalc_rank(self) -> bool:
        old_tier = self.rank.tier
        new_r = StyleRank.NONE
        for r in StyleRank:
            if self.points >= r.threshold:
                new_r = r
        self.rank = new_r
        if new_r.tier > old_tier and new_r.tier >= 1:
            self.rank_flash = 1.0
            return True
        return False


class Fighter:
    """
    Complete fighting-game character controller for Cecilia Darkmoon (P1 / P2).
    Handles frame-accurate state playback, physics, cancel windows, guard/just-
    guard timing, Dark Souls poise, Soulcalibur guard-crush, Eclipse Overdrive,
    recoverable vitality, and hit-tracking.
    """

    def __init__(
        self,
        player_id: int,
        name: str,
        title: str,
        pal_idx: int,
        atlas: Dict[FighterState, List[CelKeyframePlate]],
        moves: Dict[FighterState, MoveSpec],
    ) -> None:
        self.player_id = player_id
        self.name = name
        self.title = title
        self.pal_idx = pal_idx
        self.atlas = atlas
        self.moves = moves

        # World Kinematics
        self.x: float = 560.0 if player_id == 0 else 1040.0
        self.y: float = GROUND_Y
        self.vx: float = 0.0
        self.vy: float = 0.0
        self.facing_right: bool = (player_id == 0)
        self.grounded: bool = True

        # State Machine & Frame Counters
        self.state: FighterState = FighterState.IDLE
        self.frame_idx: int = 0
        self.frame_tick: int = 0
        self.state_elapsed: int = 0
        self.hitstop: int = 0
        self.hitstun_left: int = 0
        self.blockstun_left: int = 0
        self.just_guard_window: int = 0
        self.invuln_frames: int = 0
        self.air_actions_left: int = 1
        self.has_hit_this_move: bool = False
        self.move_hit_count: int = 0
        self.last_multi_hit_frame: int = -99
        self.did_wall_bounce: bool = False
        self.did_ground_bounce: bool = False
        self.combo_received: int = 0
        self.combo_scaling: float = 1.0

        # Gauges (Life, Delayed Damage Trail, Grey Recoverable HP, Curse, Guard, Poise, Eclipse)
        self.health: int = BASE_MAX_HEALTH
        self.display_health_trail: float = float(BASE_MAX_HEALTH)
        self.recoverable_hp: float = float(BASE_MAX_HEALTH)
        self.curse_meter: int = 2500
        self.guard_gauge: float = BASE_MAX_GUARD_GAUGE
        self.poise: float = BASE_MAX_POISE
        self.eclipse_timer: float = 0.0
        self.shadow_slow_timer: float = 0.0
        self.rounds_won: int = 0

        # Input & Stylish Trackers
        self.input_buf = InputBuffer()
        self.stylish = StylishRankTracker()
        self.last_attack_frame_adv: int = 0

    def reset_for_round(self, start_x: float, facing_right: bool, keep_meter: bool = True) -> None:
        self.x = start_x
        self.y = GROUND_Y
        self.vx = 0.0
        self.vy = 0.0
        self.facing_right = facing_right
        self.grounded = True
        self.health = BASE_MAX_HEALTH
        self.display_health_trail = float(BASE_MAX_HEALTH)
        self.recoverable_hp = float(BASE_MAX_HEALTH)
        if not keep_meter:
            self.curse_meter = 2500
        self.guard_gauge = BASE_MAX_GUARD_GAUGE
        self.poise = BASE_MAX_POISE
        self.eclipse_timer = 0.0
        self.shadow_slow_timer = 0.0
        self.hitstop = 0
        self.hitstun_left = 0
        self.blockstun_left = 0
        self.just_guard_window = 0
        self.invuln_frames = 0
        self.air_actions_left = 1
        self.combo_received = 0
        self.combo_scaling = 1.0
        self.did_wall_bounce = False
        self.did_ground_bounce = False
        self.stylish.reset_round()
        self.enter_state(FighterState.IDLE)

    def current_frames(self) -> List[CelKeyframePlate]:
        return self.atlas.get(self.state) or self.atlas[FighterState.IDLE]

    def current_keyframe(self) -> CelKeyframePlate:
        frames = self.current_frames()
        return frames[clamp_int(self.frame_idx, 0, len(frames) - 1)]

    def is_attacking(self) -> bool:
        return self.state in self.moves

    def is_hitstun(self) -> bool:
        return self.state in (
            FighterState.HIT_HIGH, FighterState.HIT_MID, FighterState.HIT_LOW,
            FighterState.HIT_HEAVY, FighterState.HIT_CRUMPLE, FighterState.HIT_LAUNCH,
            FighterState.HIT_AIR_TUMBLE, FighterState.HIT_WALL_BOUNCE, FighterState.HIT_GROUND_BOUNCE,
            FighterState.GUARD_CRUSH, FighterState.KNOCKDOWN_LIE, FighterState.KO_COLLAPSE,
        )

    def is_guarding_state(self) -> bool:
        return self.state in (
            FighterState.GUARD_STAND, FighterState.GUARD_CROUCH,
            FighterState.GUARD_AIR, FighterState.JUST_GUARD_DEFLECT,
        )

    def is_free_actionable(self) -> bool:
        return self.state in (
            FighterState.IDLE, FighterState.IDLE_BATTLE_BREATH,
            FighterState.WALK_FWD, FighterState.WALK_BACK,
            FighterState.CROUCH_ENTER, FighterState.CROUCH_HOLD,
            FighterState.RUN_LOOP, FighterState.RUN_STOP,
            FighterState.JUMP_RISE, FighterState.JUMP_APEX,
            FighterState.JUMP_FALL, FighterState.DOUBLE_JUMP,
        )

    def enter_state(self, new_state: FighterState) -> None:
        self.state = new_state
        self.frame_idx = 0
        self.frame_tick = 0
        self.state_elapsed = 0
        self.has_hit_this_move = False
        self.move_hit_count = 0
        self.last_multi_hit_frame = -99

    def get_world_boxes(self, local_boxes: Sequence[BoxRect]) -> List[BoxRect]:
        out: List[BoxRect] = []
        for b in local_boxes:
            if self.facing_right:
                wx = self.x + b.x
            else:
                wx = self.x - (b.x + b.w)
            wy = self.y + b.y
            out.append(BoxRect(wx, wy, b.w, b.h))
        return out

    def pushbox_world(self) -> BoxRect:
        h = 112.0 if self.state in (FighterState.CROUCH_HOLD, FighterState.CROUCH_ENTER, FighterState.GUARD_CROUCH) else 156.0
        return BoxRect(self.x - 24.0, self.y - h, 48.0, h)

    def hurtboxes_world(self) -> List[BoxRect]:
        kf = self.current_keyframe()
        if kf.hurtboxes:
            return self.get_world_boxes(kf.hurtboxes)
        # Sensible anatomical fallback hurtbox
        h = 118.0 if not self.grounded or self.state == FighterState.CROUCH_HOLD else 166.0
        return [BoxRect(self.x - 28.0, self.y - h, 56.0, h)]

    def hitboxes_world(self) -> List[BoxRect]:
        kf = self.current_keyframe()
        return self.get_world_boxes(kf.hitboxes) if kf.hitboxes else []

    def clashboxes_world(self) -> List[BoxRect]:
        kf = self.current_keyframe()
        return self.get_world_boxes(kf.clashboxes) if kf.clashboxes else []

    def can_cancel_into(self, target_state: FighterState) -> bool:
        if self.is_free_actionable():
            return True
        if self.state not in self.moves:
            return False
        cur_move = self.moves[self.state]
        if not self.has_hit_this_move and not cur_move.cancel_on_whiff:
            # Shadow Cancel works even on whiff!
            if target_state == FighterState.SHADOW_CANCEL and self.curse_meter >= 5000:
                return True
            return False
        if target_state == FighterState.SHADOW_CANCEL:
            return bool(cur_move.cancels & CancelFlag.SHADOW_CANCEL) and self.curse_meter >= 5000
        tgt = self.moves.get(target_state)
        if tgt is None:
            return False
        if tgt.weight in (AttackWeight.SUPER, AttackWeight.ASTRAL):
            return bool(cur_move.cancels & CancelFlag.SUPER)
        if tgt.weight == AttackWeight.SPECIAL:
            return bool(cur_move.cancels & CancelFlag.SPECIAL)
        if target_state in (FighterState.ATK_6A, FighterState.ATK_6B, FighterState.ATK_3C, FighterState.ATK_6C):
            return bool(cur_move.cancels & CancelFlag.COMMAND_NORMAL)
        if tgt.weight.value > cur_move.weight.value:
            return bool(cur_move.cancels & CancelFlag.CHAIN_NORMAL)
        return False

    def try_consume_commands(
        self,
        opponent: "Fighter",
        simple_mode: bool,
        audio: AudioEngine,
        vfx: "VFXDirector",
    ) -> None:
        """Evaluate buffered motions & buttons cleanly in priority order."""
        if self.is_hitstun() or self.is_guarding_state():
            # Allow wakeup tech roll during Knockdown
            if self.state == FighterState.KNOCKDOWN_LIE and self.state_elapsed >= 16:
                np = self.input_buf.latest().numpad
                if self.input_buf.pressed_within(InputButton.A | InputButton.B | InputButton.C, 4):
                    if np in (6, 3, 9):
                        self.enter_state(FighterState.WAKEUP_ROLL_FWD)
                        self.invuln_frames = 18
                    elif np in (4, 1, 7):
                        self.enter_state(FighterState.WAKEUP_ROLL_BACK)
                        self.invuln_frames = 18
                    else:
                        self.enter_state(FighterState.WAKEUP_NEUTRAL)
                        self.invuln_frames = 14
            return

        if self.state in (
            FighterState.WAKEUP_NEUTRAL, FighterState.WAKEUP_ROLL_FWD, FighterState.WAKEUP_ROLL_BACK,
            FighterState.THROW_EXECUTE, FighterState.INTRO_SALUTE, FighterState.ROUND_WIN,
            FighterState.MATCH_VICTORY, FighterState.WEAPON_CLASH,
        ):
            return

        inp = self.input_buf.latest()
        np = inp.numpad
        p_a = bool(inp.pressed & InputButton.A)
        p_b = bool(inp.pressed & InputButton.B)
        p_c = bool(inp.pressed & InputButton.C)
        p_d = bool(inp.pressed & InputButton.D)
        p_any_atk = p_a or p_b or p_c or p_d

        # Track Just-Guard 5-frame parry window whenever player freshly taps Back (4/1)!
        if np in (4, 1):
            prev_np = self.input_buf.frames[-2].numpad if len(self.input_buf.frames) >= 2 else 5
            if prev_np not in (4, 1):
                self.just_guard_window = 6

        # 1. Shadow Roman Cancel (50% Gauge) — instant time-dilation cancel!
        want_shadow = bool(inp.pressed & InputButton.SHADOW) or (
            (inp.held & InputButton.A) and (inp.held & InputButton.B) and (p_a or p_b)
        )
        if want_shadow and self.is_attacking() and self.can_cancel_into(FighterState.SHADOW_CANCEL):
            self.curse_meter -= 5000
            self.enter_state(FighterState.SHADOW_CANCEL)
            opponent.shadow_slow_timer = 0.72
            self.stylish.on_stylish_event(240)
            audio.play_sfx(SFXId.SHADOW_CANCEL_BURST, self._pan())
            vfx.spawn_shockwave(self.x, self.y - 96.0, (255, 42, 134), 165.0, width=6)
            vfx.spawn_callout("SHADOW CANCEL!", self.x, self.y - 185.0, (255, 118, 198))
            return

        # 2. Eclipse Overdrive (50% Gauge + A+B+C or H)
        want_eclipse = bool(inp.pressed & InputButton.ECLIPSE) or (
            (inp.held & InputButton.A) and (inp.held & InputButton.B) and (inp.held & InputButton.C) and p_any_atk
        )
        if want_eclipse and self.grounded and self.eclipse_timer <= 0.0 and self.curse_meter >= 5000 and self.is_free_actionable():
            self.curse_meter -= 5000
            self.eclipse_timer = 11.5
            self.enter_state(FighterState.ECLIPSE_ACTIVATE)
            self.invuln_frames = 16
            self.stylish.on_stylish_event(320)
            audio.play_sfx(SFXId.ECLIPSE_OVERDRIVE, self._pan())
            vfx.spawn_shockwave(self.x, self.y - 96.0, (255, 196, 68), 210.0, width=8)
            vfx.spawn_callout("ECLIPSE OVERDRIVE!", self.x, self.y - 196.0, (255, 212, 92))
            return

        # 3. Distortion Supers & 100% Astral Execution
        if self.grounded and p_any_atk:
            # 100% Astral Execution: 236236+D (or simple: 6+C+D)
            if p_d and self.curse_meter >= 10000 and (
                self.input_buf.match_motion((2, 6, 2, 6), 22)
                or (simple_mode and np == 6 and (inp.held & InputButton.C))
            ):
                if self.can_cancel_into(FighterState.ASTRAL_DARKMOON_JUDGE):
                    self._launch_attack(FighterState.ASTRAL_DARKMOON_JUDGE, audio, vfx)
                    return

            # 50% Scarlet Requiem: 236236+C (or simple: 6+B+C)
            if p_c and self.curse_meter >= 5000 and (
                self.input_buf.match_motion((2, 6, 2, 6), 22)
                or (simple_mode and np == 6 and (inp.held & InputButton.B))
            ):
                if self.can_cancel_into(FighterState.SUPER_SCARLET_REQUIEM):
                    self._launch_attack(FighterState.SUPER_SCARLET_REQUIEM, audio, vfx)
                    return

            # 50% Eclipse Cataclysm: 214214+C (or simple: 4+B+C)
            if p_c and self.curse_meter >= 5000 and (
                self.input_buf.match_motion((2, 4, 2, 4), 22)
