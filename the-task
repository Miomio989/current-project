class ScreenTransition:
    """Silky crimson-ink gothic slash screen transition wipe between game screens."""

    def __init__(self) -> None:
        self.active: bool = False
        self.progress: float = 0.0
        self.swapped: bool = False
        self.target_state: ScreenState = ScreenState.TITLE
        self.on_midpoint: Optional[Callable[[], None]] = None
        self.duration_sec: float = 0.34

    def trigger(
        self, target_state: ScreenState, on_midpoint: Optional[Callable[[], None]] = None
    ) -> None:
        self.active = True
        self.progress = 0.0
        self.swapped = False
        self.target_state = target_state
        self.on_midpoint = on_midpoint

    def update(self, dt: float) -> Optional[ScreenState]:
        if not self.active:
            return None
        self.progress += dt / max(0.08, self.duration_sec)
        switched: Optional[ScreenState] = None
        if not self.swapped and self.progress >= 0.5:
            self.swapped = True
            switched = self.target_state
            if self.on_midpoint is not None:
                self.on_midpoint()
        if self.progress >= 1.0:
            self.active = False
            self.progress = 0.0
        return switched

    def render(self, target: pygame.Surface) -> None:
        if not self.active:
            return
        # Smooth bell-curve obsidian & crimson slash curtain
        env = math.sin(clamp(self.progress, 0.0, 1.0) * math.pi)
        al = clamp_int(int(248 * env), 0, 255)
        ov = pygame.Surface((SCREEN_W, SCREEN_H), pygame.SRCALPHA)
        ov.fill((10, 2, 8, al))
        # Sweeping crimson blade streak across diagonal during transition
        sx = int(lerp(-320.0, SCREEN_W + 320.0, self.progress))
        streak = [(sx, 0), (sx + 110, 0), (sx - 210, SCREEN_H), (sx - 320, SCREEN_H)]
        pygame.draw.polygon(ov, (224, 18, 48, clamp_int(int(180 * env), 0, 220)), streak)
        pygame.draw.line(ov, (255, 226, 184, clamp_int(int(220 * env), 0, 240)), (sx + 55, 0), (sx - 265, SCREEN_H), 3)
        target.blit(ov, (0, 0))


class NoroiNoYaibaApp:
    """Top-level AAA host for 呪いの刃 managing Pygame lifecycle, HD scaling,
    fixed 60Hz simulation, screen routing, progressive asset baking, and audio.
    """

    def __init__(self, headless: bool = False) -> None:
        self.headless = headless
        if headless:
            os.environ.setdefault("SDL_VIDEODRIVER", "dummy")
            os.environ.setdefault("SDL_AUDIODRIVER", "dummy")

        pygame.init()
        pygame.display.set_caption(f"{GAME_TITLE_JP} — {GAME_SUBTITLE_EN}")

        self.settings = GameSettings()
        self.training_cfg = TrainingSettings()
        self.archive = DarkmoonArchive()

        # Resizable / fullscreen desktop window MUST initialize before Surface.convert()
        self.window = self._create_window(fullscreen=False)
        self.canvas = pygame.Surface((SCREEN_W, SCREEN_H)).convert()
        self.clock = pygame.time.Clock()
        self.running: bool = True

        # Core procedural engines
        self.fonts = FontManager()
        self.rast = PainterlyRasterizer()
        self.cecilia_renderer = CeciliaRenderer(self.rast)
        self.bank = SpriteBank(self.rast, self.cecilia_renderer)
        self.stage = CursedCathedralStage(self.rast)
        self.audio = AudioManager(self.settings)
        self.inputs = InputManager()

        # Screens & Directors
        self.menus = MenuScreensRenderer(self.fonts, self.bank, self.stage, self.settings)
        self.codex = CommandListScreen(self.fonts, self.bank, self.stage)
        self.options = OptionsScreen(self.fonts, self.stage, self.settings, self.audio)
        self.gallery = GalleryScreen(self.fonts, self.bank, self.stage, self.audio, self.archive)
        self.match = MatchDirector(
            self.settings,
            self.training_cfg,
            self.fonts,
            self.bank,
            self.stage,
            self.audio,
            self.inputs,
            self.rast,
        )
        self.transition = ScreenTransition()

        # Screen state & progressive loading tracking
        self.screen: ScreenState = ScreenState.LOADING
        self._load_phase: int = 0
        self._load_progress: float = 0.0
        self._load_status: str = "Awakening Cursed Cathedral Ruins..."
        self._return_screen_after_sub: ScreenState = ScreenState.MAIN_MENU
        self._recorded_current_match_end: bool = False
        self._fps_smooth: float = 60.0

    def _create_window(self, fullscreen: bool) -> pygame.Surface:
        flags = pygame.FULLSCREEN | pygame.SCALED if fullscreen else pygame.RESIZABLE
        try:
            return pygame.display.set_mode((SCREEN_W, SCREEN_H), flags)
        except Exception:
            return pygame.display.set_mode((SCREEN_W, SCREEN_H))

    def _apply_display_mode(self) -> None:
        self.window = self._create_window(self.settings.fullscreen)

    def complete_loading_synchronously(self) -> None:
        """Finish all progressive baking immediately (used by headless QA verifier)."""
        self.stage.ensure_baked()
        self.audio.ensure_baked()
        while not self.bank.is_preload_complete():
            self.bank.step_preload(budget_items=32)
        self.bank.get_title_hero_art()
        self._load_progress = 1.0
        self.screen = ScreenState.TITLE

    def _step_progressive_loading(self) -> None:
        """Bake Stage -> Procedural 146 BPM OST & 35 SFX -> Priority Cecilia Sprites smoothly."""
        if self._load_phase == 0:
            p = self.stage.step_bake()
            self._load_progress = p * 0.28
            self._load_status = "Constructing Cursed Romanesque Cathedral Swamp..."
            if p >= 1.0:
                self._load_phase = 1
        elif self._load_phase == 1:
            p = self.audio.step_bake()
            self._load_progress = 0.28 + p * 0.34
            self._load_status = "Synthesizing 146 BPM Techno / Breakbeat OST & Combat SFX..."
            if p >= 1.0:
                self._load_phase = 2
        elif self._load_phase == 2:
            p = self.bank.step_preload(budget_items=8)
            self._load_progress = 0.62 + p * 0.34
            self._load_status = "Painting Cecilia Darkmoon Hand-Crafted Keyframes..."
            if p >= 1.0:
                self._load_phase = 3
        elif self._load_phase == 3:
            self.bank.get_title_hero_art()
            self._load_progress = 1.0
            self._load_status = "Cursed Blade Unsealed."
            self._load_phase = 4
            self.audio.play_bgm(BGMId.TITLE_THEME)
            self.transition.trigger(ScreenState.TITLE)

    # --------------------------------------------------------------------------
    # EVENT ROUTING ACROSS ALL SCREENS
    # --------------------------------------------------------------------------
    def handle_events(self) -> None:
        for ev in pygame.event.get():
            if ev.type == pygame.QUIT:
                self.running = False
                return
            if ev.type in (pygame.JOYDEVICEADDED, pygame.JOYDEVICEREMOVED):
                self.inputs.rescan_joysticks()
                continue
            if ev.type == pygame.KEYDOWN:
                if ev.key == pygame.K_F11:
                    self.settings.fullscreen = not self.settings.fullscreen
                    self._apply_display_mode()
                    continue
                if self.transition.active:
                    continue
                self._route_keydown(ev.key)

    def _route_keydown(self, key: int) -> None:
        if self.screen == ScreenState.LOADING:
            return

        if self.screen == ScreenState.TITLE:
            if key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_u, pygame.K_j, pygame.K_z):
                self.audio.play_sfx(SFXId.UI_CONFIRM, vol_scale=1.0)
                self.transition.trigger(ScreenState.MAIN_MENU)
            elif key == pygame.K_ESCAPE:
                self.running = False
            return

        if self.screen == ScreenState.MAIN_MENU:
            action = self.menus.handle_main_menu_key(key, self.audio)
            if action is None:
                return
            if action == "BACK_TITLE":
                self.transition.trigger(ScreenState.TITLE)
            elif action == "ARCADE TRIAL":
                self._launch_mode_with_setup(GameMode.ARCADE, skip_setup=False)
            elif action == "VERSUS CPU":
                self._launch_mode_with_setup(GameMode.VERSUS_CPU, skip_setup=False)
            elif action == "VERSUS 2P LOCAL":
                self._launch_mode_with_setup(GameMode.VERSUS_2P, skip_setup=False)
            elif action == "SURVIVAL GAUNTLET":
                self._launch_mode_with_setup(GameMode.SURVIVAL, skip_setup=False)
            elif action == "TRAINING LAB":
                self._launch_mode_with_setup(GameMode.TRAINING, skip_setup=False)
            elif action == "COMMAND LIST & CODEX":
                self._return_screen_after_sub = ScreenState.MAIN_MENU
                self.transition.trigger(ScreenState.COMMAND_LIST)
            elif action == "KEYFRAME & OST GALLERY":
                self._return_screen_after_sub = ScreenState.MAIN_MENU
                self.transition.trigger(ScreenState.GALLERY)
            elif action == "OPTIONS & CONTROLS":
                self._return_screen_after_sub = ScreenState.MAIN_MENU
                self.transition.trigger(ScreenState.OPTIONS)
            elif action == "EXIT GAME":
                self.running = False
            return

        if self.screen == ScreenState.MATCH_SETUP:
            res = self.menus.handle_setup_key(key, self.audio)
            if res == "BACK_MENU":
                self.transition.trigger(ScreenState.MAIN_MENU)
            elif res == "START_MATCH":
                self._begin_selected_match()
            return

        if self.screen == ScreenState.VS_SPLASH:
            if key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_u, pygame.K_ESCAPE):
                self.menus.vs_timer = 0
            return

        if self.screen == ScreenState.BATTLE:
            nav = self.match.handle_keydown(key)
            if nav == "OPEN_CODEX":
                self._return_screen_after_sub = ScreenState.BATTLE
                self.screen = ScreenState.COMMAND_LIST
            elif nav == "OPEN_OPTIONS":
                self._return_screen_after_sub = ScreenState.BATTLE
                self.screen = ScreenState.OPTIONS
            elif nav == "OPEN_SETUP":
                self.audio.play_bgm(BGMId.TITLE_THEME)
                self.menus.open_setup(self.match.mode)
                self.transition.trigger(ScreenState.MATCH_SETUP)
            elif nav == "EXIT_TO_MENU":
                self.audio.play_bgm(BGMId.TITLE_THEME)
                self.transition.trigger(ScreenState.MAIN_MENU)
            elif nav == "SHOW_VS_NEXT":
                self._recorded_current_match_end = False
                self.menus.start_vs_splash(
                    self.match.p1.palette_idx,
                    self.match.p2.palette_idx,
                    rival=self.match.current_rival,
                    stage_label=self.match.get_arcade_stage_label(),
                )
                self.transition.trigger(ScreenState.VS_SPLASH)
            elif nav == "ARCADE_ENDING":
                elapsed = max(1.0, time.time() - self.match.arcade_start_time)
                self.archive.record_arcade_clear(self.match.arcade_total_score)
                self.menus.set_arcade_ending(
                    self.match.arcade_total_score, self.match.arcade_accum_stats, elapsed
                )
                self.audio.play_bgm(BGMId.VICTORY_THEME)
                self.transition.trigger(ScreenState.ARCADE_ENDING)
            return

        if self.screen == ScreenState.COMMAND_LIST:
            if self.codex.handle_key(key, self.audio) == "CLOSE":
                self.screen = self._return_screen_after_sub
            return

        if self.screen == ScreenState.OPTIONS:
            res = self.options.handle_key(key)
            if self.options.display_changed_flag:
                self.options.display_changed_flag = False
                self._apply_display_mode()
            if res == "CLOSE":
                self.screen = self._return_screen_after_sub
            return

        if self.screen == ScreenState.GALLERY:
            if self.gallery.handle_key(key) == "CLOSE":
                self.audio.play_bgm(BGMId.TITLE_THEME)
                self.transition.trigger(ScreenState.MAIN_MENU)
            return

        if self.screen == ScreenState.ARCADE_ENDING:
            if key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_ESCAPE):
                self.audio.play_sfx(SFXId.UI_CONFIRM, vol_scale=0.9)
                self.audio.play_bgm(BGMId.TITLE_THEME)
                self.transition.trigger(ScreenState.MAIN_MENU)

    def _launch_mode_with_setup(self, mode: GameMode, skip_setup: bool = False) -> None:
        self.menus.open_setup(mode)
        if skip_setup:
            self._begin_selected_match()
        else:
            self.transition.trigger(ScreenState.MATCH_SETUP)

    def _begin_selected_match(self) -> None:
        mode = self.menus.setup_target_mode
        rival = self.match.start_new_mode(mode)
        self._recorded_current_match_end = False
        if mode == GameMode.TRAINING:
            self.transition.trigger(ScreenState.BATTLE)
        else:
            self.menus.start_vs_splash(
                self.match.p1.palette_idx,
                self.match.p2.palette_idx,
                rival=rival,
                stage_label=self.match.get_arcade_stage_label(),
            )
            self.transition.trigger(ScreenState.VS_SPLASH)

    # --------------------------------------------------------------------------
    # FIXED-STEP UPDATE & ASPECT-PRESERVING DISPLAY PRESENT
    # --------------------------------------------------------------------------
    def update_fixed(self, keys: Sequence[bool]) -> None:
        self.archive.tick_beat(FIXED_DT, bpm=146.0)
        swapped = self.transition.update(FIXED_DT)
        if swapped is not None:
            self.screen = swapped

        if self.screen == ScreenState.LOADING:
            self._step_progressive_loading()
            self.menus.time_sec += FIXED_DT
        elif self.screen in (ScreenState.TITLE, ScreenState.MAIN_MENU, ScreenState.MATCH_SETUP, ScreenState.ARCADE_ENDING):
            self.menus.update(FIXED_DT)
        elif self.screen == ScreenState.VS_SPLASH:
            self.menus.update(FIXED_DT)
        elif self.screen == ScreenState.BATTLE:
            self.match.tick(keys)
            # Record combat ledger cleanly once when a match finishes
            if self.match.phase == RoundPhase.MATCH_END and not self._recorded_current_match_end:
                self._recorded_current_match_end = True
                self.archive.record_match_result(
                    self.match.p1.stats,
                    p1_won=(self.match.winner_idx == 0),
                    survival_wave=self.match.survival_wins + (1 if self.match.winner_idx == 0 else 0)
                    if self.match.mode == GameMode.SURVIVAL
                    else 0,
                )

    def render_canvas(self) -> None:
        if self.screen == ScreenState.LOADING:
            self.menus.render_loading(self.canvas, self._load_progress, self._load_status)
        elif self.screen == ScreenState.TITLE:
            self.menus.render_title(self.canvas)
        elif self.screen == ScreenState.MAIN_MENU:
            self.menus.render_main_menu(self.canvas)
        elif self.screen == ScreenState.MATCH_SETUP:
            self.menus.render_match_setup(self.canvas)
        elif self.screen == ScreenState.VS_SPLASH:
            done = self.menus.render_vs_splash(self.canvas)
            if done and not self.transition.active:
                self.transition.trigger(ScreenState.BATTLE)
        elif self.screen == ScreenState.BATTLE:
            self.match.render(self.canvas)
        elif self.screen == ScreenState.COMMAND_LIST:
            self.codex.render(self.canvas, self.settings.p1_palette_idx)
        elif self.screen == ScreenState.OPTIONS:
            self.options.render(self.canvas)
        elif self.screen == ScreenState.GALLERY:
            self.gallery.render(self.canvas, FIXED_DT)
        elif self.screen == ScreenState.ARCADE_ENDING:
            self.menus.render_arcade_ending(self.canvas)

        self.transition.render(self.canvas)

        # Optional FPS profiler badge
        if self.settings.show_fps:
            fps_s = f"{self._fps_smooth:4.1f} FPS"
            self.fonts.draw_text(
                self.canvas, fps_s, (SCREEN_W - 14, SCREEN_H - 14), size=12,
                color=UI_GOLD_BRIGHT, outline_px=1, style="mono", bold=True, align="bottomright",
            )

    def present(self) -> None:
        win_w, win_h = self.window.get_size()
        if win_w == SCREEN_W and win_h == SCREEN_H:
            self.window.blit(self.canvas, (0, 0))
        else:
            # Crisp 16:9 aspect-preserving letterbox scaling for any laptop/monitor
            scale = min(win_w / float(SCREEN_W), win_h / float(SCREEN_H))
            dw = max(1, int(SCREEN_W * scale))
            dh = max(1, int(SCREEN_H * scale))
            ox = (win_w - dw) // 2
            oy = (win_h - dh) // 2
            self.window.fill((4, 1, 5))
            scaled = pygame.transform.smoothscale(self.canvas, (dw, dh))
            self.window.blit(scaled, (ox, oy))
        pygame.display.flip()

    def run(self) -> None:
        """Main deterministic 60Hz fixed-timestep game loop."""
        accum = 0.0
        last_t = time.perf_counter()
        while self.running:
            now = time.perf_counter()
            frame_dt = min(0.05, max(0.0, now - last_t))
            last_t = now
            accum += frame_dt

            self.handle_events()
            keys = pygame.key.get_pressed()

            steps = 0
            while accum >= FIXED_DT and steps < 3:
                self.update_fixed(keys)
                accum -= FIXED_DT
                steps += 1

            self.render_canvas()
            self.present()
            self.clock.tick(TARGET_FPS)
            cur_fps = self.clock.get_fps()
            if cur_fps > 1.0:
                self._fps_smooth = lerp(self._fps_smooth, cur_fps, 0.12)

        pygame.quit()


# ==============================================================================
# SECTION 30: BUILT-IN QA CERTIFICATION SMOKE-TEST & ENTRY POINT
# ==============================================================================

def run_qa_smoke_test(dump_dir: Optional[str] = None) -> int:
    """Automated studio QA verifier: validates full asset baking, audio synth,
    all menus, live 420-frame AI-vs-AI sword combat simulation, Training Lab,
    Super Cut-In, and optional PNG screenshot capture without any crash.
    """
    t0 = time.perf_counter()
    app = NoroiNoYaibaApp(headless=True)
    app.complete_loading_synchronously()
    t_bake = time.perf_counter() - t0

    if dump_dir:
        os.makedirs(dump_dir, exist_ok=True)

    # 1. Verify Title Screen render
    app.screen = ScreenState.TITLE
    app.menus.update(0.16)
    app.render_canvas()
    if dump_dir:
        pygame.image.save(app.canvas, os.path.join(dump_dir, "01_title_screen.png"))

    # 2. Verify Main Menu & Match Setup
    app.screen = ScreenState.MAIN_MENU
    app.render_canvas()
    if dump_dir:
        pygame.image.save(app.canvas, os.path.join(dump_dir, "02_main_menu.png"))

    app.menus.open_setup(GameMode.VERSUS_CPU)
    app.screen = ScreenState.MATCH_SETUP
    app.render_canvas()
    if dump_dir:
        pygame.image.save(app.canvas, os.path.join(dump_dir, "03_match_setup.png"))

    # 3. Verify Live AI-vs-AI Battle Simulation (420 deterministic frames!)
    app.match.start_new_mode(GameMode.VERSUS_CPU)
    app.match.ai_p1_demo = ShadowCeciliaAI(AIDifficulty.NIGHTMARE)
    app.match.ai_p2 = ShadowCeciliaAI(AIDifficulty.NIGHTMARE)
    app.match.phase = RoundPhase.FIGHT
    app.match.banner_text = ""
    app.match.banner_alpha = 0.0
    app.screen = ScreenState.BATTLE

    empty_keys = pygame.key.get_pressed()
    t_sim0 = time.perf_counter()
    mid_dumped = False
    super_dumped = False
    for frame in range(420):
        # Force an exciting mid-fight Eclipse Requiem Super Cut-In showcase at frame 180
        if frame == 180 and not super_dumped:
            app.match.p1.super_meter = 200.0
            app.match.p1.enter_state(FighterState.SUPER_ECLIPSE_REQUIEM)
            app.match.combat.on_move_started(app.match.p1, FighterState.SUPER_ECLIPSE_REQUIEM)
        app.match.tick(empty_keys)
        if frame % 4 == 0:
            app.render_canvas()
        if frame == 120 and dump_dir and not mid_dumped:
            mid_dumped = True
            app.render_canvas()
            pygame.image.save(app.canvas, os.path.join(dump_dir, "04_battle_action.png"))
        if frame == 192 and dump_dir and not super_dumped:
            super_dumped = True
            app.render_canvas()
            pygame.image.save(app.canvas, os.path.join(dump_dir, "05_super_cutin.png"))
    t_sim = time.perf_counter() - t_sim0

    # 4. Verify Training Lab (Hitboxes, Frame Data Analyzer, Input Tape & Trials)
    app.match.start_new_mode(GameMode.TRAINING)
    app.match.training_lab.trials.cycle_trial()
    app.match.p1.enter_state(FighterState.ATTACK_5M)
    for _ in range(10):
        app.match.tick(empty_keys)
    app.render_canvas()
    if dump_dir:
        pygame.image.save(app.canvas, os.path.join(dump_dir, "06_training_lab.png"))

    # 5. Verify Command List Codex & Gallery
    app.screen = ScreenState.COMMAND_LIST
    app.render_canvas()
    if dump_dir:
        pygame.image.save(app.canvas, os.path.join(dump_dir, "07_command_codex.png"))

    app.screen = ScreenState.GALLERY
    app.gallery.mode_tab = 0
    app.gallery.state_idx = list(FighterState).index(FighterState.ATTACK_5H)
    app.gallery.frame_idx = 4
    app.gallery.playing = False
    app.render_canvas()
    if dump_dir:
        pygame.image.save(app.canvas, os.path.join(dump_dir, "08_keyframe_gallery.png"))

    print(
        f"[QA PASS] {GAME_TITLE_JP} v{GAME_VERSION} | "
        f"Bake: {t_bake:.2f}s | 420f Sim: {t_sim:.2f}s | "
        f"P1 HP: {app.match.p1.hp} | Keyframe States: {len(app.bank.keyframes)} | "
        f"Total Authored Keyframes: {sum(len(v) for v in app.bank.keyframes.values())}"
    )
    pygame.quit()
    return 0


def main() -> int:
    args = sys.argv[1:]
    if "--smoke-test" in args or "--dump-screens" in args:
        dump_dir: Optional[str] = None
        if "--dump-screens" in args:
            idx = args.index("--dump-screens")
            dump_dir = args[idx + 1] if (idx + 1 < len(args)) else "/tmp/nny_screens"
        return run_qa_smoke_test(dump_dir)

    app = NoroiNoYaibaApp(headless=False)
    app.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
