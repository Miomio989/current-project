    def _lora_list_menu(self, pos: QPoint) -> None:
        it = self.lora_list.itemAt(pos)
        if it is None:
            m = QMenu(self)
            m.addAction("New LoRA\u2026", self.open_new_lora_dialog)
            m.addAction("New folder\u2026", self.add_lora_folder)
            m.exec(self.lora_list.viewport().mapToGlobal(pos))
            return
        entry = self.lora_list.entry_for_uid(str(it.data(Qt.ItemDataRole.UserRole) or ""))
        if not isinstance(entry, dict):
            return
        uid = str(entry.get("uid") or "")
        fcol = lora_folder_color(entry.get("folder", "Improve-Overall"))
        m = QMenu(self)
        m.addAction(
            "Disable LoRA" if entry.get("enabled", True) else "Enable LoRA",
            lambda: self._toggle_lora_entry(entry),
        )
        m.addAction("Edit LoRA\u2026", lambda: self._on_lora_edit_requested(uid))
        m.addAction("Lookup Name & Triggers on Civitai", lambda: self._lookup_lora_by_uid(uid))
        m.addAction("Reset to Preferred Strength", self._on_lora_d_pref)
        m.addAction("Duplicate LoRA Entry", lambda: self._duplicate_lora_by_uid(uid))
        trig_menu = m.addMenu("Trigger words")
        for i, tv in enumerate(entry.get("triggers") or []):
            txt = str(tv.get("text") or "").strip()
            if not txt:
                continue
            sub = trig_menu.addMenu(f"[{tv.get('label') or f'V{i + 1}'}] {elide(txt, 26)}")
            sub.addAction(
                "\u2713 Use as ghost/auto trigger",
                lambda i=i: self._pick_lora_trigger(entry, i),
            )
            sub.addAction("Insert into Prompt (highlighted)", lambda t=txt: self._insert_lora_trigger(t, fcol, False))
            sub.addAction("Insert into Negative", lambda t=txt: self._insert_lora_trigger(t, fcol, True))
            sub.addAction("Copy to Clipboard", lambda t=txt: self._copy_lora_trigger(t))
        m.addSeparator()
        m.addAction("Remove LoRA", lambda: self._remove_lora_by_uid(uid))
        m.exec(self.lora_list.viewport().mapToGlobal(pos))

    def _toggle_lora_entry(self, entry: Dict[str, Any]) -> None:
        entry["enabled"] = not bool(entry.get("enabled", True))
        save_lora_library(self.lora_lib)
        self._show_lora_details()
        self.lora_list.viewport().update()
        self._on_lora_changed(str(entry.get("uid") or ""))

    def _pick_lora_trigger(self, entry: Dict[str, Any], idx: int) -> None:
        if not (entry.get("triggers") or []):
            return
        entry["trigger_sel"] = max(0, min(idx, len(entry["triggers"]) - 1))
        save_lora_library(self.lora_lib)
        self._show_lora_details()
        self.lora_list.viewport().update()
        self._on_lora_changed(str(entry.get("uid") or ""))

    def _on_lora_edit_requested(self, uid: str) -> None:
        entry = self._find_lora_by_uid(uid)
        if entry is None:
            return
        dlg = LoraEditorDialog(entry, self._lora_stack_folders(), self.api, self)
        if dlg.exec():
            normalized = normalize_lora_entry(dlg.data)
            folders = self._lora_stack_folders()
            if normalized["folder"] not in folders:
                folders.append(normalized["folder"])
            entry.update(normalized)
            save_lora_library(self.lora_lib)
            self._rebuild_lora_ui()

    def open_new_lora_dialog(self, preset_id: str = "", is_ver: bool = False) -> None:
        raw: Dict[str, Any] = {
