class SecondarySpringChain:
    """
    Lightweight bone-chain secondary motion solver for PS2/PSP-era hair,
    ponytails, twintails, lotus petal skirts, and trailing crimson ribbon-scarves.
    """
    __slots__ = ("bone_indices", "angles", "vels", "stiffness", "damping", "gravity_bias")

    def __init__(
        self,
        bone_indices: Sequence[int],
        stiffness: float = 28.0,
        damping: float = 6.2,
        gravity_bias: float = -10.0,
    ) -> None:
        self.bone_indices = tuple(bone_indices)
        n = len(self.bone_indices)
        self.angles: List[List[float]] = [[0.0, 0.0, 0.0] for _ in range(n)]
        self.vels: List[List[float]] = [[0.0, 0.0, 0.0] for _ in range(n)]
        self.stiffness = stiffness
        self.damping = damping
        self.gravity_bias = gravity_bias

    def step(
        self,
        dt: float,
        accel_x: float,
        accel_y: float,
        facing: int,
        beat_pulse: float,
        wind_t: float,
    ) -> None:
        wind = math.sin(wind_t * 3.1) * 7.0 + math.cos(wind_t * 5.7) * 3.5 + beat_pulse * 6.0
        for i in range(len(self.bone_indices)):
            weight = 1.0 + i * 0.45
            target_z = clamp((-accel_x * facing * 2.2 + wind) * weight, -58.0, 58.0)
            target_x = clamp((self.gravity_bias - accel_y * 1.1) * weight, -48.0, 48.0)
            # Axis X
            ax = (target_x - self.angles[i][0]) * self.stiffness - self.vels[i][0] * self.damping
            self.vels[i][0] += ax * dt
            self.angles[i][0] = clamp(self.angles[i][0] + self.vels[i][0] * dt, -65.0, 65.0)
            # Axis Z
            az = (target_z - self.angles[i][2]) * self.stiffness - self.vels[i][2] * self.damping
            self.vels[i][2] += az * dt
            self.angles[i][2] = clamp(self.angles[i][2] + self.vels[i][2] * dt, -72.0, 72.0)

    def apply_to_pose(self, bone_eulers: List[List[float]]) -> None:
        for i, b_idx in enumerate(self.bone_indices):
            bone_eulers[b_idx][0] += self.angles[i][0]
            bone_eulers[b_idx][2] += self.angles[i][2]


class SkeletonPose:
    """Computes world-space bone positions and orientation matrices for all 28 bones."""
    __slots__ = ("bind_offsets", "world_pos", "world_quat", "world_mat3")

    def __init__(self, bind_offsets: Sequence[Tuple[float, float, float]]) -> None:
        self.bind_offsets = tuple(bind_offsets)
        n = len(BONE_NAMES)
        self.world_pos: List[Tuple[float, float, float]] = [(0.0, 0.0, 0.0)] * n
        self.world_quat: List[Quat] = [Quat() for _ in range(n)]
        self.world_mat3: List[Tuple[float, ...]] = [Quat().to_mat3() for _ in range(n)]

    def solve(
        self,
        root_pos: Tuple[float, float, float],
        facing: int,
        bone_eulers: Sequence[Sequence[float]],
        scale: float = 1.0,
    ) -> None:
        # Base character facing: +1 faces right (+X), -1 faces left (-X)
        yaw = 82.0 if facing >= 0 else -82.0
        root_q = Quat.from_euler_deg(0.0, yaw, 0.0)
        rx0, ry0, rz0 = root_pos

        for idx in range(len(BONE_NAMES)):
            parent = BONE_PARENTS[idx]
            ex, ey, ez = bone_eulers[idx]
            local_q = Quat.from_euler_deg(ex, ey, ez)
            ox, oy, oz = self.bind_offsets[idx]
            ox *= scale
            oy *= scale
            oz *= scale

            if parent < 0:
                wq = (root_q * local_q).normalized()
                dx, dy, dz = root_q.rotate_vec(ox, oy, oz)
                wp = (rx0 + dx, ry0 + dy, rz0 + dz)
            else:
                pq = self.world_quat[parent]
                px, py, pz = self.world_pos[parent]
                dx, dy, dz = pq.rotate_vec(ox, oy, oz)
                wp = (px + dx, py + dy, pz + dz)
                wq = (pq * local_q).normalized()

            self.world_pos[idx] = wp
            self.world_quat[idx] = wq
            self.world_mat3[idx] = wq.to_mat3()


@dataclass
class Camera3D:
    """
    2.5D side-on slightly low-angle telephoto fighting camera (GDD 7.4).
    Supports heavy impact nudge, zoom, 3D Rite dramatic swings, and Stage Break tracking.
    """
    pos_x: float = 0.0
    pos_y: float = 1.92
    pos_z: float = 10.6
    target_x: float = 0.0
    target_y: float = 1.55
    target_z: float = 0.0
    fov_deg: float = 34.0
    shake_x: float = 0.0
    shake_y: float = 0.0
    shake_timer: float = 0.0
    shake_mag: float = 0.0
    impact_nudge_x: float = 0.0
    impact_nudge_y: float = 0.0
    impact_zoom: float = 0.0
    cinematic_yaw: float = 0.0
    cinematic_pitch: float = 0.0
    cinematic_zoom: float = 0.0

    # Precomputed basis per frame
    right: Tuple[float, float, float] = (1.0, 0.0, 0.0)
    up: Tuple[float, float, float] = (0.0, 1.0, 0.0)
    forward: Tuple[float, float, float] = (0.0, 0.0, -1.0)
    focal: float = 1100.0
    eye: Tuple[float, float, float] = (0.0, 1.92, 10.6)

    def trigger_impact(self, wx: float, wy: float, mag: float = 0.22, zoom: float = 0.75) -> None:
        self.shake_mag = max(self.shake_mag, mag)
        self.shake_timer = max(self.shake_timer, 0.20)
        self.impact_nudge_x = clamp((wx - self.target_x) * 0.25, -0.8, 0.8)
        self.impact_nudge_y = clamp((wy - self.target_y) * 0.20, -0.45, 0.45)
        self.impact_zoom = max(self.impact_zoom, zoom)

    def update(
        self,
        dt: float,
        p1_x: float,
        p1_y: float,
        p2_x: float,
        p2_y: float,
        tempo_ratio: float,
        beat_pulse: float,
        rite_cam: Optional[Tuple[float, float, float, float]] = None,
    ) -> None:
        mid_x = (p1_x + p2_x) * 0.5
        mid_y = max(1.38, (p1_y + p2_y) * 0.35 + 1.38)
        dist = abs(p1_x - p2_x)
        desired_z = clamp(7.4 + dist * 0.66 - self.impact_zoom - self.cinematic_zoom, 5.2, 13.4)
        desired_x = clamp(mid_x, -4.6, 4.6)

        if rite_cam is not None:
            rx, ry, rz, ryaw = rite_cam
            desired_x = rx
            mid_y = ry
            desired_z = rz
            self.cinematic_yaw = lerp(self.cinematic_yaw, ryaw, min(1.0, dt * 10.0))
        else:
            self.cinematic_yaw = lerp(self.cinematic_yaw, 0.0, min(1.0, dt * 7.0))

        self.target_x = lerp(self.target_x, desired_x + self.impact_nudge_x, min(1.0, dt * 11.0))
        self.target_y = lerp(self.target_y, mid_y + self.impact_nudge_y, min(1.0, dt * 10.0))
        self.target_z = lerp(self.target_z, 0.0, min(1.0, dt * 10.0))

        yaw_rad = math.radians(self.cinematic_yaw)
        cam_off_x = math.sin(yaw_rad) * desired_z
        cam_off_z = math.cos(yaw_rad) * desired_z

        # Subtle low-angle telephoto feel + rhythmic Frenzy camera breathe
        pulse_breathe = beat_pulse * (0.08 if tempo_ratio > 0.66 else 0.025)
        self.pos_x = lerp(self.pos_x, self.target_x + cam_off_x, min(1.0, dt * 10.0))
        self.pos_y = lerp(self.pos_y, self.target_y + 0.16 - pulse_breathe * 0.4, min(1.0, dt * 9.0))
        self.pos_z = lerp(self.pos_z, cam_off_z - pulse_breathe, min(1.0, dt * 10.0))

        self.impact_nudge_x *= max(0.0, 1.0 - dt * 9.0)
        self.impact_nudge_y *= max(0.0, 1.0 - dt * 9.0)
        self.impact_zoom *= max(0.0, 1.0 - dt * 6.5)

        if self.shake_timer > 0.0:
            self.shake_timer = max(0.0, self.shake_timer - dt)
            m = self.shake_mag * (self.shake_timer / 0.20)
            self.shake_x = random.uniform(-m, m)
            self.shake_y = random.uniform(-m * 0.8, m * 0.8)
            if self.shake_timer <= 0.0:
                self.shake_mag = 0.0
                self.shake_x = 0.0
                self.shake_y = 0.0
        else:
            self.shake_x = 0.0
            self.shake_y = 0.0

        self.compute_basis(INTERNAL_W, INTERNAL_H)

    def compute_basis(self, width: int, height: int) -> None:
        ex = self.pos_x + self.shake_x
        ey = self.pos_y + self.shake_y
        ez = self.pos_z
        self.eye = (ex, ey, ez)
        fx = self.target_x - ex
        fy = self.target_y - ey
        fz = self.target_z - ez
        fl = math.sqrt(fx * fx + fy * fy + fz * fz) or 1.0
        fx, fy, fz = fx / fl, fy / fl, fz / fl
        self.forward = (fx, fy, fz)
        # right = normalize(cross(forward, (0,1,0)))
        rx = -fz
        ry = 0.0
        rz = fx
        rl = math.sqrt(rx * rx + rz * rz) or 1.0
        rx, rz = rx / rl, rz / rl
        self.right = (rx, ry, rz)
        # up = cross(right, forward)
        ux = ry * fz - rz * fy
        uy = rz * fx - rx * fz
        uz = rx * fy - ry * fx
        self.up = (ux, uy, uz)
        self.focal = (height * 0.5) / math.tan(math.radians(self.fov_deg) * 0.5)

    def project(
        self,
        wx: float,
        wy: float,
        wz: float,
        half_w: float,
        half_h: float,
    ) -> Optional[Tuple[float, float, float]]:
        ex, ey, ez = self.eye
        dx = wx - ex
        dy = wy - ey
        dz = wz - ez
        fx, fy, fz = self.forward
        cz = dx * fx + dy * fy + dz * fz
        if cz < 0.25:
            return None
        rx, ry, rz = self.right
        ux, uy, uz = self.up
        cx = dx * rx + dy * ry + dz * rz
        cy = dx * ux + dy * uy + dz * uz
        inv_z = self.focal / cz
        sx = half_w + cx * inv_z
        sy = half_h - cy * inv_z
        return (sx, sy, cz)
