        hp = 0.0
        prev = 0.0
        for i in range(n):
            t = i * self.inv_sr
            ph += (228.0 + 90.0 * math.exp(-t * 80.0)) * math.tau * self.inv_sr
            nz = rng.uniform(-1.0, 1.0)
            hp = 0.78 * (hp + nz - prev)
            prev = nz
            v = (math.sin(ph) * math.exp(-t * 42.0) * 0.55 + hp * math.exp(-t * 32.0) * 0.62) * 0.68
            L[i] = v * 0.86
