    def _st_start(self) -> None:
        if self.st_server is not None and self.st_server.running:
            if self.st_server.port == self.st_port_spin.value():
                return
            self._st_stop()
        server = LocalStServer(self.st_port_spin.value(), self._st_state, self._st_submit,
                               log_fn=self._api_log_bridge.logged.emit)
        if server.start():
            self.st_server = server
            self.append_log(f"SillyTavern server listening on {server.address} "
                            "(A1111-compatible /sdapi/v1, prompt-only)")
        else:
            self.st_server = None
            self.append_log(f"SillyTavern server could not start: {server.last_error}")
            self.st_check.blockSignals(True)
            self.st_check.setChecked(False)
            self.st_check.blockSignals(False)
            self.st_status.setText(f"Failed to start: {server.last_error}")

    def _st_stop(self) -> None:
        if self.st_server is not None:
            self.st_server.stop()
            self.append_log("SillyTavern server stopped")
        self.st_server = None

    def _copy_st_url(self) -> None:
        QApplication.clipboard().setText(self.st_url_edit.text())
        self._flash_summary("SillyTavern address copied")

    def _update_server_status(self) -> None:
        """Timer slot (GUI thread): refresh both server status labels and the
        cached settings snapshot the SillyTavern server reads from its threads."""
        self._refresh_st_state()
        # bridge
        if self.bridge is None:
            self.bridge_status.setText("Off \u2022 API requests use the direct connection.")
        elif not self.bridge.running:
            self.bridge_status.setText(f"Failed \u2022 {self.bridge.last_error}")
        elif self.bridge.is_connected():
            label = self.bridge.client_label()
            who = ""
            for pat, name in (("Firefox", "Firefox"), ("Edg/", "Edge"), ("Chrome", "Chrome"),
                              ("Chromium", "Chromium"), ("Safari", "Safari"), ("OPR", "Opera")):
                if pat in label:
                    who = f" ({name})"
                    break
            self.bridge_status.setText(f"Connected{who} \u2022 {self.bridge.served} request(s) "
                                       "served through the browser.")
        else:
            self.bridge_status.setText("Waiting for the browser tab\u2026 open https://stablehorde.net/api/ "
                                       "with the userscript and paste the token.")
        # local SillyTavern server
        if self.st_server is None:
            self.st_status.setText("Off.")
        elif not self.st_server.running:
            self.st_status.setText(f"Failed \u2022 {self.st_server.last_error}")
        else:
            last = self.st_server.last_request
            self.st_status.setText(f"Running on {self.st_server.address}" + (f" \u2022 {last}" if last else ""))

    def _refresh_st_state(self) -> None:
        """Snapshot the current generation settings (GUI thread) so the ST
        server threads never touch Qt widgets directly."""
        model = self.current_model()
        gs = self._gen_settings()
        w, h, _k = self._current_size()
        self._st_state_cache = {
            "models": [(name, spec["label"]) for name, spec in MODELS.items()],
            "model": model, "model_label": MODELS.get(model, {}).get("label", model),
            "width": w, "height": h, "steps": gs["steps"], "cfg": gs["cfg"],
            "sampler": gs["sampler"], "samplers": self.samplers,
        }

    def _st_state(self) -> Dict[str, Any]:
        """Called from the SillyTavern HTTP thread - reads only the cached
        snapshot refreshed by the status timer in the GUI thread."""
        return self._st_state_cache

    def _st_submit(self, prompt: str) -> Dict[str, Any]:
        """Called from the SillyTavern HTTP thread: hand the prompt to the GUI
        thread, wait for the queued generation to finish, report the result."""
        q: "_pyqueue.Queue[Optional[Job]]" = _pyqueue.Queue()
        self._st_bridge.requested.emit((q, prompt))
        try:
            job = q.get(timeout=15)
        except _pyqueue.Empty:
            return {"ok": False, "error": "the app did not accept the request (UI busy?)"}
        if job is None:
            return {"ok": False, "error": "empty prompt"}
        ev = self._st_waiters.get(job.local_id)
        if ev is None:
            return {"ok": False, "error": "request lost"}
        if not ev.wait(ST_RESULT_TIMEOUT):
            self._st_waiters.pop(job.local_id, None)
            return {"ok": False, "error": f"no result within {ST_RESULT_TIMEOUT / 60:.0f} min "
                                          "(check the QUEUE tab)"}
        if job.state == STATE_DONE and job.results:
            return {"ok": True, "path": job.results[0], "meta": job.meta}
        if job.state == STATE_CANCELLED:
            return {"ok": False, "error": "request cancelled in the app"}
        return {"ok": False, "error": job.message or f"request {job.state}"}

    def _st_enqueue_request(self, payload: Any) -> None:
        """GUI-thread slot: queue the generation for a SillyTavern request.
        Only the prompt comes from ST; model, size and options follow the
        app's current settings."""
        q, prompt = payload
        final = " ".join(str(prompt).split())
        if not final:
            q.put(None)
            return
        payload_dict, meta = self.build_payload(prompt_override=final, n_override=1)
        job = self.queue.enqueue(payload_dict, meta)
        self._st_waiters[job.local_id] = threading.Event()
        self.mini_queue.setVisible(True)
        self.mini_queue.scrollToBottom()
        self.append_log(f"#{job.local_id} SillyTavern request queued "
                        f"\u201c{elide(final, 60)}\u201d")
        q.put(job)

    # ------------------------------------------------------------------ network helpers
    def _run_task(self, fn: Callable[[], Any], on_done: Callable[[Any], None], on_error: Callable[[str], None]) -> None:
        t = TaskThread(fn, self)
        t.done.connect(on_done)
        t.error.connect(on_error)
        t.finished.connect(lambda: self._tasks.remove(t) if t in self._tasks else None)
        t.finished.connect(t.deleteLater)
        self._tasks.append(t)
        t.start()

    def startup_network(self) -> None:
        self.load_samplers()
        self.refresh_horde()
        if self.api_key != ANON_KEY:
            self.check_account()
        else:
            self.account_label.setText("Anonymous key: works, but lowest priority. Register at aihorde.net and paste the key into key.txt.")

