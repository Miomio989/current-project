    def _update_generate_subtext(self) -> None:
        m = MODELS[self.current_model()]
        w, h, _k = self._current_size()
        n = self.n_spin.value()
        bits = [m["label"], f"\u00d7{n}", f"{w}\u00d7{h}"]
        if self.img2img_source:
            mode = "INPAINT" if self.img2img_mask else "IMG2IMG"
            bits.append(f"{mode} \u03b5{self.i2i_denoise_spin.value():.2f}")
        active = self._active_horde_loras()
        if active:
            bits.append(f"LORA {len(active)}")
        self.gen_btn.set_sub_info("  \u2022  ".join(bits))
        self.chip_i2i.setVisible(bool(self.img2img_source))

    def _update_deck_badges(self) -> None:
        feats = model_features(self.current_model())
        stack = self._current_lora_stack()
        enabled = sum(1 for e in stack if e.get("enabled") and e.get("id"))
        if enabled > MAX_ACTIVE_LORAS:
            self.chip_lora.setText(f"LORA {enabled}/{MAX_ACTIVE_LORAS}")
            self.chip_lora.setStyleSheet(f"color: {C['err']}; font-weight: bold;")
            self.chip_lora.setToolTip(
                f"{enabled} LoRAs enabled — AI Horde accepts at most {MAX_ACTIVE_LORAS} per request; "
                "only the first 5 will be sent."
            )
        else:
            self.chip_lora.setText(f"LORA {enabled}/{MAX_ACTIVE_LORAS}")
            self.chip_lora.setStyleSheet("")
            self.chip_lora.setToolTip(
                "Enabled LoRAs on the active model stack "
                f"(max {MAX_ACTIVE_LORAS} per request) — click to open the LoRA manager"
            )
        self.chip_i2i.setVisible(bool(self.img2img_source))

    def _insert_highlighted_snippet(self, text: str, color: str, to_negative: bool = False, kind: str = "tag") -> None:
        """Append a snippet to the prompt (or negative) as one undoable edit and
        register its color span so it stays highlighted until edited."""
        edit = self.neg_edit if to_negative else self.prompt_edit
        book = self.neg_book if to_negative else self.prompt_book
        cur = edit.toPlainText()
        new_text, pos = append_to_prompt_pos(cur, text)
        added = new_text[len(cur):]
        if not added:
            return
        tc = edit.textCursor()
        # Insert at the end of the EDITABLE zone (never inside the ghost tail)
        tc.setPosition(edit.editable_end())
        tc.beginEditBlock()
        tc.insertText(added)
        tc.endEditBlock()
        book.add(pos, text.strip(), color, kind)
        maintain_spans(book, edit.toPlainText())
        if to_negative:
            self._rehighlight(self.neg_hl, "_neg_hl_busy")
        else:
            self._rehighlight(self.prompt_hl, "_prompt_hl_busy")
            self._update_preview()
        self._schedule_save()

    # ------------------------------------------------------------------ LoRA Library
    def _lora_view_key(self) -> str:
        """Stack currently browsed in the LoRA tab (follows the active model)."""
        return getattr(self, "_lora_browse_key", self._active_model_key)

    def _lora_stack_folders(self, key: Optional[str] = None) -> List[str]:
        k = key or self._lora_view_key()
        if k not in LORA_STACK_KEYS:
            k = "krea"
        defaults = DEFAULT_LORA_FOLDERS_BY_STACK.get(k, [])
        folders = self.lora_lib.setdefault("folders", {}).setdefault(k, list(defaults))
        # v4: only THIS stack's own defaults are merged in (Anima gets anime
        # folders, Krea 2 gets photographic ones — never cross-contaminated).
        for fn in defaults:
            if fn not in folders:
                folders.append(fn)
        return folders

    def _on_lora_stack_clicked(self, btn: QPushButton) -> None:
        for key, b in self.lora_stack_btns.items():
            if b is btn:
                self._lora_browse_key = key
                if self._lora_folder_filter != "ALL" and self._lora_folder_filter not in self._lora_stack_folders(key):
                    self._lora_folder_filter = "ALL"
                self._rebuild_lora_ui()
                return

    def _current_lora_stack(self) -> List[Dict[str, Any]]:
        """Stack of the ACTIVE generation model (drives payload + ghost text)."""
        return self.lora_lib["stacks"][self._active_model_key]

    def _browsed_lora_stack(self) -> List[Dict[str, Any]]:
        """Stack currently browsed/edited in the LoRA tab."""
        return self.lora_lib["stacks"][self._lora_view_key()]

    def _active_lora_entries(self) -> List[Dict[str, Any]]:
        """First MAX_ACTIVE_LORAS enabled entries with an ID (what the Horde gets)."""
        out: List[Dict[str, Any]] = []
        for entry in self._current_lora_stack():
            ident = str(entry.get("id") or "").strip()
            if ident and entry.get("enabled", True):
                out.append(entry)
                if len(out) >= MAX_ACTIVE_LORAS:
                    break
        return out

    def _active_horde_loras(self) -> List[Dict[str, Any]]:
        out: List[Dict[str, Any]] = []
        for entry in self._active_lora_entries():
            obj = lora_entry_to_horde_payload(entry)
            if obj is not None:
                out.append(obj)
        return out

    # ---- Ghost trigger text & payload prompt composition ----------------------
    def _lora_ghost_text(self) -> str:
        """Trigger words of the active LoRAs, in order, shown as locked ghost text."""
        parts: List[str] = []
        seen: Set[str] = set()
        for entry in self._active_lora_entries():
            trig = lora_selected_trigger(entry)
            low = trig.lower()
            if trig and low not in seen:
                seen.add(low)
                parts.append(trig)
        return ", ".join(parts)

    def _refresh_lora_ghost(self) -> None:
        ghost = self._lora_ghost_text()
        self.prompt_edit.set_ghost(ghost)
        g0, g1 = self.prompt_edit.ghost_range()
        self.prompt_hl.set_ghost_range(g0, g1)
        self._rehighlight(self.prompt_hl, "_prompt_hl_busy")
        self._update_preview()

    def _with_lora_triggers(self, prompt: str) -> str:
        """Append active LoRA trigger words not already present in the prompt."""
        base = prompt.rstrip()
        low = base.lower()
        additions: List[str] = []
        for entry in self._active_lora_entries():
            trig = lora_selected_trigger(entry)
            if trig and trig.lower() not in low:
                additions.append(trig)
        if not additions:
            return base
        if not base:
            return ", ".join(additions)
        return base + ", " + ", ".join(additions)

    def _folder_icon_key(self, folder: str) -> str:
        return _LORA_FOLDER_ICON_KEYS.get(folder, "folder_generic")

    def _rebuild_lora_ui(self) -> None:
        view_key = self._lora_view_key()
        stack = self._browsed_lora_stack()
        folders = self._lora_stack_folders(view_key)
        if self._lora_folder_filter not in folders and self._lora_folder_filter != "ALL":
            self._lora_folder_filter = "ALL"

        # Stack switcher follows the browsed stack (v4.2: ANIMA / KREA 2 / MOSS-S)
        btn = self.lora_stack_btns.get(view_key if view_key in LORA_STACK_KEYS else "krea")
        if btn is not None:
            btn.setChecked(True)

        # Folder chip strip (one line, scrolls horizontally, per-folder counts)
        self.lora_folder_flow.clear_items()
        self.lora_folder_btns: Dict[str, FolderChipButton] = {}
        chips: List[Tuple[str, str, str]] = [("All", C["acc_hi"], f"ALL \u00b7 {len(stack)}")]
        for f in folders:
            cnt = sum(1 for e in stack if e.get("folder") == f)
            chips.append((f, lora_folder_color(f), f"{f} \u00b7 {cnt}"))
        for fname, fcol, flabel in chips:
            icon_key = "" if fname == "ALL" else self._folder_icon_key(fname)
            chip = FolderChipButton(flabel, fcol, icon_key)
            chip.setChecked(fname == self._lora_folder_filter)
            chip.clicked.connect(lambda _c=False, f=fname: self._select_lora_folder(f))
            if fname != "ALL":
                chip.setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)
                chip.customContextMenuRequested.connect(
                    lambda pos, f=fname, ch=None: self._lora_folder_menu(f)
                )
            self.lora_folder_group.addButton(chip)
            self.lora_folder_flow.addWidget(chip)
            self.lora_folder_btns[fname] = chip
        # ---- The LIST (filter + search + sort applied) -------------------------
        keep_uid: Optional[str] = self._lora_detail_uid()  # capture BEFORE clear()
        q = self._lora_search.strip().lower()
        sort_mode = str(self.lora_sort_combo.currentData() or "added") if hasattr(self, "lora_sort_combo") else "added"
        enabled_only = self.lora_enabled_only_btn.isChecked() if hasattr(self, "lora_enabled_only_btn") else False
        entries = list(stack)
        if enabled_only:
            entries = [e for e in entries if e.get("enabled") and e.get("id")]
        if sort_mode == "name":
            entries.sort(key=lambda e: str(e.get("name") or "").lower())
        elif sort_mode == "folder":
            entries.sort(key=lambda e: (str(e.get("folder") or "").lower(), str(e.get("name") or "").lower()))
        elif sort_mode == "weight":
            entries.sort(key=lambda e: float(e.get("model", 1.0)), reverse=True)
        elif sort_mode == "enabled":
            entries.sort(key=lambda e: (not (e.get("enabled") and e.get("id")), str(e.get("name") or "").lower()))
        self.lora_list.clear()
        shown = 0
        visible_entries: List[Dict[str, Any]] = []
        select_row = -1
        row_h = self.lora_list.row_height()
        # v6: suspend repaints during large-list rebuilds (buttery on big libraries)
        self.lora_list.setUpdatesEnabled(False)
        try:
            for entry in entries:
                fname = str(entry.get("folder") or "")
                if self._lora_folder_filter != "ALL" and fname != self._lora_folder_filter:
                    continue
                if q:
                    hay = " ".join([
                        str(entry.get("name") or ""), str(entry.get("id") or ""), fname,
                        str(entry.get("notes") or ""),
                        " ".join(str(t.get("text") or "") for t in entry.get("triggers") or []),
                    ]).lower()
                    if q not in hay:
                        continue
                it = QListWidgetItem()
                it.setData(Qt.ItemDataRole.UserRole, str(entry.get("uid") or ""))
                it.setSizeHint(QSize(240, row_h))
                trig = lora_selected_trigger(entry)
                tip = (
                    f"{entry.get('name') or 'LoRA'}\n"
                    f"Folder: {fname}\nID: {entry.get('id')} "
                    f"({'version' if entry.get('is_version') else 'model'})\n"
                    f"M {float(entry.get('model', 1.0)):+.2f} \u00b7 C {float(entry.get('clip', 1.0)):+.2f}"
                )
                if trig:
                    tip += f"\nTrigger: {trig}"
                if entry.get("notes"):
                    tip += f"\nNotes: {entry['notes']}"
                it.setToolTip(tip)
                self.lora_list.addItem(it)
                visible_entries.append(entry)
                if keep_uid is not None and str(entry.get("uid") or "") == keep_uid:
                    select_row = shown
                shown += 1
        finally:
            self.lora_list.setUpdatesEnabled(True)
        self.lora_list.set_entries(visible_entries)
        self.lora_list.show_folder_names = self._lora_folder_filter == "ALL"
        if select_row >= 0:
            self.lora_list.setCurrentRow(select_row)
        self._show_lora_details()
        # The details dock only occupies space when a LoRA is actually selected
        has_sel = self._lora_detail_entry() is not None
        self.lora_detail.setVisible(has_sel)

        # Count badge + status caption
        total_ids = sum(1 for e in stack if e.get("id"))
        self.lora_count_label.setText(f"{shown}/{total_ids}")
        if shown == 0:
            self.lora_status.setText(
                "No LoRAs here \u2014 add one with + LORA, the quick-add bar, or the context menu."
            )
        else:
            n_on = sum(1 for e in stack if e.get("enabled") and e.get("id"))
            self.lora_status.setText(
                f"{n_on} enabled / {total_ids} total \u2022 lamp = toggle \u2022 dbl-click = edit \u2022 "
                "Space = toggle (Ctrl+click = multi-select) \u2022 Del = remove \u2022 "
                "folder names shown in ALL view."
            )

        # Sliders drawer + badges + ghost (driven by the ACTIVE model stack)
        active_stack = self._current_lora_stack()
        enabled = sum(1 for e in active_stack if e.get("enabled") and e.get("id"))
        self._update_deck_badges()
        n_sliders = self.prompt_sliders_bar.rebuild(active_stack)
        self.prompt_sliders_section.setVisible(n_sliders > 0)
        self._refresh_lora_ghost()
        self._update_generate_subtext()
        self._schedule_save()

    def _on_lora_rows_toggled(self, comfortable: bool) -> None:
        """v6: compact (36px) vs comfortable (48px) row density for big lists."""
        h = LoraListView.ROW_COMFORT if comfortable else LoraListView.ROW_COMPACT
        self.lora_rows_btn.setText("ROWS 48" if comfortable else "ROWS 36")
        self.lora_list.set_row_height(h)
