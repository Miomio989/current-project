        view = pygame.Rect(396, 114, 850, 560)
        draw_gothic_panel(target, view, bg_alpha=186, border_col=UI_BORDER_SILVER, corner_cut=12, ornate=True)
        # Reference ground baseline inside studio
        gy = view.y + 422
        pygame.draw.line(target, UI_CRIMSON_DARK, (view.x + 30, gy), (view.right - 30, gy), 2)

        spr = self.bank.get_sprite(self.palette_idx, st, self.frame_idx, facing_right=True, resonance=self.resonance_preview)
        sc = pygame.transform.smoothscale(spr, (int(SPRITE_W * 1.18), int(SPRITE_H * 1.18)))
        target.blit(sc, (view.centerx - int(SPRITE_ANCHOR_X * 1.18), gy - int(SPRITE_ANCHOR_Y * 1.18)))

        # Keyframe technical inspector readout
        pal = CECILIA_PALETTES[self.palette_idx]
        info_top = f"STATE: {st.value}   |   KEYFRAME {self.frame_idx + 1} / {len(kfs)}   |   PALETTE: {pal.display_name}"
        self.fonts.draw_text(target, info_top, (view.x + 24, view.y + 18), size=15, color=UI_GOLD_BRIGHT, outline_px=1, style="sans", bold=True)
        info_bot = (
            f"Torso Yaw: {kf.torso_yaw:.0f} deg   |   Head Yaw: {kf.head_yaw:.0f} deg   |   "
            f"Sword Plane: {kf.sword_plane.value}   |   Expression: {kf.expression.value}   |   "
            f"Duration: {kf.duration}F   |   {'PLAYING' if self.playing else 'PAUSED'}"
        )
        self.fonts.draw_text(target, info_bot, (view.x + 24, view.bottom - 52), size=13, color=UI_TEXT_IVORY, outline_px=1, style="mono", bold=False)
        self.fonts.draw_text(
            target, "UP/DOWN: State  |  SPACE: Play/Pause  |  LEFT/RIGHT: Step Frame  |  P: Palette  |  R: Resonance  |  TAB: Audio  |  ESC: Back",
            (HALF_W, SCREEN_H - 22), size=12, color=UI_GOLD_BRIGHT, outline_px=1, style="sans", bold=True, align="center",
        )

    def _render_sound_test(self, target: pygame.Surface) -> None:
        total_items: List[Tuple[str, str]] = [
            (f"[BGM] {b.value}", "Procedural Synth Soundtrack") for b in self.bgm_list
        ] + [(f"[SFX] {s.value}", "Procedural Combat SFX") for s in self.sfx_list]

        left = pygame.Rect(46, 118, 490, 550)
        right = pygame.Rect(560, 118, 676, 550)
        draw_gothic_panel(target, left, bg_alpha=212, corner_cut=12, ornate=True)
        draw_gothic_panel(target, right, bg_alpha=212, border_col=UI_BORDER_SILVER, corner_cut=12, ornate=True)

        vis = 15
        scroll = max(0, min(len(total_items) - vis, self.sound_cursor - vis // 2))
        for i in range(scroll, min(len(total_items), scroll + vis)):
            sel = (i == self.sound_cursor)
            ry = left.y + 18 + (i - scroll) * 34
            if sel:
                pygame.draw.rect(target, (116, 16, 36), (left.x + 14, ry, left.w - 28, 30))
                pygame.draw.rect(target, UI_GOLD_BRIGHT, (left.x + 14, ry, left.w - 28, 30), 1)
            lbl, _ = total_items[i]
            col = UI_GOLD_BRIGHT if sel else (UI_CRIMSON_GLOW if lbl.startswith("[BGM]") else UI_TEXT_IVORY)
            self.fonts.draw_text(target, lbl, (left.x + 24, ry + 15), size=14, color=col, outline_px=1, style="mono", bold=sel, align="midleft")

        # Gothic Techno Spectrum Visualizer Panel
        self.fonts.draw_text(target, "PROCEDURAL DSP SYNTHESIZER ENGINE", (right.centerx, right.y + 34), size=22, color=UI_GOLD_BRIGHT, outline_px=2, style="serif", bold=True, align="center")
        self.fonts.draw_text(target, f"NOW PLAYING BGM: {self.audio.current_bgm.value}  (146-150 BPM D PHRYGIAN)", (right.centerx, right.y + 68), size=14, color=UI_CRIMSON_GLOW, outline_px=1, style="sans", bold=True, align="center")

        # Pulsing spectrum bars synced to 146 BPM beat!
        bar_n = 32
        bw = (right.w - 84) // bar_n
        base_y = right.y + 390
        beat = abs(math.sin(self.wave_phase * 0.78))
        for bi in range(bar_n):
            u = bi / float(bar_n - 1)
            h_val = (0.28 + 0.72 * abs(math.sin(self.wave_phase + bi * 0.42))) * (1.0 - 0.35 * abs(u - 0.5)) * (0.65 + 0.35 * beat)
            bh = max(8, int(h_val * 230))
            bx = right.x + 42 + bi * bw
            col = lerp_color(UI_CRIMSON_DARK, UI_GOLD_BRIGHT, h_val)
            pygame.draw.rect(target, col, (bx, base_y - bh, bw - 4, bh))
            pygame.draw.rect(target, UI_BORDER_BRIGHT, (bx, base_y - bh, bw - 4, 3))

        self.fonts.draw_text(
            target, "UP/DOWN: Select Track/SFX  |  ENTER/SPACE: Play  |  TAB: Keyframe Studio  |  ESC: Return",
            (HALF_W, SCREEN_H - 22), size=12, color=UI_GOLD_BRIGHT, outline_px=1, style="sans", bold=True, align="center",
        )

