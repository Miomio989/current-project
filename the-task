    @staticmethod
    def _select_combo(combo: QComboBox, text: str) -> None:
        i = combo.findText(text)
        if i < 0 and text:
            combo.addItem(text)
            i = combo.count() - 1
        combo.setCurrentIndex(max(0, i))

    # ------------------------------------------------------------------ state helpers
    def current_model(self) -> str:
        for name, b in self.model_btns.items():
            if b.isChecked():
                return name
        return DEFAULT_MODEL

    def _template_set(self) -> str:
        for k, b in self.tpl_set_btns.items():
            if b.isChecked():
                return k
        return "krea"

    def _gen_settings(self) -> Dict[str, Any]:
        spec = MODELS[self.current_model()]
        if self.override_check.isChecked():
            return {"sampler": self.sampler_combo.currentText(), "scheduler": self.scheduler_combo.currentText(),
                    "steps": self.steps_spin.value(), "cfg": round(self.cfg_spin.value(), 2), "clip_skip": self.clip_spin.value()}
        return {"sampler": spec["sampler"], "scheduler": spec["scheduler"], "steps": spec["steps"], "cfg": spec["cfg"], "clip_skip": 0}

    def _current_size(self) -> "tuple[int, int, str]":
        if self.custom_size_check.isChecked():
            return self.w_spin.value(), self.h_spin.value(), "custom"
        a = self.aspect.current()
        return a["w"], a["h"], a["key"]

    def _expand_prompt_wildcards(self, text: str) -> str:
        """Resolve wildcards with a cache: while the composed prompt stays the
        same, the same expansion is returned, so the preview shows exactly what
        the next request will send."""
        if not text or not has_wildcard_syntax(text):
            return text
        if self._wc_cache_key == text:
            return self._wc_cache_val
        val = expand_wildcards(text, getattr(self, "tags_by_folder", None))
        if not val.strip():
            return text
        self._wc_cache_key, self._wc_cache_val = text, val
        return val

    def _reroll_wildcards(self) -> None:
        self._wc_cache_key = None
        self._wc_cache_val = ""
        self._update_preview()
        self._flash_summary("Wildcards re-rolled")

    def _compose(self) -> "tuple[str, str, str]":
        raw = self.prompt_edit.toPlainText().strip()
        neg = " ".join(self.neg_edit.toPlainText().split())
        final = apply_template(self.active_template["body"], raw) if self.active_template else raw
        final = self._expand_prompt_wildcards(" ".join(final.split()))
        return final, raw, neg

    def _options(self) -> Dict[str, bool]:
        return {k: cb.isChecked() for k, cb in self.opt_checks.items()}

    def build_payload(self, dry_run: bool = False, prompt_override: Optional[str] = None,
                      n_override: Optional[int] = None) -> "tuple[Dict[str, Any], Dict[str, Any]]":
        """Compose the Horde payload from the current settings. `prompt_override`
        replaces the composed prompt verbatim (SillyTavern requests: only the
        prompt is taken, no template, no wildcards); `n_override` pins the
        image count (ST always wants exactly one)."""
        if prompt_override is not None:
            final = raw = prompt_override
            neg = " ".join(self.neg_edit.toPlainText().split())
        else:
            final, raw, neg = self._compose()
        full = final + (f" ### {neg}" if neg else "")
        model = self.current_model()
        gs = self._gen_settings()
        w, h, akey = self._current_size()
        n_images = int(n_override) if n_override is not None else self.n_spin.value()
        params: Dict[str, Any] = {
            "sampler_name": gs["sampler"], "scheduler": gs["scheduler"], "steps": int(gs["steps"]),
            "cfg_scale": gs["cfg"], "width": w, "height": h, "n": n_images,
        }
        if gs.get("clip_skip"):
            params["clip_skip"] = int(gs["clip_skip"])
        seed = self.seed_edit.text().strip()
        if seed:
            params["seed"] = seed
        loras = self._active_loras()
        payload: Dict[str, Any] = {"prompt": full, "params": params, "models": [model], "r2": True}
        # v1.8.0 LoRA FIX: the Horde API schema puts `loras` at the TOP LEVEL
        # of the generation payload (next to `models`), NOT inside `params` -
        # the old placement made the payload verification reject every request
        # that carried a LoRA. Each entry: {name, is_version?, model, clip,
        # inject_trigger?}; `name` is the Civitai model or version id.
        if loras:
            payload["loras"] = loras
        payload.update(self._options())
        if dry_run:
            payload["dry_run"] = True
        meta = {
            "prompt": final, "raw_prompt": raw, "negative": neg,
            "template": self.active_template["name"] if (self.active_template and prompt_override is None) else "",
            "template_set": self._template_set() if (self.active_template and prompt_override is None) else "",
            "model": model, "width": w, "height": h, "aspect": akey, "sampler": gs["sampler"],
            "scheduler": gs["scheduler"], "steps": gs["steps"], "cfg": gs["cfg"], "clip_skip": gs.get("clip_skip", 0),
            "seed_requested": seed, "loras": loras, "n": n_images, "created_at": time.time(),
            "options": self._options(),
        }
        if prompt_override is not None:
            meta["via"] = "sillytavern"
        return payload, meta

    # ------------------------------------------------------------------ generate / queue
    def on_generate(self) -> None:
        final, raw, _neg = self._compose()
        if not final.strip():
            self.tabs.setCurrentIndex(0)
            self.prompt_edit.setFocus()
            self._flash_summary("Type a prompt first.")
            return
        w, h, _k = self._current_size()
        if w * h > MEGAPIXEL_BUDGET:
            self.tabs.setCurrentIndex(5)
            self._flash_summary(f"Custom size {w}\u00d7{h} exceeds the 1 MP budget.")
            return
        if len([l for l in self._all_loras() if l["enabled"] and l["id"]]) > 5:
            self.tabs.setCurrentIndex(3)
            self._flash_summary("At most 5 active LoRAs per request.")
            return
        payload, meta = self.build_payload()
        job = self.queue.enqueue(payload, meta)
        self.mini_queue.setVisible(True)
        self.mini_queue.scrollToBottom()
        # v1.7.0 bug fix: the roll cache used to be invalidated only when the
        # *expanded* prompt still contained wildcard syntax - which is never
        # true after a successful expansion, so the first roll stuck forever
        # ({red|blue} always sent the first pick). Invalidate on the RAW text
        # (and the template body), which is where the tokens actually live.
        if has_wildcard_syntax(raw) or (self.active_template and has_wildcard_syntax(self.active_template.get("body", ""))):
            # next request gets a fresh random wildcard roll
            self._wc_cache_key = None
            self._wc_cache_val = ""
            self._update_preview()
        self._schedule_save()
        if self.api_key == ANON_KEY and job.local_id == 1:
            self.append_log("Anonymous key in use: lowest priority and size limits. Put your key into key.txt.")

    def _selected_job(self, view: Optional[QListView] = None) -> Optional[Job]:
        view = view or self.queue_view
        idx = view.currentIndex()
        return idx.data(Qt.ItemDataRole.UserRole) if idx.isValid() else None

    def _queue_act(self, action: str, view: Optional[QListView] = None) -> None:
        job = self._selected_job(view)
        if job is None:
            return
        if job.kind == KIND_GROUP:
            gid = job.group_id
            if action == "cancel":
                self.queue.cancel(job)
            elif action == "focus" and gid is not None:
                self._ups_show_run(gid)
                self.tabs.setCurrentIndex(self.tabs.count() - 1)
            elif action == "group_retry" and gid is not None:
                self._ups_show_run(gid)
                self.ups_retry_failed()
            elif action == "group_merge" and gid is not None:
                self._ups_show_run(gid)
                self.ups_merge_and_save()
            elif action == "remove":
                self.queue.remove(job)
                gid = job.group_id
                if gid is not None:
                    ImageStore.clean_group_tiles(gid)
                    self.ups_groups.pop(gid, None)
                    if self.ups_active_gid == gid:
                        remaining = sorted(self.ups_groups)
                        self._ups_show_run(remaining[-1] if remaining else None)
                    self._ups_rebuild_group_combo()
            return
        if action == "cancel":
            self.queue.cancel(job)
        elif action == "retry":
            self.queue.retry(job)
        elif action == "remove":
            self.queue.remove(job)
        elif action == "up":
            self.queue.move(job, -1)
        elif action == "down":
            self.queue.move(job, 1)
        elif action == "show":
            if job.results:
                self.refresh_gallery(select=job.results[0])
        elif action == "prompt":
            self._loading = True
            self.prompt_edit.setPlainText(job.meta.get("prompt", ""))
            self.neg_edit.setPlainText(job.meta.get("negative", ""))
            self._loading = False
            self.clear_template()
            self.tabs.setCurrentIndex(0)
        elif action == "copy":
            QApplication.clipboard().setText(job.horde_id or "")

    def _queue_menu(self, pos: QPoint, view: Optional[QListView] = None) -> None:
        view = view or self.queue_view
        idx = view.indexAt(pos)
        if not idx.isValid():
            return
        view.setCurrentIndex(idx)
        job: Job = idx.data(Qt.ItemDataRole.UserRole)
        m = QMenu(self)
        if job.kind == KIND_GROUP:
            gid = job.group_id
            if job.results:
                m.addAction("Show result", lambda: self._queue_act("show", view))
            m.addAction("Focus in UPSCALE tab", lambda: self._queue_act("focus", view))
            if job.active:
                m.addAction("Cancel run (all tiles)", lambda: self._queue_act("cancel", view))
            else:
                if job.state == STATE_FAILED:
                    m.addAction("Retry failed tiles", lambda: self._queue_act("group_retry", view))
                if any(t["state"] == TILE_DONE for t in (self.ups_groups.get(gid) or {}).get("tiles", [])):
                    m.addAction("Merge \u25B8 Save now", lambda: self._queue_act("group_merge", view))
                m.addAction("Remove run", lambda: self._queue_act("remove", view))
            if job.horde_id:
                m.addAction("Copy Horde request id", lambda: self._queue_act("copy", view))
            m.exec(view.viewport().mapToGlobal(pos))
            return
        if job.results:
            m.addAction("Show image", lambda: self._queue_act("show", view))
        if job.kind != KIND_ALCH:
            m.addAction("Load prompt into editor", lambda: self._queue_act("prompt", view))
        m.addSeparator()
        if job.active or job.state == STATE_QUEUED:
            m.addAction("Cancel", lambda: self._queue_act("cancel", view))
        else:
            if job.state == STATE_FAILED:
                m.addAction("Restart (replaces the failed entry)", lambda: self._queue_act("retry", view))
            else:
                m.addAction("Retry (queue a copy)", lambda: self._queue_act("retry", view))
            m.addAction("Remove", lambda: self._queue_act("remove", view))
        if job.horde_id:
            m.addAction("Copy Horde request id", lambda: self._queue_act("copy", view))
        if job.group_id is None:
            m.addSeparator()
            m.addAction("Move up", lambda: self._queue_act("up", view))
            m.addAction("Move down", lambda: self._queue_act("down", view))
        else:
            gid = job.group_id
            m.addSeparator()
            m.addAction("Focus run in UPSCALE tab", lambda: self._ups_show_run(gid))
        m.exec(view.viewport().mapToGlobal(pos))

    def _queue_show_result(self, idx: QModelIndex) -> None:
        job: Job = idx.data(Qt.ItemDataRole.UserRole)
        if job is None:
            return
        if job.kind == KIND_GROUP:
            if job.results:
                self.refresh_gallery(select=job.results[0])
            elif job.group_id is not None:
                self._ups_show_run(job.group_id)
                self.tabs.setCurrentIndex(self.tabs.count() - 1)
            return
        if job.results:
            self.refresh_gallery(select=job.results[0])
        elif job.state == STATE_FAILED:
            QMessageBox.warning(self, "Request failed", f"#{job.local_id}\n\n{job.message}")

    def retry_failed(self) -> None:
        for job in list(self.queue.jobs):
            if job.state == STATE_FAILED:
                self.queue.retry(job)

    def cancel_all(self) -> None:
        c = self.queue.counts()
        if c["queued"] + c["active"] == 0:
            return
        if QMessageBox.question(self, "Cancel all", f"Cancel {c['queued'] + c['active']} pending request(s)?",
                                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No) == QMessageBox.StandardButton.Yes:
            self.queue.cancel_all()

    def _on_pause_toggled(self, on: bool) -> None:
        self.queue.set_paused(on)
        self.pause_btn.setText("RESUME" if on else "PAUSE")
        if self.act_pause.isChecked() != on:
            self.act_pause.setChecked(on)

    def _on_queue_settings(self) -> None:
        self.queue.max_parallel = self.parallel_spin.value()
        self.queue.poll_interval = self.poll_spin.value()
        self._schedule_save()

    def _on_direct_save_toggled(self, on: bool) -> None:
        self.queue.save_direct = on
        self.append_log("finished renders will now be saved "
                        + ("directly into output/ (temp ring skipped)" if on else "into the temp ring as usual"))
        self._schedule_save()
        self.refresh_gallery()

    def _update_summary(self) -> None:
        c = self.queue.counts()
        eta = self.queue.eta()
        bits = []
        if c["upscales"]:
            bits.append(f"{c['upscales']} upscale")
        if c["active"]:
            bits.append(f"{c['active']} running")
        if c["queued"]:
            bits.append(f"{c['queued']} queued")
        if c["done"]:
            bits.append(f"{c['done']} done")
        if c["failed"]:
            bits.append(f"{c['failed']} failed")
        if eta is not None:
            bits.append(f"ETA {fmt_secs(eta)}")
        if self.queue.paused:
            bits.insert(0, "PAUSED")
        text = "QUEUE  " + (" \u2022 ".join(bits) if bits else "idle")
        if not getattr(self, "_flash_until", 0) > time.time():
            self.summary_label.setText(text)
        self.mini_queue.setVisible(len(self.queue.jobs) > 0)
        n = self.queue.rowCount()
        if n and (c["active"] or c["queued"] or c["upscales"]):
            self.mini_queue.viewport().update()

    def _flash_summary(self, text: str) -> None:
        self._flash_until = time.time() + 3.5
        self.summary_label.setText("\u26A0  " + text)
        QTimer.singleShot(3600, self._update_summary)

    def append_log(self, text: str) -> None:
        self.log_edit.appendPlainText(time.strftime("%H:%M:%S  ") + text)

    # ------------------------------------------------------------------ images
    def on_image_ready(self, path: str) -> None:
        if os.path.dirname(path) == TILES_DIR:
            # tile work files are tracked through their queue jobs, not the gallery
            return
        self.refresh_gallery(select=path)
        if self.aesthetic_check.isChecked():
            self._queue_aesthetic(path)
        if os.path.dirname(path) == OUTPUT_DIR:
            # a render landed in output/: the GALLERY tab wants to know
            self.gallery_tab.mark_dirty()

    # ------------------------------------------------------------------ aesthetic score (Alchemy)
    def _queue_aesthetic(self, path: str) -> None:
        if path not in self._aesthetic_pending and not any(w.path == path for w in self._aesthetic_workers):
            self._aesthetic_pending.append(path)
        self._pump_aesthetics()

    def _pump_aesthetics(self) -> None:
        while self._aesthetic_pending and len(self._aesthetic_workers) < 3:
            path = self._aesthetic_pending.pop(0)
            w = AestheticWorker(self.api, path, self)
            w.scored.connect(self._on_aesthetic_scored)
            w.log.connect(self.append_log)
            w.finished.connect(lambda w=w: self._aesthetic_worker_done(w))
            self._aesthetic_workers.append(w)
            w.start()

    def _aesthetic_worker_done(self, w: AestheticWorker) -> None:
        if w in self._aesthetic_workers:
            self._aesthetic_workers.remove(w)
        w.deleteLater()
        self._pump_aesthetics()

    def _on_aesthetic_scored(self, path: str, score: float) -> None:
        try:
            update_image_metadata(path, {"aesthetic": score})
        except Exception as exc:  # noqa: BLE001
            self.append_log(f"aesthetic score could not be stored: {exc}")
            return
        self.gallery.refresh_item_meta(path)
        self.gallery_tab.on_meta_changed(path)
        self.append_log(f"\u2605 aesthetic {score:.2f} for {os.path.basename(path)}")
        if self.viewer.path == path:
            self.show_image(path)

    def refresh_gallery(self, select: Optional[str] = None) -> None:
        paths = self.store.list_recent(include_output=self.direct_save_check.isChecked())
        self.gallery.set_paths(paths, keep=select)
        if select:
            self.gallery.select_path(select)
            self.show_image(select)
        elif paths and not self.gallery.currentItem():
            self.gallery.setCurrentRow(0)
        elif not paths:
            self.show_image(None)

    def show_image(self, path: Optional[str]) -> None:
        self.viewer.set_image(path)
        m = self.viewer.meta
        if not path or not m:
            self.caption.setText("\u2014" if not path else os.path.basename(path))
            return
        bits = [f"Seed {m.get('seed', '?')}", f"{m.get('width')}\u00d7{m.get('height')}",
                model_short(str(m.get("model"))) or str(m.get("model", ""))]
        if isinstance(m.get("aesthetic"), (int, float)):
            bits.append(f"\u2605 {float(m['aesthetic']):.2f}")
        if m.get("kudos") is not None:
            bits.append(f"{float(m['kudos']):.0f} kudos")
        if m.get("censored"):
            bits.append("CENSORED")
        self.caption.setText("  \u2022  ".join(bits))
        tip = m.get("prompt", "")
        if m.get("negative"):
            tip += f"\nNegative: {m['negative']}"
        if m.get("worker_name"):
            tip += f"\nWorker: {m['worker_name']}"
        if isinstance(m.get("aesthetic"), (int, float)):
            tip += f"\n\u2605 Aesthetic score: {float(m['aesthetic']):.2f} (Alchemy)"
        self.caption.setToolTip(tip)

    def _current_image(self) -> Optional[str]:
        return self.viewer.path if self.viewer.path and os.path.exists(self.viewer.path) else None

    def save_current(self) -> None:
        path = self._current_image()
        if not path:
            self._flash_summary("No image selected.")
            return
        if os.path.abspath(os.path.dirname(path)) == os.path.abspath(OUTPUT_DIR):
            self._flash_summary("Already stored in output/")
            return
        try:
            dest = self.store.save_to_output(path)
        except OSError as exc:
            QMessageBox.warning(self, "Save failed", str(exc))
            return
        self.append_log(f"saved {os.path.basename(dest)} to output/")
        self._flash_summary(f"Saved {os.path.basename(dest)}")
        self.gallery_tab.mark_dirty()

    def save_current_as(self) -> None:
        path = self._current_image()
        if not path:
            return
        ensure_dirs()
        suggested = self.store.output_name(self.viewer.meta, os.path.splitext(path)[1].lower())
        dest, _f = QFileDialog.getSaveFileName(self, "Save image as", suggested, "Images (*.png *.webp)")
        if dest:
            try:
                self.store.save_to_output(path, dest)
                self.append_log(f"saved {dest}")
            except OSError as exc:
                QMessageBox.warning(self, "Save failed", str(exc))

    def delete_current(self) -> None:
        path = self._current_image()
        if not path:
            return
        self.store.delete_temp(path)
        self.refresh_gallery()

    def use_from_image(self, what: str, path: Optional[str] = None,
                       meta: Optional[Dict[str, Any]] = None) -> None:
        """Load settings from a stored image into the editor. Without arguments
        the viewer's current image is used; the GALLERY tab passes the path and
        metadata of its selected tile directly."""
        if path is None:
            path = self._current_image()
            m = self.viewer.meta
        else:
            m = meta if meta is not None else read_image_metadata(path)
        if not path or not m:
            self._flash_summary("No image selected.")
            return
        self._loading = True
        if what in ("prompt", "all"):
            self.prompt_edit.setPlainText(m.get("prompt", ""))
            self.neg_edit.setPlainText(m.get("negative", ""))
            if m.get("negative"):
                self.neg_btn.setChecked(True)
            self.active_template = None
        if what in ("seed", "all") and m.get("seed") is not None:
            self.seed_edit.setText(str(m.get("seed")))
        if what == "all":
            if m.get("model") in MODELS:
                self.model_btns[m["model"]].setChecked(True)
                self._on_model_changed()          # switches the LoRA stack first
            akey = m.get("aspect")
            if akey in ASPECT_BY_KEY:
                self.custom_size_check.setChecked(False)
                self.aspect.set_current(akey)
            elif m.get("width") and m.get("height"):
                self.custom_size_check.setChecked(True)
                self.w_spin.setValue(int(m["width"]))
                self.h_spin.setValue(int(m["height"]))
            if m.get("loras") is not None:
                self._lora_filling = True
                try:
                    self.lora_table.setRowCount(0)
                    for lora in m.get("loras") or []:
                        self._append_lora_row({"id": lora.get("name"), "model": lora.get("model", 1.0),
                                               "clip": lora.get("clip", 1.0),
                                               "is_version": lora.get("is_version", False),
                                               "trigger": bool(lora.get("inject_trigger")), "enabled": True})
                finally:
                    self._lora_filling = False
                self._sync_lora_stack()
                self._update_lora_caption()
        self._loading = False
        self._on_model_changed()
        self._on_size_changed()
        self._update_template_chip()
        self._update_preview()
        self.tabs.setCurrentIndex(0)
        self._schedule_save()

    def _gallery_menu(self, pos: QPoint) -> None:
        it = self.gallery.itemAt(pos)
        if it is None:
            return
        self.gallery.setCurrentItem(it)
        m = QMenu(self)
        m.addAction("Save to output", self.save_current)
        m.addAction("Save as\u2026", self.save_current_as)
        m.addSeparator()
        m.addAction("Send to Upscale tab", lambda: self.ups_set_source(it.data(Gallery.ROLE_PATH)))
        m.addSeparator()
        m.addAction("Use prompt", lambda: self.use_from_image("prompt"))
        m.addAction("Use seed", lambda: self.use_from_image("seed"))
        m.addAction("Use everything", lambda: self.use_from_image("all"))
        m.addSeparator()
        m.addAction("Open with system viewer", lambda: open_path(it.data(Gallery.ROLE_PATH)))
        m.addAction("Open temp folder", lambda: open_path(TEMP_DIR))
        m.addAction("Delete from disk", self.delete_current)
        m.exec(self.gallery.viewport().mapToGlobal(pos))

    # ------------------------------------------------------------------ tile upscale (UPSCALE tab)
    def _ups_template_set(self) -> str:
        for k, b in self.ups_tpl_btns.items():
            if b.isChecked():
                return k
        return "anime"

    def _fill_ups_templates(self) -> None:
        key = self._ups_template_set()
        pending = getattr(self, "_ups_pending_tpl_name", None)
        if pending is not None:
            self._ups_pending_tpl_name = None
            prev = pending
        else:
            prev = self.ups_tpl_combo.currentText() if hasattr(self, "ups_tpl_combo") else ""
        self.ups_tpl_combo.blockSignals(True)
        self.ups_tpl_combo.clear()
        self.ups_tpl_combo.addItem("(no template)", "")
        for t in self.templates.get(key, []):
            self.ups_tpl_combo.addItem(t["name"], t["body"])
            self.ups_tpl_combo.setItemData(self.ups_tpl_combo.count() - 1, t["body"], Qt.ItemDataRole.ToolTipRole)
        ix = self.ups_tpl_combo.findText(prev) if prev and prev != "(no template)" else 0
        self.ups_tpl_combo.setCurrentIndex(max(0, ix))
        self.ups_tpl_combo.blockSignals(False)
        self._on_ups_settings_changed()

    def _ups_active_template_body(self) -> str:
        return str(self.ups_tpl_combo.currentData() or "")

    def ups_take_from_gallery(self) -> None:
        path = self._current_image() or self.gallery.current_path()
        if not path:
            self._flash_summary("No image selected in the gallery.")
            return
        self.ups_set_source(path)

    def _ups_current_upscaler(self) -> Tuple[str, str, Optional[int]]:
        """(api name, label, factor) of the selected upscaler; the factor is
        None for the pure-Lanczos pseudo-upscaler (no neural pass)."""
        name = self.ups_upscaler_combo.currentData() or DEFAULT_UPSCALER
        if name == LANCZOS_UPSCALER:
            return name, "Lanczos", None
        return name, UPSCALER_BY_NAME.get(name, name), UPSCALER_FACTOR.get(name, 4)

    def _ups_run(self, gid: Optional[int]) -> Optional[Dict[str, Any]]:
        return self.ups_groups.get(gid) if gid is not None else None

    def _ups_active_run(self) -> Optional[Dict[str, Any]]:
        return self._ups_run(self.ups_active_gid)

    def ups_set_source(self, path: Optional[str]) -> None:
        if not path or not os.path.exists(path):
            self._flash_summary("The image file is gone.")
            return
        reader = QImageReader(path)
        size = reader.size()
        if not size.isValid() or size.isEmpty():
            self._flash_summary("Cannot read that image.")
            return
        self.ups_source = path
        self.ups_source_meta = read_image_metadata(path)
        # default the template set to the one matching the source image
        tset = self.ups_source_meta.get("template_set")
        if tset in self.ups_tpl_btns:
            self.ups_tpl_btns[tset].setChecked(True)
            self._fill_ups_templates()
        prompt = self.ups_source_meta.get("raw_prompt") or self.ups_source_meta.get("prompt", "")
        self.ups_source_caption.setText(
            f"{os.path.basename(path)}  \u2022  {size.width()}\u00d7{size.height()} px  \u2022  "
            f"{model_short(str(self.ups_source_meta.get('model', ''))) or 'image'}  \u2022  {elide(prompt, 90)}")
        self.ups_source_caption.setToolTip(prompt)
        self._on_ups_settings_changed()
        self.tabs.setCurrentIndex(self.tabs.count() - 1)   # jump to the UPSCALE tab
        self._flash_summary("Image loaded into the UPSCALE tab")

    def ups_clear_source(self) -> None:
        self.ups_source = None
        self.ups_source_meta = {}
        self.ups_source_caption.setText("Pick a render from the gallery, then FROM GALLERY.")
        self.ups_plan_preview.setPlaceholder()
        self._on_ups_settings_changed()

    def _on_ups_settings_changed(self) -> None:
        self._schedule_save()
        if not self.ups_source:
            self.ups_plan_caption.setText("")
            self._ups_live_plan_text = ""
            self.ups_plan_preview.set_plan(None, None)
            return
        reader = QImageReader(self.ups_source)
        size = reader.size()
        if not size.isValid():
            return
        plan = plan_tile_grid(size.width(), size.height(),
                              self.ups_scale_spin.value(), self.ups_overlap_spin.value())
        self._ups_live_plan_text = self._ups_plan_text(plan, size.width(), size.height())
        if self._ups_active_run() is None:
            # live plan preview (no run selected): tiles shown as 'planned'
            src = QImage(self.ups_source)
            self.ups_plan_preview.set_plan(src, plan)
            self.ups_plan_caption.setText(self._ups_live_plan_text)
            self._ups_update_buttons()
        elif self.ups_active_gid is None:
            self.ups_plan_caption.setText(self._ups_live_plan_text)

    def _ups_plan_text(self, plan: Dict[str, Any], src_w: int, src_h: int) -> str:
        """One-line plan summary: sizes, grid, whole-image chain, result size."""
        tiles = plan["tiles"]
        up_name, up_label, factor = self._ups_current_upscaler()
        biggest = max(t["w"] * t["h"] for t in tiles)
        ws = sorted({t["w"] for t in tiles})
        hs = sorted({t["h"] for t in tiles})
        wtxt = f"{ws[0]}\u2013{ws[-1]}" if len(ws) > 1 else str(ws[0])
        htxt = f"{hs[0]}\u2013{hs[-1]}" if len(hs) > 1 else str(hs[0])
        if up_name == LANCZOS_UPSCALER:
            chain = f"whole image \u2192 Lanczos \u00d7{plan['out_w'] / max(1, src_w):.2f} \u2192 {plan['out_w']}\u00d7{plan['out_h']}"
        else:
            chain = (f"whole image \u2192 {up_label} \u00d7{factor} \u2192 "
                     f"{src_w * factor}\u00d7{src_h * factor} \u2192 Lanczos \u2192 {plan['out_w']}\u00d7{plan['out_h']}")
        return (f"{src_w}\u00d7{src_h} \u25B8 {plan['out_w']}\u00d7{plan['out_h']} "
                f"(\u00d7{plan['out_w'] / max(1, src_w):.2f})  \u2022  {plan['cols']}\u00d7{plan['rows']} = {len(tiles)} tiles"
                f"  \u2022  tiles {wtxt}\u00d7{htxt} (max {biggest / 1_000_000:.2f} MP \u2264 1 MP)  \u2022  overlap {plan['overlap']} px\n"
                f"{chain}  \u2022  then per tile: img2img (CLIP skip "
                f"{int(TILE_MODELS.get(self.ups_model_combo.currentData() or DEFAULT_TILE_MODEL, {}).get('clip_skip', 1))}) "
                "over the base, feathered merge")

    def _ups_tile_prompt(self, run: Dict[str, Any]) -> None:
        """Compose the shared tile prompt once per run (same prompt for every
        tile so the pieces blend coherently)."""
        raw = self.ups_source_meta.get("raw_prompt") or self.ups_source_meta.get("prompt", "")
        body = self._ups_active_template_body()
        final = apply_template(body, raw) if body else raw
        final = self._expand_prompt_wildcards(" ".join(final.split()))
        if not final.strip():
            # the Horde refuses an empty prompt outright, so a source without
            # prompt metadata still gets a neutral quality prompt for the
            # img2img pass (the denoise strength keeps the picture intact)
            final = "high quality, detailed, sharp focus"
            self.append_log("tile upscale: the source image carries no prompt metadata - using a neutral "
                            "quality prompt for the img2img pass")
        run["prompt"] = final
        run["negative"] = " ".join(str(self.ups_source_meta.get("negative", "")).split())

    # ------------------------------------------------------------------ run control
    def ups_start(self) -> None:
        if not self.ups_source or not os.path.exists(self.ups_source):
            self._flash_summary("Choose an image first (FROM GALLERY).")
            return
        reader = QImageReader(self.ups_source)
        size = reader.size()
        if not size.isValid():
            self._flash_summary("Cannot read the source image.")
            return
        if self.api_key == ANON_KEY:
            QMessageBox.warning(self, "Anonymous key",
                                "Tile upscale sends img2img tiles larger than 512\u00d7512.\n"
                                "Anonymous keys are limited to 512\u00d7512 - put your API key\n"
                                "into key.txt before starting a tile upscale.")
        # Censorship preflight: an SFW-flagged (or censor-requested) request is
        # offered to safety-filter workers, and those return a BLACK placeholder
        # instead of the refined tile - the classic "every img2img tile comes
        # back black and empty" failure. The tile models here are all NSFW
        # lineages and the tile prompt is inherited from the (likely explicit)
        # source image, so make the conflict explicit BEFORE kudos are spent.
        opts = self._options()
        if not opts.get("nsfw") or opts.get("censor_nsfw"):
            ans = QMessageBox.warning(
                self, "Censoring would black out every tile",
                "The request options are currently flagged SFW / censoring, but each tile "
                "img2img goes out with the source image's (probably explicit) prompt and an "
                "NSFW-lineage tile model.\n\n"
                "Workers with a safety filter will then return a black censored placeholder "
                "for each tile instead of a refined one.\n\n"
                "Switch ON 'Enable NSFW (skip censoring workers)' and OFF 'Censor NSFW results' "
                "(HORDE tab) and continue?",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
                | QMessageBox.StandardButton.Cancel)
            if ans == QMessageBox.StandardButton.Yes:
                self.opt_checks["nsfw"].setChecked(True)
                self.opt_checks["censor_nsfw"].setChecked(False)
                self._schedule_save()
                self.append_log("tile upscale: request options switched to NSFW (skip censoring workers), "
                                "censoring disabled")
            elif ans == QMessageBox.StandardButton.Cancel:
                return
        src_w, src_h = size.width(), size.height()
        scale = round(self.ups_scale_spin.value(), 2)
        overlap = self.ups_overlap_spin.value()
        plan = plan_tile_grid(src_w, src_h, scale, overlap)
        up_name, up_label, factor = self._ups_current_upscaler()
        is_lanczos = up_name == LANCZOS_UPSCALER
        model_name = self.ups_model_combo.currentData() or DEFAULT_TILE_MODEL
        model_label = TILE_MODELS.get(model_name, {}).get("label", model_name)

        # guard against accidental monster runs (huge canvases cost a lot)
        if plan["out_w"] * plan["out_h"] > 24_000_000 and not is_lanczos:
            ans = QMessageBox.question(
                self, "Very large upscale",
                f"The target canvas is {plan['out_w']}\u00d7{plan['out_h']} "
                f"({plan['out_w'] * plan['out_h'] / 1_000_000:.0f} MP, {len(plan['tiles'])} tiles).\n"
                "This takes a long time and a lot of kudos. Start anyway?",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
            if ans != QMessageBox.StandardButton.Yes:
                return

        # the group row: pinned on top of the queue, composing the inner tasks
        gmeta: Dict[str, Any] = {
            "src_name": os.path.basename(self.ups_source), "src_w": src_w, "src_h": src_h,
            "out_w": plan["out_w"], "out_h": plan["out_h"], "scale": scale,
            "cols": plan["cols"], "rows": plan["rows"], "overlap": overlap,
            "model": model_name, "model_label": model_label,
            "upscaler": up_name, "upscaler_label": up_label, "factor": factor or 0,
            "base_state": "lanczos" if is_lanczos else "pending",
            "prompt": elide(self.ups_source_meta.get("raw_prompt")
                            or self.ups_source_meta.get("prompt", ""), 80),
        }
        gj = self.queue.enqueue({}, gmeta, kind=KIND_GROUP)
        gj.group_id = gj.local_id          # a group is its own group
        gid = gj.local_id
        gj.state = STATE_PROCESSING
        gj.started = time.time()
        gj.agg = {"total": len(plan["tiles"]), "frac": 0.0}

        src_img = QImage(self.ups_source)
        run: Dict[str, Any] = {
            "gid": gid, "group_job": gj, "plan": plan, "tiles": [], "jobs": {},
            "source": self.ups_source, "source_meta": dict(self.ups_source_meta),
            "prompt": "", "negative": "", "merging": False, "merged": None,
            "src_img": src_img, "dirty": True, "factor": factor or 0,
            "upscaler": up_name, "upscaler_label": up_label,
            "model": model_name, "model_label": model_label, "scale": scale,
            "src_w": src_w, "src_h": src_h,
            "steps": self.ups_steps_spin.value(), "cfg": round(self.ups_cfg_spin.value(), 1),
            "denoise": round(self.ups_denoise_spin.value(), 2),
            "base_path": os.path.join(TILES_DIR, f"g{gid}_base.png"),
            "base_job": None, "base_state": "pending",
            "tiles_queued": False, "cancelled": False, "remerge": False,
        }
        self._ups_tile_prompt(run)
        for t in plan["tiles"]:
            run["tiles"].append({
                **t,
                "state": TILE_PLANNED, "message": "",
                "tile_path": os.path.join(TILES_DIR, f"g{gid}_tile_r{t['row']}c{t['col']}.png"),
                "i2i_job": None,
            })
        self.ups_groups[gid] = run
        # A1111-style flow: the whole image is magnified exactly ONCE first -
        # a single Alchemy pass on the Horde, or a local Lanczos resize when
        # the "Lanczos only" pseudo-upscaler is selected. Only then are the
        # tiles cut from that base and refined with img2img.
        if is_lanczos:
            self._ups_base_local(gid)
        else:
            self._ups_enqueue_base(gid)
        self.append_log(f"tile upscale run #{gid}: {plan['cols']}\u00d7{plan['rows']} grid, "
                        f"target {plan['out_w']}\u00d7{plan['out_h']}, {len(run['tiles'])} tiles "
                        f"\u2022 overlap {plan['overlap']} px"
                        f"\u2022 base: {up_label}" + ("" if is_lanczos else f" \u00d7{factor}")
                        + f" \u2192 Lanczos to size \u2022 img2img with {model_label} "
                        f"(CLIP skip {int(TILE_MODELS.get(model_name, {}).get('clip_skip', 1))})")
        self._ups_show_run(gid)
        self._ups_group_refresh(gid)
        self._schedule_save()

    def _ups_enqueue_base(self, gid: int) -> None:
        """Queue the single whole-image Alchemy upscale every tile is cut from."""
        run = self._ups_run(gid)
        if run is None or run.get("base_job") is not None or run.get("base_state") == "done":
            return
        meta = {
            "tile_job": True, "alchemy": True, "base": True, "group": gid,
            "upscaler": run["upscaler"], "upscaler_label": run["upscaler_label"],
            "factor": run["factor"], "model": run["upscaler"],
            "src_w": run["src_w"], "src_h": run["src_h"],
            "width": run["src_w"], "height": run["src_h"],
            "tile_w": run["plan"]["out_w"], "tile_h": run["plan"]["out_h"],
            "source": run["source"], "up_path": run["base_path"],
            "src_rect": (0, 0, run["src_w"], run["src_h"]),
            "resize_to": (run["plan"]["out_w"], run["plan"]["out_h"]),
            "prompt": elide(run["source_meta"].get("raw_prompt")
                            or run["source_meta"].get("prompt", ""), 60),
        }
        job = self.queue.enqueue({}, meta, kind=KIND_ALCH, group_id=gid)
        run["base_job"] = job.local_id
        run["base_state"] = "queued"
        run["group_job"].meta["base_state"] = "queued"

    def _ups_base_local(self, gid: int) -> None:
        """"Lanczos only" base: magnify the whole image locally, no Horde call."""
        run = self._ups_run(gid)
        if run is None or run.get("base_state") in ("done", "lanczos"):
            return
        run["base_state"] = "lanczos"
        gj = run["group_job"]
        gj.meta["base_state"] = "lanczos"
        src_path, base_path = run["source"], run["base_path"]
        out_w, out_h = run["plan"]["out_w"], run["plan"]["out_h"]

        def work() -> str:
            src = QImage(src_path)
            if src.isNull():
                raise HordeError("cannot read the source image")
            ensure_dirs()
            base = hq_resize(src, out_w, out_h)
            if not base.save(base_path, "PNG"):
                raise HordeError(f"cannot save {os.path.basename(base_path)}")
            return base_path

        def done(_path: str) -> None:
            run2 = self._ups_run(gid)
            if run2 is None or run2.get("cancelled"):
                return
            run2["base_path"] = base_path
            run2["base_state"] = "done"
            run2["group_job"].meta["base_state"] = "done"
            self.append_log(f"tile upscale run #{gid}: Lanczos base ready "
                            f"({out_w}\u00d7{out_h}) - queuing {len(run2['tiles'])} img2img tiles")
            self._ups_queue_tiles(gid)
            self._ups_group_refresh(gid)

        def err(msg: str) -> None:
            run2 = self._ups_run(gid)
            if run2 is None:
                return
            run2["base_state"] = "failed"
            run2["group_job"].meta["base_state"] = "failed"
            run2["group_job"].message = f"Lanczos base failed: {msg}"
            self.append_log(f"tile upscale run #{gid}: Lanczos base failed: {msg}")
            self._ups_group_refresh(gid)

        self._run_task(work, done, err)

    def _ups_queue_tiles(self, gid: int) -> None:
        """Once the base is ready: enqueue the img2img refinement for every
        tile (each worker cuts its own tile out of the shared base file, so
        retries need no extra bookkeeping)."""
        run = self._ups_run(gid)
        if run is None or run.get("tiles_queued"):
            return
        run["tiles_queued"] = True
        for i in range(len(run["tiles"])):
            self._ups_enqueue_i2i(gid, i)

    def _ups_enqueue_i2i(self, gid: int, index: int) -> None:
        run = self._ups_run(gid)
        if run is None or not (0 <= index < len(run["tiles"])):
            return
        t = run["tiles"][index]
        base_path = run.get("base_path") or ""
        if not base_path or not os.path.exists(base_path):
            t["state"] = TILE_FAILED
            t["message"] = "base image missing"
            return
        spec = TILE_MODELS[run["model"]]
        # CLIP skip the model was trained with (2 for every SDXL anime / Pony
        # lineage in TILE_MODELS). The Horde default is 1 ("no layer cut"),
        # which feeds these models a CLIP layer that was never used in their
        # training and muddies / darkens the refined tiles. The Horde accepts
        # clip_skip inside params, minimum 1.
        clip_skip = max(1, int(spec.get("clip_skip", 1)))
        prompt = run["prompt"] + (f" ### {run['negative']}" if run["negative"] else "")
        params: Dict[str, Any] = {
            "sampler_name": spec["sampler"], "scheduler": spec["scheduler"],
            "steps": run["steps"], "cfg_scale": run["cfg"],
            "denoising_strength": run["denoise"],
            # 64-px aligned tile sizes: the Horde's payload verification refuses
            # width/height that are not multiples of 64 (the grid plan guarantees
            # this; snap64 is pure defence against a stale plan).
            "width": snap64(t["w"], hi=3072), "height": snap64(t["h"], hi=3072),
            "n": 1,
            "clip_skip": clip_skip,
        }
        # deterministic per-tile seeds (source seed + tile index) when the
        # source carries a numeric seed, so reruns reproduce exactly.
        # The Horde API verifies `seed` as a STRING - sending the int sum
        # made the whole payload fail with
        # "payload verification failed: seed is not of type string".
        try:
            params["seed"] = str(int(str(run["source_meta"].get("seed")).strip()) + index)
        except (TypeError, ValueError):
            pass
        payload: Dict[str, Any] = {
            "prompt": prompt, "params": params, "models": [run["model"]],
            "r2": True,
            # the worker cuts this tile out of the shared upscaled base
            "source_image_path": base_path,
            "source_rect": (t["x"], t["y"], t["w"], t["h"]),
            "source_processing": "img2img",
        }
        payload.update(self._options())
        meta = {
            "tile_job": True, "alchemy": False, "group": gid, "tile_index": index,
            "tile_row": t["row"], "tile_col": t["col"], "tile_target": t["tile_path"],
            "prompt": run["prompt"], "raw_prompt": run["source_meta"].get("raw_prompt", ""),
            "negative": run["negative"],
            "template": "" if self.ups_tpl_combo.currentIndex() <= 0 else self.ups_tpl_combo.currentText(),
            "template_set": self._ups_template_set(),
            "model": run["model"], "width": t["w"], "height": t["h"],
            "upscaler": run["upscaler"], "upscaler_label": run["upscaler_label"],
            "factor": run["factor"],
            "sampler": spec["sampler"], "scheduler": spec["scheduler"],
            "steps": run["steps"], "cfg": run["cfg"],
            "clip_skip": clip_skip,
            "denoising_strength": run["denoise"],
            "tile_upscale": {"scale": run["scale"], "upscaler": run["upscaler"], "overlap": run["plan"]["overlap"]},
            "created_at": time.time(),
        }
        job = self.queue.enqueue(payload, meta, kind=KIND_TILE_I2I, group_id=gid)
        run["jobs"][job.local_id] = index
        t["i2i_job"] = job.local_id
        t["state"] = TILE_REFINING
        t["message"] = ""

    # ------------------------------------------------------------------ run lifecycle
    def _on_queue_job_finished(self, local_id: int, state: str) -> None:
        # wake a SillyTavern request waiting on this job
        waiter = getattr(self, "_st_waiters", {}).pop(local_id, None)
        if waiter is not None:
            waiter.set()
        job = self.queue.job_by_id(local_id)
        if job is not None and job.kind == KIND_GROUP:
            return          # group rows are refreshed by _ups_group_refresh
        # --- the whole-image base pass of a tile-upscale run
        if job is not None and job.meta.get("base"):
            gid = job.meta.get("group")
            run = self._ups_run(gid) if gid is not None else None
            if run is not None:
                if state == STATE_DONE and job.results and os.path.exists(job.results[0]):
                    run["base_path"] = job.results[0]
                    run["base_state"] = "done"
                    run["group_job"].meta["base_state"] = "done"
                    self.append_log(f"tile upscale run #{gid}: base ready "
                                    f"({run['plan']['out_w']}\u00d7{run['plan']['out_h']}) - queuing "
                                    f"{len(run['tiles'])} img2img tiles")
                    self._ups_queue_tiles(gid)
                else:
                    run["base_state"] = "failed"
                    run["group_job"].meta["base_state"] = "failed"
                    run["group_job"].message = ("cancelled" if state == STATE_CANCELLED
                                                else (job.message or state))
                    if state == STATE_CANCELLED:
                        run["cancelled"] = True
                        # tiles that were never queued have no job to cancel -
                        # mark them directly so the run reaches a terminal state
                        for t in run["tiles"]:
                            if t["state"] not in (TILE_DONE, TILE_FAILED):
                                t["state"] = TILE_FAILED
                                t["message"] = "cancelled"
                    self.append_log(f"tile upscale run #{gid}: base upscale failed: "
                                    f"{run['group_job'].message}")
                self._ups_group_refresh(gid)
            return
        # --- a per-tile img2img job
        gid: Optional[int] = None
        idx: Optional[int] = None
        for g, run in self.ups_groups.items():
            if local_id in run["jobs"]:
                gid, idx = g, run["jobs"][local_id]
                break
        if gid is None and job is not None:
            # the job was (re-)queued through a generic queue action - find its
            # tile from the metadata every tile job carries
            g = job.meta.get("group")
            i = job.meta.get("tile_index")
            if g in self.ups_groups and isinstance(i, int) and 0 <= i < len(self.ups_groups[g]["tiles"]):
                gid, idx = g, i
                self.ups_groups[g]["jobs"][local_id] = i
        if gid is None or idx is None:
            return
        run = self.ups_groups[gid]
        tile = run["tiles"][idx]
        # use the path the job ACTUALLY stored: when Qt cannot decode the
        # downloaded webp, write_image_with_metadata() keeps the raw bytes in
        # a .webp file instead of the planned .png - checking the planned
        # tile_path would fail an img2img that actually succeeded.
        stored = ""
        if job is not None and job.results:
            stored = job.results[0]
        if not stored or not os.path.exists(stored):
            stored = tile["tile_path"] if os.path.exists(tile["tile_path"]) else ""
        if state == STATE_DONE and stored:
            tile["tile_path"] = stored
            tile["state"] = TILE_DONE
            tile["message"] = ""
            self.append_log(f"tile r{tile['row']}c{tile['col']} img2img finished "
                            f"({tile['w']}\u00d7{tile['h']})")
        else:
            tile["state"] = TILE_FAILED
            if state == STATE_CANCELLED:
                run["cancelled"] = True
            tile["message"] = ((job.message if job else "") or state) if state != STATE_CANCELLED else "cancelled"
            self.append_log(f"tile r{tile['row']}c{tile['col']} img2img failed: {tile['message']}")
        self._ups_group_refresh(gid)

    def _ups_group_refresh(self, gid: int) -> None:
        """Recompute the run aggregate, refresh the group row, previews,
        buttons and - once every tile reached a terminal state - auto-merge."""
        run = self._ups_run(gid)
        if run is None:
            return
        gj = run["group_job"]
        counts = {s: 0 for s in TILE_STATES}
        for t in run["tiles"]:
            counts[t["state"]] = counts.get(t["state"], 0) + 1
        total = len(run["tiles"])
        tile_frac = sum(TILE_STAGE_WEIGHT.get(t["state"], 0.0) for t in run["tiles"]) / max(1, total)
        base_done = bool(run.get("base_path")) and os.path.exists(run.get("base_path") or "")
        base_running = run.get("base_state") in ("pending", "queued", "running", "lanczos")
        base_weight = 0.2 if run.get("upscaler") == LANCZOS_UPSCALER else 0.35
        base_frac = 1.0 if base_done else (0.5 if base_running else 0.0)
        frac = base_weight * base_frac + (1.0 - base_weight) * tile_frac
        terminal = total > 0 and all(t["state"] in (TILE_DONE, TILE_FAILED) for t in run["tiles"])
        gj.agg = {**counts, "total": total, "frac": frac, "merging": run["merging"],
                  "base": base_running and not base_done}
        if run["merging"]:
            gj.state = STATE_FETCHING
        elif run.get("merged") and not run.get("remerge"):
            gj.state = STATE_DONE if not counts[TILE_FAILED] else STATE_FAILED
        elif terminal and run.get("cancelled"):
            gj.state = STATE_CANCELLED
            gj.message = "Run cancelled"
            gj.ended = gj.ended or time.time()
        elif terminal and counts[TILE_FAILED]:
            gj.state = STATE_FAILED
            gj.message = (f"{counts[TILE_FAILED]} tile(s) failed - RETRY FAILED or RESET "
                          "(failed areas keep the upscaled base)")
            gj.ended = time.time()
        else:
            gj.state = STATE_PROCESSING
            gj.message = ""
        self.queue.touch_group(gid)
        self._ups_rebuild_group_combo()
        self._ups_schedule_refresh(gid)
        if gid == self.ups_active_gid:
            self._ups_update_buttons()   # react immediately, don't wait for the refresh timer
        if (terminal and base_done and not run["merging"]
                and (not run.get("merged") or run.get("remerge"))
                and not run.get("cancelled")):
            self._ups_merge(gid)

    def _ups_merge(self, gid: int) -> None:
        """Assemble the final image: the finished tiles are feather-blended
        OVER the neural base, so failed tiles degrade gracefully instead of
        leaving holes."""
        run = self._ups_run(gid)
        if run is None or run["merging"]:
            return
        if run.get("merged") and not run.get("remerge"):
            return
        base_path = run.get("base_path") or ""
        if not base_path or not os.path.exists(base_path):
            self._flash_summary("The upscaled base image is missing.")
            return
        done_tiles = [t for t in run["tiles"]
                      if t["state"] == TILE_DONE and os.path.exists(t["tile_path"])]
        if not done_tiles:
            self._flash_summary("No finished tiles to merge yet.")
            return
        run["remerge"] = False
        run["merging"] = True
        self._ups_group_refresh(gid)
        self.append_log(f"tile upscale run #{gid}: assembling {len(done_tiles)} finished tile(s) "
                        f"over the base \u2192 {run['plan']['out_w']}\u00d7{run['plan']['out_h']}")
        plan = run["plan"]
        tiles = [{**t, "path": t["tile_path"]} for t in done_tiles]
        model_name = run["model"]
        src_meta = run["source_meta"]
        failures = sum(1 for t in run["tiles"] if t["state"] == TILE_FAILED)

        def work() -> str:
            merged = merge_tiles(tiles, plan["out_w"], plan["out_h"], base_path)
            meta = dict(src_meta)
            meta.update({
                "prompt": run["prompt"], "negative": run["negative"],
                "model": model_name, "width": plan["out_w"], "height": plan["out_h"],
                "steps": run["steps"], "cfg": run["cfg"],
                "clip_skip": max(1, int(TILE_MODELS.get(model_name, {}).get("clip_skip", 1))),
                "denoising_strength": run["denoise"],
                "tile_upscale": {
                    "scale": run["scale"], "upscaler": run["upscaler"],
                    "overlap": plan["overlap"], "cols": plan["cols"], "rows": plan["rows"],
                    "tiles": len(tiles), "failed_tiles": failures,
                    "source": os.path.basename(run["source"]),
                },
                "saved_at": time.time(), "app": f"{APP_NAME} {APP_VERSION}",
            })
            return self.store.save_direct(image_to_png_bytes(merged), meta)

        def done(dest: str) -> None:
            run["merged"] = dest
            run["merging"] = False
            gj = run["group_job"]
            gj.results = [dest]
            gj.ended = time.time()
            removed = 0
            if failures:
                gj.state = STATE_FAILED
                gj.message = (f"{failures} tile(s) failed - merged with the neural base in those "
                              "regions; RETRY FAILED to refine them, then MERGE \u25B8 SAVE again")
            else:
                gj.state = STATE_DONE
                gj.message = ""
                # work files are only wiped when nothing is left to retry
                removed = ImageStore.clean_group_tiles(gid)
            self.queue.job_finished.emit(gid, gj.state)
            self.queue.touch_group(gid)
            self.append_log(f"tile upscale run #{gid} merged: {os.path.basename(dest)} "
                            f"({plan['out_w']}\u00d7{plan['out_h']})"
                            + ("" if failures else f" \u2022 work files cleaned ({removed})"))
            self._ups_rebuild_group_combo()
            self._ups_refresh_now()
            self.refresh_gallery(select=dest)
            self.gallery_tab.mark_dirty()

        def err(msg: str) -> None:
            run["merging"] = False
            run["group_job"].message = f"merge failed: {msg}"
            self.append_log(f"tile upscale run #{gid} merge failed: {msg}")
            self._flash_summary(f"Merge failed: {msg}")
            self._ups_group_refresh(gid)

        self._run_task(work, done, err)

    def ups_merge_and_save(self) -> None:
        run = self._ups_active_run()
        if run is None:
            return
        if not run.get("base_path") or not os.path.exists(run.get("base_path") or ""):
            self._flash_summary("The base upscale has not finished yet.")
            return
        if any(t["state"] in (TILE_PLANNED, TILE_UPSCALED, TILE_REFINING) for t in run["tiles"]):
            self._flash_summary("Wait until every tile finished (or failed) its img2img pass.")
            return
        run["remerge"] = True
        self._ups_merge(run["gid"])

    def ups_retry_failed(self) -> None:
        run = self._ups_active_run()
        if run is None or run["merging"]:
            return
        gid = run["gid"]
        retried = 0
        # 1) the whole-image base pass failed -> restart it first
        if run.get("base_state") == "failed":
            if run.get("upscaler") == LANCZOS_UPSCALER:
                self._ups_base_local(gid)        # local resize, simply re-run it
                run["group_job"].meta["base_state"] = "lanczos"
                retried += 1
            else:
                jid = run.get("base_job")
                job = self.queue.job_by_id(jid) if jid else None
                if job is not None and not job.active:
                    self.queue.retry(job)          # replaces the failed entry in place
                    run["base_state"] = "queued"
                    run["group_job"].meta["base_state"] = "queued"
                    retried += 1
                else:
                    self._ups_enqueue_base(gid)
                    retried += 1
        # 2) failed tiles: their img2img job restarts in place and re-cuts
        #    its tile from the base file. (When the base itself was just
        #    retried, the tiles are enqueued automatically once it lands -
        #    there is nothing to retry yet.)
        if not retried:
            for i, t in enumerate(run["tiles"]):
                if t["state"] != TILE_FAILED:
                    continue
                jid = t.get("i2i_job")
                job = self.queue.job_by_id(jid) if jid else None
                if job is not None and not job.active:
                    self.queue.retry(job)
                    run["jobs"][job.local_id] = i
                    t["state"] = TILE_REFINING
                    t["message"] = ""
                    retried += 1
                elif run.get("base_path") and os.path.exists(run["base_path"]):
                    self._ups_enqueue_i2i(gid, i)
                    retried += 1
                else:
                    t["message"] = "cannot retry - base image missing"
        if retried:
            run["cancelled"] = False
            run["remerge"] = True
            gj = run["group_job"]
            gj.state = STATE_PROCESSING
            gj.message = ""
            self.append_log(f"tile upscale run #{gid}: re-queued {retried} failed item(s)")
            self._ups_group_refresh(gid)
            self._ups_show_run(gid)

    def ups_reset(self) -> None:
        run = self._ups_active_run()
        if run is None:
            ImageStore.clean_tiles_dir()
            self._flash_summary("Tiles folder cleaned.")
            return
        gid = run["gid"]
        gj = run["group_job"]
        if gj.active:
            self.queue.cancel(gj)
            self._flash_summary(f"Cancelling run #{gid} - press RESET again to remove it.")
            self._ups_group_refresh(gid)
            return
        self.queue.remove(gj)
        ImageStore.clean_group_tiles(gid)
        self.ups_groups.pop(gid, None)
        self._ups_rebuild_group_combo()
        remaining = sorted(self.ups_groups)
        self._ups_show_run(remaining[-1] if remaining else None)
        self._flash_summary(f"Tile-upscale run #{gid} removed.")

    # ------------------------------------------------------------------ run selection & previews
    def _ups_combo_changed(self) -> None:
        gid = self.ups_run_combo.currentData()
        if gid is not None and gid != self.ups_active_gid:
            self._ups_show_run(gid)

    def _queue_clicked(self, idx: QModelIndex) -> None:
        job: Job = idx.data(Qt.ItemDataRole.UserRole)
        if job is not None and job.kind == KIND_GROUP and job.group_id is not None:
            self._ups_show_run(job.group_id)

    def _ups_rebuild_group_combo(self) -> None:
        combo = self.ups_run_combo
        current = self.ups_active_gid
        combo.blockSignals(True)
        combo.clear()
        combo.addItem("no run", None)
        for gid in sorted(self.ups_groups):
            run = self.ups_groups[gid]
            gj = run["group_job"]
            combo.addItem(f"Run #{gid} \u2022 {run['plan']['out_w']}\u00d7{run['plan']['out_h']} \u2022 {gj.state}", gid)
        ix = combo.findData(current)
        if ix >= 0:
            combo.setCurrentIndex(ix)
        else:
            self.ups_active_gid = None
        combo.blockSignals(False)

    def _ups_show_run(self, gid: Optional[int]) -> None:
        self.ups_active_gid = gid
        self._ups_rebuild_group_combo()
        run = self._ups_active_run()
        self.ups_grid.clear()
        if run is not None:
            for t in run["tiles"]:
                it = QListWidgetItem()
                it.setData(TileGridDelegate.ROLE_STATE, t["state"])
                it.setData(TileGridDelegate.ROLE_LABEL,
                           f"r{t['row']}c{t['col']} {TILE_STATE_SHORT.get(t['state'], '')}")
                pix_path = t["tile_path"] if t["state"] == TILE_DONE else ""
                it.setData(TileGridDelegate.ROLE_PIX, self._ups_tile_pixmap(pix_path))
                it.setToolTip(self._ups_tile_tooltip(t))
                self.ups_grid.addItem(it)
            self.ups_plan_caption.setText(self._ups_plan_text(run["plan"], run["src_w"], run["src_h"]))
        elif self.ups_source:
            reader = QImageReader(self.ups_source)
            size = reader.size()
            if size.isValid():
                plan = plan_tile_grid(size.width(), size.height(),
                                      self.ups_scale_spin.value(), self.ups_overlap_spin.value())
                self.ups_plan_preview.set_plan(QImage(self.ups_source), plan)
                self.ups_plan_caption.setText(self._ups_live_plan_text or self._ups_plan_text(plan, size.width(), size.height()))
        self.ups_plan_preview.set_run(run)
        self.ups_canvas_preview.set_run(run)
        self._ups_update_buttons()
        self._ups_refresh_now()

    def _ups_tile_pixmap(self, path: str) -> QPixmap:
        if path and os.path.exists(path):
            reader = QImageReader(path)
            reader.setAutoTransform(True)
            size = reader.size()
            if size.isValid():
                reader.setScaledSize(size.scaled(QSize(160, 160), Qt.AspectRatioMode.KeepAspectRatio))
            img = reader.read()
            if not img.isNull():
                return QPixmap.fromImage(img)
        return QPixmap()

    def _ups_tile_tooltip(self, t: Dict[str, Any]) -> str:
        state = TILE_STATE_LONG.get(t["state"], t["state"])
        msg = f"\n{t['message']}" if t.get("message") else ""
        run = self._ups_active_run()
        model = str((run or {}).get("model_label") or (run or {}).get("model") or "?")
        clip = int(TILE_MODELS.get((run or {}).get("model"), {}).get("clip_skip", 1))
        denoise = (run or {}).get("denoise")
        return (f"r{t['row']}c{t['col']} \u2022 {t['x']},{t['y']} {t['w']}\u00d7{t['h']} "
                f"(core {t['core_w']}\u00d7{t['core_h']})\n"
                f"cut from the upscaled base, refined with img2img\n"
                f"model: {model} \u2022 CLIP skip {clip} \u2022 denoise {denoise}\n"
                f"status: {state}{msg}")

    def _ups_set_tile_pix(self, index: int, path: str) -> None:
        if not (0 <= index < self.ups_grid.count()):
            return
        it = self.ups_grid.item(index)
        it.setData(TileGridDelegate.ROLE_PIX, self._ups_tile_pixmap(path))
        self.ups_grid.viewport().update()

    def _ups_set_tile_state(self, index: int) -> None:
        run = self._ups_active_run()
        if run is None or not (0 <= index < len(run["tiles"])) or not (0 <= index < self.ups_grid.count()):
            return
        t = run["tiles"][index]
        it = self.ups_grid.item(index)
        it.setData(TileGridDelegate.ROLE_STATE, t["state"])
        it.setData(TileGridDelegate.ROLE_LABEL, f"r{t['row']}c{t['col']} {TILE_STATE_SHORT.get(t['state'], '')}")
        it.setToolTip(self._ups_tile_tooltip(t))
        self.ups_grid.viewport().update()

    def _ups_schedule_refresh(self, gid: Optional[int] = None) -> None:
        run = self._ups_run(gid if gid is not None else self.ups_active_gid)
        if run is not None:
            run["dirty"] = True
        self._ups_refresh_timer.start()

    def _ups_refresh_now(self) -> None:
        run = self._ups_active_run()
        if run is not None and run.get("dirty"):
            run["dirty"] = False
            for i, t in enumerate(run["tiles"]):
                self._ups_set_tile_state(i)
                if t["state"] == TILE_DONE:
                    self._ups_set_tile_pix(i, t["tile_path"])
            self.ups_plan_preview.refresh()
            self.ups_canvas_preview.refresh()
        self._ups_update_status()
        self._ups_update_buttons()

    def _ups_update_status(self) -> None:
        run = self._ups_active_run()
        if run is None:
            if self.ups_source:
                self.ups_status.setText("Ready \u2022 the plan above shows the tile grid for the current settings.")
            else:
                self.ups_status.setText("Choose an image, check the plan, then START.")
            return
        c = {s: 0 for s in TILE_STATES}
        for t in run["tiles"]:
            c[t["state"]] = c.get(t["state"], 0) + 1
        total = len(run["tiles"])
        plan = run["plan"]
        if run.get("merged"):
            self.ups_status.setText(f"Assembled {plan['out_w']}\u00d7{plan['out_h']} \u2192 "
                                    f"{os.path.basename(run['merged'])} in output/")
        elif run["merging"]:
            self.ups_status.setText(f"Assembling tiles over the base \u2192 {plan['out_w']}\u00d7{plan['out_h']}\u2026")
        else:
            bits = []
            bs = run.get("base_state")
            if bs in ("pending", "queued", "running", "lanczos"):
                bits.append("whole-image upscale in progress")
            elif bs == "failed":
                bits.append("base upscale FAILED - RETRY FAILED")
            if c[TILE_REFINING]:
                bits.append(f"{c[TILE_REFINING]} in img2img")
            if c[TILE_DONE]:
                bits.append(f"{c[TILE_DONE]}/{total} tiles done")
            if c[TILE_FAILED]:
                bits.append(f"{c[TILE_FAILED]} failed")
            if not bits:
                bits.append("starting\u2026")
            self.ups_status.setText(" \u2022 ".join(bits))

    def _ups_update_buttons(self) -> None:
        run = self._ups_active_run()
        self.ups_start_btn.setEnabled(bool(self.ups_source))
        if run is None:
            self.ups_retry_btn.setEnabled(False)
            self.ups_merge_btn.setEnabled(False)
            self.ups_reset_btn.setText("RESET")
            return
        base_done = bool(run.get("base_path")) and os.path.exists(run.get("base_path") or "")
        base_failed = run.get("base_state") == "failed"
        failed_tiles = any(t["state"] == TILE_FAILED for t in run["tiles"])
        any_done = any(t["state"] == TILE_DONE for t in run["tiles"])
        busy = (run["merging"]
                or any(t["state"] in (TILE_PLANNED, TILE_UPSCALED, TILE_REFINING) for t in run["tiles"])
                or run.get("base_state") in ("pending", "queued", "running", "lanczos"))
        self.ups_retry_btn.setEnabled((failed_tiles or base_failed) and not run["merging"])
        self.ups_merge_btn.setEnabled(base_done and any_done and not busy)
        self.ups_reset_btn.setText("REMOVE" if not run["group_job"].active else "CANCEL")

    def _ups_grid_menu(self, pos: QPoint) -> None:
        it = self.ups_grid.itemAt(pos)
        run = self._ups_active_run()
        if it is None or run is None:
            m = QMenu(self)
            m.addAction("Open tiles folder", lambda: open_path(TILES_DIR))
            m.exec(self.ups_grid.viewport().mapToGlobal(pos))
            return
        index = self.ups_grid.row(it)
        if not (0 <= index < len(run["tiles"])):
            return
        t = run["tiles"][index]
        m = QMenu(self)
        if os.path.exists(t["tile_path"]):
            m.addAction("Open finished tile (img2img result)", lambda: open_path(t["tile_path"]))
        base_path = run.get("base_path") or ""
        if base_path and os.path.exists(base_path):
            m.addAction("Open the upscaled base image", lambda: open_path(base_path))
        m.addSeparator()
        m.addAction("Open tiles folder", lambda: open_path(TILES_DIR))
        m.exec(self.ups_grid.viewport().mapToGlobal(pos))

    # ------------------------------------------------------------------ templates / tags / loras
    def load_templates(self) -> None:
        for key, path in TEMPLATE_FILES.items():
            if not os.path.exists(path):
                write_text(path, DEFAULT_TEMPLATES[key])
            self.templates[key] = parse_templates(path)
        self._fill_template_list()
        self._fill_ups_templates()
        wanted = self.settings.get("template_name")
        if wanted and self._loading:
            for t in self.templates.get(self._template_set(), []):
                if t["name"] == wanted:
                    self.active_template = t
                    break
        self._update_template_chip()
        self._update_preview()

    def _fill_template_list(self) -> None:
        key = self._template_set()
        self.tpl_list.clear()
        for t in self.templates.get(key, []):
            it = QListWidgetItem(t["name"])
            it.setData(Qt.ItemDataRole.UserRole, t)
            it.setToolTip(t["body"])
            self.tpl_list.addItem(it)
        if self.tpl_list.count():
            self.tpl_list.setCurrentRow(0)
        else:
            self.tpl_preview.setPlainText(f"No templates in {os.path.basename(TEMPLATE_FILES[key])}")
        self._schedule_save()

    def _show_template_preview(self, item: Optional[QListWidgetItem]) -> None:
        t = item.data(Qt.ItemDataRole.UserRole) if item else None
        self.tpl_preview.setPlainText(t["body"] if t else "")

    def apply_selected_template(self) -> None:
        it = self.tpl_list.currentItem()
        if not it:
            return
        self.active_template = it.data(Qt.ItemDataRole.UserRole)
        self._update_template_chip()
        self._update_preview()
        self.preview_section.set_expanded(True)
        self.tabs.setCurrentIndex(0)
        self._schedule_save()

    def clear_template(self) -> None:
        self.active_template = None
        self._update_template_chip()
        self._update_preview()
        self._schedule_save()

    def _update_template_chip(self) -> None:
        if self.active_template:
            self.template_chip.setText(f"TEMPLATE  \u25B8  {self.active_template['name']}")
            self.template_chip.setToolTip(self.active_template["body"])
            self.template_chip.setStyleSheet(f"color: {PAL['acc_hi']}; font-weight: bold;")
            self.template_clear_btn.setVisible(True)
        else:
            self.template_chip.setText("TEMPLATE  \u25B8  none  (prompt is sent as typed)")
            self.template_chip.setToolTip("Pick a template in the TEMPLATES tab")
            self.template_chip.setStyleSheet("")
            self.template_clear_btn.setVisible(False)

    def save_prompt_as_template(self) -> None:
        raw = self.prompt_edit.toPlainText().strip()
        if not raw:
            self._flash_summary("Prompt is empty.")
            return
        name, ok = QInputDialog.getText(self, "Save template", "Template name:")
        if not ok or not name.strip():
            return
        body = raw if "{{insert}}" in raw else raw + ", {{insert}}"
        if append_template(TEMPLATE_FILES[self._template_set()], name.strip(), body):
            self.load_templates()

    def load_tags(self) -> None:
        if not os.path.exists(TAGS_FILE):
            write_text(TAGS_FILE, DEFAULT_TAGS)
        self.tag_folders, self.tags_by_folder = parse_tag_groups(TAGS_FILE)
        saved = (self.settings.get("ui") or {}).get("tag_folder", "")
        if saved not in self.tag_folders:
            saved = self.tag_folders[0] if self.tag_folders else "General"
        self._tag_fill_buttons(saved)
        self._tag_fill_list(saved)

    def _tag_fill_buttons(self, active: str) -> None:
        for b in list(self.tag_folder_btns.values()):
            self.tag_folder_group.removeButton(b)
        self.tag_folder_btns.clear()
        while self.tag_folder_row.count():
            item = self.tag_folder_row.takeAt(0)
            w = item.widget()
            if w is not None:
                w.deleteLater()
        for name in self.tag_folders:
            b = FolderButton(name, tag_folder_color(name))
            b.setChecked(name == active)
            b.clicked.connect(lambda _c, n=name: self._tag_select_folder(n))
            self.tag_folder_group.addButton(b)
            self.tag_folder_btns[name] = b
            self.tag_folder_row.addWidget(b)

    def _tag_select_folder(self, name: str) -> None:
        for n, b in self.tag_folder_btns.items():
            b.setChecked(n == name)
        self._tag_fill_list(name)
        self._schedule_save()

    def _tag_folder_current(self) -> str:
        for n, b in self.tag_folder_btns.items():
            if b.isChecked():
                return n
        return self.tag_folders[0] if getattr(self, "tag_folders", None) else "General"

    def _tag_fill_list(self, folder: str) -> None:
        self.tag_list.clear()
        for t in self.tags_by_folder.get(folder, []):
            it = QListWidgetItem(t["label"])
            it.setData(Qt.ItemDataRole.UserRole, t["text"])
            it.setData(Qt.ItemDataRole.UserRole + 1, t)
            it.setToolTip(f"[{t['folder']}]  {t['text']}")
            self.tag_list.addItem(it)
        if self.tag_list.count():
            self.tag_list.setCurrentRow(0)
        else:
            self.tag_preview.setPlainText(f"No groups in this folder.\n"
                                          f"Add some to tag_groups.txt under [{folder}].")

    def add_tags(self, negative: bool) -> None:
        it = self.tag_list.currentItem()
        if not it:
            return
        group = it.data(Qt.ItemDataRole.UserRole + 1) or {}
        text = str(it.data(Qt.ItemDataRole.UserRole) or group.get("text", ""))
        folder = str(group.get("folder", self._tag_folder_current()))
        color = tag_folder_color(folder)
        edit = self.neg_edit if negative else self.prompt_edit
        book = self.neg_book if negative else self.prompt_book
        new_text, pos = append_to_prompt_pos(edit.toPlainText(), text)
        edit.setPlainText(new_text)
        # register the coloured span (dropped automatically once that passage is edited)
        book.spans.append({"start": pos, "text": text, "color": color, "folder": folder})
        book.prev = new_text
        (self.neg_hl if negative else self.prompt_hl).rehighlight()
        if negative:
            self.neg_btn.setChecked(True)
        self._flash_summary(f"Added \u201c{it.text()}\u201d [{folder}] to the {'negative ' if negative else ''}prompt")

    def insert_folder_wildcard(self) -> None:
        """Drop a __[Folder]__ token into the prompt at the cursor. The token is
        kept in the editor (marked with the folder colour like an inserted group)
        and expanded to a random group from that folder when a request is
        composed - a fresh pick for every generation."""
        folder = self._tag_folder_current()
        token = f"__[{folder}]__"
        edit = self.prompt_edit
        edit.setFocus()
        cursor = edit.textCursor()
        start = cursor.selectionStart() if cursor.hasSelection() else cursor.position()
        sep = ""
        if not cursor.hasSelection() and cursor.atEnd():
            before = edit.toPlainText()[: cursor.position()].rstrip()
            if before and not before.endswith((",", ".")):
                sep = ", "
        cursor.insertText(sep + token)
        new_text = edit.toPlainText()
        self.prompt_book.spans.append({"start": start + len(sep), "text": token,
                                       "color": tag_folder_color(folder), "folder": folder})
        self.prompt_book.prev = new_text
        self.prompt_hl.rehighlight()
        self._flash_summary(f"Inserted {token} - a random \u201c{folder}\u201d group is picked per generation")

    def new_tag_group(self) -> None:
        body = self.prompt_edit.toPlainText().strip()
        text, ok = QInputDialog.getText(self, "New tag group", "Text to store (edit as needed):", text=body)
        if not ok or not text.strip():
            return
        label, ok2 = QInputDialog.getText(self, "New tag group", "Label:")
        if not ok2 or not label.strip():
            return
        folders = list(getattr(self, "tag_folders", []) or ["General"])
        cur = self._tag_folder_current()
        folder, ok3 = QInputDialog.getItem(self, "New tag group", "Folder:", folders,
                                           folders.index(cur) if cur in folders else 0, editable=True)
        if not ok3 or not folder.strip():
            return
        if append_tag_group(TAGS_FILE, label.strip(), " ".join(text.split()), folder.strip()):
            self.load_tags()

    # ------------------------------------------------------------------ LoRA stacks (per model)
    def _lora_model_key(self) -> str:
        """Stack key of the active generation model (anime = Anima, krea = Krea)."""
        return str(MODELS.get(self.current_model(), {}).get("template_set", "krea"))

    def _sync_lora_stack(self) -> None:
        """Write the table (the active model's stack) back into the store."""
        self._lora_stacks[self._lora_stack_key] = self._all_loras()

    def _switch_lora_stack(self) -> None:
        """Follow the deck's model selector: save the current table, load the
        stack of the newly active model. While settings load (_loading) the
        table is still empty, so nothing is synced back."""
        new_key = self._lora_model_key()
        if new_key == getattr(self, "_lora_stack_key", None):
            self._update_lora_caption()
            return
        if not self._loading:
            self._sync_lora_stack()
        self._lora_stack_key = new_key
        self._lora_filling = True
        try:
            self.lora_table.setRowCount(0)
            for lora in self._lora_stacks.get(new_key, []):
                self._append_lora_row(lora)
        finally:
            self._lora_filling = False
        self._update_lora_caption()

    def _update_lora_caption(self) -> None:
        model = MODELS.get(self.current_model(), {})
        # read the LIVE table - the caption must never lag behind a checkbox
        rows = self._all_loras() if getattr(self, "lora_table", None) is not None else []
        active = sum(1 for l in rows if l["enabled"] and l["id"])
        self.lora_stack_label.setText(
            f"STACK  \u25B8  {model.get('label', '?')}  \u2014  each model keeps its own LoRA list "
            f"({len(rows)} entr{'y' if len(rows) == 1 else 'ies'}, {active} active of max 5)")
        self.lora_stack_label.setToolTip("The LoRA tab always edits the stack of the model selected in the "
                                         "deck (ANIMA TURBO / KREA 2 TURBO). Switch the model to edit the "
                                         "other stack.")

    def _lora_menu(self, pos: QPoint) -> None:
        """Context menu for one LoRA row: quick actions without the buttons."""
        row = self.lora_table.rowAt(pos.y())
        if row < 0:
            return
        self.lora_table.selectRow(row)
        m = QMenu(self)
        m.addAction("Look up name on Civitai", self.lookup_lora)
        on_w = self.lora_table.cellWidget(row, 0)
        is_on = bool(on_w is not None and on_w.isChecked())
        def _toggle_row() -> None:
            if on_w is not None:
                on_w.setChecked(not is_on)
        m.addAction("Disable for this model" if is_on else "Enable for this model", _toggle_row)
        m.addSeparator()
        m.addAction("Remove row", self.remove_lora)
        m.exec(self.lora_table.viewport().mapToGlobal(pos))

    def _append_lora_row(self, lora: Dict[str, Any]) -> None:
        row = self.lora_table.rowCount()
        self.lora_table.insertRow(row)
        # v1.9.0: the ON column is a REAL checkbox WIDGET. The old item
        # checkbox (Qt.ItemIsUserCheckable under NoEditTriggers) only ever
        # scheduled a settings save - the state sat in the widget, was not
        # synced into the stack until the 900 ms save fired, the caption
        # stayed stale and a click during save could silently revert. A real
        # widget pushes every change through _on_lora_cell_changed() at once.
        on = QCheckBox()
        on.setToolTip("Send this LoRA with every request of this model")
        on.setChecked(bool(lora.get("enabled", True)))
        on.toggled.connect(lambda _v, r=row: self._on_lora_cell_changed(r))
        self.lora_table.setCellWidget(row, 0, on)
        ident = QTableWidgetItem(str(lora.get("id", "")))
        ident.setData(Qt.ItemDataRole.UserRole, bool(lora.get("is_version", False)))
        ident.setToolTip("Civitai version ID" if lora.get("is_version") else "Civitai model ID")
        self.lora_table.setItem(row, 1, ident)
        name = QTableWidgetItem(str(lora.get("name", "")))
        name.setToolTip(str(lora.get("name", "")))
        self.lora_table.setItem(row, 2, name)
        for col, key in ((3, "model"), (4, "clip")):
            sp = QDoubleSpinBox()
            sp.setRange(-5.0, 5.0)
            sp.setSingleStep(0.05)
            sp.setDecimals(2)
            sp.setValue(float(lora.get(key, 1.0)))
            sp.setFixedWidth(74)
            sp.valueChanged.connect(lambda _v, r=row: self._on_lora_cell_changed(r))
            self.lora_table.setCellWidget(row, col, sp)
        trig = QCheckBox("any")
        trig.setToolTip("Let the Horde inject the LoRA's trigger word into the prompt")
        trig.setChecked(bool(lora.get("trigger", False)))
        trig.toggled.connect(lambda _v, r=row: self._on_lora_cell_changed(r))
        self.lora_table.setCellWidget(row, 5, trig)
        self.lora_table.setRowHeight(row, 30)
        self._paint_lora_row(row)

    def _paint_lora_row(self, row: int) -> None:
        """Grey the ID / NAME text of a disabled row so the ON state is
        readable at a glance without squinting at the checkbox."""
        on_w = self.lora_table.cellWidget(row, 0)
        enabled = bool(on_w is not None and on_w.isChecked())
        color = QColor(PAL["text"]) if enabled else QColor(PAL["dis_text"])
        for col in (1, 2):
            it = self.lora_table.item(row, col)
            if it is not None:
                it.setForeground(QBrush(color))

    def _on_lora_cell_changed(self, row: int) -> None:
        """One widget of one LoRA row changed: sync the active stack INTO
        the store immediately (single source of truth), refresh the caption
        and the row look, then schedule the settings save."""
        if getattr(self, "_lora_filling", False) or self._loading:
            return
        self._paint_lora_row(row)
        self._sync_lora_stack()
        self._update_lora_caption()
        self._schedule_save()

    def _all_loras(self) -> List[Dict[str, Any]]:
        out = []
        for row in range(self.lora_table.rowCount()):
            ident = self.lora_table.item(row, 1)
            if ident is None:
                continue
            on_w = self.lora_table.cellWidget(row, 0)
            model_w = self.lora_table.cellWidget(row, 3)
            clip_w = self.lora_table.cellWidget(row, 4)
            trig_w = self.lora_table.cellWidget(row, 5)
            out.append({
                "id": ident.text().strip(), "name": (self.lora_table.item(row, 2).text() if self.lora_table.item(row, 2) else ""),
                "is_version": bool(ident.data(Qt.ItemDataRole.UserRole)),
                "model": round(model_w.value(), 2) if model_w else 1.0, "clip": round(clip_w.value(), 2) if clip_w else 1.0,
                "trigger": bool(trig_w.isChecked()) if trig_w else False,
                "enabled": bool(on_w.isChecked()) if on_w else True,
            })
        return out

    def _active_loras(self) -> List[Dict[str, Any]]:
        """Enabled LoRAs of the ACTIVE model's stack, in the exact shape the
        Horde expects at the payload's top level. Hard-capped at 5 (the API's
        per-request limit; on_generate also refuses earlier with a message)."""
        out: List[Dict[str, Any]] = []
        for l in self._all_loras():
            if not l["enabled"] or not l["id"]:
                continue
            if len(out) >= 5:
                break
            entry: Dict[str, Any] = {"name": l["id"], "model": l["model"], "clip": l["clip"]}
            if l["is_version"]:
                entry["is_version"] = True
            if l["trigger"]:
                entry["inject_trigger"] = "any"
            out.append(entry)
        return out

    def add_lora(self) -> None:
        ident = self.lora_id_edit.text().strip()
        if not ident:
            return
        if not re.fullmatch(r"[0-9]+", ident):
            self.lora_status.setText("Civitai IDs are numeric (the number in the civitai.com/models/<id> URL).")
            return
        self._append_lora_row({"id": ident, "is_version": self.lora_is_version.isChecked(), "enabled": True})
        self.lora_id_edit.clear()
        self.lora_table.selectRow(self.lora_table.rowCount() - 1)
        self._schedule_save()
        self._update_lora_caption()
        self.lookup_lora()

    def lookup_lora(self) -> None:
        row = self.lora_table.currentRow()
        if row < 0:
            return
        ident_item = self.lora_table.item(row, 1)
        if not ident_item:
            return
        ident = ident_item.text()
        is_version = bool(ident_item.data(Qt.ItemDataRole.UserRole))
        self.lora_status.setText(f"Looking up {ident} on Civitai\u2026")

        def done(info: Dict[str, Any], row=row, ident=ident) -> None:
            for r in range(self.lora_table.rowCount()):
                it = self.lora_table.item(r, 1)
                if it and it.text() == ident:
                    nm = self.lora_table.item(r, 2)
                    if nm:
                        nm.setText(info.get("name", ""))
                        nm.setToolTip(f"{info.get('name', '')}\nType: {info.get('type', '')}\nBase: {info.get('base', '')}")
            words = ", ".join(info.get("trained_words") or [])
            self.lora_status.setText(f"{info.get('name', '?')}  [{info.get('type', '')} / {info.get('base', '')}]" + (f"  trigger words: {words}" if words else ""))
            self._schedule_save()

        self._run_task(lambda: self.api.civitai_lookup(ident, is_version), done,
                       lambda err: self.lora_status.setText(f"Lookup failed: {err}"))

    def remove_lora(self) -> None:
        row = self.lora_table.currentRow()
        if row >= 0:
            self.lora_table.removeRow(row)
            self._schedule_save()
            self._update_lora_caption()

    def clear_loras(self) -> None:
        self.lora_table.setRowCount(0)
        self._schedule_save()
        self._update_lora_caption()

