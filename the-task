        # Razor gold-crimson top & bottom cinematic frame bars
        pygame.draw.rect(surf, (255, 236, 246), (0, 0, w, 4))
        pygame.draw.rect(surf, pal.aura_mid, (0, 4, w, 3))
        pygame.draw.rect(surf, pal.aura_mid, (0, h - 7, w, 3))
        pygame.draw.rect(surf, (255, 236, 246), (0, h - 4, w, 4))

        # Bold gothic super art title
        f_title = _load_crisp_font(34, serif=True, bold=True, italic=True)
        f_sub = _load_crisp_font(15, serif=True, bold=True)
        tx = 256 if facing_right else 38
