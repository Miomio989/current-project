# ==============================================================================
# PROCEDURAL COMBAT, FOLEY, UI & VOICE SFX GENERATOR + STREAMING AUDIO MANAGER
# ==============================================================================

class AudioManager:
    """
    Studio audio director combining:
      1. Seamless background-threaded multi-movement non-looping OST streaming
         (zero startup freeze, zero 4-bar ugly loops, live beat pulse sync!)
      2. 42+ layered procedural combat, steel-clash, blood, water, UI & voice SFX
    """

    def __init__(self, settings: GameSettings, headless: bool = False) -> None:
        self.settings = settings
        self.headless = headless
        self.mixer_ok: bool = False
        self.dsp = ModularAudioDSP(AUDIO_SAMPLE_RATE)
        self.scores: Dict[OSTTrackId, OSTComposition] = _build_full_ost_scores()
        self.sfx_bank: Dict[SFXId, pygame.mixer.Sound] = {}

        self._bgm_channel: Optional[pygame.mixer.Channel] = None
        self._active_track: Optional[OSTTrackId] = None
        self._current_bar_idx: int = 0
        self._current_section_name: str = ""
        self._phrase_bars: int = 2
        self._beat_timer: float = 0.0
        self._current_bpm: float = 148.0
        self._last_beat_pulse: float = 0.0

        # Background phrase streaming state
        self._stream_lock = threading.Lock()
        self._stream_gen: int = 0
        self._ready_queue: "queue.Queue[Tuple[int, int, str, pygame.mixer.Sound]]" = queue.Queue(maxsize=4)
        self._worker_stop = threading.Event()
        self._worker_wake = threading.Event()
        self._worker_thread: Optional[threading.Thread] = None

        self._init_mixer()
        if self.mixer_ok:
            self._bake_all_sfx()
            if not self.headless:
                self._start_stream_worker()

    def _init_mixer(self) -> None:
        try:
            if not pygame.mixer.get_init():
                pygame.mixer.init(
                    frequency=AUDIO_SAMPLE_RATE,
                    size=-16,
                    channels=AUDIO_CHANNELS,
                    buffer=AUDIO_BUFFER_SIZE,
                )
            pygame.mixer.set_num_channels(24)
            self._bgm_channel = pygame.mixer.Channel(0)
            self.mixer_ok = True
        except Exception:
            self.mixer_ok = False

    def _start_stream_worker(self) -> None:
        self._worker_thread = threading.Thread(target=self._stream_loop, daemon=True, name="nny-ost-synth")
        self._worker_thread.start()

    def shutdown(self) -> None:
        self._worker_stop.set()
        self._worker_wake.set()
        if self._worker_thread is not None and self._worker_thread.is_alive():
            self._worker_thread.join(timeout=0.5)

    def _stream_loop(self) -> None:
        """Synthesizes upcoming 2-bar musical movements ahead of playback seamlessly."""
        local_gen = -1
        local_bar = 0
        while not self._worker_stop.is_set():
            with self._stream_lock:
                gen = self._stream_gen
                track_id = self._active_track
            if track_id is None:
                self._worker_wake.wait(0.08)
                self._worker_wake.clear()
                continue
            if gen != local_gen:
                local_gen = gen
                local_bar = 0
            if self._ready_queue.full():
                self._worker_wake.wait(0.06)
                self._worker_wake.clear()
                continue

            comp = self.scores[track_id]
            n_bars = len(comp.bars)
            chunk: List[BarSectionSpec] = []
            for k in range(self._phrase_bars):
                chunk.append(comp.bars[(local_bar + k) % n_bars])
            sec_name = chunk[0].section_name
            snd = self.dsp.render_bars_phrase(chunk, comp.bpm, gain=0.80)
            if snd is not None:
                with self._stream_lock:
                    if gen == self._stream_gen:
                        try:
                            self._ready_queue.put_nowait((gen, local_bar, sec_name, snd))
                        except queue.Full:
                            pass
            local_bar = (local_bar + self._phrase_bars) % n_bars

    def play_bgm(self, track_id: OSTTrackId, force_restart: bool = False) -> None:
        if not self.mixer_ok:
            return
        if self._active_track == track_id and not force_restart:
            return
        comp = self.scores[track_id]
        self._current_bpm = comp.bpm
        self._beat_timer = 0.0
        with self._stream_lock:
            self._active_track = track_id
            self._stream_gen += 1
            gen = self._stream_gen
            self._current_bar_idx = 0
            self._current_section_name = comp.bars[0].section_name
            while not self._ready_queue.empty():
                try:
                    self._ready_queue.get_nowait()
                except queue.Empty:
                    break
        if self._bgm_channel is not None:
            self._bgm_channel.stop()
        self._worker_wake.set()

        # In headless mode or for immediate first-phrase kick-off, bake phrase 0 cleanly
        if self.headless and self._bgm_channel is not None:
            first_snd = self.dsp.render_bars_phrase(comp.bars[: self._phrase_bars], comp.bpm, gain=0.80)
            if first_snd is not None:
                vol = clamp(self.settings.master_volume * self.settings.bgm_volume, 0.0, 1.0)
                first_snd.set_volume(vol)
                self._bgm_channel.play(first_snd)

    def stop_bgm(self) -> None:
        with self._stream_lock:
            self._active_track = None
            self._stream_gen += 1
        if self._bgm_channel is not None:
            self._bgm_channel.stop()

    def update(self, dt: float) -> float:
        """
        Pump the seamless non-looping OST stream queue & return real-time
        quarter-note beat pulse [0..1] for stage/HUD visual synchronization!
        """
        pulse = 0.0
        if self._active_track is not None:
            beat_sec = 60.0 / max(60.0, self._current_bpm)
            self._beat_timer += dt
            if self._beat_timer >= beat_sec:
                self._beat_timer -= beat_sec
                pulse = 1.0

        if self.mixer_ok and self._bgm_channel is not None and self._active_track is not None:
            vol = clamp(self.settings.master_volume * self.settings.bgm_volume, 0.0, 1.0)
            self._bgm_channel.set_volume(vol)
            # Queue next synthesized phrase seamlessly without any gap!
            if not self._bgm_channel.get_busy() or self._bgm_channel.get_queue() is None:
                try:
                    gen, bar_idx, sec_name, snd = self._ready_queue.get_nowait()
                    if gen == self._stream_gen:
                        snd.set_volume(vol)
                        self._current_bar_idx = bar_idx
                        self._current_section_name = sec_name
                        if not self._bgm_channel.get_busy():
                            self._bgm_channel.play(snd)
                        else:
                            self._bgm_channel.queue(snd)
                        self._worker_wake.set()
                except queue.Empty:
                    self._worker_wake.set()
        self._last_beat_pulse = pulse
        return pulse

    def current_track_info(self) -> Tuple[str, str, int, int]:
        if self._active_track is None:
            return ("Silent", "", 0, 0)
        c = self.scores[self._active_track]
        return (c.title, self._current_section_name, self._current_bar_idx + 1, len(c.bars))

    def play_sfx(self, sfx_id: SFXId, volume: float = 1.0, pan: float = 0.0) -> None:
        if not self.mixer_ok:
            return
        snd = self.sfx_bank.get(sfx_id)
        if snd is None:
            return
        ch = pygame.mixer.find_channel(True)
        if ch is None:
            return
        if ch == self._bgm_channel:
            ch = pygame.mixer.Channel(1)
        master_v = clamp(self.settings.master_volume * self.settings.sfx_volume * volume, 0.0, 1.0)
        vl = master_v * clamp(1.0 - max(0.0, pan * 0.65), 0.25, 1.0)
        vr = master_v * clamp(1.0 + min(0.0, pan * 0.65), 0.25, 1.0)
        ch.set_volume(vl, vr)
        ch.play(snd)

    # --------------------------------------------------------------------------
    # Procedural Combat, Blade, Blood, Water, Gothic UI & Voice SFX Bank (42 SFX!)
    # --------------------------------------------------------------------------

    def _bake_all_sfx(self) -> None:
        sr = self.dsp.sr
        inv_sr = self.dsp.inv_sr
        rng = random.Random(2026)

        def make_sfx(dur: float, fn: Callable[[int, float, float], Tuple[float, float]], gain: float = 0.85) -> pygame.mixer.Sound:
            n = max(64, int(sr * dur))
            bl = [0.0] * n
            br = [0.0] * n
            for i in range(n):
                t = i * inv_sr
                u = i / float(max(1, n - 1))
                l_v, r_v = fn(i, t, u)
                bl[i] = l_v
                br[i] = r_v
            snd = self.dsp._pack_stereo_sound(bl, br, gain=gain)
            assert snd is not None
            return snd

        # 1. Steel Blade Whooshes (filtered noise Doppler sweep + steel ring)
        def bake_whoosh(dur: float, f0: float, f1: float, curse: bool = False) -> pygame.mixer.Sound:
            n = max(64, int(sr * dur))
            bl, br = [0.0] * n, [0.0] * n
            lp = bp = 0.0
            ph = 0.0
            for i in range(n):
                t = i * inv_sr
                u = i / float(max(1, n - 1))
                env = math.sin(u * math.pi) ** 1.25
                cut = clamp(lerp(f0, f1, u) * inv_sr * 2.5, 0.04, 0.72)
                w = rng.uniform(-1.0, 1.0)
                hp = w - lp - 0.35 * bp
                bp += cut * hp
                lp += cut * bp
                ring = 0.0
                if curse:
                    ph += lerp(440.0, 180.0, u) * inv_sr * math.tau
                    ring = math.sin(ph) * 0.28 * env
                v = (bp * 1.15 + ring) * env
                pan = lerp(-0.35, 0.35, u)
                bl[i] = v * (1.0 - max(0.0, pan))
                br[i] = v * (1.0 + min(0.0, pan))
            snd = self.dsp._pack_stereo_sound(bl, br, gain=0.82)
            assert snd is not None
            return snd

        self.sfx_bank[SFXId.WHOOSH_LIGHT] = bake_whoosh(0.14, 1800.0, 620.0)
        self.sfx_bank[SFXId.WHOOSH_MED] = bake_whoosh(0.20, 1450.0, 420.0)
        self.sfx_bank[SFXId.WHOOSH_HEAVY] = bake_whoosh(0.28, 1100.0, 260.0)
        self.sfx_bank[SFXId.WHOOSH_CURSE] = bake_whoosh(0.32, 1650.0, 310.0, curse=True)

