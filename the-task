# SECTION 11: ORNATE LACQUER/GOLD HUD, SCREENS, TRAINING MODE & MAIN APP LOOP
# ==============================================================================

class OrnateHUDRenderer:
    """
    Renders the Soulcalibur / Bayonetta / DMC4 inspired lacquer-and-gold filigree HUD
    matching the art reference: circular halo portraits, blade-shaped crimson Vitality bars
    with crawling violet Fester, fraying silver Resolve thread, blazing Tempo Halo timer,
    moon-phase round counters, 3-bead Trance strands, character widgets, and brush banners.
    """

    def __init__(self, textures: ProceduralTextureAtlas) -> None:
        self.textures = textures
        self.font_title = pygame.font.SysFont("georgia", 66, bold=True)
        self.font_sub = pygame.font.SysFont("georgia", 28, bold=True)
        self.font_timer = pygame.font.SysFont("georgia", 46, bold=True)
        self.font_hud = pygame.font.SysFont("georgia", 18, bold=True)
        self.font_small = pygame.font.SysFont("consolas", 14, bold=True)
        self.font_combo = pygame.font.SysFont("georgia", 42, bold=True, italic=True)

    def draw_match_hud(self, surf: "pygame.Surface", match: MatchSession) -> None:
        p1, p2 = match.fighters[0], match.fighters[1]
        cx = INTERNAL_W // 2

        # 1. Foreground Parallax Iron Spear Fence Silhouette along bottom (GDD 7.4)
        fence_off = int(-match.camera.pos_x * 18.0) % 92
        surf.blit(self.textures.surfaces["fg_iron_fence"], (-fence_off, INTERNAL_H - 104))

        # 2. Curved Black-Lacquer Gold-Filigree Vitality Bars + Crawling Fester + Silver Resolve
        self._draw_vitality_side(surf, p1, left=True, world_t=match.world_t, beat=match.beat_pulse)
        self._draw_vitality_side(surf, p2, left=False, world_t=match.world_t, beat=match.beat_pulse)

        # 3. Circular Halo Portrait Medallions (Top Left & Top Right)
        p1_img = pygame.transform.smoothscale(
            self.textures.surfaces["portrait_cecilia" if p1.char_id == "cecilia" else "portrait_kiri"], (112, 112)
        )
        p2_img = pygame.transform.smoothscale(
            self.textures.surfaces["portrait_cecilia" if p2.char_id == "cecilia" else "portrait_kiri"], (112, 112)
        )
        p2_img = pygame.transform.flip(p2_img, True, False)
        surf.blit(p1_img, (18, 12))
        surf.blit(p2_img, (INTERNAL_W - 130, 12))

        # 4. Central Blazing Gold Tempo Halo Medallion & 60s Timer
        ty = 60
        pulse_r = int(48 + match.beat_pulse * 7)
        tempo_col = (242, 184, 62) if match.tempo_phase == "prelude" else ((255, 112, 42) if match.tempo_phase == "rupture" else (255, 42, 34))
        pygame.draw.circle(surf, (18, 6, 10), (cx, ty), 45)
        pygame.draw.circle(surf, tempo_col, (cx, ty), pulse_r, 4)
        # Tempo arc fill around dial
        arc_rect = pygame.Rect(cx - 50, ty - 50, 100, 100)
        if match.tempo > 1.0:
            pygame.draw.arc(surf, (255, 224, 112), arc_rect, math.pi * 0.5, math.pi * 0.5 + (match.tempo / 100.0) * math.tau, 5)
        t_str = f"{int(math.ceil(match.timer)):02d}" if not match.training_mode else "∞"
        t_surf = self.font_timer.render(t_str, True, (255, 236, 178))
        surf.blit(t_surf, (cx - t_surf.get_width() // 2, ty - t_surf.get_height() // 2))
        ph_surf = self.font_small.render(match.tempo_phase.upper(), True, tempo_col)
        surf.blit(ph_surf, (cx - ph_surf.get_width() // 2, ty + 48))

        # 5. Lower-Corner 3-Bead Trance Strands + Character-Unique Widgets
        self._draw_trance_beads(surf, p1, left=True, beat=match.beat_pulse)
        self._draw_trance_beads(surf, p2, left=False, beat=match.beat_pulse)
        self._draw_char_widget(surf, p1, left=True)
        self._draw_char_widget(surf, p2, left=False)

        # 6. Bayonetta / DMC Combo Counter & Grade Word
        for f, is_left in ((p1, True), (p2, False)):
            if f.combo_count >= 2:
                grade_word, grade_col = "CALLOUS", (220, 200, 175)
                for thr, w, c in COMBO_GRADES:
                    if f.combo_count >= thr:
                        grade_word, grade_col = w, c
                bx = 64 if is_left else INTERNAL_W - 270
                by = 205
                c_txt = self.font_combo.render(f"{f.combo_count} HITS", True, grade_col)
                g_txt = self.font_sub.render(grade_word, True, (255, 236, 186))
                d_txt = self.font_small.render(f"{int(f.combo_damage)} TOLL", True, (215, 190, 170))
                surf.blit(c_txt, (bx, by))
                surf.blit(g_txt, (bx + 4, by + 44))
                surf.blit(d_txt, (bx + 6, by + 76))

        # 7. Callout Toast (Severance Hush, Sync Hit, Fester Reap, Possession, Blade Lock)
        if match.callout_timer > 0 and match.callout_text:
            cs = self.font_sub.render(match.callout_text, True, match.callout_color)
            sh = self.font_sub.render(match.callout_text, True, (18, 4, 8))
            surf.blit(sh, (cx - cs.get_width() // 2 + 2, 136))
            surf.blit(cs, (cx - cs.get_width() // 2, 134))

        # 8. Painterly Gold-Crimson Round / Final Round Eclipse / KO Banner
        if match.banner_timer > 0 and match.banner_title:
            bt_sh = self.font_title.render(match.banner_title, True, (42, 6, 10))
            bt = self.font_title.render(match.banner_title, True, (255, 208, 72))
            by = INTERNAL_H // 2 - 72
            surf.blit(bt_sh, (cx - bt.get_width() // 2 + 4, by + 4))
            surf.blit(bt, (cx - bt.get_width() // 2, by))
            if match.banner_sub:
