    def _update_edit_stage(self) -> None:
        """Show the full-size edit stage while the EDIT tab is active and a
        document is loaded; the regular viewer otherwise."""
        if not hasattr(self, "right_stack"):
            return
        show = (
            self.tabs.currentIndex() == TAB_EDIT
            and self.edit_base is not None
            and not self.edit_base.isNull()
        )
        if show == self._edit_stage_visible:
            return
        self._edit_stage_visible = show
        if show:
            self.right_stack.setCurrentWidget(self.edit_stage)
            QTimer.singleShot(0, self.edit_canvas.fit_view)
        else:
            self.right_stack.setCurrentWidget(self.viewer_tab)

    def edit_from_viewer(self) -> None:
        path = self._current_image()
        if not path:
            self._flash_summary("Open an image in the viewer first.")
            return
        self.edit_set_source(path)

    def edit_open_file(self) -> None:
        path, _f = QFileDialog.getOpenFileName(
            self, "Select an image to edit", OUTPUT_DIR, "Images (*.png *.webp *.jpg *.jpeg)"
        )
        if path:
            self.edit_set_source(path)

    def _edit_push_undo(self) -> None:
        if self.edit_base is None:
            return
        px = max(1, self.edit_base.width() * self.edit_base.height())
        max_states = max(2, min(10, int(160 * 1024 * 1024 // (px * 4))))
        self.edit_undo_stack.append(self.edit_base.copy())
        self.edit_redo_stack.clear()
        while len(self.edit_undo_stack) > max_states:
            self.edit_undo_stack.pop(0)
        self.edit_undo_btn.setEnabled(True)
        if hasattr(self, "edit_redo_btn"):
            self.edit_redo_btn.setEnabled(False)

    def edit_undo(self) -> None:
        if not self.edit_undo_stack:
            return
        if self.edit_base is not None:
            self.edit_redo_stack.append(self.edit_base.copy())
        self.edit_base = self.edit_undo_stack.pop()
        self.edit_canvas.set_document(self.edit_base)
        self.edit_undo_btn.setEnabled(bool(self.edit_undo_stack))
        if hasattr(self, "edit_redo_btn"):
            self.edit_redo_btn.setEnabled(bool(self.edit_redo_stack))
        self._edit_recompute_now()
        self._flash_summary("Editor: undo applied")

    def edit_redo(self) -> None:
        if not self.edit_redo_stack:
            return
        if self.edit_base is not None:
            self.edit_undo_stack.append(self.edit_base.copy())
        self.edit_base = self.edit_redo_stack.pop()
        self.edit_canvas.set_document(self.edit_base)
        self.edit_undo_btn.setEnabled(bool(self.edit_undo_stack))
        if hasattr(self, "edit_redo_btn"):
            self.edit_redo_btn.setEnabled(bool(self.edit_redo_stack))
        self._edit_recompute_now()
        self._flash_summary("Editor: redo applied")

    def edit_auto_enhance(self) -> None:
        """One-click balanced cinematic polish (subtle contrast, shadow lift, highlight recovery, vibrance)."""
        preset = {
            "exposure": 4, "contrast": 14, "highlights": -10, "shadows": 12,
            "temperature": 3, "saturation": 4, "vibrance": 14, "hdr": 10,
            "bloom": 6, "sharpness": 12, "vignette": 8, "grain": 0,
        }
        for key, val in preset.items():
            if key in self.edit_sliders:
                sl = self.edit_sliders[key]
                sl.blockSignals(True)
                sl.setValue(val)
                sl.blockSignals(False)
                self.edit_adjust[key] = float(val)
                self.edit_slider_vals[key].setText(str(val))
        self._edit_recompute_now()
        self._schedule_save()
        self._flash_summary("Auto balance applied")

    def edit_apply(self) -> None:
        """Bake everything currently visible — manual adjustments, the
        cinematic LUT grade and every placed anamorphic flare — into the
        image (full frame or masked scope). The mask is consumed."""
        if self.edit_base is None or self.edit_base.isNull():
            return
        mask = None
        if self.edit_scope_mask.isChecked() or self.edit_scope_unmask.isChecked():
            mask = self.edit_canvas.effective_mask()
            if mask is None or not self.edit_canvas.has_mask():
                mask = None
        self._edit_push_undo()
        result, _skipped = apply_edit_pipeline(
            self.edit_base, self.edit_adjust,
            mask=mask,
            invert_mask=self.edit_scope_unmask.isChecked(),
            lut_key=self.edit_lut_key,
            lut_intensity=self.edit_lut_intensity,
            flares=self.edit_flares,
        )
        # retouch strokes are baked in the same pass (what you see is what is
        # applied); the stroke layer is cleared with the fresh document below
        paint = self.edit_canvas.paint_layer()
        if paint is not None and self.edit_canvas.has_paint():
            baked = result.convertToFormat(QImage.Format.Format_ARGB32_Premultiplied)
            bp = QPainter(baked)
            bp.drawImage(0, 0, paint)
            bp.end()
            result = baked
        self.edit_base = result
        # keep the mask painted area visible for further passes? No - consumed.
        self.edit_canvas.set_document(result)
        self.edit_adjust = default_edit_adjustments()
        for key, sl in self.edit_sliders.items():
            sl.blockSignals(True)
            sl.setValue(0)
            sl.blockSignals(False)
            self.edit_slider_vals[key].setText("0")
        # LUT + flares are baked: reset the live grading stack
        self.edit_lut_key = ""
        ix = self.edit_lut_combo.findData("")
        self.edit_lut_combo.blockSignals(True)
        self.edit_lut_combo.setCurrentIndex(max(0, ix))
        self.edit_lut_combo.blockSignals(False)
        self.edit_flares = []
        self._edit_flare_sel = -1
        self._sync_flare_ui()
        self._edit_recompute_now()
        self._update_split_info()
        self._flash_summary("Grade baked into the image — mask, LUT and flares cleared.")
        STUDIO_LOG.ok("SYS", "Editor: adjustments + LUT + flares applied")

    # ---- Cinematic LUT grade handlers ----------------------------------------
    def _on_edit_lut_changed(self) -> None:
        self.edit_lut_key = str(self.edit_lut_combo.currentData() or "")
        self.edit_lut_intensity = int(self.edit_lut_intensity_sl.value())
        self.edit_lut_intensity_val.setText(f"{self.edit_lut_intensity}%")
        spec = LUT_FILTER_BY_KEY.get(self.edit_lut_key)
        self.edit_lut_hint.setText(spec["hint"] if spec else "")
        self._edit_schedule_recompute()
        self._schedule_save()

    # ---- Anamorphic flare VFX handlers (v6.0 pure-vector dual-hue horizontal) --
    @staticmethod
    def _format_flare_val(key: str, value: int) -> str:
        if key in ("scale", "brightness", "saturation", "stretch", "opacity"):
            return f"{value}%"
        if key in ("hue", "hue2"):
            return f"{'+' if value > 0 else ''}{value}°"
        return f"{'+' if value > 0 else ''}{value}"

    def _sync_stage_flare_quick_sliders(self) -> None:
        if not hasattr(self, "edit_stage_flare_size"):
            return
        for sl_src, sl_dst, lab_dst, k in (
            (self.edit_flare_sl_scale, self.edit_stage_flare_size, self._edit_stage_flare_size_lab, "scale"),
            (self.edit_flare_sl_brightness, self.edit_stage_flare_bright, self._edit_stage_flare_bright_lab, "brightness"),
            (self.edit_flare_sl_hue, self.edit_stage_flare_hue, self._edit_stage_flare_hue_lab, "hue"),
            (self.edit_flare_sl_hue2, self.edit_stage_flare_hue2, self._edit_stage_flare_hue2_lab, "hue2"),
        ):
            v = int(sl_src.value())
            sl_dst.blockSignals(True)
            sl_dst.setValue(v)
            sl_dst.blockSignals(False)
            lab_dst.setText(self._format_flare_val(k, v))

    def _flare_defaults(self) -> Dict[str, Any]:
        return {
            "preset": str(self.edit_flare_combo.currentData() or FLARE_PRESETS[0]["key"]),
            "x": 0.5, "y": 0.42,
            "scale": int(self.edit_flare_sl_scale.value()),
            "brightness": int(self.edit_flare_sl_brightness.value()),
            "saturation": int(self.edit_flare_sl_saturation.value()),
            "stretch": int(self.edit_flare_sl_stretch.value()),
            "hue": int(self.edit_flare_sl_hue.value()),
            "hue2": int(self.edit_flare_sl_hue2.value()),
            "contrast": int(self.edit_flare_sl_contrast.value()),
            "opacity": int(self.edit_flare_sl_opacity.value()),
            "visible": True,
            "locked": False,
            "solo": False,
        }

    def edit_flare_add_center(self) -> None:
        if self.edit_base is None or self.edit_base.isNull():
            self._flash_summary("Open an image in the editor first.")
            return
        if len(self.edit_flares) >= 16:
            self._flash_summary("Flare limit reached (16) — remove a flare first.")
            return
        off = (len(self.edit_flares) % 5) * 0.06
        fx = min(0.86, 0.36 + off)
        fy = min(0.80, 0.34 + (len(self.edit_flares) % 3) * 0.12)
        self._set_edit_tool("flare")
        self._on_flare_placed(fx, fy)

    def _on_flare_preset_changed(self) -> None:
        pkey = str(self.edit_flare_combo.currentData() or "")
        spec = FLARE_PRESET_BY_KEY.get(pkey)
        if spec is not None:
            self.edit_flare_hint.setText(
                f"{spec['hint']}  Click a light source or press Add; drag ring or Shift+Wheel to resize."
            )
            sel = self._edit_flare_sel
            if 0 <= sel < len(self.edit_flares) and self.edit_flares[sel].get("preset") != pkey:
                self.edit_flares[sel]["preset"] = pkey
                self._sync_flare_ui()
                self._edit_schedule_recompute()
        self._schedule_save()

    def _on_flare_param_slider(self, key: str, value: int, label: QLabel) -> None:
        label.setText(self._format_flare_val(key, int(value)))
        sel = self._edit_flare_sel
        if 0 <= sel < len(self.edit_flares):
            self.edit_flares[sel][key] = int(value)
            if key == "scale":
                self.edit_canvas.set_flares(self.edit_flares, self._edit_flare_sel)
            self._edit_schedule_recompute()
        self._sync_stage_flare_quick_sliders()
        self._schedule_save()

    def _on_flare_xy_spin(self) -> None:
        sel = self._edit_flare_sel
        if 0 <= sel < len(self.edit_flares) and not self.edit_flares[sel].get("locked", False):
            self.edit_flares[sel]["x"] = float(self.edit_flare_x_spin.value()) / 100.0
            self.edit_flares[sel]["y"] = float(self.edit_flare_y_spin.value()) / 100.0
            self.edit_canvas.set_flares(self.edit_flares, self._edit_flare_sel)
            self._edit_schedule_recompute()

    def _on_flare_scaled(self, index: int, new_scale: int) -> None:
        if 0 <= index < len(self.edit_flares) and not self.edit_flares[index].get("locked", False):
            self._edit_flare_sel = index
            clamped = max(30, min(250, int(new_scale)))
            self.edit_flares[index]["scale"] = clamped
            self.edit_flare_sl_scale.blockSignals(True)
            self.edit_flare_sl_scale.setValue(clamped)
            self.edit_flare_sl_scale.blockSignals(False)
            self.edit_flare_val_scale.setText(f"{clamped}%")
            self._sync_stage_flare_quick_sliders()
            self.edit_canvas.set_flares(self.edit_flares, self._edit_flare_sel)
            self._edit_schedule_recompute()

    def _on_flare_placed(self, fx: float, fy: float) -> None:
        if self.edit_base is None or self.edit_base.isNull():
            return
        if len(self.edit_flares) >= 16:
            self._flash_summary("Flare limit reached (16) — remove one before placing another.")
            return
        self.edit_flares.append(self._flare_defaults())
        self.edit_flares[-1]["x"] = float(fx)
        self.edit_flares[-1]["y"] = float(fy)
        self._edit_flare_sel = len(self.edit_flares) - 1
        if hasattr(self, "edit_subtabs"):
            self.edit_subtabs.setCurrentIndex(1)
        self._sync_flare_ui()
        self._edit_schedule_recompute()
        STUDIO_LOG.info("SYS", f"Editor: horizontal flare placed ({fx:.2f}, {fy:.2f})")

    def _on_flare_handle_selected(self, index: int) -> None:
        self._edit_flare_sel = int(index)
        self._sync_flare_ui()

    def _on_flare_moved(self, index: int, fx: float, fy: float) -> None:
        if 0 <= index < len(self.edit_flares) and not self.edit_flares[index].get("locked", False):
            self.edit_flares[index]["x"] = float(fx)
            self.edit_flares[index]["y"] = float(fy)
            self._edit_flare_sel = index
            if hasattr(self, "edit_flare_x_spin"):
                self.edit_flare_x_spin.blockSignals(True)
                self.edit_flare_x_spin.setValue(fx * 100.0)
                self.edit_flare_x_spin.blockSignals(False)
                self.edit_flare_y_spin.blockSignals(True)
                self.edit_flare_y_spin.setValue(fy * 100.0)
                self.edit_flare_y_spin.blockSignals(False)
            self.edit_canvas.set_flares(self.edit_flares, self._edit_flare_sel)
            self._edit_schedule_recompute()

    def _on_flare_list_selected(self, row: int) -> None:
        self._edit_flare_sel = int(row) if 0 <= row < len(self.edit_flares) else -1
        self.edit_canvas.set_selected_flare(self._edit_flare_sel)
        self._sync_flare_sliders()

    def edit_flare_duplicate_selected(self) -> None:
        if not (0 <= self._edit_flare_sel < len(self.edit_flares)):
            return
        if len(self.edit_flares) >= 16:
            self._flash_summary("Flare limit reached (16).")
            return
        dup = dict(self.edit_flares[self._edit_flare_sel])
        dup["x"] = min(0.95, float(dup.get("x", 0.5)) + 0.06)
        dup["y"] = min(0.95, float(dup.get("y", 0.5)) + 0.04)
        dup["locked"] = False
        dup["solo"] = False
        self.edit_flares.append(dup)
        self._edit_flare_sel = len(self.edit_flares) - 1
        self._sync_flare_ui()
        self._edit_schedule_recompute()
        self._flash_summary("Flare duplicated")

    def edit_flare_toggle_selected_visible(self) -> None:
        if not (0 <= self._edit_flare_sel < len(self.edit_flares)):
            return
        f = self.edit_flares[self._edit_flare_sel]
        f["visible"] = not bool(f.get("visible", True))
        self._sync_flare_ui()
        self._edit_schedule_recompute()

    def edit_flare_toggle_selected_solo(self) -> None:
        if not (0 <= self._edit_flare_sel < len(self.edit_flares)):
            return
        cur = bool(self.edit_flares[self._edit_flare_sel].get("solo", False))
        for f in self.edit_flares:
            f["solo"] = False
        self.edit_flares[self._edit_flare_sel]["solo"] = not cur
        self._sync_flare_ui()
        self._edit_schedule_recompute()

    def edit_flare_toggle_selected_locked(self) -> None:
        if not (0 <= self._edit_flare_sel < len(self.edit_flares)):
            return
        f = self.edit_flares[self._edit_flare_sel]
        f["locked"] = not bool(f.get("locked", False))
        self._sync_flare_ui()
        self.edit_canvas.update()

    def edit_flare_reset_params(self) -> None:
        sel = self._edit_flare_sel
        for key in ("scale", "brightness", "saturation", "stretch", "hue", "hue2", "contrast", "opacity"):
            dv = int(DEFAULT_FLARE_STATE[key])
            sl = getattr(self, f"edit_flare_sl_{key}")
            lab = getattr(self, f"edit_flare_val_{key}")
            sl.blockSignals(True)
            sl.setValue(dv)
            sl.blockSignals(False)
            lab.setText(self._format_flare_val(key, dv))
            if 0 <= sel < len(self.edit_flares):
                self.edit_flares[sel][key] = dv
        self._sync_stage_flare_quick_sliders()
        self.edit_canvas.set_flares(self.edit_flares, self._edit_flare_sel)
        self._edit_schedule_recompute()

    def edit_flare_remove_selected(self) -> None:
        if 0 <= self._edit_flare_sel < len(self.edit_flares):
            self.edit_flares.pop(self._edit_flare_sel)
            self._edit_flare_sel = min(self._edit_flare_sel, len(self.edit_flares) - 1)
            self._sync_flare_ui()
            self._edit_schedule_recompute()

    def edit_flare_clear_all(self) -> None:
        if self.edit_flares:
            self.edit_flares = []
            self._edit_flare_sel = -1
            self._sync_flare_ui()
            self._edit_schedule_recompute()

    def _sync_flare_sliders(self) -> None:
        sel = self._edit_flare_sel
        active = 0 <= sel < len(self.edit_flares)
        values = self.edit_flares[sel] if active else dict(DEFAULT_FLARE_STATE)
        if active:
            pkey = str(values.get("preset") or "")
            ix = self.edit_flare_combo.findData(pkey)
            if ix >= 0 and self.edit_flare_combo.currentIndex() != ix:
                self.edit_flare_combo.blockSignals(True)
                self.edit_flare_combo.setCurrentIndex(ix)
                self.edit_flare_combo.blockSignals(False)
        for key in ("scale", "brightness", "saturation", "stretch", "hue", "hue2", "contrast", "opacity"):
            sl = getattr(self, f"edit_flare_sl_{key}")
            lab = getattr(self, f"edit_flare_val_{key}")
            v = int(values.get(key, DEFAULT_FLARE_STATE.get(key, 0)))
            sl.blockSignals(True)
            sl.setValue(v)
            sl.blockSignals(False)
            lab.setText(self._format_flare_val(key, v))
        if hasattr(self, "edit_flare_x_spin"):
            self.edit_flare_x_spin.blockSignals(True)
            self.edit_flare_x_spin.setValue(float(values.get("x", 0.5)) * 100.0)
            self.edit_flare_x_spin.blockSignals(False)
            self.edit_flare_y_spin.blockSignals(True)
            self.edit_flare_y_spin.setValue(float(values.get("y", 0.5)) * 100.0)
            self.edit_flare_y_spin.blockSignals(False)
        self._sync_stage_flare_quick_sliders()
        if hasattr(self, "edit_flare_vis_btn"):
            vis = bool(values.get("visible", True))
            self.edit_flare_vis_btn.setText("Hide" if vis else "Show")
            self.edit_flare_vis_btn.setIcon(VECTOR_ASSETS.icon("eye" if vis else "eye_off", 12))
        if hasattr(self, "edit_flare_solo_btn"):
            solo = bool(values.get("solo", False))
            self.edit_flare_solo_btn.setText("Unsolo" if solo else "Solo")
        if hasattr(self, "edit_flare_lock_btn"):
            locked = bool(values.get("locked", False))
            self.edit_flare_lock_btn.setText("Unlock" if locked else "Lock")
            self.edit_flare_lock_btn.setIcon(VECTOR_ASSETS.icon("lock" if locked else "unlock", 12))

    def _sync_flare_ui(self) -> None:
        if not hasattr(self, "edit_flare_list"):
            return
        keep = self._edit_flare_sel
        self.edit_flare_list.blockSignals(True)
        self.edit_flare_list.clear()
        for i, f in enumerate(self.edit_flares):
            spec = FLARE_PRESET_BY_KEY.get(str(f.get("preset") or ""))
            name = spec["name"] if spec else str(f.get("preset"))
            sc = int(f.get("scale", 100))
            flags = []
            if f.get("solo"):
                flags.append("Solo")
            if f.get("locked"):
                flags.append("Locked")
            if not f.get("visible", True):
                flags.append("Hidden")
            flag_txt = f" [{', '.join(flags)}]" if flags else ""
            self.edit_flare_list.addItem(
                f"{i + 1} · {name} · {sc}% ({f.get('x', 0.5) * 100:.0f}%, {f.get('y', 0.5) * 100:.0f}%){flag_txt}"
            )
        if 0 <= keep < len(self.edit_flares):
            self.edit_flare_list.setCurrentRow(keep)
        else:
            self.edit_flare_list.setCurrentRow(-1)
        self.edit_flare_list.blockSignals(False)
        self.edit_canvas.set_flares(self.edit_flares, self._edit_flare_sel)
        self._sync_flare_sliders()
        has = bool(self.edit_flares)
        has_sel = 0 <= self._edit_flare_sel < len(self.edit_flares)
        self.edit_flare_remove_btn.setEnabled(has_sel)
        self.edit_flare_clear_btn.setEnabled(has)
        for btn_name in ("edit_flare_dup_btn", "edit_flare_vis_btn", "edit_flare_solo_btn", "edit_flare_lock_btn"):
            b = getattr(self, btn_name, None)
            if b is not None:
                b.setEnabled(has_sel)
        if hasattr(self, "edit_flare_reset_btn"):
            self.edit_flare_reset_btn.setEnabled(True)
        if hasattr(self, "edit_stage_flare_dup"):
            self.edit_stage_flare_dup.setEnabled(has_sel)
            self.edit_stage_flare_del.setEnabled(has_sel)
        if not has:
            self._edit_flare_sel = -1
        self._update_edit_buttons()

    # ---- Split Studio handlers -------------------------------------------------
    def _split_vertical(self) -> bool:
        return self.edit_split_vert.isChecked()

    def _split_document(self) -> Tuple[Optional[QImage], Optional[QImage], int]:
        """Current graded result (full resolution) split into two halves."""
        if self.edit_base is None or self.edit_base.isNull():
            return None, None, 0
        mask = None
        if self.edit_scope_mask.isChecked() or self.edit_scope_unmask.isChecked():
            mask = self.edit_canvas.effective_mask()
        full, _skipped = apply_edit_pipeline(
            self._edit_working_image(), self.edit_adjust,
            mask=mask if (mask is not None and self.edit_canvas.has_mask()) else None,
            invert_mask=self.edit_scope_unmask.isChecked(),
            lut_key=self.edit_lut_key,
            lut_intensity=self.edit_lut_intensity,
            flares=self.edit_flares,
        )
        return split_image_halves(full, self._split_vertical(), int(self.edit_split_gap.value()))

    def _on_split_params_changed(self) -> None:
        self.edit_split_gap_val.setText(f"{self.edit_split_gap.value()} px")
        self._update_split_info()
        self._schedule_save()

    def _update_split_info(self) -> None:
        if not hasattr(self, "edit_split_dims") or self.edit_base is None:
            if hasattr(self, "edit_split_dims"):
                self.edit_split_dims.setText("Open an image to split it into two halves.")
            return
        vertical = self._split_vertical()
        w, h = self.edit_base.width(), self.edit_base.height()
        first, second, real_gap = split_image_halves(self.edit_base, vertical, int(self.edit_split_gap.value()))
        if first is None or second is None:
            self.edit_split_dims.setText("Open an image to split it into two halves.")
            return
        a = ("L/R" if vertical else "T/B")
        self.edit_split_dims.setText(
            f"{a}: half A {first.width()}\u00d7{first.height()} px, half B "
            f"{second.width()}\u00d7{second.height()} px \u00b7 middle bar excluded: "
            f"{real_gap} px \u00b7 source {w}\u00d7{h}"
        )

    def edit_split_copy_first(self) -> None:
        first, _second, _g = self._split_document()
        if first is None:
            self._flash_summary("Open an image on the edit stage first.")
            return
        QApplication.clipboard().setImage(first)
        self._flash_summary(
            f"{'Left' if self._split_vertical() else 'Top'} half copied to the clipboard "
            f"({first.width()}\u00d7{first.height()})."
        )

    def edit_split_copy_second(self) -> None:
        _first, second, _g = self._split_document()
        if second is None:
            self._flash_summary("Open an image on the edit stage first.")
            return
        QApplication.clipboard().setImage(second)
        self._flash_summary(
            f"{'Right' if self._split_vertical() else 'Bottom'} half copied to the clipboard "
            f"({second.width()}\u00d7{second.height()})."
        )

    def edit_split_save_both(self) -> None:
        """Save both halves into outputs/ as separate PNG files, each carrying
        a copy of the source image's JSON metadata (sizes patched)."""
        first, second, real_gap = self._split_document()
        if first is None or second is None:
            self._flash_summary("Open an image on the edit stage first.")
            return
        base_meta = read_image_metadata(self.edit_source_path) if self.edit_source_path else {}
        stem = os.path.splitext(os.path.basename(self.edit_source_path or "edit"))[0] or "edit"
        vertical = self._split_vertical()
        ensure_dirs()
        saved: List[str] = []
        stamp = time.strftime("%Y%m%d_%H%M%S")
        for half, tag in ((first, "L" if vertical else "T"), (second, "R" if vertical else "B")):
            meta = {k: v for k, v in base_meta.items() if not k.startswith("_")}
            meta.update({
                "width": half.width(),
                "height": half.height(),
                "split_source": self.edit_source_path or "",
                "split_half": {"L": "left", "R": "right", "T": "top", "B": "bottom"}[tag],
                "split_gap": real_gap,
                "saved_at": time.time(),
                "app": f"{APP_NAME} {APP_VERSION}",
            })
            meta.pop("favorite", None)
            meta.pop("aesthetic", None)
            dest = os.path.join(OUTPUT_DIR, f"{stem}_split{tag}_{stamp}.png")
            write_image_with_metadata(image_to_png_bytes(half), dest, meta)
            saved.append(dest)
        self.gallery_tab.mark_dirty()
        self.refresh_gallery(select=saved[0])
        self.gallery_tab.reload_dir()
        self.toast.notify(
            f"Split saved \u2192 {os.path.basename(saved[0])} + {os.path.basename(saved[1])}", "ok"
        )
        SOUNDS.play("done")
        STUDIO_LOG.ok("SYS", f"Editor: split saved {os.path.basename(saved[0])} / {os.path.basename(saved[1])}")

    def edit_send_inpaint(self) -> None:
        """Send image + painted mask to img2img as an inpainting request."""
        if self.edit_base is None or not self.edit_canvas.has_mask():
            return
        ensure_dirs()
        stamp = time.strftime("%Y%m%d_%H%M%S")
        img_path = os.path.join(SCRATCH_DIR, f"edit_{stamp}.png")
        mask_path = os.path.join(SCRATCH_DIR, f"edit_{stamp}_mask.png")
        img, _sk = apply_edit_pipeline(
            self._edit_working_image(), self.edit_adjust,
            lut_key=self.edit_lut_key, lut_intensity=self.edit_lut_intensity,
        )
        if not img.save(img_path, "PNG"):
            self._flash_summary("Could not write the editor image to scratch.")
            return
        with open(mask_path, "wb") as fh:
            fh.write(mask_to_inpaint_png(self.edit_canvas.effective_mask(), img.width(), img.height()))
        self._set_img2img_source(img_path)
        self._set_img2img_mask(mask_path)
        w, h = fit_pair_under_mp(img.width(), img.height())
        self.custom_size_check.setChecked(True)
        self.w_spin.setValue(w)
        self.h_spin.setValue(h)
        self.tabs.setCurrentIndex(TAB_PROMPT)
        self._flash_summary(
            "Inpainting source attached - describe the REPAINED area in the prompt, then GENERATE."
        )

    def edit_save_new(self) -> None:
        """Write the edited image into outputs/ as a NEW file, copying the
        original's JSON metadata; optionally delete the original afterwards."""
        if self.edit_base is None or self.edit_base.isNull():
            return
        was_masked = self.edit_canvas.has_mask() and not self.edit_scope_full.isChecked()
        working = self._edit_working_image() or self.edit_base
        if was_masked or edit_adjustments_active(self.edit_adjust) or self.edit_lut_key or self.edit_flares:
            self._edit_push_undo()
            img, _sk = apply_edit_pipeline(
                working, self.edit_adjust,
                mask=self.edit_canvas.effective_mask() if was_masked else None,
                invert_mask=self.edit_scope_unmask.isChecked(),
                lut_key=self.edit_lut_key,
                lut_intensity=self.edit_lut_intensity,
                flares=self.edit_flares,
            )
        else:
            img = working
        base_meta = read_image_metadata(self.edit_source_path) if self.edit_source_path else {}
        meta = {k: v for k, v in base_meta.items() if not k.startswith("_")}
        meta.update({
            "width": img.width(),
            "height": img.height(),
            "edit_source": self.edit_source_path or "",
            "edit_adjustments": {k: round(float(v), 1) for k, v in self.edit_adjust.items()
                                 if abs(float(v)) > 0.01},
            "edit_lut": {
                "key": self.edit_lut_key,
                "intensity": int(self.edit_lut_intensity),
            } if self.edit_lut_key else None,
            "edit_flares": [
                {k: (round(float(v), 4) if k in ("x", "y") else v) for k, v in f.items()}
                for f in self.edit_flares
            ],
            "edit_masked": bool(was_masked),
            "saved_at": time.time(),
            "app": f"{APP_NAME} {APP_VERSION}",
        })
        meta.pop("favorite", None)
        meta.pop("aesthetic", None)
        ensure_dirs()
        dest = self.store.output_name(meta, ".png")
        write_image_with_metadata(image_to_png_bytes(img), dest, meta)
        STUDIO_LOG.ok("SYS", f"Editor: saved {os.path.basename(dest)}")
        self.gallery_tab.mark_dirty()
        deleted_note = ""
        if (
            self.edit_delete_original_check.isChecked()
            and self.edit_source_path
            and os.path.isfile(self.edit_source_path)
            and os.path.dirname(self.edit_source_path) in (OUTPUT_DIR, TEMP_DIR)
        ):
            self.store.delete_file(self.edit_source_path)
            deleted_note = " (original deleted)"
            STUDIO_LOG.info("SYS", f"Editor: original deleted - {os.path.basename(self.edit_source_path)}")
        self.refresh_gallery(select=dest)
        self.gallery_tab.reload_dir()
        self.show_image(dest)
        self.toast.notify(f"Edit saved \u2192 {os.path.basename(dest)}{deleted_note}", "ok")
        SOUNDS.play("done")

    # ------------------------------------------------------------------ Depth maps (Alchemy)
    def request_depth_map(self, path: Optional[str]) -> None:
        """Queue a depth_anything_v2 Alchemy annotation for a gallery / temp
        image. The result lands beside its source as <name>_depth.png."""
        if not path or not os.path.isfile(path) or is_depth_image_path(path):
            return
        if has_depth_map(path):
            try:
                os.remove(depth_path_for(path))
                os.remove(os.path.splitext(depth_path_for(path))[0] + ".json")
            except OSError:
                pass
        job = self.queue.enqueue(
            {"source_image_path": path},
            {
                "depth_job": True,
                "depth_source": path,
                "depth_target": depth_path_for(path),
                "prompt": "Depth Anything V2",
            },
            kind=KIND_DEPTH,
        )
        SOUNDS.play("sent")
        self.mini_queue.setVisible(True)
        self.mini_queue.scrollToBottom()
        self._flash_summary(f"Depth map requested (job #{job.local_id}) - AI Horde Alchemy")

    def delete_depth_map(self, path: Optional[str]) -> None:
        if not path:
            return
        removed = False
        for cand in (depth_path_for(path), os.path.splitext(depth_path_for(path))[0] + ".json"):
            if os.path.isfile(cand):
                try:
                    os.remove(cand)
                    removed = True
                except OSError:
                    pass
        if removed:
            self.gallery.refresh(self.store.list_recent())
            self.gallery_tab.mark_dirty()
            self.gallery_tab.reload_dir()
            self._flash_summary("Depth map deleted.")

