def _build_all_ost_scores() -> Dict[OSTTrackId, OSTComposition]:
    """
    Compose 5 complete, evolving, non-repetitive high-BPM Techno / Breakbeat /
    Dark Gothic Industrial OST arrangements (64-80 bars each!).
    Every track progresses cleanly through Intro -> Tension Build -> Drop A ->
    Cathedral Breakdown -> Riser -> Hyper Assault Drop B -> Acid Trance Climax!
    """
    scores: Dict[OSTTrackId, OSTComposition] = {}

    # Rhythmic pattern templates (16 sixteenth-notes per bar)
    K_FOUR = (1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)
    K_BREAK_A = (2, 0, 0, 0, 0, 0, 1, 0, 0, 0, 2, 0, 0, 0, 0, 0)
