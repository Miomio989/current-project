class DSPVoice:
    """Pure-Python DSP primitives: polyBLEP saw, FM bronze bell, SVF resonant filter, waveshaper."""

    @staticmethod
    def pack_wav_bytes(samples: Sequence[float], sr: int = AUDIO_SR) -> bytes:
        buf = io.BytesIO()
        pcm = array.array("h")
        for s in samples:
            v = int(clamp(s, -1.0, 1.0) * 32000.0)
            pcm.append(v)
        with wave.open(buf, "wb") as wf:
            wf.setnchannels(1)
            wf.setsampwidth(2)
            wf.setframerate(sr)
            wf.writeframes(pcm.tobytes())
        return buf.getvalue()

    @staticmethod
    def make_sound(samples: Sequence[float], sr: int = AUDIO_SR) -> Optional["pygame.mixer.Sound"]:
        try:
            if not pygame.mixer.get_init():
                return None
            raw = DSPVoice.pack_wav_bytes(samples, sr)
            return pygame.mixer.Sound(file=io.BytesIO(raw))
        except Exception:
            return None

    @staticmethod
    def synth_kick(dur: float = 0.24, hard: bool = False, sr: int = AUDIO_SR) -> List[float]:
        n = int(dur * sr)
        out = [0.0] * n
        phase = 0.0
        f0 = 195.0 if hard else 152.0
        f1 = 44.0 if hard else 48.0
        drive = 3.2 if hard else 1.5
        for i in range(n):
            t = i / float(sr)
            freq = f1 + (f0 - f1) * math.exp(-t * (42.0 if hard else 34.0))
            phase += math.tau * freq / sr
            env = math.exp(-t * (10.5 if hard else 13.0))
            click = math.sin(t * 2200.0) * math.exp(-t * 160.0) * (0.45 if hard else 0.22)
            sig = math.tanh((math.sin(phase) + click) * drive) * env * 0.85
            out[i] = sig
        return out

    @staticmethod
    def synth_snare(dur: float = 0.16, ghost: bool = False, sr: int = AUDIO_SR) -> List[float]:
        n = int(dur * sr)
        out = [0.0] * n
        rng = random.Random(42 if not ghost else 99)
        gain = 0.38 if ghost else 0.78
        lp = 0.0
        for i in range(n):
            t = i / float(sr)
            body = math.sin(math.tau * (195.0 - 65.0 * t) * t) * math.exp(-t * 28.0) * 0.55
            noise = rng.uniform(-1.0, 1.0)
            lp += 0.35 * (noise - lp)
            hp = noise - lp
            snap = hp * math.exp(-t * (24.0 if not ghost else 38.0)) * 0.75
            out[i] = math.tanh((body + snap) * 1.4) * gain
        return out

    @staticmethod
    def synth_hat(dur: float = 0.07, open_hat: bool = False, sr: int = AUDIO_SR) -> List[float]:
        n = int((0.18 if open_hat else dur) * sr)
        out = [0.0] * n
        rng = random.Random(101 if open_hat else 102)
        prev = 0.0
        decay = 14.0 if open_hat else 58.0
        for i in range(n):
            t = i / float(sr)
            w = rng.uniform(-1.0, 1.0)
            hp = w - prev * 0.82
            prev = w
            metal = math.sin(t * 6420.0) * 0.25 + math.sin(t * 9130.0) * 0.20
            out[i] = (hp * 0.7 + metal) * math.exp(-t * decay) * (0.34 if open_hat else 0.26)
        return out

    @staticmethod
    def synth_temple_bell(freq: float = 293.66, dur: float = 1.15, sr: int = AUDIO_SR) -> List[float]:
        """Inharmonic FM bronze temple bell & resonant singing bowl."""
        n = int(dur * sr)
        out = [0.0] * n
        ratios = (1.0, 2.01, 2.756, 4.07, 5.404)
        amps = (0.48, 0.26, 0.16, 0.10, 0.06)
        decays = (2.1, 3.2, 4.8, 6.5, 9.0)
        for i in range(n):
            t = i / float(sr)
            att = min(1.0, t * 220.0)
            fm = math.sin(math.tau * freq * 3.14 * t) * math.exp(-t * 14.0) * 1.8
            val = 0.0
            for r, a, d in zip(ratios, amps, decays):
                val += math.sin(math.tau * freq * r * t + fm * (0.5 if r > 1.5 else 1.0)) * a * math.exp(-t * d)
            out[i] = math.tanh(val * 1.25) * att * 0.72
        return out

    @staticmethod
    def synth_acid_step(freq: float, dur: float = 0.12, accent: bool = False, sr: int = AUDIO_SR) -> List[float]:
        """Resonant 2-pole SVF low-pass squelching acid 303 bass note."""
        n = int(dur * sr)
        out = [0.0] * n
        phase = 0.0
        low = 0.0
        band = 0.0
        q = 0.22 if accent else 0.36
        for i in range(n):
            t = i / float(sr)
            phase = (phase + freq / sr) % 1.0
            saw = (2.0 * phase - 1.0)
            cutoff = clamp((240.0 + (2400.0 if accent else 1150.0) * math.exp(-t * 22.0)) / sr * 6.0, 0.04, 0.92)
            low += cutoff * band
            high = saw - low - q * band
            band += cutoff * high
            env = min(1.0, t * 180.0) * math.exp(-t * 11.0)
            out[i] = math.tanh(low * (2.6 if accent else 1.8)) * env * 0.62
        return out

    @staticmethod
    def synth_trance_lead(freq: float, dur: float = 0.16, sr: int = AUDIO_SR) -> List[float]:
        """Detuned 3-oscillator hard trance supersaw lead."""
        n = int(dur * sr)
        out = [0.0] * n
        p0 = p1 = p2 = 0.0
        d0 = freq / sr
        d1 = (freq * 1.007) / sr
        d2 = (freq * 0.993) / sr
        for i in range(n):
            t = i / float(sr)
            p0 = (p0 + d0) % 1.0
            p1 = (p1 + d1) % 1.0
            p2 = (p2 + d2) % 1.0
            sig = ((2.0 * p0 - 1.0) + (2.0 * p1 - 1.0) + (2.0 * p2 - 1.0)) * 0.33
            env = min(1.0, t * 140.0) * math.exp(-t * 8.5)
            out[i] = math.tanh(sig * 1.6) * env * 0.42
        return out


class ProceduralAudioEngine:
    """
