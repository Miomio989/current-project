    _EDIT_TOOL_PAGES = {
        EditCanvas.TOOL_NAV: 0,
        EditCanvas.TOOL_BRUSH: 1,
        EditCanvas.TOOL_ERASE: 1,
        EditCanvas.TOOL_PAINT: 2,
        EditCanvas.TOOL_POLY: 3,
        EditCanvas.TOOL_CROP: 4,
        EditCanvas.TOOL_ROTATE: 5,
        EditCanvas.TOOL_FLARE: 6,
    }

    def _set_edit_tool(self, tool: str) -> None:
        self.edit_canvas.set_tool(tool)
        btn = self.edit_tool_btns.get(tool)
        if btn is not None:
            btn.setChecked(True)
        if hasattr(self, "edit_ctx_stack"):
            self.edit_ctx_stack.setCurrentIndex(self._EDIT_TOOL_PAGES.get(tool, 0))
        if tool == EditCanvas.TOOL_PAINT:
            # the retouch page owns the ring size while it is active
            self.edit_canvas.set_paint_brush(float(self.edit_paint_size.value()),
                                             float(self.edit_paint_soft.value()),
                                             int(self.edit_paint_opacity.value()))
            self._sync_paint_swatch()
            self.edit_paint_erase_btn.blockSignals(True)
            self.edit_paint_erase_btn.setChecked(self.edit_canvas.paint_erase())
            self.edit_paint_erase_btn.blockSignals(False)
            self.edit_paint_erase_btn.setText("ERASING" if self.edit_canvas.paint_erase() else "ERASER")
        elif tool in (EditCanvas.TOOL_BRUSH, EditCanvas.TOOL_ERASE):
            self.edit_canvas.set_brush(float(self.edit_brush_size.value()),
                                       float(self.edit_brush_soft.value()))
        if tool == EditCanvas.TOOL_POLY:
            sm, fe, ex = self.edit_canvas.poly_params()
            self.edit_poly_smooth_btn.blockSignals(True)
            self.edit_poly_smooth_btn.setChecked(sm)
            self.edit_poly_smooth_btn.blockSignals(False)
            self.edit_poly_feather_sl.blockSignals(True)
            self.edit_poly_feather_sl.setValue(int(fe))
            self.edit_poly_feather_sl.blockSignals(False)
            self._sync_poly_labels()
        self._on_edit_crop_changed()

    def _nudge_brush(self, delta: int) -> None:
        """[ / ] adjust whichever brush is active (mask or retouch paint)."""
        if self.edit_canvas._tool == EditCanvas.TOOL_PAINT:
            self.edit_paint_size.setValue(max(2, min(400, self.edit_paint_size.value() + delta)))
        else:
            self.edit_brush_size.setValue(max(4, min(400, self.edit_brush_size.value() + delta)))

    def _on_edit_brush_changed(self) -> None:
        if hasattr(self, "edit_brush_size"):
