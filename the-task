# ---- templates -------------------------------------------------------------
def _norm_ws(text: str) -> str:
    lines = [" ".join(ln.split()) for ln in (text or "").splitlines()]
    return " ".join(ln for ln in lines if ln).strip()


def parse_templates(path: str) -> List[Dict[str, str]]:
    """Parse an XML template file. Only first-level blocks are listed; nested
    tags stay inside the template body verbatim."""
    text = read_text(path)
    if not text.strip():
        return []
    root = None
    for candidate in (text, "<templates>" + text + "</templates>"):
        try:
            root = ET.fromstring(candidate)
            break
        except ET.ParseError:
            continue
    if root is None:
        return _parse_templates_loose(text)
    container_tags = {"templates", "root", "prompts", "list", "presets", "items"}
    if root.tag.lower() in container_tags or (not (root.text or "").strip() and len(root) > 0):
        items = list(root)
    else:
        items = [root]
    out: List[Dict[str, str]] = []
    for el in items:
        body = (el.text or "") + "".join(xml_unescape(ET.tostring(sub, encoding="unicode")) for sub in el)
        name = el.attrib.get("name") or el.attrib.get("title") or el.attrib.get("id") or el.tag
        body = _norm_ws(body)
        if body:
            out.append({"name": name.strip(), "body": body})
    return out


def _parse_templates_loose(text: str) -> List[Dict[str, str]]:
    out = []
    for m in re.finditer(r"<(\w+)([^>]*)>(.*?)</\1>", text, flags=re.S):
        attrs = m.group(2)
        nm = re.search(r'name\s*=\s*"([^"]*)"', attrs)
        out.append({"name": (nm.group(1) if nm else m.group(1)).strip(), "body": _norm_ws(m.group(3))})
    return out


def apply_template(body: str, prompt: str) -> str:
    if not body:
        return prompt
    if "{{insert}}" in body:
        return body.replace("{{insert}}", prompt.strip())
    return (body.strip() + ", " + prompt.strip()).strip(", ")


def append_template(path: str, name: str, body: str) -> bool:
    text = read_text(path).rstrip()
    safe_name = name.replace('"', "'")
    block = f'  <template name="{safe_name}">\n    {body.strip()}\n  </template>\n'
    if "</templates>" in text:
        text = text.replace("</templates>", block + "</templates>")
    else:
        text = "<templates>\n" + (text + "\n" if text else "") + block + "</templates>"
    return write_text(path, text + "\n")


def templates_to_xml(templates: List[Dict[str, str]]) -> str:
    """Serialize a template list back into the XML file format. Bodies are
    fully XML-escaped, so prompts may freely contain '&', '<' or nested tag
    markers like <mood>...</mood>; parse_templates() decodes them back to the
    exact same string (nested tags arrive as literal text)."""
    out = ["<templates>"]
    for t in templates:
        # the name lives in an XML attribute: escape it too, so names with &
        # or < keep the file well-formed (parse_templates decodes them back)
        safe_name = xml_escape((t.get("name") or "Template").replace('"', "'"))
        body = " ".join((t.get("body") or "").split())
        out.append(f'  <template name="{safe_name}">')
        out.append("    " + xml_escape(body))
        out.append("  </template>")
    out.append("</templates>")
    return "\n".join(out) + "\n"


def save_templates_file(path: str, templates: List[Dict[str, str]]) -> bool:
    return write_text(path, templates_to_xml(templates))


# ---- tag groups (foldered) -------------------------------------------------
def parse_tag_groups(path: str) -> Tuple[List[str], Dict[str, List[Dict[str, str]]]]:
    """Parse tag_groups.txt into (ordered folder names, folder -> group list).
    A line like [Artists] opens a folder; groups before any header land in
    the implicit "General" folder (so old flat files keep working)."""
    folders: List[str] = []
    groups: Dict[str, List[Dict[str, str]]] = {}
    current = "General"
    for raw in read_text(path).splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]") and len(line) > 2:
            current = line[1:-1].strip() or "General"
            if current not in groups:
                groups[current] = []
                folders.append(current)
            continue
        if "|" in line:
            label, body = line.split("|", 1)
            label, body = label.strip(), body.strip()
        else:
            label = body = line
        if body:
            groups.setdefault(current, []).append({"label": label or body, "text": body, "folder": current})
    if "General" in groups and "General" not in folders:
        folders.insert(0, "General")
    if not folders:
        folders, groups = ["General"], {"General": []}
    return folders, groups


def append_tag_group(path: str, label: str, body: str, folder: str = "General") -> bool:
    """Append one group under its folder section, creating the section when
    missing and inserting into the right place when it already exists."""
    text = read_text(path)
    if text and not text.endswith("\n"):
        text += "\n"
    line = f"{label.strip()} | {body.strip()}\n"
    lines = text.splitlines(keepends=True)

    def is_header(s: str) -> bool:
        s = s.strip()
        return s.startswith("[") and s.endswith("]") and len(s) > 2

    def insert_at(idx: int) -> str:
        lines.insert(idx, line)
        return "".join(lines)

    if not folder or folder == "General":
        # the implicit General section lives at the top, before any [Folder]
        # header - insert after the last group line above the first header.
        first_header = next((i for i, ln in enumerate(lines) if is_header(ln)), None)
        if first_header is None:
            return write_text(path, text + line)
        insert = first_header
        for i in range(first_header - 1, -1, -1):
            s = lines[i].strip()
            if s and not s.startswith("#"):
                insert = i + 1
                break
        else:
            insert = first_header          # only comments so far
        return write_text(path, insert_at(insert))

    header = f"[{folder.strip()}]"
    if not any(ln.strip() == header for ln in lines):
        return write_text(path, text + f"\n{header}\n{line}")
    start = max(i for i, ln in enumerate(lines) if ln.strip() == header)
    end = start + 1
    while end < len(lines):
        s = lines[end].strip()
        if is_header(s):
            break
        end += 1
    return write_text(path, insert_at(end))


def tags_to_text(folders: List[str], groups: "Dict[str, List[Dict[str, str]]]") -> str:
    """Serialize folders + groups back into the tag_groups.txt format. The
    'General' folder is written as an explicit section header so hand edits
    and the app agree on where its groups live."""
    out = ["# Tag groups - one per line.  Format:  Label | text appended to the prompt",
           "# Managed by the Horde Studio Lite tag editor; hand edits are welcome too.",
           "# A line like [Artists] starts a folder; every group below it belongs to it."]
    for folder in folders:
        out.append("")
        out.append(f"[{folder}]")
        rows = groups.get(folder) or []
        if not rows:
            out.append("# (empty folder)")
        for g in rows:
            label = " ".join((g.get("label") or "").split()).replace("|", "/")
            body = " ".join((g.get("text") or "").split())
            if not body:
                continue
            out.append(f"{label or body} | {body}" if label and label != body else body)
    return "\n".join(out).rstrip() + "\n"


def save_tags_file(path: str, folders: List[str],
                   groups: "Dict[str, List[Dict[str, str]]]") -> bool:
    return write_text(path, tags_to_text(folders, groups))


def append_to_prompt(current: str, addition: str) -> str:
    cur = current.rstrip()
    add = addition.strip()
    if not cur:
        return add
    if cur.endswith(",") or cur.endswith("."):
        return cur + " " + add
    return cur + ", " + add


def append_to_prompt_pos(current: str, addition: str) -> Tuple[str, int]:
    """append_to_prompt, also returning the character position where the
    addition starts (used to register the coloured span in the editor)."""
    cur = current.rstrip()
    add = addition.strip()
    if not cur:
        return add, 0
    if cur.endswith(",") or cur.endswith("."):
        return cur + " " + add, len(cur) + 1
    return cur + ", " + add, len(cur) + 2


# ---- wildcards (dynamicprompts + built-in fallback + tag-group folders) ----
_WILDCARD_SYNTAX = re.compile(r"__[^_\s][^\n]*?__|\{[^{}\n]*\|[^{}\n]*\}")
# __[Folder]__ refers to a folder of tag groups (tag_groups.txt): every
# expansion picks one RANDOM group from that folder.
_FOLDER_WILDCARD_RE = re.compile(r"__\[([^\[\]\n]+?)\]__")
# {a|b|c} variant list for the built-in fallback (no nesting)
_VARIANT_RE = re.compile(r"\{([^{}\n|]*(?:\|[^{}\n|]*)*)\}")


def has_wildcard_syntax(text: str) -> bool:
    """True when the text contains __wildcard__ references (including
    __[Folder]__ tag-group references) or {a|b} variants."""
    if not text:
        return False
    return bool(_WILDCARD_SYNTAX.search(text) or _FOLDER_WILDCARD_RE.search(text))


def expand_folder_wildcards(text: str,
                            groups: Optional[Dict[str, List[Dict[str, Any]]]]) -> str:
    """Replace every __[Folder]__ token with a random tag group from that
    folder of tag_groups.txt. Unknown or empty folders keep the token visible
    (the preview then shows the unresolved reference)."""
    if not text or not groups or not _FOLDER_WILDCARD_RE.search(text):
        return text

    def folder_items(name: str) -> Optional[List[Dict[str, Any]]]:
        if name in groups and groups[name]:
            return groups[name]
        for k, v in groups.items():          # case-insensitive fallback
            if k.lower() == name.lower() and v:
                return v
        return None

    def repl(m: "re.Match[str]") -> str:
        items = folder_items(m.group(1).strip())
        if not items:
            return m.group(0)
        picked = str(random.choice(items).get("text", "")).strip()
        return picked or m.group(0)

    return _FOLDER_WILDCARD_RE.sub(repl, text)


def _builtin_expand(text: str) -> str:
    """Fallback wildcard resolver used when the dynamicprompts package is not
    installed: {a|b} variants, __wildcard__ files and __[Folder]__ references
    (folders are resolved before this is called) keep working without it."""
    if not text or not has_wildcard_syntax(text):
        return text

    def var_repl(m: "re.Match[str]") -> str:
        parts = [p.strip() for p in m.group(1).split("|") if p.strip()]
        return random.choice(parts) if parts else m.group(0)

    text = _VARIANT_RE.sub(var_repl, text)

    def file_repl(m: "re.Match[str]") -> str:
        name = m.group(1)
        if name.startswith("["):            # unresolved folder reference
            return m.group(0)
        path = os.path.join(WILDCARDS_DIR, name + ".txt")
        if not os.path.exists(path):
            return m.group(0)
        lines = [ln.strip() for ln in read_text(path).splitlines()
                 if ln.strip() and not ln.strip().startswith("#")]
        return random.choice(lines) if lines else m.group(0)

    return re.sub(r"__([^_\s][^\n]*?)__", file_repl, text)


def expand_wildcards(text: str,
                     tag_groups: Optional[Dict[str, List[Dict[str, Any]]]] = None) -> str:
    """Resolve __[Folder]__ tag-group references, __wildcard__ entries (files
    in ./wildcards) and {a|b} variants. Folder references always use the
    built-in resolver; the rest goes through dynamicprompts when installed and
    through a small built-in fallback otherwise. Returns the original text
    unchanged when nothing could be resolved."""
    if not text:
        return text
    if tag_groups:
        text = expand_folder_wildcards(text, tag_groups)
    if not text.strip():
        return text
    if _HAS_DYNAMICPROMPTS and has_wildcard_syntax(text):
        try:
            wm = WildcardManager(WILDCARDS_DIR)
            gen = RandomPromptGenerator(wildcard_manager=wm)
            out = gen.generate(text, 1)
            if out:
                expanded = " ".join(out[0].split())
                if expanded:
                    return expanded
        except Exception:  # noqa: BLE001 - any parser error falls back to raw text
            pass
        return text
    if not _HAS_DYNAMICPROMPTS:
        return _builtin_expand(text)
    return text


# ---- LLM API (OpenAI-compatible endpoints, LLM tab) --------------------------
class LlmError(Exception):
    """Raised for any LLM endpoint problem (network, HTTP, bad payload)."""

    def __init__(self, message: str):
        super().__init__(message)
        self.message = message


def _llm_headers(api_key: str) -> Dict[str, str]:
    h = {"Content-Type": "application/json"}
    if api_key:
        h["Authorization"] = f"Bearer {api_key}"
    return h


def _llm_request(method: str, url: str, api_key: str,
                 body: Optional[Dict[str, Any]], timeout: float) -> Dict[str, Any]:
    headers = _llm_headers(api_key)
    if _HAS_REQUESTS:
        try:
            resp = requests.request(method, url, headers=headers, json=body, timeout=timeout)
        except requests.RequestException as exc:
            raise LlmError(f"network: {exc}") from exc
        try:
            payload = resp.json()
        except ValueError:
            payload = None
        if resp.status_code >= 400:
            detail = ""
            if isinstance(payload, dict):
                err = payload.get("error")
                if isinstance(err, dict):
                    detail = str(err.get("message") or "")
                elif err:
                    detail = str(err)
                if not detail:
                    detail = json.dumps(payload)[:200]
            raise LlmError(f"HTTP {resp.status_code}: {detail or resp.text[:200]}")
        if not isinstance(payload, dict):
            raise LlmError("unexpected response (not a JSON object)")
        return payload
    data = json.dumps(body).encode("utf-8") if body is not None else None
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as fh:
            raw, code = fh.read(), fh.status
    except urllib.error.HTTPError as exc:
        try:
            detail = exc.read().decode("utf-8", "replace")[:200]
        except Exception:  # noqa: BLE001
            detail = ""
        raise LlmError(f"HTTP {exc.code}: {detail}") from exc
    except urllib.error.URLError as exc:
        raise LlmError(f"network: {exc.reason}") from exc
    if code >= 400:
        raise LlmError(f"HTTP {code}")
    payload = json.loads(raw.decode("utf-8", "replace"))
    if not isinstance(payload, dict):
        raise LlmError("unexpected response (not a JSON object)")
    return payload


def llm_list_models(base_url: str, api_key: str, timeout: float = 30.0) -> List[str]:
    """GET {base}/models and return the sorted model id list."""
    payload = _llm_request("GET", f"{base_url.rstrip('/')}/models", api_key, None, timeout)
    data = payload.get("data")
    out: List[str] = []
    if isinstance(data, list):
        for item in data:
            mid = item.get("id") if isinstance(item, dict) else None
            if isinstance(mid, str) and mid:
                out.append(mid)
    return sorted(set(out))


def llm_chat(base_url: str, api_key: str, model: str, system: str, user: str,
             temperature: float, top_p: float, timeout: float = 240.0) -> str:
    """POST {base}/chat/completions and return the assistant message text."""
    messages: List[Dict[str, str]] = []
    if system:
        messages.append({"role": "system", "content": system})
    messages.append({"role": "user", "content": user})
    body = {"model": model, "messages": messages, "stream": False,
            "temperature": round(float(temperature), 3), "top_p": round(float(top_p), 3)}
    payload = _llm_request("POST", f"{base_url.rstrip('/')}/chat/completions", api_key, body, timeout)
    choices = payload.get("choices")
    if isinstance(choices, list) and choices:
        first = choices[0] if isinstance(choices[0], dict) else {}
        msg = first.get("message") if isinstance(first.get("message"), dict) else {}
        content = msg.get("content")
        if isinstance(content, list):  # content-part arrays some servers emit
            content = "".join(p.get("text", "") for p in content if isinstance(p, dict))
        if isinstance(content, str) and content.strip():
            return content
    raise LlmError("the reply carries no message content")


def _strip_code_fences(t: str) -> str:
    t = re.sub(r"^```[\w-]*[^\S\n]*\n?", "", (t or "").strip())
    t = re.sub(r"\n?```\s*$", "", t)
    return t.strip()


def llm_extract_prompts(text: str) -> List[str]:
    """Extract every <prompt>...</prompt> block from an LLM reply (whitespace
    collapsed, code fences stripped). When the reply used no blocks at all,
    the whole (fence-stripped) reply is returned as a single entry so nothing
    is silently lost."""
    out: List[str] = []
    for m in re.finditer(r"<prompt[^>]*>(.*?)</prompt>", text or "", flags=re.S | re.I):
        t = _strip_code_fences(" ".join(m.group(1).split()))
        if t:
            out.append(t)
    if not out:
        whole = _strip_code_fences(" ".join((text or "").split()))
        if whole:
            out.append(whole)
    return out


def llm_reply_has_blocks(text: str) -> bool:
    return bool(re.search(r"<prompt[^>]*>", text or "", flags=re.I))


# ---- image metadata ----------------------------------------------------------
def build_parameters_text(meta: Dict[str, Any]) -> str:
    """A1111-compatible 'parameters' text so other tools can read the prompt too."""
    lines = [meta.get("prompt", "")]
    if meta.get("negative"):
        lines.append("Negative prompt: " + meta["negative"])
    bits = [
        f"Steps: {meta.get('steps')}", f"Sampler: {meta.get('sampler')}",
        f"Schedule type: {meta.get('scheduler')}", f"CFG scale: {meta.get('cfg')}",
        f"Seed: {meta.get('seed')}", f"Size: {meta.get('width')}x{meta.get('height')}",
        f"Model: {meta.get('model')}",
    ]
    if meta.get("clip_skip"):
        bits.append(f"CLIP skip: {meta.get('clip_skip')}")
    if meta.get("loras"):
        bits.append("LoRAs: " + ", ".join(f"{l.get('name')}:{l.get('model')}" for l in meta["loras"]))
    if meta.get("aesthetic") is not None:
        bits.append(f"Aesthetic score: {float(meta['aesthetic']):.2f}")
    lines.append(", ".join(bits))
    return "\n".join(lines)


def write_image_with_metadata(data: bytes, path: str, meta: Dict[str, Any]) -> str:
    """Decode the WebP returned by the Horde and store it as PNG with embedded
    tEXt chunks ('parameters' + 'horde_studio_lite' JSON). Returns the final path."""
    img = QImage.fromData(QByteArray(data))
    final = path
    if img.isNull():
        # WebP plugin missing: keep raw bytes, metadata lives in the sidecar.
        final = os.path.splitext(path)[0] + ".webp"
        with open(final, "wb") as fh:
            fh.write(data)
    else:
        img.setText("parameters", build_parameters_text(meta))
        img.setText("horde_studio_lite", json.dumps(meta, ensure_ascii=False))
        img.setText("Software", f"{APP_NAME} {APP_VERSION}")
        if not img.save(final, "PNG"):
            final = os.path.splitext(path)[0] + ".webp"
            with open(final, "wb") as fh:
                fh.write(data)
    try:
        with open(os.path.splitext(final)[0] + ".json", "w", encoding="utf-8") as fh:
            json.dump(meta, fh, indent=1, ensure_ascii=False)
    except OSError:
        pass
    return final


def read_image_metadata(path: str) -> Dict[str, Any]:
    reader = QImageReader(path)
    txt = reader.text("horde_studio_lite")
    if txt:
        try:
            return json.loads(txt)
        except ValueError:
            pass
    side = os.path.splitext(path)[0] + ".json"
    if os.path.exists(side):
        try:
            with open(side, "r", encoding="utf-8") as fh:
                return json.load(fh)
        except (OSError, ValueError):
            pass
    params = reader.text("parameters")
    if params:
        return _parse_parameters_text(params)
    return {}


def update_image_metadata(path: str, patch: Dict[str, Any]) -> Dict[str, Any]:
    """Merge `patch` into the metadata stored beside/in the image file.
    Re-embeds the tEXt chunks when the file can be decoded, and always
    rewrites the sidecar JSON. Returns the updated metadata dict."""
    meta = read_image_metadata(path)
    meta.update(patch)
    img = QImage(path)
    if not img.isNull() and path.lower().endswith(".png"):
        img.setText("parameters", build_parameters_text(meta))
        img.setText("horde_studio_lite", json.dumps(meta, ensure_ascii=False))
        img.setText("Software", f"{APP_NAME} {APP_VERSION}")
        img.save(path, "PNG")
    try:
        with open(os.path.splitext(path)[0] + ".json", "w", encoding="utf-8") as fh:
            json.dump(meta, fh, indent=1, ensure_ascii=False)
    except OSError:
        pass
    return meta


def image_to_png_bytes(img: QImage) -> bytes:
    """Encode a QImage to in-memory PNG bytes."""
    buf = QBuffer()
    buf.open(QBuffer.OpenModeFlag.WriteOnly)
    img.save(buf, "PNG")
    return bytes(buf.data())


def hq_resize(img: QImage, w: int, h: int) -> QImage:
    """High-quality resize used by the tile-upscale pipeline (non-neural
    resizes). Prefers a true Lanczos filter through Pillow; when Pillow is
    missing it falls back to Qt's smooth transform (bilinear). Never enlarges
    the colour space: opaque ARGB in, opaque ARGB out."""
    w, h = max(1, int(w)), max(1, int(h))
    if img.isNull():
        return QImage()
    if img.width() == w and img.height() == h:
        return img
    if _HAS_PIL:
        try:
            src = img.convertToFormat(QImage.Format.Format_ARGB32)
            # QImage ARGB32 stores BGRA in memory (little-endian); PIL's raw
            # decoder/encoder handles the swap transparently. 32-bit formats
            # are always tightly packed (bytesPerLine == width * 4).
            raw = src.constBits()
            raw = bytes(raw) if not isinstance(raw, (bytes, bytearray)) else bytes(raw)
            pil = _PILImage.frombytes("RGBA", (src.width(), src.height()), raw, "raw", "BGRA")
            pil = pil.resize((w, h), _PILImage.Resampling.LANCZOS)
            out = QImage(pil.tobytes("raw", "BGRA"), w, h, w * 4,
                         QImage.Format.Format_ARGB32)
            if not out.isNull():
                return out.copy()          # detach from the temporary buffer
        except Exception:  # noqa: BLE001 - any PIL hiccup falls back to Qt
            pass
    return img.scaled(w, h, Qt.AspectRatioMode.IgnoreAspectRatio,
                      Qt.TransformationMode.SmoothTransformation)


def is_black_placeholder_frame(data: bytes, dark_luma: int = 12,
                               dark_ratio: float = 0.97) -> bool:
    """True when the decoded frame is (almost) uniformly near-black - the
    shape of the Horde worker's NSFW-censor placeholder (a black image,
    sometimes with a few percent of small white text). Used as the fallback
    detector for censored img2img tiles whose per-generation `censored` flag
    was not set (older workers). A real tile refine of a detailed picture
    never reaches 97% pure-dark pixels even in night scenes, and the
    consequence of a rare false positive is graceful: the tile keeps the
    neural base instead of blending black over the result."""
    img = QImage.fromData(QByteArray(data))
    if img.isNull() or img.width() < 8 or img.height() < 8:
        return False
    small = img.scaled(64, 64, Qt.AspectRatioMode.IgnoreAspectRatio,
                       Qt.TransformationMode.FastTransformation)
    total = dark = 0
    for y in range(small.height()):
        for x in range(small.width()):
            c = small.pixelColor(x, y)
            total += 1
            if (c.red() * 299 + c.green() * 587 + c.blue() * 114) // 1000 < dark_luma:
                dark += 1
    return total > 0 and (dark / total) >= dark_ratio


def _parse_parameters_text(text: str) -> Dict[str, Any]:
    meta: Dict[str, Any] = {}
    lines = text.splitlines()
    if not lines:
        return meta
    prompt_lines, rest = [], []
    for ln in lines:
        if ln.startswith("Negative prompt:"):
            meta["negative"] = ln[len("Negative prompt:"):].strip()
        elif re.match(r"^Steps:\s*\d+", ln):
            rest.append(ln)
        elif "negative" not in meta and not rest:
            prompt_lines.append(ln)
    meta["prompt"] = "\n".join(prompt_lines).strip()
    for ln in rest:
        for key, val in re.findall(r"([A-Za-z ]+):\s*([^,]+)", ln):
            k = key.strip().lower()
            v = val.strip()
            if k == "seed":
                meta["seed"] = v
            elif k == "size" and "x" in v:
                w, h = v.split("x", 1)
                meta["width"], meta["height"] = int(w), int(h)
            elif k == "model":
                meta["model"] = v
    return meta


# =============================================================================
#  Browser bridge: local server the Tampermonkey userscript connects to.
#  Every Horde API request can be tunnelled through the user's browser, so
#  any VPN extension active in that browser applies to it. Pure stdlib - no
#  Qt objects live in here (called from worker threads only).
# =============================================================================
class BridgeError(Exception):
    """Raised when the bridge cannot serve a request (no client, timeout...)."""

    def __init__(self, message: str, network: bool = False):
        super().__init__(message)
        self.message = message
        self.network = network      # True -> HordeAPI may retry the call


class _BridgeRequest:
    """One HTTP request waiting to be executed inside the browser."""

    __slots__ = ("id", "method", "url", "headers", "body", "deadline",
                 "done", "status", "resp_headers", "data", "error", "created")

    def __init__(self, method: str, url: str, headers: Dict[str, str],
                 body: Optional[bytes], timeout: float):
        self.id = secrets.token_hex(8)
        self.method = method.upper()
        self.url = url
        self.headers = dict(headers or {})
        self.body = body
        self.deadline = time.time() + min(300.0, timeout + 25.0)
        self.done = threading.Event()
        self.status = 0
        self.resp_headers: Dict[str, str] = {}
        self.data = b""
        self.error = ""
        self.created = time.time()

    def payload(self) -> Dict[str, Any]:
        return {
            "id": self.id, "method": self.method, "url": self.url,
            "headers": self.headers,
            "body_b64": base64.b64encode(self.body).decode("ascii") if self.body else "",
            "timeout_ms": int(max(1000.0, self.deadline - time.time()) * 1000),
        }


class _BridgeHandler(BaseHTTPRequestHandler):
    server_version = "HSLBridge/1.6"
    protocol_version = "HTTP/1.1"

    @property
    def bridge(self) -> "BrowserBridge":
        return self.server.bridge  # type: ignore[attr-defined]

    def log_message(self, fmt, *args) -> None:  # noqa: N802 - stay quiet
        pass

    # --- plumbing -----------------------------------------------------------
    def _cors(self) -> None:
        # Allow use from the https horde page (Private Network Access preflight
        # for the plain fetch fallback inside the userscript).
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, X-Bridge-Token")
        self.send_header("Access-Control-Allow-Private-Network", "true")

    def _send_json(self, code: int, obj: Dict[str, Any], close: bool = False) -> None:
        data = json.dumps(obj).encode("utf-8")
        try:
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            if close:
                self.send_header("Connection", "close")
                self.close_connection = True
            self._cors()
            self.end_headers()
            self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError):
            self.close_connection = True

    def _token_ok(self) -> bool:
        tok = self.headers.get("X-Bridge-Token") or ""
        if not tok:
            q = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query).get("token", [""])
            tok = q[0] if q else ""
        return secrets.compare_digest(tok, self.bridge.token)

    def _read_body(self, cap: int) -> Optional[bytes]:
        """Read the request body, honouring the cap. None = too large."""
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            n = 0
        if n <= 0:
            return b""
        if n > cap:
            # drain nothing - the caller closes the connection
            return None
        return self.rfile.read(n)

    # --- endpoints ------------------------------------------------------------
    def do_OPTIONS(self) -> None:  # noqa: N802
        self.send_response(204)
        self.send_header("Content-Length", "0")
        self._cors()
        self.end_headers()

    def do_GET(self) -> None:  # noqa: N802
        path = urllib.parse.urlsplit(self.path).path
        if not self._token_ok():
            self._send_json(401, {"error": "bad or missing bridge token",
                                  "hint": "copy the token from the HORDE tab into the userscript panel"})
            return
        if path == "/status":
            b = self.bridge
            self._send_json(200, {"app": f"{APP_NAME} {APP_VERSION}",
                                  "connected": b.is_connected(), "served": b.served,
                                  "client": b.client_label()})
            return
        if path == "/poll":
            self._do_poll()
            return
        self._send_json(404, {"error": "unknown endpoint"})

    def _do_poll(self) -> None:
        b = self.bridge
        q = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
        try:
            wait = min(30.0, max(1.0, float(q.get("timeout", ["25"])[0])))
        except (ValueError, IndexError):
            wait = BRIDGE_POLL_SECS
        b._poll_started(self.headers.get("User-Agent", ""))
        job: Optional[_BridgeRequest] = None
        try:
            deadline = time.time() + wait
            with b._cond:
                while True:
                    if b._queue:
                        job = b._queue.popleft()
                        break
                    remaining = deadline - time.time()
                    if remaining <= 0:
                        break
                    b._cond.wait(remaining)
            if job is None:
                self._send_json(200, {"job": None})
            else:
                self._send_json(200, {"job": job.payload()})
        except (BrokenPipeError, ConnectionResetError):
            # the tab vanished mid-poll: push an unsent job back to the front
            if job is not None:
                with b._cond:
                    try:
                        b._queue.appendleft(job)
                    except Exception:  # noqa: BLE001
                        pass
        finally:
            b._poll_ended()

    def do_POST(self) -> None:  # noqa: N802
        path = urllib.parse.urlsplit(self.path).path
        body = self._read_body(BRIDGE_BODY_CAP)
        if body is None:
            self._send_json(413, {"error": "reply too large"}, close=True)
            return
        if not self._token_ok():
            self._send_json(401, {"error": "bad or missing bridge token"})
            return
        if path != "/reply":
            self._send_json(404, {"error": "unknown endpoint"})
            return
        try:
            doc = json.loads(body.decode("utf-8") or "{}")
        except ValueError:
            self._send_json(400, {"error": "bad json"})
            return
        self._send_json(200 if self.bridge._deliver(doc) else 404, {"ok": True})


class BrowserBridge:
    """Local long-poll HTTP server (127.0.0.1 only) the Tampermonkey
    userscript talks to. The browser polls /poll, receives one queued Horde
    request, executes it through its own network stack (VPN extensions apply)
    and posts the result back to /reply."""

    def __init__(self, port: int, token: str):
        self.port = int(port)
        self.token = token or secrets.token_hex(8)
        self._cond = threading.Condition()
        self._queue: "collections.deque[_BridgeRequest]" = collections.deque()
        self._waiters: Dict[str, _BridgeRequest] = {}
        self._active_polls = 0
        self._last_poll = 0.0
        self._client = ""
        self._served = 0
        self._httpd: Optional[ThreadingHTTPServer] = None
        self._thread: Optional[threading.Thread] = None
        self.running = False
        self.last_error = ""

    # --- lifecycle ------------------------------------------------------------
    def start(self) -> bool:
        if self.running:
            return True
        try:
            httpd = ThreadingHTTPServer(("127.0.0.1", self.port), _BridgeHandler)
        except OSError as exc:
            self.last_error = str(exc)
            self.running = False
            return False
        httpd.daemon_threads = True
        httpd.bridge = self  # type: ignore[attr-defined]
        self._httpd = httpd
        self.running = True
        self._thread = threading.Thread(target=httpd.serve_forever, name="bridge-http", daemon=True)
        self._thread.start()
        return True

    def stop(self) -> None:
        self.running = False
        httpd, self._httpd = self._httpd, None
        if httpd is not None:
            try:
                httpd.shutdown()
                httpd.server_close()
            except Exception:  # noqa: BLE001
                pass
        self._thread = None
        with self._cond:
            for job in list(self._waiters.values()):
                job.error = "bridge stopped"
                job.done.set()
            self._waiters.clear()
            self._queue.clear()
            self._cond.notify_all()

    # --- client bookkeeping (called from HTTP threads) -------------------------
    def _poll_started(self, label: str) -> None:
        with self._cond:
            self._active_polls += 1
            self._last_poll = time.time()
            if label:
                self._client = label

    def _poll_ended(self) -> None:
        with self._cond:
            self._active_polls = max(0, self._active_polls - 1)

    def _deliver(self, doc: Dict[str, Any]) -> bool:
        rid = str(doc.get("id") or "")
        with self._cond:
            job = self._waiters.pop(rid, None)
            if job is None:
                return False
            err = doc.get("error")
            if err:
                job.error = str(err)
            else:
                try:
                    job.status = int(doc.get("status") or 0)
                    b64 = str(doc.get("data_b64") or "")
                    job.data = base64.b64decode(b64) if b64 else b""
                    job.resp_headers = {str(k): str(v) for k, v in (doc.get("headers") or {}).items()}
                    if job.status <= 0:
                        job.error = "browser returned no status"
                except (ValueError, TypeError) as exc:
                    job.error = f"bad reply payload: {exc}"
            self._served += 1
            job.done.set()
            return True

    # --- API used by HordeAPI (worker threads) ---------------------------------
    def is_connected(self) -> bool:
        with self._cond:
            return self._active_polls > 0 or (time.time() - self._last_poll) < BRIDGE_CLIENT_TIMEOUT

    def client_label(self) -> str:
        with self._cond:
            return self._client

    @property
    def served(self) -> int:
        with self._cond:
            return self._served

    def request(self, method: str, url: str, headers: Dict[str, str],
                body: Optional[bytes], timeout: float) -> Tuple[int, Dict[str, str], bytes]:
        """Execute one HTTP request inside the connected browser and block
        until the reply arrives. Raises BridgeError on any failure."""
        if not self.running:
            raise BridgeError("browser bridge server is not running", network=True)
        if not self.is_connected():
            # short grace period: a userscript that just started (or a tab
            # that is reconnecting) shows up within a second or two
            deadline = time.time() + 1.5
            while time.time() < deadline:
                if not self.running:
                    raise BridgeError("browser bridge server is not running", network=True)
                if self.is_connected():
                    break
                time.sleep(0.1)
            else:
                raise BridgeError(
                    "browser bridge: no browser tab connected - open the Horde API page "
                    "(stablehorde.net/api/) with the userscript and check its token",
                    network=False)
        job = _BridgeRequest(method, url, headers, body, timeout)
        with self._cond:
            self._queue.append(job)
            self._waiters[job.id] = job
            self._cond.notify_all()
        if not job.done.wait(min(300.0, timeout + 25.0)):
            with self._cond:
                self._waiters.pop(job.id, None)
                try:
                    self._queue.remove(job)
                except ValueError:
                    pass
            raise BridgeError(
                f"browser bridge: no reply within {timeout + 25:.0f}s for "
                f"{method} {urllib.parse.urlsplit(url).netloc}", network=True)
        if job.error:
            raise BridgeError(f"browser bridge: {job.error}", network=True)
        return job.status, job.resp_headers, job.data


# =============================================================================
#  Local server for SillyTavern: A1111-compatible /sdapi/v1 image generation.
#  Only the prompt is taken from the request; everything else sticks to this
#  app's current settings (active model, size, options).
# =============================================================================
class LocalStServer:
    """A tiny Automatic1111-compatible HTTP server (127.0.0.1 only) so
    SillyTavern's Image Generation panel (source: "Stable Diffusion WebUI")
    can generate through the Horde. GET endpoints answer from `state_fn`;
    POST /sdapi/v1/txt2img|img2img hands the prompt to `submit_fn`, which
    blocks until the app's queue has finished the request."""

    def __init__(self, port: int,
                 state_fn: Callable[[], Dict[str, Any]],
                 submit_fn: Callable[[str], Dict[str, Any]],
                 log_fn: Optional[Callable[[str], None]] = None):
        self.port = int(port)
        self.state_fn = state_fn
        self.submit_fn = submit_fn
        self.log_fn = log_fn
        self.running = False
        self.last_error = ""
        self.last_request = ""       # short status line for the UI
        self._httpd: Optional[ThreadingHTTPServer] = None
        self._thread: Optional[threading.Thread] = None
        self._lock = threading.Lock()

    def _note(self, text: str) -> None:
        with self._lock:
            self.last_request = text
        if self.log_fn is not None:
            try:
                self.log_fn(text)
            except Exception:  # noqa: BLE001
                pass

    def start(self) -> bool:
        if self.running:
            return True
        try:
            httpd = ThreadingHTTPServer(("127.0.0.1", self.port), _StHandler)
        except OSError as exc:
            self.last_error = str(exc)
            self.running = False
            return False
        httpd.daemon_threads = True
        httpd.st = self  # type: ignore[attr-defined]
        self._httpd = httpd
        self.running = True
        self._thread = threading.Thread(target=httpd.serve_forever, name="st-server", daemon=True)
        self._thread.start()
        return True

    def stop(self) -> None:
        self.running = False
        httpd, self._httpd = self._httpd, None
        if httpd is not None:
            try:
                httpd.shutdown()
                httpd.server_close()
            except Exception:  # noqa: BLE001
                pass
        self._thread = None

    @property
    def address(self) -> str:
        return f"http://127.0.0.1:{self.port}"


class _StHandler(BaseHTTPRequestHandler):
    server_version = "HSLSt/1.6"
    protocol_version = "HTTP/1.1"

    @property
    def st(self) -> LocalStServer:
        return self.server.st  # type: ignore[attr-defined]

    def log_message(self, fmt, *args) -> None:  # noqa: N802
        pass

    def _cors(self) -> None:
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")

    def _send_json(self, code: int, obj: Any, close: bool = False) -> None:
        data = json.dumps(obj).encode("utf-8")
        try:
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            if close:
                self.send_header("Connection", "close")
                self.close_connection = True
            self._cors()
            self.end_headers()
            self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError):
            self.close_connection = True

    def _read_json(self) -> Optional[Dict[str, Any]]:
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            n = 0
        if n <= 0:
            return {}
        if n > ST_BODY_CAP:
            return None
        try:
            return json.loads(self.rfile.read(n).decode("utf-8") or "{}")
        except ValueError:
            return {}

    def do_OPTIONS(self) -> None:  # noqa: N802
        self.send_response(204)
        self.send_header("Content-Length", "0")
        self._cors()
        self.end_headers()

    # --- GET info endpoints ----------------------------------------------------
    def do_GET(self) -> None:  # noqa: N802
        path = urllib.parse.urlsplit(self.path).path
        try:
            state = self.st.state_fn() or {}
        except Exception:  # noqa: BLE001 - state snapshot must never 500
            state = {}
        if path in ("/", ""):
            self._send_json(200, {"app": f"{APP_NAME} {APP_VERSION}",
                                  "note": "A1111-compatible /sdapi/v1 for SillyTavern; "
                                          "only the prompt is used, everything else follows the app's settings"})
        elif path == "/sdapi/v1/options":
            self._send_json(200, {
                "sd_model_checkpoint": state.get("model_label", ""),
                "sd_vae": "Automatic",
                "CLIP_stop_at_last_layers": 1,
                "forge_additional_modules": [],
                "forge_preset": "none",
            })
        elif path == "/sdapi/v1/sd-models":
            models = []
            for name, label in state.get("models", []):
                models.append({"name": name, "title": label, "model_name": name,
                               "hash": "00000000", "sha256": "0" * 64,
                               "filename": f"{name}.safetensors", "config": None})
            self._send_json(200, models)
        elif path == "/sdapi/v1/samplers":
            self._send_json(200, [{"name": s, "aliases": [], "options": {}}
                                  for s in state.get("samplers", [])])
        elif path == "/sdapi/v1/schedulers":
            self._send_json(200, [{"name": s, "label": s.title()} for s in SCHEDULERS])
        elif path == "/sdapi/v1/upscalers":
            self._send_json(200, [{"name": label} for label, _n, _f in UPSCALERS]
                            + [{"name": "Lanczos"}, {"name": "Nearest"}])
        elif path == "/sdapi/v1/latent-upscale-modes":
            self._send_json(200, [{"name": "Latent"}])
        elif path == "/sdapi/v1/progress":
            self._send_json(200, {"progress": 0, "eta_relative": 0.0,
                                  "state": {"skipped": False, "interrupted": False, "batch_index": 0},
                                  "current_image": None, "textinfo": None})
        elif path.startswith("/sdapi/"):
            self._send_json(200, [])
        else:
            self._send_json(404, {"error": "unknown endpoint"})

    # --- generation ------------------------------------------------------------
    def do_POST(self) -> None:  # noqa: N802
        path = urllib.parse.urlsplit(self.path).path
        doc = self._read_json()
        if doc is None:
            self._send_json(413, {"error": "payload too large"}, close=True)
            return
        if path == "/sdapi/v1/png-info":
            self._send_json(200, {"info": "", "items": {}})
            return
        if path not in ("/sdapi/v1/txt2img", "/sdapi/v1/img2img"):
            self._send_json(404, {"error": "unknown endpoint"})
            return
        # Only the prompt is considered; negative prompt and every other
        # parameter sent by SillyTavern are ignored in favour of the app's
        # current settings.
        prompt = " ".join(str(doc.get("prompt") or "").split())
        if not prompt:
            self._send_json(400, {"error": "empty prompt",
                                  "detail": "SillyTavern sent no prompt text"})
            return
        st = self.st
        st._note(f"SillyTavern request: {prompt[:64]}\u2026")
        try:
            res = st.submit_fn(prompt)
        except Exception as exc:  # noqa: BLE001 - never let the server thread die
            st._note(f"SillyTavern request failed: {exc}")
            self._send_json(500, {"error": f"{exc.__class__.__name__}: {exc}"})
            return
        if not isinstance(res, dict) or not res.get("ok"):
            err = (res or {}).get("error") if isinstance(res, dict) else "generation failed"
            st._note(f"SillyTavern request failed: {err}")
            self._send_json(502, {"error": str(err or "generation failed")})
            return
        path_img = str(res.get("path") or "")
        try:
            with open(path_img, "rb") as fh:
                data = fh.read()
        except OSError as exc:
            st._note(f"SillyTavern request failed: {exc}")
            self._send_json(502, {"error": f"cannot read the generated file: {exc}"})
            return
        meta = res.get("meta") or {}
        b64 = base64.b64encode(data).decode("ascii")
        info = json.dumps({
            "prompt": prompt,
            "seed": meta.get("seed"),
            "width": meta.get("width"), "height": meta.get("height"),
            "steps": meta.get("steps"), "sampler_name": meta.get("sampler"),
            "cfg_scale": meta.get("cfg"), "model": meta.get("model"),
        })
        params = {
            "prompt": prompt,
            "steps": meta.get("steps"), "width": meta.get("width"), "height": meta.get("height"),
            "cfg_scale": meta.get("cfg"), "sampler_name": meta.get("sampler"),
        }
        st._note(f"SillyTavern image delivered: {os.path.basename(path_img)}")
        self._send_json(200, {"images": [b64], "parameters": params, "info": info})


# =============================================================================
#  HTTP client (requests when available, urllib otherwise)
# =============================================================================
class HordeError(Exception):
    def __init__(self, message: str, rc: Optional[str] = None, status: Optional[int] = None,
                 retry_after: Optional[float] = None):
        super().__init__(message)
        self.message = message
        self.rc = rc
        self.status = status
        self.retry_after = retry_after


class HordeAPI:
    """REST client for the AI Horde.

    Networking is deliberately forgiving: aihorde.net sits behind Cloudflare,
    which silently closes idle keep-alive sockets. Re-using such a dead pooled
    connection makes the TLS layer fail with `SSLError: EOF occurred in
    violation of protocol` - which urllib3 does NOT retry for POST requests
    by default (it cannot know whether the server already saw the request).
    We therefore mount a Retry adapter that also covers these connection-level
    POST failures, recycle the whole session when a connection error still
    bubbles up (drops every stale socket) and retry the call a few times with
    back-off. The payload itself is logged by the workers, not here.
    """

    def __init__(self, base_url: str = HORDE_URL, api_key: str = ANON_KEY, client_agent: str = CLIENT_AGENT):
        self.base_url = base_url.rstrip("/")
        self.api_key = api_key or ANON_KEY
        self.client_agent = client_agent
        # Optional log sink (called from worker threads; must be thread-safe,
        # e.g. a Qt signal emit). Used to report retries in the main log.
        self.log_hook: Optional[Callable[[str], None]] = None
        # Optional browser bridge (VPN tunnel): when set and running, every
        # request is executed inside the user's browser instead of directly.
        self.bridge: Optional[BrowserBridge] = None
        self._session = self._make_session()

    # --- session / transport plumbing -----------------------------------------
    @property
    def transport(self) -> str:
        if self._bridge_active():
            return "browser-bridge"
        return "requests" if self._session is not None else "urllib"

    def _bridge_active(self) -> bool:
        return self.bridge is not None and self.bridge.running

    def _make_session(self):
        if not _HAS_REQUESTS:
            return None
        session = requests.Session()
        try:
            from requests.adapters import HTTPAdapter
            try:
                from urllib3.util.retry import Retry
            except ImportError:  # very old urllib3 vendored inside requests
                from requests.packages.urllib3.util.retry import Retry  # type: ignore
            kwargs: Dict[str, Any] = dict(
                total=4, connect=4, read=2, backoff_factor=1.0,
                status_forcelist=(500, 502, 503, 504),
            )
            try:
                retry = Retry(allowed_methods=None, **kwargs)   # urllib3 >= 1.26
            except TypeError:
                retry = Retry(method_whitelist=None, **kwargs)  # urllib3 < 1.26
            adapter = HTTPAdapter(max_retries=retry, pool_connections=8, pool_maxsize=16)
            session.mount("https://", adapter)
            session.mount("http://", adapter)
        except Exception:  # noqa: BLE001 - fall back to a plain session
            pass
        return session

    def _reset_session(self) -> None:
        """Drop every pooled (possibly stale) keep-alive connection."""
        if self._session is not None:
            try:
                self._session.close()
            except Exception:  # noqa: BLE001
                pass
            self._session = self._make_session()

    def _net_log(self, text: str) -> None:
        if self.log_hook is not None:
            try:
                self.log_hook(text)
            except Exception:  # noqa: BLE001 - logging must never break a call
                pass

    def _headers(self, auth: bool) -> Dict[str, str]:
        h = {"Client-Agent": self.client_agent, "Accept": "application/json"}
        if auth:
            h["apikey"] = self.api_key or ANON_KEY
        return h

    # --- core call --------------------------------------------------------------
    def call(self, method: str, path: str, body: Optional[Dict[str, Any]] = None,
             params: Optional[Dict[str, Any]] = None, timeout: float = 30, auth: bool = True,
             net_attempts: int = 3) -> Any:
        url = path if path.startswith("http") else self.base_url + path
        if params:
            url += ("&" if "?" in url else "?") + urllib.parse.urlencode(params)
        last: Optional[HordeError] = None
        for attempt in range(1, max(1, net_attempts) + 1):
            try:
                return self._call_once(method, url, body, timeout, auth)
            except HordeError as exc:
                if exc.rc != "Network" or attempt >= net_attempts:
                    raise
                last = exc
                # A connection-level failure (stale TLS socket, reset, EOF):
                # throw away the pooled connections and try again shortly.
                self._reset_session()
                self._net_log(f"network retry {attempt}/{net_attempts} on {method} "
                              f"{urllib.parse.urlsplit(url).path}: {exc.message[:140]}")
                time.sleep(min(8.0, 1.5 * attempt))
        raise last or HordeError("Network error")

    def _call_once(self, method: str, url: str, body: Optional[Dict[str, Any]],
                   timeout: float, auth: bool) -> Any:
        if self._bridge_active():
            return self._bridge_call(method, url, body, timeout, auth)
        headers = self._headers(auth)
        if body is not None:
            headers["Content-Type"] = "application/json"
        if self._session is not None:
            try:
                r = self._session.request(method, url, json=body, headers=headers, timeout=timeout)
            except requests.RequestException as exc:  # type: ignore[attr-defined]
                raise HordeError(f"Network error: {exc.__class__.__name__}: {exc}", rc="Network")
            status = r.status_code
            try:
                data = r.json()
            except ValueError:
                data = {"message": r.text[:300]}
            retry_after = r.headers.get("Retry-After")
        else:
            payload = json.dumps(body).encode("utf-8") if body is not None else None
            req = urllib.request.Request(url, data=payload, headers=headers, method=method)
            try:
                with urllib.request.urlopen(req, timeout=timeout) as resp:
                    status = resp.status
                    raw = resp.read()
                    retry_after = resp.headers.get("Retry-After")
            except urllib.error.HTTPError as exc:
                status = exc.code
                raw = exc.read()
                retry_after = exc.headers.get("Retry-After")
            except (urllib.error.URLError, OSError, ValueError) as exc:
                raise HordeError(f"Network error: {exc}", rc="Network")
            try:
                data = json.loads(raw.decode("utf-8")) if raw else {}
            except ValueError:
                data = {"message": raw[:300].decode("utf-8", "replace")}
        return self._finish_response(status, data, retry_after)

    # --- browser bridge transport ---------------------------------------------
    def _bridge_call(self, method: str, url: str, body: Optional[Dict[str, Any]],
                     timeout: float, auth: bool) -> Any:
        """Run one JSON API call inside the user's browser (VPN applies)."""
        headers = self._headers(auth)
        payload: Optional[bytes] = None
        if body is not None:
            payload = json.dumps(body).encode("utf-8")
            headers["Content-Type"] = "application/json"
        try:
            status, _hdrs, raw = self.bridge.request(method, url, headers, payload, timeout)
        except BridgeError as exc:
            # "no client connected" fails fast (rc=None -> no pointless retries);
            # everything else is treated as a transient network error.
            raise HordeError(exc.message, rc="Network" if exc.network else None) from exc
        try:
            data = json.loads(raw.decode("utf-8")) if raw else {}
        except ValueError:
            data = {"message": raw[:300].decode("utf-8", "replace")}
        return self._finish_response(status, data, None)

    @staticmethod
    def _finish_response(status: int, data: Any, retry_after: Optional[str]) -> Any:
        if status < 400:
            return data
        msg = data.get("message") if isinstance(data, dict) else str(data)
        errs = data.get("errors") if isinstance(data, dict) else None
        if isinstance(errs, dict) and errs:
            msg = f"{msg} ({'; '.join(f'{k}: {v}' for k, v in errs.items())})"
        rc = data.get("rc") if isinstance(data, dict) else None
        try:
            ra = float(retry_after) if retry_after else None
        except ValueError:
            ra = None
        raise HordeError(msg or f"HTTP {status}", rc=rc, status=status, retry_after=ra)

    # --- image generation ----------------------------------------------------
    def submit(self, payload: Dict[str, Any]) -> Dict[str, Any]:
        # The Horde verifies `seed` as a string; coerce it defensively so an
        # int can never fail the whole payload with
        # "payload verification failed: seed is not of type string".
        params = payload.get("params")
        if isinstance(params, dict) and "seed" in params and not isinstance(params["seed"], str):
            payload = dict(payload, params=dict(params, seed=str(params["seed"])))
        return self.call("POST", "/generate/async", body=payload, timeout=60)

    def check(self, rid: str) -> Dict[str, Any]:
        return self.call("GET", f"/generate/check/{rid}", timeout=20, auth=False)

    def status(self, rid: str) -> Dict[str, Any]:
        return self.call("GET", f"/generate/status/{rid}", timeout=60, auth=False)

    def cancel(self, rid: str) -> Dict[str, Any]:
        return self.call("DELETE", f"/generate/status/{rid}", timeout=30, auth=False)

    # --- alchemy (interrogation: aesthetic scoring + upscalers) --------------
    def interrogate_submit(self, payload: Dict[str, Any]) -> Dict[str, Any]:
        return self.call("POST", "/interrogate/async", body=payload, timeout=45)

    def interrogate_status(self, rid: str) -> Dict[str, Any]:
        return self.call("GET", f"/interrogate/status/{rid}", timeout=30, auth=False)

    def interrogate_cancel(self, rid: str) -> Dict[str, Any]:
        return self.call("DELETE", f"/interrogate/status/{rid}", timeout=30, auth=False)

    # --- info ----------------------------------------------------------------
    def models(self) -> List[Dict[str, Any]]:
        return self.call("GET", "/status/models", params={"type": "image"}, timeout=30, auth=False)

    def heartbeat(self) -> Dict[str, Any]:
        return self.call("GET", "/status/heartbeat", timeout=15, auth=False)

    def find_user(self) -> Dict[str, Any]:
        return self.call("GET", "/find_user", timeout=20)

    def sampler_constraints(self) -> Dict[str, Any]:
        return self.call("GET", "/status/sampler_constraints", timeout=30, auth=False)

    def download(self, url: str, timeout: float = 90) -> bytes:
        last: Optional[HordeError] = None
        for attempt in range(1, 4):
            try:
                return self._download_once(url, timeout)
            except HordeError as exc:
                if exc.rc != "Network" or attempt >= 3:
                    raise
                last = exc
                self._reset_session()
                self._net_log(f"download retry {attempt}/3: {exc.message[:120]}")
                time.sleep(1.5 * attempt)
        raise last or HordeError("Download failed")

    def _download_once(self, url: str, timeout: float) -> bytes:
        if self._bridge_active():
            try:
                status, _hdrs, raw = self.bridge.request(
                    "GET", url, {"User-Agent": self.client_agent, "Accept": "*/*"},
                    None, timeout)
            except BridgeError as exc:
                raise HordeError(f"Download failed: {exc.message}",
                                 rc="Network" if exc.network else None) from exc
            if status >= 400:
                raise HordeError(f"Download failed: HTTP {status}", status=status)
            return raw
        if self._session is not None:
            try:
                r = self._session.get(url, timeout=timeout)
            except requests.RequestException as exc:  # type: ignore[attr-defined]
                raise HordeError(f"Download failed: {exc}", rc="Network")
            if r.status_code >= 400:
                raise HordeError(f"Download failed: HTTP {r.status_code}", status=r.status_code)
            return r.content
        req = urllib.request.Request(url, headers={"User-Agent": self.client_agent})
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                return resp.read()
        except (urllib.error.URLError, OSError) as exc:
            raise HordeError(f"Download failed: {exc}", rc="Network")

    def civitai_lookup(self, ident: str, is_version: bool) -> Dict[str, Any]:
        url = (CIVITAI_VERSION_URL if is_version else CIVITAI_MODEL_URL).format(id=ident)
        data = self.call("GET", url, timeout=25, auth=False)
        out = {"name": "", "trained_words": [], "base": "", "type": ""}
        if is_version:
            out["name"] = f"{data.get('model', {}).get('name', '')} / {data.get('name', '')}".strip(" /")
            out["trained_words"] = data.get("trainedWords") or []
            out["base"] = data.get("baseModel", "")
            out["type"] = data.get("model", {}).get("type", "")
        else:
            out["name"] = data.get("name", "")
            out["type"] = data.get("type", "")
            vers = data.get("modelVersions") or []
            if vers:
                out["trained_words"] = vers[0].get("trainedWords") or []
                out["base"] = vers[0].get("baseModel", "")
        return out


# =============================================================================
#  Image store (temp ring of 10 + output folder)
# =============================================================================
class ImageStore:
    def __init__(self, temp_dir: str, output_dir: str, capacity: int = TEMP_CAPACITY):
        self.temp_dir = temp_dir
        self.output_dir = output_dir
        self.capacity = capacity
        self._lock = threading.Lock()
        for d in (temp_dir, output_dir):
            try:
                os.makedirs(d, exist_ok=True)
            except OSError:
                pass
        self.orphans_cleaned = self.cleanup_orphan_metadata()

    def cleanup_orphan_metadata(self) -> int:
        """Delete sidecar .json metadata files whose image no longer exists.
        Runs once at start-up in the temp ring and the output folder."""
        removed = 0
        for d in (self.temp_dir, self.output_dir):
            try:
                names = os.listdir(d)
            except OSError:
                continue
            stems = {os.path.splitext(n)[0].lower() for n in names
                     if n.lower().endswith((".png", ".webp", ".jpg", ".jpeg"))}
            for n in names:
                if not n.lower().endswith(".json"):
                    continue
                if os.path.splitext(n)[0].lower() not in stems:
                    try:
                        os.remove(os.path.join(d, n))
                        removed += 1
                    except OSError:
                        pass
        return removed

    def _slot(self, i: int) -> str:
        return os.path.join(self.temp_dir, f"hsl_{i:02d}")

    def reserve(self) -> str:
        """Return the base path (without extension) of the slot to overwrite."""
        with self._lock:
            oldest, oldest_t = None, None
            for i in range(self.capacity):
                base = self._slot(i)
                existing = [base + ext for ext in (".png", ".webp") if os.path.exists(base + ext)]
                if not existing:
                    return base
                t = max(os.path.getmtime(p) for p in existing)
                if oldest_t is None or t < oldest_t:
                    oldest, oldest_t = base, t
            base = oldest or self._slot(0)
            for ext in (".png", ".webp", ".json"):
                try:
                    os.remove(base + ext)
                except OSError:
                    pass
            return base

    def save_temp(self, data: bytes, meta: Dict[str, Any]) -> str:
        base = self.reserve()
        return write_image_with_metadata(data, base + ".png", meta)

    def save_direct(self, data: bytes, meta: Dict[str, Any]) -> str:
        """Store a finished render straight into the output folder, bypassing
        the temp ring entirely."""
        ensure_dirs()
        dest = self.output_name(meta, ".png")
        return write_image_with_metadata(data, dest, meta)

    def save_tile(self, data: bytes, meta: Dict[str, Any]) -> str:
        """Store a processed tile-upscale tile into the ./tiles work folder."""
        ensure_dirs()
        dest = meta.get("tile_target") or os.path.join(
            TILES_DIR, f"tile_{int(time.time() * 1000) % 100000}.png")
        return write_image_with_metadata(data, dest, meta)

    @staticmethod
    def clean_tiles_dir() -> int:
        """Remove every file in the tiles work folder. Returns files removed."""
        removed = 0
        try:
            names = os.listdir(TILES_DIR)
        except OSError:
            return 0
        for n in names:
            try:
                os.remove(os.path.join(TILES_DIR, n))
                removed += 1
            except OSError:
                pass
        return removed

    @staticmethod
    def clean_group_tiles(gid: int) -> int:
        """Remove only the work files of one tile-upscale run (g{gid}_*).
        Several runs can be in flight at once, so a full wipe is not safe."""
        prefix = f"g{int(gid)}_"
        removed = 0
        try:
            names = os.listdir(TILES_DIR)
        except OSError:
            return 0
        for n in names:
            if n.startswith(prefix):
                try:
                    os.remove(os.path.join(TILES_DIR, n))
                    removed += 1
                except OSError:
                    pass
        return removed

    def list_recent(self, include_output: bool = False) -> List[str]:
        """Newest images from the temp ring, plus (optionally) the output folder
        used when direct saving is enabled."""
        dirs = [self.temp_dir] + ([self.output_dir] if include_output else [])
        files: List[str] = []
        for d in dirs:
            try:
                files += [os.path.join(d, f) for f in os.listdir(d)
                          if f.lower().endswith((".png", ".webp"))]
            except OSError:
                continue
        files.sort(key=lambda p: os.path.getmtime(p), reverse=True)
        return files[: self.capacity]

    def output_name(self, meta: Dict[str, Any], ext: str) -> str:
        model = model_short(str(meta.get("model", ""))) or ("UPS" if meta.get("tile_upscale") else "IMG")
        seed = re.sub(r"[^A-Za-z0-9_-]", "", str(meta.get("seed", "")))[:16] or "noseed"
        stamp = time.strftime("%Y%m%d_%H%M%S", time.localtime(meta.get("saved_at") or time.time()))
        name = f"{stamp}_{model}_{seed}{ext}"
        dest = os.path.join(self.output_dir, name)
        i = 2
        while os.path.exists(dest):
            dest = os.path.join(self.output_dir, f"{stamp}_{model}_{seed}_{i}{ext}")
            i += 1
        return dest

    def save_to_output(self, src: str, dest: Optional[str] = None) -> str:
        ensure_dirs()
        meta = read_image_metadata(src)
        ext = os.path.splitext(src)[1].lower()
        dest = dest or self.output_name(meta, ext)
        shutil.copy2(src, dest)
        side = os.path.splitext(src)[0] + ".json"
        if os.path.exists(side):
            try:
                shutil.copy2(side, os.path.splitext(dest)[0] + ".json")
            except OSError:
                pass
        return dest

    def delete_temp(self, path: str) -> None:
        for p in (path, os.path.splitext(path)[0] + ".json"):
            try:
                os.remove(p)
            except OSError:
                pass


# =============================================================================
#  Jobs
# =============================================================================
_job_counter = [0]


@dataclass
class Job:
    payload: Dict[str, Any]
    meta: Dict[str, Any]
    kind: str = KIND_GEN
    group_id: Optional[int] = None
    local_id: int = 0
    state: str = STATE_QUEUED
    horde_id: Optional[str] = None
    kudos: Optional[float] = None
    wait_time: Optional[int] = None
    wait_initial: Optional[int] = None
    queue_position: Optional[int] = None
    finished: int = 0
    processing: int = 0
    waiting: int = 0
    restarted: int = 0
    is_possible: bool = True
    message: str = ""
    warnings: List[str] = field(default_factory=list)
    results: List[str] = field(default_factory=list)
    created: float = field(default_factory=time.time)
    started: Optional[float] = None
    ended: Optional[float] = None
    retry_after: float = 0.0
    attempts: int = 0
    # aggregate tile progress, only used by KIND_GROUP rows (kept up to date
    # by MainWindow): counts per tile state, "total", "frac" (0..1), "merging"
    agg: Dict[str, Any] = field(default_factory=dict)

    def __post_init__(self) -> None:
        if not self.local_id:
            _job_counter[0] += 1
            self.local_id = _job_counter[0]
        self.meta.setdefault("job_kind", self.kind)
        if self.group_id is not None:
            self.meta.setdefault("group", self.group_id)

    @property
    def n(self) -> int:
        return int(self.payload.get("params", {}).get("n", 1))

    @property
    def active(self) -> bool:
        return self.state in ACTIVE_STATES

    def title(self) -> str:
        if self.kind == KIND_GROUP:
            m = self.meta
            return (f"Tile Upscale \u2022 {m.get('src_name', '?')}  "
                    f"{m.get('src_w')}\u00d7{m.get('src_h')} \u25B8 {m.get('out_w')}\u00d7{m.get('out_h')}")
        if self.kind == KIND_ALCH:
            m = self.meta
            if m.get("base"):
                return f"Base upscale \u2b61 whole image \u2022 {m.get('upscaler_label', 'upscaler')}"
            return f"Alchemy \u2b61 r{m.get('tile_row', '?')}c{m.get('tile_col', '?')} \u2022 {m.get('upscaler_label', 'upscaler')}"
        if self.kind == KIND_TILE_I2I:
            m = self.meta
            base = f"Tile r{m.get('tile_row', '?')}c{m.get('tile_col', '?')} \u2022 img2img"
            return base + " \u2022 " + (elide(m.get("prompt", ""), 46) or "tile upscale")
        return elide(self.meta.get("prompt", ""), 90) or "(empty prompt)"

    def reset_for_retry(self) -> None:
        """Turn a finished/failed job back into a fresh queued one, replacing
        the old failed entry in place."""
        self.state = STATE_QUEUED
        self.horde_id = None
        self.kudos = None
        self.wait_time = None
        self.wait_initial = None
        self.queue_position = None
        self.finished = 0
        self.processing = 0
        self.waiting = 0
        self.restarted = 0
        self.is_possible = True
        self.message = ""
        self.warnings = []
        self.results = []
        self.created = time.time()
        self.started = None
        self.ended = None
        self.retry_after = 0.0
        self.attempts = 0

    def progress(self) -> float:
        if self.kind == KIND_GROUP:
            return max(0.0, min(1.0, float(self.agg.get("frac", 0.0))))
        st = self.state
        if st == STATE_QUEUED:
            return 0.0
        if st == STATE_SUBMITTING:
            return 0.04
        if st == STATE_WAITING:
            if self.kind == KIND_ALCH:
                return 0.10
            if self.wait_initial and self.wait_time is not None and self.wait_initial > 0:
                return 0.08 + 0.52 * max(0.0, min(1.0, 1 - self.wait_time / self.wait_initial))
            return 0.1
        if st == STATE_PROCESSING:
            if self.kind == KIND_ALCH:
                return 0.62
            frac = (self.finished + 0.5 * self.processing) / max(1, self.n)
            return 0.6 + 0.32 * max(0.0, min(1.0, frac))
        if st == STATE_FETCHING:
            return 0.95
        return 1.0

    def status_text(self) -> str:
        if self.kind == KIND_GROUP:
            a = self.agg
            total = int(a.get("total", 0))
            if a.get("merging"):
                return (f"Assembling tiles \u2192 {self.meta.get('out_w')}\u00d7{self.meta.get('out_h')}\u2026")
            if self.state == STATE_DONE and self.results:
                dur = fmt_secs((self.ended or time.time()) - (self.started or self.created))
                return f"Done \u2022 saved {os.path.basename(self.results[0])} \u2022 {dur}"
            bits = []
            if a.get("base"):
                bits.append("whole-image upscale running")
            elif self.meta.get("base_state") == "lanczos" and not a.get(TILE_REFINING) and not a.get(TILE_DONE):
                bits.append("Lanczos base upscale running")
            if a.get(TILE_REFINING):
                bits.append(f"{a[TILE_REFINING]} in img2img")
            if a.get(TILE_DONE):
                bits.append(f"{a[TILE_DONE]}/{total} tiles done")
            if a.get(TILE_FAILED):
                bits.append(f"{a[TILE_FAILED]} failed")
            if not bits:
                bits.append("starting\u2026" if self.state in ACTIVE_STATES else self.state)
            return " \u2022 ".join(bits)
        if self.kind == KIND_ALCH:
            st = self.state
            base = bool(self.meta.get("base"))
            if st == STATE_QUEUED:
                if self.retry_after > time.time():
                    return (f"Pending \u2022 retry in {fmt_secs(self.retry_after - time.time())}"
                            + (f" \u2022 {self.message}" if self.message else ""))
                return "Pending \u2022 waiting for a free slot"
            if st == STATE_SUBMITTING:
                return "Submitting the whole image to Alchemy\u2026" if base else "Cutting tile & submitting to Alchemy\u2026"
            if st == STATE_WAITING:
                bits = ["In Alchemy queue"]
                if self.queue_position is not None:
                    bits.append(f"pos {self.queue_position}")
                if self.wait_time is not None:
                    bits.append(f"ETA {fmt_secs(self.wait_time)}")
                if not self.is_possible:
                    bits.append("no eligible worker right now")
                return " \u2022 ".join(bits)
            if st == STATE_PROCESSING:
                return "Upscaling on the Horde\u2026"
            if st == STATE_FETCHING:
                return "Downloading the upscaled image\u2026"
            if st == STATE_DONE:
                return f"Done \u2022 upscaler applied{fmt_secs((self.ended or time.time()) - (self.started or self.created))}"
            if st == STATE_CANCELLED:
                return "Cancelled"
            return f"Failed \u2022 {self.message or 'unknown error'}"
        st = self.state
        if st == STATE_QUEUED:
            if self.retry_after > time.time():
                return f"Pending \u2022 retry in {fmt_secs(self.retry_after - time.time())}" + (f" \u2022 {self.message}" if self.message else "")
            return "Pending \u2022 waiting for a free slot"
        if st == STATE_SUBMITTING:
            return "Submitting to the Horde\u2026"
        if st == STATE_WAITING:
            bits = ["In Horde queue"]
            if self.queue_position is not None:
                bits.append(f"pos {self.queue_position}")
            if self.wait_time is not None:
                bits.append(f"ETA {fmt_secs(self.wait_time)}")
            if self.kudos is not None:
                bits.append(f"{self.kudos:.0f} kudos")
            if not self.is_possible:
                bits.append("no eligible worker right now")
            return " \u2022 ".join(bits)
        if st == STATE_PROCESSING:
            bits = [f"Rendering {self.finished}/{self.n} done"]
            if self.processing:
                bits.append(f"{self.processing} in progress")
            if self.wait_time:
                bits.append(f"ETA {fmt_secs(self.wait_time)}")
            return " \u2022 ".join(bits)
        if st == STATE_FETCHING:
            return "Downloading image\u2026"
        dur = f" \u2022 {fmt_secs((self.ended or time.time()) - (self.started or self.created))}"
        if st == STATE_DONE:
            k = f" \u2022 {self.kudos:.0f} kudos" if self.kudos is not None else ""
            return f"Done \u2022 {len(self.results)} image{'s' if len(self.results) != 1 else ''}{k}{dur}"
        if st == STATE_CANCELLED:
            extra = f" \u2022 {len(self.results)} partial" if self.results else ""
            return f"Cancelled{extra}{dur}"
        return f"Failed \u2022 {self.message or 'unknown error'}"


# =============================================================================
#  Worker thread: full lifecycle of one request
# =============================================================================
class JobWorker(QThread):
    progress = pyqtSignal(int, dict)
    completed = pyqtSignal(int, list, str)       # local_id, paths, final state
    failed = pyqtSignal(int, str, float)         # local_id, message, retry delay (0 = permanent)
    log = pyqtSignal(str)

    def __init__(self, job: Job, api: HordeAPI, store: ImageStore, poll_interval: float = 2.5,
                 save_direct: bool = False):
        super().__init__()
        self.job = job
        self.api = api
        self.store = store
        self.poll_interval = max(1.2, float(poll_interval))
        self.save_direct = bool(save_direct)
        self._cancel = False

    def cancel(self) -> None:
        self._cancel = True

    def _sleep(self, secs: float) -> bool:
        end = time.time() + secs
        while time.time() < end:
            if self._cancel:
                return False
            time.sleep(0.15)
        return not self._cancel

    def run(self) -> None:
        jid = self.job.local_id
        try:
            self._run()
        except HordeError as exc:
            self.failed.emit(jid, exc.message, 0.0)
        except Exception as exc:  # noqa: BLE001 - surface anything to the UI
            self.log.emit(f"#{jid} unexpected error: {traceback.format_exc(limit=3)}")
            self.failed.emit(jid, f"Unexpected error: {exc}", 0.0)

    def _run(self) -> None:
        job = self.job
        jid = job.local_id
        self.progress.emit(jid, {"state": STATE_SUBMITTING, "started": time.time()})
        send_payload = self._materialize_payload(job.payload)
        pr = send_payload.get("params", {})
        models = ",".join(send_payload.get("models", []))
        if job.kind == KIND_TILE_I2I:
            self.log.emit(
                f"#{jid} POST /generate/async  img2img tile {pr.get('width')}\u00d7{pr.get('height')}  "
                f"model={models}  sampler={pr.get('sampler_name')}/{pr.get('scheduler')}  "
                f"denoise={pr.get('denoising_strength')}  steps={pr.get('steps')}  "
                f"cfg={pr.get('cfg_scale')}  clip_skip={pr.get('clip_skip')}  "
                f"source={len(str(send_payload.get('source_image', ''))) // 1024} KB b64")
        else:
            self.log.emit(
                f"#{jid} POST /generate/async  {pr.get('width')}\u00d7{pr.get('height')}  n={pr.get('n')}  "
                f"model={models}  sampler={pr.get('sampler_name')}  steps={pr.get('steps')}  cfg={pr.get('cfg_scale')}"
                + (f"  loras={len(send_payload.get('loras') or [])}" if send_payload.get("loras") else ""))
        try:
            res = self.api.submit(send_payload)
        except HordeError as exc:
            if exc.status == 429:
                self.failed.emit(jid, "Too many concurrent requests for this key", exc.retry_after or 20.0)
                return
            if exc.status == 503:
                self.failed.emit(jid, "Horde in maintenance mode", 60.0)
                return
            if exc.rc == "Network":
                self.failed.emit(jid, exc.message, 15.0)
                return
            self.failed.emit(jid, f"{exc.message}" + (f" [{exc.rc}]" if exc.rc else ""), 0.0)
            return
        rid = res.get("id")
        if not rid:
            self.failed.emit(jid, f"No request id returned: {res}", 0.0)
            return
        warnings = [w.get("message", w.get("code", "")) for w in res.get("warnings", []) or []]
        self.log.emit(f"#{jid} accepted as {rid} (est. {res.get('kudos', '?')} kudos)")
        for w in warnings:
            self.log.emit(f"#{jid} warning: {w}")
        self.progress.emit(jid, {"state": STATE_WAITING, "horde_id": rid, "kudos": res.get("kudos"), "warnings": warnings})
        if not self._sleep(1.2):
            self._do_cancel(rid)
            return
        net_errors = 0
        final: Optional[Dict[str, Any]] = None
        while True:
            if self._cancel:
                self._do_cancel(rid)
                return
            try:
                chk = self.api.check(rid)
                net_errors = 0
            except HordeError as exc:
                if exc.status == 404:
                    self.failed.emit(jid, "Request expired or was not found on the Horde", 0.0)
                    return
                net_errors += 1
                self.log.emit(f"#{jid} check failed ({net_errors}/12): {exc.message}")
                if net_errors >= 12:
                    self.failed.emit(jid, f"Lost connection: {exc.message}", 0.0)
                    return
                if not self._sleep(min(10, 2 * net_errors)):
                    self._do_cancel(rid)
                    return
                continue
            if chk.get("faulted"):
                self.failed.emit(jid, "The Horde faulted this request", 0.0)
                return
            fields = {
                "wait_time": chk.get("wait_time"), "queue_position": chk.get("queue_position"),
                "finished": chk.get("finished", 0), "processing": chk.get("processing", 0),
                "waiting": chk.get("waiting", 0), "restarted": chk.get("restarted", 0),
                "is_possible": chk.get("is_possible", True), "kudos": chk.get("kudos", job.kudos),
            }
            if job.wait_initial is None and chk.get("wait_time"):
                fields["wait_initial"] = chk.get("wait_time")
            if chk.get("done"):
                fields["state"] = STATE_FETCHING
                self.progress.emit(jid, fields)
                break
            fields["state"] = STATE_PROCESSING if (chk.get("processing") or chk.get("finished")) else STATE_WAITING
            self.progress.emit(jid, fields)
            if not self._sleep(self.poll_interval):
                self._do_cancel(rid)
                return
        for attempt in range(4):
            try:
                final = self.api.status(rid)
                break
            except HordeError as exc:
                if exc.status == 404:
                    self.failed.emit(jid, "Result expired before it could be fetched", 0.0)
                    return
                self.log.emit(f"#{jid} status fetch failed ({attempt + 1}/4): {exc.message}")
                if not self._sleep(3 + 3 * attempt):
                    return
        if final is None:
            self.failed.emit(jid, "Could not fetch the result", 0.0)
            return
        paths, censored, black = self._store_generations(final)
        if not paths:
            if job.kind == KIND_TILE_I2I and (censored or black):
                # every tile result was a censored / black placeholder - fail
                # this tile (never blend the black frame into the merge) with
                # the actionable censorship explanation
                self.failed.emit(jid, TILE_CENSORED_MSG, 0.0)
                return
            self.failed.emit(jid, "Horde returned no images (censored or faulted)", 0.0)
            return
        if job.kind == KIND_TILE_I2I and (censored or black):
            self.log.emit(f"#{jid} note: {censored + black} of {censored + black + len(paths)} "
                          "result(s) were censored/black and were not stored")
        self.completed.emit(jid, paths, STATE_DONE)

    def _do_cancel(self, rid: str) -> None:
        jid = self.job.local_id
        paths: List[str] = []
        try:
            res = self.api.cancel(rid)
            paths, _censored, _black = self._store_generations(res)
            self.log.emit(f"#{jid} cancelled on the Horde" + (f", kept {len(paths)} finished image(s)" if paths else ""))
        except HordeError as exc:
            self.log.emit(f"#{jid} cancel request failed: {exc.message}")
        self.completed.emit(jid, paths, STATE_CANCELLED)

    def _materialize_payload(self, payload: Dict[str, Any]) -> Dict[str, Any]:
        """Prepare the payload for submission. 'source_image_path' (used by tile
        img2img jobs so retries can re-read the file) is loaded and base64
        encoded here, off the GUI thread; an optional 'source_rect' crops the
        tile out of the shared upscaled base image first (A1111-style: the
        whole image is magnified once, every tile is cut from it)."""
        out = dict(payload)
        src_path = out.pop("source_image_path", None)
        rect = out.pop("source_rect", None)
        if src_path:
            try:
                with open(src_path, "rb") as fh:
                    data = fh.read()
            except OSError as exc:
                raise HordeError(f"img2img source missing: {src_path} ({exc})") from exc
            if rect is not None:
                img = QImage.fromData(QByteArray(data))
                if img.isNull():
                    raise HordeError(f"img2img source undecodable: {src_path}")
                rx, ry, rw, rh = (int(v) for v in rect)
                rx, ry = max(0, rx), max(0, ry)
                rw = max(8, min(rw, img.width() - rx))
                rh = max(8, min(rh, img.height() - ry))
                img = img.copy(rx, ry, rw, rh)
                data = image_to_png_bytes(img)
            out["source_image"] = base64.b64encode(data).decode("ascii")
            out.setdefault("source_processing", "img2img")
        return out

    def _store_generations(self, result: Dict[str, Any]) -> Tuple[List[str], int, int]:
        """Store every usable generation of a finished request. Returns
        (stored paths, censored count, black count).

        TILE jobs only: a censored result - the worker's black NSFW
        placeholder (per-generation `censored` flag, or a censorship note in
        gen_metadata) - is never stored, because merging it would stamp a
        black rectangle over the final image. The same applies to a frame
        that decodes as (almost) uniformly black: older workers return the
        placeholder without setting the flag. Normal (gallery) generations
        keep the previous behaviour: a censored image is stored, flagged in
        its metadata and shown as CENSORED in the caption."""
        job = self.job
        is_tile = bool(job.meta.get("tile_job"))
        paths: List[str] = []
        censored = 0
        black = 0
        gens = result.get("generations") or []
        for idx, gen in enumerate(gens):
            img = gen.get("img") or ""
            if not img:
                continue
            try:
                if img.startswith("http"):
                    data = self.api.download(img)
                else:
                    data = base64.b64decode(img)
            except (HordeError, ValueError) as exc:
                self.log.emit(f"#{job.local_id} image {idx + 1} download failed: {exc}")
                continue
            notes = []
            was_censored = bool(gen.get("censored"))
            for md in gen.get("gen_metadata") or []:
                if md.get("type") == "censorship":
                    notes.append("censored: " + str(md.get("value")))
                    was_censored = True
                elif md.get("type") == "lora":
                    notes.append(f"lora {md.get('ref', '')}: {md.get('value')}")
            if is_tile and was_censored:
                censored += 1
                self.log.emit(f"#{job.local_id} tile r{job.meta.get('tile_row', '?')}c"
                              f"{job.meta.get('tile_col', '?')} came back CENSORED (black placeholder) - "
                              "not stored; enable 'Enable NSFW (skip censoring workers)' and disable "
                              "'Censor NSFW results' in the HORDE tab options, then retry the tile")
                continue
            if is_tile and is_black_placeholder_frame(data):
                black += 1
                self.log.emit(f"#{job.local_id} tile r{job.meta.get('tile_row', '?')}c"
                              f"{job.meta.get('tile_col', '?')} came back black/empty (censor placeholder "
                              "or empty frame) - not stored; the tile keeps the neural base")
                continue
            meta = dict(job.meta)
            meta.update({
                "seed": gen.get("seed"), "horde_request_id": result.get("id") or job.horde_id,
                "generation_id": gen.get("id"), "worker_name": gen.get("worker_name"),
                "worker_id": gen.get("worker_id"), "model": gen.get("model") or job.meta.get("model"),
                "kudos": result.get("kudos", job.kudos), "censored": bool(gen.get("censored")),
                "notes": notes, "saved_at": time.time(), "shared": result.get("shared"),
                "app": f"{APP_NAME} {APP_VERSION}", "index": idx,
                "img_url": img if img.startswith("http") else "",
            })
            if job.meta.get("tile_job"):
                path = self.store.save_tile(data, meta)
            elif self.save_direct:
                path = self.store.save_direct(data, meta)
            else:
                path = self.store.save_temp(data, meta)
            paths.append(path)
            if notes:
                self.log.emit(f"#{job.local_id} image {idx + 1}: " + "; ".join(notes))
        return paths, censored, black


# =============================================================================
#  Generic one-shot background task
# =============================================================================
class TaskThread(QThread):
    done = pyqtSignal(object)
    error = pyqtSignal(str)

    def __init__(self, fn: Callable[[], Any], parent: Optional[QWidget] = None):
        super().__init__(parent)
        self.fn = fn

    def run(self) -> None:
        try:
            self.done.emit(self.fn())
        except HordeError as exc:
            self.error.emit(exc.message)
        except Exception as exc:  # noqa: BLE001
            self.error.emit(f"{exc.__class__.__name__}: {exc}")


class _LogBridge(QObject):
    """Thread-safe bridge so worker threads can push lines into the log
    (the HordeAPI log hook emits this signal; Qt queues it into the GUI thread)."""
    logged = pyqtSignal(str)


class _StSubmitBridge(QObject):
    """Thread-safe bridge for the SillyTavern server thread: it emits one
    request (a queue to answer on + the prompt); the GUI thread enqueues the
    generation and hands the Job back through the queue."""
    requested = pyqtSignal(object)   # (queue.Queue, prompt str)


# =============================================================================
#  Alchemy (interrogation): aesthetic scoring + upscalers
# =============================================================================
def _interruptible_sleep(secs: float, flag: Callable[[], bool], step: float = 0.2) -> bool:
    end = time.time() + secs
    while time.time() < end:
        if flag():
            return False
        time.sleep(step)
    return not flag()


def poll_interrogation(api: HordeAPI, rid: str, form_name: str, is_cancelled: Callable[[], bool],
                       timeout: float = 600.0, poll: float = 4.0,
                       on_status: Optional[Callable[[Dict[str, Any]], None]] = None) -> Dict[str, Any]:
    """Poll /interrogate/status/{rid} until the requested form is finished and
    return its result dict. Raises HordeError on fault/timeout. Transient
    network errors while polling are tolerated (up to 8 in a row)."""
    deadline = time.time() + timeout
    net_errors = 0
    while time.time() < deadline:
        if is_cancelled():
            try:
                api.interrogate_cancel(rid)
            except HordeError:
                pass
            raise HordeError("cancelled")
        try:
            st = api.interrogate_status(rid)
            net_errors = 0
        except HordeError as exc:
            if exc.status == 404:
                raise
            net_errors += 1
            if net_errors >= 8:
                raise
            _interruptible_sleep(min(10.0, 2.0 * net_errors), is_cancelled)
            continue
        if on_status is not None:
            try:
                on_status(st)
            except Exception:  # noqa: BLE001 - progress callbacks must not break the poll
                pass
        state = str(st.get("state") or "").lower()
        if state == "done":
            for form in st.get("forms") or []:
                if form.get("form") == form_name:
                    res = form.get("result")
                    if isinstance(res, dict) and res:
                        return res
            raise HordeError(f"Alchemy returned no result for {form_name}")
        if state in ("faulted", "cancelled"):
            raise HordeError(f"Alchemy request {state}")
        _interruptible_sleep(poll, is_cancelled)
    raise HordeError("Alchemy request timed out")


def alchemy_fetch_result(api: HordeAPI, res: Dict[str, Any], form_name: str,
                         is_cancelled: Callable[[], bool]) -> bytes:
    """Extract the image bytes from an upscaler form result (R2 URL or base64)."""
    url = res.get(form_name)
    if not isinstance(url, str) or not url:
        raise HordeError(f"Alchemy result for {form_name} is empty")
    if url.startswith("http"):
        return api.download(url)
    try:
        return base64.b64decode(url)
    except (ValueError, TypeError) as exc:
        raise HordeError(f"Alchemy returned undecodable data: {exc}") from exc


class AlchemyJobWorker(QThread):
    """One Alchemy (interrogation) upscaler request, running as a normal queue
    job so it is displayed, batched, deferred and retried exactly like every
    other request. In the A1111-style tile upscale this is the SINGLE
    whole-image pass: the full source image is sent to the configured
    upscaler form, the result is resized to the exact target size with
    Lanczos (Pillow) and stored as the shared base every tile is cut from."""

    progress = pyqtSignal(int, dict)
    completed = pyqtSignal(int, list, str)       # local_id, paths, final state
    failed = pyqtSignal(int, str, float)         # local_id, message, retry delay (0 = permanent)
    log = pyqtSignal(str)

    def __init__(self, job: Job, api: HordeAPI, poll_interval: float = 2.5,
                 parent: Optional[QWidget] = None):
        super().__init__(parent)
        self.job = job
        self.api = api
        self.poll_interval = max(1.2, float(poll_interval))
        self._cancel = False

    def cancel(self) -> None:
        self._cancel = True

    def _sleep(self, secs: float) -> bool:
        end = time.time() + secs
        while time.time() < end:
            if self._cancel:
                return False
            time.sleep(0.15)
        return not self._cancel

    def run(self) -> None:
        jid = self.job.local_id
        try:
            self._run()
        except HordeError as exc:
            if exc.message == "cancelled" or self._cancel:
                self.completed.emit(jid, [], STATE_CANCELLED)
                return
            retryable = exc.rc == "Network"
            self.failed.emit(jid, exc.message, 25.0 if retryable else 0.0)
        except Exception as exc:  # noqa: BLE001 - surface anything to the UI
            self.log.emit(f"#{jid} alchemy error: {traceback.format_exc(limit=3)}")
            self.failed.emit(jid, f"Unexpected error: {exc}", 0.0)

    def _cancelled_outcome(self) -> None:
        self.completed.emit(self.job.local_id, [], STATE_CANCELLED)

    def _run(self) -> None:
        job = self.job
        jid = job.local_id
        m = job.meta
        is_base = bool(m.get("base"))
        label = "whole image" if is_base else f"tile r{m.get('tile_row', '?')}c{m.get('tile_col', '?')}"
        upscaler = str(m.get("upscaler") or DEFAULT_UPSCALER)
        up_path = str(m.get("up_path") or "")
        part_path = str(m.get("part_path") or "")
        self.progress.emit(jid, {"state": STATE_SUBMITTING, "started": time.time()})
        src = QImage(str(m.get("source") or ""))
        if src.isNull():
            self.failed.emit(jid, "cannot read the tile-upscale source image", 0.0)
            return
        rx, ry, rw, rh = m.get("src_rect") or (0, 0, src.width(), src.height())
        part = src.copy(int(rx), int(ry), int(rw), int(rh))
        if part.isNull() or part.width() < 8 or part.height() < 8:
            self.failed.emit(jid, "tile part is degenerate", 0.0)
            return
        ensure_dirs()
        if part_path:
            part.save(part_path, "PNG")
        png = image_to_png_bytes(part)
        b64 = base64.b64encode(png).decode("ascii")
        # /api/v2/interrogate/async expects: forms[{name}], source_image (base64
        # without data-URI prefix), slow_workers. Log the exact shape we send.
        self.log.emit(f"#{jid} POST /interrogate/async  form={upscaler}  "
                      f"source {part.width()}\u00d7{part.height()}  "
                      f"({len(png) // 1024} KB raw / {len(b64) // 1024} KB b64)")
        payload = {"forms": [{"name": upscaler}], "source_image": b64, "slow_workers": True}
        res: Optional[Dict[str, Any]] = None
        last: Optional[HordeError] = None
        for attempt in range(3):
            if self._cancel:
                self._cancelled_outcome()
                return
            try:
                res = self.api.interrogate_submit(payload)
                break
            except HordeError as exc:
                if exc.message == "cancelled" or self._cancel:
                    self._cancelled_outcome()
                    return
                if exc.status == 429:
                    self.failed.emit(jid, "Too many concurrent requests for this key",
                                     exc.retry_after or 20.0)
                    return
                if exc.rc != "Network":
                    # the Horde refused the request itself (bad form, wrong key,
                    # maintenance...) - retrying the same payload is pointless
                    self.failed.emit(jid, exc.message, 0.0)
                    return
                last = exc
                self.log.emit(f"#{jid} alchemy submit failed ({attempt + 1}/3): {exc.message}")
                if not self._sleep(3.0 + 5.0 * attempt):
                    self._cancelled_outcome()
                    return
        if res is None:
            self.failed.emit(jid, last.message if last else "Alchemy submit failed", 25.0)
            return
        rid = res.get("id")
        if not rid:
            self.failed.emit(jid, f"Alchemy rejected the request: {res.get('message', res)}", 0.0)
            return
        kudos = res.get("kudos")
        self.log.emit(f"#{jid} {label} alchemy accepted as {rid}"
                      + (f" (est. {kudos} kudos)" if kudos is not None else ""))
        self.progress.emit(jid, {"state": STATE_WAITING, "horde_id": rid, "kudos": kudos})

        def on_status(st: Dict[str, Any]) -> None:
            fields: Dict[str, Any] = {}
            if st.get("queue_position") is not None:
                fields["queue_position"] = st.get("queue_position")
            if st.get("wait_time") is not None:
                fields["wait_time"] = st.get("wait_time")
            state = str(st.get("state") or "").lower()
            if state == "processing":
                fields["state"] = STATE_PROCESSING
            elif fields:
                fields.setdefault("state", STATE_WAITING)
            if fields:
                self.progress.emit(jid, fields)

        result = poll_interrogation(self.api, rid, upscaler, lambda: self._cancel,
                                    timeout=900.0, poll=self.poll_interval, on_status=on_status)
        if self._cancel:
            self._cancelled_outcome()
            return
        self.progress.emit(jid, {"state": STATE_FETCHING})
        data = alchemy_fetch_result(self.api, result, upscaler, lambda: self._cancel)
        up = QImage.fromData(QByteArray(data))
        if up.isNull():
            self.failed.emit(jid, "upscaler returned an undecodable image", 0.0)
            return
        if is_base:
            # Exact target size of the whole canvas: Lanczos (Pillow) when
            # available, Qt smooth otherwise. This is the one non-neural
            # resize of the pipeline, so quality matters.
            tw, th = m.get("resize_to") or (up.width(), up.height())
            if up.width() != int(tw) or up.height() != int(th):
                up = hq_resize(up, int(tw), int(th))
        else:
            tile = m.get("plan_tile") or {}
            tw = int(tile.get("w") or up.width())
            th = int(tile.get("h") or up.height())
            if up.width() != tw or up.height() != th:
                up = hq_resize(up, tw, th)
        if not up_path:
            up_path = os.path.join(TILES_DIR, f"up_{int(time.time() * 1000) % 100000}.png")
        if not up.save(up_path, "PNG"):
            self.failed.emit(jid, f"cannot save {os.path.basename(up_path)}", 0.0)
            return
        factor = int(m.get("factor") or UPSCALER_FACTOR.get(upscaler, 4))
        if is_base:
            self.log.emit(f"#{jid} base upscale done: {upscaler} {part.width()}\u00d7{part.height()} "
                          f"\u2192 \u00d7{factor} {part.width() * factor}\u00d7{part.height() * factor} "
                          f"\u2192 Lanczos resized to {up.width()}\u00d7{up.height()}")
        else:
            self.log.emit(f"#{jid} {label} {upscaler} done: part {part.width()}\u00d7{part.height()} "
                          f"\u2192 \u00d7{factor} {part.width() * factor}\u00d7{part.height() * factor} "
                          f"\u2192 resized to tile {up.width()}\u00d7{up.height()}")
        self.completed.emit(jid, [up_path], STATE_DONE)


class AestheticWorker(QThread):
    """Sends one finished image to the Horde Alchemy interrogator for an
    aesthetic score and stores it in the image metadata."""
    scored = pyqtSignal(str, float)     # image path, aesthetic score
    log = pyqtSignal(str)

    def __init__(self, api: HordeAPI, path: str, parent: Optional[QWidget] = None):
        super().__init__(parent)
        self.api = api
        self.path = path
        self._cancel = False

    def cancel(self) -> None:
        self._cancel = True

    def run(self) -> None:
        try:
            self._run()
        except HordeError as exc:
            if exc.message != "cancelled":
                self.log.emit(f"aesthetic score failed for {os.path.basename(self.path)}: {exc.message}")
        except Exception as exc:  # noqa: BLE001
            self.log.emit(f"aesthetic score error: {exc.__class__.__name__}: {exc}")

    def _run(self) -> None:
        meta = read_image_metadata(self.path)
        source = meta.get("img_url") or ""
        if not source or not str(source).startswith("http"):
            # No R2 link (base64 generation): upload the file itself.
            try:
                with open(self.path, "rb") as fh:
                    source = base64.b64encode(fh.read()).decode("ascii")
            except OSError as exc:
                raise HordeError(f"cannot read image: {exc}") from exc
        payload = {"forms": [{"name": "aesthetic"}], "source_image": source, "slow_workers": True}
        res = self.api.interrogate_submit(payload)
        rid = res.get("id")
        if not rid:
            raise HordeError(f"interrogation rejected: {res.get('message', res)}")
        result = poll_interrogation(self.api, rid, "aesthetic", lambda: self._cancel)
        score = result.get("aesthetic")
        if isinstance(score, (int, float)):
            self.scored.emit(self.path, round(float(score), 3))
        else:
            raise HordeError(f"unexpected aesthetic result: {result}")


# =============================================================================
#  Tile upscale planning / merging (A1111-style tiled upscale)
# =============================================================================
def snap64(v: float, lo: int = 64, hi: int = 3072) -> int:
    return max(lo, min(hi, int(round(v / 64.0)) * 64))


def _axis_cells(total: int, count: int) -> List[Tuple[int, int]]:
    """Split `total` px into `count` cells. Every cell is a multiple of 64,
    the cells differ by at most one 64-px step and they always sum to exactly
    `total` (no lopsided 'last cell absorbs everything' remainder)."""
    count = max(1, count)
    total = max(1, int(total))
    k = total // 64                      # total in 64-px units
    if k < 1:
        return [(0, total)]
    count = max(1, min(count, k))        # at least 64 px per cell
    q, r = divmod(k, count)
    cells: List[Tuple[int, int]] = []
    x = 0
    for i in range(count):
        w = (q + (1 if i < r else 0)) * 64
        cells.append((x, w))
        x += w
    if x < total:                        # only when total is not a 64 multiple
        cx, cw = cells[-1]
        cells[-1] = (cx, cw + (total - x))
    return cells


def plan_tile_grid(src_w: int, src_h: int, scale: float, overlap: int,
                   budget: int = MEGAPIXEL_BUDGET) -> Dict[str, Any]:
    """Plan an overlapping tile grid for a tiled upscale.

    Rules (fixing the old 'square image, non-square grid' bug):
    * the canvas is src * scale, snapped to a multiple of 64;
    * the core cell target is derived from the megapixel budget *minus* the
      overlap on both sides, so every tile as actually sent (core + overlap)
      stays within the budget;
    * cols and rows use the same core target, so a square source always gets
      a square N\u00d7N grid of ~square tiles, and a wide source gets
      proportionally more columns than rows;
    * cells are distributed evenly (each a multiple of 64, summing exactly);
    * a safety loop grows the grid - both axes together for square canvases -
      if any tile still exceeds the budget.
    """
    out_w = snap64(src_w * scale, hi=16384)
    out_h = snap64(src_h * scale, hi=16384)
    # The Horde API only accepts width/height that are multiples of 64 (the
    # canvas and the core cells already are), so the overlap must be too -
    # otherwise the tile sizes cut from the canvas (core +/- overlap) stop
    # being 64-aligned and every img2img payload is refused with a
    # "payload verification failed" 400. Snap whatever the user typed.
    ov = max(0, int(round(int(overlap) / 64.0)) * 64)
    edge = math.sqrt(max(1.0, float(budget)))
    core_target = max(64.0, edge - 2.0 * ov)
    cols = max(1, math.ceil(out_w / core_target))
    rows = max(1, math.ceil(out_h / core_target))
    square = abs(out_w - out_h) <= 64
    tiles: List[Dict[str, Any]] = []
    for _ in range(128):
        cols = max(1, min(cols, max(1, out_w // 64)))
        rows = max(1, min(rows, max(1, out_h // 64)))
        cells_x = _axis_cells(out_w, cols)
        cells_y = _axis_cells(out_h, rows)
        tiles = []
        for r, (cy, ch) in enumerate(cells_y):
            for c, (cx, cw) in enumerate(cells_x):
                x0, x1 = max(0, cx - ov), min(out_w, cx + cw + ov)
                y0, y1 = max(0, cy - ov), min(out_h, cy + ch + ov)
                tiles.append({
                    "row": r, "col": c, "x": x0, "y": y0, "w": x1 - x0, "h": y1 - y0,
                    "core_x": cx, "core_y": cy, "core_w": cw, "core_h": ch,
                })
        if all(t["w"] * t["h"] <= budget for t in tiles) or (cols >= 64 and rows >= 64):
            break
        if square:
            # keep square canvases on a square grid while shrinking the tiles
            cols += 1
            rows += 1
        else:
            wide = max(t["w"] for t in tiles) / max(1, max(t["h"] for t in tiles))
            if wide > 1.05:
                cols += 1
            elif wide < 0.95:
                rows += 1
            else:
                cols += 1
                rows += 1
    sx = out_w / max(1, src_w)
    sy = out_h / max(1, src_h)
    for t in tiles:
        t["src_rect"] = tile_source_rect(t, src_w, src_h, out_w, out_h)
    return {"out_w": out_w, "out_h": out_h, "cols": cols, "rows": rows,
            "overlap": ov, "scale_x": sx, "scale_y": sy, "tiles": tiles}


def tile_source_rect(tile: Dict[str, Any], src_w: int, src_h: int,
                     out_w: int, out_h: int) -> Tuple[int, int, int, int]:
    """Integer source-image rect that corresponds to a planned output tile."""
    sx, sy = out_w / max(1, src_w), out_h / max(1, src_h)
    x0 = int(round(tile["x"] / sx))
    y0 = int(round(tile["y"] / sy))
    x1 = int(round((tile["x"] + tile["w"]) / sx))
    y1 = int(round((tile["y"] + tile["h"]) / sy))
    x0, y0 = max(0, x0), max(0, y0)
    x1, y1 = min(src_w, x1), min(src_h, y1)
    if x1 - x0 < 8 or y1 - y0 < 8:      # degenerate guard
        x0, x1 = max(0, min(x0, src_w - 8)), max(x0 + 8, x1)
        y0, y1 = max(0, min(y0, src_h - 8)), max(y0 + 8, y1)
    return x0, y0, x1 - x0, y1 - y0


def _ramp_bounds(e_a: int, e_b: int, span: int) -> Tuple[float, float]:
    """Gradient stop positions for a feather ramp with `e_a` transparent px at
    the start and `e_b` transparent px at the end. When the two feather zones
    overlap (tiny tiles) the ramps are merged symmetrically so the gradient
    stops never go out of order."""
    a = 0.0 if e_a <= 0 else min(1.0, e_a / max(1, span))
    b = 1.0 if e_b <= 0 else max(0.0, (span - e_b) / max(1, span))
    if a > b:
        a = b = max(0.0, min(1.0, (a + b) / 2.0))
    return a, b


def _feathered_tile(tile_img: QImage, e_l: int, e_t: int, e_r: int, e_b: int) -> QImage:
    """Return a copy of the tile whose alpha ramps from 0 at the tile edge to
    opaque at the core boundary, so overlapping tiles cross-fade smoothly."""
    tw, th = tile_img.width(), tile_img.height()
    img = tile_img.convertToFormat(QImage.Format.Format_ARGB32_Premultiplied)
    if not (e_l or e_t or e_r or e_b):
        return img

    def ramp_mask(horizontal: bool, e_a: int, e_b_: int) -> QImage:
        span = tw if horizontal else th
        mask = QImage(tw, th, QImage.Format.Format_ARGB32_Premultiplied)
        mask.fill(Qt.GlobalColor.transparent)
        mp = QPainter(mask)
        g = QLinearGradient(0, 0, tw, 0) if horizontal else QLinearGradient(0, 0, 0, th)
        opaque = QColor(255, 255, 255, 255)
        clear = QColor(255, 255, 255, 0)
        a, b = _ramp_bounds(e_a, e_b_, span)
        g.setColorAt(0.0, clear if e_a > 0 else opaque)
        g.setColorAt(a, opaque)
        g.setColorAt(b, opaque)
        g.setColorAt(1.0, clear if e_b_ > 0 else opaque)
        mp.fillRect(QRect(0, 0, tw, th), QBrush(g))
        mp.end()
        return mask

    p = QPainter(img)
    p.setCompositionMode(QPainter.CompositionMode.CompositionMode_DestinationIn)
    if e_l or e_r:
        p.drawImage(0, 0, ramp_mask(True, e_l, e_r))
    if e_t or e_b:
        p.drawImage(0, 0, ramp_mask(False, e_t, e_b))
    p.end()
    return img


def merge_tiles(tiles: List[Dict[str, Any]], out_w: int, out_h: int,
                base_path: Optional[str] = None) -> QImage:
    """Assemble the final image A1111-style. The neural base (the whole
    image after its single Alchemy/Lanczos upscale) is laid down first, then
    every finished tile is drawn over it with smooth feathered transitions
    on the borders (no visible seams). A tile that is missing or failed
    simply leaves the base detail in place - no holes, no purple gaps.
    Tiles are drawn row-major; every point of the canvas is covered by at
    least one fully opaque tile core, so nothing leaks through."""
    canvas = QImage(out_w, out_h, QImage.Format.Format_ARGB32_Premultiplied)
    base = QImage(base_path) if base_path else QImage()
    if not base.isNull():
        if base.width() != out_w or base.height() != out_h:
            base = hq_resize(base, out_w, out_h)
        cp = QPainter(canvas)
        cp.drawImage(0, 0, base.convertToFormat(QImage.Format.Format_ARGB32_Premultiplied))
        cp.end()
    else:
        canvas.fill(Qt.GlobalColor.black)
    cp = QPainter(canvas)
    try:
        for t in sorted(tiles, key=lambda t: (t.get("row", 0), t.get("col", 0))):
            path = t.get("path") or t.get("tile_path") or ""
            img = QImage(path)
            if img.isNull():
                raise HordeError(f"cannot read tile {path}")
            if img.width() != t["w"] or img.height() != t["h"]:
                img = hq_resize(img, t["w"], t["h"])
            e_l = t["core_x"] - t["x"]
            e_t = t["core_y"] - t["y"]
            e_r = (t["x"] + t["w"]) - (t["core_x"] + t["core_w"])
            e_b = (t["y"] + t["h"]) - (t["core_y"] + t["core_h"])
            feathered = _feathered_tile(img, e_l, e_t, e_r, e_b)
            cp.drawImage(t["x"], t["y"], feathered)
    finally:
        cp.end()          # never leave an active painter on the canvas
    return canvas.convertToFormat(QImage.Format.Format_ARGB32)


# =============================================================================
#  Queue manager + list model
# =============================================================================
class QueueManager(QAbstractListModel):
    image_ready = pyqtSignal(str)          # path of a freshly stored temp image
    log = pyqtSignal(str)
    summary_changed = pyqtSignal()
    job_finished = pyqtSignal(int, str)    # local_id, final state

    def __init__(self, api: HordeAPI, store: ImageStore, parent=None):
        super().__init__(parent)
        self.api = api
        self.store = store
        self.jobs: List[Job] = []
        self.workers: Dict[int, QThread] = {}
        self.max_parallel = 2
        self.poll_interval = 2.5
        self.save_direct = False
        self.paused = False
        self._timer = QTimer(self)
        self._timer.setInterval(500)
        self._timer.timeout.connect(self._tick)
        self._timer.start()

    # --- Qt model -------------------------------------------------------------
    def rowCount(self, parent: QModelIndex = QModelIndex()) -> int:  # noqa: N802
        return 0 if parent.isValid() else len(self.jobs)

    def data(self, index: QModelIndex, role: int = Qt.ItemDataRole.DisplayRole) -> Any:
        if not index.isValid() or not (0 <= index.row() < len(self.jobs)):
            return None
        job = self.jobs[index.row()]
        if role == Qt.ItemDataRole.DisplayRole:
            return job.title()
        if role == Qt.ItemDataRole.UserRole:
            return job
        if role == Qt.ItemDataRole.ToolTipRole:
            if job.kind == KIND_GROUP:
                m = job.meta
                a = job.agg
                lines = [
                    f"Tile Upscale run #{job.local_id}",
                    f"{m.get('src_name', '?')}  {m.get('src_w')}\u00d7{m.get('src_h')}  \u25B8  "
                    f"{m.get('out_w')}\u00d7{m.get('out_h')}  (\u00d7{m.get('scale', 1):.2f})",
                    f"base: {m.get('upscaler_label', '?')} pass on the whole image, then Lanczos to size",
                    f"{m.get('cols')}\u00d7{m.get('rows')} = {a.get('total', '?')} tiles  \u2022  "
                    f"overlap {m.get('overlap', 0)} px",
                    f"img2img model: {m.get('model_label', m.get('model', '?'))}",
                    f"{a.get(TILE_DONE, 0)} done \u2022 {a.get(TILE_REFINING, 0)} refining \u2022 "
                    f"{a.get(TILE_UPSCALED, 0)} ready \u2022 "
                    f"{a.get(TILE_FAILED, 0)} failed",
                ]
                if job.message:
                    lines.append(job.message)
                return "\n".join(lines)
            lines = [f"#{job.local_id}  {job.meta.get('model')}  {job.meta.get('width')}\u00d7{job.meta.get('height')}",
                     job.meta.get("prompt", "")]
            if job.meta.get("negative"):
                lines.append("Negative: " + job.meta["negative"])
            if job.kind == KIND_ALCH:
                lines.append(f"Alchemy upscaler: {job.meta.get('upscaler_label', '')} "
                             f"(\u00d7{job.meta.get('factor', '?')})")
                lines.append(f"part {job.meta.get('width')}\u00d7{job.meta.get('height')} \u2192 "
                             f"tile {job.meta.get('tile_w')}\u00d7{job.meta.get('tile_h')}")
            if job.horde_id:
                lines.append("Horde id: " + job.horde_id)
            lines += job.warnings
            if job.message:
                lines.append(job.message)
            return "\n".join(lines)
        return None

    def _row_of(self, local_id: int) -> int:
        for i, j in enumerate(self.jobs):
            if j.local_id == local_id:
                return i
        return -1

    def job_by_id(self, local_id: int) -> Optional[Job]:
        r = self._row_of(local_id)
        return self.jobs[r] if r >= 0 else None

    def _emit_row(self, row: int) -> None:
        if 0 <= row < len(self.jobs):
            idx = self.index(row)
            self.dataChanged.emit(idx, idx)
        self.summary_changed.emit()

    # --- insertion order --------------------------------------------------------
    # Tile-upscale group headers float on top of the queue, in creation order,
    # each followed by its own inner jobs; normal requests follow underneath.
    def _group_block_end(self, header_row: int) -> int:
        gid = self.jobs[header_row].group_id
        end = header_row + 1
        while end < len(self.jobs) and self.jobs[end].kind != KIND_GROUP and self.jobs[end].group_id == gid:
            end += 1
        return end

    def _insert_row(self, job: Job) -> int:
        if job.kind == KIND_GROUP:
            row, i = 0, 0
            while i < len(self.jobs):
                if self.jobs[i].kind == KIND_GROUP:
                    i = self._group_block_end(i)
                    row = i
                else:
                    break
            return row
        if job.group_id is not None:
            for i, j in enumerate(self.jobs):
                if j.kind == KIND_GROUP and j.group_id == job.group_id:
                    return self._group_block_end(i)
            return len(self.jobs)
        return len(self.jobs)

    # --- public API -------------------------------------------------------------
    def enqueue(self, payload: Dict[str, Any], meta: Dict[str, Any],
                kind: str = KIND_GEN, group_id: Optional[int] = None) -> Job:
        job = Job(payload=payload, meta=meta, kind=kind, group_id=group_id)
        row = self._insert_row(job)
        self.beginInsertRows(QModelIndex(), row, row)
        self.jobs.insert(row, job)
        self.endInsertRows()
        self.log.emit(f"#{job.local_id} queued: {job.title()}")
        self.summary_changed.emit()
        return job

    def jobs_in_group(self, gid: int) -> List[Job]:
        return [j for j in self.jobs if j.group_id == gid and j.kind != KIND_GROUP]

    def group_job(self, gid: int) -> Optional[Job]:
        for j in self.jobs:
            if j.kind == KIND_GROUP and j.group_id == gid:
                return j
        return None

    def touch_group(self, gid: int) -> None:
        gj = self.group_job(gid)
        if gj is not None:
            self._emit_row(self._row_of(gj.local_id))
        else:
            self.summary_changed.emit()

    def cancel(self, job: Job) -> None:
        if job.kind == KIND_GROUP:
            for ij in self.jobs_in_group(job.group_id or job.local_id):
                if ij.local_id in self.workers:
                    self.workers[ij.local_id].cancel()
                    ij.message = "Cancelling\u2026"
                elif ij.state == STATE_QUEUED:
                    ij.state = STATE_CANCELLED
                    ij.ended = time.time()
                    self.job_finished.emit(ij.local_id, STATE_CANCELLED)
            job.state = STATE_CANCELLED
            job.ended = time.time()
            job.message = "Run cancelled - waiting for the running tiles to stop"
            self.log.emit(f"#{job.local_id} tile upscale run cancelled")
            self.job_finished.emit(job.local_id, STATE_CANCELLED)
            self._emit_row(self._row_of(job.local_id))
            return
        if job.local_id in self.workers:
            self.workers[job.local_id].cancel()
            job.message = "Cancelling\u2026"
        elif job.state == STATE_QUEUED:
            job.state = STATE_CANCELLED
            job.ended = time.time()
            self.job_finished.emit(job.local_id, STATE_CANCELLED)
        self._emit_row(self._row_of(job.local_id))

    def cancel_all(self) -> None:
        for job in list(self.jobs):
            if job.active or job.state == STATE_QUEUED:
                self.cancel(job)

    def retry(self, job: Job) -> Optional[Job]:
        if job.active or job.kind == KIND_GROUP:
            return None
        if job.state == STATE_FAILED:
            # Restart in place: the old failed entry disappears and is replaced
            # by the fresh attempt in the same slot of the queue.
            job.reset_for_retry()
            self._emit_row(self._row_of(job.local_id))
            self.log.emit(f"#{job.local_id} restarted (failed attempt replaced)")
            return job
        return self.enqueue(json.loads(json.dumps(job.payload)), dict(job.meta),
                            kind=job.kind, group_id=job.group_id)

    def remove(self, job: Job) -> None:
        if job.active:
            return
        row = self._row_of(job.local_id)
        if row < 0:
            return
        if job.kind == KIND_GROUP:
            gid = job.group_id or job.local_id
            inners = self.jobs_in_group(gid)
            if any(j.active or j.state == STATE_QUEUED for j in inners):
                self.log.emit(f"#{job.local_id} still has running tiles - cancel it first")
                return
            end = row + 1 + len(inners)
            block = self.jobs[row + 1:end]
            if all(j.group_id == gid for j in block):   # contiguous block
                self.beginRemoveRows(QModelIndex(), row, end - 1)
                del self.jobs[row:end]
                self.endRemoveRows()
            else:                                        # fallback: piecemeal
                for j in inners:
                    r = self._row_of(j.local_id)
                    if r >= 0 and not j.active:
                        self.beginRemoveRows(QModelIndex(), r, r)
                        del self.jobs[r]
                        self.endRemoveRows()
                r = self._row_of(job.local_id)
                if r >= 0:
                    self.beginRemoveRows(QModelIndex(), r, r)
                    del self.jobs[r]
                    self.endRemoveRows()
            self.summary_changed.emit()
            return
        self.beginRemoveRows(QModelIndex(), row, row)
        del self.jobs[row]
        self.endRemoveRows()
        self.summary_changed.emit()

    def clear_finished(self) -> None:
        keep = [j for j in self.jobs if j.active or j.state == STATE_QUEUED]
        if len(keep) == len(self.jobs):
            return
        self.beginResetModel()
        self.jobs = keep
        self.endResetModel()
        self.summary_changed.emit()

    def move(self, job: Job, delta: int) -> None:
        if job.kind == KIND_GROUP or job.group_id is not None:
            self.log.emit("tile-upscale rows are ordered automatically and stay on top")
            return
        row = self._row_of(job.local_id)
        new = row + delta
        if row < 0 or not (0 <= new < len(self.jobs)):
            return
        if self.jobs[new].kind == KIND_GROUP or self.jobs[new].group_id is not None:
            self.log.emit("tile-upscale rows are ordered automatically and stay on top")
            return
        dest = new + 1 if delta > 0 else new
        if not self.beginMoveRows(QModelIndex(), row, row, QModelIndex(), dest):
            return
        self.jobs.insert(new, self.jobs.pop(row))
        self.endMoveRows()
        self.summary_changed.emit()

    def set_paused(self, paused: bool) -> None:
        self.paused = paused
        self.summary_changed.emit()

    def counts(self) -> Dict[str, int]:
        c = {"queued": 0, "active": 0, "done": 0, "failed": 0, "cancelled": 0, "upscales": 0}
        for j in self.jobs:
            if j.kind == KIND_GROUP:
                if j.state in ACTIVE_STATES:
                    c["upscales"] += 1
                continue
            if j.state == STATE_QUEUED:
                c["queued"] += 1
            elif j.active:
                c["active"] += 1
            elif j.state == STATE_DONE:
                c["done"] += 1
            elif j.state == STATE_FAILED:
                c["failed"] += 1
            else:
                c["cancelled"] += 1
        return c

    def eta(self) -> Optional[int]:
        vals = [j.wait_time for j in self.jobs if j.active and j.wait_time is not None]
        return max(vals) if vals else None

    def shutdown(self, wait_ms: int = 2500) -> None:
        self._timer.stop()
        for w in list(self.workers.values()):
            w.cancel()
        for w in list(self.workers.values()):
            w.wait(wait_ms)

    # --- scheduling -------------------------------------------------------------
    def _tick(self) -> None:
        now = time.time()
        refreshed = False
        for job in self.jobs:
            if job.active or (job.state == STATE_QUEUED and job.retry_after > now):
                refreshed = True
        if refreshed:
            # keep countdowns / timers moving
            if self.jobs:
                self.dataChanged.emit(self.index(0), self.index(len(self.jobs) - 1))
            self.summary_changed.emit()
        if self.paused:
            return
        running = len(self.workers)
        for job in self.jobs:
            if running >= self.max_parallel:
                break
            if job.kind == KIND_GROUP:
                continue          # the run row itself is never a request
            if job.state == STATE_QUEUED and job.retry_after <= now:
                self._start(job)
                running += 1

    def _start(self, job: Job) -> None:
        job.attempts += 1
        job.message = ""
        if job.kind == KIND_ALCH:
            worker: QThread = AlchemyJobWorker(job, self.api, self.poll_interval)
        else:
            worker = JobWorker(job, self.api, self.store, self.poll_interval, self.save_direct)
        worker.progress.connect(self._on_progress)
        worker.completed.connect(self._on_completed)
        worker.failed.connect(self._on_failed)
        worker.log.connect(self.log)
        worker.finished.connect(lambda jid=job.local_id: self._on_thread_done(jid))
        self.workers[job.local_id] = worker
        job.state = STATE_SUBMITTING
        worker.start()
        self._emit_row(self._row_of(job.local_id))

    def _on_progress(self, local_id: int, fields: Dict[str, Any]) -> None:
        job = self.job_by_id(local_id)
        if not job:
            return
        for k, v in fields.items():
            setattr(job, k, v)
        self._emit_row(self._row_of(local_id))

    def _on_completed(self, local_id: int, paths: List[str], state: str) -> None:
        job = self.job_by_id(local_id)
        if not job:
            return
        job.results = list(paths)
        job.state = state
        job.ended = time.time()
        job.message = ""
        for p in paths:
            self.image_ready.emit(p)
        self.log.emit(f"#{local_id} {state}: {len(paths)} image(s)")
        self._emit_row(self._row_of(local_id))
        self.job_finished.emit(local_id, state)

    def _on_failed(self, local_id: int, message: str, retry_delay: float) -> None:
        job = self.job_by_id(local_id)
        if not job:
            return
        job.message = message
        if retry_delay > 0 and job.attempts < 20:
            job.state = STATE_QUEUED
            job.retry_after = time.time() + retry_delay
            self.log.emit(f"#{local_id} deferred {retry_delay:.0f}s: {message}")
        else:
            job.state = STATE_FAILED
            job.ended = time.time()
            self.log.emit(f"#{local_id} failed: {message}")
            self.job_finished.emit(local_id, STATE_FAILED)
        self._emit_row(self._row_of(local_id))

    def _on_thread_done(self, local_id: int) -> None:
        w = self.workers.pop(local_id, None)
        if w is not None:
            w.deleteLater()
        job = self.job_by_id(local_id)
        if job and job.active:  # thread died without a verdict
            job.state = STATE_FAILED
            job.ended = time.time()
            job.message = job.message or "Worker stopped unexpectedly"
            self._emit_row(self._row_of(local_id))
        self.summary_changed.emit()


