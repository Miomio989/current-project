class AudioEngine:
    """
    Production-grade non-blocking audio manager:
      - Streams pre-synthesized 1-bar PCM chunks from a daemon worker thread
        directly into a dedicated Pygame mixer BGM channel with zero stutter.
      - Mixes 58 pre-synthesized SFX across 14 polyphonic sound channels with
        stereo spatial panning based on fighter world X position!
      - Gracefully runs in silent null-safe mode when audio device is absent.
    """

    def __init__(self, settings: GameSettings) -> None:
        self.settings = settings
        self.enabled: bool = False
        self.dsp = HyperBreakbeatDSP(AUDIO_SAMPLE_RATE)
        self.scores: Dict[OSTTrackId, OSTComposition] = _build_all_ost_scores()
        self.sfx_bank: Dict[SFXId, pygame.mixer.Sound] = {}

        self._bgm_channel: Optional[pygame.mixer.Channel] = None
        self._current_track: Optional[OSTTrackId] = None
        self._current_bar_idx: int = 0
        self._chunk_queue: "queue.Queue[Tuple[OSTTrackId, pygame.mixer.Sound]]" = queue.Queue(maxsize=4)
        self._stop_event = threading.Event()
        self._track_lock = threading.Lock()
        self._worker_thread: Optional[threading.Thread] = None
        self._init_mixer()

    def _init_mixer(self) -> None:
        try:
            if not pygame.mixer.get_init():
                pygame.mixer.init(
                    frequency=AUDIO_SAMPLE_RATE,
                    size=-16,
                    channels=AUDIO_CHANNELS,
                    buffer=AUDIO_BUFFER_SIZE,
                )
            pygame.mixer.set_num_channels(16)
            self._bgm_channel = pygame.mixer.Channel(0)
            self.sfx_bank = self.dsp.synthesize_all_sfx()
            self.enabled = True
            self._worker_thread = threading.Thread(target=self._bgm_stream_worker, daemon=True)
            self._worker_thread.start()
        except Exception:
            self.enabled = False

    def _bgm_stream_worker(self) -> None:
        while not self._stop_event.is_set():
            with self._track_lock:
                track = self._current_track
                bar_i = self._current_bar_idx
            if track is None or self._chunk_queue.full():
                time.sleep(0.025)
                continue
            comp = self.scores[track]
            bar_spec = comp.bars[bar_i % len(comp.bars)]
            pcm = self.dsp.render_bar_pcm(bar_spec, comp.bpm)
            snd = pygame.mixer.Sound(buffer=pcm)
            with self._track_lock:
                if self._current_track == track:
                    self._current_bar_idx = (bar_i + 1) % len(comp.bars)
                    try:
                        self._chunk_queue.put_nowait((track, snd))
                    except queue.Full:
                        pass

    def play_ost(self, track: OSTTrackId, force_restart: bool = False) -> None:
        if not self.enabled:
            return
        with self._track_lock:
            if self._current_track == track and not force_restart:
                return
            self._current_track = track
            self._current_bar_idx = 0
            self.dsp._reset_stream_state()
            while not self._chunk_queue.empty():
                try:
                    self._chunk_queue.get_nowait()
                except queue.Empty:
                    break
        if self._bgm_channel is not None:
            self._bgm_channel.stop()

    def stop_ost(self) -> None:
        with self._track_lock:
            self._current_track = None
        if self._bgm_channel is not None:
            self._bgm_channel.stop()

    def update(self) -> None:
        """Keep the BGM channel seamlessly queued every frame (zero stalls)."""
        if not self.enabled or self._bgm_channel is None:
            return
        vol = clamp(self.settings.master_volume * self.settings.bgm_volume, 0.0, 1.0)
        self._bgm_channel.set_volume(vol)
        if not self._bgm_channel.get_busy():
            self._pop_and_play_chunk(as_queue=False)
        elif self._bgm_channel.get_queue() is None:
            self._pop_and_play_chunk(as_queue=True)

    def _pop_and_play_chunk(self, as_queue: bool) -> None:
        if self._bgm_channel is None:
            return
        try:
            tr, snd = self._chunk_queue.get_nowait()
        except queue.Empty:
            return
        if tr != self._current_track:
            return
        if as_queue:
            self._bgm_channel.queue(snd)
        else:
            self._bgm_channel.play(snd)

    def play_sfx(
        self, sfx: SFXId, pan: float = 0.0, gain: float = 1.0
    ) -> None:
        if not self.enabled:
            return
        snd = self.sfx_bank.get(sfx)
        if snd is None:
            return
        vol = clamp(self.settings.master_volume * self.settings.sfx_volume * gain, 0.0, 1.0)
        if vol <= 0.005:
            return
        ch = pygame.mixer.find_channel(True)
        if ch is None or ch == self._bgm_channel:
            ch = pygame.mixer.Channel(1)
        p = clamp(pan, -1.0, 1.0)
        l_vol = vol * clamp(1.0 - max(0.0, p) * 0.55, 0.25, 1.0)
        r_vol = vol * clamp(1.0 + min(0.0, p) * 0.55, 0.25, 1.0)
        ch.set_volume(l_vol, r_vol)
        ch.play(snd)

    def shutdown(self) -> None:
        self._stop_event.set()
        if self._bgm_channel is not None:
            self._bgm_channel.stop()
