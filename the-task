    def _render_pattern_loop(self, drum_pat: Tuple[int, ...], include_acid: bool, include_lead: bool, include_drone: bool) -> List[float]:
        """Renders a seamless 4-bar (64 sixteenth-note) loop at exactly 172.0 BPM."""
        step_sec = (60.0 / STAGE_BPM) / 4.0  # 16th note duration
        total_n = int(round(step_sec * 64.0 * AUDIO_SR))
        buf = [0.0] * total_n

        # Pre-synth one-shot percussion voices
        k_soft = DSPVoice.synth_kick(0.22, False)
        k_hard = DSPVoice.synth_kick(0.24, True)
        sn = DSPVoice.synth_snare(0.15, False)
        sn_g = DSPVoice.synth_snare(0.10, True)
        ch = DSPVoice.synth_hat(0.055, False)
        oh = DSPVoice.synth_hat(0.15, True)
        bell = DSPVoice.synth_temple_bell(293.66, 0.85)
        taiko = DSPVoice.synth_kick(0.32, False)

        def mix_in(start_idx: int, clip: List[float], vol: float = 1.0) -> None:
            ln = len(clip)
            for k in range(ln):
                idx = (start_idx + k) % total_n
                buf[idx] += clip[k] * vol

        # 1. Ritual Long-Horn D2 Drone Bed (Prelude ominous atmosphere)
        if include_drone:
            d2 = midi_to_hz(38)
            for i in range(total_n):
                t = i / float(AUDIO_SR)
                lfo = 0.72 + 0.28 * math.sin(math.tau * t * (BEATS_PER_SEC * 0.25))
                horn = (math.sin(math.tau * d2 * t) * 0.55 +
                        math.sin(math.tau * d2 * 2.0 * t) * 0.22 +
                        math.sin(math.tau * d2 * 1.5 * t) * 0.14)
                buf[i] += horn * lfo * 0.24

        # 2. Step-sequenced drums, acid 303 bass, and trance lead
        for step in range(64):
            pos = int(round(step * step_sec * AUDIO_SR))
            dcode = drum_pat[step]
            if dcode == 1:
                mix_in(pos, k_soft, 0.82)
            elif dcode == 2:
                mix_in(pos, k_hard, 0.92)
            elif dcode == 3:
                mix_in(pos, sn, 0.72)
            elif dcode == 4:
                mix_in(pos, sn_g, 0.52)
            elif dcode == 5:
                mix_in(pos, ch, 0.48)
            elif dcode == 6:
                mix_in(pos, oh, 0.50)
            elif dcode == 7:
                mix_in(pos, bell, 0.42)
            elif dcode == 8:
                mix_in(pos, taiko, 0.78)

            if include_acid:
                note = SCORE_ACID_BASS[step]
                if note > 0:
                    acid = DSPVoice.synth_acid_step(midi_to_hz(note), step_sec * 1.35, accent=(step % 8 == 0 or note >= 45))
                    mix_in(pos, acid, 0.56)

            if include_lead:
                lnote = SCORE_TRANCE_LEAD[step]
                if lnote > 0:
                    lead = DSPVoice.synth_trance_lead(midi_to_hz(lnote), step_sec * 1.6)
                    mix_in(pos, lead, 0.44)

        # Soft limiter pass for clean punchy club/fighting-game loudness
        for i in range(total_n):
            buf[i] = math.tanh(buf[i] * 1.15) * 0.88
        return buf

    def _build_music_stems(self) -> None:
        self.stems["prelude"] = DSPVoice.make_sound(
