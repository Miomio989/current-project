        self._st_state_cache: Dict[str, Any] = {}
        self._server_status_timer = QTimer(self)
        self._server_status_timer.setInterval(2000)
        self._server_status_timer.timeout.connect(self._update_server_status)
        self._server_status_timer.start()
        # tag-group colour spans inside the prompt / negative editors
        self.prompt_book = SpanBook()
        self.neg_book = SpanBook()
        # tile upscale (UPSCALE tab): every run is a queue group; the runs
        # dict holds the plan, tile states, previews and job mappings.
        self.ups_source: Optional[str] = None
        self.ups_source_meta: Dict[str, Any] = {}
        self.ups_groups: Dict[int, Dict[str, Any]] = {}
        self.ups_active_gid: Optional[int] = None
        self._ups_live_plan_text = ""
        self._ups_refresh_timer = QTimer(self)
        self._ups_refresh_timer.setSingleShot(True)
        self._ups_refresh_timer.setInterval(160)
        self._ups_refresh_timer.timeout.connect(self._ups_refresh_now)
        self._save_timer = QTimer(self)
        self._save_timer.setSingleShot(True)
        self._save_timer.setInterval(900)
        self._save_timer.timeout.connect(self.save_now)
        # LLM settings live in their own file (llm_settings.json)
        self.llm_settings = load_llm_settings()
        self._llm_save_timer = QTimer(self)
        self._llm_save_timer.setSingleShot(True)
        self._llm_save_timer.setInterval(700)
        self._llm_save_timer.timeout.connect(self.save_llm_now)
        # v1.8.0 per-model LoRA stacks: Anima Turbo and Krea 2 Turbo each keep
        # their OWN LoRA list (a v1.7 settings file with one plain list is
        # migrated into both stacks).
        self._lora_stacks: Dict[str, List[Dict[str, Any]]] = {"anime": [], "krea": []}
        _raw_loras = self.settings.get("loras")
        if isinstance(_raw_loras, list):               # v1.7 layout
            self._lora_stacks = {"anime": list(_raw_loras), "krea": list(_raw_loras)}
        elif isinstance(_raw_loras, dict):
            for k, v in _raw_loras.items():
                if k in self._lora_stacks and isinstance(v, list):
                    self._lora_stacks[k] = v
        self._lora_stack_key = "krea"                 # corrected in _apply_settings
        self._lora_filling = False                    # True while the table is rebuilt
        # v1.8.0 viewer slideshow (3 s per image, works on both right tabs)
        self._slide_timer = QTimer(self)
        self._slide_timer.setInterval(3000)
        self._slide_timer.timeout.connect(self._slide_step)

        self.setWindowTitle(f"{APP_NAME}  \u2014  AI Horde client")
        self.setMinimumSize(800, 600)      # small-laptop floor (800×600)
        self._build_ui()
        # coloured tag spans in the prompt editors
        self.prompt_hl = SpanHighlighter(self.prompt_book, self.prompt_edit.document())
        self.neg_hl = SpanHighlighter(self.neg_book, self.neg_edit.document())
        # thread-safe log bridge for HordeAPI retry diagnostics
        self._api_log_bridge = _LogBridge(self)
        self._api_log_bridge.logged.connect(self.append_log)
        self.api.log_hook = self._api_log_bridge.logged.emit
        # clicking a TILE UPSCALE row selects that run for the UPSCALE tab
        self.queue_view.clicked.connect(self._queue_clicked)
        self.mini_queue.clicked.connect(self._queue_clicked)
        self._build_menu()
        self._wire_shortcuts()
        self._apply_settings()
        self.load_templates()
        self.load_tags()
        self.refresh_gallery()
        self._loading = False
        self._update_preview()
        self._update_summary()
        if self.store.orphans_cleaned:
            self.append_log(f"start-up: removed {self.store.orphans_cleaned} orphan metadata file(s)")
        QTimer.singleShot(300, self.startup_network)

