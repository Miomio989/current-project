class DarkmoonArchive:
    """Tracks lifetime session combat achievements, records, and BPM visual pulse."""

    def __init__(self) -> None:
        self.matches_played: int = 0
        self.matches_won: int = 0
        self.arcade_clears: int = 0
        self.best_arcade_score: int = 0
        self.best_survival_wave: int = 0
        self.best_combo_hits: int = 0
        self.best_combo_damage: int = 0
        self.lifetime_damage: int = 0
        self.lifetime_just_guards: int = 0
        self.lifetime_parries: int = 0
        self.lifetime_clashes: int = 0
        self.lifetime_ruptures: int = 0
        self.lifetime_fatals: int = 0
        self.best_rank: StyleRank = StyleRank.NONE
        self.beat_clock_sec: float = 0.0

    def record_match_result(
        self, p1_stats: MatchStats, p1_won: bool, survival_wave: int = 0
    ) -> None:
        self.matches_played += 1
        if p1_won:
            self.matches_won += 1
        self.best_survival_wave = max(self.best_survival_wave, survival_wave)
        self.best_combo_hits = max(self.best_combo_hits, p1_stats.max_combo)
        self.best_combo_damage = max(self.best_combo_damage, p1_stats.max_combo_damage)
        self.lifetime_damage += p1_stats.damage_dealt
        self.lifetime_just_guards += p1_stats.just_guards
        self.lifetime_parries += p1_stats.parries
        self.lifetime_clashes += p1_stats.weapon_clashes
        self.lifetime_ruptures += p1_stats.curse_ruptures
        self.lifetime_fatals += p1_stats.fatal_executions
        if p1_stats.highest_rank.tier > self.best_rank.tier:
            self.best_rank = p1_stats.highest_rank

    def record_arcade_clear(self, total_score: int) -> None:
        self.arcade_clears += 1
        self.best_arcade_score = max(self.best_arcade_score, total_score)

    def tick_beat(self, dt: float, bpm: float = 146.0) -> float:
        """Advance beat clock and return crisp [0..1] rhythmic pulse envelope."""
        self.beat_clock_sec += dt
        beats_per_sec = bpm / 60.0
        frac = (self.beat_clock_sec * beats_per_sec) % 1.0
        return math.exp(-frac * 4.8)


