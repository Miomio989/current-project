    def _tick_match(self, keys: Sequence[bool], pressed: set) -> None:
        if self.match is None:
            self.mode = "title"
            return
        if pg_locals.K_ESCAPE in pressed:
            self.mode = "title"
            return
        if self.match.phase == "match_end" and (pg_locals.K_RETURN in pressed or pg_locals.K_j in pressed or pg_locals.K_SPACE in pressed):
            self._start_match()
            return

        a0 = self._read_player_inputs(keys, pressed, 0)
        a1 = self._read_player_inputs(keys, pressed, 1)
        self.match.step(a0, a1)

        if self.use_opengl:
            self.canvas.fill((0, 0, 0, 0))
        else:
            self.renderer.render_stage_software(
                self.canvas, self.match.camera, self.match.stage_area,
                self.match.get_lighting_script_key(), self.match.beat_pulse, self.match.world_t, self.match.fighters
            )
            for f in self.match.fighters:
                self.renderer.render_fighter_software(
                    self.canvas, self.match.camera, f, self.match.get_lighting_script_key(), self.match.beat_pulse
                )
            self._draw_particles_and_projectiles(self.canvas, self.match)

        self.hud.draw_match_hud(self.canvas, self.match)
        if self.match.phase == "match_end":
            rem = self.hud.font_hud.render("PRESS ENTER / [J] FOR INSTANT REMATCH   |   ESC FOR TITLE", True, (255, 232, 168))
            self.canvas.blit(rem, (INTERNAL_W // 2 - rem.get_width() // 2, INTERNAL_H - 135))

    def _draw_particles_and_projectiles(self, surf: "pygame.Surface", match: MatchSession) -> None:
        half_w, half_h = INTERNAL_W * 0.5, INTERNAL_H * 0.5
        for proj in match.projectiles:
            if proj.delay_frames > 0:
                continue
            pp = match.camera.project(proj.x, proj.y, proj.z, half_w, half_h)
            if pp is not None:
                rad = int(clamp(220.0 / pp[2], 12, 36))
                pygame.draw.circle(surf, proj.color, (int(pp[0]), int(pp[1])), rad)
                pygame.draw.circle(surf, (255, 248, 224), (int(pp[0]), int(pp[1])), max(4, rad // 2))
        for p in match.particles:
            pp = match.camera.project(p.x, p.y, p.z, half_w, half_h)
            if pp is None:
                continue
            if p.kind in ("flip_slash", "flip_seal"):
                fb = self.textures.vfx_flipbooks["ink_slash" if p.kind == "flip_slash" else "seal_burst"]
                idx = clamp(int((1.0 - p.life / p.max_life) * len(fb)), 0, len(fb) - 1)
                img = fb[int(idx)]
                surf.blit(img, (int(pp[0] - img.get_width() // 2), int(pp[1] - img.get_height() // 2)))
            else:
                rad = max(2, int(p.size * (p.life / p.max_life)))
                pygame.draw.circle(surf, p.color, (int(pp[0]), int(pp[1])), rad)

    def _tick_relics(self, pressed: set) -> None:
        if pg_locals.K_ESCAPE in pressed:
            self.mode = "title"
            return
        if pg_locals.K_UP in pressed or pg_locals.K_w in pressed:
            self.relic_cursor = (self.relic_cursor - 1) % len(RELICS_CODEX)
        elif pg_locals.K_DOWN in pressed or pg_locals.K_s in pressed:
            self.relic_cursor = (self.relic_cursor + 1) % len(RELICS_CODEX)
        self.canvas.fill((12, 5, 9))
        self.canvas.blit(self.hud.font_sub.render("RELICS CODEX — FRAGMENTS OF THE SIX RINGS", True, (246, 198, 76)), (64, 42))
        for i, r in enumerate(RELICS_CODEX):
            col = (255, 224, 118) if i == self.relic_cursor else (178, 152, 146)
            self.canvas.blit(self.hud.font_hud.render(f"{'> ' if i == self.relic_cursor else '  '}{r['name']} ({r['ring']})", True, col), (64, 112 + i * 44))
        cur = RELICS_CODEX[self.relic_cursor]
        # Simple wrapped lore box
        words = cur["lore"].split(" ")
        lines_out: List[str] = []
        line = ""
        for w in words:
            if len(line) + len(w) + 1 > 54:
                lines_out.append(line)
                line = w
            else:
                line = (line + " " + w).strip()
        if line:
            lines_out.append(line)
        pygame.draw.rect(self.canvas, (26, 12, 18), (560, 112, 640, 320))
        pygame.draw.rect(self.canvas, (226, 174, 62), (560, 112, 640, 320), 2)
        self.canvas.blit(self.hud.font_sub.render(cur["name"], True, (255, 214, 96)), (590, 140))
        for li, ln in enumerate(lines_out):
            self.canvas.blit(self.hud.font_hud.render(ln, True, (232, 214, 204)), (590, 196 + li * 30))

    def _tick_options(self, pressed: set) -> None:
        if pg_locals.K_ESCAPE in pressed:
            self.mode = "title"
            return
        if pg_locals.K_1 in pressed:
            self.photosafe = not self.photosafe
        if pg_locals.K_2 in pressed:
            self.pulse_enabled = not self.pulse_enabled
        if pg_locals.K_3 in pressed:
            self.gore_level = (self.gore_level + 1) % 3
        if pg_locals.K_4 in pressed:
            self.control_scheme = "duelist" if self.control_scheme == "ritual" else "ritual"
        self.canvas.fill((12, 5, 9))
        self.canvas.blit(self.hud.font_sub.render("OPTIONS & ACCESSIBILITY (PRESS 1-4 TO TOGGLE, ESC BACK)", True, (246, 198, 76)), (64, 52))
        rows = [
            f"[1] Photosensitivity-Safe Mode (No Flash): {'ON' if self.photosafe else 'OFF'}",
            f"[2] 172 BPM Pulse Sync Indicator:          {'ON' if self.pulse_enabled else 'OFF'}",
            f"[3] Stylized Combat Gore Level:            {['LOW', 'MEDIUM', 'EXPLICIT'][self.gore_level]}",
            f"[4] Control Scheme:                        {self.control_scheme.upper()}",
            f"    3D Backend Active:                     {'OPENGL 1.5/2.0 HARDWARE' if self.use_opengl else 'PURE-PYGAME 3D SOFTWARE CEL'}",
        ]
        for i, r in enumerate(rows):
            self.canvas.blit(self.hud.font_hud.render(r, True, (238, 220, 204)), (84, 148 + i * 54))


