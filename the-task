        """One collapsible section of the HORDE tab: `build` fills the inner
        layout; the Collapsible header shows / hides it. Keeps the long HORDE
        tab compact - only what is being tweaked needs to be open."""
        inner = QWidget()
        inner.setObjectName("Transparent")
        gl = QVBoxLayout(inner)
