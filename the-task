def _svg_defs_common(p: Dict[str, str]) -> str:
    """Reusable multi-stop metallic, lacquer-glass, specular, and reflected-light
    SVG gradient definitions parameterized for the active theme. Layered
    radial + linear stops emulate true mesh gradients under QSvgRenderer."""
    return (
        "<defs>"
        f"<linearGradient id='mGold' x1='0%' y1='0%' x2='100%' y2='100%'>"
        f"<stop offset='0%' stop-color='{p['svg_metal_1']}'/>"
        f"<stop offset='38%' stop-color='{p['svg_metal_2']}'/>"
        f"<stop offset='78%' stop-color='{p['svg_metal_3']}'/>"
        f"<stop offset='100%' stop-color='{p['svg_metal_4']}'/>"
        "</linearGradient>"
        f"<linearGradient id='mVert' x1='0%' y1='0%' x2='0%' y2='100%'>"
        f"<stop offset='0%' stop-color='{p['svg_metal_1']}'/>"
        f"<stop offset='46%' stop-color='{p['svg_metal_2']}'/>"
        f"<stop offset='54%' stop-color='{p['svg_metal_3']}'/>"
        f"<stop offset='100%' stop-color='{p['svg_metal_4']}'/>"
        "</linearGradient>"
        f"<linearGradient id='bodyLac' x1='0%' y1='0%' x2='0%' y2='100%'>"
        f"<stop offset='0%' stop-color='{p['svg_body_1']}'/>"
        f"<stop offset='55%' stop-color='{p['svg_body_2']}'/>"
        f"<stop offset='100%' stop-color='{p['svg_body_3']}'/>"
        "</linearGradient>"
        f"<linearGradient id='glassArc' x1='0%' y1='0%' x2='0%' y2='100%'>"
        f"<stop offset='0%' stop-color='{p['svg_glass']}' stop-opacity='0.62'/>"
        f"<stop offset='65%' stop-color='{p['svg_glass']}' stop-opacity='0.10'/>"
        f"<stop offset='100%' stop-color='{p['svg_glass']}' stop-opacity='0.0'/>"
        "</linearGradient>"
        f"<radialGradient id='coreGlow' cx='50%' cy='42%' r='52%'>"
        f"<stop offset='0%' stop-color='{p['svg_glass']}' stop-opacity='0.95'/>"
        f"<stop offset='32%' stop-color='{p['svg_metal_1']}' stop-opacity='0.92'/>"
        f"<stop offset='70%' stop-color='{p['svg_metal_2']}' stop-opacity='0.65'/>"
        f"<stop offset='100%' stop-color='{p['svg_metal_4']}' stop-opacity='0.0'/>"
        "</radialGradient>"
        f"<radialGradient id='bounce' cx='50%' cy='92%' r='55%'>"
        f"<stop offset='0%' stop-color='{p['svg_bounce']}' stop-opacity='0.52'/>"
        f"<stop offset='100%' stop-color='{p['svg_bounce']}' stop-opacity='0.0'/>"
        "</radialGradient>"
        f"<radialGradient id='rimLight' cx='50%' cy='8%' r='70%'>"
        f"<stop offset='0%' stop-color='{p['svg_glass']}' stop-opacity='0.28'/>"
        f"<stop offset='60%' stop-color='{p['svg_glass']}' stop-opacity='0.0'/>"
        "</radialGradient>"
        "</defs>"
    )


def _seestation_four_symbols(scale: float = 1.0, stroke: float = 2.1) -> str:
    """The instantly recognizable Sony PlayStation four-symbol motif
    (triangle / circle / cross / square) arranged in a tight 2x2 grid.
    Colors stay close to the iconic green/red/blue/pink, muted for lacquer."""
    s = scale
    sw = stroke
    return (
        f"<g transform='translate({14 * s},{14 * s})'>"
        # triangle (top-left)
        f"<path d='M{4 * s},{7.4 * s} L{10.4 * s},{7.4 * s} L{7.2 * s},{2.0 * s} Z' "
        f"fill='none' stroke='#3fbf72' stroke-width='{sw}' stroke-linejoin='round'/>"
        # circle (top-right)
        f"<circle cx='{21.6 * s}' cy='{5.0 * s}' r='{3.5 * s}' fill='none' stroke='#e05c5c' stroke-width='{sw}'/>"
        # cross (bottom-left)
        f"<path d='M{3.4 * s},{16.6 * s} L{11.0 * s},{24.2 * s} M{11.0 * s},{16.6 * s} L{3.4 * s},{24.2 * s}' "
        f"stroke='#5aa2e8' stroke-width='{sw}' stroke-linecap='round'/>"
        # square (bottom-right)
        f"<rect x='{18.2 * s}' y='{16.6 * s}' width='{7.0 * s}' height='{7.0 * s}' rx='{1.1 * s}' "
        f"fill='none' stroke='#c95fc9' stroke-width='{sw}'/>"
        "</g>"
    )


