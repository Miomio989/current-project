class StageAtmosphereFX:
    """Living haunted atmosphere for the Cursed Romanesque Cathedral Swamp."""

    def __init__(self, rast: PainterlyRasterizer) -> None:
        self.rast = rast
        self.bats: List[CathedralBat] = []
        self.wisps: List[SwampWisp] = []
        self.ripples: List[PuddleRipple] = []
        self.bolts: List[StormLightningBolt] = []
        self.rain_drops: List[Tuple[float, float, float]] = []
        self.time_sec: float = 0.0
        self._init_entities()

    def _init_entities(self) -> None:
        rng = random.Random(4409)
        for _ in range(11):
            self.bats.append(
                CathedralBat(
                    x=rng.uniform(0.0, float(SCREEN_W)),
                    y=rng.uniform(46.0, 236.0),
                    vx=rng.uniform(32.0, 68.0) * rng.choice([-1.0, 1.0]),
                    amp_y=rng.uniform(6.0, 18.0),
                    phase=rng.uniform(0.0, math.tau),
                    wing_speed=rng.uniform(9.0, 14.5),
                    scale=rng.uniform(0.65, 1.28),
                )
            )
        for _ in range(18):
            self.wisps.append(
                SwampWisp(
                    world_x=rng.uniform(160.0, STAGE_WIDTH - 160.0),
                    base_y=rng.uniform(430.0, 565.0),
                    radius=rng.uniform(5.0, 11.0),
                    phase=rng.uniform(0.0, math.tau),
                    speed=rng.uniform(1.1, 2.4),
                    color=rng.choice([(255, 68, 92), (192, 54, 242), (255, 134, 72)]),
                )
            )
        for _ in range(54):
            self.rain_drops.append(
                (rng.uniform(0.0, float(SCREEN_W)), rng.uniform(0.0, float(SCREEN_H)), rng.uniform(0.75, 1.35))
            )

    def spawn_lightning(self) -> None:
        rng = random.Random(int(self.time_sec * 1000) & 0xFFFF)
        sx = rng.uniform(160.0, SCREEN_W - 160.0)
        sy = 0.0
        pts: List[Tuple[float, float]] = [(sx, sy)]
        branches: List[List[Tuple[float, float]]] = []
        cx, cy = sx, sy
        for seg in range(9):
            cx += rng.uniform(-44.0, 44.0)
            cy += rng.uniform(32.0, 56.0)
            pts.append((cx, cy))
            if seg in (2, 4, 6) and rng.random() < 0.72:
                bx, by = cx, cy
                b_pts = [(bx, by)]
                b_dir = rng.choice([-1.0, 1.0])
                for _ in range(4):
                    bx += b_dir * rng.uniform(14.0, 38.0)
                    by += rng.uniform(18.0, 34.0)
                    b_pts.append((bx, by))
                branches.append(b_pts)
        self.bolts.append(StormLightningBolt(pts, branches, life=11, max_life=11))

    def update(self, dt: float, storm_intensity: float) -> None:
        self.time_sec += dt
        for b in self.bats:
            b.x += b.vx * dt
            if b.x < -60.0:
                b.x = SCREEN_W + 55.0
            elif b.x > SCREEN_W + 60.0:
                b.x = -55.0

        # Periodic wet causeway puddle ripples
        if random.random() < (0.14 + storm_intensity * 0.45):
            if len(self.ripples) < 28:
                self.ripples.append(
                    PuddleRipple(
                        world_x=random.uniform(STAGE_LEFT_WALL, STAGE_RIGHT_WALL),
                        world_y=random.uniform(GROUND_Y - 12.0, GROUND_Y + 56.0),
                        radius=2.0,
                        max_radius=random.uniform(14.0, 34.0),
                        life=28,
                        max_life=28,
                    )
                )

        alive_rip: List[PuddleRipple] = []
        for r in self.ripples:
            r.life -= 1
            if r.life <= 0:
                continue
            u = 1.0 - (r.life / float(r.max_life))
            r.radius = lerp(2.0, r.max_radius, u)
            alive_rip.append(r)
        self.ripples = alive_rip

        alive_bolts: List[StormLightningBolt] = []
        for lt in self.bolts:
            lt.life -= 1
            if lt.life > 0:
                alive_bolts.append(lt)
        self.bolts = alive_bolts

        if storm_intensity > 0.35 and random.random() < dt * (0.55 + storm_intensity * 0.9):
            self.spawn_lightning()

        # Advance diagonal crimson storm rain drops
        if storm_intensity > 0.08:
            new_drops: List[Tuple[float, float, float]] = []
            for rx, ry, spd in self.rain_drops:
                rx -= 160.0 * spd * dt
                ry += 780.0 * spd * dt
                if ry > SCREEN_H + 20.0:
                    ry = -20.0
                    rx = random.uniform(0.0, float(SCREEN_W + 180))
                if rx < -40.0:
                    rx += SCREEN_W + 80.0
                new_drops.append((rx, ry, spd))
            self.rain_drops = new_drops

    def render_sky_creatures_and_bolts(self, target: pygame.Surface) -> None:
        # 1. Branching crimson storm lightning across blood-red sky
        for lt in self.bolts:
            ratio = lt.life / float(max(1, lt.max_life))
            glow_s = pygame.Surface((SCREEN_W, 480), pygame.SRCALPHA)
            al = clamp_int(int(235 * ratio), 0, 255)
            pygame.draw.lines(glow_s, (255, 62, 72, int(al * 0.65)), False, lt.points, 6)
            pygame.draw.lines(glow_s, (255, 232, 224, al), False, lt.points, 2)
            for br in lt.branches:
                pygame.draw.lines(glow_s, (255, 78, 86, int(al * 0.5)), False, br, 3)
                pygame.draw.lines(glow_s, (255, 220, 210, int(al * 0.8)), False, br, 1)
            target.blit(glow_s, (0, 0), special_flags=pygame.BLEND_RGBA_ADD)

        # 2. Silhouetted gothic bats / ravens gliding across the cathedral spires
        for b in self.bats:
            y = b.y + math.sin(self.time_sec * 1.9 + b.phase) * b.amp_y
            flap = math.sin(self.time_sec * b.wing_speed + b.phase)
            s = b.scale * 11.0
            wing_y = flap * s * 0.72
            pts = [
                (b.x - s * 1.35, y - wing_y),
                (b.x - s * 0.55, y - s * 0.25 - wing_y * 0.45),
                (b.x, y + s * 0.12),
                (b.x + s * 0.55, y - s * 0.25 - wing_y * 0.45),
                (b.x + s * 1.35, y - wing_y),
                (b.x + s * 0.45, y + s * 0.28),
                (b.x, y + s * 0.36),
                (b.x - s * 0.45, y + s * 0.28),
            ]
            pygame.draw.polygon(target, (18, 4, 10), pts)
            pygame.draw.lines(target, (196, 48, 36), False, pts[:5], 1)

    def render_swamp_wisps_and_ripples(
        self,
        target: pygame.Surface,
        cam_x: float,
        cam_y: float,
        cam_zoom: float,
        shake_x: float,
        shake_y: float,
    ) -> None:
        # 1. Glowing swamp cursed will-o'-wisps hovering near iron fences
        for w in self.wisps:
            wx = w.world_x + math.sin(self.time_sec * w.speed + w.phase) * 28.0
            wy = w.base_y + math.cos(self.time_sec * (w.speed * 1.3) + w.phase) * 14.0
            sx = HALF_W + (wx - cam_x) * cam_zoom + shake_x
            sy = HALF_H + (wy - cam_y) * cam_zoom + shake_y
            if sx < -40 or sx > SCREEN_W + 40:
                continue
            pulse = 0.65 + 0.35 * math.sin(self.time_sec * 4.0 + w.phase)
            self.rast.draw_soft_glow(target, (sx, sy), w.radius * 2.4 * cam_zoom * pulse, w.color, peak_alpha=68, rings=3)
            pygame.draw.circle(target, (255, 240, 232), (int(sx), int(sy)), max(1, int(2.2 * cam_zoom)))

        # 2. Expanding water ripple ellipses across causeway puddles
        rip_s = pygame.Surface((SCREEN_W, SCREEN_H), pygame.SRCALPHA)
        for r in self.ripples:
            sx = HALF_W + (r.world_x - cam_x) * cam_zoom + shake_x
            sy = HALF_H + (r.world_y - cam_y) * cam_zoom + shake_y
            if sx < -60 or sx > SCREEN_W + 60:
                continue
            ratio = r.life / float(max(1, r.max_life))
            rx = max(3, int(r.radius * cam_zoom * 1.4))
            ry = max(2, int(r.radius * cam_zoom * 0.34))
            al = clamp_int(int(120 * ratio), 0, 255)
            pygame.draw.ellipse(rip_s, (238, 86, 72, al), (int(sx - rx), int(sy - ry), rx * 2, ry * 2), 1)
        target.blit(rip_s, (0, 0))

    def render_storm_rain(self, target: pygame.Surface, storm_intensity: float) -> None:
        if storm_intensity <= 0.08:
            return
        rain_s = pygame.Surface((SCREEN_W, SCREEN_H), pygame.SRCALPHA)
        al = clamp_int(int(110 * storm_intensity), 18, 130)
        for rx, ry, spd in self.rain_drops:
            pygame.draw.line(rain_s, (255, 132, 136, al), (rx, ry), (rx - 7.0 * spd, ry + 26.0 * spd), 1)
        target.blit(rain_s, (0, 0))


