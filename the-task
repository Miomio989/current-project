class CombatResolver:
    """
    Resolves pushboxes, Weapon Clashes, Throws & Throw Techs, Darkmoon Riposte
    counters, Just-Guard Soul Deflects, Guard Crush, Poise breaks, Counter Hits,
    Fatal Counters, Projectiles, Pillars, and Combo Proration!
    """

    def __init__(
        self,
        moves: Dict[FighterState, MoveSpec],
        stage: CursedCathedralStage,
        audio: AudioEngine,
        vfx: VFXDirector,
        settings: GameSettings,
    ) -> None:
        self.moves = moves
        self.stage = stage
        self.audio = audio
        self.vfx = vfx
        self.settings = settings
        self.first_blood_awarded: bool = False

    def reset_round(self) -> None:
        self.first_blood_awarded = False

    def resolve_frame(self, f1: Fighter, f2: Fighter, stats: MatchStats) -> None:
        # 1. Pushbox Separation + Max Separation Clamping
        self._resolve_pushboxes(f1, f2)

        # 2. Sword-vs-Sword Weapon Clash (Samurai Shodown / BlazBlue!)
        if self._check_weapon_clash(f1, f2, stats):
            return

        # 3. Close-Range Throws & Throw Tech
        self._resolve_throws(f1, f2)

        # 4. Melee Sword Hitboxes (Simultaneous trades supported!)
        self._resolve_melee_attack(f1, f2, stats)
        self._resolve_melee_attack(f2, f1, stats)

        # 5. Blood Moon Projectiles & Cathedral Blood Pillars
        self._resolve_projectiles_and_pillars(f1, f2, stats)

    def _resolve_pushboxes(self, f1: Fighter, f2: Fighter) -> None:
        b1 = f1.pushbox_world()
        b2 = f2.pushbox_world()
        if rect_intersects(b1, b2):
            overlap = min(b1.x + b1.w - b2.x, b2.x + b2.w - b1.x) * 0.52
            if f1.x <= f2.x:
                f1.x = clamp(f1.x - overlap, STAGE_LEFT_WALL, STAGE_RIGHT_WALL)
                f2.x = clamp(f2.x + overlap, STAGE_LEFT_WALL, STAGE_RIGHT_WALL)
            else:
                f1.x = clamp(f1.x + overlap, STAGE_LEFT_WALL, STAGE_RIGHT_WALL)
                f2.x = clamp(f2.x - overlap, STAGE_LEFT_WALL, STAGE_RIGHT_WALL)
        # Keep fighters within camera framing distance
        dist = f2.x - f1.x
        if abs(dist) > MAX_FIGHTER_SEPARATION:
            mid = (f1.x + f2.x) * 0.5
            half = MAX_FIGHTER_SEPARATION * 0.5
            if dist > 0:
                f1.x = mid - half
                f2.x = mid + half
            else:
                f1.x = mid + half
                f2.x = mid - half

    def _check_weapon_clash(self, f1: Fighter, f2: Fighter, stats: MatchStats) -> bool:
        if f1.hitstop > 0 or f2.hitstop > 0:
            return False
        hb1 = f1.hitboxes_world()
        hb2 = f2.hitboxes_world()
        if not hb1 or not hb2:
            return False
        for r1 in hb1:
            for r2 in hb2:
                if rect_intersects(r1, r2):
                    cx, cy = rect_overlap_center(r1, r2)
                    f1.hitstop = 14
                    f2.hitstop = 14
                    f1.has_hit_this_move = True
                    f2.has_hit_this_move = True
                    f1.vx = -6.5 if f1.facing_right else 6.5
                    f2.vx = -6.5 if f2.facing_right else 6.5
                    f1.curse_meter = min(BASE_MAX_CURSE_METER, f1.curse_meter + 800)
                    f2.curse_meter = min(BASE_MAX_CURSE_METER, f2.curse_meter + 800)
                    f1.stylish.on_stylish_event(280)
                    f2.stylish.on_stylish_event(280)
                    stats.p1_clashes += 1
                    self.audio.play_sfx(SFXId.WEAPON_CLASH_CLANG, 0.0)
                    self.vfx.spawn_guard_sparks(cx, cy, is_just=True)
                    self.vfx.cam.add_shake(12.0)
                    self.vfx.cam.trigger_flash((255, 240, 180), 0.55)
                    self.vfx.spawn_callout("BLOOD-EDGE CLASH!", cx, cy - 42.0, (255, 224, 112))
                    return True
        return False

    def _resolve_throws(self, f1: Fighter, f2: Fighter) -> None:
        # Mutual throw tech!
        if f1.state == FighterState.THROW_ATTEMPT and f2.state == FighterState.THROW_ATTEMPT and abs(f1.x - f2.x) < 92.0:
            f1.enter_state(FighterState.THROW_TECH)
            f2.enter_state(FighterState.THROW_TECH)
            f1.vx = -8.5 if f1.x < f2.x else 8.5
            f2.vx = 8.5 if f1.x < f2.x else -8.5
            self.audio.play_sfx(SFXId.THROW_TECH_REPEL, 0.0)
            self.vfx.spawn_callout("THROW TECH!", (f1.x + f2.x) * 0.5, f1.y - 140.0, (158, 224, 255))
            return

        for att, dfd in ((f1, f2), (f2, f1)):
            if att.state == FighterState.THROW_ATTEMPT and att.frame_idx == 1 and att.frame_tick == 0:
                if abs(att.x - dfd.x) < 88.0 and dfd.grounded and not dfd.is_hitstun() and dfd.invuln_frames <= 0:
                    att.enter_state(FighterState.THROW_EXECUTE)
                    mv = self.moves[FighterState.THROW_EXECUTE]
                    self._apply_clean_hit(att, dfd, mv, dfd.x, dfd.y - 98.0, MatchStats())

    def _resolve_melee_attack(self, att: Fighter, dfd: Fighter, stats: MatchStats) -> None:
        if att.state not in self.moves or att.hitstop > 0:
            return
        mv = self.moves[att.state]
        if mv.damage <= 0:
            return
        if att.has_hit_this_move:
            if mv.max_hits <= 1 or att.move_hit_count >= mv.max_hits:
                return
            if (att.state_elapsed - att.last_multi_hit_frame) < max(3, mv.multi_hit_interval):
                return
        if dfd.invuln_frames > 0 or dfd.current_keyframe().invuln_strike:
            return

        hbs = att.hitboxes_world()
        hurts = dfd.hurtboxes_world()
        if not hbs or not hurts:
            return

        for hb in hbs:
            for hurt in hurts:
                if rect_intersects(hb, hurt):
                    cx, cy = rect_overlap_center(hb, hurt)
                    self._on_attack_connect(att, dfd, mv, cx, cy, stats)
                    return

    def _resolve_projectiles_and_pillars(self, f1: Fighter, f2: Fighter, stats: MatchStats) -> None:
        fighters = (f1, f2)
        for pr in self.vfx.projectiles:
            if pr.hits_left <= 0 or pr.hit_cooldown > 0:
                continue
            att = fighters[pr.owner_id]
            dfd = fighters[1 - pr.owner_id]
            if dfd.invuln_frames > 0:
                continue
            p_box = BoxRect(pr.x - 28.0, pr.y - 58.0, 56.0, 116.0)
            for hurt in dfd.hurtboxes_world():
                if rect_intersects(p_box, hurt):
                    mv = self.moves[FighterState.SP_CRESCENT_EX if pr.is_ex else FighterState.SP_CRESCENT_B]
                    cx, cy = rect_overlap_center(p_box, hurt)
                    self._on_attack_connect(att, dfd, mv, cx, cy, stats, is_projectile=True)
                    pr.hits_left -= 1
                    pr.hit_cooldown = 8
                    break

        for pil in self.vfx.pillars:
            if pil.delay_frames > 0 or pil.has_hit:
                continue
            att = fighters[pil.owner_id]
            dfd = fighters[1 - pil.owner_id]
            if dfd.invuln_frames > 0:
                continue
            p_box = BoxRect(pil.x - 42.0, GROUND_Y - 380.0, 84.0, 380.0)
            for hurt in dfd.hurtboxes_world():
                if rect_intersects(p_box, hurt):
                    mv = self.moves[FighterState.SP_CATHEDRAL_SIGIL]
                    self._on_attack_connect(att, dfd, mv, pil.x, dfd.y - 96.0, stats, is_projectile=True)
                    pil.has_hit = True
                    break

    def _on_attack_connect(
        self,
        att: Fighter,
        dfd: Fighter,
        mv: MoveSpec,
        cx: float,
        cy: float,
        stats: MatchStats,
        is_projectile: bool = False,
    ) -> None:
        if not is_projectile:
            att.has_hit_this_move = True
            att.move_hit_count += 1
            att.last_multi_hit_frame = att.state_elapsed

        # Darkmoon Riposte Parry Stance Counter!
        if dfd.state == FighterState.SP_RIPOSTE_STANCE and mv.height != AttackHeight.UNBLOCKABLE:
            dfd.x = clamp(att.x + (-76.0 if att.facing_right else 76.0), STAGE_LEFT_WALL, STAGE_RIGHT_WALL)
            dfd.facing_right = att.x > dfd.x
            dfd.enter_state(FighterState.SP_RIPOSTE_COUNTER)
            dfd.invuln_frames = 22
            att.hitstop = 18
            dfd.stylish.on_stylish_event(420)
            self.audio.play_sfx(SFXId.RIPOSTE_TELEPORT, 0.0)
            self.vfx.spawn_guard_sparks(cx, cy, is_just=True)
            self.vfx.cam.trigger_flash((255, 198, 232), 0.60)
            self.vfx.spawn_callout("DARKMOON RIPOSTE!", dfd.x, dfd.y - 178.0, (255, 218, 96))
            return

        # Evaluate Blocking & Just-Guard Soul Deflect!
        can_block = self._is_blocking(dfd, mv.height)
        if can_block:
            is_just = dfd.just_guard_window > 0
            if is_just:
                dfd.enter_state(FighterState.JUST_GUARD_DEFLECT)
                dfd.blockstun_left = max(4, mv.blockstun - 7)
                dfd.curse_meter = min(BASE_MAX_CURSE_METER, dfd.curse_meter + 1150)
                dfd.guard_gauge = min(BASE_MAX_GUARD_GAUGE, dfd.guard_gauge + 140.0)
                dfd.poise = BASE_MAX_POISE
                dfd.stylish.on_stylish_event(340)
                if dfd.player_id == 0:
                    stats.p1_just_guards += 1
                else:
                    stats.p2_just_guards += 1
                self.audio.play_sfx(SFXId.JUST_GUARD_CHIME, dfd._pan())
                self.vfx.spawn_guard_sparks(cx, cy, is_just=True)
                self.vfx.spawn_callout("JUST GUARD!", dfd.x, dfd.y - 176.0, (255, 228, 98))
            else:
                dfd.enter_state(
                    FighterState.GUARD_AIR if not dfd.grounded
                    else (FighterState.GUARD_CROUCH if dfd.input_buf.latest().numpad in (1, 2, 3) else FighterState.GUARD_STAND)
                )
                dfd.blockstun_left = mv.blockstun
                dfd.guard_gauge = max(0.0, dfd.guard_gauge - mv.guard_damage)
                if mv.chip_damage > 0 and dfd.health > 1:
                    dfd.health = max(1, dfd.health - mv.chip_damage)
                self.audio.play_sfx(
                    SFXId.GUARD_BLOCK_HEAVY if mv.weight.value >= 2 else SFXId.GUARD_BLOCK_LIGHT, dfd._pan()
                )
                self.vfx.spawn_guard_sparks(cx, cy, is_just=False)

                # Soulcalibur Guard Crush!
                if dfd.guard_gauge <= 0.0:
                    dfd.guard_gauge = BASE_MAX_GUARD_GAUGE * 0.65
                    dfd.enter_state(FighterState.GUARD_CRUSH)
                    dfd.hitstun_left = 44
                    self.audio.play_sfx(SFXId.GUARD_CRUSH_SHATTER, dfd._pan())
                    self.vfx.cam.add_shake(14.0)
                    self.vfx.spawn_callout("GUARD CRUSH!", dfd.x, dfd.y - 182.0, (255, 78, 98))

            push_dir = 1.0 if att.x < dfd.x else -1.0
            dfd.vx = push_dir * mv.pushback_block * (0.55 if is_just else 1.0)
            if not is_projectile:
                att.hitstop = max(4, mv.hitstop - 2)
            dfd.hitstop = max(4, mv.hitstop - 2)
            return

        self._apply_clean_hit(att, dfd, mv, cx, cy, stats, is_projectile=is_projectile)

    def _is_blocking(self, dfd: Fighter, height: AttackHeight) -> bool:
        if height in (AttackHeight.UNBLOCKABLE, AttackHeight.THROW):
            return False
        if not (dfd.is_free_actionable() or dfd.is_guarding_state()):
            return False
        np = dfd.input_buf.latest().numpad
        holding_back = np in (4, 1, 7)
        if not holding_back:
            return False
        if not dfd.grounded:
            return True
        if height == AttackHeight.LOW and np != 1:
            return False
        if height == AttackHeight.OVERHEAD and np == 1:
            return False
        return True

    def _apply_clean_hit(
        self,
        att: Fighter,
        dfd: Fighter,
        mv: MoveSpec,
        cx: float,
        cy: float,
        stats: MatchStats,
        is_projectile: bool = False,
    ) -> None:
        is_counter = dfd.is_attacking() and dfd.state_elapsed < 18
        is_fatal = is_counter and mv.fatal_counter

        # Combo Proration & Eclipse Overdrive Damage Multiplier
        if dfd.combo_received == 0:
            dfd.combo_scaling = mv.proration_init
        else:
            dfd.combo_scaling = max(0.22, dfd.combo_scaling * mv.proration_step)
        dfd.combo_received += 1

        dmg_mul = dfd.combo_scaling
        if is_fatal:
            dmg_mul *= 1.25
        elif is_counter:
            dmg_mul *= 1.12
        if att.eclipse_timer > 0.0:
            dmg_mul *= 1.18
        final_dmg = max(55, int(mv.damage * dmg_mul))

        dfd.health = max(0, dfd.health - final_dmg)
        dfd.recoverable_hp = max(float(dfd.health), dfd.recoverable_hp - final_dmg * 0.65)
        att.curse_meter = min(BASE_MAX_CURSE_METER, att.curse_meter + mv.meter_gain_hit)
        dfd.curse_meter = min(BASE_MAX_CURSE_METER, dfd.curse_meter + int(mv.meter_gain_hit * 0.52))
        dfd.poise = max(0.0, dfd.poise - mv.poise_damage)

        # Stats & DMC Stylish Rank Update!
        if att.player_id == 0:
            stats.p1_damage_dealt += final_dmg
            stats.p1_max_combo = max(stats.p1_max_combo, dfd.combo_received)
            if is_counter:
                stats.p1_counters += 1
            if mv.weight in (AttackWeight.SUPER, AttackWeight.ASTRAL):
                stats.p1_supers_landed += 1
        else:
            stats.p2_damage_dealt += final_dmg
            stats.p2_max_combo = max(stats.p2_max_combo, dfd.combo_received)

        leveled_up = att.stylish.on_hit_landed(mv.state, mv.style_points, final_dmg, is_counter)
        dfd.stylish.on_damaged()
        if att.player_id == 0:
            if att.stylish.rank.tier > stats.p1_max_style.tier:
                stats.p1_max_style = att.stylish.rank
            stats.p1_style_score = max(stats.p1_style_score, att.stylish.style_bonus)
        if leveled_up:
            self.audio.play_sfx(SFXId.STINGER_STYLE_UP, 0.0, 0.78)

        # First Blood Tactical Bonus
        if not self.first_blood_awarded:
            self.first_blood_awarded = True
            att.curse_meter = min(BASE_MAX_CURSE_METER, att.curse_meter + 1000)
            self.vfx.spawn_callout("FIRST BLOOD!", cx, cy - 68.0, (255, 62, 102))

        # Apply Hitstun, Launch, Crumple & Knockback
        push_dir = 1.0 if att.x <= dfd.x else -1.0
        extra_hs = (10 if is_fatal else (4 if is_counter else 0)) + (8 if dfd.poise <= 0.0 else 0)
        if dfd.poise <= 0.0:
            dfd.poise = BASE_MAX_POISE
            self.audio.play_sfx(SFXId.POISE_BREAK_GROAN, dfd._pan())
            self.vfx.spawn_callout("POISE BROKEN!", dfd.x, dfd.y - 164.0, (255, 168, 72))

        if dfd.health <= 0:
            dfd.grounded = False
            dfd.vx = push_dir * max(7.5, mv.launch_vx)
            dfd.vy = min(-10.5, mv.launch_vy)
            dfd.enter_state(FighterState.HIT_LAUNCH)
            dfd.hitstun_left = 60
        elif mv.crumple and dfd.grounded:
            dfd.vx = push_dir * 4.0
            dfd.enter_state(FighterState.HIT_CRUMPLE)
            dfd.hitstun_left = mv.hitstun + extra_hs + 12
        elif mv.launch_vy < -1.0 or not dfd.grounded or mv.knockdown or mv.hard_knockdown:
            dfd.grounded = False
            dfd.vx = push_dir * max(3.0, mv.launch_vx)
            dfd.vy = mv.launch_vy if mv.launch_vy != 0.0 else -8.8
            dfd.enter_state(FighterState.HIT_LAUNCH)
            dfd.hitstun_left = mv.hitstun + extra_hs
        else:
            dfd.vx = push_dir * mv.pushback_hit
            if mv.weight.value >= 2:
                dfd.enter_state(FighterState.HIT_HEAVY)
            elif mv.height == AttackHeight.LOW:
                dfd.enter_state(FighterState.HIT_LOW)
            elif mv.height == AttackHeight.HIGH:
                dfd.enter_state(FighterState.HIT_HIGH)
            else:
                dfd.enter_state(FighterState.HIT_MID)
            dfd.hitstun_left = mv.hitstun + extra_hs

        # Hitstop Freeze, Screen Shake, Sparks, R18+ Swamp Blood & Audio!
        hs = mv.hitstop + (7 if is_fatal else (3 if is_counter else 0))
        if not is_projectile:
            att.hitstop = hs
        dfd.hitstop = hs

        pal = CECILIA_PALETTES[att.pal_idx % len(CECILIA_PALETTES)]
        self.vfx.spawn_hit_sparks(cx, cy, pal, mv.weight, self.settings.blood_intensity)
        if mv.weight.value >= 1 and self.settings.blood_intensity > 0.1:
            self.stage.add_blood_decal(dfd.x, 0.75 + mv.weight.value * 0.22)
            self.audio.play_sfx(SFXId.BLOOD_SPRAY_BURST, dfd._pan(), 0.72)

        self.audio.play_sfx(SFXId.HIT_FATAL_BOOM if is_fatal else mv.hit_sfx, dfd._pan())
        self.vfx.cam.add_shake(4.5 + mv.weight.value * 3.0 + (7.0 if is_fatal else 0.0))

        if is_fatal:
            self.vfx.cam.trigger_flash((255, 68, 118), 0.62)
            self.vfx.spawn_callout("FATAL COUNTER!!", cx, cy - 52.0, (255, 224, 96))
        elif is_counter:
            self.vfx.spawn_callout("COUNTER!", cx, cy - 48.0, (255, 134, 96))
