    # --------------------------------------------------------------------------
    # 60 FPS Live Atmospheric Simulation
    # --------------------------------------------------------------------------

    def update(self, dt: float) -> None:
        self.time_sec += dt
        self.beat_pulse = max(0.0, self.beat_pulse - dt * 3.4)
        self.eclipse_dim += (self.target_eclipse_dim - self.eclipse_dim) * clamp(dt * 7.5, 0.0, 1.0)
        self.lightning_flash = max(0.0, self.lightning_flash - dt * 3.6)

        # Occasional dramatic Gothic storm lightning illuminating cathedral ruins
        self.next_lightning_t -= dt
        if self.next_lightning_t <= 0.0:
            self.next_lightning_t = random.uniform(7.5, 16.5)
            self.lightning_flash = 0.85
            bx = random.randint(140, INTERNAL_W - 140)
            pts = [(bx, 0)]
            for step in range(1, 9):
                bx += random.randint(-24, 24)
                pts.append((bx, step * 44))
            self.lightning_bolt_pts = pts

        # Update rising embers
        for em in self.embers:
            em.life += dt
            em.x += (em.vx + math.sin(self.time_sec * 2.4 + em.phase) * 14.0) * dt
            em.y += em.vy * dt
            if em.life >= em.max_life or em.y < 20.0:
                em.x = random.uniform(40.0, WORLD_W - 40.0)
                em.y = random.uniform(440.0, 585.0)
                em.life = 0.0

        # Update fluttering cathedral bats
        for bat in self.bats:
            bat.wing_phase += dt * (11.5 + bat.scale * 3.0)
            bat.x += bat.vx * dt
            bat.y += (bat.vy + math.sin(bat.wing_phase * 0.4) * 14.0) * dt
            if bat.x < -80.0:
                bat.x = WORLD_W + 60.0
            elif bat.x > WORLD_W + 80.0:
                bat.x = -60.0
            bat.y = clamp(bat.y, 54.0, 310.0)

        # Update expanding swamp water ripples
        alive_ripples: List[WaterRipple] = []
        for rp in self.ripples:
            rp.radius += dt * 76.0
            rp.alpha = max(0.0, rp.alpha - dt * 0.95)
            if rp.radius < rp.max_radius and rp.alpha > 0.03:
                alive_ripples.append(rp)
        self.ripples = alive_ripples

