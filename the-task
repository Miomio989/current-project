@dataclass(frozen=True)
class SlashArcSpec:
    """Explicit perspective-curved sword slash motion smear for a single keyframe."""
    offset_x: float
    offset_y: float
    rx: float
    ry: float
    start_deg: float
    end_deg: float
    thickness: float
    tilt_deg: float = 0.0
    intensity: float = 1.0
    is_thrust: bool = False
    behind_body: bool = False


@dataclass(frozen=True)
class PoseKeyframe:
    """Explicit hand-crafted anatomical keyframe for Cecilia Darkmoon.

    Every coordinate is authored in local character space (origin = ground
    midpoint beneath pelvis, +X forward toward opponent, -Y upward, +Z toward
    camera / foreground, -Z away from camera / background). This allows genuine
    3D body-turn depth sorting, limb foreshortening, multi-angle face drawing,
    perspective sword planes, and hand-animated cloth & ponytail physics.
    """
    duration: int = 4  # Display frames at 60Hz

    # Core posture & 3D body turn angles (degrees)
    pelvis: Tuple[float, float, float] = (0.0, -96.0, 0.0)
    torso_yaw: float = 28.0       # 0=front, 90=profile right, 180=back, -90=profile left
    torso_lean: float = 4.0       # Forward (+X) lean in degrees
    torso_tilt_z: float = 0.0     # Roll lean
    head_yaw: float = 24.0
    head_pitch: float = 2.0
    head_roll: float = -2.0

    # Left & Right Legs (hip auto-derived from pelvis + yaw; knee & ankle explicit)
    l_knee: Tuple[float, float, float] = (-16.0, -52.0, -10.0)
    l_ankle: Tuple[float, float, float] = (-26.0, -8.0, -14.0)
    l_toe: Tuple[float, float, float] = (-14.0, -2.0, -14.0)

    r_knee: Tuple[float, float, float] = (20.0, -52.0, 12.0)
    r_ankle: Tuple[float, float, float] = (26.0, -8.0, 14.0)
    r_toe: Tuple[float, float, float] = (40.0, -2.0, 14.0)

    # Left & Right Arms (shoulder auto-derived from torso + yaw; elbow & wrist explicit)
    l_elbow: Tuple[float, float, float] = (-14.0, -124.0, -20.0)
    l_wrist: Tuple[float, float, float] = (14.0, -110.0, -8.0)

    r_elbow: Tuple[float, float, float] = (8.0, -120.0, 22.0)
    r_wrist: Tuple[float, float, float] = (26.0, -104.0, 18.0)

    # Secondary motion: Gothic Lolita Skirt, High Ponytail & Face-Framing Sidelocks
    skirt_flare: float = 1.0      # Bell width multiplier (flares during spins/jumps/kicks)
    skirt_tilt_deg: float = 0.0   # Asymmetric wind/momentum swing angle
    skirt_lift: float = 0.0       # Vertical billow lift (airborne / dash / spin)
    ponytail_swing: float = -18.0 # Trailing angle of high ponytail cascade
    ponytail_lift: float = 6.0    # Vertical lift of ponytail arc
    sidelock_sway: float = 0.0    # Horizontal wind push on face-framing strands
    jabot_flutter: float = 0.0    # Crimson chest ruffle sway

    # Facial Expression
    expression: ExpressionId = ExpressionId.SERENE_NOBLE
    gaze_x: float = 0.45
    gaze_y: float = 0.0
    eye_glow: bool = False

    # Demonic Two-Handed Greatsword ("呪いの刃") 3D Keyframe
    sword_hilt: Tuple[float, float, float] = (22.0, -106.0, 14.0)
    sword_tip: Tuple[float, float, float] = (108.0, -24.0, 24.0)
    sword_plane: SwordPlane = SwordPlane.THREE_QUARTER
    sword_roll_deg: float = 15.0
    sword_aura: float = 1.0
    sword_visible: bool = True

    # Optional curved perspective slash smear & auxiliary double-slash
    slash_arc: Optional[SlashArcSpec] = None
    slash_arc_2: Optional[SlashArcSpec] = None

    # Optional translucent body aura / afterglow intensity
    aura_ring: float = 0.0
    phase_seed: float = 0.0


class CeciliaRenderer:
    """Painterly multi-angle anime renderer for Cecilia Darkmoon & her portraits."""

    def __init__(self, rast: PainterlyRasterizer) -> None:
        self.rast = rast

    def _compute_skeleton_3d(self, kf: PoseKeyframe) -> Dict[str, Vec3]:
        """Resolve exact 3D anatomical landmarks from a PoseKeyframe."""
        pelvis = Vec3(*kf.pelvis)
        yaw_r = math.radians(kf.torso_yaw)
        lean_r = math.radians(kf.torso_lean)
        sin_y = math.sin(yaw_r)
        cos_y = math.cos(yaw_r)

        # Spine vector rising from pelvis -> waist -> chest -> neck -> head
        spine_h = 54.0
        dx_lean = math.sin(lean_r) * spine_h
        dy_lean = -math.cos(lean_r) * spine_h

        waist = pelvis + Vec3(dx_lean * 0.34, dy_lean * 0.34, 0.0)
        chest = pelvis + Vec3(dx_lean * 0.78, dy_lean * 0.78, 0.0)
        neck = pelvis + Vec3(dx_lean * 1.02, dy_lean * 1.02, 0.0)

        head_pitch_r = math.radians(kf.head_pitch)
        head_c = neck + Vec3(
            math.sin(lean_r + head_pitch_r) * 18.0,
            -math.cos(lean_r + head_pitch_r) * 18.0,
            0.0,
        )

        # Shoulders & hips rotate genuinely in 3D around Y with torso_yaw!
        # At torso_yaw=0 (front): left shoulder at -X, right shoulder at +X.
        # At torso_yaw=90 (profile facing +X): left shoulder goes -Z (back), right shoulder +Z (front).
        sh_half = 17.5
        hip_half = 13.5
        sh_right_vec = Vec3(cos_y * sh_half, 0.0, sin_y * sh_half)
        hip_right_vec = Vec3(cos_y * hip_half, 0.0, sin_y * hip_half)

        r_shoulder = chest + sh_right_vec + Vec3(0.0, -5.0, 0.0)
        l_shoulder = chest - sh_right_vec + Vec3(0.0, -5.0, 0.0)
        r_hip = pelvis + hip_right_vec + Vec3(0.0, 4.0, 0.0)
        l_hip = pelvis - hip_right_vec + Vec3(0.0, 4.0, 0.0)

        return {
            "pelvis": pelvis,
            "waist": waist,
            "chest": chest,
            "neck": neck,
            "head": head_c,
            "l_shoulder": l_shoulder,
            "r_shoulder": r_shoulder,
            "l_elbow": Vec3(*kf.l_elbow),
            "r_elbow": Vec3(*kf.r_elbow),
            "l_wrist": Vec3(*kf.l_wrist),
            "r_wrist": Vec3(*kf.r_wrist),
            "l_hip": l_hip,
            "r_hip": r_hip,
            "l_knee": Vec3(*kf.l_knee),
            "r_knee": Vec3(*kf.r_knee),
            "l_ankle": Vec3(*kf.l_ankle),
            "r_ankle": Vec3(*kf.r_ankle),
            "l_toe": Vec3(*kf.l_toe),
            "r_toe": Vec3(*kf.r_toe),
            "sword_hilt": Vec3(*kf.sword_hilt),
            "sword_tip": Vec3(*kf.sword_tip),
        }

    def render_keyframe(
        self,
        kf: PoseKeyframe,
        pal: CeciliaPalette,
        resonance_active: bool = False,
        scale: float = 1.16,
    ) -> pygame.Surface:
        """Render a complete painterly anime sprite surface for a single keyframe."""
        surf = pygame.Surface((SPRITE_W, SPRITE_H), pygame.SRCALPHA)
        ox = float(SPRITE_ANCHOR_X)
        oy = float(SPRITE_ANCHOR_Y)

        skel = self._compute_skeleton_3d(kf)
        proj: Dict[str, Vec2] = {}
        pscale: Dict[str, float] = {}
        for k, v3 in skel.items():
            p2, ps = v3.project(ox, oy, focal=560.0, scale=scale)
            proj[k] = p2
            pscale[k] = ps

        # Optional Cursed Resonance fiery aura halo behind body
        if resonance_active or kf.aura_ring > 0.05:
            aura_str = max(kf.aura_ring, 0.85 if resonance_active else 0.0)
            self._draw_body_resonance_aura(surf, proj["pelvis"], proj["chest"], pal, aura_str, kf.phase_seed)

        # Optional behind-body perspective slash smear
        if kf.slash_arc is not None and kf.slash_arc.behind_body:
            self._draw_slash(surf, kf.slash_arc, ox, oy, scale, pal)

        # Compute exact Z-depths of every anatomical layer so 3D body turns
        # (including 360-degree spins, overhead cleaves, and back-turned swings)
        # depth-sort cleanly without visual artifacts!
        z_l_leg = (skel["l_hip"].z + skel["l_knee"].z + skel["l_ankle"].z) / 3.0
        z_r_leg = (skel["r_hip"].z + skel["r_knee"].z + skel["r_ankle"].z) / 3.0
        z_l_arm = (skel["l_shoulder"].z + skel["l_elbow"].z + skel["l_wrist"].z) / 3.0
        z_r_arm = (skel["r_shoulder"].z + skel["r_elbow"].z + skel["r_wrist"].z) / 3.0
        z_sword = (skel["sword_hilt"].z * 0.45 + skel["sword_tip"].z * 0.55)
        z_torso = skel["chest"].z

        # Ponytail anchor sits on back-upper crown of head
        head_yaw_r = math.radians(kf.head_yaw)
        ponytail_back_z = -math.cos(head_yaw_r) * 18.0 + skel["head"].z

        # Build sorted depth render queue: (z_depth, layer_priority, draw_fn)
        draw_ops: List[Tuple[float, int, Callable[[], None]]] = []

        # Back hair cascade & ponytail (behind body when facing camera, in front when back-turned!)
        draw_ops.append((ponytail_back_z - 8.0, 1, lambda: self._draw_high_ponytail(surf, kf, proj, pscale, pal)))

        # Legs with pale thighs & above-knee silver-buckled black leather boots
        draw_ops.append((z_l_leg, 2, lambda: self._draw_leg_and_boot(surf, "l", kf, proj, pscale, pal)))
        draw_ops.append((z_r_leg, 3, lambda: self._draw_leg_and_boot(surf, "r", kf, proj, pscale, pal)))

        # Back skirt under-shadow tier
        draw_ops.append((z_torso - 2.5, 4, lambda: self._draw_skirt_back_layer(surf, kf, proj, pscale, pal)))

        # Arms (puffed Juliet upper sleeve + fitted leather forearm + crimson ruffled cuff + hand)
        draw_ops.append((z_l_arm, 5, lambda: self._draw_arm_juliet(surf, "l", kf, proj, pscale, pal)))
        draw_ops.append((z_r_arm, 6, lambda: self._draw_arm_juliet(surf, "r", kf, proj, pscale, pal)))

        # Torso corset bodice, high stand collar, ruby brooch & crimson jabot
        draw_ops.append((z_torso, 7, lambda: self._draw_torso_corset(surf, kf, proj, pscale, pal)))

        # Multi-tiered gothic lolita front bell miniskirt & leather silver-buckled waist belt
        draw_ops.append((z_torso + 3.5, 8, lambda: self._draw_skirt_front_and_belt(surf, kf, proj, pscale, pal)))

        # Head: porcelain face, multi-angle nose/eyes/mouth, bangs, cute sidelocks
        draw_ops.append((skel["head"].z + 5.0, 9, lambda: self._draw_head_and_face(surf, kf, proj, pscale, pal, resonance_active)))

        # Demonic two-handed greatsword ("呪いの刃")
        if kf.sword_visible:
            draw_ops.append((
                z_sword,
                10,
                lambda: self.rast.draw_demonic_greatsword(
                    target=surf,
                    hilt_pos=proj["sword_hilt"],
                    tip_pos=proj["sword_tip"],
                    pal=pal,
                    plane=kf.sword_plane,
                    blade_roll_deg=kf.sword_roll_deg,
                    persp_scale=0.5 * (pscale["sword_hilt"] + pscale["sword_tip"]),
                    aura_intensity=kf.sword_aura * (1.35 if resonance_active else 1.0),
                    phase=kf.phase_seed,
                ),
            ))

        # Execute depth-sorted painterly passes back-to-front
        draw_ops.sort(key=lambda item: (item[0], item[1]))
        for _, _, fn in draw_ops:
            fn()

        # Foreground perspective sword slash smears
        if kf.slash_arc is not None and not kf.slash_arc.behind_body:
            self._draw_slash(surf, kf.slash_arc, ox, oy, scale, pal)
        if kf.slash_arc_2 is not None:
            self._draw_slash(surf, kf.slash_arc_2, ox, oy, scale, pal)

        return surf

    def _draw_slash(
        self,
        surf: pygame.Surface,
        spec: SlashArcSpec,
        ox: float,
        oy: float,
        scale: float,
        pal: CeciliaPalette,
    ) -> None:
        center = Vec2(ox + spec.offset_x * scale, oy + spec.offset_y * scale)
        self.rast.draw_perspective_slash_arc(
            target=surf,
            center=center,
            rx=spec.rx * scale,
            ry=spec.ry * scale,
            start_deg=spec.start_deg,
            end_deg=spec.end_deg,
            thickness=spec.thickness * scale,
            pal=pal,
            tilt_deg=spec.tilt_deg,
            intensity=spec.intensity,
            is_thrust=spec.is_thrust,
        )

    def _draw_body_resonance_aura(
        self,
        surf: pygame.Surface,
        pelvis: Vec2,
        chest: Vec2,
        pal: CeciliaPalette,
        strength: float,
        phase: float,
    ) -> None:
        aura = pygame.Surface(surf.get_size(), pygame.SRCALPHA)
        center = pelvis.lerp_to(chest, 0.45)
        for i in range(6):
            ang = phase * 2.5 + i * 1.05
            dx = math.cos(ang) * (28.0 + 14.0 * math.sin(phase * 4.0 + i))
            p0 = Vec2(center.x + dx * 0.65, pelvis.y + 42.0)
            p1 = Vec2(center.x + dx * 1.25, chest.y - 12.0)
            p2 = Vec2(center.x + dx * 0.4, chest.y - 78.0 - 18.0 * math.sin(phase * 5.0 + i))
            spine = sample_quad_bezier(p0, p1, p2, 10)
            ws = [max(1.0, math.sin((k / 10.0) * math.pi) * 14.0 * strength) for k in range(11)]
            poly = build_tapered_ribbon(spine, ws)
            if len(poly) >= 3:
                col = pal.aura_primary if (i % 2 == 0) else pal.aura_secondary
                pygame.draw.polygon(aura, with_alpha(col, int(75 * strength)), poly)
        surf.blit(aura, (0, 0))

    def _draw_high_ponytail(
        self,
        surf: pygame.Surface,
        kf: PoseKeyframe,
        proj: Dict[str, Vec2],
        pscale: Dict[str, float],
        pal: CeciliaPalette,
    ) -> None:
        """Render Cecilia's iconic voluminous high midnight-black ponytail with glossy anime sheen."""
        head = proj["head"]
        s = pscale["head"]
        yaw_r = math.radians(kf.head_yaw)
        # Crown tie sits at top-back of head relative to facing angle
        back_x = -math.sin(yaw_r) * 11.0 * s
        tie = Vec2(head.x + back_x, head.y - 17.0 * s)

        # Flowing swing vector driven by keyframe momentum
        sw_rad = math.radians(kf.ponytail_swing)
        dir_x = -math.cos(sw_rad) * (0.85 if kf.head_yaw >= -20.0 else -0.85)
        lift_y = -kf.ponytail_lift * s

        # Graceful feathery anime high ponytail arch matching char.jpg!
        # Tight crown fountain arching outward & cascading into delicate pointed locks
        crest_p1 = Vec2(tie.x + dir_x * 13.0 * s, tie.y - 10.5 * s + lift_y * 0.45)
        crest_p2 = Vec2(tie.x + dir_x * 28.0 * s, tie.y + 18.0 * s + lift_y * 0.35)
        crest_p3 = Vec2(tie.x + dir_x * 34.0 * s, tie.y + 68.0 * s + lift_y * 0.20)
        crest_p4 = Vec2(tie.x + dir_x * 26.0 * s, tie.y + 114.0 * s + lift_y * 0.08)

        # Draw 6 layered slender feathery anime locks tapering to razor-delicate tips!
        lock_specs = [
            # (lateral_offset, len_scale, max_w, tip_splay, is_main)
            (-7.5 * s, 0.86, 5.2, -10.0 * s, 0),
            (6.5 * s, 0.82, 4.8, 11.0 * s, 0),
            (-4.0 * s, 0.98, 6.2, -6.5 * s, 1),
            (4.0 * s, 0.95, 5.8, 6.0 * s, 1),
            (0.0, 1.06, 7.6, -1.5 * s, 1),
            (1.5 * s, 0.72, 4.4, 9.0 * s, 1),
        ]
        for lat_off, l_sc, max_w, splay, is_main in lock_specs:
            ctrl = [
                tie,
                Vec2(crest_p1.x + lat_off * 0.32, crest_p1.y),
                Vec2(crest_p2.x + lat_off * 0.80, tie.y + (crest_p2.y - tie.y) * l_sc),
                Vec2(crest_p3.x + lat_off * 1.05 + splay * 0.45, tie.y + (crest_p3.y - tie.y) * l_sc),
                Vec2(crest_p4.x + lat_off * 0.85 + splay, tie.y + (crest_p4.y - tie.y) * l_sc),
            ]
            spine = sample_catmull_rom(ctrl, steps_per_seg=5)
            n = len(spine)
            widths = []
            for i in range(n):
                u = i / float(max(1, n - 1))
                # Sleek tied neck -> graceful mid-arch swell -> fine needle anime tip!
                env = math.sin(math.pow(u, 0.52) * math.pi) * (1.0 - u * 0.38)
                w = max(0.6, (1.4 + max_w * env) * s)
                widths.append(w)
            poly = build_tapered_ribbon(spine, widths)
            if len(poly) >= 3:
                self.rast.fill_shaded_poly(
                    surf,
                    poly,
                    pal.hair_deep,
                    pal.hair_base if is_main else pal.hair_deep,
                    pal.hair_mid if is_main else pal.hair_base,
                    rim_col=pal.hair_rim if is_main else None,
                    outline_col=pal.ink_dark,
                    outline_width=1,
                    horizontal_grad=True,
                    cylindrical=True,
                    gloss_pos=0.38 if is_main else -1.0,
                    gloss_col=pal.hair_sheen,
                )
            # Fine silky violet-silver anime hair highlight strands near upper crown arch
            if is_main and n > 9 and max_w >= 6.0:
                hi_spine = spine[3 : int(n * 0.38)]
                hi_w = [max(0.6, 2.2 * s * math.sin((k / float(max(1, len(hi_spine) - 1))) * math.pi)) for k in range(len(hi_spine))]
                hi_poly = build_tapered_ribbon(hi_spine, hi_w)
                if len(hi_poly) >= 3:
                    pygame.draw.polygon(surf, with_alpha(pal.hair_sheen, 165), hi_poly)

        # Satin crimson-trimmed hairband tying the high ponytail
        pygame.draw.circle(surf, pal.accent_shadow, tie.to_int(), max(3, int(6.5 * s)))
        pygame.draw.circle(surf, pal.accent_base, (int(tie.x), int(tie.y - 1)), max(2, int(4.8 * s)))
        pygame.draw.circle(surf, pal.ink_dark, tie.to_int(), max(3, int(6.5 * s)), 1)

    def _draw_leg_and_boot(
        self,
        surf: pygame.Surface,
        side: str,
        kf: PoseKeyframe,
        proj: Dict[str, Vec2],
        pscale: Dict[str, float],
        pal: CeciliaPalette,
    ) -> None:
        """Render anatomically contoured porcelain thigh + glossy above-knee
        high-heeled black leather boot with silver-buckled straps.
        """
        hip = proj[f"{side}_hip"]
        knee = proj[f"{side}_knee"]
        ankle = proj[f"{side}_ankle"]
        toe = proj[f"{side}_toe"]
        s = pscale[f"{side}_knee"]

        # Above-knee boot cuff point sits 72% down the thigh ("zettai ryouiki" gap!)
        cuff_pt = hip.lerp_to(knee, 0.72)

        # 1. Porcelain thigh segment with soft cylindrical skin shading
        self.rast.draw_shaded_capsule(
            surf,
            hip,
            cuff_pt,
            r_a=11.8 * s,
            r_b=9.2 * s,
            shadow_col=pal.skin_shadow,
            base_col=pal.skin_base,
            light_col=pal.skin_light,
            rim_col=pal.accent_rim,
            outline_col=pal.ink_warm,
            bulge_mid=1.2 * s,
            outline_width=1,
        )

        # Subtle lace-hem cast shadow at top of thigh beneath miniskirt
        thigh_dir = (knee - hip).normalized()
        thigh_nrm = thigh_dir.perp()
        sh_a = hip.lerp_to(cuff_pt, 0.15)
        sh_b = hip.lerp_to(cuff_pt, 0.42)
        sh_poly = [
            (sh_a.x - thigh_nrm.x * 10.5 * s, sh_a.y - thigh_nrm.y * 10.5 * s),
            (sh_a.x + thigh_nrm.x * 10.5 * s, sh_a.y + thigh_nrm.y * 10.5 * s),
            (sh_b.x + thigh_nrm.x * 9.5 * s, sh_b.y + thigh_nrm.y * 9.5 * s),
            (sh_b.x - thigh_nrm.x * 9.5 * s, sh_b.y - thigh_nrm.y * 9.5 * s),
        ]
        sh_s = pygame.Surface(surf.get_size(), pygame.SRCALPHA)
        pygame.draw.polygon(sh_s, with_alpha(pal.skin_shadow, 110), sh_poly)
        surf.blit(sh_s, (0, 0))

        # 2. Upper above-knee leather boot shaft (cuff -> knee)
        self.rast.draw_shaded_capsule(
            surf,
            cuff_pt,
            knee,
            r_a=9.8 * s,
            r_b=8.2 * s,
            shadow_col=pal.leather_shadow,
            base_col=pal.leather_base,
            light_col=pal.leather_gloss,
            rim_col=pal.leather_rim,
            outline_col=pal.ink_dark,
            gloss_pos=0.38,
            gloss_col=pal.leather_gloss,
            outline_width=2,
        )

        # 3. Lower calf glossy black leather boot (knee -> ankle) with sculpted calf contour
        self.rast.draw_shaded_capsule(
            surf,
            knee,
            ankle,
            r_a=8.0 * s,
            r_b=5.6 * s,
            shadow_col=pal.leather_shadow,
            base_col=pal.leather_base,
            light_col=pal.leather_gloss,
            rim_col=pal.leather_rim,
            outline_col=pal.ink_dark,
            bulge_mid=1.4 * s,
            gloss_pos=0.36,
            gloss_col=pal.leather_gloss,
            outline_width=2,
        )

        # 4. Sculpted high-heeled gothic leather boot foot & stiletto/block heel
        foot_fwd = (toe - ankle).normalized()
        if foot_fwd.length_sq() < 1e-4:
            foot_fwd = Vec2(1.0, 0.0)
        foot_down = Vec2(0.0, 1.0)
        heel_top = ankle - foot_fwd * (4.5 * s) + foot_down * (2.0 * s)
        heel_bot = heel_top + foot_down * (9.5 * s)
        arch = ankle.lerp_to(toe, 0.42) + foot_down * (6.0 * s)
        sole_mid = ankle.lerp_to(toe, 0.65) + foot_down * (9.5 * s)
        toe_tip = toe + foot_fwd * (3.5 * s) + foot_down * (6.5 * s)
        instep = ankle.lerp_to(toe, 0.46) - foot_down * (1.8 * s)

        boot_foot_poly = [
            (ankle.x - foot_fwd.x * 5.0 * s, ankle.y - 2.0 * s),
            (ankle.x + foot_fwd.x * 4.5 * s, ankle.y - 2.5 * s),
            (instep.x, instep.y),
            (toe_tip.x, toe_tip.y),
            (sole_mid.x, sole_mid.y),
            (arch.x, arch.y),
            (heel_bot.x + foot_fwd.x * 2.5 * s, heel_bot.y),
            (heel_bot.x - foot_fwd.x * 2.8 * s, heel_bot.y),
            (heel_top.x - foot_fwd.x * 2.5 * s, heel_top.y),
        ]
        self.rast.fill_shaded_poly(
            surf,
            boot_foot_poly,
            pal.leather_shadow,
            pal.leather_base,
            pal.leather_gloss,
            rim_col=pal.leather_rim,
            outline_col=pal.ink_dark,
            outline_width=2,
            horizontal_grad=False,
            gloss_pos=0.35,
            gloss_col=pal.leather_gloss,
        )

        # 5. Signature horizontal leather straps with shiny silver square buckles (from char.jpg!)
        # Top thigh cuff buckle strap
        top_c = cuff_pt.lerp_to(knee, 0.24)
        self.rast.draw_leather_buckle_strap(
            surf,
            top_c - thigh_nrm * (10.2 * s),
            top_c + thigh_nrm * (10.2 * s),
            thickness=4.0 * s,
            pal=pal,
            buckle_ratio=0.72 if side == "r" else 0.28,
        )
        # Four shin buckled straps descending from knee to ankle
        shin_dir = (ankle - knee).normalized()
        shin_nrm = shin_dir.perp()
        for strap_u, rad in ((0.22, 8.6), (0.44, 8.2), (0.66, 7.2), (0.86, 6.2)):
            sc = knee.lerp_to(ankle, strap_u)
            self.rast.draw_leather_buckle_strap(
                surf,
                sc - shin_nrm * (rad * s),
                sc + shin_nrm * (rad * s),
                thickness=3.2 * s,
                pal=pal,
                buckle_ratio=0.74 if side == "r" else 0.26,
            )

    def _draw_skirt_back_layer(
        self,
        surf: pygame.Surface,
        kf: PoseKeyframe,
        proj: Dict[str, Vec2],
        pscale: Dict[str, float],
        pal: CeciliaPalette,
    ) -> None:
        """Draw the interior dark underside of the bell miniskirt behind legs."""
        waist = proj["waist"]
        pelvis = proj["pelvis"]
        s = pscale["pelvis"]
        flare = kf.skirt_flare
        tilt = math.radians(kf.skirt_tilt_deg)
        lift = kf.skirt_lift * s

        w_half = 16.0 * s
        hem_half = 44.0 * s * flare
        skirt_h = max(24.0 * s, (42.0 - kf.skirt_lift * 0.45) * s)
        dx_t = math.sin(tilt) * skirt_h
        hem_y = pelvis.y + skirt_h * 0.72 - lift * 0.4

        back_poly = [
            (waist.x - w_half, waist.y + 4.0 * s),
            (waist.x + w_half, waist.y + 4.0 * s),
            (pelvis.x + dx_t + hem_half, hem_y),
            (pelvis.x + dx_t, hem_y + 10.0 * s),
            (pelvis.x + dx_t - hem_half, hem_y),
        ]
        self.rast.fill_shaded_poly(
            surf,
            back_poly,
            pal.dress_shadow,
            pal.accent_shadow,
            pal.dress_shadow,
            outline_col=pal.ink_dark,
            outline_width=1,
            horizontal_grad=False,
        )

    def _draw_torso_corset(
        self,
        surf: pygame.Surface,
        kf: PoseKeyframe,
        proj: Dict[str, Vec2],
        pscale: Dict[str, float],
        pal: CeciliaPalette,
    ) -> None:
        """Render Cecilia's tailored gothic-lolita corset bodice, crimson pleated
        center panel, scalloped red lace collar trim, ruby throat brooch, and
        layered crimson jabot ruffle.
        """
        waist = proj["waist"]
        chest = proj["chest"]
        neck = proj["neck"]
        l_sh = proj["l_shoulder"]
        r_sh = proj["r_shoulder"]
        s = pscale["chest"]

        yaw_deg = kf.torso_yaw
        yaw_rad = math.radians(yaw_deg)
        facing_front = math.cos(yaw_rad)  # +1 front, 0 profile, -1 back

        # Anatomical tapered hourglass torso contour
        sh_left_x = min(l_sh.x, r_sh.x)
        sh_right_x = max(l_sh.x, r_sh.x)
        sh_span = max(14.0 * s, (sh_right_x - sh_left_x) * 0.56)
        waist_half = max(9.5 * s, 12.8 * s * (0.72 + 0.28 * abs(facing_front)))

        # Bust curve offset when in 3/4 or profile view (natural feminine silhouette)
        bust_push = math.sin(yaw_rad) * 5.2 * s

        bodice_poly = [
            (neck.x - 7.0 * s, neck.y + 2.0 * s),
            (chest.x - sh_span, chest.y - 3.0 * s),
            (chest.x - sh_span * 0.92 + bust_push * 0.25, chest.y + 12.0 * s),
            (waist.x - waist_half, waist.y + 6.0 * s),
            (waist.x, waist.y + 11.0 * s),
            (waist.x + waist_half, waist.y + 6.0 * s),
            (chest.x + sh_span * 0.92 + bust_push * 0.85, chest.y + 12.0 * s),
            (chest.x + sh_span, chest.y - 3.0 * s),
            (neck.x + 7.0 * s, neck.y + 2.0 * s),
        ]
        self.rast.fill_shaded_poly(
            surf,
            bodice_poly,
            pal.dress_shadow,
            pal.dress_base,
            pal.dress_light,
            rim_col=pal.dress_rim,
            outline_col=pal.ink_dark,
            outline_width=2,
            horizontal_grad=True,
            cylindrical=True,
        )

        # Front crimson ruffled bodice center panel (visible whenever front is turned toward viewer)
        if facing_front > -0.25:
            panel_vis = clamp((facing_front + 0.25) / 1.1, 0.25, 1.0)
            cx_off = math.sin(yaw_rad) * (sh_span * 0.52)
            pw_top = 8.2 * s * panel_vis
            pw_bot = 5.4 * s * panel_vis
            p_top_y = chest.y - 2.0 * s
            p_bot_y = waist.y + 6.0 * s
            panel_poly = [
                (chest.x + cx_off - pw_top, p_top_y),
                (chest.x + cx_off + pw_top, p_top_y),
                (waist.x + cx_off * 0.75 + pw_bot, p_bot_y),
                (waist.x + cx_off * 0.75 - pw_bot, p_bot_y),
            ]
            self.rast.fill_shaded_poly(
                surf,
                panel_poly,
                pal.accent_shadow,
                pal.accent_base,
                pal.accent_light,
                outline_col=pal.ink_dark,
                outline_width=1,
                horizontal_grad=True,
                cylindrical=True,
            )
            # Fine vertical gothic bodice lacing buttons
            for bi in range(4):
                bu = 0.20 + bi * 0.22
                bx = lerp(chest.x + cx_off, waist.x + cx_off * 0.75, bu)
                by = lerp(p_top_y, p_bot_y, bu)
                pygame.draw.circle(surf, pal.ink_dark, (int(bx), int(by)), max(1, int(1.6 * s)))

            # Crimson V-yoke ruffle framing the chest
            v_left = Vec2(chest.x + cx_off - sh_span * 0.65 * panel_vis, chest.y - 3.0 * s)
            v_mid = Vec2(chest.x + cx_off, chest.y + 11.0 * s)
            v_right = Vec2(chest.x + cx_off + sh_span * 0.65 * panel_vis, chest.y - 3.0 * s)
            self.rast.draw_ruffle_lace_ribbon(
                surf,
                [v_left, v_mid, v_right],
                depth=4.8 * s,
                scallops=5,
                shadow_col=pal.accent_shadow,
                base_col=pal.accent_base,
                light_col=pal.accent_light,
                outline_col=pal.ink_dark,
                outward_sign=1.0,
            )

        # High fitted gothic stand collar + top crimson lace trim
        col_w = 7.4 * s
        col_poly = [
            (neck.x - col_w, neck.y - 7.5 * s),
            (neck.x + col_w, neck.y - 7.5 * s),
            (neck.x + col_w * 1.15, neck.y + 4.0 * s),
            (neck.x - col_w * 1.15, neck.y + 4.0 * s),
        ]
        self.rast.fill_shaded_poly(
            surf,
            col_poly,
            pal.dress_shadow,
            pal.dress_base,
            pal.dress_light,
            outline_col=pal.ink_dark,
            outline_width=1,
            horizontal_grad=True,
        )
        pygame.draw.line(
            surf,
            pal.accent_base,
            (neck.x - col_w, neck.y - 7.5 * s),
            (neck.x + col_w, neck.y - 7.5 * s),
            max(2, int(2.2 * s)),
        )

        # Layered crimson jabot & silver-bezel dark ruby brooch at throat (front-visible)
        if facing_front > -0.15:
            jx = neck.x + math.sin(yaw_rad) * 5.2 * s
            jy = neck.y + 4.0 * s
            fl = kf.jabot_flutter * s
            jabot_poly = [
                (jx - 3.0 * s, jy),
                (jx + 3.0 * s, jy),
                (jx + 10.5 * s + fl, jy + 15.0 * s),
                (jx + 4.0 * s + fl * 0.7, jy + 18.5 * s),
                (jx + fl * 0.5, jy + 15.5 * s),
                (jx - 4.0 * s + fl * 0.7, jy + 18.5 * s),
                (jx - 10.5 * s + fl, jy + 15.0 * s),
            ]
            self.rast.fill_shaded_poly(
                surf,
                jabot_poly,
                pal.accent_shadow,
                pal.accent_base,
                pal.accent_light,
                outline_col=pal.ink_dark,
                outline_width=1,
                horizontal_grad=True,
            )
            # Oval crimson ruby brooch set in silver bezel
            brooch_rect = pygame.Rect(int(jx - 3.2 * s), int(jy - 2.6 * s), max(4, int(6.4 * s)), max(5, int(7.8 * s)))
            pygame.draw.ellipse(surf, pal.silver_bright, brooch_rect.inflate(2, 2))
            pygame.draw.ellipse(surf, pal.jewel_dark, brooch_rect)
            pygame.draw.ellipse(surf, pal.jewel_bright, brooch_rect.inflate(-2, -2))
            pygame.draw.circle(surf, (255, 240, 244), (int(jx - 0.8 * s), int(jy - 0.6 * s)), max(1, int(1.2 * s)))

    def _draw_skirt_front_and_belt(
        self,
        surf: pygame.Surface,
        kf: PoseKeyframe,
        proj: Dict[str, Vec2],
        pscale: Dict[str, float],
        pal: CeciliaPalette,
    ) -> None:
        """Render the voluminous multi-tiered gothic lolita miniskirt (black pleated
        upper + crimson front gusset + crimson scalloped lace + lower black flounce
        + bright crimson ruffle tier + black lace trim) and double-strap leather belt.
        """
        waist = proj["waist"]
        pelvis = proj["pelvis"]
        s = pscale["pelvis"]

        flare = kf.skirt_flare
        tilt_r = math.radians(kf.skirt_tilt_deg)
        lift = kf.skirt_lift * s
        yaw_r = math.radians(kf.torso_yaw)

        w_half = 13.8 * s
        h_total = max(25.0 * s, (46.0 - kf.skirt_lift * 0.4) * s)
        dx = math.sin(tilt_r) * h_total
        hem_half = 44.0 * s * flare

        top_y = waist.y + 4.0 * s
        bot_y = pelvis.y + h_total * 0.72 - lift * 0.35

        # Tier 3 (Bottom-most vivid crimson ruffled petticoat + black lace trim)
        t3_curve = [
            Vec2(pelvis.x + dx - hem_half * 0.96, bot_y - 6.0 * s),
            Vec2(pelvis.x + dx - hem_half * 0.45, bot_y + 1.5 * s),
            Vec2(pelvis.x + dx, bot_y + 4.0 * s),
            Vec2(pelvis.x + dx + hem_half * 0.45, bot_y + 1.5 * s),
            Vec2(pelvis.x + dx + hem_half * 0.96, bot_y - 6.0 * s),
        ]
        # Bottom fine black lace hem
        self.rast.draw_ruffle_lace_ribbon(
            surf,
            [Vec2(p.x, p.y + 5.0 * s) for p in t3_curve],
            depth=5.5 * s,
            scallops=10,
            shadow_col=pal.dress_shadow,
            base_col=pal.dress_base,
            light_col=pal.dress_light,
            outline_col=pal.ink_dark,
            outward_sign=1.0,
        )
        # Vibrant crimson gathered ruffle tier
        self.rast.draw_ruffle_lace_ribbon(
            surf,
            t3_curve,
            depth=9.5 * s,
            scallops=8,
            shadow_col=pal.accent_shadow,
            base_col=pal.accent_base,
            light_col=pal.accent_light,
            outline_col=pal.ink_dark,
            outward_sign=1.0,
        )

        # Tier 2 (Middle black pleated flounce)
        t2_y = lerp(top_y, bot_y, 0.70)
        t2_half = hem_half * 0.88
        t2_curve = [
            Vec2(pelvis.x + dx * 0.7 - t2_half, t2_y - 4.0 * s),
            Vec2(pelvis.x + dx * 0.7 - t2_half * 0.45, t2_y + 2.5 * s),
            Vec2(pelvis.x + dx * 0.7, t2_y + 4.5 * s),
            Vec2(pelvis.x + dx * 0.7 + t2_half * 0.45, t2_y + 2.5 * s),
            Vec2(pelvis.x + dx * 0.7 + t2_half, t2_y - 4.0 * s),
        ]
        self.rast.draw_ruffle_lace_ribbon(
            surf,
            t2_curve,
            depth=8.0 * s,
            scallops=8,
            shadow_col=pal.dress_shadow,
            base_col=pal.dress_base,
            light_col=pal.dress_light,
            outline_col=pal.ink_dark,
            outward_sign=1.0,
        )

        # Tier 1 (Main bell-shaped pleated black gothic miniskirt body)
        t1_y = lerp(top_y, bot_y, 0.60)
        t1_half = hem_half * 0.80
        skirt_poly = [
            (waist.x - w_half, top_y),
            (waist.x + w_half, top_y),
            (pelvis.x + dx * 0.55 + t1_half, t1_y - 3.0 * s),
            (pelvis.x + dx * 0.55 + t1_half * 0.45, t1_y + 3.5 * s),
            (pelvis.x + dx * 0.55, t1_y + 5.5 * s),
            (pelvis.x + dx * 0.55 - t1_half * 0.45, t1_y + 3.5 * s),
            (pelvis.x + dx * 0.55 - t1_half, t1_y - 3.0 * s),
        ]
        self.rast.fill_shaded_poly(
            surf,
            skirt_poly,
            pal.dress_shadow,
            pal.dress_base,
            pal.dress_light,
            rim_col=pal.dress_rim,
            outline_col=pal.ink_dark,
            outline_width=2,
            horizontal_grad=True,
            cylindrical=True,
        )

        # Crimson front triangular pleated panel (signature detail from char.jpg!)
        if math.cos(yaw_r) > -0.35:
            gx_off = math.sin(yaw_r) * t1_half * 0.42
            gusset = [
                (waist.x + gx_off * 0.35 - 3.5 * s, top_y + 3.0 * s),
                (waist.x + gx_off * 0.35 + 3.5 * s, top_y + 3.0 * s),
                (pelvis.x + dx * 0.55 + gx_off + 11.5 * s, t1_y + 4.0 * s),
                (pelvis.x + dx * 0.55 + gx_off - 11.5 * s, t1_y + 4.0 * s),
            ]
            self.rast.fill_shaded_poly(
                surf,
                gusset,
                pal.accent_shadow,
                pal.accent_base,
                pal.accent_light,
                outline_col=pal.ink_dark,
                outline_width=1,
                horizontal_grad=True,
            )

        # Sculpted vertical fabric pleat shadows & highlight ridges across Tier 1
        pleat_count = 7
        for pi in range(1, pleat_count):
            pu = (pi / float(pleat_count)) * 2.0 - 1.0  # -1..+1
            p_top = Vec2(waist.x + pu * w_half * 0.88, top_y + 2.0 * s)
            p_bot = Vec2(
                pelvis.x + dx * 0.55 + pu * t1_half * 0.90,
                t1_y + (1.0 - abs(pu)) * 5.0 * s,
            )
            pygame.draw.line(surf, pal.dress_shadow, (p_top.x, p_top.y), (p_bot.x, p_bot.y), max(1, int(2.0 * s)))
            pygame.draw.line(surf, pal.dress_light, (p_top.x + 1.5, p_top.y), (p_bot.x + 2.0, p_bot.y), 1)

        # Scalloped crimson lace ribbon trimming the lower edge of Tier 1
        t1_lace = [
            Vec2(pelvis.x + dx * 0.55 - t1_half, t1_y - 3.0 * s),
            Vec2(pelvis.x + dx * 0.55 - t1_half * 0.45, t1_y + 3.2 * s),
            Vec2(pelvis.x + dx * 0.55, t1_y + 5.2 * s),
            Vec2(pelvis.x + dx * 0.55 + t1_half * 0.45, t1_y + 3.2 * s),
            Vec2(pelvis.x + dx * 0.55 + t1_half, t1_y - 3.0 * s),
        ]
        self.rast.draw_ruffle_lace_ribbon(
            surf,
            t1_lace,
            depth=5.5 * s,
            scallops=7,
            shadow_col=pal.accent_shadow,
            base_col=pal.accent_base,
            light_col=pal.accent_light,
            outline_col=pal.ink_dark,
            outward_sign=1.0,
        )

        # Wide glossy black leather double-strap waist belt with silver buckle
        belt_l = Vec2(waist.x - w_half * 1.04, top_y - 1.0 * s)
        belt_r = Vec2(waist.x + w_half * 1.04, top_y - 1.0 * s)
        buckle_pos = clamp(0.5 + math.sin(yaw_r) * 0.34, 0.22, 0.78)
        self.rast.draw_leather_buckle_strap(
            surf,
            belt_l,
            belt_r,
            thickness=7.4 * s,
            pal=pal,
            buckle_ratio=buckle_pos,
            show_buckle=(math.cos(yaw_r) > -0.2),
        )

    def _draw_arm_juliet(
        self,
