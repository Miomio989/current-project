class StylishRankTracker:
    """Devil May Cry 4 inspired real-time battle flair & variety rank meter (D -> SSS)."""

    def __init__(self) -> None:
        self.meter: float = 0.0
        self.rank: StyleRank = StyleRank.NONE
        self.recent_moves: Deque[FighterState] = collections.deque(maxlen=6)
        self.peak_rank: StyleRank = StyleRank.NONE

    def reset(self) -> None:
        self.meter = 0.0
        self.rank = StyleRank.NONE
        self.recent_moves.clear()

    def register_action(self, state: FighterState, base_pts: float, is_counter: bool = False, is_deflect: bool = False) -> bool:
        repeats = sum(1 for m in self.recent_moves if m == state)
        variety_mul = 1.0 if repeats == 0 else (0.55 if repeats == 1 else 0.25)
        gain = base_pts * variety_mul * (1.35 if is_counter else 1.0) * (1.5 if is_deflect else 1.0)
        self.recent_moves.append(state)
        old_rank = self.rank
        self.meter = clamp(self.meter + gain, 0.0, 260.0)
        self._update_rank()
        if self.rank.value[1] > self.peak_rank.value[1]:
            self.peak_rank = self.rank
        return self.rank.value[1] > old_rank.value[1]

    def on_damaged(self) -> None:
        self.meter = max(0.0, self.meter - 58.0)
        self._update_rank()

    def update(self, dt: float) -> None:
        if self.meter > 0.0:
            decay = 8.5 + self.rank.value[1] * 2.4
            self.meter = max(0.0, self.meter - decay * dt)
            self._update_rank()

    def _update_rank(self) -> None:
        m = self.meter
        if m >= 210.0: self.rank = StyleRank.SSS
        elif m >= 170.0: self.rank = StyleRank.SS
        elif m >= 132.0: self.rank = StyleRank.S
        elif m >= 96.0: self.rank = StyleRank.A
        elif m >= 64.0: self.rank = StyleRank.B
        elif m >= 36.0: self.rank = StyleRank.C
        elif m >= 14.0: self.rank = StyleRank.D
        else: self.rank = StyleRank.NONE


class Fighter:
    """Complete fighting-game actor for Cecilia Darkmoon (P1 & P2/AI)."""

    def __init__(
        self,
        slot: int,
        name: str,
        palette_idx: int,
        atlas: Dict[FighterState, List[HandCraftedKeyframe]],
        moves: Dict[FighterState, MoveSpec],
    ) -> None:
        self.slot = slot
        self.name = name
        self.palette_idx = palette_idx
        self.atlas = atlas
        self.moves = moves

        self.x: float = STAGE_CENTER_X - 180.0 if slot == 0 else STAGE_CENTER_X + 180.0
        self.y: float = GROUND_Y
        self.vx: float = 0.0
        self.vy: float = 0.0
        self.facing_right: bool = (slot == 0)

        self.hp: int = MAX_HEALTH
        self.hp_trail: float = float(MAX_HEALTH)
        self.curse_gauge: float = 25.0
        self.soul_burst: float = 50.0
        self.guard_gauge: float = MAX_GUARD_GAUGE
        self.overdrive_timer: float = 0.0
        self.rounds_won: int = 0

        self.state: FighterState = FighterState.IDLE
        self.frame_idx: int = 0
        self.frame_tick: int = 0
        self.state_total_frames: int = 0

        self.hitstun_frames: int = 0
        self.blockstun_frames: int = 0
        self.hitstop_frames: int = 0
        self.invuln_frames: int = 0
        self.just_guard_timer: int = 0
        self.flash_white_frames: int = 0
        self.air_dashes_left: int = 1
        self.move_has_hit: bool = False
        self.move_has_spawned_proj: bool = False
        self.move_connected: bool = False
        self.juggle_count: int = 0
        self.combo_hits_taken: int = 0
        self.combo_dmg_taken: int = 0
        self.combo_proration: float = 1.0
        self.last_frame_advantage: int = 0

        self.inp_buf = InputBuffer()
        self.style = StylishRankTracker()
        self.last_hit_seq: List[FighterState] = []

    def reset_for_round(self, start_x: float, facing_right: bool) -> None:
        self.x = start_x
        self.y = GROUND_Y
        self.vx = 0.0
        self.vy = 0.0
        self.facing_right = facing_right
        self.hp = MAX_HEALTH
        self.hp_trail = float(MAX_HEALTH)
        self.guard_gauge = MAX_GUARD_GAUGE
        self.overdrive_timer = 0.0
        self.hitstun_frames = 0
        self.blockstun_frames = 0
        self.hitstop_frames = 0
        self.invuln_frames = 0
        self.just_guard_timer = 0
        self.flash_white_frames = 0
        self.air_dashes_left = 1
        self.juggle_count = 0
        self.combo_hits_taken = 0
        self.combo_dmg_taken = 0
        self.combo_proration = 1.0
        self.style.reset()
        self.set_state(FighterState.INTRO_STANCE)

    def current_frames(self) -> List[HandCraftedKeyframe]:
        return self.atlas.get(self.state, self.atlas[FighterState.IDLE])

    def current_kf(self) -> HandCraftedKeyframe:
        frs = self.current_frames()
        return frs[min(self.frame_idx, len(frs) - 1)]

    def is_airborne(self) -> bool:
        return self.y < GROUND_Y - 0.5

    def is_attacking(self) -> bool:
        return self.state in self.moves

    def is_hitstunned(self) -> bool:
        return self.state in (
            FighterState.HIT_HIGH, FighterState.HIT_LOW, FighterState.HIT_HEAVY,
            FighterState.LAUNCHED, FighterState.AIR_SPIN_HIT, FighterState.WALL_BOUNCE,
            FighterState.KNOCKDOWN, FighterState.GUARD_CRUSH, FighterState.THROWN,
            FighterState.DEFEAT_COLLAPSE,
        )

    def is_guarding(self) -> bool:
        return self.state in (FighterState.GUARD_HIGH, FighterState.GUARD_LOW, FighterState.GUARD_AIR)

    def can_act(self) -> bool:
        return self.state in (
            FighterState.IDLE, FighterState.CROUCH, FighterState.CROUCH_ENTER,
            FighterState.WALK_FWD, FighterState.WALK_BACK, FighterState.DASH_FWD,
            FighterState.JUMP_RISE, FighterState.JUMP_APEX, FighterState.JUMP_FALL,
        )

    def get_hud_expression(self) -> ExpressionId:
        if self.hp <= 0 or self.is_hitstunned():
            return ExpressionId.PAIN
        if self.overdrive_timer > 0.0:
            return ExpressionId.ECSTATIC
        if self.is_attacking():
            return ExpressionId.FIERCE
        if self.is_guarding() or self.state == FighterState.JUST_DEFLECT:
            return ExpressionId.FOCUSED
        if self.state in (FighterState.VICTORY_POSE, FighterState.VICTORY_ELEGANT):
            return ExpressionId.VICTORY
        if self.hp < MAX_HEALTH * 0.30:
            return ExpressionId.CONFIDENT
        return ExpressionId.SERENE

    def set_state(self, new_state: FighterState) -> None:
        if new_state not in self.atlas:
            new_state = FighterState.IDLE
        self.state = new_state
        self.frame_idx = 0
        self.frame_tick = 0
        self.state_total_frames = 0
        self.move_has_hit = False
        self.move_has_spawned_proj = False
        self.move_connected = False
        kf = self.current_kf()
        if abs(kf.vel_x) > 0.01:
            self.vx = kf.vel_x * (1.0 if self.facing_right else -1.0)
        if abs(kf.vel_y) > 0.01:
            self.vy = kf.vel_y

    def get_pushbox(self) -> BoxRect:
        h = PUSHBOX_H * (0.68 if self.state in (FighterState.CROUCH, FighterState.GUARD_LOW) else 1.0)
        return BoxRect(self.x - PUSHBOX_HALF_W, self.y - h, PUSHBOX_HALF_W * 2.0, h)

    def _to_world_box(self, b: BoxRect) -> BoxRect:
        if self.facing_right:
            return BoxRect(self.x + b.x, self.y + b.y, b.w, b.h)
        return BoxRect(self.x - b.x - b.w, self.y + b.y, b.w, b.h)

    def get_world_hurtboxes(self) -> List[BoxRect]:
        if self.invuln_frames > 0 or self.current_kf().invuln:
            return []
        return [self._to_world_box(b) for b in self.current_kf().hurtboxes]

    def get_world_hitboxes(self) -> List[BoxRect]:
        if self.move_has_hit:
            return []
        return [self._to_world_box(b) for b in self.current_kf().hitboxes]

    def can_cancel_into(self, target: FighterState) -> bool:
        if not self.is_attacking():
            return False
        spec = self.moves.get(self.state)
        if spec is None:
            return False
        if not self.move_connected and self.state != FighterState.SP_WALTZ_1 and self.state != FighterState.SP_WALTZ_2:
            return False
        cf = spec.cancel_flags
        # Normal chains: A -> B -> C -> Command -> Drive -> Special -> Super
        if target in (FighterState.ATK_5B, FighterState.ATK_2B, FighterState.ATK_JB) and (cf & CancelFlag.NORMAL_CHAIN):
            return self.state in (FighterState.ATK_5A, FighterState.ATK_2A, FighterState.ATK_JA)
        if target in (FighterState.ATK_5C, FighterState.ATK_2C, FighterState.ATK_JC) and (cf & CancelFlag.NORMAL_CHAIN):
            return self.state in (FighterState.ATK_5A, FighterState.ATK_2A, FighterState.ATK_5B, FighterState.ATK_2B, FighterState.ATK_JA, FighterState.ATK_JB)
        if target in (FighterState.ATK_6B, FighterState.ATK_3C, FighterState.ATK_6C) and (cf & CancelFlag.COMMAND):
            return True
        if target in (FighterState.ATK_5D, FighterState.ATK_2D, FighterState.ATK_6D, FighterState.ATK_JD) and (cf & CancelFlag.DRIVE):
            return True
        if target.name.startswith("SP_") and (cf & CancelFlag.SPECIAL):
            # Rekka follow-up gating
            if target in (FighterState.SP_WALTZ_2, FighterState.SP_WALTZ_LOW):
                return self.state == FighterState.SP_WALTZ_1
            if target in (FighterState.SP_WALTZ_3, FighterState.SP_WALTZ_OVER):
                return self.state == FighterState.SP_WALTZ_2
            return True
        if target in (FighterState.SUPER_REQUIEM_START, FighterState.ASTRAL_START) and (cf & CancelFlag.SUPER):
            return True
        return False

    def handle_input(self, dx: int, dy: int, btns: InputButton, opp: "Fighter", audio: StudioAudioEngine, vfx: "VFXDirector", stage: DrownedCathedralStage) -> Optional[FighterState]:
        fr = self.inp_buf.push(dx, dy, btns, self.facing_right)
        np = dir_to_numpad(dx, dy, self.facing_right)
        holding_back = np in (1, 4, 7)
        if holding_back:
            self.just_guard_timer = min(8, self.just_guard_timer + 1)
        else:
            self.just_guard_timer = 0

        if self.hitstop_frames > 0 or self.hp <= 0:
            return None

        # Wakeup Ukemi roll inputs from knockdown
        if self.state == FighterState.KNOCKDOWN and self.frame_idx >= 3:
            if np in (3, 6):
                self.set_state(FighterState.WAKEUP_ROLL_FWD)
                self.invuln_frames = 18
                audio.play_sfx(SFXId.ROLL_WATER, self._pan())
                stage.spawn_water_splash(self.x, 0.9)
                return self.state
            elif np in (1, 4):
                self.set_state(FighterState.WAKEUP_ROLL_BACK)
                self.invuln_frames = 18
                audio.play_sfx(SFXId.ROLL_WATER, self._pan())
                stage.spawn_water_splash(self.x, 0.9)
                return self.state

        # Shadow Cancel (L button) during ANY connected attack recovery!
        if self.inp_buf.button_pressed(InputButton.SHADOW, 4) and self.curse_gauge >= 50.0 and self.is_attacking() and self.move_connected:
            self.curse_gauge -= 50.0
            self.set_state(FighterState.SHADOW_CANCEL)
            self.vx = (11.5 if self.facing_right else -11.5)
            self.vy = min(0.0, self.vy)
            audio.play_sfx(SFXId.SHADOW_CANCEL, self._pan())
            vfx.spawn_shockwave(self.x, self.y - 92, (246, 38, 128), 115)
            stage.spawn_water_splash(self.x, 1.1, crimson=True)
            return FighterState.SHADOW_CANCEL

        # Eclipse Overdrive / Soul Burst (H button) — usable even as defensive burst!
        if self.inp_buf.button_pressed(InputButton.BURST, 4) and self.soul_burst >= 100.0 and self.overdrive_timer <= 0.0:
            if self.can_act() or self.is_attacking() or self.state in (FighterState.HIT_HIGH, FighterState.HIT_LOW, FighterState.HIT_HEAVY):
                self.soul_burst = 0.0
                self.overdrive_timer = 11.0
                self.hitstun_frames = 0
                self.invuln_frames = 22
                self.set_state(FighterState.ECLIPSE_BURST)
                audio.play_sfx(SFXId.ECLIPSE_BURST, self._pan())
                vfx.spawn_shockwave(self.x, self.y - 96, (255, 198, 72), 210)
                stage.trigger_lightning(1.0)
                stage.spawn_water_splash(self.x, 1.5, crimson=True)
                return FighterState.ECLIPSE_BURST

        if self.is_hitstunned() or self.is_guarding() or self.state in (
            FighterState.JUST_DEFLECT, FighterState.SWORD_CLASH, FighterState.THROW_EXECUTE,
            FighterState.WAKEUP_NEUTRAL, FighterState.WAKEUP_ROLL_FWD, FighterState.WAKEUP_ROLL_BACK,
            FighterState.ECLIPSE_BURST, FighterState.INTRO_STANCE, FighterState.INTRO_DRAW,
            FighterState.VICTORY_POSE, FighterState.VICTORY_ELEGANT,
        ):
            return None

        air = self.is_airborne()
        chosen: Optional[FighterState] = None

        # 1. Astral Curse Finale (214214+D or C+D at 100% Curse & Overdrive!)
        if not air and self.curse_gauge >= 100.0:
            if (self.inp_buf.match_motion((2, 4, 2, 4), self.facing_right, 22) and self.inp_buf.button_pressed(InputButton.D, 6)) or (
                self.overdrive_timer > 0.0 and (fr.buttons & (InputButton.C | InputButton.D)) == (InputButton.C | InputButton.D) and fr.pressed != InputButton.NONE
            ):
                chosen = FighterState.ASTRAL_START

        # 2. Distortion Super: Scarlet Requiem (236236+C or B+C at 50%+ Curse!)
        if chosen is None and not air and self.curse_gauge >= 50.0:
            if (self.inp_buf.match_motion((2, 6, 2, 6), self.facing_right, 22) and self.inp_buf.button_pressed(InputButton.C, 6)) or (
                (fr.buttons & (InputButton.B | InputButton.C)) == (InputButton.B | InputButton.C) and fr.pressed != InputButton.NONE and np in (6, 3, 2)
            ):
                chosen = FighterState.SUPER_REQUIEM_START

        # 3. Motion Specials & Rekka Follow-ups!
        if chosen is None and not air:
            # Rekka Nightmare Waltz Follow-ups (214 chains!)
            if self.state == FighterState.SP_WALTZ_1 and self.frame_idx >= 2:
                if self.inp_buf.button_pressed(InputButton.B, 5):
                    chosen = FighterState.SP_WALTZ_LOW if np in (1, 2, 3) else FighterState.SP_WALTZ_2
            elif self.state == FighterState.SP_WALTZ_2 and self.frame_idx >= 2:
                if self.inp_buf.button_pressed(InputButton.C, 5):
                    chosen = FighterState.SP_WALTZ_OVER if np in (6, 9) else FighterState.SP_WALTZ_3

            if chosen is None:
                # 623 Vespera Ascension (DP Anti-Air!)
                if self.inp_buf.match_motion((6, 2, 3), self.facing_right, 15) or self.inp_buf.match_motion((6, 2, 6), self.facing_right, 15):
                    if (fr.buttons & (InputButton.A | InputButton.C)) == (InputButton.A | InputButton.C) and self.curse_gauge >= 25.0:
                        chosen = FighterState.SP_ASCENSION_EX
                    elif self.inp_buf.button_pressed(InputButton.C, 5):
                        chosen = FighterState.SP_ASCENSION_H
                    elif self.inp_buf.button_pressed(InputButton.A, 5) or self.inp_buf.button_pressed(InputButton.B, 5):
                        chosen = FighterState.SP_ASCENSION_L
                # 41236 Abyssal Blood Lunge
                elif self.inp_buf.match_motion((4, 2, 6), self.facing_right, 18) and self.inp_buf.button_pressed(InputButton.C, 5):
                    chosen = FighterState.SP_BLOOD_LUNGE
                # 236 Crimson Crescent Projectile
                elif self.inp_buf.match_motion((2, 3, 6), self.facing_right, 14) or self.inp_buf.match_motion((2, 6), self.facing_right, 12):
                    if (fr.buttons & (InputButton.A | InputButton.C)) == (InputButton.A | InputButton.C) and self.curse_gauge >= 25.0:
                        chosen = FighterState.SP_CRESCENT_EX
                    elif self.inp_buf.button_pressed(InputButton.C, 5):
                        chosen = FighterState.SP_CRESCENT_H
                    elif self.inp_buf.button_pressed(InputButton.A, 5) or self.inp_buf.button_pressed(InputButton.B, 5):
                        chosen = FighterState.SP_CRESCENT_L
                # 421 Darkmoon Riposte Parry Stance
                elif self.inp_buf.match_motion((4, 2, 1), self.facing_right, 15) and (
                    self.inp_buf.button_pressed(InputButton.D, 5) or self.inp_buf.button_pressed(InputButton.A, 5)
                ):
                    chosen = FighterState.SP_RIPOSTE_STANCE
                # 214 Nightmare Waltz Stage 1
                elif self.inp_buf.match_motion((2, 1, 4), self.facing_right, 14) or self.inp_buf.match_motion((2, 4), self.facing_right, 12):
                    if self.inp_buf.button_pressed(InputButton.A, 5) or self.inp_buf.button_pressed(InputButton.B, 5) or self.inp_buf.button_pressed(InputButton.C, 5):
                        chosen = FighterState.SP_WALTZ_1
        elif chosen is None and air:
            if self.inp_buf.match_motion((2, 6), self.facing_right, 14) and (
                self.inp_buf.button_pressed(InputButton.B, 5) or self.inp_buf.button_pressed(InputButton.C, 5)
            ):
                chosen = FighterState.SP_AIR_CRESCENT

        # 4. Throws, Cursed Drive (D), Command Normals & Standard Normals
        if chosen is None:
            if not air and self.inp_buf.button_pressed(InputButton.THROW, 4):
                chosen = FighterState.THROW_ATTEMPT
            elif self.inp_buf.button_pressed(InputButton.D, 4):
                if air:
                    chosen = FighterState.ATK_JD
                elif np in (1, 2, 3):
                    chosen = FighterState.ATK_2D
                elif np == 6:
                    chosen = FighterState.ATK_6D
                else:
                    chosen = FighterState.ATK_5D
            elif self.inp_buf.button_pressed(InputButton.C, 4):
                if air:
                    chosen = FighterState.ATK_JC
                elif np == 3:
                    chosen = FighterState.ATK_3C
                elif np == 6:
                    chosen = FighterState.ATK_6C
                elif np in (1, 2):
                    chosen = FighterState.ATK_2C
                else:
                    chosen = FighterState.ATK_5C
            elif self.inp_buf.button_pressed(InputButton.B, 4):
                if air:
                    chosen = FighterState.ATK_JB
                elif np == 6:
                    chosen = FighterState.ATK_6B
                elif np in (1, 2, 3):
                    chosen = FighterState.ATK_2B
                else:
                    chosen = FighterState.ATK_5B
            elif self.inp_buf.button_pressed(InputButton.A, 4):
                if air:
                    chosen = FighterState.ATK_JA
                elif np in (1, 2, 3):
                    chosen = FighterState.ATK_2A
                else:
                    chosen = FighterState.ATK_5A
            elif not air and self.inp_buf.button_pressed(InputButton.TAUNT, 3) and self.can_act():
                chosen = FighterState.TAUNT_NOBLE

        # Validate trigger (from neutral OR valid cancel window!)
        if chosen is not None:
            if self.can_act() or self.can_cancel_into(chosen):
                spec = self.moves.get(chosen)
                if spec is not None and spec.curse_cost > 0.0:
                    if self.curse_gauge < spec.curse_cost:
                        chosen = None
                    else:
                        self.curse_gauge -= spec.curse_cost
                if chosen is not None:
                    self.set_state(chosen)
                    if chosen in (FighterState.SP_ASCENSION_L, FighterState.SP_ASCENSION_H, FighterState.SP_ASCENSION_EX):
                        self.invuln_frames = 10 if chosen == FighterState.SP_ASCENSION_EX else 7
                    return chosen

        # 5. Locomotion (Jump, Air Dash, Ground Dash, Backstep, Walk, Crouch)
        if self.can_act():
            if air:
                if self.air_dashes_left > 0 and self.y < GROUND_Y - 52:
                    if self.inp_buf.match_double_tap(6, self.facing_right, 11):
                        self.air_dashes_left -= 1
                        self.set_state(FighterState.AIR_DASH_FWD)
                        self.vx = AIR_DASH_SPEED * (1.0 if self.facing_right else -1.0)
                        self.vy = -1.2
                        audio.play_sfx(SFXId.AIR_DASH, self._pan())
                        return self.state
                    elif self.inp_buf.match_double_tap(4, self.facing_right, 11):
                        self.air_dashes_left -= 1
                        self.set_state(FighterState.AIR_DASH_BACK)
                        self.vx = -AIR_DASH_SPEED * 0.88 * (1.0 if self.facing_right else -1.0)
                        self.vy = -1.2
                        audio.play_sfx(SFXId.AIR_DASH, self._pan())
                        return self.state
            else:
                if dy < 0:
                    self.set_state(FighterState.JUMP_SQUAT)
                    self.vx = dx * WALK_FWD_SPEED * 1.18
                    return self.state
                elif dy > 0:
                    if self.state not in (FighterState.CROUCH, FighterState.CROUCH_ENTER):
                        self.set_state(FighterState.CROUCH_ENTER)
                    self.vx *= 0.72
                else:
                    if self.state in (FighterState.CROUCH, FighterState.CROUCH_ENTER):
                        self.set_state(FighterState.CROUCH_EXIT)
                    elif self.inp_buf.match_double_tap(6, self.facing_right, 11) and self.state != FighterState.DASH_FWD:
                        self.set_state(FighterState.DASH_FWD)
                        audio.play_sfx(SFXId.DASH_SPLASH, self._pan())
                        stage.spawn_water_splash(self.x, 1.0)
                    elif self.inp_buf.match_double_tap(4, self.facing_right, 11):
                        self.set_state(FighterState.BACKSTEP)
                        self.invuln_frames = 9
                        self.vx = -BACKSTEP_SPEED * (1.0 if self.facing_right else -1.0)
                        audio.play_sfx(SFXId.BACKSTEP_WHOOSH, self._pan())
                        stage.spawn_water_splash(self.x, 0.85)
                    elif dx != 0:
                        moving_fwd = (dx > 0 and self.facing_right) or (dx < 0 and not self.facing_right)
                        if self.state == FighterState.DASH_FWD and moving_fwd:
                            self.vx = DASH_FWD_SPEED * (1.0 if self.facing_right else -1.0) * (1.14 if self.overdrive_timer > 0 else 1.0)
                        else:
                            tgt = FighterState.WALK_FWD if moving_fwd else FighterState.WALK_BACK
                            if self.state != tgt:
                                self.set_state(tgt)
                            spd = (WALK_FWD_SPEED if moving_fwd else -WALK_BACK_SPEED) * (1.12 if self.overdrive_timer > 0 else 1.0)
                            self.vx = spd * (1.0 if self.facing_right else -1.0)
                    else:
                        if self.state == FighterState.DASH_FWD:
                            self.set_state(FighterState.DASH_BRAKE)
                        elif self.state not in (FighterState.IDLE, FighterState.DASH_BRAKE, FighterState.CROUCH_EXIT):
                            self.set_state(FighterState.IDLE)
                        self.vx *= 0.70
        return None

    def _pan(self) -> float:
        return clamp((self.x - STAGE_CENTER_X) / 480.0, -0.85, 0.85)

    def step_physics(self, opp: "Fighter", audio: StudioAudioEngine, vfx: "VFXDirector", stage: DrownedCathedralStage) -> None:
        # Smooth HP drain trail
        if self.hp_trail > self.hp:
            self.hp_trail = max(float(self.hp), self.hp_trail - 52.0)
        else:
            self.hp_trail = float(self.hp)

        if self.overdrive_timer > 0.0:
            self.overdrive_timer = max(0.0, self.overdrive_timer - FIXED_DT)
            self.curse_gauge = min(MAX_CURSE_GAUGE, self.curse_gauge + 0.08)

        # Regenerate Guard Integrity smoothly when not blocking
        if not self.is_guarding() and self.state != FighterState.GUARD_CRUSH:
            self.guard_gauge = min(MAX_GUARD_GAUGE, self.guard_gauge + 0.16)

        self.style.update(FIXED_DT)
        if self.invuln_frames > 0:
            self.invuln_frames -= 1
        if self.flash_white_frames > 0:
            self.flash_white_frames -= 1
        if self.hitstop_frames > 0:
            self.hitstop_frames -= 1
            return

        # Auto-face opponent when grounded & able to act
        if not self.is_airborne() and self.state in (
            FighterState.IDLE, FighterState.CROUCH, FighterState.WALK_FWD, FighterState.WALK_BACK,
        ):
            self.facing_right = opp.x >= self.x

        # Apply keyframe motion, splashes, and SFX cues on frame entry!
        kf = self.current_kf()
        if self.frame_tick == 0:
            if abs(kf.vel_x) > 0.01 and not self.is_hitstunned():
                self.vx = kf.vel_x * (1.0 if self.facing_right else -1.0)
            if abs(kf.vel_y) > 0.01 and not self.is_hitstunned():
                self.vy = kf.vel_y
            if kf.water_splash > 0.05 and not self.is_airborne():
                stage.spawn_water_splash(self.x, kf.water_splash, crimson=(self.overdrive_timer > 0))
            if kf.sfx_cue:
                try:
                    audio.play_sfx(SFXId[kf.sfx_cue], self._pan())
                except Exception:
                    pass
            if kf.vfx_cue == "AFTERIMAGE":
                vfx.spawn_afterimage(self)
            elif kf.vfx_cue == "BLOOD_SPARK":
                vfx.spawn_slash_sparks(self.x + (64 if self.facing_right else -64), self.y - 108, 12, (255, 48, 86))

        # Spawn crimson afterimage trails during dashes, Shadow Cancel, Overdrive & Supers!
        if (self.overdrive_timer > 0.0 or self.state in (
            FighterState.DASH_FWD, FighterState.AIR_DASH_FWD, FighterState.SHADOW_CANCEL,
            FighterState.ATK_6D, FighterState.SUPER_REQUIEM_RUSH, FighterState.SP_BLOOD_LUNGE,
        )) and (self.state_total_frames % 3 == 0):
            vfx.spawn_afterimage(self)

        # Spawn projectiles when move reaches its active firing frame!
        spec = self.moves.get(self.state)
        if spec is not None and spec.projectile_type and not self.move_has_spawned_proj and self.frame_idx >= 3:
            self.move_has_spawned_proj = True
            vfx.spawn_projectile(self, spec.projectile_type, spec)

        # Horizontal & vertical integration
        self.x += self.vx
        self.y += self.vy

        if self.is_airborne():
            if self.state not in (FighterState.AIR_DASH_FWD, FighterState.AIR_DASH_BACK):
                self.vy = min(MAX_FALL_SPEED, self.vy + GRAVITY_BASE)
        else:
            if self.state not in (FighterState.WALK_FWD, FighterState.WALK_BACK, FighterState.DASH_FWD, FighterState.SUPER_REQUIEM_RUSH):
                self.vx *= 0.80

        # Wall collision & Wall-Bounce check!
        if self.x < STAGE_LEFT_WALL:
            self.x = STAGE_LEFT_WALL
            if self.state == FighterState.WALL_BOUNCE and self.vx < -4.0:
                self.vx = 6.2
                self.vy = -10.5
                self.set_state(FighterState.LAUNCHED)
                audio.play_sfx(SFXId.HIT_SLAM, -0.8)
                vfx.spawn_shockwave(self.x, self.y - 96, (255, 86, 102), 95)
        elif self.x > STAGE_RIGHT_WALL:
            self.x = STAGE_RIGHT_WALL
            if self.state == FighterState.WALL_BOUNCE and self.vx > 4.0:
                self.vx = -6.2
                self.vy = -10.5
                self.set_state(FighterState.LAUNCHED)
                audio.play_sfx(SFXId.HIT_SLAM, 0.8)
                vfx.spawn_shockwave(self.x, self.y - 96, (255, 86, 102), 95)

        # Landing transition!
        if self.y >= GROUND_Y:
            was_air = self.vy > 1.2
            self.y = GROUND_Y
            self.vy = 0.0
            self.air_dashes_left = 1
            if was_air:
                if self.state in (FighterState.LAUNCHED, FighterState.AIR_SPIN_HIT, FighterState.WALL_BOUNCE):
                    self.set_state(FighterState.DEFEAT_COLLAPSE if self.hp <= 0 else FighterState.KNOCKDOWN)
                    self.vx *= 0.35
                    audio.play_sfx(SFXId.FALL_PLUNGE, self._pan())
                    stage.spawn_water_splash(self.x, 1.45, crimson=True)
                elif self.state in (
                    FighterState.JUMP_RISE, FighterState.JUMP_APEX, FighterState.JUMP_FALL,
                    FighterState.AIR_DASH_FWD, FighterState.AIR_DASH_BACK, FighterState.GUARD_AIR,
                    FighterState.ATK_JA, FighterState.ATK_JB, FighterState.ATK_JC, FighterState.ATK_JD,
                    FighterState.SP_AIR_CRESCENT, FighterState.SP_ASCENSION_L, FighterState.SP_ASCENSION_H, FighterState.SP_ASCENSION_EX,
                ):
                    self.set_state(FighterState.LANDING)
                    self.vx *= 0.45
                    audio.play_sfx(SFXId.LAND_SPLASH, self._pan())
                    stage.spawn_water_splash(self.x, 1.05)

        # Hitstun & Blockstun countdown
        if self.hitstun_frames > 0:
            self.hitstun_frames -= 1
            if self.hitstun_frames == 0 and self.state in (FighterState.HIT_HIGH, FighterState.HIT_LOW, FighterState.HIT_HEAVY, FighterState.GUARD_CRUSH):
                self.combo_hits_taken = 0
                self.combo_dmg_taken = 0
                self.combo_proration = 1.0
                self.juggle_count = 0
                self.set_state(FighterState.IDLE)

        if self.blockstun_frames > 0:
            self.blockstun_frames -= 1
            if self.blockstun_frames == 0 and self.is_guarding():
                self.set_state(FighterState.CROUCH if self.state == FighterState.GUARD_LOW else FighterState.IDLE)

        # Advance keyframe plate timing
        self.state_total_frames += 1
        self.frame_tick += 1
        if self.frame_tick >= max(1, kf.duration):
            self.frame_tick = 0
            frs = self.current_frames()
            if self.frame_idx + 1 < len(frs):
                self.frame_idx += 1
            else:
                self._on_animation_complete(audio, stage)

    def _on_animation_complete(self, audio: StudioAudioEngine, stage: DrownedCathedralStage) -> None:
        st = self.state
        looping = (
            FighterState.IDLE, FighterState.CROUCH, FighterState.WALK_FWD,
            FighterState.WALK_BACK, FighterState.DASH_FWD, FighterState.JUMP_FALL,
            FighterState.GUARD_HIGH, FighterState.GUARD_LOW, FighterState.GUARD_AIR,
            FighterState.VICTORY_POSE, FighterState.VICTORY_ELEGANT, FighterState.DEFEAT_COLLAPSE,
        )
        if st in looping:
            if st in (FighterState.VICTORY_POSE, FighterState.VICTORY_ELEGANT, FighterState.DEFEAT_COLLAPSE):
                self.frame_idx = len(self.current_frames()) - 1
            else:
                self.frame_idx = 0
        elif st == FighterState.CROUCH_ENTER:
            self.set_state(FighterState.CROUCH)
        elif st == FighterState.JUMP_SQUAT:
            self.set_state(FighterState.JUMP_RISE)
            self.vy = JUMP_VEL_Y
            self.y = GROUND_Y - 2.0
            audio.play_sfx(SFXId.JUMP_SPLASH, self._pan())
            stage.spawn_water_splash(self.x, 1.0)
        elif st == FighterState.JUMP_RISE:
            self.set_state(FighterState.JUMP_APEX)
        elif st == FighterState.JUMP_APEX:
            self.set_state(FighterState.JUMP_FALL)
        elif st in (FighterState.AIR_DASH_FWD, FighterState.AIR_DASH_BACK):
            self.set_state(FighterState.JUMP_FALL)
        elif st == FighterState.KNOCKDOWN:
            if self.hp <= 0:
                self.set_state(FighterState.DEFEAT_COLLAPSE)
            else:
                self.set_state(FighterState.WAKEUP_NEUTRAL)
                self.invuln_frames = 14
                self.combo_hits_taken = 0
                self.combo_dmg_taken = 0
                self.combo_proration = 1.0
                self.juggle_count = 0
        elif st == FighterState.INTRO_STANCE:
            self.set_state(FighterState.INTRO_DRAW)
        elif st == FighterState.SUPER_REQUIEM_START:
            self.set_state(FighterState.SUPER_REQUIEM_RUSH)
        elif st == FighterState.SUPER_REQUIEM_RUSH:
            self.set_state(FighterState.SUPER_REQUIEM_END)
        elif st == FighterState.ASTRAL_START:
            self.set_state(FighterState.ASTRAL_CATACLYSM)
            stage.trigger_lightning(1.0)
        elif st == FighterState.ASTRAL_CATACLYSM:
            self.set_state(FighterState.ASTRAL_BISECT)
            stage.trigger_lightning(1.0)
        elif self.is_airborne():
            self.set_state(FighterState.JUMP_FALL)
        else:
            self.set_state(FighterState.IDLE)


