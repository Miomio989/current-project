            # Delicate arched anime eyebrow
            brow_y = open_h + 2.4 * scale
            if expr in (ExpressionId.BATTLE_GRIT, ExpressionId.FIERCE_SHOUT, ExpressionId.COLD_FOCUS):
                ba = (ec - fwd * ew + up * (brow_y + 1.3 * scale)).to_int_tuple()
                bb = (ec + fwd * ew + up * (brow_y - 1.3 * scale)).to_int_tuple()
            elif expr in (ExpressionId.PAIN_WINCE, ExpressionId.SHOCK):
