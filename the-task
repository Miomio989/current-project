                crack = rng.uniform(-1.0, 1.0) * math.exp(-t * 32.0) * crunch
                steel = (math.sin(t * 1420.0 * math.tau) + math.sin(t * 2380.0 * math.tau)) * math.exp(-t * 22.0) * metallic
