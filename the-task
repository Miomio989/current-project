class Vec3:
    x: float
    y: float
    z: float

    def __add__(self, other: "Vec3") -> "Vec3":
        return Vec3(self.x + other.x, self.y + other.y, self.z + other.z)

    def __sub__(self, other: "Vec3") -> "Vec3":
        return Vec3(self.x - other.x, self.y - other.y, self.z - other.z)

    def __mul__(self, s: float) -> "Vec3":
        return Vec3(self.x * s, self.y * s, self.z * s)

    def __rmul__(self, s: float) -> "Vec3":
        return Vec3(self.x * s, self.y * s, self.z * s)

    def length(self) -> float:
        return math.sqrt(self.x * self.x + self.y * self.y + self.z * self.z)

    def normalized(self) -> "Vec3":
        l = self.length()
        if l < 1e-8:
            return Vec3(0.0, 0.0, 1.0)
        return Vec3(self.x / l, self.y / l, self.z / l)

    def dot(self, other: "Vec3") -> float:
        return self.x * other.x + self.y * other.y + self.z * other.z

    def cross(self, other: "Vec3") -> "Vec3":
        return Vec3(
            self.y * other.z - self.z * other.y,
            self.z * other.x - self.x * other.z,
            self.x * other.y - self.y * other.x,
        )

    def rotate_y_deg(self, deg: float) -> "Vec3":
        r = math.radians(deg)
        c = math.cos(r)
        s = math.sin(r)
        return Vec3(self.x * c + self.z * s, self.y, -self.x * s + self.z * c)

    def rotate_x_deg(self, deg: float) -> "Vec3":
        r = math.radians(deg)
        c = math.cos(r)
        s = math.sin(r)
        return Vec3(self.x, self.y * c - self.z * s, self.y * s + self.z * c)

    def rotate_z_deg(self, deg: float) -> "Vec3":
        r = math.radians(deg)
        c = math.cos(r)
        s = math.sin(r)
        return Vec3(self.x * c - self.y * s, self.x * s + self.y * c, self.z)

    def lerp_to(self, other: "Vec3", t: float) -> "Vec3":
        return Vec3(
            lerp(self.x, other.x, t),
            lerp(self.y, other.y, t),
            lerp(self.z, other.z, t),
        )

    def project(
        self,
        origin_x: float,
        origin_y: float,
        focal: float = 540.0,
        scale: float = 1.0,
    ) -> Tuple[Vec2, float]:
        """Weak-perspective 3D projection giving true anime foreshortening."""
        denom = max(120.0, focal - self.z)
        persp = (focal / denom) * scale
        px = origin_x + self.x * persp
        py = origin_y + self.y * persp
        return Vec2(px, py), persp


def eval_quad_bezier(p0: Vec2, p1: Vec2, p2: Vec2, t: float) -> Vec2:
    u = 1.0 - t
    uu = u * u
    tt = t * t
    return Vec2(
        uu * p0.x + 2.0 * u * t * p1.x + tt * p2.x,
        uu * p0.y + 2.0 * u * t * p1.y + tt * p2.y,
    )


def eval_cubic_bezier(
    p0: Vec2, p1: Vec2, p2: Vec2, p3: Vec2, t: float
) -> Vec2:
    u = 1.0 - t
    uu = u * u
    uuu = uu * u
    tt = t * t
    ttt = tt * t
    return Vec2(
        uuu * p0.x + 3.0 * uu * t * p1.x + 3.0 * u * tt * p2.x + ttt * p3.x,
        uuu * p0.y + 3.0 * uu * t * p1.y + 3.0 * u * tt * p2.y + ttt * p3.y,
    )


def sample_quad_bezier(
    p0: Vec2, p1: Vec2, p2: Vec2, steps: int = 12
) -> List[Vec2]:
    if steps < 2:
        return [p0, p2]
    return [eval_quad_bezier(p0, p1, p2, i / float(steps)) for i in range(steps + 1)]


def sample_cubic_bezier(
    p0: Vec2, p1: Vec2, p2: Vec2, p3: Vec2, steps: int = 16
) -> List[Vec2]:
    if steps < 2:
        return [p0, p3]
    return [
        eval_cubic_bezier(p0, p1, p2, p3, i / float(steps))
        for i in range(steps + 1)
    ]


def sample_catmull_rom(pts: Sequence[Vec2], steps_per_seg: int = 6) -> List[Vec2]:
    n = len(pts)
    if n < 2:
        return list(pts)
    if n == 2:
        return [pts[0].lerp_to(pts[1], i / float(steps_per_seg)) for i in range(steps_per_seg + 1)]
    out: List[Vec2] = []
    for i in range(n - 1):
        p0 = pts[max(0, i - 1)]
        p1 = pts[i]
        p2 = pts[i + 1]
        p3 = pts[min(n - 1, i + 2)]
        for s in range(steps_per_seg):
            t = s / float(steps_per_seg)
            t2 = t * t
            t3 = t2 * t
            x = 0.5 * (
                (2.0 * p1.x)
                + (-p0.x + p2.x) * t
                + (2.0 * p0.x - 5.0 * p1.x + 4.0 * p2.x - p3.x) * t2
                + (-p0.x + 3.0 * p1.x - 3.0 * p2.x + p3.x) * t3
            )
            y = 0.5 * (
                (2.0 * p1.y)
                + (-p0.y + p2.y) * t
                + (2.0 * p0.y - 5.0 * p1.y + 4.0 * p2.y - p3.y) * t2
                + (-p0.y + 3.0 * p1.y - 3.0 * p2.y + p3.y) * t3
            )
            out.append(Vec2(x, y))
    out.append(pts[-1])
    return out


def build_tapered_ribbon(
    spine: Sequence[Vec2],
    widths: Sequence[float],
    bias: float = 0.0,
) -> List[Tuple[float, float]]:
    """Construct a closed polygon ribbon along a spine with per-point half-widths.

    Used for calligraphic brush strokes, anime hair locks, tapered limbs,
    flowing skirt trims, and perspective sword slash smears.
    """
    n = len(spine)
    if n < 2:
        return []
    left_pts: List[Tuple[float, float]] = []
    right_pts: List[Tuple[float, float]] = []
    for i in range(n):
        if i == 0:
            tangent = spine[1] - spine[0]
        elif i == n - 1:
            tangent = spine[-1] - spine[-2]
        else:
            tangent = spine[i + 1] - spine[i - 1]
        t_norm = tangent.normalized()
        if t_norm.length_sq() < 1e-8:
            t_norm = Vec2(1.0, 0.0)
        normal = t_norm.perp()
        w = widths[min(i, len(widths) - 1)]
        wl = w * (1.0 + bias)
        wr = w * (1.0 - bias)
        p = spine[i]
        left_pts.append((p.x + normal.x * wl, p.y + normal.y * wl))
        right_pts.append((p.x - normal.x * wr, p.y - normal.y * wr))
    right_pts.reverse()
    return left_pts + right_pts


def build_tapered_capsule_poly(
    a: Vec2,
    b: Vec2,
    r_a: float,
    r_b: float,
    bulge_mid: float = 0.0,
    cap_steps: int = 5,
) -> List[Tuple[float, float]]:
    """Generate a smooth anatomically contoured limb segment polygon."""
    diff = b - a
    length = diff.length()
    if length < 1e-4:
        pts: List[Tuple[float, float]] = []
        r = max(r_a, r_b, 1.0)
        for i in range(10):
            ang = (2.0 * math.pi * i) / 10.0
            pts.append((a.x + math.cos(ang) * r, a.y + math.sin(ang) * r))
        return pts
    fwd = Vec2(diff.x / length, diff.y / length)
    nrm = fwd.perp()
    mid = a.lerp_to(b, 0.5)
    r_mid = 0.5 * (r_a + r_b) + bulge_mid
    poly: List[Tuple[float, float]] = []

    # Cap around A
    base_ang_a = math.atan2(nrm.y, nrm.x)
    for i in range(cap_steps + 1):
        ang = base_ang_a + math.pi * (i / float(cap_steps))
        poly.append((a.x + math.cos(ang) * r_a, a.y + math.sin(ang) * r_a))

    # Right contour via anatomical bulge midpoint
    q1 = a.lerp_to(b, 0.30) - nrm * (lerp(r_a, r_mid, 0.65))
    q2 = mid - nrm * r_mid
    q3 = a.lerp_to(b, 0.72) - nrm * (lerp(r_mid, r_b, 0.60))
    poly.extend([(q1.x, q1.y), (q2.x, q2.y), (q3.x, q3.y)])

    # Cap around B
    base_ang_b = math.atan2(-nrm.y, -nrm.x)
    for i in range(cap_steps + 1):
        ang = base_ang_b + math.pi * (i / float(cap_steps))
        poly.append((b.x + math.cos(ang) * r_b, b.y + math.sin(ang) * r_b))

    # Left contour back to A
    l3 = a.lerp_to(b, 0.72) + nrm * (lerp(r_mid, r_b, 0.60))
    l2 = mid + nrm * r_mid
    l1 = a.lerp_to(b, 0.30) + nrm * (lerp(r_a, r_mid, 0.65))
    poly.extend([(l3.x, l3.y), (l2.x, l2.y), (l1.x, l1.y)])
    return poly


def rect_intersects(
    a: Tuple[float, float, float, float], b: Tuple[float, float, float, float]
) -> bool:
    ax, ay, aw, ah = a
    bx, by, bw, bh = b
    return (ax < bx + bw) and (ax + aw > bx) and (ay < by + bh) and (ay + ah > by)


def rect_overlap_center(
    a: Tuple[float, float, float, float], b: Tuple[float, float, float, float]
) -> Tuple[float, float]:
    ax, ay, aw, ah = a
    bx, by, bw, bh = b
    lx = max(ax, bx)
    rx = min(ax + aw, bx + bw)
    ty = max(ay, by)
    by2 = min(ay + ah, by + bh)
    return ((lx + rx) * 0.5, (ty + by2) * 0.5)


def deterministic_hash(x: int, y: int, seed: int = 1337) -> float:
    """Fast deterministic value noise in [0.0, 1.0] for procedural textures."""
    n = (x * 374761393 + y * 668265263 + seed * 1442695041) & 0xFFFFFFFF
    n = ((n ^ (n >> 13)) * 1274126177) & 0xFFFFFFFF
    n = n ^ (n >> 16)
    return (n & 0xFFFFFF) / float(0x1000000)


def value_noise_2d(x: float, y: float, seed: int = 1337) -> float:
    xi = int(math.floor(x))
    yi = int(math.floor(y))
    xf = smoothstep(x - xi)
    yf = smoothstep(y - yi)
    v00 = deterministic_hash(xi, yi, seed)
    v10 = deterministic_hash(xi + 1, yi, seed)
    v01 = deterministic_hash(xi, yi + 1, seed)
    v11 = deterministic_hash(xi + 1, yi + 1, seed)
    return lerp(lerp(v00, v10, xf), lerp(v01, v11, xf), yf)


def fbm_noise_2d(
    x: float, y: float, octaves: int = 4, seed: int = 1337
) -> float:
    total = 0.0
    amp = 0.5
    freq = 1.0
    norm = 0.0
    for o in range(octaves):
        total += value_noise_2d(x * freq, y * freq, seed + o * 79) * amp
        norm += amp
        amp *= 0.5
        freq *= 2.03
    return total / max(norm, 1e-6)


