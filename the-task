@dataclass(frozen=True)
class BoxRect:
    """Fighter-local box relative to ground anchor (facing right: +X forward, -Y up)."""
    x: float
    y: float
    w: float
    h: float

    def to_world(self, world_x: float, world_y: float, facing_right: bool) -> Tuple[float, float, float, float]:
        if facing_right:
            return (world_x + self.x, world_y + self.y, self.w, self.h)
        return (world_x - self.x - self.w, world_y + self.y, self.w, self.h)


@dataclass(frozen=True)
class HitWindow:
    """Single active strike phase inside a combat move."""
    hit_id: int
    start_frame: int
    end_frame: int
    boxes: Tuple[BoxRect, ...]
    damage: int
    chip_damage: int
    poise_damage: int
    height: AttackHeight
    weight: AttackWeight
    hitstun: int
    blockstun: int
    hitstop: int
    pushback_x: float
    launch_vx: float = 0.0
    launch_vy: float = 0.0
    knockdown: bool = False
    hard_knockdown: bool = False
    curse_gain_hit: int = 45
