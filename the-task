class FontManager:
    """Manages crisp Gothic serif, HUD sans, and monospace frame-data fonts cleanly."""

    def __init__(self) -> None:
        self._cache: Dict[Tuple[str, int, bool, bool], pygame.font.Font] = {}
        self._font_paths: Dict[str, Optional[str]] = {
            "serif": self._find_ttf(("DejaVuSerif-Bold.ttf", "DejaVuSerif.ttf", "LiberationSerif-Bold.ttf", "georgia.ttf")),
            "sans": self._find_ttf(("DejaVuSans-Bold.ttf", "DejaVuSans.ttf", "LiberationSans-Bold.ttf", "segoeui.ttf")),
            "mono": self._find_ttf(("DejaVuSansMono-Bold.ttf", "DejaVuSansMono.ttf", "LiberationMono-Regular.ttf", "consola.ttf")),
        }

    @staticmethod
    def _find_ttf(filenames: Sequence[str]) -> Optional[str]:
        roots = (
            "/usr/share/fonts/truetype/dejavu",
            "/usr/share/fonts/truetype/liberation",
            "/usr/share/fonts/TTF",
            "C:\\Windows\\Fonts",
            "/System/Library/Fonts",
        )
        for root in roots:
            if not os.path.isdir(root):
                continue
            for fn in filenames:
                p = os.path.join(root, fn)
                if os.path.isfile(p):
                    return p
        return None

    def get(
        self,
        style: str = "serif",
        size: int = 18,
        bold: bool = False,
        italic: bool = False,
    ) -> pygame.font.Font:
        key = (style, size, bold, italic)
        f = self._cache.get(key)
        if f is not None:
            return f
        path = self._font_paths.get(style)
        if path is not None:
            font = pygame.font.Font(path, size)
            font.set_bold(bold)
            font.set_italic(italic)
        else:
            font = pygame.font.Font(None, int(size * 1.15))
            font.set_bold(bold)
            font.set_italic(italic)
        self._cache[key] = font
        return font

    def draw_text(
        self,
        dest: pygame.Surface,
        text: str,
        x: int,
        y: int,
        size: int = 18,
        color: RGB = (244, 236, 242),
        style: str = "serif",
        bold: bool = False,
        italic: bool = False,
        align: str = "left",
        shadow: bool = True,
        outline_color: Optional[RGB] = (18, 6, 16),
    ) -> pygame.Rect:
        font = self.get(style, size, bold, italic)
        surf = font.render(text, True, color)
        rect = surf.get_rect()
        if align == "center":
            rect.midtop = (x, y)
        elif align == "right":
            rect.topright = (x, y)
        else:
            rect.topleft = (x, y)
        if outline_color is not None:
            out_s = font.render(text, True, outline_color)
            for ox, oy in ((-1, 0), (1, 0), (0, -1), (0, 1)):
                dest.blit(out_s, (rect.x + ox, rect.y + oy))
        if shadow:
            sh = font.render(text, True, (12, 4, 12))
            dest.blit(sh, (rect.x + 2, rect.y + 2))
        dest.blit(surf, rect.topleft)
        return rect


def draw_metallic_gauge_bar(
    dest: pygame.Surface,
    rect: pygame.Rect,
    ratio: float,
    ghost_ratio: float,
    color_hi: RGB,
    color_lo: RGB,
    flip_right: bool = False,
    skew: int = 10,
    segments: int = 0,
    border_color: RGB = (224, 214, 232),
) -> None:
    ratio = clamp(ratio, 0.0, 1.0)
    ghost_ratio = clamp(max(ratio, ghost_ratio), 0.0, 1.0)
    x, y, w, h = rect.x, rect.y, rect.w, rect.h
    sk = skew if not flip_right else -skew

    def make_quad(u0: float, u1: float) -> List[Tuple[int, int]]:
        if flip_right:
            x_a = x + int(w * (1.0 - u1))
            x_b = x + int(w * (1.0 - u0))
        else:
            x_a = x + int(w * u0)
            x_b = x + int(w * u1)
        return [(x_a + sk, y), (x_b + sk, y), (x_b, y + h), (x_a, y + h)]

    bg_quad = make_quad(0.0, 1.0)
    pygame.draw.polygon(dest, (22, 10, 24), bg_quad)

    if ghost_ratio > ratio + 0.002:
        pygame.draw.polygon(dest, (252, 224, 134), make_quad(0.0, ghost_ratio))

    if ratio > 0.002:
        pygame.draw.polygon(dest, color_lo, make_quad(0.0, ratio))
        top_h = max(2, int(h * 0.48))
        if flip_right:
            xa = x + int(w * (1.0 - ratio))
            xb = x + w
        else:
            xa = x
            xb = x + int(w * ratio)
        sk_mid = int(sk * (1.0 - top_h / float(max(1, h))))
        hi_quad = [(xa + sk, y + 1), (xb + sk, y + 1), (xb + sk_mid, y + top_h), (xa + sk_mid, y + top_h)]
        pygame.draw.polygon(dest, color_hi, hi_quad)
        pygame.draw.line(dest, (255, 240, 248), (xa + sk + 2, y + 2), (xb + sk - 2, y + 2), 1)

    if segments > 1:
        for si in range(1, segments):
            u = si / float(segments)
            sx = x + int(w * u)
            pygame.draw.line(dest, (20, 8, 22), (sx + sk, y), (sx, y + h), 2)
            pygame.draw.line(dest, (216, 204, 228), (sx + sk + 1, y + 1), (sx + 1, y + h - 1), 1)

    pygame.draw.polygon(dest, (16, 6, 18), bg_quad, 3)
    pygame.draw.polygon(dest, border_color, bg_quad, 1)


