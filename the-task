    def _synth_whoosh(self, dur: float, f_start: float, f_end: float, ghostly: bool) -> List[float]:
        n = int(dur * AUDIO_SR)
        out = [0.0] * n
        rng = random.Random(303 if ghostly else 107)
        lp = 0.0
        for i in range(n):
            t = i / float(AUDIO_SR)
            r = i / float(max(1, n - 1))
            env = math.sin(r * math.pi)
            freq = lerp(f_start, f_end, r)
            wn = rng.uniform(-1.0, 1.0)
            alpha = clamp(freq / (AUDIO_SR * 0.45), 0.02, 0.9)
            lp += alpha * (wn - lp)
            choir = (math.sin(math.tau * freq * 0.5 * t) * 0.35 + math.sin(math.tau * freq * 0.75 * t) * 0.25) if ghostly else 0.0
            out[i] = math.tanh((lp * 1.4 + choir) * env * 1.3) * 0.65
        return out

    def _synth_hit(self, dur: float, power: float) -> List[float]:
        """Layered wet thud + crystalline shatter crack + sub-bass boom (GDD 9.2)."""
        n = int(dur * AUDIO_SR)
        out = [0.0] * n
        rng = random.Random(int(power * 1000))
        phase = 0.0
        for i in range(n):
            t = i / float(AUDIO_SR)
            sub_f = 135.0 * math.exp(-t * 16.0) + 38.0
            phase += math.tau * sub_f / AUDIO_SR
            sub = math.sin(phase) * math.exp(-t * 8.5) * 0.75
            crack = rng.uniform(-1.0, 1.0) * math.exp(-t * 42.0) * 0.65
            glass = math.sin(t * 5800.0 + math.sin(t * 1400.0) * 3.0) * math.exp(-t * 26.0) * 0.35
            out[i] = math.tanh((sub + crack + glass) * power) * 0.85
        return out

    def start_music(self) -> None:
        if not self.enabled or self.music_running:
            return
        self.music_running = True
        for idx, name in enumerate(("prelude", "rupture", "frenzy")):
            ch = pygame.mixer.Channel(idx)
            snd = self.stems.get(name)
            if snd is not None:
                ch.play(snd, loops=-1)
                ch.set_volume(self.music_vol if name == "prelude" else 0.0)
            self.channels[name] = ch

    def set_tempo_phase(self, phase: str) -> None:
        self.current_phase = phase
        self._apply_mix()

    def trigger_hush(self) -> None:
        self.hush_timer = 0.52
        self._apply_mix()
        self.play_sfx("severance", 0.95)
        if self.enabled and self.stems.get("hush_drone"):
            self.stems["hush_drone"].set_volume(0.0 if self.muted else self.music_vol * 0.9)
            self.stems["hush_drone"].play()

