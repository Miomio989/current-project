class BaroqueHUDRenderer:
    """
    Ornate antique-gold & crimson baroque fighting-game HUD modeled directly on
    graphics-mockup.jpg, Soulcalibur, Devil May Cry 4, and Bayonetta:
      - Gilded scrollwork HP frames with beveled crimson / amethyst health fills
        and animated delayed damage-drain bar
      - Tucked HD anime portrait medallions reacting live to battle expressions
      - Central gilded baroque heraldic "ROUND 1 / 99" medallion
      - Radiant CURSE GAUGE underneath each life bar + Guard Integrity bar
      - Bottom-left SOUL BURST segmented amber-gold energy cells
      - Bottom-center glowing baroque "COUNTER X HIT ! YYYY DAMAGE" banner +
        Devil May Cry Stylish Rank Emblem (D -> SSS)
      - Bottom-right gilded READY / EX READY badges & Curse Finale gauge
    """

    def __init__(self, cg: StudioCGRasterizer, fonts: FontManager, portrait_art: CeciliaPortraitArtist) -> None:
        self.cg = cg
        self.fonts = fonts
        self.portrait_art = portrait_art
        self.mini_logo = render_japanese_calligraphy_logo(cg, width=108, height=28)
        self._hp_grad_cache: Dict[int, pygame.Surface] = {}
        self._curse_grad = cg.make_linear_gradient(196, 11, [(134, 24, 196), (238, 38, 108), (255, 168, 192)], vertical=False)

    def render_battle_hud(
        self,
        surf: pygame.Surface,
        p1: Any,
        p2: Any,
        round_num: int,
        timer_sec: int,
        rounds_to_win: int,
        p1_name: str,
        p2_name: str,
        fps: float,
        combo_banner_timer: float = 0.0,
        combo_banner_hits: int = 0,
        combo_banner_dmg: int = 0,
        combo_banner_counter: bool = False,
        announcement_text: str = "",
        announcement_sub: str = "",
        announcement_alpha: int = 0,
        training_mode: bool = False,
    ) -> None:
        gold_hi = (254, 232, 152)
        gold_mid = (204, 152, 58)
        gold_sh = (88, 52, 16)

        # ------------------------------------------------------------------
        # 1. TOP-LEFT (P1) & TOP-RIGHT (P2) GILDED HEALTH BARS & PORTRAITS
        # ------------------------------------------------------------------
        bar_w = 278
        bar_h = 20
        bar_y = 32
        p1_x = 76
        p2_x = RENDER_W - 76 - bar_w

        for side, fighter, bx, name in ((0, p1, p1_x, p1_name), (1, p2, p2_x, p2_name)):
            pal = CECILIA_PALETTES[fighter.palette_idx % len(CECILIA_PALETTES)]
            hp_ratio = clamp(fighter.hp / float(MAX_HEALTH), 0.0, 1.0)
            trail_ratio = clamp(fighter.hp_trail / float(MAX_HEALTH), hp_ratio, 1.0)

            # Dark crimson-obsidian ornate backing behind health bar
            bg_rect = pygame.Rect(bx - 3, bar_y - 3, bar_w + 6, bar_h + 6)
            pygame.draw.rect(surf, (18, 6, 12), bg_rect)

            # Delayed damage-drain white/gold trail
            tr_w = int(bar_w * trail_ratio)
            if tr_w > 0:
                tx = (bx + bar_w - tr_w) if side == 0 else bx
                pygame.draw.rect(surf, (242, 198, 96), (tx, bar_y, tr_w, bar_h))

            # Active beveled health gradient fill (drains toward center medallion!)
            cur_w = int(bar_w * hp_ratio)
            if cur_w > 0:
                hx = (bx + bar_w - cur_w) if side == 0 else bx
                c_hi = pal.hud_bar_hi
                c_lo = pal.hud_bar_lo
                if hp_ratio < 0.25:
                    # Pulsing blood-alert glow at low HP!
                    pulse = 0.5 + 0.5 * math.sin(pygame.time.get_ticks() * 0.015)
                    c_hi = lerp_rgb(c_hi, (255, 224, 152), pulse * 0.45)
                p_key = fighter.palette_idx % len(CECILIA_PALETTES)
                full_grad = self._hp_grad_cache.get(p_key)
                if full_grad is None:
                    full_grad = self.cg.make_linear_gradient(bar_w, bar_h, [add_rgb(pal.hud_bar_hi, (48, 34, 34)), pal.hud_bar_hi, pal.hud_bar_lo], vertical=True)
                    self._hp_grad_cache[p_key] = full_grad
                surf.blit(full_grad, (hx, bar_y), area=pygame.Rect(0, 0, cur_w, bar_h))
                # Top glossy bevel highlight streak
                pygame.draw.line(surf, (255, 232, 220), (hx, bar_y + 2), (hx + cur_w - 1, bar_y + 2), 1)

            # Ornate baroque gilded frame around HP bar
            pygame.draw.rect(surf, gold_sh, (bx - 4, bar_y - 4, bar_w + 8, bar_h + 8), 2)
            pygame.draw.rect(surf, gold_mid, (bx - 2, bar_y - 2, bar_w + 4, bar_h + 4), 2)
            pygame.draw.rect(surf, gold_hi, (bx - 1, bar_y - 1, bar_w + 2, bar_h + 2), 1)

            # Nameplate + HP Percentage readout (graphics-mockup.jpg!)
            pct_str = f"{hp_ratio * 100.0:.1f}%"
            if side == 0:
                self.fonts.draw_text(surf, f"P1  {name}", (bx + 4, bar_y - 21), size=15, color=(255, 236, 196), serif=True, bold=True)
                self.fonts.draw_text(surf, pct_str, (bx + 4, bar_y + bar_h + 6), size=12, color=(248, 218, 178), serif=False, bold=True)
            else:
                self.fonts.draw_text(surf, f"{name}  P2", (bx + bar_w - 4, bar_y - 21), size=15, color=(255, 224, 232), serif=True, bold=True, align="right")
                self.fonts.draw_text(surf, pct_str, (bx + bar_w - 4, bar_y + bar_h + 6), size=12, color=(248, 218, 178), serif=False, bold=True, align="right")

            # Round Win Ruby Gems
            for ri in range(rounds_to_win):
                gx = (bx + bar_w - 12 - ri * 18) if side == 0 else (bx + 12 + ri * 18)
                gy = bar_y - 11
                won = ri < fighter.rounds_won
                pts = [(gx, gy - 6), (gx + 6, gy), (gx, gy + 6), (gx - 6, gy)]
                pygame.draw.polygon(surf, (252, 46, 72) if won else (34, 16, 24), pts)
                pygame.draw.aalines(surf, gold_hi if won else gold_mid, True, pts)
                if won:
                    self.cg.blit_glow(surf, (gx, gy), 11, (255, 62, 86), 135, additive=True)

            # CURSE GAUGE directly beneath HP bar (matching graphics-mockup.jpg!)
            cg_w = 196
            cg_h = 11
            cg_y = bar_y + bar_h + 23
            cg_x = bx if side == 0 else (bx + bar_w - cg_w)
            pygame.draw.rect(surf, (16, 6, 18), (cg_x - 2, cg_y - 2, cg_w + 4, cg_h + 4))
            curse_r = clamp(fighter.curse_gauge / MAX_CURSE_GAUGE, 0.0, 1.0)
            cw = int(cg_w * curse_r)
            if cw > 0:
                cx_fill = cg_x if side == 0 else (cg_x + cg_w - cw)
                surf.blit(self._curse_grad, (cx_fill, cg_y), area=pygame.Rect(0, 0, cw, cg_h))
            pygame.draw.rect(surf, gold_mid, (cg_x - 2, cg_y - 2, cg_w + 4, cg_h + 4), 1)
            # Ornate gilded diamond end-finials on Curse Gauge (graphics-mockup.jpg!)
            for fx_e in (cg_x - 3, cg_x + cg_w + 3):
                pygame.draw.polygon(surf, gold_mid, [(fx_e, cg_y - 3), (fx_e + 5, cg_y + cg_h // 2), (fx_e, cg_y + cg_h + 3), (fx_e - 5, cg_y + cg_h // 2)])
            cg_lbl = f"CURSE GAUGE  {int(fighter.curse_gauge)}%"
            self.fonts.draw_text(
                surf, cg_lbl,
                (cg_x + 2 if side == 0 else cg_x + cg_w - 2, cg_y + cg_h + 4),
                size=10, color=(248, 212, 224), serif=False, bold=True,
                align="left" if side == 0 else "right",
            )

            # Guard Integrity thin steel-blue crystal strip beside Curse Gauge
            gd_w = 72
            gd_x = (cg_x + cg_w + 10) if side == 0 else (bx)
            gd_r = clamp(fighter.guard_gauge / MAX_GUARD_GAUGE, 0.0, 1.0)
            pygame.draw.rect(surf, (16, 12, 22), (gd_x, cg_y + 2, gd_w, 7))
            g_col = (104, 208, 255) if gd_r > 0.35 else (255, 92, 62)
            pygame.draw.rect(surf, g_col, (gd_x, cg_y + 2, int(gd_w * gd_r), 7))
            pygame.draw.rect(surf, gold_sh, (gd_x, cg_y + 2, gd_w, 7), 1)

            # Tucked HD Anime Bust Portrait Medallion at Top Corner!
            p_sz = 64
            px = 6 if side == 0 else (RENDER_W - 6 - p_sz)
            py = 10
            expr = fighter.get_hud_expression()
            port_s = self.portrait_art.render_portrait(pal, fighter.palette_idx, size=p_sz, facing_right=(side == 0), expr=expr, with_bg=True)
            surf.blit(port_s, (px, py))
            draw_baroque_filigree_rect(surf, pygame.Rect(px, py, p_sz, p_sz), fill_top=(0, 0, 0, 0), fill_bot=(0, 0, 0, 0))

        # ------------------------------------------------------------------
        # 2. TOP-CENTER BAROQUE HERALDIC ROUND & TIMER MEDALLION
        # ------------------------------------------------------------------
        mcx, mcy = RENDER_W // 2, 42
        crest = [
            (mcx, mcy - 36), (mcx + 42, mcy - 22), (mcx + 46, mcy + 8),
            (mcx + 26, mcy + 34), (mcx, mcy + 46),
            (mcx - 26, mcy + 34), (mcx - 46, mcy + 8), (mcx - 42, mcy - 22),
        ]
        self.cg.fill_shaded_poly(
            surf, crest,
            [(14, 4, 10), (46, 8, 18), (22, 6, 14)],
            light_dir=(0.0, -1.0), ink_color=gold_mid, ink_width=3.0,
        )
        pygame.draw.aalines(surf, gold_hi, True, crest)
        # Gilded baroque wing flourishes bridging medallion to HP bars
        for sgn in (-1, 1):
            wing_pts = [(mcx + sgn * 42, mcy - 16), (mcx + sgn * 56, mcy - 22), (mcx + sgn * 48, mcy - 6), (mcx + sgn * 54, mcy + 8), (mcx + sgn * 38, mcy + 16)]
            pygame.draw.lines(surf, gold_mid, False, wing_pts, 3)
            pygame.draw.aalines(surf, gold_hi, False, wing_pts)
        self.fonts.draw_text(surf, f"ROUND {round_num}", (mcx, mcy - 28), size=11, color=gold_hi, serif=True, bold=True, align="center")
