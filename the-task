class CameraDirector:
    """Spring-damped fighting game camera with zoom, shake & Super darkening."""

    def __init__(self) -> None:
        self.x: float = WORLD_W * 0.5
        self.y: float = 0.0
        self.shake_mag: float = 0.0
        self.shake_ox: float = 0.0
        self.shake_oy: float = 0.0
        self.flash_alpha: float = 0.0
        self.flash_color: RGB = (255, 224, 240)
        self.eclipse_dim: float = 0.0

    def add_shake(self, mag: float) -> None:
        self.shake_mag = min(22.0, max(self.shake_mag, mag))

    def trigger_flash(self, color: RGB, alpha: float = 0.65) -> None:
        self.flash_color = color
        self.flash_alpha = max(self.flash_alpha, alpha)

    def update(self, f1: Fighter, f2: Fighter, dt: float, shake_scale: float = 1.0) -> None:
        mid_x = (f1.x + f2.x) * 0.5
        target_x = clamp(mid_x, INTERNAL_W * 0.5, WORLD_W - INTERNAL_W * 0.5)
        self.x += (target_x - self.x) * min(1.0, dt * 11.0)

        highest_y = min(f1.y, f2.y)
        target_y = clamp((highest_y - GROUND_Y) * 0.34, -84.0, 0.0)
        self.y += (target_y - self.y) * min(1.0, dt * 9.5)

        if self.shake_mag > 0.15:
            self.shake_ox = random.uniform(-self.shake_mag, self.shake_mag) * shake_scale
            self.shake_oy = random.uniform(-self.shake_mag, self.shake_mag) * shake_scale
            self.shake_mag *= 0.82
        else:
            self.shake_mag = 0.0
            self.shake_ox = 0.0
            self.shake_oy = 0.0

        if self.flash_alpha > 0.0:
            self.flash_alpha = max(0.0, self.flash_alpha - dt * 3.6)

        target_dim = 0.42 if (f1.eclipse_timer > 0.0 or f2.eclipse_timer > 0.0) else 0.0
        self.eclipse_dim += (target_dim - self.eclipse_dim) * min(1.0, dt * 6.0)


class VFXDirector:
    """Manages all particles, blood sprays, slash sparks, projectiles & Super Cut-Ins."""

    def __init__(self, rast: PainterlyCGRasterizer, bank: SpriteBank) -> None:
        self.rast = rast
        self.bank = bank
        self.cam = CameraDirector()
        self.particles: List[VFXParticle] = []
        self.rings: List[ShockwaveRing] = []
        self.afterimages: List[AfterimageGhost] = []
        self.callouts: List[TacticalCallout] = []
        self.projectiles: List[BloodMoonProjectile] = []
        self.pillars: List[CataclysmPillar] = []
        self.super_freeze: int = 0
        self.super_banner: Optional[pygame.Surface] = None
        self.super_banner_timer: int = 0

    def clear(self) -> None:
        self.particles.clear()
        self.rings.clear()
        self.afterimages.clear()
        self.callouts.clear()
        self.projectiles.clear()
        self.pillars.clear()
        self.super_freeze = 0
        self.super_banner = None
        self.super_banner_timer = 0

    def trigger_super_cutin(self, fighter: Fighter, name: str, frames: int) -> None:
        self.super_freeze = frames
        self.super_banner = self.bank.get_super_cutin(fighter.pal_idx, name, fighter.facing_right)
