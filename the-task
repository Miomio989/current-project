    def _rehighlight(self, highlighter: Optional[SpanHighlighter], busy_flag: str) -> None:
        if highlighter is None or getattr(self, busy_flag, False):
            return
        setattr(self, busy_flag, True)
        try:
            highlighter.rehighlight()
        finally:
            setattr(self, busy_flag, False)

