                ty = base_y - bar_h + u * math.sin(tilt) * 18
                pygame.draw.line(s, iron_dark, (bx, base_y), (tx, ty), 4)
                pygame.draw.line(s, iron_rim, (bx + 1, base_y), (tx + 1, ty), 1)
                # Gothic fleur-de-lis spearhead finial
