    def closeEvent(self, ev) -> None:  # noqa: N802
        c = self.queue.counts()
        pending = c["active"] + c["queued"] + c["upscales"]
        if pending:
            ans = QMessageBox.question(self, "Quit", f"{pending} request(s) are still pending.\nCancel them and quit?",
                                       QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
            if ans != QMessageBox.StandardButton.Yes:
                ev.ignore()
                return
        for w in list(self._aesthetic_workers):
            w.cancel()
        # stop the local servers and wake any SillyTavern request still waiting
        self._server_status_timer.stop()
        self._bridge_stop()
        self._st_stop()
        for ev in list(self._st_waiters.values()):
            ev.set()
        self._st_waiters.clear()
        # give background workers and an in-flight merge a moment to unwind
        deadline = time.time() + 3.0
        while time.time() < deadline:
            running = any(w.isRunning() for w in self._aesthetic_workers) or any(
                t.isRunning() for t in self._tasks)
            if not running:
                break
            QApplication.processEvents()
            time.sleep(0.1)
        self.queue.shutdown()
        self._save_timer.stop()
        self._ups_refresh_timer.stop()
        self._llm_save_timer.stop()
        self._slide_timer.stop()
        self.gallery_tab.shutdown()
        self._loading = False
        self.save_now()
        self.save_llm_now()
        super().closeEvent(ev)


