def dx_dy_to_numpad(dx: int, dy: int, facing_right: bool) -> int:
    fx = dx if facing_right else -dx
    if dy > 0:
        return 1 if fx < 0 else (3 if fx > 0 else 2)
    if dy < 0:
        return 7 if fx < 0 else (9 if fx > 0 else 8)
    return 4 if fx < 0 else (6 if fx > 0 else 5)


class InputBuffer:
    """24-frame arcade circular input buffer with authentic fighting-game motion leniency."""

    def __init__(self, max_len: int = 24) -> None:
        self.frames: Deque[Tuple[int, InputFrame]] = collections.deque(maxlen=max_len)
        self.tape: Deque[Tuple[int, InputButton, int]] = collections.deque(maxlen=16)  # (numpad, pressed, hold_count)
        self._prev_held: InputButton = InputButton.NONE

    def clear(self) -> None:
        self.frames.clear()
        self.tape.clear()
        self._prev_held = InputButton.NONE

    def push(self, dx: int, dy: int, held: InputButton, facing_right: bool) -> InputFrame:
        pressed = held & ~self._prev_held
        released = self._prev_held & ~held
        self._prev_held = held
        fr = InputFrame(dx=dx, dy=dy, held=held, pressed=pressed, released=released)
        num = dx_dy_to_numpad(dx, dy, facing_right)
        self.frames.append((num, fr))

        # Update Training Lab scrolling arcade input history tape
        if self.tape and self.tape[-1][0] == num and pressed == InputButton.NONE and self.tape[-1][1] == InputButton.NONE:
            old_n, old_b, cnt = self.tape[-1]
            self.tape[-1] = (old_n, old_b, min(99, cnt + 1))
        else:
            self.tape.append((num, pressed, 1))
        return fr

    def latest(self) -> Tuple[int, InputFrame]:
        if not self.frames:
            return (5, InputFrame())
        return self.frames[-1]

    def button_pressed_recently(self, btn: InputButton, window: int = 5) -> bool:
        recent = list(self.frames)[-window:]
        return any((fr.pressed & btn) != 0 for _, fr in recent)

    def match_motion(self, seq: Sequence[int], window: int = 16) -> bool:
        """Scan buffer chronologically with fighting-game diagonal tolerance."""
        if not self.frames:
            return False
        recent = list(self.frames)[-window:]
        target_idx = 0
        seq_len = len(seq)
        for num, _ in recent:
            if num == seq[target_idx]:
                target_idx += 1
                if target_idx >= seq_len:
                    return True
        return False

    def has_double_tap(self, direction_num: int, window: int = 12) -> bool:
        """Detect crisp arcade double-tap forward (6,5,6) or back (4,5,4) dash."""
        recent = [n for n, _ in list(self.frames)[-window:]]
        if len(recent) < 3 or recent[-1] != direction_num:
            return False
        stage = 0
        for n in recent:
            if stage == 0 and n == direction_num:
                stage = 1
            elif stage == 1 and n != direction_num:
                stage = 2
            elif stage == 2 and n == direction_num:
                return True
        return False


class InputManager:
    """Reads P1/P2 keyboards + up to 2 USB/Bluetooth gamepads with SOCD cleaning."""

    def __init__(self) -> None:
        self.p1_bind = default_p1_bindings()
        self.p2_bind = default_p2_bindings()
        self.joysticks: List[pygame.joystick.Joystick] = []
        self.refresh_gamepads()

    def refresh_gamepads(self) -> None:
        self.joysticks.clear()
        try:
            if not pygame.joystick.get_init():
                pygame.joystick.init()
            for idx in range(min(2, pygame.joystick.get_count())):
                js = pygame.joystick.Joystick(idx)
                js.init()
                self.joysticks.append(js)
        except Exception:
            pass

    def poll_player(self, player_idx: int, keys: Sequence[bool], two_player_kb: bool) -> Tuple[int, int, InputButton]:
        kb = self.p1_bind if player_idx == 0 else self.p2_bind
        use_alt = (player_idx == 0 and not two_player_kb)

        def down(k1: int, k2: int = 0) -> bool:
            v1 = bool(keys[k1]) if (0 < k1 < len(keys)) else False
            v2 = bool(keys[k2]) if (use_alt and 0 < k2 < len(keys)) else False
            return v1 or v2

        left = down(kb.left, kb.alt_left)
        right = down(kb.right, kb.alt_right)
        up = down(kb.up, kb.alt_up)
        dn = down(kb.down, kb.alt_down)

        # Arcade SOCD cleaning: Left+Right = Neutral; Up+Down = Up
        dx = (1 if right else 0) - (1 if left else 0)
        dy = -1 if up else (1 if dn else 0)

        btn = InputButton.NONE
        if down(kb.light, kb.alt_light):
            btn |= InputButton.LIGHT
        if down(kb.medium, kb.alt_medium):
            btn |= InputButton.MEDIUM
        if down(kb.heavy, kb.alt_heavy):
            btn |= InputButton.HEAVY
        if down(kb.special, kb.alt_special):
            btn |= InputButton.SPECIAL
        if down(kb.eclipse, 0):
            btn |= InputButton.ECLIPSE
        if down(kb.taunt, 0):
            btn |= InputButton.TAUNT

        # Merge optional USB/Bluetooth gamepad inputs cleanly
        if player_idx < len(self.joysticks):
            js = self.joysticks[player_idx]
            try:
                if js.get_numaxes() >= 2:
                    ax_x = js.get_axis(0)
                    ax_y = js.get_axis(1)
                    if ax_x < -0.45:
                        dx = -1
                    elif ax_x > 0.45:
                        dx = 1
                    if ax_y < -0.45:
                        dy = -1
                    elif ax_y > 0.45:
                        dy = 1
                if js.get_numhats() > 0:
                    hx, hy = js.get_hat(0)
                    if hx != 0:
                        dx = hx
                    if hy != 0:
                        dy = -hy
                nb = js.get_numbuttons()
                if nb > 0 and js.get_button(0):
                    btn |= InputButton.LIGHT
                if nb > 1 and js.get_button(1):
                    btn |= InputButton.MEDIUM
                if nb > 2 and js.get_button(2):
                    btn |= InputButton.HEAVY
                if nb > 3 and js.get_button(3):
                    btn |= InputButton.SPECIAL
                if nb > 4 and js.get_button(4):
                    btn |= InputButton.ECLIPSE
            except Exception:
                pass
        return (dx, dy, btn)


