    def _gen_settings(self) -> Dict[str, Any]:
        spec = MODELS[self.current_model()]
        if self.override_check.isChecked():
            return {
                "sampler": self.sampler_combo.currentText(),
                "scheduler": self.scheduler_combo.currentText(),
                "steps": self.steps_spin.value(),
                "cfg": round(self.cfg_spin.value(), 2),
                "clip_skip": self.clip_spin.value(),
            }
        return {
            "sampler": spec["sampler"],
            "scheduler": spec["scheduler"],
            "steps": spec["steps"],
            "cfg": spec["cfg"],
            "clip_skip": 0,
        }

    def _current_size(self) -> Tuple[int, int, str]:
        if self.custom_size_check.isChecked():
            # v4: custom values are always rounded to the nearest multiple of 64
            return snap64_nearest(self.w_spin.value()), snap64_nearest(self.h_spin.value()), "custom"
        a = self.aspect.current()
        return int(a["w"]), int(a["h"]), str(a["key"])

    def _expand_prompt_wildcards(self, text: str) -> str:
        if not text or not has_wildcard_syntax(text):
            return text
        if self._wc_cache_key == text:
            return self._wc_cache_val
        val = expand_wildcards(text, self.tags_by_folder)
        if not val.strip():
            return text
        self._wc_cache_key, self._wc_cache_val = text, val
        return val

    def _reroll_wildcards(self) -> None:
        self._wc_cache_key = None
        self._wc_cache_val = ""
        self._update_preview()
        self._flash_summary("Wildcards re-rolled")

    def _compose(self) -> Tuple[str, str, str]:
        raw = self.prompt_edit.toPlainText().strip()
        neg = " ".join(self.neg_edit.toPlainText().split())
        feats = model_features(self.current_model())
        tpl = self.active_template if feats["templates"] else None
        final = apply_template(tpl["body"], raw) if tpl else raw
        final = self._expand_prompt_wildcards(" ".join(final.split()))
        # LoRA trigger words of enabled LoRAs are appended to the very end of
        # the final prompt (mirrored by the greyed ghost tail in the editor).
        if feats["loras"]:
            final = self._with_lora_triggers(final)
        return final, raw, neg

    def _compose_line(self, line: str) -> Tuple[str, str]:
        """Compose ONE external single-line prompt through the active pipeline:
        template (when supported & selected) -> wildcards -> LoRA triggers.
        Returns (final, raw) — the negative prompt is handled by build_payload."""
        feats = model_features(self.current_model())
        tpl = self.active_template if feats["templates"] else None
        final = apply_template(tpl["body"], line) if tpl else line
        final = self._expand_prompt_wildcards(" ".join(final.split()))
        if feats["loras"]:
            final = self._with_lora_triggers(final)
        return final, line

    def _update_preview(self) -> None:
        final, raw, neg = self._compose()
        has_wc = has_wildcard_syntax(raw) or bool(self.active_template and has_wildcard_syntax(self.active_template.get("body", "")))
        self.reroll_btn.setVisible(has_wc)
        full = final + (f" ### {neg}" if neg else "")
        if self.preview_edit.toPlainText() != full:
            self.preview_edit.setPlainText(full)

    def _options(self) -> Dict[str, bool]:
        return {k: cb.isChecked() for k, cb in self.opt_checks.items()}

    def build_payload(
        self,
        dry_run: bool = False,
        prompt_override: Optional[str] = None,
        n_override: Optional[int] = None,
        seed_override: Optional[str] = None,
        apply_template: bool = False,
        via: str = "",
    ) -> Tuple[Dict[str, Any], Dict[str, Any]]:
        feats = model_features(self.current_model())
        if prompt_override is not None:
            raw = " ".join(str(prompt_override).split())
            if apply_template:
                # Batch queue: run every line through the active template &
                # wildcards & LoRA triggers exactly like a typed prompt.
                final = self._compose_line(raw)[0]
            else:
                final = raw
                if feats["loras"]:
                    final = self._with_lora_triggers(final)
            neg = " ".join(self.neg_edit.toPlainText().split())
        else:
            final, raw, neg = self._compose()
        if not feats["negative"]:
            neg = ""  # MOSS-Image-SFT: negative channel unused by the publisher
        full = final + (f" ### {neg}" if neg else "")
        model = self.current_model()
        gs = self._gen_settings()
        w, h, akey = self._current_size()
        n_images = int(n_override) if n_override is not None else self.n_spin.value()
        params: Dict[str, Any] = {
            "sampler_name": gs["sampler"],
            "scheduler": gs["scheduler"],
            "steps": int(gs["steps"]),
            "cfg_scale": gs["cfg"],
            "width": w,
            "height": h,
            "n": n_images,
        }
        if gs.get("clip_skip"):
            params["clip_skip"] = int(gs["clip_skip"])
        seed = seed_override if seed_override is not None else self.seed_edit.text().strip()
        if seed:
            params["seed"] = seed
        if self.img2img_source:
            params["denoising_strength"] = round(self.i2i_denoise_spin.value(), 2)
        loras = self._active_horde_loras() if feats["loras"] else []
        payload: Dict[str, Any] = {"prompt": full, "params": params, "models": [model], "r2": True}
        if loras:
            payload["loras"] = loras
        payload.update(self._options())
        if dry_run:
            payload["dry_run"] = True
        if self.img2img_source:
            payload["source_image_path"] = self.img2img_source
            payload["source_processing"] = "inpainting" if self.img2img_mask else "img2img"
            if self.img2img_mask:
                payload["source_mask_path"] = self.img2img_mask
        meta: Dict[str, Any] = {
            "prompt": final,
            "raw_prompt": raw,
            "negative": neg,
            "template": (self.active_template["name"] if (self.active_template and feats["templates"] and (prompt_override is None or apply_template)) else ""),
            "model": model,
            "width": w,
            "height": h,
            "aspect": akey,
            "sampler": gs["sampler"],
            "scheduler": gs["scheduler"],
            "steps": gs["steps"],
            "cfg": gs["cfg"],
            "clip_skip": gs.get("clip_skip", 0),
            "seed_requested": seed,
            "loras": loras,
            "n": n_images,
            "created_at": time.time(),
            "options": self._options(),
        }
        if self.img2img_source:
            meta["img2img"] = True
            meta["img2img_source"] = self.img2img_source
            meta["denoise"] = round(self.i2i_denoise_spin.value(), 2)
            if self.img2img_mask:
                meta["inpaint"] = True
            if self._i2i_edit_mode:
                meta["edit_side_by_side"] = True
        if via:
            meta["via"] = via
        elif prompt_override is not None:
            meta["via"] = "sillytavern"
        return payload, meta

    def _record_history(self, raw: str, neg: str) -> None:
        self.history = push_history_entry(
            self.history, self.current_model(), raw, neg, self.seed_edit.text().strip()
        )
        save_history(self.history)

    def on_generate(self) -> None:
        final, raw, neg = self._compose()
        if not final.strip():
            self.tabs.setCurrentIndex(TAB_PROMPT)
            self.prompt_edit.setFocus()
            self._flash_summary("Type a prompt first.")
            return
        w, h, _k = self._current_size()
        if w * h > MEGAPIXEL_BUDGET:
            self.tabs.setCurrentIndex(TAB_HORDE)
            self._flash_summary(f"Custom size {w}\u00d7{h} exceeds 1 MP limit.")
            return
        enabled_loras = sum(
            1 for e in self._current_lora_stack() if e.get("enabled") and str(e.get("id") or "").strip()
        )
        if enabled_loras > MAX_ACTIVE_LORAS:
            self.tabs.setCurrentIndex(TAB_LORA)
            self._flash_summary(
                f"{enabled_loras} LoRAs enabled — AI Horde accepts at most {MAX_ACTIVE_LORAS} per request."
            )
            return
        if self.img2img_source and not self._validate_img2img_source():
            return
        payload, meta = self.build_payload()
        job = self.queue.enqueue(payload, meta)
        SOUNDS.play("sent")
        self._record_history(raw, neg)
        self.mini_queue.setVisible(True)
        self.mini_queue.scrollToBottom()
        if has_wildcard_syntax(raw) or (self.active_template and has_wildcard_syntax(self.active_template.get("body", ""))):
            self._wc_cache_key = None
            self._wc_cache_val = ""
            self._update_preview()
        self._schedule_save()
        if self.api_key == ANON_KEY and job.local_id == 1:
            STUDIO_LOG.warn("HORDE", "Anonymous API key active (lowest priority). Add your key in data/key.txt.")

    # ------------------------------------------------------------------ Batch Prompt Queue
    def _batch_pipeline_summary(self) -> str:
        """One-line description of what every batch line will be wrapped with."""
        feats = model_features(self.current_model())
        model = MODELS[self.current_model()]["label"]
        bits = [f"Model {model}"]
        if feats["templates"] and self.active_template:
            bits.append(f"template '{self.active_template['name']}'")
        else:
            bits.append("no template")
        neg = self.neg_edit.toPlainText().strip()
        if feats["negative"] and neg:
            bits.append(f"negative ({len(neg)} ch)")
        else:
            bits.append("empty negative")
        if feats["loras"]:
            n_loras = len(self._active_lora_entries())
            bits.append(f"{n_loras} LoRA(s)")
        else:
            bits.append("no LoRAs")
        if self.img2img_source:
            bits.append(f"img2img ε{self.i2i_denoise_spin.value():.2f}")
        w, h, _k = self._current_size()
        bits.append(f"{w}×{h}")
        return "Each line gets:  " + "  •  ".join(bits)

    def open_batch_queue_dialog(self) -> None:
        """Batch Prompt Queue: paste single-line prompts (Ctrl+Shift+V), every
        line becomes its own queued request through the active pipeline."""
        if self.img2img_source and not self._validate_img2img_source():
            return
        w, h, _k = self._current_size()
        if w * h > MEGAPIXEL_BUDGET:
            self.tabs.setCurrentIndex(TAB_HORDE)
            self._flash_summary(f"Custom size {w}×{h} exceeds 1 MP limit.")
            return
        clip = ""
        try:
            clip = QApplication.clipboard().text()
        except Exception:  # noqa: BLE001
            clip = ""
        dlg = BatchQueueDialog(self, clipboard_text=clip)
        dlg.set_pipeline_info(self._batch_pipeline_summary())
        if not dlg.exec():
            return
        self.batch_submit(dlg.lines)

    def batch_submit(self, lines: Sequence[str]) -> int:
        """Queue one generation request per single-line prompt. Applies the
        active template, negative prompt, LoRA stack, wildcards and img2img
        source to every line. Seed: offsets when a seed is set, fresh randoms
        otherwise. Returns the number of queued jobs."""
        feats = model_features(self.current_model())
        if feats["loras"]:
            enabled_loras = sum(
                1 for e in self._current_lora_stack() if e.get("enabled") and str(e.get("id") or "").strip()
            )
            if enabled_loras > MAX_ACTIVE_LORAS:
                self.tabs.setCurrentIndex(TAB_LORA)
                self._flash_summary(
                    f"{enabled_loras} LoRAs enabled — AI Horde accepts at most {MAX_ACTIVE_LORAS} per request."
                )
                return 0
        base_seed = self.seed_edit.text().strip()
        queued = 0
        first_raw = ""
        for i, raw_line in enumerate(lines):
            raw_line = " ".join(str(raw_line).split())
            if not raw_line:
                continue
            seed_override: Optional[str] = None
            if base_seed:
                if base_seed.lstrip("-").isdigit():
                    seed_override = str(int(base_seed) + i)
                else:
                    seed_override = base_seed if i == 0 else f"{base_seed} b{i + 1}"
            payload, meta = self.build_payload(
                prompt_override=raw_line,
                n_override=1,
                seed_override=seed_override,
                apply_template=True,
                via="batch",
            )
            self.queue.enqueue(payload, meta)
            if queued == 0:
                first_raw = raw_line
            queued += 1
        if queued:
            self._record_history(first_raw, self.neg_edit.toPlainText())
            self.mini_queue.setVisible(True)
            self.mini_queue.scrollToBottom()
            # every batch line re-rolls wildcard values independently
            self._wc_cache_key = None
            self._wc_cache_val = ""
            self._flash_summary(f"Batch: queued {queued} prompt(s)")
            self.toast.notify(f"Batch queue \u2014 {queued} request(s) submitted", "ok")
            SOUNDS.play("sent")
            STUDIO_LOG.ok("HORDE", f"Batch Prompt Queue: {queued} jobs enqueued")
        else:
            self._flash_summary("Batch queue empty — nothing pasted")
        return queued

    # ------------------------------------------------------------------ Queue & Log Handling
    def _selected_job(self, view: Optional[QListView] = None) -> Optional[Job]:
        v = view or self.queue_view
        idx = v.currentIndex()
        return idx.data(Qt.ItemDataRole.UserRole) if idx.isValid() else None

    def _queue_act(self, action: str, view: Optional[QListView] = None) -> None:
        job = self._selected_job(view)
        if job is None:
            return
        if job.kind == KIND_GROUP:
            gid = job.group_id
            if action == "cancel":
                self.queue.cancel(job)
            elif action == "focus" and gid is not None:
                self._ups_show_run(gid)
                self.tabs.setCurrentIndex(TAB_UPSCALE)
            elif action == "group_retry" and gid is not None:
                self._ups_show_run(gid)
                self.ups_retry_failed()
            elif action == "group_merge" and gid is not None:
                self._ups_show_run(gid)
                self.ups_merge_and_save()
            elif action == "remove":
                self.queue.remove(job)
                if gid is not None:
                    ImageStore.clean_group_tiles(gid)
                    self.ups_groups.pop(gid, None)
                    if self.ups_active_gid == gid:
                        rem = sorted(self.ups_groups)
                        self._ups_show_run(rem[-1] if rem else None)
                    self._ups_rebuild_group_combo()
            return
        if action == "cancel":
            self.queue.cancel(job)
        elif action == "retry":
            self.queue.retry(job)
        elif action == "remove":
            self.queue.remove(job)
        elif action == "up":
            self.queue.move(job, -1)
        elif action == "down":
            self.queue.move(job, 1)
        elif action == "view":
            self._queue_show_result(self.queue_view.currentIndex() if view is None else view.currentIndex())

    def _queue_menu(self, pos: QPoint, view: QListView) -> None:
        idx = view.indexAt(pos)
        if not idx.isValid():
            return
        view.setCurrentIndex(idx)
        job = idx.data(Qt.ItemDataRole.UserRole)
        if not isinstance(job, Job):
            return
        m = QMenu(self)
        if job.kind == KIND_GROUP:
            m.addAction("Focus in Upscale Tab", lambda: self._queue_act("focus", view))
            m.addAction("Retry Failed Tiles", lambda: self._queue_act("group_retry", view))
            m.addAction("Merge & Save Now", lambda: self._queue_act("group_merge", view))
            m.addSeparator()
            m.addAction("Cancel Group", lambda: self._queue_act("cancel", view))
            m.addAction("Remove Group", lambda: self._queue_act("remove", view))
        else:
            if job.results:
                m.addAction("Open Result in Viewer", lambda: self._queue_act("view", view))
            if job.active:
                m.addAction("Cancel", lambda: self._queue_act("cancel", view))
            if job.state == STATE_FAILED:
                m.addAction("Retry", lambda: self._queue_act("retry", view))
            if job.kind == KIND_TILE_I2I and job.group_id is not None:
                m.addAction("Focus Upscale Run", lambda: self._queue_act("focus", view))
            m.addSeparator()
            if job.state == STATE_QUEUED:
                m.addAction("Move Up", lambda: self._queue_act("up", view))
                m.addAction("Move Down", lambda: self._queue_act("down", view))
            m.addAction("Remove from List", lambda: self._queue_act("remove", view))
        m.exec(view.viewport().mapToGlobal(pos))

    def _queue_clicked(self, idx: QModelIndex) -> None:
        job = idx.data(Qt.ItemDataRole.UserRole)
        if isinstance(job, Job) and job.kind == KIND_TILE_I2I and job.group_id is not None:
            self._ups_show_run(job.group_id)

    def _queue_show_result(self, idx: QModelIndex) -> None:
        job = idx.data(Qt.ItemDataRole.UserRole)
        if isinstance(job, Job) and job.results:
            self.right_tabs.setCurrentIndex(0)
            self.show_image(job.results[0])

    def retry_failed(self) -> None:
        n = 0
        for job in list(self.queue.jobs):
            if job.kind != KIND_GROUP and job.state == STATE_FAILED:
                self.queue.retry(job)
                n += 1
        self._flash_summary(f"Retried {n} failed job(s)" if n else "No failed jobs to retry")

    def cancel_all(self) -> None:
        if (
            QMessageBox.question(
                self,
                "Cancel all",
                "Cancel every active and queued request on AI Horde?",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
            )
            != QMessageBox.StandardButton.Yes
        ):
            return
        self.queue.cancel_all()

