def ensure_dirs() -> None:
    for d in (TEMP_DIR, OUTPUT_DIR, TILES_DIR, WILDCARDS_DIR):
        try:
            os.makedirs(d, exist_ok=True)
        except OSError:
            pass
    # Drop a tiny sample wildcard so the format is discoverable.
    for name, body in DEFAULT_WILDCARDS.items():
        path = os.path.join(WILDCARDS_DIR, name)
        if not os.path.exists(path):
            write_text(path, body)


def read_text(path: str, default: str = "") -> str:
    try:
        with open(path, "r", encoding="utf-8-sig") as fh:
            return fh.read()
    except OSError:
        return default


def write_text(path: str, text: str) -> bool:
    try:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(text)
        return True
    except OSError:
        return False


def load_api_key() -> str:
    """Return the key stored in key.txt; create the file with the anonymous key if missing."""
    if not os.path.exists(KEY_FILE):
        write_text(KEY_FILE, ANON_KEY + "\n")
        return ANON_KEY
    for line in read_text(KEY_FILE).splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            return line
    return ANON_KEY


def mask_key(key: str) -> str:
    if not key or key == ANON_KEY:
        return "anonymous (0000000000)"
    if len(key) <= 6:
        return "*" * len(key)
    return "*" * (len(key) - 4) + key[-4:]


def deep_merge(base: Dict[str, Any], over: Dict[str, Any]) -> Dict[str, Any]:
    out = json.loads(json.dumps(base))
    for k, v in (over or {}).items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = v
    return out


