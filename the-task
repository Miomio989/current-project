    def _sfx_sword_whoosh(self, dur: float, f0: float, f1: float, metal: float = 0.35) -> Optional[pygame.mixer.Sound]:
        n = int(self.sr * dur)
        out = [0.0] * n
        inv_sr = 1.0 / float(self.sr)
        lp = 0.0
        mp = 0.0
        for i in range(n):
            u = i / float(max(1, n - 1))
            t = i * inv_sr
            env = math.sin(u * math.pi) ** 1.25
            freq = lerp(f0, f1, u)
            cut = clamp(freq / (self.sr * 0.45), 0.02, 0.85)
            rn = self._noise_lut[(i * 3) & self._noise_mask]
            lp += cut * (rn - lp)
            mp += (freq * 1.65) * inv_sr * _TWO_PI
            ring = math.sin(mp) * metal * 0.32 * math.exp(-t * 10.0)
            out[i] = _fast_tanh((lp * 1.9 + ring) * env * 1.5) * 0.72
        return self._to_stereo_sound(out, gain=0.80)

    def _sfx_slash_hit(self, dur: float, punch: float, crunch: float, blood: float) -> Optional[pygame.mixer.Sound]:
        n = int(self.sr * dur)
        out = [0.0] * n
        inv_sr = 1.0 / float(self.sr)
        ph = 0.0
        lp = 0.0
        for i in range(n):
            t = i * inv_sr
            freq = punch * 0.45 + punch * 1.65 * math.exp(-t * 36.0)
            ph += freq * inv_sr * _TWO_PI
            thump = math.sin(ph) * math.exp(-t * 14.0) * 0.95
            rn = self._noise_lut[(i * 5 + 7) & self._noise_mask]
            # Sharp blade tear + wet arterial splash tail
            tear = rn * math.exp(-t * 24.0) * crunch * 0.85
            lp += 0.16 * (rn - lp)
            wet = lp * math.exp(-t * 8.5) * blood * 0.55
            out[i] = _fast_tanh((thump + tear + wet) * 1.8) * 0.88
        return self._to_stereo_sound(out, gain=0.88)

    def _sfx_blood_spray(self, dur: float) -> Optional[pygame.mixer.Sound]:
        n = int(self.sr * dur)
        out = [0.0] * n
        inv_sr = 1.0 / float(self.sr)
        lp = 0.0
        for i in range(n):
            t = i * inv_sr
            rn = self._noise_lut[(i * 7 + 33) & self._noise_mask]
            lp += 0.22 * (rn - lp)
            # Modulated wet burst droplets
            mod = 0.65 + 0.35 * math.sin(t * 115.0)
            out[i] = lp * math.exp(-t * 11.0) * mod * 0.72
        return self._to_stereo_sound(out, gain=0.78)

    def _sfx_counter_hit(self) -> Optional[pygame.mixer.Sound]:
        n = int(self.sr * 0.46)
