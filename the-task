class AnimationPlayer:
    """Stepped PS2/PSP-style skeletal animation evaluator with cross-fade blending and smear detection."""
    __slots__ = (
        "char_id", "clip_name", "frame", "prev_eulers", "blend_t", "blend_dur",
        "expression", "root_dx", "root_dy", "smear_active", "finished"
    )

    def __init__(self, char_id: str) -> None:
        self.char_id = char_id
        self.clip_name = "idle"
        self.frame = 0.0
        self.prev_eulers: List[List[float]] = [[0.0, 0.0, 0.0] for _ in range(len(BONE_NAMES))]
        self.blend_t = 1.0
        self.blend_dur = 0.08
        self.expression = "neutral"
        self.root_dx = 0.0
        self.root_dy = 0.0
        self.smear_active = False
        self.finished = False

    def play(self, clip_name: str, restart: bool = False, blend_dur: float = 0.07) -> None:
        clips = ANIMATION_LIBRARY[self.char_id]
        if clip_name not in clips:
            clip_name = "idle"
        if clip_name == self.clip_name and not restart:
            return
        self.prev_eulers = self.sample_raw_eulers()
        self.clip_name = clip_name
        self.frame = 0.0
        self.blend_t = 0.0 if blend_dur > 0.0 else 1.0
        self.blend_dur = max(0.01, blend_dur)
        self.finished = False

    def step(self, dt: float, speed: float = 1.0) -> None:
        total_frames, loop, _ = ANIMATION_LIBRARY[self.char_id][self.clip_name]
        self.frame += dt * FPS * speed
        if self.frame >= total_frames - 1:
            if loop:
                self.frame = self.frame % max(1, total_frames - 1)
            else:
                self.frame = float(total_frames - 1)
                self.finished = True
        if self.blend_t < 1.0:
            self.blend_t = min(1.0, self.blend_t + dt / self.blend_dur)

    def sample_raw_eulers(self) -> List[List[float]]:
        total_frames, _, kfs = ANIMATION_LIBRARY[self.char_id][self.clip_name]
        f = clamp(self.frame, 0.0, float(total_frames - 1))
        # Find enclosing keyframes
        k0 = kfs[0]
        k1 = kfs[-1]
        for i in range(len(kfs) - 1):
            if kfs[i][0] <= f <= kfs[i + 1][0]:
                k0 = kfs[i]
                k1 = kfs[i + 1]
                break
        span = max(1.0, float(k1[0] - k0[0]))
        t = clamp((f - k0[0]) / span, 0.0, 1.0)
        # Stepped limited-key interpolation for crisp anime fighting-game snap
        t_step = smoothstep(round(t * 4.0) / 4.0) if k0[4] or k1[4] else smoothstep(t)

        self.expression = k0[1] if t < 0.5 else k1[1]
        self.root_dx = lerp(k0[2], k1[2], t_step)
        self.root_dy = lerp(k0[3], k1[3], t_step)
        self.smear_active = bool(k0[4] or (k1[4] and t > 0.5))

        out = [[0.0, 0.0, 0.0] for _ in range(len(BONE_NAMES))]
        m0 = {b[0]: (b[1], b[2], b[3]) for b in k0[5]}
        m1 = {b[0]: (b[1], b[2], b[3]) for b in k1[5]}
        for b_idx in range(len(BONE_NAMES)):
            a = m0.get(b_idx, (0.0, 0.0, 0.0))
            b = m1.get(b_idx, a)
            out[b_idx][0] = lerp(a[0], b[0], t_step)
            out[b_idx][1] = lerp(a[1], b[1], t_step)
            out[b_idx][2] = lerp(a[2], b[2], t_step)
        return out

    def evaluate(self) -> List[List[float]]:
        cur = self.sample_raw_eulers()
        if self.blend_t < 1.0:
            bt = smoothstep(self.blend_t)
            for i in range(len(BONE_NAMES)):
                cur[i][0] = lerp(self.prev_eulers[i][0], cur[i][0], bt)
                cur[i][1] = lerp(self.prev_eulers[i][1], cur[i][1], bt)
                cur[i][2] = lerp(self.prev_eulers[i][2], cur[i][2], bt)
        return cur


