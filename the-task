    # ------------------------------------------------------------------ theme (v1.8.0)
    def _apply_theme(self, name: str) -> None:
        """Switch the live theme: swap the palettes, rebuild the app style
        sheet + QPalette, repolish and repaint EVERY widget, then refresh the
        pieces that cache themed text (placeholders, inline chips)."""
        name = set_theme(name)
        app = QApplication.instance()
        if app is not None:
            apply_palette(app)
            scale = float((self.settings.get("ui") or {}).get("font_scale", 1.0) or 1.0)
            app.setStyleSheet(build_stylesheet(scale))
            for w in QApplication.allWidgets():
                try:
                    st = w.style()
                    st.unpolish(w)
                    st.polish(w)
                except RuntimeError:
                    pass                # deleted C++ object behind a live wrapper
                w.update()
        # refresh themed inline styles / cached placeholder texts
        self._update_template_chip()
        if self.viewer.pix is None:
            self.viewer._show_placeholder()
        self.ups_plan_preview.refresh_placeholder()
        self.ups_canvas_preview.refresh_placeholder()
        self._sync_theme_ui(name)
        self.settings.setdefault("ui", {})["theme"] = name
        self._schedule_save()
        self.append_log(f"theme switched to {theme_meta('name')} ({theme_meta('label')})")

    def _toggle_theme(self) -> None:
        other = "crimson" if theme_name() == "gold" else "gold"
        self._apply_theme(other)

    def _sync_theme_ui(self, name: str) -> None:
        """Mirror the active theme in the corner button and the View menu."""
        th = THEMES.get(name, THEMES[DEFAULT_THEME])
        if getattr(self, "theme_btn", None) is not None:
