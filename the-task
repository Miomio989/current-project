        iron_dark = (14, 10, 16)
        iron_rust = (88, 36, 32)
        iron_rim = (176, 62, 52)

        def draw_fence_section(x0: float, x1: float, base_y: float, tilt: float, h: float) -> None:
            n_bars = max(4, int((x1 - x0) / 17))
            top_l = (x0 + math.sin(tilt) * h, base_y - h)
            top_r = (x1 + math.sin(tilt) * h, base_y - h + math.sin(tilt) * 18)
            # Horizontal rusted iron rails
            for rf in (0.25, 0.78):
                ra = (lerp(x0, top_l[0], rf), lerp(base_y, top_l[1], rf))
                rb = (lerp(x1, top_r[0], rf), lerp(base_y, top_r[1], rf))
                pygame.draw.line(s, iron_dark, ra, rb, 5)
                pygame.draw.line(s, iron_rust, (ra[0], ra[1] - 1), (rb[0], rb[1] - 1), 2)
            # Individual spearhead iron bars (some bent/snapped!)
            for i in range(n_bars + 1):
                u = i / float(n_bars)
                bx = lerp(x0, x1, u)
                bend = rng.uniform(-0.10, 0.10) if rng.random() < 0.35 else 0.0
                bar_h = h * (rng.uniform(0.55, 0.85) if rng.random() < 0.22 else 1.0)
