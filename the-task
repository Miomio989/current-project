    def rename_selected(self) -> None:
        """Rename the current image in place (image + its .json sidecar)."""
        p, _m = self._current_path_meta()
        if not p or not os.path.exists(p):
            self.main._flash_summary("Select an image first.")
            return
        base = os.path.basename(p)
        ext = os.path.splitext(base)[1]
        new, ok = QInputDialog.getText(self, "Rename image", "New file name:", text=base)
        if not ok:
            return
        new = new.strip()
        if not new or new == base:
            return
        if not new.lower().endswith(ext.lower()):
            new += ext
        dest = os.path.join(os.path.dirname(p), new)
        if dest == p:
            return
        if os.path.exists(dest):
            self.main._flash_summary("A file with that name already exists.")
            return
        try:
            os.rename(p, dest)
            side_old = os.path.splitext(p)[0] + ".json"
            side_new = os.path.splitext(dest)[0] + ".json"
            if os.path.exists(side_old):
                os.rename(side_old, side_new)
        except OSError as exc:
            self.main._flash_summary(f"Rename failed: {exc}")
            return
        self._cache.pop(p, None)
        self._mtimes.pop(p, None)
        self.main.append_log(f"gallery: renamed {base} \u2192 {new}")
        self.main._flash_summary(f"Renamed to {new}")
        self.refresh(force=True)

    def show_in_viewer(self, path: Optional[str]) -> None:
        if not path or not os.path.exists(path):
            return
        self.main.right_tabs.setCurrentIndex(0)
        self.main.show_image(path)

    def send_to_upscale(self) -> None:
        p, _m = self._current_path_meta()
        if not p or not os.path.exists(p):
            return
        self.main.ups_set_source(p)            # jumps the left tabs to UPSCALE
        self.main.right_tabs.setCurrentIndex(0)
        self.main.show_image(p)

    def copy_prompt(self, unique: bool) -> None:
        p, m = self._current_path_meta()
        if not p or not m:
            self.main._flash_summary("Select an image first.")
            return
        full = (m.get("prompt") or "").strip()
        raw = (m.get("raw_prompt") or "").strip()
        if unique:
            if raw:
                txt, note = raw, None
            elif full and not m.get("template"):
                txt, note = full, "no template was used - the full prompt is the unique part"
            elif full:
                txt, note = full, "the unique part was not stored for this image - copied the full prompt"
            else:
                txt, note = "", "this image carries no prompt metadata"
        else:
            txt, note = (full, None) if full else ("", "this image carries no prompt metadata")
        if not txt:
            self.main._flash_summary(note or "Nothing to copy")
            return
        QApplication.clipboard().setText(txt)
        self.main._flash_summary(note or ("Unique part copied" if unique else "Full prompt copied"))

    def delete_selected(self) -> None:
        sel = self.list.selectedItems()
        if not sel:
            return
        paths = [it.data(self.ROLE_PATH) for it in sel]
        paths = [p for p in paths if p]
        if not paths:
            return
        preview = "\n".join("  " + os.path.basename(p) for p in paths[:8])
        more = f"\n  \u2026 and {len(paths) - 8} more" if len(paths) > 8 else ""
        ans = QMessageBox.question(
            self, "Delete from output/",
            f"Delete {len(paths)} image(s) from output/ (with their .json sidecars)?\n\n{preview}{more}",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No | QMessageBox.StandardButton.Cancel)
        if ans != QMessageBox.StandardButton.Yes:
            return
        removed = 0
        for p in paths:
            for q in (p, os.path.splitext(p)[0] + ".json"):
                try:
                    os.remove(q)
                    if q == p:
                        removed += 1
                except OSError:
                    pass
            self._cache.pop(p, None)
            self._mtimes.pop(p, None)
        self.main.append_log(f"gallery: deleted {removed} image(s) from output/")
        if self.main.viewer.path and self.main.viewer.path in set(paths):
            self.main.show_image(None)          # the viewer showed a deleted file
        self.main.refresh_gallery()             # the strip may have held them too
        self._page = max(0, min(self._page, self.page_count() - 1))
        self.refresh(force=True)
        self.main._flash_summary(f"Deleted {removed} image(s)")

    def use_in_editor(self, what: str) -> None:
        p, m = self._current_path_meta()
        self.main.use_from_image(what, p, m)

    def _menu(self, pos: QPoint) -> None:
        it = self.list.itemAt(pos)
        if it is None:
            return
        self.list.setCurrentItem(it)
        path = it.data(self.ROLE_PATH)
        m = QMenu(self)
        m.addAction("Show in viewer", lambda: self.show_in_viewer(path))
        m.addAction("Open with system viewer", lambda: open_path(path))
        m.addAction("Open containing folder", lambda: open_path(os.path.dirname(path)))
        m.addSeparator()
        m.addAction("Info", self.show_info)
        m.addAction("Rename\u2026", self.rename_selected)
        m.addAction("Send to tile upscale", self.send_to_upscale)
        m.addSeparator()
        m.addAction("Copy full prompt", lambda: self.copy_prompt(False))
        m.addAction("Copy unique part", lambda: self.copy_prompt(True))
        m.addAction("Copy image to clipboard", self.copy_image)
        m.addAction("Copy file path", lambda: self.copy_path())
        m.addSeparator()
        m.addAction("Use prompt in editor", lambda: self.use_in_editor("prompt"))
        m.addAction("Use everything", lambda: self.use_in_editor("all"))
        m.addSeparator()
        m.addAction("Delete from disk", self.delete_selected)
        m.exec(self.list.viewport().mapToGlobal(pos))

    def shutdown(self) -> None:
        self._refresh_timer.stop()
        self.loader.stop()
        self.loader.wait(1500)


class QueueDelegate(QStyledItemDelegate):
    """Queue rows. Job-state colours come from the live JOB_STATE_COLORS dict
    (swapped by set_theme()), every surface from PAL."""

    def __init__(self, compact: bool = False, parent=None):
        super().__init__(parent)
        self.compact = compact

    def sizeHint(self, opt: QStyleOptionViewItem, index: QModelIndex) -> QSize:  # noqa: N802
        job: Job = index.data(Qt.ItemDataRole.UserRole)
        if job is not None and job.kind == KIND_GROUP:
            return QSize(120, 46 if self.compact else 66)
        return QSize(120, 42 if self.compact else 58)

    def _chip_text(self, job: Job) -> str:
        if job.kind == KIND_GROUP:
            m = job.meta
            return f"{m.get('cols')}\u00d7{m.get('rows')} \u2022 {m.get('out_w')}\u00d7{m.get('out_h')}"
        if job.kind == KIND_ALCH:
            m = job.meta
            if m.get("base"):
                return f"BASE \u00d7{m.get('factor', '?')} {m.get('tile_w')}\u00d7{m.get('tile_h')}"
            return f"ALCH \u00d7{m.get('factor', '?')} {m.get('width')}\u00d7{m.get('height')}"
        chip = f"{model_short(job.meta.get('model', '')) or '?'}  {job.meta.get('width')}\u00d7{job.meta.get('height')}"
        if job.n > 1:
            chip += f"  \u00d7{job.n}"
        if job.meta.get("loras"):
            chip += f"  L{len(job.meta['loras'])}"
        return chip

    def paint(self, p: QPainter, opt: QStyleOptionViewItem, index: QModelIndex) -> None:
        job: Job = index.data(Qt.ItemDataRole.UserRole)
        if job is None:
            return
        p.save()
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(opt.rect).adjusted(2, 2, -2, -2)
        selected = bool(opt.state & QStyle.StateFlag.State_Selected)
        if job.kind == KIND_GROUP:
            self._paint_group(p, r, job, selected)
            p.restore()
            return
        inner = job.group_id is not None
        g = QLinearGradient(0, r.top(), 0, r.bottom())
        if selected:
            g.setColorAt(0, QColor(PAL["row_sel_hi"])); g.setColorAt(1, QColor(PAL["row_sel_lo"]))
        else:
            g.setColorAt(0, QColor(PAL["row_hi"])); g.setColorAt(1, QColor(PAL["row_lo"]))
        p.setPen(QPen(QColor(PAL["acc_lo"]) if selected else QColor(PAL["row_border"]), 1))
        p.setBrush(QBrush(g))
        p.drawRoundedRect(r, 4, 4)
        p.setPen(QPen(QColor(255, 255, 255, 22), 1))
        p.drawLine(QPointF(r.left() + 4, r.top() + 1.5), QPointF(r.right() - 4, r.top() + 1.5))
        x = r.left() + 28 + (12 if inner else 0)
        chip_text = self._chip_text(job)
        right_w = QFontMetrics(_font(8, True)).horizontalAdvance(chip_text) + 14
        # lamp
        color = QColor(JOB_STATE_COLORS.get(job.state, PAL["st_queued"]))
        lamp = QRectF(r.left() + 8, r.top() + (9 if self.compact else 12), 12, 12)
        if inner:
            lamp = QRectF(r.left() + 16, r.top() + (9 if self.compact else 12), 11, 11)
        rg = QRadialGradient(lamp.center().x() - 2, lamp.center().y() - 3, 9)
        rg.setColorAt(0, color.lighter(160))
        rg.setColorAt(1, color.darker(130))
        p.setPen(QPen(QColor(PAL["lamp_border"]), 1))
        p.setBrush(QBrush(rg))
        p.drawEllipse(lamp)
        if job.active:
            glow = QColor(color)
            glow.setAlpha(70 + int(50 * abs((time.time() * 2) % 2 - 1)))
            p.setPen(QPen(glow, 2))
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.drawEllipse(lamp.adjusted(-2.5, -2.5, 2.5, 2.5))
        # title
        p.setFont(_font(10 if not inner else 9.3, True))
        p.setPen(QColor(PAL["row_title"]) if not inner else QColor(PAL["row_title_inner"]))
        title_rect = QRectF(x, r.top() + (2 if self.compact else 4), r.width() - (x - r.left()) - right_w - 6, 17)
        fm = QFontMetrics(p.font())
        prefix = "\u21b3  " if inner else ""
        p.drawText(title_rect, Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft,
                   fm.elidedText(f"#{job.local_id}  {prefix}{job.title()}", Qt.TextElideMode.ElideRight, int(title_rect.width())))
        # right chip (kind + size)
        p.setFont(_font(8, True))
        chip = QRectF(r.right() - right_w - 2, r.top() + (3 if self.compact else 5), right_w, 15)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(0, 0, 0, 90))
        p.drawRoundedRect(chip, 3, 3)
        p.setPen(QColor(PAL["acc_hi"]) if job.kind != KIND_ALCH else QColor(PAL["alch_chip"]))
        p.drawText(chip, Qt.AlignmentFlag.AlignCenter, chip_text)
        # status
        status = job.status_text()
        p.setFont(_font(8.8))
        p.setPen(QColor(PAL["proc"]) if job.active else (QColor(PAL["status_failed"]) if job.state == STATE_FAILED else QColor(PAL["status_idle"])))
        if self.compact:
            st_rect = QRectF(x, r.top() + 18, r.width() - (x - r.left()) - 8, 13)
        else:
            st_rect = QRectF(x, r.top() + 24, r.width() - (x - r.left()) - 8, 16)
        fm2 = QFontMetrics(p.font())
        p.drawText(st_rect, Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft,
                   fm2.elidedText(status, Qt.TextElideMode.ElideRight, int(st_rect.width())))
        # progress bar
        bar_h = 4 if self.compact else 7
        bar = QRectF(x, r.bottom() - bar_h - (3 if self.compact else 4), r.width() - (x - r.left()) - 8, bar_h)
        p.setPen(QPen(QColor(PAL["bar_border"]), 1))
        p.setBrush(QColor(PAL["bar_bg"]))
        p.drawRoundedRect(bar, 2.5, 2.5)
        frac = job.progress()
        if frac > 0:
            fill = QRectF(bar.left() + 1, bar.top() + 1, max(2.0, (bar.width() - 2) * frac), bar.height() - 2)
            bg = QLinearGradient(0, fill.top(), 0, fill.bottom())
            if job.state == STATE_FAILED:
                bg.setColorAt(0, QColor(PAL["bar_fail_hi"])); bg.setColorAt(1, QColor(PAL["bar_fail_lo"]))
            elif job.state == STATE_CANCELLED:
                bg.setColorAt(0, QColor(PAL["bar_cancel_hi"])); bg.setColorAt(1, QColor(PAL["bar_cancel_lo"]))
            else:
                bg.setColorAt(0, QColor(PAL["bar_hi"])); bg.setColorAt(1, QColor(PAL["bar_lo"]))
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QBrush(bg))
            p.drawRoundedRect(fill, 2, 2)
        p.restore()

    def _paint_group(self, p: QPainter, r: QRectF, job: Job, selected: bool) -> None:
        a = job.agg
        # accent-framed plate
        g = QLinearGradient(0, r.top(), 0, r.bottom())
        if selected:
            g.setColorAt(0, QColor(PAL["grp_sel_hi"])); g.setColorAt(1, QColor(PAL["grp_sel_lo"]))
        else:
            g.setColorAt(0, QColor(PAL["grp_hi"])); g.setColorAt(1, QColor(PAL["grp_lo"]))
        p.setPen(QPen(QColor(PAL["acc"]) if selected else QColor(PAL["acc_lo"]), 1.6))
        p.setBrush(QBrush(g))
        p.drawRoundedRect(r, 5, 5)
        top_glow = QColor(GOLD["edge"])
        top_glow.setAlpha(70)
        p.setPen(QPen(top_glow, 1))
        p.drawLine(QPointF(r.left() + 4, r.top() + 1.5), QPointF(r.right() - 4, r.top() + 1.5))
        # diamond marker
        cy = r.top() + 13
        dia = QPainterPath()
        dia.moveTo(r.left() + 13, cy - 5); dia.lineTo(r.left() + 18, cy)
        dia.lineTo(r.left() + 13, cy + 5); dia.lineTo(r.left() + 8, cy)
        dia.closeSubpath()
        rg = QRadialGradient(r.left() + 12, cy - 2, 8)
        rg.setColorAt(0, QColor(PAL["sh_diamond_hi"]))
        rg.setColorAt(1, QColor(PAL["acc_lo"]))
        p.setPen(QPen(QColor(PAL["acc_dk"]), 1))
        p.setBrush(QBrush(rg))
        p.drawPath(dia)
        # kicker
        p.setFont(_font(8, True, 1.2))
        p.setPen(QColor(PAL["acc_hi"]))
        if not self.compact:
            p.drawText(QRectF(r.left() + 26, r.top() + 2, r.width() - 26, 12),
                       Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft, "TILE UPSCALE")
        # title
        p.setFont(_font(10.5, True))
        p.setPen(QColor(PAL["sh_title"]))
        if self.compact:
            title_rect = QRectF(r.left() + 26, r.top() + 2, r.width() - 26 - 10, 14)
            p.setFont(_font(9.2, True))
        else:
            title_rect = QRectF(r.left() + 26, r.top() + 13, r.width() - 26 - 10, 18)
        fm = QFontMetrics(p.font())
        p.drawText(title_rect, Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft,
                   fm.elidedText(job.title(), Qt.TextElideMode.ElideRight, int(title_rect.width())))
        if not self.compact:
            # per-stage status chips with the state colours (above the bar)
            bits = []
            if a.get("base"):
                bits.append(("base", 1))
            for st in (TILE_DONE, TILE_REFINING, TILE_UPSCALED, TILE_FAILED):
                if a.get(st):
                    bits.append((st, int(a[st])))
            x = r.left() + 26
            p.setFont(_font(8.6, True))
            for st, cnt in bits:
                if st == "base":
                    col = QColor(PAL["acc"])
                    txt = "BASE \u2191"
                else:
                    col = QColor(TILE_STATE_COLORS[st])
                    txt = f"{cnt} {TILE_STATE_SHORT[st].strip()}"
                w = QFontMetrics(p.font()).horizontalAdvance(txt) + 10
                box = QRectF(x, r.bottom() - 25, w, 14)
                p.setPen(Qt.PenStyle.NoPen)
                p.setBrush(QColor(0, 0, 0, 100))
                p.drawRoundedRect(box, 3, 3)
                p.setPen(col)
                p.drawText(box, Qt.AlignmentFlag.AlignCenter, txt)
                x += w + 4
        else:
            # compact: single status line with the same colours
            bits = [f"{a[st]} {TILE_STATE_SHORT[st].strip()}" for st in
                    (TILE_DONE, TILE_REFINING, TILE_UPSCALED, TILE_UPSCALING, TILE_FAILED) if a.get(st)]
            if a.get("base"):
                bits.insert(0, "BASE \u2191")
            if bits:
                p.setFont(_font(8, True))
                p.setPen(QColor(PAL["acc_hi"]))
                st_rect = QRectF(r.left() + 26, r.top() + 16, r.width() - 26 - 10, 12)
                fm3 = QFontMetrics(p.font())
                p.drawText(st_rect, Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft,
                           fm3.elidedText(" \u2022 ".join(bits), Qt.TextElideMode.ElideRight, int(st_rect.width())))
        # right chip: grid + result size
        chip_text = self._chip_text(job)
        p.setFont(_font(8, True))
        cw = QFontMetrics(p.font()).horizontalAdvance(chip_text) + 14
        chip = QRectF(r.right() - cw - 3, r.top() + 3, cw, 15)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(0, 0, 0, 100))
        p.drawRoundedRect(chip, 3, 3)
        p.setPen(QColor(PAL["acc_hi"]))
        p.drawText(chip, Qt.AlignmentFlag.AlignCenter, chip_text)
        # progress bar
        bar_h = 5 if self.compact else 6
        bar = QRectF(r.left() + 26, r.bottom() - bar_h - 3, r.width() - 26 - 8, bar_h)
        if self.compact:
            bar = QRectF(r.left() + 26, r.bottom() - bar_h - 2, r.width() - 26 - 8, bar_h)
        p.setPen(QPen(QColor(PAL["bar_border"]), 1))
        p.setBrush(QColor(PAL["bar_bg"]))
        p.drawRoundedRect(bar, 2.5, 2.5)
        frac = job.progress()
        if frac > 0:
            fill = QRectF(bar.left() + 1, bar.top() + 1, max(2.0, (bar.width() - 2) * frac), bar.height() - 2)
            bg = QLinearGradient(0, fill.top(), 0, fill.bottom())
            if job.state == STATE_FAILED and a.get(TILE_FAILED) and not (a.get(TILE_UPSCALING) or a.get(TILE_REFINING) or a.get(TILE_UPSCALED)):
                bg.setColorAt(0, QColor(PAL["bar_fail_hi"])); bg.setColorAt(1, QColor(PAL["bar_fail_lo"]))
            elif job.state == STATE_CANCELLED:
                bg.setColorAt(0, QColor(PAL["bar_cancel_hi"])); bg.setColorAt(1, QColor(PAL["bar_cancel_lo"]))
            else:
                bg.setColorAt(0, QColor(PAL["bar_hi"])); bg.setColorAt(1, QColor(PAL["bar_lo"]))
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QBrush(bg))
            p.drawRoundedRect(fill, 2, 2)


class TileGridDelegate(QStyledItemDelegate):
    """Tiles in the UPSCALE tab: preview with a status ribbon and size info."""
    ROLE_PIX = Qt.ItemDataRole.UserRole + 2
    ROLE_STATE = Qt.ItemDataRole.UserRole + 1
    ROLE_LABEL = Qt.ItemDataRole.UserRole + 3

    def sizeHint(self, opt: QStyleOptionViewItem, index: QModelIndex) -> QSize:  # noqa: N802
        return QSize(96, 96)

    def paint(self, p: QPainter, opt: QStyleOptionViewItem, index: QModelIndex) -> None:
        p.save()
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(opt.rect).adjusted(3, 3, -3, -3)
        state = str(index.data(self.ROLE_STATE) or TILE_PLANNED)
        g = QLinearGradient(0, r.top(), 0, r.bottom())
        g.setColorAt(0, QColor(PAL["grid_hi"])); g.setColorAt(1, QColor(PAL["grid_lo"]))
        edge = QColor(TILE_STATE_COLORS.get(state, PAL["dim"]))
        p.setPen(QPen(edge, 2 if state in (TILE_DONE, TILE_FAILED) else 1))
        p.setBrush(QBrush(g))
        p.drawRoundedRect(r, 5, 5)
        inner = r.adjusted(4, 4, -4, -18)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(PAL["grid_inner"]))
        p.drawRect(inner)
        pix = index.data(self.ROLE_PIX)
        if isinstance(pix, QPixmap) and not pix.isNull():
            scaled = pix.scaled(inner.size().toSize(), Qt.AspectRatioMode.KeepAspectRatio,
                                Qt.TransformationMode.SmoothTransformation)
            x = inner.left() + (inner.width() - scaled.width()) / 2
            y = inner.top() + (inner.height() - scaled.height()) / 2
            p.drawPixmap(int(x), int(y), scaled)
        else:
            p.setPen(QColor(PAL["dim"]))
            p.drawText(inner, Qt.AlignmentFlag.AlignCenter, "\u2026")
        label = str(index.data(self.ROLE_LABEL) or "")
        col = QColor(TILE_STATE_COLORS.get(state, PAL["dim"]))
        p.setFont(_font(7.5, True))
        p.setPen(col)
        p.drawText(QRectF(r.left() + 2, r.bottom() - 16, r.width() - 4, 14),
                   Qt.AlignmentFlag.AlignCenter, label)
        p.restore()


