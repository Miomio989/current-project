        self._schedule_save()

    def _apply_sound_ui(self) -> None:
        self.sound_master_check.blockSignals(True)
        self.sound_master_check.setChecked(SOUNDS.master)
        self.sound_master_check.blockSignals(False)
        for ev, cb in self.sound_event_checks.items():
            cb.blockSignals(True)
            cb.setChecked(SOUNDS.enabled.get(ev, True))
            cb.setEnabled(SOUNDS.master)
            cb.blockSignals(False)

    def reset_options(self) -> None:
        for k, v in DEFAULT_OPTIONS.items():
            cb = self.opt_checks.get(k)
            if cb is not None:
                cb.setChecked(v)

    # ------------------------------------------------------------------ Bridge & SillyTavern
    def _on_bridge_toggled(self, on: bool) -> None:
        if on:
            bridge = BrowserBridge(self.bridge_port_spin.value(), self.bridge_token_edit.text().strip())
            if bridge.start():
                self.bridge = bridge
                self.api.bridge = bridge
            else:
                bind_error = bridge.last_error
                self.bridge = None
                self.api.bridge = None
                self.bridge_check.setChecked(False)
                QMessageBox.warning(self, "Bridge failed", f"Could not bind the bridge port:\n{bind_error}")
        else:
            if self.bridge is not None:
                self.bridge.stop()
            self.bridge = None
            self.api.bridge = None
        self._update_server_status()
        self._update_summary()
        self._schedule_save()

    def _on_bridge_port_changed(self) -> None:
        if self.bridge_check.isChecked():
            self._on_bridge_toggled(False)
            self._on_bridge_toggled(True)
        self._schedule_save()

    def _copy_bridge_token(self) -> None:
        QApplication.clipboard().setText(self.bridge_token_edit.text().strip())
        self._flash_summary("Bridge token copied")

    def _regen_bridge_token(self) -> None:
        self.bridge_token_edit.setText(secrets.token_hex(8))
        self._schedule_save()
        if self.bridge_check.isChecked():
            self._on_bridge_toggled(False)
            self._on_bridge_toggled(True)

    def _copy_userscript(self) -> None:
        QApplication.clipboard().setText(EMBEDDED_BRIDGE_USERSCRIPT)
        self._flash_summary("Tampermonkey userscript copied to clipboard")

    def _export_userscript(self) -> None:
        path, _f = QFileDialog.getSaveFileName(
            self, "Export userscript", os.path.join(DATA_DIR, "horde_studio_bridge.user.js"),
            "Userscript (*.js)"
        )
        if path:
            if write_text(path, EMBEDDED_BRIDGE_USERSCRIPT):
                self._flash_summary(f"Exported {os.path.basename(path)}")
                STUDIO_LOG.ok("BRIDGE", f"Userscript exported: {path}")
            else:
                self._flash_summary("Export failed (cannot write file)")

    def _refresh_st_cache(self) -> None:
        self._st_state_cache = {
            "model_label": MODELS[self.current_model()]["label"],
            "models": [(name, spec["label"]) for name, spec in MODELS.items()],
            "samplers": list(self.samplers),
        }

    def _on_st_toggled(self, on: bool) -> None:
        if on:
            self.st_server = LocalStServer(
                self.st_port_spin.value(),
                lambda: self._st_state_cache,
                self._st_submit_from_http,
            )
            if not self.st_server.start():
                self.st_check.setChecked(False)
                self.st_server = None
        else:
            if self.st_server is not None:
                self.st_server.stop()
            self.st_server = None
        self._update_server_status()
        self._schedule_save()

    def _on_st_port_changed(self) -> None:
        self.st_url_edit.setText(f"http://127.0.0.1:{self.st_port_spin.value()}")
        if self.st_check.isChecked():
            self._on_st_toggled(False)
            self._on_st_toggled(True)
        self._schedule_save()

    def _st_submit_from_http(self, prompt: str) -> Dict[str, Any]:
        ev = threading.Event()
        box: Dict[str, Any] = {"event": ev, "result": {"ok": False, "error": "timed out"}}
        self._st_bridge.requested.emit(prompt, ev, box)
        ev.wait(ST_RESULT_TIMEOUT)
        return box["result"]

    def _st_enqueue_request(self, prompt: str, ev: object, box: Dict[str, Any]) -> None:
        payload, meta = self.build_payload(prompt_override=prompt, n_override=1)
        job = self.queue.enqueue(payload, meta)
        self._st_waiters[job.local_id] = box
        self.mini_queue.setVisible(True)

    def _update_server_status(self) -> None:
        if self.bridge and self.bridge.running:
            st = f"CONNECTED ({self.bridge.client_label()}, {self.bridge.served} reqs)" if self.bridge.is_connected() else f"Listening on 127.0.0.1:{self.bridge.port} — waiting for browser tab"
            self.bridge_status.setText(st)
        else:
            self.bridge_status.setText("Off.")
        if self.st_server and self.st_server.running:
            extra = f" \u2022 {self.st_server.last_request}" if self.st_server.last_request else ""
            self.st_status.setText(f"Listening on {self.st_server.address}{extra}")
        else:
            self.st_status.setText("Off.")

    # ------------------------------------------------------------------ Network Helpers
    def _run_task(self, fn: Callable[[], Any], on_done: Callable[[Any], None], on_err: Callable[[str], None]) -> None:
        th = TaskThread(fn, self)
        th.done.connect(on_done)
        th.error.connect(on_err)
        th.finished.connect(lambda t=th: self._cleanup_task(t))
        self._tasks.append(th)
        th.start()

    def _cleanup_task(self, th: TaskThread) -> None:
        if th in self._tasks:
            self._tasks.remove(th)
        th.deleteLater()

    def _refresh_key_label(self) -> None:
        self.key_label.setText(f"KEY  \u25B8  {mask_key(self.api_key)}   ({os.path.relpath(KEY_FILE, BASE_DIR)})")

    def reload_key(self) -> None:
        self.api_key = load_api_key()
        self.api.api_key = self.api_key
        self._refresh_key_label()
        self.check_account()

    def startup_network(self) -> None:
        self.refresh_horde()
        if self.api_key != ANON_KEY:
            self.check_account()

    def check_account(self) -> None:
        def _done(u: Dict[str, Any]) -> None:
            name = u.get("username") or "Anonymous"
            kudos = float(u.get("kudos") or 0.0)
            self.account_label.setText(f"{name}  \u2022  {kudos:,.0f} kudos  \u2022  trusted={u.get('trusted', False)}")
            self.chip_horde.setText(f"HORDE \u2022 {kudos:,.0f}k")
            self.chip_horde.setStyleSheet(f"color: {C['ok']}; font-weight: bold;")
            STUDIO_LOG.ok("HORDE", f"Account verified: {name} ({kudos:,.0f} kudos)")

        def _err(msg: str) -> None:
            self.account_label.setText(f"Account check failed: {msg}")
            self.chip_horde.setText("HORDE ERR")
            self.chip_horde.setStyleSheet(f"color: {C['err']}; font-weight: bold;")

        self._run_task(self.api.find_user, _done, _err)

    def refresh_horde(self) -> None:
        def _job() -> Dict[str, Any]:
            hb = self.api.heartbeat()
            mods = self.api.models()
            return {"hb": hb, "mods": mods}

        def _done(res: Dict[str, Any]) -> None:
            self.hb_label.setText(f"Horde online ({self.api.transport}) — heartbeat OK")
            by_name = {m.get("name"): m for m in (res.get("mods") or []) if isinstance(m, dict)}
            for mname, lb in self.model_status_labels.items():
                info = by_name.get(mname)
                if info:
                    lb.setText(f"{mname}: {info.get('count', 0)} worker(s), queue {info.get('queued', 0)}, ETA {info.get('eta', '?')}s")
                else:
                    lb.setText(f"{mname}: 0 active workers")
            if self.api_key == ANON_KEY:
                self.chip_horde.setText("HORDE \u2022 ANON")
                self.chip_horde.setStyleSheet(f"color: {C['info']}; font-weight: bold;")
            elif self.chip_horde.text().startswith("HORDE\u2026"):
                self.chip_horde.setText("HORDE OK")
                self.chip_horde.setStyleSheet(f"color: {C['ok']}; font-weight: bold;")

        def _err(msg: str) -> None:
            self.hb_label.setText(f"Horde unreachable: {msg}")
            self.chip_horde.setText("HORDE OFFLINE")
            self.chip_horde.setStyleSheet(f"color: {C['err']}; font-weight: bold;")

        self._run_task(_job, _done, _err)

    def load_samplers(self) -> None:
        def _done(doc: Dict[str, Any]) -> None:
            names = sorted(set(self.samplers) | set(doc.keys())) if isinstance(doc, dict) else self.samplers
            cur = self.sampler_combo.currentText()
            self.samplers = names
            self.sampler_combo.clear()
            self.sampler_combo.addItems(names)
            self._set_combo(self.sampler_combo, cur)
            self.sampler_status.setText(f"Synced {len(names)} samplers from AI Horde")
            self._refresh_st_cache()

        self._run_task(self.api.sampler_constraints, _done, lambda err: self.sampler_status.setText(f"Sync failed: {err}"))

    def dry_run(self) -> None:
        payload, _m = self.build_payload(dry_run=True)
        self.dry_label.setText("Estimating kudos\u2026")
        self._run_task(
            lambda: self.api.submit(payload),
            lambda r: self.dry_label.setText(f"Estimated cost: {float(r.get('kudos') or 0):,.1f} kudos"),
            lambda err: self.dry_label.setText(f"Estimate failed: {err}"),
        )

    # ------------------------------------------------------------------ Shutdown
    def closeEvent(self, event) -> None:  # noqa: N802
        self._server_status_timer.stop()
        self._telemetry_timer.stop()
        self._slide_timer.stop()
        self.save_now()
        self.save_llm_now()
        save_history(self.history)
        if self.bridge is not None:
            self.bridge.stop()
        if self.st_server is not None:
            self.st_server.stop()
        for w in list(self._aesthetic_workers):
            w.request_cancel()
            w.wait(500)
        self.gallery_tab.shutdown()
        for th in list(self._tasks):
            th.wait(250)
        self.queue.shutdown()
        super().closeEvent(event)


