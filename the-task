def _flare_rgb(hue: float, sat: float, val: float = 1.0) -> Tuple[int, int, int]:
    if _colorsys is None:
        return (255, 255, 255)
    h = (float(hue) % 360.0) / 360.0
    r, g, b = _colorsys.hsv_to_rgb(h, max(0.0, min(1.0, sat)), max(0.0, min(1.0, val)))
    return (int(round(r * 255)), int(round(g * 255)), int(round(b * 255)))


def _flare_qcol(hue: float, sat: float, alpha: float, lift_white: float = 0.0) -> QColor:
    r, g, b = _flare_rgb(hue, sat, 1.0)
    if lift_white > 0.0:
        w = max(0.0, min(1.0, lift_white))
        r = int(round(r + (255 - r) * w))
        g = int(round(g + (255 - g) * w))
        b = int(round(b + (255 - b) * w))
    a = max(0, min(255, int(round(alpha * 255.0))))
    return QColor(r, g, b, a)


def _draw_soft_ellipse(
    p: QPainter, cx: float, cy: float, rx: float, ry: float,
    hue: float, sat: float, alpha: float, gamma: float = 1.0, lift_white: float = 0.0,
) -> None:
    """Pure-vector smooth Gaussian-falloff horizontal ellipse — strictly 0 alpha at boundary."""
    if rx < 1.0 or ry < 1.0 or alpha <= 0.004:
        return
    p.save()
    p.translate(cx, cy)
    p.scale(1.0, max(0.008, ry / max(1.0, rx)))
    grad = QRadialGradient(QPointF(0.0, 0.0), rx)
    stops = (
        (0.00, 1.00, lift_white),
        (0.16, 0.78 ** gamma, lift_white * 0.65),
        (0.36, 0.44 ** gamma, lift_white * 0.25),
        (0.62, 0.16 ** gamma, 0.0),
        (0.84, 0.035 ** gamma, 0.0),
        (1.00, 0.00, 0.0),
    )
    for pos, k, lw in stops:
        grad.setColorAt(pos, _flare_qcol(hue, sat, alpha * k, lw))
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QBrush(grad))
    p.drawEllipse(QPointF(0.0, 0.0), rx, rx)
    p.restore()


def _draw_poly_bokeh(
    p: QPainter, cx: float, cy: float, rad: float, sides: int,
    hue: float, sat: float, alpha: float,
) -> None:
    """Soft-edged polygonal iris aperture ghost (hex / oct) in pure vector QPainterPath."""
    if rad < 2.0 or alpha <= 0.004:
        return
    poly = QPainterPath()
    for i in range(sides):
        ang = (2.0 * math.pi * i / sides) - math.pi * 0.5
        px = cx + math.cos(ang) * rad
        py = cy + math.sin(ang) * rad
        if i == 0:
            poly.moveTo(px, py)
        else:
            poly.lineTo(px, py)
    poly.closeSubpath()
    # Soft iris edge glow + inner translucent fill (true aperture ring distribution)
    g = QRadialGradient(QPointF(cx, cy), rad)
    g.setColorAt(0.00, _flare_qcol(hue, sat * 0.72, alpha * 0.46, 0.08))
    g.setColorAt(0.66, _flare_qcol(hue, sat, alpha * 0.68, 0.04))
    g.setColorAt(0.86, _flare_qcol(hue, min(1.0, sat * 1.08), alpha * 0.96, 0.15))
    g.setColorAt(0.95, _flare_qcol(hue, sat, alpha * 0.42, 0.0))
    g.setColorAt(1.00, _flare_qcol(hue, sat, 0.0, 0.0))
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QBrush(g))
    p.drawPath(poly)


def _draw_ring_bokeh(
    p: QPainter, cx: float, cy: float, rx: float, ry: float,
    hue: float, hue2: float, sat: float, alpha: float, width_frac: float = 0.16,
) -> None:
    """Hollow chromatic glass halo ring — zero border artifact, pure vector."""
    if rx < 3.0 or ry < 3.0 or alpha <= 0.004:
        return
    p.save()
    p.translate(cx, cy)
    p.scale(1.0, max(0.15, ry / max(1.0, rx)))
    w = max(0.05, min(0.32, width_frac))
    r_mid = 0.74
    g = QRadialGradient(QPointF(0.0, 0.0), rx)
    g.setColorAt(0.0, _flare_qcol(hue, sat, 0.0))
    g.setColorAt(max(0.05, r_mid - w * 1.4), _flare_qcol(hue, sat, 0.0))
    g.setColorAt(max(0.08, r_mid - w * 0.45), _flare_qcol(hue, sat, alpha * 0.65, 0.10))
    g.setColorAt(r_mid, _flare_qcol(hue, sat * 0.78, alpha, 0.22))
    g.setColorAt(min(0.94, r_mid + w * 0.55), _flare_qcol(hue2, sat, alpha * 0.68, 0.08))
    g.setColorAt(min(0.99, r_mid + w * 1.4), _flare_qcol(hue2, sat, 0.0))
    g.setColorAt(1.0, _flare_qcol(hue2, sat, 0.0))
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QBrush(g))
    p.drawEllipse(QPointF(0.0, 0.0), rx, rx)
    p.restore()


def _draw_crescent_bokeh(
    p: QPainter, cx: float, cy: float, rx: float, ry: float,
    hue: float, hue2: float, sat: float, alpha: float, flip_side: float = 1.0,
) -> None:
    """Curved lens-barrel caustic crescent arc."""
    if rx < 4.0 or ry < 4.0 or alpha <= 0.004:
        return
    p.save()
    outer = QPainterPath()
    outer.addEllipse(QPointF(cx, cy), rx, ry)
    inner = QPainterPath()
    inner.addEllipse(QPointF(cx - flip_side * rx * 0.24, cy), rx * 0.86, ry * 0.90)
    crescent = outer.subtracted(inner)
    g = QLinearGradient(cx - rx, cy, cx + rx, cy)
    g.setColorAt(0.0, _flare_qcol(hue, sat, alpha * 0.88, 0.14))
    g.setColorAt(0.5, _flare_qcol(hue2, sat, alpha * 0.62, 0.08))
    g.setColorAt(1.0, _flare_qcol(hue, sat, alpha * 0.82, 0.12))
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QBrush(g))
    p.drawPath(crescent)
    p.restore()


def render_vector_flare_layer(w: int, h: int, f: Dict[str, Any]) -> QImage:
    """Render ONE strictly-horizontal wide anamorphic vector flare into a
    black-backed ARGB32_Premultiplied light map for crisp Screen compositing.
    100% pure vector QPainter math — zero Pillow dependency, zero box edges."""
    spec = FLARE_PRESET_BY_KEY.get(str(f.get("preset") or ""), FLARE_PRESETS[0])
    w, h = max(4, int(w)), max(4, int(h))
    mwh = float(min(w, h))
    fx = max(-0.5, min(1.5, float(f.get("x", 0.5))))
    fy = max(-0.5, min(1.5, float(f.get("y", 0.5))))
    cx, cy = fx * w, fy * h

    scale_k = max(0.25, min(2.8, int(f.get("scale", 100)) / 100.0))
    stretch_k = max(0.35, min(2.8, int(f.get("stretch", 100)) / 100.0))
    gain = max(0.06, min(2.4, int(f.get("brightness", 100)) / 100.0))
    opac = max(0.05, min(1.0, int(f.get("opacity", 100)) / 100.0))
    sat_k = max(0.0, min(2.0, int(f.get("saturation", 100)) / 100.0))
    contrast = max(-100, min(100, int(f.get("contrast", 0))))
    gamma = max(0.55, min(1.85, 1.0 + contrast / 150.0))

    h1 = (float(spec.get("hue", 210)) + float(f.get("hue", 0))) % 360.0
    h2 = (float(spec.get("hue2", spec.get("hue", 210) + 32)) + float(f.get("hue2", 0))) % 360.0
    s1 = max(0.0, min(1.0, float(spec.get("sat", 0.82)) * sat_k))
    s2 = max(0.0, min(1.0, float(spec.get("sat2", s1)) * sat_k))
    chroma = float(spec.get("chroma", 0.50)) * min(1.3, sat_k)
    style = str(spec.get("streak_style", "satin"))
    eff_gain = gain * opac

    layer = QImage(w, h, QImage.Format.Format_ARGB32_Premultiplied)
    layer.fill(QColor(0, 0, 0, 0))
    p = QPainter(layer)
    p.setRenderHint(QPainter.RenderHint.Antialiasing, True)
    p.setCompositionMode(QPainter.CompositionMode.CompositionMode_Plus)

    # 1. Soft atmospheric anamorphic veiling glare (natural photographic scatter)
    veil = float(spec.get("veil", 0.16)) * eff_gain
    if veil > 0.01:
        _draw_soft_ellipse(p, cx, cy, w * 0.42 * scale_k, mwh * 0.24 * scale_k, h1, s1 * 0.70, min(0.32, veil * 0.55), gamma * 0.85)

    # 2. Primary wide horizontal anamorphic streak (strictly 0° horizontal!)
    half_len = w * 0.5 * float(spec.get("streak_len", 1.2)) * stretch_k * scale_k
    half_thk = max(2.2, w * float(spec.get("streak_thick", 0.015)) * scale_k * 1.15)
    s_str = min(1.0, float(spec.get("streak_str", 0.88)) * eff_gain)

    if half_len >= 6.0 and s_str > 0.01:
        # Outer atmospheric chromatic bloom around streak
        _draw_soft_ellipse(p, cx, cy, half_len * 1.06, half_thk * 2.45, h1 + 10.0 * chroma, s1 * 0.88, s_str * 0.26, gamma)
        _draw_soft_ellipse(p, cx, cy, half_len * 0.96, half_thk * 1.45, h1 - 8.0 * chroma, s1 * 0.92, s_str * 0.42, gamma)

        if style == "prism_split":
            # Multi-color horizontal split: left wing primary hue, right wing secondary hue + warm/cool weave
            _draw_soft_ellipse(p, cx - half_len * 0.20, cy, half_len * 0.72, half_thk * 1.35, h1, s1, s_str * 0.52, gamma)
            _draw_soft_ellipse(p, cx + half_len * 0.20, cy, half_len * 0.72, half_thk * 1.35, h2, s2, s_str * 0.52, gamma)
            _draw_soft_ellipse(p, cx, cy, half_len * 0.88, half_thk * 0.65, h1, s1 * 0.55, s_str * 0.58, gamma, 0.45)
        elif style == "harmonic":
            # Optical ribbed diffraction horizontal nodes along the bar
            _draw_soft_ellipse(p, cx, cy, half_len, half_thk * 0.95, h1, s1, s_str * 0.54, gamma)
            for node_f, node_s, use_h2 in ((0.18, 0.22, False), (0.34, 0.16, True), (0.52, 0.12, True), (0.72, 0.09, False)):
                nx = half_len * node_f
                nh = h2 if use_h2 else h1
                ns = s2 if use_h2 else s1
                _draw_soft_ellipse(p, cx - nx, cy, half_len * 0.16, half_thk * (1.2 + node_f), nh, ns, s_str * node_s, gamma)
                _draw_soft_ellipse(p, cx + nx, cy, half_len * 0.16, half_thk * (1.2 + node_f), nh, ns, s_str * node_s, gamma)
        elif style == "taper_needle":
            _draw_soft_ellipse(p, cx, cy, half_len * 1.08, half_thk * 0.62, h1, s1 * 0.82, s_str * 0.66, gamma * 1.12, 0.22)
            _draw_soft_ellipse(p, cx, cy, half_len * 0.55, half_thk * 0.34, h1, s1 * 0.35, s_str * 0.78, gamma, 0.68)
        elif style == "razor":
            _draw_soft_ellipse(p, cx, cy, half_len * 1.04, half_thk * 0.72, h1, s1, s_str * 0.64, gamma * 1.15)
            _draw_soft_ellipse(p, cx, cy, half_len * 0.64, half_thk * 0.32, h2, s2 * 0.50, s_str * 0.70, gamma, 0.55)
        elif style == "caustic_wave":
            _draw_soft_ellipse(p, cx, cy, half_len, half_thk * 1.65, h1, s1 * 0.86, s_str * 0.48, gamma * 0.90)
            _draw_soft_ellipse(p, cx, cy, half_len * 0.72, half_thk * 0.90, h2, s2 * 0.72, s_str * 0.44, gamma, 0.28)
        else:
            # Satin / dual_rail classic smooth Panavision/Sony streak
            _draw_soft_ellipse(p, cx, cy, half_len, half_thk * 1.05, h1, s1, s_str * 0.62, gamma)

        # Hot white-tinted optical filament core along the horizontal axis
        if spec.get("hot_line", True):
            _draw_soft_ellipse(p, cx, cy, half_len * 0.52, max(1.5, half_thk * 0.30), h1, s1 * 0.28, min(0.95, s_str * 0.86), max(0.65, gamma * 0.85), 0.74)

        # Dual parallel horizontal cinema rails (above/below primary streak)
        if spec.get("dual_rail"):
            dy_off = max(2.2, mwh * float(spec.get("dual_offset", 0.015)) * scale_k)
            _draw_soft_ellipse(p, cx, cy - dy_off, half_len * 0.76, max(1.6, half_thk * 0.44), h2, s2 * 0.85, s_str * 0.44, gamma)
            _draw_soft_ellipse(p, cx, cy + dy_off, half_len * 0.76, max(1.6, half_thk * 0.44), h1, s1 * 0.85, s_str * 0.44, gamma)

        # Multi-color prismatic side-wings (flanking the core horizontally)
        pw = float(spec.get("prism_wings", 0.0) or 0.0) * min(1.3, sat_k)
        if pw > 0.06:
            for side in (-1.0, 1.0):
                for hue_w, sat_w, dist_f, wf in (
                    (h1 - 36.0 * chroma, s1, 0.22, 0.22),
                    (h2, s2, 0.34, 0.26),
                    (h2 + 42.0 * chroma, s2, 0.46, 0.20),
                ):
                    wx = cx + side * half_len * dist_f
                    _draw_soft_ellipse(p, wx, cy, half_len * wf, half_thk * 1.12, hue_w, sat_w, s_str * 0.30 * pw, gamma)

    # 3. 2x Anamorphic Vertical-Oval Core Bloom + Incandescent Center
    core_str = min(1.0, float(spec.get("core_str", 0.84)) * eff_gain)
    if core_str > 0.01:
        cr = float(spec.get("core_r", 0.082)) * mwh * scale_k * 1.25
        oval = max(0.42, float(spec.get("core_oval", 0.62)))
        cw = cr * (0.88 + 0.12 * stretch_k)
        ch = cr / oval * 0.78
        _draw_soft_ellipse(p, cx, cy, cw * 1.45, ch * 1.25, h2 if spec.get("multi_color") else h1, s2 * 0.55, core_str * 0.38, gamma)
        _draw_soft_ellipse(p, cx, cy, cw, ch, h1, s1 * 0.62, core_str * 0.74, gamma, 0.24)
        _draw_soft_ellipse(p, cx, cy, cr * 0.44, cr * 0.46, h1, s1 * 0.14, min(1.0, core_str * 0.94), max(0.6, gamma * 0.82), 0.86)

    # 4. Crisp Optical Diffraction Star Glint (horizontal-balanced)
    star_rays = int(spec.get("star_rays", 0) or 0)
    if star_rays >= 4 and core_str > 0.02:
        sr = float(spec.get("core_r", 0.088)) * mwh * scale_k * 1.85
        for k_ray in range(star_rays // 2):
            ang_deg = (180.0 / (star_rays // 2)) * k_ray
            if star_rays == 4:
                ang_deg += 45.0
            elif star_rays == 6:
                ang_deg += 30.0
            p.save()
            p.translate(cx, cy)
            p.rotate(ang_deg)
            _draw_soft_ellipse(p, 0.0, 0.0, sr, max(1.4, sr * 0.055), h1, s1 * 0.34, core_str * 0.46, gamma, 0.62)
            p.restore()

    # 5. Stretched Anamorphic Lens Halo Ring
    hring = spec.get("halo_ring")
    if hring and eff_gain > 0.05:
        hr_rad, hr_w, hr_str, hr_aspect = hring
        rw = hr_rad * mwh * scale_k * hr_aspect * 1.18
        rh = hr_rad * mwh * scale_k * 1.18
        _draw_ring_bokeh(p, cx, cy, rw, rh, h1, h2, (s1 + s2) * 0.5, min(0.75, hr_str * eff_gain), max(0.08, hr_w * 5.2))

    # 6. Opposite-Axis Aperture Iris Ghosts (along optical axis through frame center)
    g_shape = str(spec.get("ghost_shape", "oval"))
    for idx_g, (t, gr, gs) in enumerate(spec.get("ghosts", [])):
        g_str = min(0.85, float(gs) * eff_gain)
        if g_str <= 0.01:
            continue
        gx = w * 0.5 - (cx - w * 0.5) * float(t)
        gy = h * 0.5 - (cy - h * 0.5) * float(t)
        g_rad = max(6.0, float(gr) * mwh * scale_k * 1.15)
        gh = (h2 + idx_g * 18.0 * chroma) % 360.0
        gsat = s2
        if g_shape == "oval":
            _draw_soft_ellipse(p, gx, gy, g_rad * 0.64, g_rad * 1.24, gh, gsat, g_str * 0.82, gamma * 0.9)
            _draw_ring_bokeh(p, gx, gy, g_rad * 0.70, g_rad * 1.30, gh, h1, gsat, g_str * 0.42, 0.16)
        elif g_shape == "hex":
            _draw_poly_bokeh(p, gx, gy, g_rad, 6, gh, gsat, g_str * 0.85)
        elif g_shape == "oct":
            _draw_poly_bokeh(p, gx, gy, g_rad, 8, gh, gsat, g_str * 0.85)
        elif g_shape == "ring":
            _draw_ring_bokeh(p, gx, gy, g_rad, g_rad * 1.12, gh, h1, gsat, g_str * 0.90, 0.18)
        elif g_shape == "crescent":
            flip = -1.0 if cx >= w * 0.5 else 1.0
            _draw_crescent_bokeh(p, gx, gy, g_rad * 0.86, g_rad * 1.14, gh, h1, gsat, g_str * 0.78, flip)
        elif g_shape == "triplet":
            # Staggered multi-color chromatic triplet bokeh
            _draw_soft_ellipse(p, gx - g_rad * 0.28, gy, g_rad * 0.62, g_rad * 1.12, h1, s1, g_str * 0.56, gamma)
            _draw_poly_bokeh(p, gx, gy, g_rad * 0.84, 6, gh, gsat, g_str * 0.68)
            _draw_ring_bokeh(p, gx + g_rad * 0.24, gy, g_rad * 0.58, g_rad * 1.02, h2, h1, s2, g_str * 0.52, 0.18)
        else:
            _draw_soft_ellipse(p, gx, gy, g_rad, g_rad, gh, gsat, g_str * 0.80, gamma)

    p.end()
    return layer


def _effective_visible_flares(flares: Optional[List[Dict[str, Any]]]) -> List[Dict[str, Any]]:
    if not flares:
        return []
    any_solo = any(bool(f.get("solo", False)) for f in flares)
    if any_solo:
        return [f for f in flares if bool(f.get("solo", False)) and bool(f.get("visible", True))]
    return [f for f in flares if bool(f.get("visible", True))]


def apply_flares_qt(img: QImage, flares: List[Dict[str, Any]]) -> QImage:
    """Screen-composite all active horizontal vector anamorphic flares onto `img`
    with per-flare LRU caching so moving one flare never re-renders the others."""
    active = _effective_visible_flares(flares)
    if img.isNull() or not active:
        return img
    out = img.convertToFormat(QImage.Format.Format_ARGB32_Premultiplied)
    w, h = out.width(), out.height()
    p = QPainter(out)
    p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform, True)
    p.setCompositionMode(QPainter.CompositionMode.CompositionMode_Screen)
    for f in active:
        ck = (
            w, h, str(f.get("preset") or ""),
            round(float(f.get("x", 0.5)), 4), round(float(f.get("y", 0.5)), 4),
            int(f.get("scale", 100)), int(f.get("brightness", 100)),
            int(f.get("saturation", 100)), int(f.get("stretch", 100)),
            int(f.get("hue", 0)), int(f.get("hue2", 0)),
            int(f.get("contrast", 0)), int(f.get("opacity", 100)),
        )
        layer = _FLARE_VEC_CACHE.get(ck)
        if layer is None:
            layer = render_vector_flare_layer(w, h, f)
            _FLARE_VEC_CACHE[ck] = layer
            while len(_FLARE_VEC_CACHE) > _FLARE_VEC_CACHE_MAX:
                _FLARE_VEC_CACHE.pop(next(iter(_FLARE_VEC_CACHE)))
        p.drawImage(0, 0, layer)
    p.end()
    return out.convertToFormat(QImage.Format.Format_RGB32)


def apply_flares_pil(pil, flares: List[Dict[str, Any]]):
    """Bridge PIL images through the exact same pure-vector QPainter flare engine."""
    if not flares or _PILImage is None:
        return pil
    q = _pil_to_qimg(pil)
    q = apply_flares_qt(q, flares)
    return _qimg_to_pil(q).convert("RGB")


# =============================================================================
#  6f. Split Studio — cut an image into two halves with an excluded middle bar
# -----------------------------------------------------------------------------
# Vertical split = LEFT + RIGHT halves; horizontal split = TOP + BOTTOM. The
# gap slider excludes a bar of exactly 1-100 px from the middle. Pure QImage
# math — available even without Pillow.
# =============================================================================
def split_image_halves(
    img: QImage, vertical: bool, gap: int,
) -> Tuple[Optional[QImage], Optional[QImage], int]:
    """Split `img` into two halves, excluding EXACTLY `gap` pixels from the
    middle. vertical=True yields (left, right); False yields (top, bottom).
    The halves are as equal as the source allows (they differ by at most 1 px
    when the span is odd), while the excluded middle bar is always precisely
    `gap` px wide. Returns (first, second, actual_gap_px)."""
    if img is None or img.isNull():
        return None, None, 0
    w, h = img.width(), img.height()
    span = w if vertical else h
    gap = max(0, min(int(gap), max(0, span // 2 - 1)))
    if vertical:
        first_w = max(1, (w - gap) // 2)
        second_w = max(1, w - gap - first_w)
        first = img.copy(0, 0, first_w, h)
        second = img.copy(w - second_w, 0, second_w, h)
        real_gap = w - first_w - second_w
    else:
        first_h = max(1, (h - gap) // 2)
        second_h = max(1, h - gap - first_h)
        first = img.copy(0, 0, w, first_h)
        second = img.copy(0, h - second_h, w, second_h)
        real_gap = h - first_h - second_h
    return first, second, real_gap


# =============================================================================
#  7. Prompt Element Tokenizer (Ctrl+Drag Tag Blocks) & Span Highlighter
# =============================================================================
@dataclass
class PromptElement:
    """One discrete prompt element separated by comma or sentence-ending dot.
    May be a single word, weighted tag, multi-word phrase, or full sentence."""
    index: int
    start: int       # inclusive char index of trimmed content start
    end: int         # exclusive char index of trimmed content end
    text: str        # trimmed element text (without trailing separator)
    sep: str         # trailing delimiter ("," or "." or "")


def parse_prompt_elements(text: str) -> List[PromptElement]:
    """Split a prompt into atomic tag/sentence elements separated by commas (,)
    or sentence-ending periods (.) while keeping decimals (1.5, v1.1), ellipses
    (...), and parenthesized weight syntax ((word:1.8)) completely intact."""
    if not text:
        return []
    n = len(text)
    elements: List[PromptElement] = []
    seg_start = 0
    paren_depth = 0
    brace_depth = 0
    bracket_depth = 0

    def _emit(end_pos: int, sep_char: str) -> None:
        raw_seg = text[seg_start:end_pos]
        lead = len(raw_seg) - len(raw_seg.lstrip(" \t\r\n"))
        trail = len(raw_seg) - len(raw_seg.rstrip(" \t\r\n"))
        t_start = seg_start + lead
        t_end = end_pos - trail
        if t_end > t_start:
            elements.append(
                PromptElement(
                    index=len(elements),
                    start=t_start,
                    end=t_end,
                    text=text[t_start:t_end],
                    sep=sep_char,
                )
            )

    i = 0
    while i < n:
        ch = text[i]
        if ch == "(":
            paren_depth += 1
        elif ch == ")" and paren_depth > 0:
            paren_depth -= 1
        elif ch == "{":
            brace_depth += 1
        elif ch == "}" and brace_depth > 0:
            brace_depth -= 1
        elif ch == "[":
            bracket_depth += 1
        elif ch == "]" and bracket_depth > 0:
            bracket_depth -= 1
        elif paren_depth == 0 and brace_depth == 0 and bracket_depth == 0:
            if ch == ",":
                _emit(i, ",")
                seg_start = i + 1
            elif ch == ".":
                prev_c = text[i - 1] if i > 0 else ""
                next_c = text[i + 1] if i + 1 < n else ""
                # Ignore decimals (1.5, v1.1), ellipses (...), and domain names (foo.com)
                is_ellipsis = prev_c == "." or next_c == "."
                is_decimal_or_token = prev_c.isdigit() and next_c.isdigit()
                is_boundary = (not next_c) or next_c.isspace()
                if is_boundary and not is_ellipsis and not is_decimal_or_token:
                    _emit(i, ".")
                    seg_start = i + 1
        i += 1
    if seg_start < n:
        _emit(n, "")
    return elements


def reorder_prompt_elements(
    text: str,
    selected_indices: Sequence[int],
    target_slot: int,
) -> Tuple[str, List[int], List[Tuple[int, int]]]:
    """Atomically move one or more prompt elements (in their relative order) to
    `target_slot` (0..len(elements)) in the original sequence.

    Returns:
        (new_text, new_selected_indices, moved_char_ranges)
    Preserves comma / sentence-dot separators cleanly with zero double commas
    or orphaned punctuation."""
    elems = parse_prompt_elements(text)
    if not elems or not selected_indices:
        return text, [], []
    valid_set = {idx for idx in selected_indices if 0 <= idx < len(elems)}
    if not valid_set:
        return text, [], []

    selected_ordered = [elems[i] for i in sorted(valid_set)]
    remaining = [e for e in elems if e.index not in valid_set]

    # Count how many remaining elements sit strictly before target_slot
    clamped_slot = max(0, min(len(elems), int(target_slot)))
    insert_at = sum(1 for e in remaining if e.index < clamped_slot)

    reordered = remaining[:insert_at] + selected_ordered + remaining[insert_at:]
    new_sel_indices = list(range(insert_at, insert_at + len(selected_ordered)))

    # Reconstruct cleanly while honoring each element's original comma/dot delimiter
    pieces: List[str] = []
    char_ranges: List[Tuple[int, int]] = []
    cursor = 0
    for pos, el in enumerate(reordered):
        is_last = pos == len(reordered) - 1
        start_c = cursor
        pieces.append(el.text)
        cursor += len(el.text)
        end_c = cursor
        if pos in new_sel_indices:
            char_ranges.append((start_c, end_c))
        if not is_last:
            delim = el.sep if el.sep in (",", ".") else ","
            joiner = f"{delim} "
            pieces.append(joiner)
            cursor += len(joiner)
        else:
            if el.sep == ".":
                pieces.append(".")
                cursor += 1
    return "".join(pieces), new_sel_indices, char_ranges


class SpanBook:
    """Tracks colored text spans inside a prompt editor (inserted Tag Groups AND
    inserted LoRA Trigger Words). Each span retains its folder highlight color
    until any character inside that exact span is modified."""

    def __init__(self) -> None:
        self.spans: List[Dict[str, Any]] = []

    def clear(self) -> None:
        self.spans.clear()

    def add(self, start: int, text: str, color: str, kind: str = "tag") -> None:
        if not text:
            return
        self.spans.append({
            "start": int(start),
            "end": int(start) + len(text),
            "text": text,
            "color": color,
            "kind": kind,
        })

    def snapshot(self) -> List[Dict[str, Any]]:
        return copy.deepcopy(self.spans)

    def restore(self, snap: List[Dict[str, Any]]) -> None:
        self.spans = copy.deepcopy(snap)


def maintain_spans(book: SpanBook, new_text: str) -> None:
    """Keep every untouched span aligned with its exact substring even when text
    before/after it changes or tags are Ctrl-dragged. Drop any span whose inner
    text was altered."""
    if not book.spans:
        return
    kept: List[Dict[str, Any]] = []
    used_intervals: List[Tuple[int, int]] = []
    for sp in book.spans:
        needle = sp.get("text") or ""
        if not needle:
            continue
        old_start = int(sp.get("start", 0))
        # Fast path: exact match at previous offset
        if new_text[old_start : old_start + len(needle)] == needle:
            pos = old_start
        else:
            # Find nearest non-overlapping exact occurrence (survives edits elsewhere & Ctrl-drag!)
            best_pos = -1
            best_dist = 10**9
            search_from = 0
            while True:
                idx = new_text.find(needle, search_from)
                if idx < 0:
                    break
                end_idx = idx + len(needle)
                overlaps = any(not (end_idx <= u0 or idx >= u1) for u0, u1 in used_intervals)
                if not overlaps:
                    dist = abs(idx - old_start)
                    if dist < best_dist:
                        best_dist = dist
                        best_pos = idx
                search_from = idx + 1
            pos = best_pos
        if pos >= 0:
            end_pos = pos + len(needle)
            used_intervals.append((pos, end_pos))
            kept.append({
                "start": pos,
                "end": end_pos,
                "text": needle,
                "color": sp["color"],
                "kind": sp.get("kind", "tag"),
            })
    book.spans = kept


class SpanHighlighter(QSyntaxHighlighter):
    """Highlights untouched Tag Group & LoRA Trigger Word spans inside QPlainTextEdit.

    v3.1: additionally renders the trailing LoRA-trigger GHOST region (the
    un-editable auto-appended trigger words) as dimmed italic "ghost text"."""

    def __init__(self, book: SpanBook, document) -> None:
        super().__init__(document)
        self.book = book
        self._ghost_start: int = -1
        self._ghost_end: int = -1

    def set_ghost_range(self, start: int, end: int) -> None:
        if start == self._ghost_start and end == self._ghost_end:
            return
        self._ghost_start = int(start)
        self._ghost_end = int(end)

    def highlightBlock(self, text: str) -> None:  # noqa: N802
        block_start = self.currentBlock().position()
        block_end = block_start + len(text)
        if self.book.spans:
            for sp in self.book.spans:
                s0, s1 = int(sp["start"]), int(sp["end"])
                if s1 <= block_start or s0 >= block_end:
                    continue
                ov_start = max(s0, block_start) - block_start
                ov_end = min(s1, block_end) - block_start
                if ov_end <= ov_start:
                    continue
                fmt = QTextCharFormat()
                col = QColor(sp["color"])
                fmt.setForeground(col)
                bg = QColor(col)
                bg.setAlpha(34 if sp.get("kind") == "lora" else 24)
                fmt.setBackground(bg)
                if sp.get("kind") == "lora":
                    fmt.setFontUnderline(True)
                    fmt.setUnderlineColor(QColor(col.red(), col.green(), col.blue(), 150))
                self.setFormat(ov_start, ov_end - ov_start, fmt)
        # Ghost (locked LoRA trigger) zone: greyed-out italic, but readable
        if self._ghost_start >= 0 and self._ghost_end > self._ghost_start:
            g0 = max(self._ghost_start, block_start) - block_start
            g1 = min(self._ghost_end, block_end) - block_start
            if g1 > g0:
                fmt = QTextCharFormat()
                fmt.setForeground(QColor(C["ghost"]))
                fmt.setFontItalic(True)
                self.setFormat(g0, g1 - g0, fmt)


