def clamp(val: float, lo: float, hi: float) -> float:
    if val < lo:
        return lo
    if val > hi:
        return hi
    return val


def clamp_int(val: int, lo: int, hi: int) -> int:
    if val < lo:
        return lo
    if val > hi:
        return hi
    return val


def lerp(a: float, b: float, t: float) -> float:
    return a + (b - a) * t


def inv_lerp(a: float, b: float, v: float) -> float:
    span = b - a
    if abs(span) < 1e-8:
        return 0.0
    return clamp((v - a) / span, 0.0, 1.0)


def smoothstep(t: float) -> float:
    u = clamp(t, 0.0, 1.0)
    return u * u * (3.0 - 2.0 * u)


def smootherstep(t: float) -> float:
    u = clamp(t, 0.0, 1.0)
    return u * u * u * (u * (u * 6.0 - 15.0) + 10.0)


def ease_out_cubic(t: float) -> float:
    u = 1.0 - clamp(t, 0.0, 1.0)
    return 1.0 - u * u * u


def ease_in_cubic(t: float) -> float:
    u = clamp(t, 0.0, 1.0)
    return u * u * u


def ease_in_out_cubic(t: float) -> float:
    u = clamp(t, 0.0, 1.0)
    if u < 0.5:
        return 4.0 * u * u * u
    v = -2.0 * u + 2.0
    return 1.0 - (v * v * v) * 0.5


def ease_out_back(t: float, overshoot: float = 1.70158) -> float:
    u = clamp(t, 0.0, 1.0) - 1.0
    return 1.0 + (overshoot + 1.0) * (u * u * u) + overshoot * (u * u)


def ease_out_expo(t: float) -> float:
    u = clamp(t, 0.0, 1.0)
    return 1.0 if u >= 1.0 else 1.0 - (2.0 ** (-10.0 * u))


def lerp_rgb(c1: RGB, c2: RGB, t: float) -> RGB:
    u = clamp(t, 0.0, 1.0)
    return (
        int(c1[0] + (c2[0] - c1[0]) * u),
        int(c1[1] + (c2[1] - c1[1]) * u),
        int(c1[2] + (c2[2] - c1[2]) * u),
    )


def lerp_rgba(c1: RGBA, c2: RGBA, t: float) -> RGBA:
    u = clamp(t, 0.0, 1.0)
    return (
        int(c1[0] + (c2[0] - c1[0]) * u),
        int(c1[1] + (c2[1] - c1[1]) * u),
        int(c1[2] + (c2[2] - c1[2]) * u),
        int(c1[3] + (c2[3] - c1[3]) * u),
    )


def sample_color_ramp(stops: Sequence[Tuple[float, RGB]], t: float) -> RGB:
    u = clamp(t, 0.0, 1.0)
    if u <= stops[0][0]:
        return stops[0][1]
    for idx in range(len(stops) - 1):
        t0, c0 = stops[idx]
        t1, c1 = stops[idx + 1]
        if u <= t1:
            span = max(1e-6, t1 - t0)
            return lerp_rgb(c0, c1, (u - t0) / span)
    return stops[-1][1]


def scale_rgb(c: RGB, factor: float) -> RGB:
    return (
        clamp_int(int(c[0] * factor), 0, 255),
        clamp_int(int(c[1] * factor), 0, 255),
        clamp_int(int(c[2] * factor), 0, 255),
    )


def add_rgb(c1: RGB, c2: RGB, weight: float = 1.0) -> RGB:
    return (
        clamp_int(int(c1[0] + c2[0] * weight), 0, 255),
        clamp_int(int(c1[1] + c2[1] * weight), 0, 255),
        clamp_int(int(c1[2] + c2[2] * weight), 0, 255),
    )


def screen_rgb(c1: RGB, c2: RGB) -> RGB:
    return (
        255 - ((255 - c1[0]) * (255 - c2[0])) // 255,
        255 - ((255 - c1[1]) * (255 - c2[1])) // 255,
        255 - ((255 - c1[2]) * (255 - c2[2])) // 255,
    )


def with_alpha(c: RGB, a: int) -> RGBA:
    return (c[0], c[1], c[2], clamp_int(a, 0, 255))


class Vec2:
    __slots__ = ("x", "y")

    def __init__(self, x: float = 0.0, y: float = 0.0) -> None:
        self.x = float(x)
        self.y = float(y)

    def __add__(self, other: "Vec2") -> "Vec2":
        return Vec2(self.x + other.x, self.y + other.y)

    def __sub__(self, other: "Vec2") -> "Vec2":
        return Vec2(self.x - other.x, self.y - other.y)

    def __mul__(self, scalar: float) -> "Vec2":
        return Vec2(self.x * scalar, self.y * scalar)

    def __rmul__(self, scalar: float) -> "Vec2":
        return Vec2(self.x * scalar, self.y * scalar)

    def __truediv__(self, scalar: float) -> "Vec2":
        inv = 1.0 / scalar if abs(scalar) > 1e-8 else 0.0
        return Vec2(self.x * inv, self.y * inv)

    def __neg__(self) -> "Vec2":
        return Vec2(-self.x, -self.y)

    def dot(self, other: "Vec2") -> float:
        return self.x * other.x + self.y * other.y

    def cross(self, other: "Vec2") -> float:
        return self.x * other.y - self.y * other.x

    def length(self) -> float:
        return math.hypot(self.x, self.y)

    def length_sq(self) -> float:
        return self.x * self.x + self.y * self.y

    def normalized(self) -> "Vec2":
        d = math.hypot(self.x, self.y)
        if d < 1e-8:
            return Vec2(1.0, 0.0)
        return Vec2(self.x / d, self.y / d)

    def perp(self) -> "Vec2":
        return Vec2(-self.y, self.x)

    def rotated(self, rad: float) -> "Vec2":
        ca = math.cos(rad)
        sa = math.sin(rad)
        return Vec2(self.x * ca - self.y * sa, self.x * sa + self.y * ca)

    def lerp(self, other: "Vec2", t: float) -> "Vec2":
        return Vec2(self.x + (other.x - self.x) * t, self.y + (other.y - self.y) * t)

    def as_int(self) -> Tuple[int, int]:
        return (int(round(self.x)), int(round(self.y)))

    def as_tuple(self) -> Pt2:
        return (self.x, self.y)


class Vec3:
    __slots__ = ("x", "y", "z")

    def __init__(self, x: float = 0.0, y: float = 0.0, z: float = 0.0) -> None:
        self.x = float(x)
        self.y = float(y)
        self.z = float(z)

    def __add__(self, o: "Vec3") -> "Vec3":
        return Vec3(self.x + o.x, self.y + o.y, self.z + o.z)

    def __sub__(self, o: "Vec3") -> "Vec3":
        return Vec3(self.x - o.x, self.y - o.y, self.z - o.z)

    def __mul__(self, s: float) -> "Vec3":
        return Vec3(self.x * s, self.y * s, self.z * s)

    def dot(self, o: "Vec3") -> float:
        return self.x * o.x + self.y * o.y + self.z * o.z

    def cross(self, o: "Vec3") -> "Vec3":
        return Vec3(
            self.y * o.z - self.z * o.y,
            self.z * o.x - self.x * o.z,
            self.x * o.y - self.y * o.x,
        )

    def length(self) -> float:
        return math.sqrt(self.x * self.x + self.y * self.y + self.z * self.z)

    def normalized(self) -> "Vec3":
        d = self.length()
        if d < 1e-8:
            return Vec3(0.0, 0.0, 1.0)
        return Vec3(self.x / d, self.y / d, self.z / d)

    def rotate_y(self, rad: float) -> "Vec3":
        c = math.cos(rad)
        s = math.sin(rad)
        return Vec3(self.x * c + self.z * s, self.y, -self.x * s + self.z * c)

    def rotate_x(self, rad: float) -> "Vec3":
        c = math.cos(rad)
        s = math.sin(rad)
        return Vec3(self.x, self.y * c - self.z * s, self.y * s + self.z * c)

    def rotate_z(self, rad: float) -> "Vec3":
        c = math.cos(rad)
        s = math.sin(rad)
        return Vec3(self.x * c - self.y * s, self.x * s + self.y * c, self.z)

    def project(self, focal: float = 360.0) -> Tuple[Vec2, float]:
        denom = max(48.0, focal - self.z)
        scale = focal / denom
        return (Vec2(self.x * scale, self.y * scale), scale)


def eval_quad_bezier(p0: Vec2, p1: Vec2, p2: Vec2, t: float) -> Vec2:
    u = 1.0 - t
    return Vec2(
        u * u * p0.x + 2.0 * u * t * p1.x + t * t * p2.x,
        u * u * p0.y + 2.0 * u * t * p1.y + t * t * p2.y,
    )


def eval_cubic_bezier(p0: Vec2, p1: Vec2, p2: Vec2, p3: Vec2, t: float) -> Vec2:
    u = 1.0 - t
    u2 = u * u
    t2 = t * t
    return Vec2(
        u2 * u * p0.x + 3.0 * u2 * t * p1.x + 3.0 * u * t2 * p2.x + t2 * t * p3.x,
        u2 * u * p0.y + 3.0 * u2 * t * p1.y + 3.0 * u * t2 * p2.y + t2 * t * p3.y,
    )


def sample_quad_bezier(p0: Vec2, p1: Vec2, p2: Vec2, steps: int = 10) -> List[Vec2]:
    return [eval_quad_bezier(p0, p1, p2, i / float(steps)) for i in range(steps + 1)]


def sample_cubic_bezier(
    p0: Vec2, p1: Vec2, p2: Vec2, p3: Vec2, steps: int = 14
) -> List[Vec2]:
    return [eval_cubic_bezier(p0, p1, p2, p3, i / float(steps)) for i in range(steps + 1)]


def sample_catmull_rom(
    pts: Sequence[Vec2], steps_per_seg: int = 6, closed: bool = False
) -> List[Vec2]:
    n = len(pts)
    if n < 2:
        return list(pts)
    if n == 2:
        return [pts[0].lerp(pts[1], i / float(steps_per_seg)) for i in range(steps_per_seg + 1)]
    out: List[Vec2] = []
    segs = n if closed else (n - 1)
    for i in range(segs):
        p0 = pts[(i - 1) % n] if closed else pts[max(0, i - 1)]
        p1 = pts[i % n]
        p2 = pts[(i + 1) % n]
        p3 = pts[(i + 2) % n] if closed else pts[min(n - 1, i + 2)]
        for s in range(steps_per_seg):
            t = s / float(steps_per_seg)
            t2 = t * t
            t3 = t2 * t
            x = 0.5 * (
                (2.0 * p1.x)
                + (-p0.x + p2.x) * t
                + (2.0 * p0.x - 5.0 * p1.x + 4.0 * p2.x - p3.x) * t2
                + (-p0.x + 3.0 * p1.x - 3.0 * p2.x + p3.x) * t3
            )
            y = 0.5 * (
                (2.0 * p1.y)
                + (-p0.y + p2.y) * t
                + (2.0 * p0.y - 5.0 * p1.y + 4.0 * p2.y - p3.y) * t2
                + (-p0.y + 3.0 * p1.y - 3.0 * p2.y + p3.y) * t3
            )
            out.append(Vec2(x, y))
    if not closed:
        out.append(pts[-1])
    return out


def build_tapered_ribbon(
    spine: Sequence[Vec2],
    widths: Sequence[float],
    asymmetry: float = 0.0,
) -> Tuple[List[Vec2], List[Vec2], List[Vec2]]:
    """
    Build left edge, right edge, and closed contour polygon along an arbitrary
    2D spine curve using smooth averaged normals.
    """
    n = len(spine)
    if n < 2:
        return ([], [], [])
    left: List[Vec2] = []
    right: List[Vec2] = []
    wl_mul = 1.0 + clamp(asymmetry, -0.6, 0.6)
    wr_mul = 1.0 - clamp(asymmetry, -0.6, 0.6)
    for i in range(n):
        if i == 0:
            tan = (spine[1] - spine[0]).normalized()
        elif i == n - 1:
            tan = (spine[-1] - spine[-2]).normalized()
        else:
            tan = (spine[i + 1] - spine[i - 1]).normalized()
        nrm = Vec2(-tan.y, tan.x)
        w = widths[min(i, len(widths) - 1)]
        left.append(spine[i] + nrm * (w * wl_mul))
        right.append(spine[i] - nrm * (w * wr_mul))
    closed_poly = left + list(reversed(right))
    return (left, right, closed_poly)


def build_anatomical_contour(
    p0: Vec2,
    p1: Vec2,
    w0: float,
    w1: float,
    bulge_l: float = 0.0,
    bulge_r: float = 0.0,
    bulge_t: float = 0.45,
    pinch_t: float = 0.78,
    pinch_amt: float = 0.0,
    steps: int = 12,
) -> List[Vec2]:
    """
    Build an organic, anatomically tapered closed silhouette (thigh, calf,
    forearm, corset torso) with asymmetric muscular curvature and joint pinch.
    """
    axis = p1 - p0
    ln = axis.length()
    if ln < 1e-4:
        return [p0 + Vec2(-w0, -w0), p0 + Vec2(w0, -w0), p0 + Vec2(w0, w0), p0 + Vec2(-w0, w0)]
    fwd = axis / ln
    nrm = Vec2(-fwd.y, fwd.x)
    left: List[Vec2] = []
    right: List[Vec2] = []
    for i in range(steps + 1):
        t = i / float(steps)
        base_w = lerp(w0, w1, smoothstep(t))
        bell = math.exp(-((t - bulge_t) / 0.28) ** 2)
        pinch = math.exp(-((t - pinch_t) / 0.16) ** 2) * pinch_amt
        wl = max(0.8, base_w + bulge_l * bell - pinch)
        wr = max(0.8, base_w + bulge_r * bell - pinch)
        c = p0 + fwd * (ln * t)
        left.append(c + nrm * wl)
        right.append(c - nrm * wr)
    # Rounded organic end caps
    cap_top = p0 - fwd * (w0 * 0.28)
    cap_bot = p1 + fwd * (w1 * 0.22)
    return [cap_top] + left + [cap_bot] + list(reversed(right))


def poly_bounds(pts: Sequence[Vec2]) -> Tuple[int, int, int, int]:
    xs = [p.x for p in pts]
    ys = [p.y for p in pts]
    return (
        int(math.floor(min(xs))),
        int(math.floor(min(ys))),
        int(math.ceil(max(xs))),
        int(math.ceil(max(ys))),
    )


def rect_intersects(a: BoxRect, b: BoxRect) -> bool:
    return (
        a.x < b.x + b.w
        and a.x + a.w > b.x
        and a.y < b.y + b.h
        and a.y + a.h > b.y
    )


def rect_overlap_center(a: BoxRect, b: BoxRect) -> Pt2:
    ox0 = max(a.x, b.x)
    oy0 = max(a.y, b.y)
    ox1 = min(a.x + a.w, b.x + b.w)
    oy1 = min(a.y + a.h, b.y + b.h)
    return ((ox0 + ox1) * 0.5, (oy0 + oy1) * 0.5)


# Deterministic Procedural Noise Library (for clouds, stone, mist, water)
def hash_2d(ix: int, iy: int, seed: int = 1666) -> float:
    n = (ix * 374761393 + iy * 668265263 + seed * 1442695041) & 0xFFFFFFFF
    n = ((n ^ (n >> 13)) * 1274126177) & 0xFFFFFFFF
    n = (n ^ (n >> 16)) & 0xFFFFFFFF
    return n / 4294967295.0


def value_noise_2d(x: float, y: float, seed: int = 1666) -> float:
    ix = int(math.floor(x))
    iy = int(math.floor(y))
    fx = smoothstep(x - ix)
    fy = smoothstep(y - iy)
    a = hash_2d(ix, iy, seed)
    b = hash_2d(ix + 1, iy, seed)
    c = hash_2d(ix, iy + 1, seed)
    d = hash_2d(ix + 1, iy + 1, seed)
    return lerp(lerp(a, b, fx), lerp(c, d, fx), fy)


def fbm_2d(x: float, y: float, octaves: int = 4, seed: int = 1666) -> float:
    val = 0.0
    amp = 0.5
    freq = 1.0
    norm = 0.0
    for o in range(octaves):
        val += amp * value_noise_2d(x * freq, y * freq, seed + o * 97)
        norm += amp
        amp *= 0.5
        freq *= 2.04
    return val / max(1e-6, norm)


def ridged_fbm_2d(x: float, y: float, octaves: int = 4, seed: int = 4096) -> float:
    val = 0.0
    amp = 0.5
    freq = 1.0
    norm = 0.0
    for o in range(octaves):
        n = value_noise_2d(x * freq, y * freq, seed + o * 131)
        ridge = 1.0 - abs(n * 2.0 - 1.0)
        val += amp * (ridge * ridge)
        norm += amp
        amp *= 0.5
        freq *= 2.1
    return val / max(1e-6, norm)


