class CombatResolver:
    """
    Resolves pushboxes, Sword Clash, Darkmoon Riposte Counter, Throw/Tech,
    Just-Deflect Parry, Guard Crush, Combo Scaling, Stylish Rank & KO Slow-Mo!
    """

    def __init__(self, moves: Dict[FighterState, MoveSpec], audio: StudioAudioEngine, vfx: VFXDirector, cam: CameraDirector, stage: DrownedCathedralStage) -> None:
        self.moves = moves
        self.audio = audio
        self.vfx = vfx
        self.cam = cam
        self.stage = stage
        self.banner_timer: float = 0.0
        self.banner_hits: int = 0
        self.banner_dmg: int = 0
        self.banner_counter: bool = False
        self.super_freeze_frames: int = 0
        self.clash_freeze_frames: int = 0

    def reset_round(self) -> None:
        self.banner_timer = 0.0
        self.banner_hits = 0
        self.banner_dmg = 0
        self.banner_counter = False
        self.super_freeze_frames = 0
        self.clash_freeze_frames = 0

    def resolve_frame(self, p1: Fighter, p2: Fighter, training_cfg: Optional[TrainingSettings] = None) -> None:
        if self.banner_timer > 0.0:
            self.banner_timer = max(0.0, self.banner_timer - FIXED_DT)

        # 1. Pushbox separation (no overlapping bodies!)
        b1, b2 = p1.get_pushbox(), p2.get_pushbox()
        if rect_intersects(b1, b2):
            c1 = b1.x + b1.w * 0.5
            c2 = b2.x + b2.w * 0.5
            overlap = (b1.w + b2.w) * 0.5 - abs(c2 - c1)
            if overlap > 0.0:
                push = overlap * 0.5 + 0.5
                if c1 <= c2:
                    p1.x = clamp(p1.x - push, STAGE_LEFT_WALL, STAGE_RIGHT_WALL)
                    p2.x = clamp(p2.x + push, STAGE_LEFT_WALL, STAGE_RIGHT_WALL)
                else:
                    p1.x = clamp(p1.x + push, STAGE_LEFT_WALL, STAGE_RIGHT_WALL)
                    p2.x = clamp(p2.x - push, STAGE_LEFT_WALL, STAGE_RIGHT_WALL)

        # 2. Simultaneous Sword Clash check (Soulcalibur / Samurai Shodown blade lock!)
        hb1 = p1.get_world_hitboxes()
        hb2 = p2.get_world_hitboxes()
        if hb1 and hb2 and p1.state != FighterState.THROW_ATTEMPT and p2.state != FighterState.THROW_ATTEMPT:
            for a in hb1:
                for b in hb2:
                    if rect_intersects(a, b):
                        cx, cy = rect_overlap_center(a, b)
                        p1.move_has_hit = True
                        p2.move_has_hit = True
                        p1.set_state(FighterState.SWORD_CLASH)
                        p2.set_state(FighterState.SWORD_CLASH)
                        p1.hitstop_frames = 14
                        p2.hitstop_frames = 14
                        p1.vx = -7.5 if p1.facing_right else 7.5
                        p2.vx = -7.5 if p2.facing_right else 7.5
                        p1.curse_gauge = min(MAX_CURSE_GAUGE, p1.curse_gauge + 12.0)
                        p2.curse_gauge = min(MAX_CURSE_GAUGE, p2.curse_gauge + 12.0)
                        self.audio.play_sfx(SFXId.SWORD_CLASH, 0.0)
                        self.vfx.spawn_shockwave(cx, cy, (255, 224, 128), 165.0)
                        self.vfx.spawn_slash_sparks(cx, cy, 28, (255, 224, 128), burst=True)
                        self.vfx.trigger_flash((255, 220, 148), 95.0)
                        self.cam.add_shake(12.0)
                        return

        # 3. Direct Weapon & Throw Hit Resolution (both directions)
        self._check_melee(p1, p2, training_cfg)
        self._check_melee(p2, p1, training_cfg)

        # 4. Cursed Projectile Hit Resolution
        for proj in self.vfx.projectiles:
            if proj.hit_cooldown > 0 or proj.hits_left <= 0:
                continue
            atk = p1 if proj.owner_slot == 0 else p2
            dfd = p2 if proj.owner_slot == 0 else p1
            p_box = BoxRect(proj.x - 34, proj.y - 54, 68, 108) if proj.kind != "SWAMP_SPIKE" else BoxRect(proj.x - 32, proj.y - 102, 64, 106)
            for hb in dfd.get_world_hurtboxes():
                if rect_intersects(p_box, hb):
                    cx, cy = rect_overlap_center(p_box, hb)
                    self._apply_attack_impact(atk, dfd, proj.spec, cx, cy, is_proj=True, training_cfg=training_cfg)
                    proj.hits_left -= 1
                    proj.hit_cooldown = 7
                    break

    def _check_melee(self, atk: Fighter, dfd: Fighter, training_cfg: Optional[TrainingSettings]) -> None:
        spec = self.moves.get(atk.state)
        if spec is None or atk.move_has_hit:
            return
        hitboxes = atk.get_world_hitboxes()
        if not hitboxes:
            return
        hurtboxes = dfd.get_world_hurtboxes()
        if not hurtboxes:
            return

        for hbox in hitboxes:
            for ubox in hurtboxes:
                if rect_intersects(hbox, ubox):
                    cx, cy = rect_overlap_center(hbox, ubox)
                    atk.move_has_hit = True
                    # Special case: Throw Attempt & Throw Tech!
                    if spec.height == AttackHeight.THROW and atk.state == FighterState.THROW_ATTEMPT:
                        if dfd.is_airborne() or dfd.is_hitstunned():
                            return
                        if dfd.state == FighterState.THROW_ATTEMPT or dfd.inp_buf.button_pressed(InputButton.THROW, 7):
                            atk.set_state(FighterState.THROW_TECH)
                            dfd.set_state(FighterState.THROW_TECH)
                            atk.vx = -8.5 if atk.facing_right else 8.5
                            dfd.vx = -8.5 if dfd.facing_right else 8.5
                            self.audio.play_sfx(SFXId.THROW_TECH, 0.0)
                            self.vfx.spawn_shockwave(cx, cy, (148, 224, 255), 110.0)
                            return
                        atk.set_state(FighterState.THROW_EXECUTE)
                        dfd.set_state(FighterState.THROWN)
                        dfd.x = atk.x + (54.0 if atk.facing_right else -54.0)
                        self.audio.play_sfx(SFXId.THROW_GRAB, atk._pan())
                        ex_spec = self.moves[FighterState.THROW_EXECUTE]
                        self._apply_damage_and_knockback(atk, dfd, ex_spec, cx, cy, counter=False)
                        return

                    # Special case: Defender in Darkmoon Riposte Counter Stance!
                    if dfd.state == FighterState.SP_RIPOSTE_STANCE and dfd.current_kf().parry_window:
                        dfd.set_state(FighterState.SP_RIPOSTE_SLASH)
                        dfd.invuln_frames = 18
                        atk.hitstop_frames = 16
                        self.audio.play_sfx(SFXId.JUST_DEFLECT, dfd._pan())
                        self.vfx.spawn_shockwave(cx, cy, (255, 224, 118), 150.0)
                        self.vfx.spawn_slash_sparks(cx, cy, 24, (255, 224, 118))
                        self.cam.add_shake(10.0)
                        return

                    self._apply_attack_impact(atk, dfd, spec, cx, cy, is_proj=False, training_cfg=training_cfg)
                    return

    def _is_blocking(self, dfd: Fighter, height: AttackHeight, training_cfg: Optional[TrainingSettings]) -> bool:
        if height in (AttackHeight.UNBLOCKABLE, AttackHeight.THROW):
            return False
        if dfd.is_hitstunned() or dfd.is_attacking():
            return False
        if training_cfg is not None and dfd.slot == 1:
            if training_cfg.dummy_mode == DummyBehavior.GUARD_ALL:
                return True
            if training_cfg.dummy_mode == DummyBehavior.GUARD_AFTER_FIRST and dfd.combo_hits_taken >= 1:
                return True
        fr = dfd.inp_buf.latest()
        np = dir_to_numpad(fr.dx, fr.dy, dfd.facing_right)
        if dfd.is_airborne():
            return np in (1, 4, 7)
        if height == AttackHeight.LOW:
            return np == 1
        if height == AttackHeight.OVERHEAD:
            return np in (4, 7)
        return np in (1, 4, 7)

    def _apply_attack_impact(
        self,
        atk: Fighter,
        dfd: Fighter,
        spec: MoveSpec,
        cx: float,
        cy: float,
        is_proj: bool,
        training_cfg: Optional[TrainingSettings],
    ) -> None:
        if not is_proj:
            atk.move_connected = True

        # Check Block & Just-Deflect Perfect Parry!
        if self._is_blocking(dfd, spec.height, training_cfg):
            if 1 <= dfd.just_guard_timer <= 5 and not dfd.is_airborne():
                # DARK SOULS / SOULCALIBUR JUST-DEFLECT PERFECT PARRY!
                dfd.set_state(FighterState.JUST_DEFLECT)
                dfd.invuln_frames = 10
                dfd.hitstop_frames = 9
                atk.hitstop_frames = 12
                dfd.curse_gauge = min(MAX_CURSE_GAUGE, dfd.curse_gauge + 16.0)
                dfd.soul_burst = min(MAX_SOUL_BURST, dfd.soul_burst + 14.0)
                dfd.guard_gauge = min(MAX_GUARD_GAUGE, dfd.guard_gauge + 18.0)
                dfd.style.register_action(FighterState.JUST_DEFLECT, 48.0, is_deflect=True)
                self.audio.play_sfx(SFXId.JUST_DEFLECT, dfd._pan())
                self.vfx.spawn_shockwave(cx, cy, (255, 224, 128), 135.0)
                self.vfx.spawn_slash_sparks(cx, cy, 22, (255, 232, 148))
                self.cam.add_shake(7.0)
                return

            # Standard Guard + Guard Gauge drain + Chip Damage
            dfd.guard_gauge = max(0.0, dfd.guard_gauge - spec.guard_damage)
            if spec.chip_damage > 0 and dfd.hp > 1:
                dfd.hp = max(1, dfd.hp - spec.chip_damage)
            atk.curse_gauge = min(MAX_CURSE_GAUGE, atk.curse_gauge + spec.curse_gain * 0.45)
            dfd.curse_gauge = min(MAX_CURSE_GAUGE, dfd.curse_gauge + 4.0)
            dfd.hitstop_frames = max(4, spec.hitstop - 2)
            if not is_proj:
                atk.hitstop_frames = max(4, spec.hitstop - 2)

            if dfd.guard_gauge <= 0.0:
                # GUARD CRUSH!
                dfd.guard_gauge = MAX_GUARD_GAUGE * 0.65
                dfd.set_state(FighterState.GUARD_CRUSH)
                dfd.hitstun_frames = 38
                dfd.vx = (-9.0 if dfd.facing_right else 9.0)
                self.audio.play_sfx(SFXId.GUARD_CRUSH, dfd._pan())
                self.vfx.spawn_shockwave(cx, cy, (255, 86, 62), 155.0)
                self.vfx.spawn_slash_sparks(cx, cy, 26, (255, 168, 86))
                self.cam.add_shake(13.0)
                return

            if dfd.is_airborne():
                dfd.set_state(FighterState.GUARD_AIR)
            elif spec.height == AttackHeight.LOW or dfd.state == FighterState.CROUCH:
                dfd.set_state(FighterState.GUARD_LOW)
            else:
                dfd.set_state(FighterState.GUARD_HIGH)
            dfd.blockstun_frames = spec.blockstun
            dfd.vx = (-spec.pushback_block if dfd.facing_right else spec.pushback_block)
            sfx_b = SFXId.BLOCK_CURSED if spec.weight.value >= 3 else (SFXId.BLOCK_HEAVY if spec.weight == AttackWeight.HEAVY else SFXId.BLOCK_LIGHT)
            self.audio.play_sfx(sfx_b, dfd._pan())
            self.vfx.spawn_shockwave(cx, cy, (112, 206, 255), 68.0)
            self.vfx.spawn_slash_sparks(cx, cy, 10, (164, 226, 255), burst=False)
            return

        # CLEAN HIT! Check Lethal Counter Hit!
        is_counter = dfd.is_attacking() or (training_cfg is not None and training_cfg.counter_hit_forced and dfd.slot == 1)
        self._apply_damage_and_knockback(atk, dfd, spec, cx, cy, counter=is_counter)

    def _apply_damage_and_knockback(
        self,
        atk: Fighter,
        dfd: Fighter,
        spec: MoveSpec,
        cx: float,
        cy: float,
        counter: bool,
    ) -> None:
        # Combo scaling proration + Overdrive damage bonus + Counter bonus!
        ov_mul = 1.18 if atk.overdrive_timer > 0.0 else 1.0
        ch_mul = 1.16 if counter else 1.0
        scale = max(0.24, dfd.combo_proration)
        dmg = max(80, int(spec.damage * scale * ov_mul * ch_mul))
        dfd.hp = max(0, dfd.hp - dmg)
        dfd.combo_hits_taken += 1
        dfd.combo_dmg_taken += dmg
        dfd.combo_proration *= spec.proration
        dfd.flash_white_frames = 4
        dfd.style.on_damaged()

        # Record for Combo Trials tracker!
        atk.last_hit_seq.append(spec.state)
        if len(atk.last_hit_seq) > 16:
            atk.last_hit_seq.pop(0)

        # Meter & Stylish Rank progression
        atk.curse_gauge = min(MAX_CURSE_GAUGE, atk.curse_gauge + spec.curse_gain)
        atk.soul_burst = min(MAX_SOUL_BURST, atk.soul_burst + spec.burst_gain)
        dfd.soul_burst = min(MAX_SOUL_BURST, dfd.soul_burst + spec.burst_gain * 1.15)
        dfd.curse_gauge = min(MAX_CURSE_GAUGE, dfd.curse_gauge + spec.curse_gain * 0.35)
        ranked_up = atk.style.register_action(spec.state, spec.style_points, is_counter=counter)
        if ranked_up:
            self.audio.play_sfx(SFXId.RANK_UP, atk._pan(), 0.72)

        # Update Dramatic Bottom Combo Banner!
        if atk.slot == 0 or dfd.combo_hits_taken >= 2 or counter:
            self.banner_timer = 2.4
            self.banner_hits = dfd.combo_hits_taken
            self.banner_dmg = dfd.combo_dmg_taken
            self.banner_counter = counter and dfd.combo_hits_taken == 1

        # Hitstop & Screen Shake (Samurai Shodown / DMC4 meaty visceral feel!)
        hs = spec.hitstop + (spec.counter_bonus_hitstop if counter else 0)
        dfd.hitstop_frames = hs
        atk.hitstop_frames = max(3, hs - 1)
        self.cam.add_shake(4.5 + spec.weight.value * 3.0 + (4.5 if counter else 0.0))

        # Knockback / Launch / Wall-Bounce / Knockdown physics!
        sgn = 1.0 if atk.facing_right else -1.0
        grav_decay = max(0.45, 1.0 - dfd.juggle_count * 0.09)
        if dfd.hp <= 0:
            dfd.set_state(FighterState.LAUNCHED)
            dfd.vx = sgn * 8.6
            dfd.vy = -12.8
            self.audio.play_sfx(SFXId.KO_THUNDER, 0.0)
            self.vfx.trigger_flash((255, 42, 62), 130.0)
            self.stage.trigger_lightning(1.0)
        elif spec.causes_wall_bounce and (counter or spec.weight.value >= 3):
            dfd.set_state(FighterState.WALL_BOUNCE)
            dfd.vx = sgn * max(9.5, spec.launch_vx * 1.45)
            dfd.vy = -8.2
            dfd.juggle_count += 1
        elif spec.launch_vy < -3.0 or dfd.is_airborne() or spec.causes_knockdown:
            dfd.set_state(FighterState.LAUNCHED if spec.launch_vy < -3.0 or dfd.is_airborne() else FighterState.KNOCKDOWN)
            dfd.vx = sgn * max(2.2, spec.launch_vx)
            dfd.vy = (spec.launch_vy if spec.launch_vy < -2.0 else -8.2) * grav_decay
            dfd.juggle_count += 1
        else:
            if spec.weight.value >= 2:
                dfd.set_state(FighterState.HIT_HEAVY)
            elif spec.height == AttackHeight.LOW:
                dfd.set_state(FighterState.HIT_LOW)
            else:
                dfd.set_state(FighterState.HIT_HIGH)
            dfd.hitstun_frames = spec.hitstun + (5 if counter else 0)
            dfd.vx = sgn * spec.pushback_hit

        # Audio & Paintery Hitsparks!
        if counter and spec.weight.value >= 2:
            self.audio.play_sfx(SFXId.HIT_LETHAL if spec.weight.value >= 3 else SFXId.HIT_COUNTER, dfd._pan())
            self.vfx.trigger_flash((255, 68, 86), 92.0)
        elif spec.weight == AttackWeight.LIGHT:
            self.audio.play_sfx(SFXId.HIT_LIGHT, dfd._pan())
        elif spec.weight == AttackWeight.MEDIUM:
            self.audio.play_sfx(SFXId.HIT_MED, dfd._pan())
        elif spec.weight == AttackWeight.HEAVY:
            self.audio.play_sfx(SFXId.HIT_HEAVY, dfd._pan())
        else:
            self.audio.play_sfx(SFXId.HIT_CURSED, dfd._pan())

        pal = CECILIA_PALETTES[atk.palette_idx % len(CECILIA_PALETTES)]
        self.vfx.spawn_slash_sparks(cx, cy, 14 + spec.weight.value * 7, pal.aura_mid, burst=True)
        self.vfx.spawn_shockwave(cx, cy, pal.rune_glow if not counter else (255, 224, 128), 72.0 + spec.weight.value * 24.0)
        if spec.weight.value >= 2:
            self.stage.spawn_water_splash(dfd.x, 0.9 + spec.weight.value * 0.25, crimson=True)


