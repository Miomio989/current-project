    # ---- extraction --------------------------------------------------------------
    def _llm_vision_extract(self) -> None:
        """Run the active vision task: DESCRIBE (t2i prompt, single line) or
        MOTION (structured Hailuo-class video prompt)."""
        if not self._llm_vision_images:
            self.llm_status.setText("Attach at least one image (drop / FROM VIEWER / PASTE) first.")
            return
        self._store_current_vision_prompt()
        model = self.llm_vision_model_combo.currentText().strip() or self.llm_model_combo.currentText().strip()
        base = self.llm_url_edit.text().strip()
        key = self.llm_key_edit.text().strip()
        images = list(self._llm_vision_images)
        if self._llm_vision_task == "motion":
            self._llm_motion_extract(base, key, model, images)
        else:
            self._llm_describe_extract(base, key, model, images)

    def _llm_describe_extract(self, base: str, key: str, model: str, images: List[str]) -> None:
        mode = self._llm_vision_mode_key
        system = self._llm_vision_prompts.get(mode) or build_default_vision_prompt(mode)
        self.llm_vision_run_btn.setEnabled(False)
        n_txt = "image" if len(images) == 1 else f"{len(images)} images"
        self.llm_status.setText(f"Vision model is captioning the {n_txt} [{VISION_MODE_LABELS[mode]}]\u2026")
        t0 = time.monotonic()

        def _job() -> str:
            data_urls = [image_to_vlm_data_url(p) for p in images]
            return llm_vision_chat(
                base, key, model, system,
                "Caption this image as ONE text-to-image prompt following your instructions exactly."
                if len(images) == 1
                else f"Caption the FIRST of the {len(images)} attached images as ONE text-to-image "
                     "prompt following your instructions exactly; use the others only as context.",
                data_urls,
                min(0.5, max(0.0, self.llm_temp_spin.value())),
                self.llm_topp_spin.value(),
            )

        def _done(reply: str) -> None:
            self.llm_vision_run_btn.setEnabled(True)
            dt = time.monotonic() - t0
            prompt = llm_single_line_prompt(reply)
            if not prompt:
                self.llm_status.setText("VLM returned an empty prompt.")
                STUDIO_LOG.warn("LLM", "Vision extraction produced no usable prompt")
                return
            self._llm_out_append(prompt)
            self.llm_status.setText(
                f"Vision prompt extracted in {dt:.1f}s [{VISION_MODE_LABELS[mode]}] "
                f"({len(prompt)} ch) - queued into the list below."
            )
            STUDIO_LOG.ok("LLM", f"Vision extraction [{mode}]: {len(prompt)} chars in {dt:.1f}s")

        def _err(msg: str) -> None:
            self.llm_vision_run_btn.setEnabled(True)
            self.llm_status.setText(f"VLM error: {msg}")

        self._run_task(_job, _done, _err)

    def _llm_motion_extract(self, base: str, key: str, model: str, images: List[str]) -> None:
        """Forge a structured MiniMax-Hailuo-class video prompt (I2VA / FL2VA /
        References) from the attached keyframe(s) + the user's concept."""
        mode = self._llm_motion_mode_key
        if mode == "fl2va" and len(images) < 2:
            self.llm_status.setText("FIRST + LAST frame mode needs TWO attached images (or switch mode).")
            return
        system = self._llm_motion_prompts.get(mode) or build_default_motion_prompt(mode)
        concept = self.llm_user_edit.toPlainText().strip()
        if not concept:
            concept = "A short, natural continuation of the attached keyframe(s) - your choice of motion; keep it tasteful and cinematic."
        n_txt = "image" if len(images) == 1 else f"{len(images)} images"
        self.llm_vision_run_btn.setEnabled(False)
        self.llm_status.setText(
            f"Forging the motion prompt [{VIDEO_MOTION_LABELS[mode]}] from {n_txt}\u2026"
        )
        t0 = time.monotonic()

        def _job() -> str:
            data_urls = [image_to_vlm_data_url(p) for p in images]
            instruction = (
                f"Active mode: {VIDEO_MOTION_LABELS[mode]}. Attached images: {len(data_urls)}. "
                f"Desired video content from the user:\n{concept}\n\n"
                "Write the final video prompt now, following your instructions exactly."
            )
            return llm_vision_chat(
                base, key, model, system, instruction, data_urls,
                min(0.8, max(0.1, self.llm_temp_spin.value())),
                self.llm_topp_spin.value(),
                timeout=300.0,
            )

        def _done(reply: str) -> None:
            self.llm_vision_run_btn.setEnabled(True)
            dt = time.monotonic() - t0
            text = _strip_code_fences(reply or "").strip()
            if text.startswith('"') and text.endswith('"'):
                text = text.strip('"').strip()
            if not text:
                self.llm_status.setText("The VLM returned an empty motion prompt.")
                STUDIO_LOG.warn("LLM", "Motion extraction produced no usable prompt")
                return
            if "integrated_multimodal_description" not in text:
                self.llm_status.setText(
                    "Motion prompt returned WITHOUT the core fields - check the system prompt "
                    "(RESET DEFAULT restores the researched template)."
                )
            self._llm_out_append(text, tag="MOTION")
            self.llm_status.setText(
                f"Motion prompt forged in {dt:.1f}s [{VIDEO_MOTION_LABELS[mode]}] "
                f"({len(text)} ch) - added to the list below (multi-line)."
            )
            STUDIO_LOG.ok("LLM", f"Motion prompt [{mode}]: {len(text)} chars in {dt:.1f}s")

        def _err(msg: str) -> None:
            self.llm_vision_run_btn.setEnabled(True)
            self.llm_status.setText(f"Motion prompt error: {msg}")

        self._run_task(_job, _done, _err)


