                bub = math.sin(t * (520.0 + 380.0 * math.sin(t * 48.0)) * math.tau) * 0.18
                env = min(1.0, t * 70.0) * math.exp(-t * (6.0 / max(0.15, dur)))
                v = (lp * 0.82 + bub) * env * gain
                sl.append(v)
                sr_v.append(v * (0.88 + 0.12 * math.cos(t * 34.0)))
            return make_sound(sl, sr_v)

        def synth_clash(dur: float, f_root: float, gain: float) -> pygame.mixer.Sound:
