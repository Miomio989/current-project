class PainterlyCGRasterizer:
    """
    Studio-grade procedural painterly CG rasterizer built on Pygame.

    Eliminates flat Flash-vector artifacts by combining:
      - Curved-volume multi-tone cel + airbrush directional gradients
      - Crimson swamp bounce-light & ambient occlusion falloff
      - Strict silhouette-clipped edge-only Blood-Moon rim-lighting
      - Anisotropic glossy anime hair highlight ribbons
      - Dimensional ruffled cloth & scalloped gothic lace bands
      - Electric multi-layer crescent slash waves with incandescent cores
      - Variable-weight colored anime ink linework (never flat raw black!)
    """

    def __init__(self) -> None:
        self._radial_add_cache: Dict[Tuple[int, RGB, int], pygame.Surface] = {}
        self._radial_alpha_cache: Dict[Tuple[int, RGB, int], pygame.Surface] = {}
        self._grain_tile: pygame.Surface = self._build_painterly_grain_tile()

    def _build_painterly_grain_tile(self) -> pygame.Surface:
        """Subtle canvas/brush micro-texture tile for painterly CG richness."""
        surf = pygame.Surface((32, 32), pygame.SRCALPHA)
        for y in range(32):
            for x in range(32):
                n = hash_2d(x, y, 7777)
                if n > 0.62:
                    surf.set_at((x, y), (255, 240, 246, int((n - 0.62) * 26)))
                elif n < 0.34:
                    surf.set_at((x, y), (24, 6, 18, int((0.34 - n) * 28)))
        return surf

    def get_radial_bloom(
        self, radius: int, color: RGB, max_alpha: int = 160, additive: bool = True
    ) -> pygame.Surface:
        r = clamp_int(int(radius), 4, 240)
        q_col = (color[0] & 0xF8, color[1] & 0xF8, color[2] & 0xF8)
        q_a = max_alpha & 0xF8
        key = (r, q_col, q_a)
        if additive:
            cached = self._radial_add_cache.get(key)
            if cached is not None:
                return cached
            d = r * 2
            surf = pygame.Surface((d, d))
            surf.fill((0, 0, 0))
            strength = q_a / 255.0
            rings = clamp_int(r, 12, 34)
            for i in range(rings, 0, -1):
                t = i / float(rings)
                rad = max(1, int(round(r * t)))
                falloff = ((1.0 - t) ** 2.4) * strength
                col = (
                    clamp_int(int(q_col[0] * falloff), 0, 255),
                    clamp_int(int(q_col[1] * falloff), 0, 255),
                    clamp_int(int(q_col[2] * falloff), 0, 255),
                )
                pygame.draw.circle(surf, col, (r, r), rad)
            if len(self._radial_add_cache) > 480:
                self._radial_add_cache.clear()
            self._radial_add_cache[key] = surf
            return surf
        else:
            cached = self._radial_alpha_cache.get(key)
            if cached is not None:
                return cached
            d = r * 2
            surf = pygame.Surface((d, d), pygame.SRCALPHA)
            rings = clamp_int(r, 8, 22)
            for i in range(rings, 0, -1):
                t = i / float(rings)
                rad = max(1, int(round(r * t)))
                a = clamp_int(int(q_a * ((1.0 - t) ** 1.65) * (2.5 / float(rings))), 1, 255)
                pygame.draw.circle(surf, (q_col[0], q_col[1], q_col[2], a), (r, r), rad)
            if len(self._radial_alpha_cache) > 360:
                self._radial_alpha_cache.clear()
            self._radial_alpha_cache[key] = surf
            return surf

    def stamp_bloom(
        self,
        dest: pygame.Surface,
        cx: float,
        cy: float,
        radius: float,
        color: RGB,
        alpha: int = 140,
        additive: bool = True,
    ) -> None:
        r = max(4, int(radius))
        stamp = self.get_radial_bloom(r, color, alpha, additive=additive)
        if additive:
            dest.blit(stamp, (int(cx) - r, int(cy) - r), special_flags=pygame.BLEND_RGB_ADD)
        else:
            dest.blit(stamp, (int(cx) - r, int(cy) - r))

    def paint_cg_poly(
        self,
        dest: pygame.Surface,
        pts: Sequence[Vec2],
        col_hi: RGB,
        col_mid: RGB,
        col_shadow: RGB,
        light_dir: Pt2 = (0.58, -0.81),
        rim_color: Optional[RGB] = None,
        rim_strength: float = 0.0,
        bounce_color: Optional[RGB] = None,
        bounce_strength: float = 0.0,
        spec_pos: Optional[Vec2] = None,
        spec_color: Optional[RGB] = None,
        spec_radius: float = 0.0,
        ink_color: Optional[RGB] = INK_OBSIDIAN,
        ink_width: float = 1.6,
        cel_cut: float = 0.44,
        volume_curve: float = 0.32,
        painterly_grain: bool = False,
        alpha: int = 255,
    ) -> None:
        """
        Render a closed sculpted vector contour with 3D-volume CG shading:
          1. Analytical directional light + curved cross-section volume shading
          2. Soft-crisp anime cel shadow terminator + optional crimson bounce
          3. Optional soft airbrush specular bloom clipped strictly inside shape
          4. Crisp 2px edge-only Blood-Moon rim-light on lit outer silhouette
          5. Subtle painterly canvas grain & variable-weight colored ink outline
        """
        if len(pts) < 3:
            return
        min_x, min_y, max_x, max_y = poly_bounds(pts)
        pad = 4
        bx = min_x - pad
        by = min_y - pad
        bw = (max_x - min_x) + pad * 2 + 1
        bh = (max_y - min_y) + pad * 2 + 1
        if bw <= 2 or bh <= 2 or bw > 1100 or bh > 1100:
            return

        local_pts = [(p.x - bx, p.y - by) for p in pts]
        int_pts = [(int(round(x)), int(round(y))) for x, y in local_pts]

        mask = pygame.Surface((bw, bh), pygame.SRCALPHA)
        pygame.draw.polygon(mask, (255, 255, 255, clamp_int(alpha, 1, 255)), int_pts)

        grad = pygame.Surface((bw, bh), pygame.SRCALPHA)
        lx, ly = light_dir
        llen = math.hypot(lx, ly)
        if llen < 1e-5:
            lx, ly = 0.58, -0.81
        else:
            lx, ly = lx / llen, ly / llen

        corners = ((0.0, 0.0), (float(bw), 0.0), (0.0, float(bh)), (float(bw), float(bh)))
        projs = [cx * lx + cy * ly for cx, cy in corners]
        p_min = min(projs)
        p_span = max(1.0, max(projs) - p_min)

        diag = math.hypot(bw, bh)
        steps = clamp_int(int(diag / 2.2), 12, 48)
        perp_x, perp_y = -ly, lx
        half_span = diag * 0.74
        thick = max(3, int(math.ceil(p_span / float(steps))) + 2)
        cx0 = bw * 0.5
        cy0 = bh * 0.5
        c_proj = cx0 * lx + cy0 * ly

        for s in range(steps + 1):
            u = s / float(steps)
            # Curved cylindrical normal response gives lush 3D roundness!
            curved_u = clamp(u + math.sin(u * math.pi) * volume_curve * 0.35 - 0.08 * volume_curve, 0.0, 1.0)
            if curved_u < cel_cut - 0.08:
                sub = clamp(curved_u / max(0.05, cel_cut), 0.0, 0.52)
                t_col = lerp_rgb(col_shadow, col_mid, sub)
                if bounce_color is not None and bounce_strength > 0.01 and u < 0.22:
                    bf = (1.0 - u / 0.22) * bounce_strength
                    t_col = lerp_rgb(t_col, bounce_color, clamp(bf, 0.0, 0.55))
            elif curved_u < cel_cut + 0.05:
                blend = smoothstep((curved_u - (cel_cut - 0.08)) / 0.13)
                t_col = lerp_rgb(lerp_rgb(col_shadow, col_mid, 0.48), col_mid, blend)
            else:
                hi_u = clamp((curved_u - cel_cut) / max(0.08, 1.0 - cel_cut), 0.0, 1.0)
                t_col = lerp_rgb(col_mid, col_hi, hi_u ** 0.84)

            proj_val = p_min + u * p_span
            delta = proj_val - c_proj
            mx = cx0 + lx * delta
            my = cy0 + ly * delta
            pa = (int(mx - perp_x * half_span), int(my - perp_y * half_span))
            pb = (int(mx + perp_x * half_span), int(my + perp_y * half_span))
            pygame.draw.line(grad, (t_col[0], t_col[1], t_col[2], 255), pa, pb, thick)

        # Curved interior shadow core glaze (elliptical 3D occlusion!)
        if volume_curve > 0.15 and bw > 14 and bh > 14:
            ao_x = int(cx0 - lx * bw * 0.22)
            ao_y = int(cy0 - ly * bh * 0.22)
            ao_r = max(6, int(min(bw, bh) * 0.45))
            self.stamp_bloom(grad, ao_x, ao_y, ao_r, col_shadow, alpha=int(72 * volume_curve), additive=False)

        if painterly_grain:
            for gy in range(0, bh, 32):
                for gx in range(0, bw, 32):
                    grad.blit(self._grain_tile, (gx, gy))

        # Soft specular airbrush sheen inside contour
        if spec_color is not None and spec_pos is not None and spec_radius > 2.5:
            self.stamp_bloom(
                grad,
                spec_pos.x - bx,
                spec_pos.y - by,
                spec_radius,
                spec_color,
                alpha=145,
                additive=True,
            )

        # True edge-only Blood-Moon rim-light strictly along light-facing contour
        if rim_color is not None and rim_strength > 0.02:
            rim_a = clamp_int(int(195 * clamp(rim_strength, 0.0, 1.0)), 14, 228)
            rim_surf = pygame.Surface((bw, bh), pygame.SRCALPHA)
            pygame.draw.polygon(rim_surf, (rim_color[0], rim_color[1], rim_color[2], rim_a), int_pts)
            shift_x = -lx * 2.6
            shift_y = -ly * 2.6
            inner_pts = [(int(round(x + shift_x)), int(round(y + shift_y))) for x, y in local_pts]
            punch = pygame.Surface((bw, bh), pygame.SRCALPHA)
            pygame.draw.polygon(punch, (0, 0, 0, 255), inner_pts)
            rim_surf.blit(punch, (0, 0), special_flags=pygame.BLEND_RGBA_SUB)
            grad.blit(rim_surf, (0, 0))

        # Clip cleanly to silhouette mask
        grad.blit(mask, (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
        dest.blit(grad, (bx, by))

        # Colored anime ink contour (clean continuous antialiased-feel stroke at 2x SS!)
        if ink_color is not None and ink_width > 0.4:
            iw = max(1, int(round(ink_width)))
            world_int = [p.as_int() for p in pts]
            pygame.draw.polygon(dest, with_alpha(ink_color, alpha), world_int, iw)

    def paint_glossy_hair_strand(
        self,
        dest: pygame.Surface,
        spine: Sequence[Vec2],
        widths: Sequence[float],
        pal: CeciliaPalette,
        sheen_u: float = 0.34,
        rim_side: float = 1.0,
        ink_width: float = 1.8,
        internal_strands: int = 2,
    ) -> None:
        """
        Render an anime CG hair ribbon with glossy violet-indigo anisotropic
        specular halo band, internal lock shadow grooves, and crimson rim light.
        """
        left, right, poly = build_tapered_ribbon(spine, widths)
        if len(poly) < 4:
            return
        self.paint_cg_poly(
            dest,
            poly,
            col_hi=pal.hair_mid,
            col_mid=pal.hair_base,
            col_shadow=pal.hair_deep,
            light_dir=(0.45 * rim_side, -0.88),
            rim_color=pal.hair_rim,
            rim_strength=0.42,
            ink_color=INK_OBSIDIAN,
            ink_width=ink_width,
            cel_cut=0.42,
            volume_curve=0.38,
        )
        n = len(spine)
        if n < 5:
            return
        # Fine internal glossy anime strand grooves
        for k in range(internal_strands):
            frac = 0.32 + 0.36 * (k / max(1, internal_strands - 1)) if internal_strands > 1 else 0.5
            groove: List[Tuple[int, int]] = []
            for i in range(1, n - 1):
                p = left[i].lerp(right[i], frac)
                groove.append(p.as_int())
            if len(groove) >= 2:
                pygame.draw.lines(dest, with_alpha(pal.hair_deep, 175), False, groove, 1)

        # Silky curved anime hair-halo gloss (follows exact Bezier strand curvature!)
        c_idx = clamp_int(int(sheen_u * (n - 1)), 1, n - 3)
        i0 = max(0, c_idx - 2)
        i1 = min(n - 1, c_idx + 2)
        for pass_w, col_s, alpha_s in (
            (3, pal.hair_sheen, 88),
            (1, screen_rgb(pal.hair_sheen, (165, 145, 205)), 145),
        ):
            hi_line: List[Tuple[int, int]] = []
            for i in range(i0, i1 + 1):
                frac = 0.34 if rim_side >= 0 else 0.66
                hi_line.append(left[i].lerp(right[i], frac).as_int())
            if len(hi_line) >= 2:
                # Subtle translucent curved sheen stroke
                min_x = min(p[0] for p in hi_line) - 4
                min_y = min(p[1] for p in hi_line) - 4
                max_x = max(p[0] for p in hi_line) + 4
                max_y = max(p[1] for p in hi_line) + 4
                bw, bh = max_x - min_x + 1, max_y - min_y + 1
                if 2 < bw < 320 and 2 < bh < 320:
                    hs = pygame.Surface((bw, bh), pygame.SRCALPHA)
                    loc = [(p[0] - min_x, p[1] - min_y) for p in hi_line]
                    pygame.draw.lines(hs, with_alpha(col_s, alpha_s), False, loc, pass_w)
                    dest.blit(hs, (min_x, min_y))

        # Luminous crimson-magenta backlight edge thread
        edge = left if rim_side >= 0.0 else right
        rim_pts = [edge[i].as_int() for i in range(1, n - 1)]
        if len(rim_pts) >= 2:
            pygame.draw.lines(dest, with_alpha(pal.hair_rim, 145), False, rim_pts, 2)

    def paint_ruffle_strip(
        self,
        dest: pygame.Surface,
        curve_pts: Sequence[Vec2],
        depth: float,
        col_hi: RGB,
        col_mid: RGB,
        col_deep: RGB,
        ink_color: RGB = INK_CRIMSON,
        scallops: int = 8,
        down_dir: Vec2 = Vec2(0.0, 1.0),
    ) -> None:
        """
        Render a lush, dimensional gothic-lolita pleated ruffle band along a
        curved hem with alternating shadow folds and bright scalloped crests.
        """
        n = len(curve_pts)
        if n < 2 or scallops < 2:
            return
        # Sample evenly along curve_pts
        dense: List[Vec2] = []
        total_segs = scallops * 2
        for i in range(total_segs + 1):
            u = i / float(total_segs)
            fidx = u * (n - 1)
            i0 = min(n - 2, int(fidx))
            frac = fidx - i0
            dense.append(curve_pts[i0].lerp(curve_pts[i0 + 1], frac))

        for s in range(scallops):
            p_a = dense[s * 2]
            p_m = dense[s * 2 + 1]
            p_b = dense[s * 2 + 2]
            # Alternating shadow/lit ruffle pleat lobes
            drop_a = down_dir * (depth * 0.78)
            drop_m = down_dir * (depth * 1.18)
            drop_b = down_dir * (depth * 0.82)
            lobe = [
                p_a,
                p_b,
                p_b + drop_b,
                p_m + drop_m,
                p_a + drop_a,
            ]
            # Subtle directional lighting variance per fold
            is_lit = (s % 2 == 0)
            c_h = col_hi if is_lit else lerp_rgb(col_mid, col_hi, 0.55)
            c_m = col_mid if is_lit else lerp_rgb(col_deep, col_mid, 0.65)
            self.paint_cg_poly(
                dest,
                lobe,
                col_hi=c_h,
                col_mid=c_m,
                col_shadow=col_deep,
                light_dir=(0.45, -0.88),
                ink_color=ink_color,
                ink_width=1.4,
                cel_cut=0.46,
                volume_curve=0.28,
            )
            # Fold crease shadow line inside pleat
            crease_top = p_a.lerp(p_b, 0.5)
            crease_bot = p_m + drop_m * 0.82
            pygame.draw.line(
                dest,
                with_alpha(col_deep, 195),
                crease_top.as_int(),
                crease_bot.as_int(),
                1,
            )

    def paint_crimson_slash_arc(
        self,
        dest: pygame.Surface,
        outer_pts: Sequence[Vec2],
        inner_pts: Sequence[Vec2],
        pal: CeciliaPalette,
        intensity: float = 1.0,
        electric_sparks: bool = True,
        hue_shift: float = 0.0,
    ) -> None:
        """
        Paint mockup.jpg-grade multi-layered electric magenta-crimson cursed
        crescent slash arc:
          1. Wide dark-blood void trail & smoky outer crimson halo
          2. Saturated magenta-crimson plasma crescent ribbon
          3. Incandescent rose-white leading razor blade edge
          4. Radiating impact sparks, arcane speed-needles, and additive bloom!
        """
        if len(outer_pts) < 3 or len(inner_pts) < 3:
            return
        o_smooth = sample_catmull_rom(outer_pts, steps_per_seg=4)
        i_smooth = sample_catmull_rom(inner_pts, steps_per_seg=4)
        n = min(len(o_smooth), len(i_smooth))
        if n < 4:
            return

        # Optional hue variation for Supers / Overdrive
        c_outer = pal.aura_outer
        c_mid = pal.aura_mid
        c_core = pal.aura_core
        if hue_shift > 0.05:
            c_mid = lerp_rgb(c_mid, (255, 196, 68), clamp(hue_shift, 0.0, 0.8))
            c_outer = lerp_rgb(c_outer, (168, 22, 196), clamp(hue_shift, 0.0, 0.8))

        full_poly = [p.as_int() for p in o_smooth[:n]] + [p.as_int() for p in reversed(i_smooth[:n])]
        min_x, min_y, max_x, max_y = poly_bounds(o_smooth[:n] + i_smooth[:n])
        pad = 22
        bx = min_x - pad
        by = min_y - pad
        bw = max_x - min_x + pad * 2 + 1
        bh = max_y - min_y + pad * 2 + 1
        if bw <= 4 or bh <= 4 or bw > 1400 or bh > 1400:
            return

        arc_surf = pygame.Surface((bw, bh), pygame.SRCALPHA)
        loc_o = [(int(p.x - bx), int(p.y - by)) for p in o_smooth[:n]]
        loc_i = [(int(p.x - bx), int(p.y - by)) for p in i_smooth[:n]]

        # Layer 1: Dark cursed crimson-black under-smoke trailing wake
        smoke_poly = loc_o + list(reversed(loc_i))
        pygame.draw.polygon(arc_surf, with_alpha(c_outer, clamp_int(int(175 * intensity), 30, 235)), smoke_poly)

        # Layer 2: Luminous layered plasma bands stepping from inner wake to razor edge
        for band_idx, (frac_lo, frac_hi, col, base_a) in enumerate((
            (0.18, 1.00, lerp_rgb(c_outer, c_mid, 0.55), 185),
            (0.46, 1.00, c_mid, 220),
            (0.74, 1.00, lerp_rgb(c_mid, c_core, 0.62), 240),
            (0.89, 1.00, c_core, 255),
        )):
            band_pts_hi: List[Tuple[int, int]] = []
            band_pts_lo: List[Tuple[int, int]] = []
            for k in range(n):
                u = k / float(max(1, n - 1))
                taper = math.sin(u * math.pi) ** 0.55
                fl = lerp(1.0, frac_lo, taper)
                p_hi = i_smooth[k].lerp(o_smooth[k], frac_hi)
                p_lo = i_smooth[k].lerp(o_smooth[k], fl)
                band_pts_hi.append((int(p_hi.x - bx), int(p_hi.y - by)))
                band_pts_lo.append((int(p_lo.x - bx), int(p_lo.y - by)))
            b_poly = band_pts_hi + list(reversed(band_pts_lo))
            pygame.draw.polygon(
                arc_surf,
                with_alpha(col, clamp_int(int(base_a * intensity), 25, 255)),
                b_poly,
            )

        # Layer 3: Sweeping internal dark blood-curls & incandescent speed streaks
        for streak in range(3):
            f_s = 0.30 + streak * 0.24
            s_pts = [
                (
                    int(i_smooth[k].lerp(o_smooth[k], f_s).x - bx),
                    int(i_smooth[k].lerp(o_smooth[k], f_s).y - by),
                )
                for k in range(1, n - 1)
            ]
            if len(s_pts) >= 2:
                sc = c_core if streak == 2 else (INK_CRIMSON if streak == 0 else c_mid)
                sa = 225 if streak == 2 else 140
                pygame.draw.lines(arc_surf, with_alpha(sc, sa), False, s_pts, 2 if streak == 2 else 1)

        # Leading razor highlight line
        pygame.draw.lines(arc_surf, with_alpha((255, 248, 252), 255), False, loc_o, 2)

        # Layer 4: Electric plasma needles & crimson sparks peeling off the slash
        if electric_sparks:
            for k in range(2, n - 2, max(2, n // 9)):
                po = o_smooth[k]
                pi = i_smooth[k]
                tan = (o_smooth[min(n - 1, k + 1)] - o_smooth[max(0, k - 1)]).normalized()
                out_n = (po - pi).normalized()
                seed_v = hash_2d(int(po.x), int(po.y), 991)
                needle_len = (10.0 + 18.0 * seed_v) * intensity
                p_start = po - out_n * 2.0
                p_end = po + out_n * (needle_len * 0.45) - tan * (needle_len * 0.85)
                pygame.draw.line(
                    arc_surf,
                    with_alpha(c_core, 220),
                    (int(p_start.x - bx), int(p_start.y - by)),
                    (int(p_end.x - bx), int(p_end.y - by)),
                    2,
                )
                pygame.draw.circle(
                    arc_surf,
                    with_alpha(c_mid, 210),
                    (int(p_end.x - bx), int(p_end.y - by)),
                    2,
                )

        dest.blit(arc_surf, (bx, by))

        # Additive optical glow pulses along the apex of the crescent
        for idx_frac in (0.28, 0.50, 0.72):
            k = clamp_int(int(idx_frac * (n - 1)), 0, n - 1)
            p_glow = i_smooth[k].lerp(o_smooth[k], 0.82)
            self.stamp_bloom(
                dest,
                p_glow.x,
                p_glow.y,
                radius=28.0 * intensity,
                color=c_mid,
                alpha=clamp_int(int(125 * intensity), 30, 180),
                additive=True,
            )


