    # ---------------------------------------------------------------- filters
    def _search_changed(self, text: str) -> None:
        self._search = " ".join(text.split()).lower()
        self._search_timer.start()

    def current_model_filter(self) -> str:
        return str(self.model_combo.currentData() or "")

    def current_score_filter(self) -> str:
        return str(self.score_combo.currentData() or "")

    def _tiles_changed(self) -> None:
        self.delegate.set_size_key(str(self.tiles_combo.currentData() or "M"))
        self._page = 0
        self.refresh(force=True)

    def tile_size_key(self) -> str:
        return self.delegate.size_key

    def set_tile_size(self, key: str) -> None:
        ix = self.tiles_combo.findData(key)
        if ix >= 0 and ix != self.tiles_combo.currentIndex():
            self.tiles_combo.setCurrentIndex(ix)
        else:
            self.delegate.set_size_key(key)
            self.refresh(force=True)

    # ---------------------------------------------------------------- data
    def _meta(self, path: str, mtime: float) -> Dict[str, Any]:
        hit = self._cache.get(path)
        if hit is not None and hit[0] == mtime:
            return hit[1]
        meta = read_image_metadata(path)
        self._cache[path] = (mtime, meta)
        if len(self._cache) > 6000:            # keep the metadata cache bounded
            for k in list(self._cache)[: len(self._cache) - 3000]:
                self._cache.pop(k, None)
        return meta

    def _scan(self) -> None:
        entries: List[Tuple[str, float]] = []
        total_bytes = 0
        try:
            names = os.listdir(OUTPUT_DIR)
        except OSError:
            names = []
        for n in names:
            if n.startswith("."):
                continue
            if not n.lower().endswith((".png", ".webp", ".jpg", ".jpeg")):
                continue
            p = os.path.join(OUTPUT_DIR, n)
            try:
                entries.append((p, os.path.getmtime(p)))
                total_bytes += os.path.getsize(p)
            except OSError:
                continue
        self._bytes = total_bytes
        self._mtimes = dict(entries)
        # --- live filters (search box + model combo + score filter) ----------
        q = self._search
        model_filter = self.current_model_filter()
        score_filter = self.current_score_filter()
        if q or model_filter or score_filter:
            kept: List[Tuple[str, float]] = []
            for p, t in entries:
                if model_filter:
                    m = self._meta(p, t)
                    if model_short(str(m.get("model", ""))) != model_filter:
                        continue
                if score_filter:
                    m = self._meta(p, t)
                    v = m.get("aesthetic")
                    if not isinstance(v, (int, float)):
                        continue
                    if score_filter != "scored" and float(v) < float(score_filter):
                        continue
                if q:
                    m = self._meta(p, t)
                    hay = (str(m.get("prompt", "")) + " " + str(m.get("raw_prompt", ""))
                           + " " + os.path.basename(p)).lower()
                    if q not in hay:
                        continue
                kept.append((p, t))
            entries = kept
        key = self.current_sort_key()
        if key == "date_desc":
            entries.sort(key=lambda e: -e[1])
        elif key == "date_asc":
            entries.sort(key=lambda e: e[1])
        elif key == "name_asc":
            entries.sort(key=lambda e: os.path.basename(e[0]).lower())
        elif key == "name_desc":
            entries.sort(key=lambda e: os.path.basename(e[0]).lower(), reverse=True)
        else:                                    # score sorts: unscored always last
            deco: List[Tuple[int, float, float, str]] = []
            for p, t in entries:
                m = self._meta(p, t)
                v = m.get("aesthetic")
                has = isinstance(v, (int, float))
                val = float(v) if has else 0.0
                deco.append((0 if has else 1, -val if key == "score_desc" else val, -t, p))
            deco.sort()
            entries = [(p, self._mtimes.get(p, t)) for (_f, _v, t, p) in deco]
        self._paths = [p for p, _t in entries]

    def _rescan(self) -> None:
        self._page = 0
        self.refresh(force=True)

    # ---------------------------------------------------------------- paging
    def page_count(self) -> int:
        ps = self.page_size()
        return max(1, (len(self._paths) + ps - 1) // ps)

    def _goto_page(self, n: int) -> None:
        n = max(0, min(int(n), self.page_count() - 1))
        if n == self._page:
            self._update_nav()
            return
        self._page = n
        self._apply_page()

    def _apply_page(self) -> None:
        ps = self.page_size()
        start = self._page * ps
        paths = self._paths[start:start + ps]
        current = None
        it = self.list.currentItem()
        if it is not None:
            current = it.data(self.ROLE_PATH)
        self.list.clear()
        self.loader.reset()
        size = QSize(*self.delegate.img_size())
        kept = None
        for p in paths:
            mtime = self._mtimes.get(p, 0.0)
            meta = self._meta(p, mtime)
            item = QListWidgetItem()
            item.setData(self.ROLE_PATH, p)
            item.setData(GalleryTileDelegate.ROLE_META, meta)
            item.setToolTip(gallery_tooltip(meta, p))
            self.list.addItem(item)
            self.loader.ask(p, size)
            if p == current:
                kept = item
        if kept is not None:
            self.list.setCurrentItem(kept)
        elif self.list.count():
            self.list.setCurrentRow(0)
        self._update_nav()

    def _update_nav(self) -> None:
        n = self.page_count()
        self.page_spin.blockSignals(True)
        self.page_spin.setRange(1, max(1, n))
        self.page_spin.setValue(self._page + 1)
        self.page_spin.blockSignals(False)
        self.page_total.setText(f"of {n}")
        self.nav_first.setEnabled(self._page > 0)
        self.nav_prev.setEnabled(self._page > 0)
        self.nav_next.setEnabled(self._page < n - 1)
        self.nav_last.setEnabled(self._page < n - 1)
        n_all = len(self._paths)
        txt = (f"{n_all} image(s) in output/  \u2022  page {self._page + 1}/{n}  \u2022  "
               f"{self.page_size()}/page  \u2022  {self._bytes / 1_048_576:.1f} MB")
        if self._search or self.current_model_filter() or self.current_score_filter():
            txt += "  \u2022  filtered"
        if self.current_sort_key().startswith("score") and n_all:
            scored = sum(1 for p in self._paths
                         if isinstance(self._meta(p, self._mtimes.get(p, 0.0)).get("aesthetic"),
                                       (int, float)))
            txt += f"  \u2022  {scored} scored (unscored at the end)"
        if not n_all:
            if self._search or self.current_model_filter() or self.current_score_filter():
                txt = "Nothing matches the current search / model / score filter."
            else:
                txt = ("output/ is empty - finished renders land here after SAVE \u25b8 OUTPUT "
                       "or with direct saving enabled")
        self._base_status = txt
        self._refresh_status_selection()

    def _refresh_status_selection(self) -> None:
        """Base status line + the dimensions of the current tile + the live
        selection count."""
        n = len(self.list.selectedItems())
        base = getattr(self, "_base_status", "")
        extra = f"  \u2022  {n} selected" if n > 1 else ""
        p, m = self._current_path_meta()
        if p and m:
            try:
                extra = f"  \u2022  {int(m.get('width', 0))}\u00d7{int(m.get('height', 0))}" + extra
            except (TypeError, ValueError):
                pass
        self.status.setText(base + extra)

    def _on_selection(self) -> None:
        sel = self.list.selectedItems()
        n = len(sel)
        self.del_btn.setEnabled(n > 0)
        self.del_btn.setText(f"DELETE ({n})" if n else "DELETE")
        self.ups_btn.setEnabled(n == 1)
        has_cur = self.list.currentItem() is not None
        self.copy_full_btn.setEnabled(has_cur)
        self.copy_uni_btn.setEnabled(has_cur)
        self.copy_img_btn.setEnabled(n == 1)
        self.copy_path_btn.setEnabled(n > 0)
        self.view_btn.setEnabled(has_cur)
        self._refresh_status_selection()

    def _on_thumb(self, rid: int, path: str, img: QImage) -> None:
        if rid != self.loader.current_gen():
            return
        for i in range(self.list.count()):
            it = self.list.item(i)
            if it.data(self.ROLE_PATH) == path:
                it.setData(GalleryTileDelegate.ROLE_PIX, QPixmap.fromImage(img))
                break
        self.list.viewport().update()

    # ---------------------------------------------------------------- public API
    def is_visible_tab(self) -> bool:
        try:
            return self.main.right_tabs.currentIndex() == 1
        except AttributeError:
            return False

    def mark_dirty(self) -> None:
        self._dirty = True
        if self.is_visible_tab():
            self._refresh_timer.start()

    def refresh_if_dirty(self) -> None:
        if self._dirty:
            self.refresh()

    def _refresh_if_visible(self) -> None:
        if self.is_visible_tab():
            self.refresh()

    def refresh(self, force: bool = False) -> None:
        if not (force or self._dirty):
            return
        self._dirty = False
        self._scan()
        self._page = max(0, min(self._page, self.page_count() - 1))
        self._apply_page()
        self._on_selection()

    def on_meta_changed(self, path: str) -> None:
        """One image's metadata changed (e.g. an aesthetic score arrived)."""
        self._cache.pop(path, None)
        try:
            self._mtimes[path] = os.path.getmtime(path)
        except OSError:
            self._mtimes.pop(path, None)
            return
        if self.is_visible_tab() and not self._dirty:
            if self.current_sort_key().startswith("score"):
                self.refresh(force=True)
                return
            for i in range(self.list.count()):
                it = self.list.item(i)
                if it.data(self.ROLE_PATH) == path:
                    meta = self._meta(path, self._mtimes[path])
                    it.setData(GalleryTileDelegate.ROLE_META, meta)
                    it.setToolTip(gallery_tooltip(meta, path))
                    break
            self.list.viewport().update()

