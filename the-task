class StylishMeter:
    """DMC4 / Bayonetta inspired Stylish Combat Rank Engine (D -> SSS).

    Rewards diverse move routing, counters, Just Guards, Darkmoon Parries,
    weapon clashes, and Blood Curse Ruptures while penalizing single-move spam.
    """

    THRESHOLDS: Tuple[Tuple[float, StyleRank], ...] = (
        (420.0, StyleRank.SSS),
        (315.0, StyleRank.SS),
        (225.0, StyleRank.S),
        (155.0, StyleRank.A),
        (100.0, StyleRank.B),
        (55.0, StyleRank.C),
        (18.0, StyleRank.D),
    )

    def __init__(self) -> None:
        self.points: float = 0.0
        self.rank: StyleRank = StyleRank.NONE
        self.recent_moves: Deque[FighterState] = collections.deque(maxlen=6)
        self.rank_flash_timer: int = 0
        self.decay_grace_timer: int = 0

    def reset(self) -> None:
        self.points = 0.0
        self.rank = StyleRank.NONE
        self.recent_moves.clear()
        self.rank_flash_timer = 0
        self.decay_grace_timer = 0

    def award_move(self, state: FighterState, base_pts: float, bonus_mult: float = 1.0) -> bool:
        """Award stylish points with move-freshness scaling; returns True if rank climbed."""
        repeats = sum(1 for m in self.recent_moves if m == state)
        freshness = 1.0 / (1.0 + repeats * 0.72)
        gain = base_pts * freshness * bonus_mult
        self.recent_moves.append(state)
        return self.award_raw(gain)

    def award_raw(self, pts: float) -> bool:
        old_tier = self.rank.tier
        self.points = clamp(self.points + pts, 0.0, 520.0)
        self.decay_grace_timer = 110
        self._recompute_rank()
        if self.rank.tier > old_tier:
            self.rank_flash_timer = 26
            return True
        return False

    def penalize_hit(self) -> None:
        self.points = max(0.0, self.points * 0.42 - 25.0)
        self._recompute_rank()

    def tick(self) -> None:
        if self.rank_flash_timer > 0:
            self.rank_flash_timer -= 1
        if self.decay_grace_timer > 0:
            self.decay_grace_timer -= 1
        elif self.points > 0.0:
            decay = 0.24 + self.rank.tier * 0.09
            self.points = max(0.0, self.points - decay)
            self._recompute_rank()

    def _recompute_rank(self) -> None:
        new_rank = StyleRank.NONE
        for thresh, r in self.THRESHOLDS:
            if self.points >= thresh:
                new_rank = r
                break
        self.rank = new_rank

    @property
    def next_rank_progress(self) -> float:
        if self.rank == StyleRank.SSS:
            return 1.0
        low = 0.0
        high = 18.0
        for idx, (th, r) in enumerate(reversed(self.THRESHOLDS)):
            if r.tier == self.rank.tier:
                low = th
            elif r.tier == self.rank.tier + 1:
                high = th
                break
        return inv_lerp(low, high, self.points)


class Fighter:
    """Complete deterministic 2D fighting-game character entity for Cecilia Darkmoon."""

    def __init__(
        self,
        player_idx: int,
        name: str,
        palette_idx: int = 0,
        max_hp: int = MAX_HP,
    ) -> None:
        self.player_idx = player_idx
        self.name = name
        self.palette_idx = palette_idx % len(CECILIA_PALETTES)
        self.max_hp = max_hp

        # Spatial & physics state
        self.x: float = STAGE_CENTER_X + (-260.0 if player_idx == 0 else 260.0)
        self.y: float = GROUND_Y
        self.vx: float = 0.0
        self.vy: float = 0.0
        self.facing_right: bool = (player_idx == 0)

        # State machine
        self.state: FighterState = FighterState.IDLE
        self.state_tick: int = 0
        self.is_ex_move: bool = False
        self.move_has_connected: bool = False
        self.move_was_blocked: bool = False
        self.hits_landed_ids: Set[int] = set()
        self.projectile_spawned: bool = False
        self.swing_sfx_played: bool = False
        self.floor_crack_spawned: bool = False

        # Core combat resources
        self.hp: int = max_hp
        self.display_red_hp: float = float(max_hp)   # Delayed trauma bleed bar
        self.super_meter: float = 100.0              # Start with 1 Soul Stock ready
        self.resonance_gauge: float = 50.0           # Builds from combat; activates at 100%
        self.resonance_active: bool = False
        self.resonance_timer: int = 0
        self.guard_gauge: float = MAX_GUARD_GAUGE
        self.blood_curse: float = 0.0                # 0..100; ruptures at 100!
        self.stun_gauge: float = 0.0
        self.stun_decay_delay: int = 0

        # Hitstun / Blockstun / Juggle / Wakeup timers
        self.stun_timer: int = 0
        self.knockdown_timer: int = 0
        self.invuln_timer: int = 0
        self.hitflash_timer: int = 0
        self.hitshake_x: float = 0.0
        self.back_hold_frames: int = 0               # Tracks exact timing for 4f Just Guard
        self.juggle_hits: int = 0
        self.has_groundbounced: bool = False
        self.has_wallbounced: bool = False
        self.pending_jump_dir: int = 0
        self.throw_victim: Optional["Fighter"] = None
        self.throw_tech_timer: int = 0
        self.in_throw_lock: bool = False

        # Combo tracking (as attacker)
        self.combo_count: int = 0
        self.combo_damage: int = 0
        self.combo_proration: float = 1.0
        self.combo_display_timer: int = 0
        self.last_combo_moves: List[FighterState] = []

        # Stylish Combat Rank & Match Stats
        self.stylish = StylishMeter()
        self.stats = MatchStats()
        self.rounds_won: int = 0

        # Training Mode real-time Frame Data Timeline (45-frame ring buffer)
        # Codes: '.' neutral, 'S' startup, 'A' active, 'R' recovery, 'H' hitstun, 'B' blockstun, 'I' invuln
        self.frame_timeline: Deque[str] = collections.deque(["."] * 45, maxlen=45)
        self.last_move_spec: Optional[MoveSpec] = None
        self.last_frame_advantage: int = 0
        self.step_sound_cd: int = 0

    @property
    def grounded(self) -> bool:
        return self.y >= GROUND_Y - 0.5 and self.vy >= 0.0

    @property
    def alive(self) -> bool:
        return self.hp > 0

    @property
    def current_move(self) -> Optional[MoveSpec]:
        return MOVE_REGISTRY.get(self.state)

    @property
    def is_attacking(self) -> bool:
        return self.state in MOVE_REGISTRY

    @property
    def is_in_hitstun(self) -> bool:
        return self.state in (
            FighterState.HITSTUN_HIGH,
            FighterState.HITSTUN_LOW,
            FighterState.HITSTUN_LAUNCH,
            FighterState.HITSTUN_WALLBOUNCE,
            FighterState.KNOCKDOWN,
            FighterState.DIZZY_STUN,
            FighterState.GUARD_CRUSH,
        )

    @property
    def is_blocking(self) -> bool:
        return self.state in (
            FighterState.GUARD_STAND,
            FighterState.GUARD_CROUCH,
            FighterState.GUARD_AIR,
            FighterState.JUST_GUARD,
        )

    @property
    def is_neutral_movable(self) -> bool:
        return self.state in (
            FighterState.IDLE,
            FighterState.WALK_FWD,
            FighterState.WALK_BACK,
            FighterState.DASH_FWD,
            FighterState.CROUCH_TRANS,
            FighterState.CROUCH_IDLE,
        )

    @property
    def is_air_movable(self) -> bool:
        return self.state in (
            FighterState.JUMP_RISE,
            FighterState.JUMP_APEX,
            FighterState.JUMP_FALL,
        )

    def reset_for_round(self, start_x: float, facing_right: bool, keep_meter: bool = True) -> None:
        self.x = start_x
        self.y = GROUND_Y
        self.vx = 0.0
        self.vy = 0.0
        self.facing_right = facing_right
        self.hp = self.max_hp
        self.display_red_hp = float(self.max_hp)
        if not keep_meter:
            self.super_meter = 100.0
            self.resonance_gauge = 50.0
        else:
            self.super_meter = max(self.super_meter, 100.0)
            self.resonance_gauge = max(self.resonance_gauge, 50.0)
        self.resonance_active = False
        self.resonance_timer = 0
        self.guard_gauge = MAX_GUARD_GAUGE
        self.blood_curse = 0.0
        self.stun_gauge = 0.0
        self.stun_timer = 0
        self.knockdown_timer = 0
        self.invuln_timer = 0
        self.hitflash_timer = 0
        self.hitshake_x = 0.0
        self.juggle_hits = 0
        self.has_groundbounced = False
        self.has_wallbounced = False
        self.combo_count = 0
        self.combo_damage = 0
        self.combo_proration = 1.0
        self.combo_display_timer = 0
        self.last_combo_moves.clear()
        self.throw_victim = None
        self.in_throw_lock = False
        self.stylish.reset()
        self.frame_timeline = collections.deque(["."] * 45, maxlen=45)
        self.enter_state(FighterState.IDLE)

    def enter_state(self, new_state: FighterState, is_ex: bool = False) -> None:
        self.state = new_state
        self.state_tick = 0
        self.is_ex_move = is_ex
        self.move_has_connected = False
        self.move_was_blocked = False
        self.hits_landed_ids.clear()
        self.projectile_spawned = False
        self.swing_sfx_played = False
        self.floor_crack_spawned = False
        if new_state in MOVE_REGISTRY:
            self.last_move_spec = MOVE_REGISTRY[new_state]
            if new_state == FighterState.OVERDRIVE_ACTIVATE:
                self.activate_resonance()
            elif self.last_move_spec.meter_cost > 0.0:
                self.super_meter = max(0.0, self.super_meter - self.last_move_spec.meter_cost)
            elif is_ex and self.super_meter >= 50.0:
                self.super_meter = max(0.0, self.super_meter - 50.0)

    def activate_resonance(self) -> None:
        """Enter ecstatic Cursed Resonance Overdrive (or Flash Cancel if already active)."""
        if not self.resonance_active:
            self.resonance_active = True
            self.resonance_timer = RESONANCE_DURATION_FRAMES
            self.resonance_gauge = 0.0
            self.guard_gauge = MAX_GUARD_GAUGE
        else:
            # Mid-Resonance Flash Cancel costs 50% Soul Meter
            self.super_meter = max(0.0, self.super_meter - 50.0)
            self.resonance_timer = min(RESONANCE_DURATION_FRAMES, self.resonance_timer + 60)

    def is_strike_invulnerable(self) -> bool:
        if self.invuln_timer > 0 or self.in_throw_lock:
            return True
        if self.state in (FighterState.BACKSTEP, FighterState.WAKEUP_ROLL, FighterState.WAKEUP_RISE):
            return self.state_tick < 11
        spec = self.current_move
        if spec is not None:
            i0, i1 = spec.invuln_frames
            if i0 <= self.state_tick < i1:
                return True
        return False

    def is_anti_air_invulnerable(self) -> bool:
        spec = self.current_move
        if spec is not None:
            a0, a1 = spec.anti_air_invuln
            if a0 <= self.state_tick < a1:
                return True
        return False

    def has_hyper_armor(self) -> bool:
        spec = self.current_move
        if spec is not None:
            a0, a1 = spec.armor_frames
            if a0 <= self.state_tick < a1:
                return True
        return False

    def is_parry_active(self) -> bool:
        if self.state != FighterState.SPECIAL_CURSED_PARRY:
            return False
        spec = MOVE_REGISTRY[FighterState.SPECIAL_CURSED_PARRY]
        return spec.startup <= self.state_tick < (spec.startup + spec.active)

    def get_hurtboxes_world(self) -> List[Tuple[float, float, float, float]]:
        if self.state in (FighterState.KNOCKDOWN, FighterState.DEFEAT_POSE):
            boxes = HURTBOX_KNOCKDOWN
        elif self.state in (
            FighterState.CROUCH_TRANS,
            FighterState.CROUCH_IDLE,
            FighterState.GUARD_CROUCH,
            FighterState.ATTACK_2L,
            FighterState.ATTACK_2M,
        ):
            boxes = HURTBOX_CROUCHING
        elif not self.grounded:
            boxes = HURTBOX_AIRBORNE
        else:
            boxes = HURTBOX_STANDING
        return [b.to_world(self.x, self.y, self.facing_right) for b in boxes]

    def get_pushbox_world(self) -> Tuple[float, float, float, float]:
        if not self.grounded:
            box = PUSHBOX_AIRBORNE
        elif self.state in (FighterState.CROUCH_IDLE, FighterState.GUARD_CROUCH, FighterState.ATTACK_2L, FighterState.ATTACK_2M):
            box = PUSHBOX_CROUCHING
        else:
            box = PUSHBOX_STANDING
        return box.to_world(self.x, self.y, self.facing_right)

    def get_active_hit_windows(self) -> List[HitWindow]:
        spec = self.current_move
        if spec is None:
            return []
        active: List[HitWindow] = []
        for w in spec.windows:
            if w.start_frame <= self.state_tick < w.end_frame and w.hit_id not in self.hits_landed_ids:
                active.append(w)
        return active

    def get_hud_expression(self) -> ExpressionId:
        """Drive Cecilia's live HUD portrait expression dynamically from battle state."""
        if not self.alive or self.state == FighterState.DEFEAT_POSE:
            return ExpressionId.CLOSED_EYES_CALM
        if self.is_in_hitstun:
            return ExpressionId.GRITTED_PAIN
        if self.resonance_active or self.state in (
            FighterState.SUPER_ECLIPSE_REQUIEM,
            FighterState.FATAL_CRIMSON_JUDGMENT,
            FighterState.OVERDRIVE_ACTIVATE,
        ):
            return ExpressionId.ECSTATIC_TRANCE
        if self.is_attacking:
            return ExpressionId.FIERCE_STRIKE
        if self.hp < self.max_hp * 0.28:
            return ExpressionId.FOCUSED_GLARE
        if self.stylish.rank.tier >= 5 or self.state == FighterState.VICTORY_POSE:
            return ExpressionId.BOLD_SMIRK
        return ExpressionId.SERENE_NOBLE

    def get_current_frame_code(self) -> str:
        """Single-character frame state code for Training Lab Frame Timeline."""
        if self.is_strike_invulnerable():
            return "I"
        if self.is_in_hitstun:
            return "H"
        if self.is_blocking:
            return "B"
        spec = self.current_move
        if spec is not None:
            if self.state_tick < spec.startup:
                return "S"
            if self.state_tick < spec.startup + spec.active:
                return "A"
            return "R"
        return "."

    def can_cancel_into(self, target_state: FighterState) -> bool:
        """Check whether current attack state may cancel cleanly into `target_state`."""
        spec = self.current_move
        if spec is None:
            return False

        # Cursed Resonance Flash Cancel: cancel ANY move on hit or block into neutral burst!
        if target_state == FighterState.OVERDRIVE_ACTIVATE and (self.move_has_connected or self.move_was_blocked):
            if self.resonance_gauge >= MAX_RESONANCE or (self.resonance_active and self.super_meter >= 50.0):
                return True

        # Rekka follow-ups allowed even on whiff near recovery window or immediately on contact
        if self.state == FighterState.SPECIAL_PHANTOM_REKKA_1 and target_state == FighterState.SPECIAL_PHANTOM_REKKA_2:
            return (self.move_has_connected or self.move_was_blocked) or self.state_tick >= spec.startup + 2
        if self.state == FighterState.SPECIAL_PHANTOM_REKKA_2 and target_state == FighterState.SPECIAL_PHANTOM_REKKA_3:
            return (self.move_has_connected or self.move_was_blocked) or self.state_tick >= spec.startup + 2

        if self.move_has_connected and target_state in spec.cancel_on_hit:
            return True
        if self.move_was_blocked and target_state in spec.cancel_on_block:
            return True

        # During Cursed Resonance Overdrive, normal-to-normal gatling chains are expanded!
        if self.resonance_active and self.move_has_connected and target_state in MOVE_REGISTRY:
            t_spec = MOVE_REGISTRY[target_state]
            if t_spec.category in (MoveCategory.SPECIAL, MoveCategory.SUPER, MoveCategory.FATAL):
                return True
        return False

    def try_process_input(
        self,
        buf: InputBuffer,
        opponent: "Fighter",
        simple_mode: bool,
        audio: AudioManager,
    ) -> Optional[FighterState]:
        """Process fighter input buffer for movement, jumping, dashing, and attacks.

        Returns the newly triggered attack FighterState if a Special/Super/Attack
        was initiated (used by CombatResolver & Super Choreographer).
        """
        if self.in_throw_lock or not self.alive:
            return None

        cur = buf.current
        # Track exact back-hold duration for 4-frame Just Guard window
        if buf.is_holding_back():
            self.back_hold_frames = min(120, self.back_hold_frames + 1)
        else:
            self.back_hold_frames = 0

        # Wakeup Roll option on final knockdown frames
        if self.state == FighterState.KNOCKDOWN and self.knockdown_timer <= 8:
            if buf.is_holding_forward() or buf.is_holding_back():
                roll_dir = 1.0 if buf.is_holding_forward() else -1.0
                self.vx = roll_dir * (1.0 if self.facing_right else -1.0) * 11.5
                self.invuln_timer = 14
                self.enter_state(FighterState.WAKEUP_ROLL)
                return None

        # Throw tech check when grabbed within window
        if self.throw_tech_timer > 0:
            if (buf.was_pressed(InputButton.L, 3) and bool(cur.held & InputButton.M)) or (
                buf.was_pressed(InputButton.M, 3) and bool(cur.held & InputButton.L)
            ):
                return FighterState.THROW_TECH

        if self.is_in_hitstun or self.is_blocking or self.state in (
            FighterState.BACKSTEP,
            FighterState.WAKEUP_ROLL,
            FighterState.WAKEUP_RISE,
            FighterState.JUMP_START,
            FighterState.LAND,
            FighterState.CLASH_RECOIL,
            FighterState.THROW_EXECUTE,
            FighterState.THROW_TECH,
            FighterState.INTRO_POSE,
            FighterState.VICTORY_POSE,
            FighterState.DEFEAT_POSE,
        ):
            return None

        # Detect any attack / special / super command from input buffer
        cmd = buf.detect_command_move(
            grounded=self.grounded,
            super_meter=self.super_meter,
            resonance_gauge=self.resonance_gauge,
            resonance_active=self.resonance_active,
            current_state=self.state,
            simple_mode=simple_mode,
        )

        # Jump Cancel check on hit for 5L, 5M, 2H (BlazBlue aerial rave!)
        if self.is_attacking and self.grounded and self.move_has_connected:
            spec = self.current_move
            if spec is not None and spec.jump_cancelable_on_hit and buf.is_holding_up():
                self.pending_jump_dir = 1 if buf.is_holding_forward() else (-1 if buf.is_holding_back() else 0)
                self.enter_state(FighterState.JUMP_START)
                audio.play_sfx(SFXId.JUMP_SWISH, vol_scale=0.8)
                return None

        if cmd is not None:
            target_st, is_ex = cmd
            if self.is_neutral_movable or self.is_air_movable or self.state == FighterState.TAUNT:
                self.enter_state(target_st, is_ex=is_ex)
                return target_st
            if self.is_attacking and self.can_cancel_into(target_st):
                self.enter_state(target_st, is_ex=is_ex)
                return target_st

        # Movement & Neutral State Transitions
        if self.is_neutral_movable:
            # Update facing toward opponent whenever neutral on ground
            self.facing_right = opponent.x >= self.x

            # Jump initiation (7, 8, 9)
            if buf.is_holding_up():
                self.pending_jump_dir = 1 if buf.is_holding_forward() else (-1 if buf.is_holding_back() else 0)
                self.enter_state(FighterState.JUMP_START)
                audio.play_sfx(SFXId.JUMP_SWISH, vol_scale=0.8)
                return None

            # Dash Forward (66 or Shift+Forward/Neutral)
            dash_macro = buf.was_pressed(InputButton.DASH, 3)
            if (dash_macro and not buf.is_holding_back()) or (
                self.state != FighterState.DASH_FWD and buf.check_double_tap(6, 12) and buf.is_holding_forward()
            ):
                self.enter_state(FighterState.DASH_FWD)
                audio.play_sfx(SFXId.JUMP_SWISH, vol_scale=0.65)
                return None

            # Backstep Evasion (44 or Shift+Back)
            if (dash_macro and buf.is_holding_back()) or (
                buf.check_double_tap(4, 12) and buf.is_holding_back()
            ):
                self.vx = (-1.0 if self.facing_right else 1.0) * BACKSTEP_SPEED
                self.vy = -5.6
                self.invuln_timer = 10
                self.enter_state(FighterState.BACKSTEP)
                audio.play_sfx(SFXId.JUMP_SWISH, vol_scale=0.75)
                return None

            # Keep sprinting while holding forward in Dash
            if self.state == FighterState.DASH_FWD:
                if buf.is_holding_forward() or bool(cur.held & InputButton.DASH):
                    speed = DASH_FWD_SPEED * (1.14 if self.resonance_active else 1.0)
                    self.vx = (1.0 if self.facing_right else -1.0) * speed
                    return None
                self.enter_state(FighterState.IDLE)

            # Crouch
            if buf.is_holding_down():
                self.vx *= 0.65
                if self.state not in (FighterState.CROUCH_TRANS, FighterState.CROUCH_IDLE):
                    self.enter_state(FighterState.CROUCH_TRANS)
                return None

            # Walk Forward / Backward
            if buf.is_holding_forward():
                speed = WALK_FWD_SPEED * (1.12 if self.resonance_active else 1.0)
                self.vx = (1.0 if self.facing_right else -1.0) * speed
                if self.state != FighterState.WALK_FWD:
                    self.enter_state(FighterState.WALK_FWD)
                return None

            if buf.is_holding_back():
                speed = WALK_BACK_SPEED * (1.08 if self.resonance_active else 1.0)
                self.vx = (-1.0 if self.facing_right else 1.0) * speed
                if self.state != FighterState.WALK_BACK:
                    self.enter_state(FighterState.WALK_BACK)
                return None

            # Return to noble Idle stance
            self.vx *= 0.60
            if self.state != FighterState.IDLE:
                self.enter_state(FighterState.IDLE)

        return None

    def tick_physics_and_state(
        self,
        opponent: "Fighter",
        audio: AudioManager,
        stage: CursedCathedralStage,
    ) -> None:
        """Advance deterministic 60Hz physics, timers, resource decay, and state progression."""
        self.state_tick += 1

        # Record Training Mode frame timeline snapshot
        self.frame_timeline.append(self.get_current_frame_code())

        # Timers & Resource updates
        if self.invuln_timer > 0:
            self.invuln_timer -= 1
        if self.hitflash_timer > 0:
            self.hitflash_timer -= 1
        if self.throw_tech_timer > 0:
            self.throw_tech_timer -= 1
        if self.combo_display_timer > 0:
            self.combo_display_timer -= 1
        if self.step_sound_cd > 0:
            self.step_sound_cd -= 1

        self.hitshake_x *= -0.68
        if abs(self.hitshake_x) < 0.35:
            self.hitshake_x = 0.0

        # Smoothly bleed delayed red trauma HP bar toward actual HP
        if self.display_red_hp > self.hp:
            if not self.is_in_hitstun:
                self.display_red_hp = max(float(self.hp), self.display_red_hp - 36.0)
        else:
            self.display_red_hp = float(self.hp)

        # Cursed Resonance Overdrive duration & subtle gothic regeneration
        if self.resonance_active:
            self.resonance_timer -= 1
            if self.alive and self.hp < self.max_hp and (self.resonance_timer % 12 == 0):
                self.hp = min(self.max_hp, self.hp + 18)
            if self.resonance_timer <= 0:
                self.resonance_active = False
                self.resonance_timer = 0
        else:
            # Slow passive Blood Curse & Guard Integrity recovery when not actively hit/blocking
            if not self.is_blocking and self.guard_gauge < MAX_GUARD_GAUGE:
                self.guard_gauge = min(MAX_GUARD_GAUGE, self.guard_gauge + 0.14)
            if self.blood_curse > 0.0 and not self.is_in_hitstun:
                self.blood_curse = max(0.0, self.blood_curse - 0.08)

        if self.stun_decay_delay > 0:
            self.stun_decay_delay -= 1
        elif self.stun_gauge > 0.0 and self.state != FighterState.DIZZY_STUN:
            self.stun_gauge = max(0.0, self.stun_gauge - 0.25)

        self.stylish.tick()
        if self.stylish.rank.tier > self.stats.highest_rank.tier:
            self.stats.highest_rank = self.stylish.rank

        # Wet stone footsteps during Walk/Dash
        if self.state in (FighterState.WALK_FWD, FighterState.WALK_BACK, FighterState.DASH_FWD) and self.step_sound_cd == 0:
            self.step_sound_cd = 12 if self.state == FighterState.DASH_FWD else 19
            audio.play_sfx(SFXId.STEP_STONE, vol_scale=0.32)

        # ----------------------------------------------------------------------
        # State-specific progression & move physics
        # ----------------------------------------------------------------------
        if self.in_throw_lock:
            return

        if self.state == FighterState.CROUCH_TRANS and self.state_tick >= 3:
            self.enter_state(FighterState.CROUCH_IDLE)

        elif self.state == FighterState.JUMP_START and self.state_tick >= 4:
            self.vy = JUMP_VEL_Y
            if self.pending_jump_dir > 0:
                self.vx = (1.0 if self.facing_right else -1.0) * JUMP_VEL_X_FWD
            elif self.pending_jump_dir < 0:
                self.vx = (1.0 if self.facing_right else -1.0) * JUMP_VEL_X_BACK
            else:
                self.vx *= 0.4
            self.y = GROUND_Y - 1.0
            self.enter_state(FighterState.JUMP_RISE)

        elif self.state == FighterState.JUMP_RISE and self.vy > -3.5:
            self.enter_state(FighterState.JUMP_APEX)

        elif self.state == FighterState.JUMP_APEX and self.vy > 3.5:
            self.enter_state(FighterState.JUMP_FALL)

        elif self.state == FighterState.LAND:
            self.vx *= 0.65
            if self.state_tick >= 4:
                self.enter_state(FighterState.IDLE)

        elif self.state == FighterState.BACKSTEP:
            self.vx *= 0.93
            if self.state_tick >= 15 and self.grounded:
                self.enter_state(FighterState.IDLE)

        elif self.state == FighterState.TAUNT:
            self.vx *= 0.78
            if self.state_tick == 6:
                audio.play_sfx(SFXId.TAUNT_CHIME, vol_scale=0.8)
                self.stylish.award_raw(20.0)
                self.resonance_gauge = min(MAX_RESONANCE, self.resonance_gauge + 8.0)
            if self.state_tick >= 29:
                self.enter_state(FighterState.IDLE)

        elif self.state == FighterState.CLASH_RECOIL:
            self.vx *= 0.84
            if self.state_tick >= 12:
                self.enter_state(FighterState.IDLE)

        elif self.state == FighterState.THROW_TECH:
            self.vx *= 0.85
            if self.state_tick >= 14:
                self.enter_state(FighterState.IDLE)

        elif self.state == FighterState.THROW_EXECUTE:
            self.vx *= 0.75
            if self.state_tick >= 28:
                self.enter_state(FighterState.IDLE)

        elif self.is_blocking:
            self.vx *= 0.82
            self.stun_timer -= 1
            if self.stun_timer <= 0:
                if self.grounded:
                    self.enter_state(FighterState.CROUCH_IDLE if self.state == FighterState.GUARD_CROUCH else FighterState.IDLE)
                else:
                    self.enter_state(FighterState.JUMP_FALL)

        elif self.state in (FighterState.HITSTUN_HIGH, FighterState.HITSTUN_LOW, FighterState.GUARD_CRUSH, FighterState.DIZZY_STUN):
            self.vx *= 0.84
            self.stun_timer -= 1
            if self.stun_timer <= 0:
                if not self.alive:
                    self.enter_state(FighterState.DEFEAT_POSE)
                else:
                    if self.state == FighterState.DIZZY_STUN:
                        self.stun_gauge = 0.0
                    self.enter_state(FighterState.IDLE)

        elif self.state in (FighterState.HITSTUN_LAUNCH, FighterState.HITSTUN_WALLBOUNCE):
            self.vx *= 0.985
            if self.state == FighterState.HITSTUN_WALLBOUNCE and self.state_tick >= 7:
                self.state = FighterState.HITSTUN_LAUNCH

        elif self.state == FighterState.KNOCKDOWN:
            self.vx *= 0.82
            self.knockdown_timer -= 1
            if self.knockdown_timer <= 0:
                if not self.alive:
                    self.enter_state(FighterState.DEFEAT_POSE)
                else:
                    self.invuln_timer = WAKEUP_INVULN_FRAMES
                    self.enter_state(FighterState.WAKEUP_RISE)

        elif self.state == FighterState.WAKEUP_ROLL:
            self.vx *= 0.90
            if self.state_tick >= 12:
                self.facing_right = opponent.x >= self.x
                self.enter_state(FighterState.IDLE)

        elif self.state == FighterState.WAKEUP_RISE:
            self.vx *= 0.75
            if self.state_tick >= 11:
                self.facing_right = opponent.x >= self.x
                self.enter_state(FighterState.IDLE)

        elif self.is_attacking:
            spec = MOVE_REGISTRY[self.state]
            # Play sword swing whoosh cleanly at late startup
            if not self.swing_sfx_played and self.state_tick >= max(1, spec.startup - 2):
                self.swing_sfx_played = True
                audio.play_sfx(spec.sfx_swing, vol_scale=0.85)

            # Heavy slam stone crack decal on cathedral causeway
            if spec.causes_floor_crack and not self.floor_crack_spawned and self.state_tick == spec.startup + 2:
                self.floor_crack_spawned = True
                crack_x = self.x + (132.0 if self.facing_right else -132.0)
                stage.add_stone_crack(crack_x, intensity=1.15)

            # Lunge movement impulses authored per move
            lunge_applied = False
            for f0, f1, lvx, lvy in spec.lunge_windows:
                if f0 <= self.state_tick < f1:
                    self.vx = (1.0 if self.facing_right else -1.0) * lvx
                    if lvy != 0.0 and self.state_tick == f0:
                        self.vy = lvy
                        if lvy < 0.0:
                            self.y = min(self.y, GROUND_Y - 2.0)
                    lunge_applied = True
                    break
            if not lunge_applied and self.grounded:
                self.vx *= 0.76

            # Complete attack recovery
            if self.state_tick >= spec.total_frames:
                if self.grounded:
                    self.facing_right = opponent.x >= self.x
                    self.enter_state(FighterState.IDLE)
                else:
                    self.enter_state(FighterState.JUMP_FALL)

        # ----------------------------------------------------------------------
        # Integrate 2D Position, Gravity, Ground Contact, Groundbounce & Walls
        # ----------------------------------------------------------------------
        if not self.grounded or self.vy < 0.0:
            grav = GRAVITY_BASE + (self.juggle_hits * GRAVITY_JUGGLE_STEP if self.state == FighterState.HITSTUN_LAUNCH else 0.0)
            self.vy += grav

        self.x += self.vx
        self.y += self.vy

        # Stage Iron Gate Wall boundaries + Wallbounce trigger!
        if self.x < STAGE_LEFT_WALL:
            self.x = STAGE_LEFT_WALL
            if self.state == FighterState.HITSTUN_LAUNCH and self.vx < -9.5 and not self.has_wallbounced:
                self.has_wallbounced = True
                self.vx = 9.5
                self.vy = -12.5
                self.enter_state(FighterState.HITSTUN_WALLBOUNCE)
                audio.play_sfx(SFXId.WALLBOUNCE_SLAM, vol_scale=0.95)
            else:
                self.vx = max(0.0, self.vx)
        elif self.x > STAGE_RIGHT_WALL:
            self.x = STAGE_RIGHT_WALL
            if self.state == FighterState.HITSTUN_LAUNCH and self.vx > 9.5 and not self.has_wallbounced:
                self.has_wallbounced = True
                self.vx = -9.5
                self.vy = -12.5
                self.enter_state(FighterState.HITSTUN_WALLBOUNCE)
                audio.play_sfx(SFXId.WALLBOUNCE_SLAM, vol_scale=0.95)
            else:
                self.vx = min(0.0, self.vx)

        # Ground contact handling (Landing, Aerial Cancel, Groundbounce, Knockdown)
        if self.y >= GROUND_Y:
            self.y = GROUND_Y
            if self.vy > 0.0:
                impact_vy = self.vy
                self.vy = 0.0
                if self.state in (FighterState.HITSTUN_LAUNCH, FighterState.HITSTUN_WALLBOUNCE):
                    if not self.alive:
                        audio.play_sfx(SFXId.KNOCKDOWN_THUD, vol_scale=1.0)
                        stage.add_stone_crack(self.x, 0.9)
                        self.enter_state(FighterState.DEFEAT_POSE)
                    elif self.has_groundbounced and impact_vy > 11.0:
                        # Single cinematic groundbounce per combo!
                        self.has_groundbounced = False
                        self.vy = -13.2
                        self.vx *= 0.45
                        audio.play_sfx(SFXId.WALLBOUNCE_SLAM, vol_scale=0.85)
                        stage.add_stone_crack(self.x, 0.9)
                    else:
                        audio.play_sfx(SFXId.KNOCKDOWN_THUD, vol_scale=0.9)
                        self.knockdown_timer = 26
                        self.juggle_hits = 0
                        self.has_wallbounced = False
                        self.enter_state(FighterState.KNOCKDOWN)
                elif self.state in (
                    FighterState.JUMP_RISE,
                    FighterState.JUMP_APEX,
                    FighterState.JUMP_FALL,
                    FighterState.ATTACK_JL,
                    FighterState.ATTACK_JM,
                    FighterState.ATTACK_JH,
                ):
                    audio.play_sfx(SFXId.LAND_SPLASH, vol_scale=0.65)
                    self.facing_right = opponent.x >= self.x
                    self.enter_state(FighterState.LAND)
                elif self.state == FighterState.GUARD_AIR:
                    self.enter_state(FighterState.GUARD_STAND)
                elif self.state == FighterState.BACKSTEP:
                    audio.play_sfx(SFXId.LAND_SPLASH, vol_scale=0.55)
                    self.enter_state(FighterState.IDLE)

        # Reset opponent's combo counter cleanly when victim leaves hitstun
        if not self.is_in_hitstun and not self.in_throw_lock:
            self.juggle_hits = 0
            self.has_wallbounced = False
            self.has_groundbounced = False
            if opponent.combo_count > 0:
                opponent.combo_count = 0
                opponent.combo_damage = 0
                opponent.combo_proration = 1.0
                opponent.last_combo_moves.clear()

