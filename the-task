class InputButton(enum.IntFlag):
    NONE = 0
    A = 1 << 0          # Light Slash
    B = 1 << 1          # Medium Sweep
    C = 1 << 2          # Heavy Cleave
    D = 1 << 3          # Cursed Arts
    THROW = 1 << 4      # Throw macro (or A+D)
    SHADOW = 1 << 5     # Shadow Cancel macro (or A+B)
    ECLIPSE = 1 << 6    # Eclipse Overdrive macro (or A+B+C)
    TAUNT = 1 << 7


@dataclass
class InputFrame:
    numpad: int = 5           # 1..9 facing-relative fighting-game numpad notation!
    raw_dx: int = 0
    raw_dy: int = 0
    held: InputButton = InputButton.NONE
    pressed: InputButton = InputButton.NONE


@dataclass
class KeyBindings:
    left: int
    right: int
    up: int
    down: int
    btn_a: int
    btn_b: int
    btn_c: int
    btn_d: int
    btn_throw: int
    btn_shadow: int
    btn_eclipse: int
    btn_taunt: int


def default_p1_bindings() -> KeyBindings:
    return KeyBindings(
        left=pygame.K_a, right=pygame.K_d, up=pygame.K_w, down=pygame.K_s,
        btn_a=pygame.K_u, btn_b=pygame.K_i, btn_c=pygame.K_o, btn_d=pygame.K_j,
        btn_throw=pygame.K_k, btn_shadow=pygame.K_l, btn_eclipse=pygame.K_h, btn_taunt=pygame.K_t,
