    def _edit_reset_rotate(self) -> None:
        self.edit_canvas.set_rot_angle(0.0)

    # ---- v4.2: smart undo + WYSIWYG working image ------------------------------------
    def _edit_undo_smart(self) -> None:
        """Ctrl+Z: first undo the newest paint/mask stroke or lasso op; when
        no stroke history is left, undo the last baked APPLY / crop / tilt."""
        if self.edit_canvas.undo_last_stroke():
            self._sync_poly_labels()
            self._flash_summary("Stroke undone")
            return
        self.edit_undo()

    def _edit_escape_key(self) -> None:
        """Esc from anywhere on the stage: cancel lasso drawing, discard the
        finished selection, or drop the crop frame — in that priority."""
        if self.edit_canvas.poly_drawing():
            self.edit_canvas.cancel_poly()
        elif self.edit_canvas.has_poly():
            self.edit_poly_discard()
        elif self.edit_canvas._tool == EditCanvas.TOOL_CROP:
            self.edit_canvas.clear_crop()
            self._on_edit_crop_changed()

    def _edit_working_image(self) -> Optional[QImage]:
        """The document exactly as shown on the stage: the base with the
        retouch-stroke layer composited on top. Used by SAVE / INPAINT /
        SPLIT so every export is what-you-see-is-what-you-get."""
        if self.edit_base is None or self.edit_base.isNull():
            return None
        paint = self.edit_canvas.paint_layer()
        if paint is None or not self.edit_canvas.has_paint():
            return self.edit_base
        out = self.edit_base.convertToFormat(QImage.Format.Format_ARGB32_Premultiplied)
        p = QPainter(out)
        p.drawImage(0, 0, paint)
        p.end()
        return out

