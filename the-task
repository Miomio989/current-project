    pygame.quit()
    return 0


def main() -> int:
    args = sys.argv[1:]
    if "--smoke-test" in args or "--dump-screens" in args:
        dump_dir: Optional[str] = None
        if "--dump-screens" in args:
            idx = args.index("--dump-screens")
            dump_dir = args[idx + 1] if (idx + 1 < len(args)) else "/tmp/nny_screens"
        return run_qa_smoke_test(dump_dir)

    app = NoroiNoYaibaApp(headless=False)
    app.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
