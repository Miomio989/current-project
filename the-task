    def _draw_hp_overlay_clean(
        self,
        surf: pygame.Surface,
        rect: pygame.Rect,
        hp_ratio: float,
        red_ratio: float,
        c_left: RGB,
        c_right: RGB,
        reverse: bool,
    ) -> None:
        """Render clean translucent trauma + main HP layering so delayed damage bar shines clearly."""
        x, y, w, h = rect.x, rect.y, rect.w, rect.h
        s = 12

        def spoly(rx: float, rw: float) -> List[Tuple[float, float]]:
            if not reverse:
                return [(rx + s, y), (rx + rw + s, y), (rx + rw, y + h), (rx, y + h)]
            return [(rx, y), (rx + rw, y), (rx + rw + s, y + h), (rx + s, y + h)]

        usable = float(w - s)
        bg = spoly(float(x), usable)
        pygame.draw.polygon(surf, (18, 8, 20), bg)

        # Red delayed trauma strip
        rw_r = usable * red_ratio
        if rw_r > 1.5:
            sx = float(x) if not reverse else float(x + usable - rw_r)
            pygame.draw.polygon(surf, (176, 16, 36), spoly(sx, rw_r))

        # Active HP gradient
        fw = usable * hp_ratio
        if fw > 1.5:
            steps = max(4, min(22, int(fw // 14) + 1))
            seg_w = fw / float(steps)
            start_x = float(x) if not reverse else float(x + usable - fw)
            for i in range(steps):
                t = i / float(max(1, steps - 1))
                col = lerp_color(c_left, c_right, t if not reverse else (1.0 - t))
                pygame.draw.polygon(surf, col, spoly(start_x + i * seg_w, seg_w + 1.0))

        pygame.draw.polygon(surf, UI_BORDER_DARK, bg, 3)
        pygame.draw.polygon(surf, UI_BORDER_SILVER, bg, 1)

    def _render_bottom_meters(
