class IgnitionGenerateButton(QPushButton):
    """High-craft East-Asian 'ENGAGE / SORTIE / GACHA' style Generate button.
    Features a sculpted chamfered metallic bezel, 4-stop luminous liquid gloss,
    a curved late-2000s Aqua/PSP specular reflection, corner tactical brackets,
    an embedded vector ignition crystal, a sweeping diagonal sheen, a live
    in-flight queue counter chip, and a press-state mechanical snap."""

    def __init__(self, text: str = "GENERATE", parent: Optional[QWidget] = None) -> None:
        super().__init__(text, parent)
        self.setMinimumHeight(54)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
        self._sub_text = "KREA 2  \u2022  \u00d71  \u2022  CTRL+ENTER"
        self._active_badge = ""
        self._in_flight = 0
        self._sheen_pos = -0.35
        self._hovered = False
        self._hover_glow = 0.0
        self._sheen_timer = QTimer(self)
        self._sheen_timer.setInterval(38)
        self._sheen_timer.timeout.connect(self._tick_sheen)
        self._idle_pulse = QTimer(self)
        self._idle_pulse.setInterval(5200)
        self._idle_pulse.timeout.connect(self._trigger_sheen)
        self._idle_pulse.start()
        self._glow_timer = QTimer(self)
        self._glow_timer.setInterval(40)
        self._glow_timer.timeout.connect(self._tick_glow)

    def set_sub_info(self, sub_text: str, active_badge: str = "") -> None:
        if sub_text != self._sub_text or active_badge != self._active_badge:
            self._sub_text = sub_text
            self._active_badge = active_badge
            self.update()

    def set_in_flight(self, count: int) -> None:
        count = max(0, int(count))
        if count != self._in_flight:
            self._in_flight = count
            self.update()

    def _trigger_sheen(self) -> None:
        if not self.isVisible() or not self.isEnabled():
            return
        win = self.window()
        if win is not None and not win.isActiveWindow():
            return
        self._sheen_pos = -0.30
        if not self._sheen_timer.isActive():
            self._sheen_timer.start()

    def _tick_sheen(self) -> None:
        self._sheen_pos += 0.065
        if self._sheen_pos > 1.35:
            self._sheen_pos = -0.35
            self._sheen_timer.stop()
        self.update()

    def _tick_glow(self) -> None:
        target = 1.0 if (self._hovered and not self.isDown()) else 0.0
        if abs(self._hover_glow - target) < 0.08:
            self._hover_glow = target
            self._glow_timer.stop()
        else:
            self._hover_glow += 0.16 if target > self._hover_glow else -0.16
        self.update()

    def enterEvent(self, event) -> None:  # noqa: N802
        self._hovered = True
        self._trigger_sheen()
        if not self._glow_timer.isActive():
            self._glow_timer.start()
        super().enterEvent(event)

    def leaveEvent(self, event) -> None:  # noqa: N802
        self._hovered = False
        if not self._glow_timer.isActive():
            self._glow_timer.start()
        super().leaveEvent(event)

    def paintEvent(self, event) -> None:  # noqa: N802
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing, True)
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform, True)

        pressed = self.isDown()
        r = QRectF(self.rect()).adjusted(1.0, 1.0, -1.0, -1.0)
