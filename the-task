    def _validate_img2img_source(self) -> bool:
        if not self.img2img_source:
            return False
        img = QImage(self.img2img_source)
        if img.isNull():
            self._flash_summary("img2img source cannot be decoded.")
            self.tabs.setCurrentIndex(TAB_PROMPT)
            return False
        if img.width() * img.height() > IMG2IMG_MAX_SRC_MP:
            self._flash_summary(f"img2img source too large ({img.width()}\u00d7{img.height()}).")
            self.tabs.setCurrentIndex(TAB_PROMPT)
            return False
        return True

    def _set_img2img_source(self, path: Optional[str]) -> None:
        if path and not os.path.isfile(path):
            return
        if (path or "") != (self.img2img_source or ""):
            # a NEW source invalidates any stale mask / edit mode
            self.img2img_mask = None
            self._i2i_edit_mode = False
            self.i2i_clear_mask_btn.setVisible(False)
        self.img2img_source = path
        if path:
            img = QImage(path)
            if not img.isNull():
                pm = QPixmap(path).scaled(
                    84, 58, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation
                )
                self.i2i_drop_lbl.setPixmap(pm)
                self.i2i_drop_lbl.setText("")
                self.i2i_drop_lbl.setMinimumHeight(58)
            self.i2i_section.set_expanded(True)
            STUDIO_LOG.info("SYS", f"img2img source set: {path}")
        else:
            self.i2i_drop_lbl.setText("Drop image \u2022 img2img source")
        self._update_i2i_caption()
        self.i2i_section.header.set_title(
            f"img2img Source [{os.path.basename(self.img2img_source) if self.img2img_source else 'none'}]"
        )
        self._update_generate_subtext()
        self._schedule_save()

