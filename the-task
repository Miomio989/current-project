        img = QImage(self.ups_source)
        if img.isNull():
            self.ups_plan_caption.setText("Cannot decode the source image.")
            return
        plan = plan_tile_grid(img.width(), img.height(), self.ups_scale_spin.value(), self.ups_overlap_spin.value())
        self.ups_plan_preview.set_data(self.ups_source, plan)
        n_tiles = len(plan["tiles"])
        t = plan["tile"]
        self.ups_source_caption.setText(
            f"Source: {os.path.basename(self.ups_source)} ({img.width()}\u00d7{img.height()})  \u2192  "
            f"output {plan['out_w']}\u00d7{plan['out_h']}  \u2022  {plan['cols']}\u00d7{plan['rows']} grid  \u2022  "
            f"{n_tiles} square tile{'' if n_tiles == 1 else 's'} of {t}\u00d7{t}px (\u2264 1 MP each, no edge slivers)"
        )
        self._schedule_save()

    def ups_start(self) -> None:
        if not self.ups_source or not os.path.isfile(self.ups_source):
            self._flash_summary("Select a source image first.")
            return
        img = QImage(self.ups_source)
        if img.isNull():
            return
        opts = self._options()
        if (not opts.get("nsfw")) or opts.get("censor_nsfw"):
            STUDIO_LOG.warn("Upscale", "Preflight: NSFW disabled or censoring active — workers may return black placeholder tiles.")
        plan = plan_tile_grid(img.width(), img.height(), self.ups_scale_spin.value(), self.ups_overlap_spin.value())
        gid = self._ups_next_gid
        self._ups_next_gid += 1
        upscaler = str(self.ups_upscaler_combo.currentData() or DEFAULT_UPSCALER)
        tmodel = str(self.ups_model_combo.currentData() or DEFAULT_TILE_MODEL)
        tpl_body = str(self.ups_tpl_combo.currentData() or "")
        src_prompt = str(self.ups_source_meta.get("raw_prompt") or self.ups_source_meta.get("prompt") or self.prompt_edit.toPlainText()).strip()
        tile_prompt = apply_template(tpl_body, src_prompt) if tpl_body else src_prompt
        tile_neg = " ".join(self.neg_edit.toPlainText().split())
        base_target = os.path.join(TILES_DIR, f"g{gid}_base.png")

        run = {
            "gid": gid,
            "source": self.ups_source,
            "source_meta": dict(self.ups_source_meta),
            "plan": plan,
            "upscaler": upscaler,
            "model": tmodel,
            "denoise": round(self.ups_denoise_spin.value(), 2),
            "steps": self.ups_steps_spin.value(),
            "cfg": round(self.ups_cfg_spin.value(), 1),
            "prompt": tile_prompt,
            "negative": tile_neg,
            "base_path": "",
            "base_target": base_target,
            "merged_path": "",
            "base_job_id": None,
        }
        self.ups_groups[gid] = run
        self.queue.add_group(gid, f"Tile Upscale #{gid} ({plan['out_w']}\u00d7{plan['out_h']})", "Running whole-image base pass\u2026")
        base_job = self.queue.enqueue(
            {"source_image_path": self.ups_source},
            {
                "tile_job": True,
                "tile_group": gid,
                "tile_stage": "base",
                "alchemy_form": upscaler,
                "target_w": plan["out_w"],
                "target_h": plan["out_h"],
                "tile_target": base_target,
            },
            kind=KIND_ALCH,
            group_id=gid,
        )
        run["base_job_id"] = base_job.local_id
        self._ups_rebuild_group_combo(select_gid=gid)
        self._ups_show_run(gid)
        self.mini_queue.setVisible(True)
        STUDIO_LOG.info(
            "UPSCALE",
            f"Started Tile Upscale #{gid}: {plan['cols']}x{plan['rows']} grid, "
            f"{len(plan['tiles'])} uniform {plan['tile']}x{plan['tile']}px square tiles "
            f"({plan['out_w']}x{plan['out_h']}, overlap {plan['overlap']}px)",
        )

    def _ups_enqueue_i2i(self, run: Dict[str, Any], tile: Dict[str, Any]) -> None:
        gid = run["gid"]
        spec = TILE_MODELS.get(run["model"], TILE_MODELS[DEFAULT_TILE_MODEL])
        full_p = run["prompt"] + (f" ### {run['negative']}" if run["negative"] else "")
        target = os.path.join(TILES_DIR, f"g{gid}_r{tile['row']}c{tile['col']}.png")
        payload: Dict[str, Any] = {
            "prompt": full_p,
            "models": [run["model"]],
            "r2": True,
            "source_image_path": run["base_path"],
            "source_rect": (tile["x"], tile["y"], tile["w"], tile["h"]),
            "source_processing": "img2img",
            "params": {
                "sampler_name": spec["sampler"],
                "scheduler": spec["scheduler"],
                "steps": int(run["steps"]),
                "cfg_scale": float(run["cfg"]),
                "clip_skip": int(spec.get("clip_skip", 2)),
                "denoising_strength": float(run["denoise"]),
                "width": int(tile["send_w"]),
                "height": int(tile["send_h"]),
                "n": 1,
            },
        }
        payload.update(self._options())
        job = self.queue.enqueue(
            payload,
            {
                "tile_job": True,
                "tile_group": gid,
                "tile_stage": "i2i",
                "tile_idx": tile["idx"],
                "tile_row": tile["row"],
                "tile_col": tile["col"],
                "tile_target": target,
                "model": run["model"],
                "prompt": run["prompt"],
            },
            kind=KIND_TILE_I2I,
            group_id=gid,
        )
        tile["state"] = TILE_REFINING
        tile["job_id"] = job.local_id
        tile["error"] = ""

    def _on_queue_job_finished(self, job: Job) -> None:
        # Handle SillyTavern waiter wakeup if any
        st_w = self._st_waiters.pop(job.local_id, None)
        if st_w is not None:
            if job.state == STATE_DONE and job.results:
                st_w["result"] = {"ok": True, "path": job.results[0], "meta": read_image_metadata(job.results[0])}
            else:
                st_w["result"] = {"ok": False, "error": job.message or job.state}
            st_w["event"].set()

        # Surface plain generation failures as toasts (tile groups stay in the queue view)
        if job.kind in (KIND_GEN, KIND_DEPTH) and job.state == STATE_FAILED:
            self.toast.notify(f"Job #{job.local_id} failed \u2014 {elide(job.message, 60)}", "err")
            SOUNDS.play("fail")

        # Handle Tile Upscale child jobs
        gid = job.group_id
        if gid is None or gid not in self.ups_groups or job.kind == KIND_GROUP:
            return
        run = self.ups_groups[gid]
        plan = run["plan"]
        stage = job.meta.get("tile_stage")

        if stage == "base":
            if job.state == STATE_DONE and job.results:
                run["base_path"] = job.results[0]
                for t in plan["tiles"]:
                    t["state"] = TILE_UPSCALED
                    self._ups_enqueue_i2i(run, t)
            else:
                for t in plan["tiles"]:
                    t["state"] = TILE_FAILED
                    t["error"] = job.message or "Base upscale failed"
        elif stage == "i2i":
            tidx = job.meta.get("tile_idx")
            if isinstance(tidx, int) and 0 <= tidx < len(plan["tiles"]):
                t = plan["tiles"][tidx]
                if job.state == STATE_DONE and job.results:
                    t["state"] = TILE_DONE
                    t["path"] = job.results[0]
                    t["error"] = ""
                else:
                    t["state"] = TILE_FAILED
                    t["error"] = job.message or job.state

        self._ups_recompute_group(gid)

    def _ups_recompute_group(self, gid: int) -> None:
        run = self.ups_groups.get(gid)
        if not run:
            return
        tiles = run["plan"]["tiles"]
        done = sum(1 for t in tiles if t["state"] == TILE_DONE)
        failed = sum(1 for t in tiles if t["state"] == TILE_FAILED)
        total = max(1, len(tiles))
        prog = sum(TILE_STAGE_WEIGHT.get(t["state"], 0.0) for t in tiles) / total
        all_terminal = all(t["state"] in (TILE_DONE, TILE_FAILED) for t in tiles)
        if all_terminal and done > 0 and not run["merged_path"]:
            self._ups_do_merge(gid)
        st = STATE_DONE if (all_terminal and failed == 0) else (STATE_FAILED if all_terminal else STATE_PROCESSING)
        detail = f"{done}/{total} tiles done" + (f" \u2022 {failed} failed" if failed else "")
        self.queue.update_group(gid, state=st, detail=detail, progress=prog, results=[run["merged_path"]] if run["merged_path"] else [])
        if all_terminal and failed > 0 and not run.get("_fail_notified"):
            run["_fail_notified"] = True
            SOUNDS.play("fail")
        if run.get("merged_path") and all_terminal and not run.get("_toasted"):
            run["_toasted"] = True
            self.toast.notify(
                f"Tile Upscale #{gid} merged — {os.path.basename(run['merged_path'])}",
                "ok",
                payload=run["merged_path"],
                on_click=lambda p: self._open_from_gallery_tab(p),
            )
        if self.ups_active_gid == gid:
            self._ups_refresh_timer.start()

    def _ups_do_merge(self, gid: int) -> Optional[str]:
        run = self.ups_groups.get(gid)
        if not run:
            return None
        plan = run["plan"]
        merged = merge_tiles(plan["tiles"], plan["out_w"], plan["out_h"], run.get("base_path") or None)
        meta = dict(run["source_meta"])
        meta.update({
            "tile_upscale": True,
            "width": plan["out_w"],
            "height": plan["out_h"],
            "upscaler": run["upscaler"],
            "tile_model": run["model"],
            "saved_at": time.time(),
        })
        dest = self.store.output_name(meta, ".png")
        write_image_with_metadata(image_to_png_bytes(merged), dest, meta)
        run["merged_path"] = dest
        self.gallery_tab.mark_dirty()
        self.refresh_gallery(select=dest)
        STUDIO_LOG.ok("Upscale", f"Tile Upscale #{gid} merged & saved: {os.path.basename(dest)}")
        SOUNDS.play("upscale")
        return dest

    def ups_merge_and_save(self) -> None:
        if self.ups_active_gid is not None:
            p = self._ups_do_merge(self.ups_active_gid)
            if p:
                self._flash_summary(f"Merged \u2192 {os.path.basename(p)}")

    def ups_retry_failed(self) -> None:
        if self.ups_active_gid is None or self.ups_active_gid not in self.ups_groups:
            return
        run = self.ups_groups[self.ups_active_gid]
        if not run.get("base_path") or not os.path.isfile(run["base_path"]):
            # Re-run base pass
            for j in self.queue.jobs:
                if j.local_id == run.get("base_job_id"):
                    self.queue.retry(j)
                    return
        else:
            for t in run["plan"]["tiles"]:
                if t["state"] == TILE_FAILED:
                    self._ups_enqueue_i2i(run, t)
        self._ups_refresh_now()

    def ups_reset(self) -> None:
        if self.ups_active_gid is None:
            self.ups_clear_source()
            return
        gid = self.ups_active_gid
        for j in list(self.queue.jobs):
            if j.kind == KIND_GROUP and j.group_id == gid:
                if j.active:
                    self.queue.cancel(j)
                    return
                self.queue.remove(j)
        ImageStore.clean_group_tiles(gid)
        self.ups_groups.pop(gid, None)
        rem = sorted(self.ups_groups)
        self._ups_rebuild_group_combo(select_gid=rem[-1] if rem else None)
        self._ups_show_run(rem[-1] if rem else None)

    def _ups_rebuild_group_combo(self, select_gid: Optional[int] = None) -> None:
        self.ups_run_combo.blockSignals(True)
        self.ups_run_combo.clear()
        if not self.ups_groups:
            self.ups_run_combo.addItem("no run", None)
        else:
            for gid in sorted(self.ups_groups):
                r = self.ups_groups[gid]
                self.ups_run_combo.addItem(f"Run #{gid} ({r['plan']['out_w']}\u00d7{r['plan']['out_h']})", gid)
            if select_gid is not None:
                ix = self.ups_run_combo.findData(select_gid)
                if ix >= 0:
                    self.ups_run_combo.setCurrentIndex(ix)
        self.ups_run_combo.blockSignals(False)

    def _ups_combo_changed(self) -> None:
        gid = self.ups_run_combo.currentData()
        self._ups_show_run(gid if isinstance(gid, int) else None)

    def _ups_show_run(self, gid: Optional[int]) -> None:
        self.ups_active_gid = gid if (gid in self.ups_groups) else None
        self._ups_refresh_now()

    def _ups_refresh_now(self) -> None:
        gid = self.ups_active_gid
        if gid is None or gid not in self.ups_groups:
            self.ups_canvas_preview.set_run(None, None)
            self.ups_grid.clear()
            self.ups_retry_btn.setEnabled(False)
            self.ups_merge_btn.setEnabled(False)
            self.ups_status.setText("Select source image, verify plan, then START UPSCALE.")
            return
        run = self.ups_groups[gid]
        plan = run["plan"]
        self.ups_plan_preview.set_data(run["source"], plan)
        self.ups_canvas_preview.set_run(plan, run.get("base_path") or None)
        self.ups_grid.clear()
        done = sum(1 for t in plan["tiles"] if t["state"] == TILE_DONE)
        failed = sum(1 for t in plan["tiles"] if t["state"] == TILE_FAILED)
        for t in plan["tiles"]:
            it = QListWidgetItem()
            it.setData(Qt.ItemDataRole.UserRole, t)
            tip = f"Tile r{t['row']}c{t['col']} ({t['send_w']}\u00d7{t['send_h']})\nState: {TILE_STATE_LONG.get(t['state'], t['state'])}"
            if t.get("error"):
                tip += f"\nError: {t['error']}"
            it.setToolTip(tip)
            self.ups_grid.addItem(it)
        self.ups_retry_btn.setEnabled(failed > 0)
        self.ups_merge_btn.setEnabled(done > 0)
        self.ups_status.setText(f"Run #{gid}: {done}/{len(plan['tiles'])} done" + (f" \u2022 {failed} failed" if failed else ""))

    def _ups_tile_menu(self, pos: QPoint) -> None:
        it = self.ups_grid.itemAt(pos)
        if it is None or self.ups_active_gid is None:
            return
        t = it.data(Qt.ItemDataRole.UserRole)
        run = self.ups_groups.get(self.ups_active_gid)
        if not isinstance(t, dict) or not run:
            return
        m = QMenu(self)
        if run.get("base_path") and os.path.isfile(run["base_path"]):
            m.addAction(f"Retry Tile r{t['row']}c{t['col']}", lambda: self._ups_enqueue_i2i(run, t))
        if t.get("path") and os.path.isfile(t["path"]):
            m.addAction("Inspect Tile in Viewer", lambda: self.show_image(t["path"]))
        m.exec(self.ups_grid.viewport().mapToGlobal(pos))

