class TemplateEditorDialog(QDialog):
    """Full editor for the template XML files: add / edit / duplicate / remove
    entries, switch between the ANIME and KREA sets, live preview. Saving
    rewrites the whole XML file through templates_to_xml() (fully escaped, so
    prompts may contain '&', '<' or nested tag markers)."""

    def __init__(self, main: "MainWindow") -> None:
        super().__init__(main)
        self.main = main
        self.setWindowTitle("Template editor")
        self.setModal(True)
        self.resize(680, 500)
        self.setMinimumSize(560, 420)
        # working copies - only written back on Save
        self.data: Dict[str, List[Dict[str, str]]] = {
            key: [dict(t) for t in main.templates.get(key, [])]
            for key in TEMPLATE_FILES
        }
        self._set = main._template_set() if hasattr(main, "_template_set") else "krea"
        self._loading = True

        lay = QVBoxLayout(self)
        lay.setContentsMargins(10, 10, 10, 10)
        lay.setSpacing(6)
        top = QHBoxLayout()
        top.setSpacing(6)
        self.set_group = QButtonGroup(self)
        self.set_group.setExclusive(True)
        self.set_btns: Dict[str, QPushButton] = {}
        for key, label, obj in (("anime", "ANIME", "SegL"), ("krea", "KREA", "SegR")):
            b = QPushButton(label)
            b.setObjectName(obj)
            b.setCheckable(True)
            b.setCursor(Qt.CursorShape.PointingHandCursor)
