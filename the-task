# ==============================================================================
# SECTION 5: VECTOR MATH, SPLINES, 3D PROJECTION & PROCEDURAL NOISE
# ==============================================================================

def clamp(v: float, lo: float, hi: float) -> float:
    return lo if v < lo else (hi if v > hi else v)


def clamp_int(v: int, lo: int, hi: int) -> int:
    return lo if v < lo else (hi if v > hi else v)


def lerp(a: float, b: float, t: float) -> float:
    return a + (b - a) * t


def smoothstep(t: float) -> float:
    t = clamp(t, 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def ease_out_cubic(t: float) -> float:
    t = clamp(t, 0.0, 1.0)
    u = 1.0 - t
    return 1.0 - u * u * u


def ease_in_out_cubic(t: float) -> float:
    t = clamp(t, 0.0, 1.0)
    return 4.0 * t * t * t if t < 0.5 else 1.0 - ((-2.0 * t + 2.0) ** 3) * 0.5


def lerp_rgb(c1: RGB, c2: RGB, t: float) -> RGB:
    t = clamp(t, 0.0, 1.0)
    return (
        int(c1[0] + (c2[0] - c1[0]) * t),
        int(c1[1] + (c2[1] - c1[1]) * t),
        int(c1[2] + (c2[2] - c1[2]) * t),
    )


def scale_rgb(c: RGB, factor: float) -> RGB:
    return (
        clamp_int(int(c[0] * factor), 0, 255),
        clamp_int(int(c[1] * factor), 0, 255),
        clamp_int(int(c[2] * factor), 0, 255),
    )


def add_rgb(c1: RGB, c2: RGB, w: float = 1.0) -> RGB:
    return (
        clamp_int(int(c1[0] + c2[0] * w), 0, 255),
        clamp_int(int(c1[1] + c2[1] * w), 0, 255),
        clamp_int(int(c1[2] + c2[2] * w), 0, 255),
    )


def sample_ramp(stops: Sequence[Tuple[float, RGB]], t: float) -> RGB:
    if t <= stops[0][0]:
        return stops[0][1]
    if t >= stops[-1][0]:
        return stops[-1][1]
    for i in range(len(stops) - 1):
        t0, c0 = stops[i]
        t1, c1 = stops[i + 1]
        if t0 <= t <= t1:
            u = (t - t0) / max(1e-6, t1 - t0)
            return lerp_rgb(c0, c1, u)
    return stops[-1][1]


def v_add(a: Pt2, b: Pt2) -> Pt2:
    return (a[0] + b[0], a[1] + b[1])


def v_sub(a: Pt2, b: Pt2) -> Pt2:
    return (a[0] - b[0], a[1] - b[1])


def v_mul(a: Pt2, s: float) -> Pt2:
    return (a[0] * s, a[1] * s)


def v_lerp(a: Pt2, b: Pt2, t: float) -> Pt2:
    return (a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t)


def v_len(a: Pt2) -> float:
    return math.hypot(a[0], a[1])


def v_norm(a: Pt2) -> Pt2:
    d = math.hypot(a[0], a[1])
    if d < 1e-6:
        return (1.0, 0.0)
    return (a[0] / d, a[1] / d)


def v_perp(a: Pt2) -> Pt2:
    return (-a[1], a[0])


def v_rot(a: Pt2, rad: float) -> Pt2:
    c = math.cos(rad)
    s = math.sin(rad)
    return (a[0] * c - a[1] * s, a[0] * s + a[1] * c)


def eval_cubic(p0: Pt2, p1: Pt2, p2: Pt2, p3: Pt2, t: float) -> Pt2:
    u = 1.0 - t
    uu = u * u
    tt = t * t
    w0 = uu * u
    w1 = 3.0 * uu * t
    w2 = 3.0 * u * tt
    w3 = tt * t
    return (
        w0 * p0[0] + w1 * p1[0] + w2 * p2[0] + w3 * p3[0],
        w0 * p0[1] + w1 * p1[1] + w2 * p2[1] + w3 * p3[1],
    )


def sample_cubic(p0: Pt2, p1: Pt2, p2: Pt2, p3: Pt2, steps: int = 12) -> List[Pt2]:
    return [eval_cubic(p0, p1, p2, p3, i / float(steps)) for i in range(steps + 1)]


def eval_quad(p0: Pt2, p1: Pt2, p2: Pt2, t: float) -> Pt2:
    u = 1.0 - t
    return (
        u * u * p0[0] + 2.0 * u * t * p1[0] + t * t * p2[0],
        u * u * p0[1] + 2.0 * u * t * p1[1] + t * t * p2[1],
    )


def sample_quad(p0: Pt2, p1: Pt2, p2: Pt2, steps: int = 10) -> List[Pt2]:
    return [eval_quad(p0, p1, p2, i / float(steps)) for i in range(steps + 1)]


def build_tapered_ribbon_poly(
    pts: Sequence[Pt2],
    widths: Sequence[float],
) -> List[Pt2]:
    """Construct a smooth closed contour around a polyline with per-vertex half-widths."""
    n = len(pts)
    if n < 2:
        return list(pts)
    left: List[Pt2] = []
    right: List[Pt2] = []
    for i in range(n):
        if i == 0:
            tang = v_norm(v_sub(pts[1], pts[0]))
        elif i == n - 1:
            tang = v_norm(v_sub(pts[-1], pts[-2]))
        else:
            tang = v_norm(v_sub(pts[i + 1], pts[i - 1]))
        nrm = (-tang[1], tang[0])
        w = widths[i]
        p = pts[i]
        left.append((p[0] + nrm[0] * w, p[1] + nrm[1] * w))
        right.append((p[0] - nrm[0] * w, p[1] - nrm[1] * w))
    right.reverse()
    return left + right


def build_anatomical_limb(
    p0: Pt2,
    p1: Pt2,
    r0_l: float,
    r0_r: float,
    rm_l: float,
    rm_r: float,
    r1_l: float,
    r1_r: float,
    mid_t: float = 0.45,
    steps: int = 10,
) -> List[Pt2]:
    """
    Sculpt an organic curved anatomical limb segment (thigh, calf, forearm)
    with asymmetric muscle/calf contour via cubic Beziers on both sides.
    """
    d = v_sub(p1, p0)
    tang = v_norm(d)
    nrm = (-tang[1], tang[0])
    L = max(1.0, v_len(d))
    pm = v_lerp(p0, p1, mid_t)

    l0 = (p0[0] + nrm[0] * r0_l, p0[1] + nrm[1] * r0_l)
    l1 = (p0[0] + tang[0] * (L * 0.30) + nrm[0] * rm_l, p0[1] + tang[1] * (L * 0.30) + nrm[1] * rm_l)
    l2 = (pm[0] + tang[0] * (L * 0.22) + nrm[0] * lerp(rm_l, r1_l, 0.48), pm[1] + tang[1] * (L * 0.22) + nrm[1] * lerp(rm_l, r1_l, 0.48))
    l3 = (p1[0] + nrm[0] * r1_l, p1[1] + nrm[1] * r1_l)

    r0 = (p0[0] - nrm[0] * r0_r, p0[1] - nrm[1] * r0_r)
    r1 = (p0[0] + tang[0] * (L * 0.30) - nrm[0] * rm_r, p0[1] + tang[1] * (L * 0.30) - nrm[1] * rm_r)
    r2 = (pm[0] + tang[0] * (L * 0.22) - nrm[0] * lerp(rm_r, r1_r, 0.48), pm[1] + tang[1] * (L * 0.22) - nrm[1] * lerp(rm_r, r1_r, 0.48))
    r3 = (p1[0] - nrm[0] * r1_r, p1[1] - nrm[1] * r1_r)

    side_l = sample_cubic(l0, l1, l2, l3, steps)
    side_r = sample_cubic(r0, r1, r2, r3, steps)
    side_r.reverse()
    return side_l + side_r


def poly_bbox(pts: Sequence[Pt2]) -> Tuple[int, int, int, int]:
    xs = [p[0] for p in pts]
    ys = [p[1] for p in pts]
    x0 = int(math.floor(min(xs)))
    y0 = int(math.floor(min(ys)))
    x1 = int(math.ceil(max(xs)))
    y1 = int(math.ceil(max(ys)))
    return (x0, y0, max(1, x1 - x0 + 1), max(1, y1 - y0 + 1))


def rect_intersects(a: BoxRect, b: BoxRect) -> bool:
    return (
        a.x < b.x + b.w
        and a.x + a.w > b.x
        and a.y < b.y + b.h
        and a.y + a.h > b.y
    )


def rect_overlap_center(a: BoxRect, b: BoxRect) -> Pt2:
    x0 = max(a.x, b.x)
    x1 = min(a.x + a.w, b.x + b.w)
    y0 = max(a.y, b.y)
    y1 = min(a.y + a.h, b.y + b.h)
    return ((x0 + x1) * 0.5, (y0 + y1) * 0.5)


def hash2(ix: int, iy: int, seed: int = 1337) -> float:
    n = (ix * 374761393 + iy * 668265263 + seed * 1442695041) & 0x7FFFFFFF
    n = (n ^ (n >> 13)) * 1274126177
    n = (n ^ (n >> 16)) & 0x7FFFFFFF
    return n / 2147483647.0


def value_noise2(x: float, y: float, seed: int = 1337) -> float:
    ix = int(math.floor(x))
    iy = int(math.floor(y))
    fx = x - ix
    fy = y - iy
    ux = fx * fx * (3.0 - 2.0 * fx)
    uy = fy * fy * (3.0 - 2.0 * fy)
    a = hash2(ix, iy, seed)
    b = hash2(ix + 1, iy, seed)
    c = hash2(ix, iy + 1, seed)
    d = hash2(ix + 1, iy + 1, seed)
    return a + (b - a) * ux + (c - a) * uy + (a - b - c + d) * ux * uy


def fbm2(x: float, y: float, octaves: int = 4, seed: int = 1337) -> float:
    val = 0.0
    amp = 0.5
    freq = 1.0
    norm = 0.0
    for i in range(octaves):
        val += amp * value_noise2(x * freq, y * freq, seed + i * 97)
        norm += amp
        freq *= 2.04
        amp *= 0.5
    return val / max(1e-6, norm)


def ridged_fbm2(x: float, y: float, octaves: int = 4, seed: int = 4099) -> float:
    val = 0.0
    amp = 0.52
    freq = 1.0
    norm = 0.0
    for i in range(octaves):
        n = value_noise2(x * freq, y * freq, seed + i * 131)
        r = 1.0 - abs(2.0 * n - 1.0)
        val += amp * (r * r)
        norm += amp
        freq *= 2.11
        amp *= 0.48
    return val / max(1e-6, norm)


