def build_all_animation_keyframes() -> Dict[FighterState, List[PoseKeyframe]]:
    """Populate and verify that EVERY FighterState has authored keyframes."""
    ANIMATION_KEYFRAMES.clear()
    _register_movement_and_pose_keyframes()
    _register_normal_attack_keyframes()
    _register_special_and_throw_keyframes()
    _register_super_and_damage_keyframes()

    # Safety assertion: guarantee zero missing FighterState entries
    idle_fallback = ANIMATION_KEYFRAMES[FighterState.IDLE]
    for st in FighterState:
        if st not in ANIMATION_KEYFRAMES or not ANIMATION_KEYFRAMES[st]:
            ANIMATION_KEYFRAMES[st] = idle_fallback
    return ANIMATION_KEYFRAMES


