DEFAULT_THEME = "gold"

# Live palette: every widget / delegate reads these dicts AT PAINT TIME, so a
# theme switch only has to swap their contents in place and repaint.
PAL: Dict[str, str] = {}
GOLD: Dict[str, str] = {}
# Job-state colours for the queue rows (kept as a live dict for the same reason).
JOB_STATE_COLORS: Dict[str, str] = {}
_active_theme = {"name": DEFAULT_THEME}


def theme_name() -> str:
    """Key of the active theme ("gold" / "crimson")."""
    return _active_theme["name"]


def theme_meta(key: str) -> str:
    """Non-colour metadata of the active theme (label / name / hint)."""
    return str(THEMES[theme_name()].get(key, ""))


def set_theme(name: str) -> str:
    """Activate a theme: swap PAL / GOLD and the state-colour dicts in place
    and return the canonical key. Callers then rebuild the style sheet,
    repolish and repaint (see MainWindow._apply_theme)."""
    th = THEMES.get(name, THEMES[DEFAULT_THEME])
    _active_theme["name"] = th["key"]
    PAL.clear()
    PAL.update(th)
    GOLD.clear()
    GOLD.update({k[len("ramp_"):]: v for k, v in th.items() if k.startswith("ramp_")})
    TILE_STATE_COLORS.clear()
    TILE_STATE_COLORS.update({
        TILE_PLANNED: th["tile_planned"], TILE_UPSCALING: th["tile_upscaling"],
        TILE_UPSCALED: th["tile_upscaled"], TILE_REFINING: th["tile_refining"],
        TILE_DONE: th["tile_done"], TILE_FAILED: th["tile_failed"],
    })
    JOB_STATE_COLORS.clear()
    JOB_STATE_COLORS.update({
        STATE_QUEUED: th["st_queued"], STATE_SUBMITTING: th["st_submit"],
        STATE_WAITING: th["st_wait"], STATE_PROCESSING: th["st_proc"],
        STATE_FETCHING: th["st_fetch"], STATE_DONE: th["st_done"],
        STATE_FAILED: th["st_failed"], STATE_CANCELLED: th["st_cancel"],
    })
    return th["key"]


set_theme(DEFAULT_THEME)   # populate the live dicts at import time


def _acc_grad(hover: bool = False) -> str:
    """Gel-style accent gradient string (bright specular band over the top
    third, crisp falloff at the middle, deep polished base)."""
    pfx = "ramp2_" if hover else "ramp_"
    return (f"qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 {PAL[pfx + 'hi']}, "
            f"stop:0.35 {PAL[pfx + 'mid']}, stop:0.52 {PAL[pfx + 'mid2']}, stop:1 {PAL[pfx + 'lo']})")


