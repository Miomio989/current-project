@dataclass
class PlayerHabitProfile:
    jump_count: int = 0
    low_atk_count: int = 0
    proj_count: int = 0
    mash_count: int = 0
    samples: int = 1


class DarkmoonMasterAI:
    """
    Adaptive tactical fighting-game AI with 5 difficulty tiers, 6 Arcade Rival
    combat doctrines, real-time player habit profiling, footsies spacing,
    whiff punishing, anti-airs, hit-confirmed rekka/Shadow-Cancel combos, and
    human-like reaction windows!
    """

    def __init__(self, difficulty: AIDifficulty = AIDifficulty.DUELIST, doctrine: str = "FOOTSIES") -> None:
        self.difficulty = difficulty
        self.doctrine = doctrine
        self.habits = PlayerHabitProfile()
        self.decision_cd: int = 0
        self.planned_seq: Deque[Tuple[int, int, InputButton]] = collections.deque()
        self.hold_dx: int = 0
        self.hold_dy: int = 0
        self.hold_frames: int = 0
        self.rng = random.Random()

    def observe_player(self, opp: Fighter) -> None:
        self.habits.samples += 1
        if opp.state == FighterState.JUMP_RISE and opp.frame_idx == 0:
            self.habits.jump_count += 1
        elif opp.state in (FighterState.ATK_2A, FighterState.ATK_2B, FighterState.ATK_2D) and opp.frame_idx == 0:
            self.habits.low_atk_count += 1
        elif opp.state in (FighterState.SP_CRESCENT_L, FighterState.SP_CRESCENT_H, FighterState.SP_CRESCENT_EX) and opp.frame_idx == 0:
            self.habits.proj_count += 1

    def decide(self, me: Fighter, opp: Fighter) -> Tuple[int, int, InputButton]:
        self.observe_player(opp)
        _, aggr, react_f, block_p, combo_p = self.difficulty.value
        if self.doctrine == "RUSHDOWN": aggr = min(0.98, aggr + 0.14)
        elif self.doctrine == "COUNTER": block_p = min(0.95, block_p + 0.16)
        elif self.doctrine == "BOSS": aggr = min(0.98, aggr + 0.12); combo_p = min(0.95, combo_p + 0.12)

        if self.planned_seq:
            return self.planned_seq.popleft()

        dist = abs(opp.x - me.x)
        to_opp = 1 if opp.x >= me.x else -1
        away = -to_opp

        # 1. Active Combo Extensions on Hit Confirm!
        if me.is_attacking() and me.move_connected and self.rng.random() < combo_p:
            if me.state == FighterState.ATK_5A:
                return (0, 0, InputButton.B)
            if me.state == FighterState.ATK_5B:
                return (0, 0, InputButton.C)
            if me.state in (FighterState.ATK_5C, FighterState.ATK_6B):
                if me.curse_gauge >= 50.0 and self.rng.random() < 0.45:
                    # Queue Scarlet Requiem Super!
                    self._queue_motion((2, 6, 2, 6), InputButton.C, me.facing_right)
                    return self.planned_seq.popleft()
                self._queue_motion((2, 1, 4), InputButton.A, me.facing_right)
                return self.planned_seq.popleft()
            if me.state == FighterState.SP_WALTZ_1:
                return (0, 1 if self.rng.random() < 0.35 else 0, InputButton.B)
            if me.state == FighterState.SP_WALTZ_2:
                return (to_opp if self.rng.random() < 0.3 else 0, 0, InputButton.C)

        # 2. Defensive Guarding, Just-Deflect & Anti-Air Reactions!
        if opp.is_attacking() and dist < 215.0:
            if self.rng.random() < block_p:
                opp_spec = me.moves.get(opp.state)
                crouch_blk = (opp_spec is not None and opp_spec.height == AttackHeight.LOW)
                return (away, 1 if crouch_blk else 0, InputButton.NONE)
            if self.doctrine in ("COUNTER", "BOSS") and self.rng.random() < 0.18 and me.can_act():
                self._queue_motion((4, 2, 1), InputButton.D, me.facing_right)
                return self.planned_seq.popleft()

        # Anti-air jumping opponent with 2C or Vespera Ascension!
        if opp.is_airborne() and dist < 175.0 and opp.y < GROUND_Y - 55 and me.can_act():
            if self.rng.random() < combo_p * 0.72:
                if self.rng.random() < 0.55:
                    return (0, 1, InputButton.C)
                self._queue_motion((6, 2, 3), InputButton.C, me.facing_right)
                return self.planned_seq.popleft()

        # Wakeup Ukemi roll
        if me.state == FighterState.KNOCKDOWN and me.frame_idx >= 3:
            return (away if self.rng.random() < 0.6 else to_opp, 0, InputButton.NONE)

        # Burst out of heavy combo if low HP & Soul Burst full!
        if me.is_hitstunned() and me.soul_burst >= 100.0 and me.combo_hits_taken >= 4 and self.rng.random() < 0.35:
            return (0, 0, InputButton.BURST)

        if self.hold_frames > 0:
            self.hold_frames -= 1
            return (self.hold_dx, self.hold_dy, InputButton.NONE)

        if self.decision_cd > 0:
            self.decision_cd -= 1
            return (0, 0, InputButton.NONE)

        self.decision_cd = max(2, react_f + self.rng.randint(0, 8))

        # 3. Neutral Spacing & Range-Specific Attacks!
        if dist < 115.0:
            r = self.rng.random()
            if r < 0.18 * aggr:
                return (0, 0, InputButton.THROW)
            elif r < 0.42 * aggr:
                return (0, 0, InputButton.A)
            elif r < 0.64 * aggr:
                return (0, 1, InputButton.B)
            elif r < 0.80 * aggr:
                return (to_opp, 1, InputButton.C)  # Overhead 3C mixup!
            else:
                self.hold_dx, self.hold_dy, self.hold_frames = away, 0, 10
                return (away, 0, InputButton.NONE)
        elif dist < 235.0:
            r = self.rng.random()
            if r < 0.32 * aggr:
                return (0, 0, InputButton.B)      # Signature 5B Horizontal Sweep!
            elif r < 0.54 * aggr:
                return (to_opp, 0, InputButton.B) # Piercing Lunge 6B!
            elif r < 0.72 * aggr:
                return (0, 0, InputButton.D)      # Cursed Drive 5D!
            elif r < 0.86 * aggr:
                self._queue_motion((2, 1, 4), InputButton.A, me.facing_right)
                return self.planned_seq.popleft()
            else:
                self.hold_dx, self.hold_dy, self.hold_frames = to_opp, 0, 14
                return (to_opp, 0, InputButton.NONE)
        else:
            # Far range: Zone with Crimson Crescent, Swamp Spike 2D, or Dash/Jump in!
            r = self.rng.random()
            if r < (0.48 if self.doctrine == "ZONER" else 0.28) * aggr:
                self._queue_motion((2, 3, 6), InputButton.C if self.rng.random() < 0.5 else InputButton.A, me.facing_right)
                return self.planned_seq.popleft()
            elif r < 0.52 * aggr:
                return (0, 1, InputButton.D)      # Swamp Mire Spike!
            elif r < 0.78 * aggr:
                # Dash forward!
                self.planned_seq.extend([(to_opp, 0, InputButton.NONE), (0, 0, InputButton.NONE), (to_opp, 0, InputButton.NONE), (to_opp, 0, InputButton.NONE)])
                return self.planned_seq.popleft()
            else:
                self.hold_dx, self.hold_dy, self.hold_frames = to_opp, 0, 18
                return (to_opp, 0, InputButton.NONE)

    def _queue_motion(self, numpad_seq: Sequence[int], btn: InputButton, facing_right: bool) -> None:
        self.planned_seq.clear()
        for i, np in enumerate(numpad_seq):
            fx = -1 if np in (1, 4, 7) else (1 if np in (3, 6, 9) else 0)
            dx = fx if facing_right else -fx
            dy = -1 if np >= 7 else (1 if np <= 3 else 0)
            b = btn if i == len(numpad_seq) - 1 else InputButton.NONE
            self.planned_seq.append((dx, dy, b))


class TrainingDummyController:
    def __init__(self, ai: DarkmoonMasterAI) -> None:
        self.ai = ai

    def decide(self, dummy: Fighter, player: Fighter, cfg: TrainingSettings) -> Tuple[int, int, InputButton]:
        m = cfg.dummy_mode
        if m == DummyBehavior.CPU_CONTROL:
            return self.ai.decide(dummy, player)
        if m == DummyBehavior.CROUCH:
            return (0, 1, InputButton.NONE)
        if m == DummyBehavior.JUMP:
            return (0, -1, InputButton.NONE)
        if m == DummyBehavior.COUNTER_POKE and dummy.can_act() and abs(player.x - dummy.x) < 220:
            if dummy.state_total_frames % 42 == 0:
                return (0, 0, InputButton.B)
        return (0, 0, InputButton.NONE)


