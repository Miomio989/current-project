class GlossButton(QPushButton):
    """Big glossy capsule button (VN / PS3-era feel)."""

    def __init__(self, text: str, tone: str = "amber", parent: Optional[QWidget] = None):
        super().__init__(text, parent)
        self.tone = tone
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setMinimumHeight(46)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)

    def paintEvent(self, _e) -> None:  # noqa: N802
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(self.rect()).adjusted(1.5, 1.5, -1.5, -1.5)
        radius = r.height() / 2.0 - 2
        down = self.isDown()
        hover = self.underMouse() and self.isEnabled()
        amber = self.tone == "amber"
        if not self.isEnabled():
            top, bot = QColor(PAL["gl_dis_hi"]), QColor(PAL["gl_dis_lo"])
            border, txt = QColor(PAL["sh_border"]), QColor(PAL["gl_dis_text"])
        elif amber:
            top, bot = QColor(PAL["gl_hi"]), QColor(PAL["gl_lo"])
            if hover:
                top, bot = QColor(PAL["gl_hov_hi"]), QColor(PAL["gl_hov_lo"])
            if down:
                top, bot = QColor(PAL["gl_down_hi"]), QColor(PAL["gl_down_lo"])
            border, txt = QColor(PAL["gl_border"]), QColor(PAL["gl_text"])
        else:
            top, bot = QColor(PAL["gl_n_hi"]), QColor(PAL["gl_n_lo"])
            if hover:
                top, bot = QColor(PAL["gl_n_hov_hi"]), QColor(PAL["gl_n_hov_lo"])
            if down:
                top, bot = QColor(PAL["gl_n_down_hi"]), QColor(PAL["gl_n_down_lo"])
            border, txt = QColor(PAL["sh_border"]), QColor(PAL["gl_n_text"])
        # drop shadow
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(0, 0, 0, 90))
        p.drawRoundedRect(r.translated(0, 2), radius, radius)
        g = QLinearGradient(0, r.top(), 0, r.bottom())
        g.setColorAt(0, top)
        g.setColorAt(0.5, top.darker(112) if not down else top)
        g.setColorAt(0.52, bot.lighter(112))
        g.setColorAt(1, bot)
        p.setPen(QPen(border, 1.4))
        p.setBrush(QBrush(g))
        p.drawRoundedRect(r, radius, radius)
        # gloss on the upper half
        if not down:
            gl = QPainterPath()
            top_half = QRectF(r.left() + 3, r.top() + 2, r.width() - 6, r.height() * 0.48)
            gl.addRoundedRect(top_half, radius - 2, radius - 2)
            gg = QLinearGradient(0, top_half.top(), 0, top_half.bottom())
            gg.setColorAt(0, QColor(255, 255, 255, 132 if amber else 76))
            gg.setColorAt(1, QColor(255, 255, 255, 10))
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QBrush(gg))
            p.drawPath(gl)
        f = QFont(self.font())
        f.setPointSizeF(13.5 if amber else 11)
        f.setBold(True)
        f.setLetterSpacing(QFont.SpacingType.AbsoluteSpacing, 1.5 if amber else 0.6)
        p.setFont(f)
        tr = self.rect().adjusted(0, 1 if down else 0, 0, 1 if down else 0)
        p.setPen(QColor(255, 255, 255, 110) if amber else QColor(0, 0, 0, 140))
        p.drawText(tr.translated(0, 1), Qt.AlignmentFlag.AlignCenter, self.text())
        p.setPen(txt)
        p.drawText(tr, Qt.AlignmentFlag.AlignCenter, self.text())
        p.end()


class AspectButton(QAbstractButton):
    def __init__(self, spec: Dict[str, Any], parent: Optional[QWidget] = None):
        super().__init__(parent)
        self.spec = spec
        self.portrait = False
        self.setCheckable(True)
        self.setFixedSize(52, 52)          # 6 presets fit one row at 800x600
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self._refresh_tip()

    def set_portrait(self, on: bool) -> None:
        self.portrait = on and self.spec["key"] != "1:1"
        self._refresh_tip()
        self.update()

    def key(self) -> str:
        return invert_aspect_key(self.spec["key"]) if self.portrait else self.spec["key"]

    def size_wh(self) -> "tuple[int, int]":
        w, h = self.spec["w"], self.spec["h"]
        return (h, w) if self.portrait else (w, h)

    def _refresh_tip(self) -> None:
        w, h = self.size_wh()
        self.setToolTip(f"{self.key()}  \u2014  {w} \u00d7 {h} px  ({w * h / 1_000_000:.2f} MP)")

    def paintEvent(self, _e) -> None:  # noqa: N802
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(self.rect()).adjusted(1, 1, -1, -1)
        on = self.isChecked()
        hover = self.underMouse() and self.isEnabled()
        g = QLinearGradient(0, r.top(), 0, r.bottom())
        if not self.isEnabled():
            g.setColorAt(0, QColor(PAL["asp_dis_hi"])); g.setColorAt(1, QColor(PAL["asp_dis_lo"]))
            border = QColor(PAL["sh_border"])
        elif on:
            g.setColorAt(0, QColor(PAL["asp_on_hi"])); g.setColorAt(0.5, QColor(PAL["asp_on_mid"]))
            g.setColorAt(0.52, QColor(PAL["asp_on_mid2"])); g.setColorAt(1, QColor(PAL["asp_on_lo"]))
            border = QColor(PAL["acc_dk"])
        else:
            g.setColorAt(0, QColor(PAL["asp_hov_hi"] if hover else PAL["asp_hi"]))
            g.setColorAt(1, QColor(PAL["asp_hov_lo"] if hover else PAL["asp_lo"]))
            border = QColor(PAL["acc_lo"]) if hover else QColor(PAL["asp_border"])
        p.setPen(QPen(border, 1))
        p.setBrush(QBrush(g))
        p.drawRoundedRect(r, 6, 6)
        p.setPen(QPen(QColor(255, 255, 255, 70 if on else 40), 1))
        p.drawLine(QPointF(r.left() + 5, r.top() + 1.5), QPointF(r.right() - 5, r.top() + 1.5))
        w, h = self.size_wh()
        box_max = 30.0
        if w >= h:
            bw, bh = box_max, box_max * h / w
        else:
            bh, bw = box_max, box_max * w / h
        bh, bw = max(bh, 9), max(bw, 9)
        cx, cy = r.center().x(), r.top() + 21
        box = QRectF(cx - bw / 2, cy - bh / 2, bw, bh)
        ink = QColor(PAL["asp_ink"]) if on else (QColor(PAL["asp_text"]) if self.isEnabled() else QColor(PAL["dis_text2"]))
        p.setPen(QPen(ink, 2))
        p.setBrush(QColor(255, 255, 255, 60) if on else QColor(255, 255, 255, 18))
        p.drawRoundedRect(box, 2, 2)
        p.setFont(_font(9, True))
        p.setPen(QColor(PAL["asp_ink2"]) if on else ink)
        p.drawText(QRectF(r.left(), r.bottom() - 20, r.width(), 18), Qt.AlignmentFlag.AlignCenter, self.key())
        p.end()


class AspectPicker(QWidget):
    """One row of ratio buttons + landscape/portrait switch. Every size stays <= 1 MP."""
    changed = pyqtSignal(str)

    def __init__(self, parent: Optional[QWidget] = None):
        super().__init__(parent)
        self.group = QButtonGroup(self)
        self.group.setExclusive(True)
        self.buttons: Dict[str, AspectButton] = {}
        self.portrait = False
        row = QHBoxLayout(self)
        row.setContentsMargins(0, 0, 0, 0)
        row.setSpacing(4)
        for key in BASE_ASPECT_KEYS:
            b = AspectButton(ASPECT_BY_KEY[key])
            self.buttons[key] = b
            self.group.addButton(b)
            row.addWidget(b)
        row.addStretch(1)
        self.group.buttonClicked.connect(lambda _b: self.changed.emit(self.current()["key"]))
        # orientation switch (placed by the owner, e.g. in a section header)
        self.orient_land = QToolButton()
        self.orient_land.setText("\u25AD")
        self.orient_port = QToolButton()
        self.orient_port.setText("\u25AF")
        self.orient_group = QButtonGroup(self)
        self.orient_group.setExclusive(True)
        for b, tip in ((self.orient_land, "Landscape orientation"), (self.orient_port, "Portrait orientation")):
            b.setCheckable(True)
            b.setObjectName("Small")
            b.setToolTip(tip + "  (flips the presets)")
            b.setFixedSize(30, 22)
            b.setCursor(Qt.CursorShape.PointingHandCursor)
            self.orient_group.addButton(b)
        self.orient_land.setChecked(True)
        self.orient_group.buttonClicked.connect(lambda b: self._set_portrait(b is self.orient_port, emit=True))
        self.buttons["1:1"].setChecked(True)

    def _set_portrait(self, on: bool, emit: bool) -> None:
        self.portrait = on
        (self.orient_port if on else self.orient_land).setChecked(True)
        for b in self.buttons.values():
            b.set_portrait(on)
        if emit:
            self.changed.emit(self.current()["key"])

    def current(self) -> Dict[str, Any]:
        for b in self.buttons.values():
            if b.isChecked():
                w, h = b.size_wh()
                return {"key": b.key(), "w": w, "h": h}
        return {"key": "1:1", "w": 1024, "h": 1024}

    def set_current(self, key: str) -> None:
        if key not in ASPECT_BY_KEY:
            key = "1:1"
        spec = ASPECT_BY_KEY[key]
        portrait = spec["group"] == "port"
        base = invert_aspect_key(key) if portrait else key
        self._set_portrait(portrait, emit=False)
        (self.buttons.get(base) or self.buttons["1:1"]).setChecked(True)
        self.changed.emit(self.current()["key"])


class ThumbDelegate(QStyledItemDelegate):
    ROLE_PIX = Qt.ItemDataRole.UserRole + 2
    ROLE_META = Qt.ItemDataRole.UserRole + 1

    def paint(self, p: QPainter, opt: QStyleOptionViewItem, index: QModelIndex) -> None:
        p.save()
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(opt.rect).adjusted(3, 3, -3, -3)
        selected = bool(opt.state & QStyle.StateFlag.State_Selected)
        hover = bool(opt.state & QStyle.StateFlag.State_MouseOver)
        # frame
        g = QLinearGradient(0, r.top(), 0, r.bottom())
        g.setColorAt(0, QColor(PAL["thumb_hi"])); g.setColorAt(1, QColor(PAL["thumb_lo"]))
        p.setPen(QPen(QColor(PAL["acc"]) if selected else (QColor(PAL["acc_lo"]) if hover else QColor(PAL["thumb_inner"])), 2 if selected else 1))
        p.setBrush(QBrush(g))
        p.drawRoundedRect(r, 5, 5)
        inner = r.adjusted(5, 5, -5, -5)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(PAL["thumb_inner"]))
        p.drawRect(inner)
        pix = index.data(self.ROLE_PIX)
        if isinstance(pix, QPixmap) and not pix.isNull():
            scaled = pix.scaled(inner.size().toSize(), Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation)
            x = inner.left() + (inner.width() - scaled.width()) / 2
            y = inner.top() + (inner.height() - scaled.height()) / 2
            p.drawPixmap(int(x), int(y), scaled)
        meta = index.data(self.ROLE_META) or {}
        badge = model_short(str(meta.get("model", "")))
        badge_col = PAL.get("tint_krea" if badge == "KREA" else "tint_anima", PAL["acc_hi"]) if badge else ""
        if badge:
            p.setFont(_font(7.5, True))
            fm = QFontMetrics(p.font())
            bw = fm.horizontalAdvance(badge) + 8
            br = QRectF(inner.right() - bw - 1, inner.bottom() - 15, bw, 14)
            p.setBrush(QColor(0, 0, 0, 170))
            p.setPen(Qt.PenStyle.NoPen)
            p.drawRoundedRect(br, 3, 3)
            p.setPen(QColor(PAL["acc_hi"]) if not badge_col else QColor(badge_col))
            p.drawText(br, Qt.AlignmentFlag.AlignCenter, badge)
        # aesthetic score badge (Alchemy) in the top-right corner
        aes = meta.get("aesthetic")
        if isinstance(aes, (int, float)):
            txt = f"\u2605 {float(aes):.1f}"
            p.setFont(_font(7.5, True))
            fm = QFontMetrics(p.font())
            aw = fm.horizontalAdvance(txt) + 8
            ar_ = QRectF(inner.right() - aw - 1, inner.top() + 1, aw, 14)
            p.setBrush(QColor(0, 0, 0, 185))
            p.setPen(Qt.PenStyle.NoPen)
            p.drawRoundedRect(ar_, 3, 3)
            p.setPen(QColor(PAL["badge_star"]))
            p.drawText(ar_, Qt.AlignmentFlag.AlignCenter, txt)
        num = index.row() + 1
        p.setFont(_font(7.5, True))
        nr = QRectF(inner.left() + 1, inner.top() + 1, 16, 14)
        p.setBrush(QColor(0, 0, 0, 170))
        p.setPen(Qt.PenStyle.NoPen)
        p.drawRoundedRect(nr, 3, 3)
        p.setPen(QColor(PAL["text"]))
        p.drawText(nr, Qt.AlignmentFlag.AlignCenter, str(num))
        if selected:
            sel_glow = QColor(GOLD["edge"])
            sel_glow.setAlpha(120)
            p.setPen(QPen(sel_glow, 1))
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.drawRoundedRect(r.adjusted(-1.5, -1.5, 1.5, 1.5), 6, 6)
        p.restore()

    def sizeHint(self, opt: QStyleOptionViewItem, index: QModelIndex) -> QSize:  # noqa: N802
        return QSize(104, 104)


def gallery_tooltip(meta: Dict[str, Any], path: str) -> str:
    """Tooltip text for a gallery / tile thumbnail."""
    tip = elide(meta.get("prompt", os.path.basename(path)), 140)
    if meta.get("seed") is not None or meta.get("width"):
        tip += f"\nSeed {meta.get('seed')} \u2022 {meta.get('width')}x{meta.get('height')} \u2022 {meta.get('model', '')}"
    if isinstance(meta.get("aesthetic"), (int, float)):
        tip += f"\n\u2605 aesthetic {float(meta['aesthetic']):.2f}"
    return tip


class Gallery(QListWidget):
    """Horizontal strip with the newest renders: the temp ring, plus recent
    output-folder files when direct saving is enabled."""
    ROLE_PATH = Qt.ItemDataRole.UserRole
    open_requested = pyqtSignal(str)

    def __init__(self, parent: Optional[QWidget] = None):
        super().__init__(parent)
        self.setViewMode(QListView.ViewMode.IconMode)
        self.setFlow(QListView.Flow.LeftToRight)
        self.setWrapping(False)
        self.setMovement(QListView.Movement.Static)
        self.setResizeMode(QListView.ResizeMode.Adjust)
        self.setUniformItemSizes(True)
        self.setSpacing(2)
        self.setFixedHeight(126)
        self.setMouseTracking(True)
        self.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAsNeeded)
        self.setVerticalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        self.setSelectionMode(QAbstractItemView.SelectionMode.SingleSelection)
        self.setItemDelegate(ThumbDelegate(self))
        self.setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)
        self.itemDoubleClicked.connect(lambda it: self.open_requested.emit(it.data(self.ROLE_PATH)))

    def set_paths(self, paths: List[str], keep: Optional[str] = None) -> None:
        current = keep or self.current_path()
        self.clear()
        for path in paths:
            it = QListWidgetItem()
            it.setData(self.ROLE_PATH, path)
            meta = read_image_metadata(path)
            it.setData(ThumbDelegate.ROLE_META, meta)
            reader = QImageReader(path)
            reader.setAutoTransform(True)
            size = reader.size()
            if size.isValid():
                reader.setScaledSize(size.scaled(QSize(160, 160), Qt.AspectRatioMode.KeepAspectRatio))
            img = reader.read()
            it.setData(ThumbDelegate.ROLE_PIX, QPixmap.fromImage(img) if not img.isNull() else QPixmap())
            it.setToolTip(gallery_tooltip(meta, path))
            self.addItem(it)
            if path == current:
                it.setSelected(True)
                self.setCurrentItem(it)

    def refresh_item_meta(self, path: str) -> None:
        """Re-read metadata for one item (e.g. after an aesthetic score)."""
        for i in range(self.count()):
            it = self.item(i)
            if it.data(self.ROLE_PATH) == path:
                meta = read_image_metadata(path)
                it.setData(ThumbDelegate.ROLE_META, meta)
                it.setToolTip(gallery_tooltip(meta, path))
                break
        self.viewport().update()

    def current_path(self) -> Optional[str]:
        it = self.currentItem()
        return it.data(self.ROLE_PATH) if it else None

    def select_path(self, path: str) -> None:
        for i in range(self.count()):
            it = self.item(i)
            if it.data(self.ROLE_PATH) == path:
                self.setCurrentItem(it)
                it.setSelected(True)
                self.scrollToItem(it)
                return


class ImageViewer(QScrollArea):
    """Fit-to-window / 1:1 viewer with a bevelled dark stage.

    v1.8.0: full zoom & pan on top of the classic fit mode -
      * Ctrl+wheel zooms towards the cursor (5 % ... 800 %),
      * the left button drags the image when zoomed in,
      * set_zoom() / zoom_by() drive the external toolbar controls,
      * a zoom_changed signal keeps the percentage label in sync.
    The currently displayed pixmap is cached per size, so repeated wheel
    steps reuse the same scaled buffer until the zoom actually changes."""
    toggled_fit = pyqtSignal(bool)
    zoom_changed = pyqtSignal(float)
    MIN_ZOOM, MAX_ZOOM = 0.05, 8.0

    def __init__(self, parent: Optional[QWidget] = None):
        super().__init__(parent)
        self.setObjectName("Sunken")
        self.setWidgetResizable(True)
        self.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.label = QLabel()
        self.label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.label.setObjectName("Transparent")
        self.label.setMinimumSize(1, 1)
        self.setWidget(self.label)
        self.pix: Optional[QPixmap] = None
        self.path: Optional[str] = None
        self.meta: Dict[str, Any] = {}
        self.fit = True
        self.zoom = 1.0
        self._scaled: Optional[QPixmap] = None
        self._scaled_zoom = -1.0
        self._panning = False
        self._pan_start = QPoint()
        self._pan_h0 = 0
        self._pan_v0 = 0
        self._show_placeholder()

    # ------------------------------------------------------------------ content
    def _show_placeholder(self) -> None:
        self.label.setPixmap(QPixmap())
        self._scaled = None
        self._scaled_zoom = -1.0
        self.label.setText(f"<div style='color:{PAL['dim']}; font-size:13pt; font-weight:bold; letter-spacing:2px'>NO IMAGE</div>"
                           f"<div style='color:{PAL['dimmer']}; font-size:10pt; margin-top:6px'>Type a prompt and press GENERATE<br>"
                           "Finished renders appear here and in the gallery strip</div>")

    def set_image(self, path: Optional[str]) -> None:
        self.path = path
        if not path or not os.path.exists(path):
            self.pix = None
            self.meta = {}
            self._show_placeholder()
            return
        reader = QImageReader(path)
        reader.setAutoTransform(True)
        img = reader.read()
        self.pix = QPixmap.fromImage(img) if not img.isNull() else None
        self.meta = read_image_metadata(path)
        self._scaled = None
        self._scaled_zoom = -1.0
        if self.pix is None:
            self.label.setText(f"<span style='color:{PAL['err']}'>Cannot decode this image</span>")
            return
        self.label.setText("")
        self._refresh()

    # ------------------------------------------------------------------ modes
    def set_fit(self, fit: bool) -> None:
        if self.fit != fit:
            self.fit = fit
            if fit:
                self.zoom = 1.0
            self._refresh()
            self.toggled_fit.emit(fit)
            self.zoom_changed.emit(self.current_zoom())

    def current_zoom(self) -> float:
        """Effective zoom factor (fit mode reports the downscale ratio)."""
        if self.pix is None:
            return 1.0
        if self.fit:
            area = self.viewport().size() - QSize(6, 6)
            if area.width() < 2 or area.height() < 2 or self.pix.width() < 1:
                return 1.0
            return min(area.width() / self.pix.width(), area.height() / self.pix.height())
        return self.zoom

    def set_zoom(self, z: float, anchor: Optional[QPoint] = None) -> None:
        z = max(self.MIN_ZOOM, min(self.MAX_ZOOM, float(z)))
        if self.pix is None or (not self.fit and abs(z - self.zoom) < 1e-4):
            return
        was_fit = self.fit
        old_zoom = self.current_zoom()
        self.fit = False
        self.zoom = z
        if was_fit:
            self.toggled_fit.emit(False)
        self._apply_zoom(old_zoom, z, anchor)
        self.zoom_changed.emit(z)

    def zoom_by(self, factor: float, anchor: Optional[QPoint] = None) -> None:
        if self.pix is None:
            return
        self.set_zoom(self.current_zoom() * factor, anchor)

    def _scaled_pixmap(self) -> QPixmap:
        """Pixmap at the current zoom (cached; fit mode scales to viewport)."""
        if self.pix is None:
            return QPixmap()
        if self.fit:
            area = self.viewport().size() - QSize(6, 6)
            return self.pix.scaled(area, Qt.AspectRatioMode.KeepAspectRatio,
                                   Qt.TransformationMode.SmoothTransformation)
        if self._scaled is None or abs(self._scaled_zoom - self.zoom) > 1e-6:
            w = max(1, int(round(self.pix.width() * self.zoom)))
            h = max(1, int(round(self.pix.height() * self.zoom)))
            mode = (Qt.TransformationMode.SmoothTransformation if self.zoom <= 1.0
                    else Qt.TransformationMode.FastTransformation)
            self._scaled = self.pix.scaled(w, h, Qt.AspectRatioMode.IgnoreAspectRatio, mode)
            self._scaled_zoom = self.zoom
        return self._scaled

    def _apply_zoom(self, old_zoom: float, new_zoom: float, anchor: Optional[QPoint]) -> None:
        """Re-render and keep the content point under `anchor` stationary."""
        if anchor is None:
            anchor = QPoint(self.viewport().width() // 2, self.viewport().height() // 2)
        old_h = self.horizontalScrollBar().value()
        old_v = self.verticalScrollBar().value()
        # content coordinate under the anchor before the change
        cx = anchor.x() + old_h
        cy = anchor.y() + old_v
        k = new_zoom / max(1e-6, old_zoom)
        self._refresh()
        # after resize: place the same content point under the anchor again
        new_h = int(cx * k - anchor.x())
        new_v = int(cy * k - anchor.y())
        self._clamp_scroll_to(new_h, new_v)

    def _clamp_scroll_to(self, h: int, v: int) -> None:
        hs, vs = self.horizontalScrollBar(), self.verticalScrollBar()
        hs.setValue(max(hs.minimum(), min(hs.maximum(), h)))
        vs.setValue(max(vs.minimum(), min(vs.maximum(), v)))

    # ------------------------------------------------------------------ events
    def wheelEvent(self, e) -> None:  # noqa: N802
        if self.pix is not None and e.modifiers() & Qt.KeyboardModifier.ControlModifier:
            steps = e.angleDelta().y() / 120.0
            if steps:
                self.zoom_by(1.1 ** steps, e.position().toPoint())
            e.accept()
            return
        super().wheelEvent(e)

    def mousePressEvent(self, e) -> None:  # noqa: N802
        if (e.button() == Qt.MouseButton.LeftButton and self.pix is not None and not self.fit):
            self._panning = True
            self._pan_start = e.globalPosition().toPoint()
            self._pan_h0 = self.horizontalScrollBar().value()
            self._pan_v0 = self.verticalScrollBar().value()
            self.setCursor(Qt.CursorShape.ClosedHandCursor)
            e.accept()
            return
        super().mousePressEvent(e)

    def mouseMoveEvent(self, e) -> None:  # noqa: N802
        if self._panning:
            pos = e.globalPosition().toPoint()
            self._clamp_scroll_to(self._pan_h0 - (pos.x() - self._pan_start.x()),
                                  self._pan_v0 - (pos.y() - self._pan_start.y()))
            e.accept()
            return
        if self.pix is not None and not self.fit:
            self.setCursor(Qt.CursorShape.OpenHandCursor if not self._panning
                           else Qt.CursorShape.ClosedHandCursor)
        super().mouseMoveEvent(e)

    def mouseReleaseEvent(self, e) -> None:  # noqa: N802
        if self._panning and e.button() == Qt.MouseButton.LeftButton:
            self._panning = False
            self.setCursor(Qt.CursorShape.OpenHandCursor)
            e.accept()
            return
        super().mouseReleaseEvent(e)

    def mouseDoubleClickEvent(self, e) -> None:  # noqa: N802
        if self.pix is not None:
            if self.fit:
                self.set_fit(False)           # leave fit at 1:1
                self.set_zoom(1.0)
            else:
                self.set_fit(True)
        super().mouseDoubleClickEvent(e)

    def resizeEvent(self, e) -> None:  # noqa: N802
        super().resizeEvent(e)
        if self.pix is not None and self.fit:
            self._refresh()
            self.zoom_changed.emit(self.current_zoom())

    def leaveEvent(self, e) -> None:  # noqa: N802
        if not self._panning:
            self.unsetCursor()
        super().leaveEvent(e)

    # ------------------------------------------------------------------ render
    def _refresh(self) -> None:
        if self.pix is None:
            return
        if self.fit:
            self.setWidgetResizable(True)
            self.label.setPixmap(self._scaled_pixmap())
        else:
            self.setWidgetResizable(False)
            pm = self._scaled_pixmap()
            self.label.setPixmap(pm)
            self.label.resize(pm.size())


