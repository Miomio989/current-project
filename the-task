    app.match.start_match(GameMode.ARCADE, 0, 1, 0)
    app.match.phase = RoundPhase.FIGHT_ACTIVE
    app.match.ann_alpha = 0
    for _ in range(30):
        app.match.render(app.canvas)
    tb0 = time.perf_counter()
    for _ in range(300):
        # Drive P1 with AI too during benchmark so real combat, clashes & slashes execute!
        p1_in = app.match.ai.decide(app.match.p1, app.match.p2)
        p2_in = app.match.ai.decide(app.match.p2, app.match.p1)
        app.match.p1.handle_input(p1_in[0], p1_in[1], p1_in[2], app.match.p2, app.audio, app.match.vfx, app.stage)
        app.match.p2.handle_input(p2_in[0], p2_in[1], p2_in[2], app.match.p1, app.audio, app.match.vfx, app.stage)
        app.match.p1.step_physics(app.match.p2, app.audio, app.match.vfx, app.stage)
        app.match.p2.step_physics(app.match.p1, app.audio, app.match.vfx, app.stage)
        app.match.resolver.resolve_frame(app.match.p1, app.match.p2)
        app.stage.update(FIXED_DT)
        app.match.vfx.update(FIXED_DT)
        app.match.cam.update(app.match.p1, app.match.p2, FIXED_DT)
        app.match.render(app.canvas)
    tb = time.perf_counter() - tb0
    fps_est = 300.0 / max(1e-4, tb)
    print(f"[QA] 300-Frame Live Combat + Water Reflections + HUD Benchmark: {tb:.2f}s ({fps_est:.1f} FPS)")
    app.audio.shutdown()
    pygame.quit()
    return 0


