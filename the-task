def _find_ttf_font(serif: bool, bold: bool) -> Optional[str]:
    candidates = (
        (
            "/usr/share/fonts/truetype/dejavu/DejaVuSerif-Bold.ttf",
            "/usr/share/fonts/truetype/liberation/LiberationSerif-Bold.ttf",
            "/usr/share/fonts/truetype/freefont/FreeSerifBold.ttf",
            "C:/Windows/Fonts/georgiab.ttf",
            "C:/Windows/Fonts/timesbd.ttf",
            "/System/Library/Fonts/Supplemental/Georgia Bold.ttf",
        )
        if (serif and bold)
        else (
            "/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf",
            "/usr/share/fonts/truetype/liberation/LiberationSerif-Regular.ttf",
            "C:/Windows/Fonts/georgia.ttf",
            "/System/Library/Fonts/Supplemental/Georgia.ttf",
        )
        if serif
        else (
            "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
            "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
            "C:/Windows/Fonts/arialbd.ttf",
        )
    )
    for path in candidates:
        if os.path.isfile(path):
            return path
    return None


def _load_crisp_font(size: int, serif: bool = True, bold: bool = True, italic: bool = False) -> pygame.font.Font:
    ttf = _find_ttf_font(serif=serif, bold=bold)
    if ttf is not None:
        f = pygame.font.Font(ttf, size)
        f.set_italic(italic)
        return f
    fam = "georgia,timesnewroman,serif" if serif else "dejavusans,arial,sans-serif"
    return pygame.font.SysFont(fam, size, bold=bold, italic=italic)


def bake_stylish_rank_emblems(
    rast: PainterlyCGRasterizer,
) -> Dict[StyleRank, pygame.Surface]:
    """
    Pre-bake Devil May Cry 4 / mockup.jpg slashed gothic rank emblems (D -> SSS)
    with fiery crimson-gold bevels, diagonal katana split lines, and inner bloom.
    """
    emblems: Dict[StyleRank, pygame.Surface] = {}
    font_big = _load_crisp_font(40, serif=True, bold=True, italic=True)

    for rank in StyleRank:
        if rank == StyleRank.NONE:
            continue
        surf = pygame.Surface((132, 62), pygame.SRCALPHA)
        text = rank.glyph
        base_col = rank.color
        hi_col = screen_rgb(base_col, (180, 120, 140))
        deep_col = scale_rgb(base_col, 0.32)

        # Back crimson energy flare for S/SS/SSS
        if rank.tier >= 5:
            rast.stamp_bloom(surf, 62, 32, 44, (242, 24, 86), alpha=155, additive=False)
            rast.stamp_bloom(surf, 62, 32, 26, base_col, alpha=145, additive=True)

        # Heavy gothic drop shadow + dark crimson outline
        shadow = font_big.render(text, True, (24, 4, 14))
        for ox, oy in ((-2, 2), (2, 2), (0, 3), (-2, -1), (2, -1)):
            surf.blit(shadow, (12 + ox, 8 + oy))

        # Metallic gradient pass: lower deep, upper bright
        glyph_surf = font_big.render(text, True, hi_col).convert_alpha()
        gw, gh = glyph_surf.get_size()
        grad_overlay = pygame.Surface((gw, gh), pygame.SRCALPHA)
        for row in range(gh):
            u = row / float(max(1, gh - 1))
            if u < 0.42:
                c = lerp_rgb((255, 250, 244), hi_col, u / 0.42)
            elif u < 0.62:
                c = lerp_rgb(hi_col, base_col, (u - 0.42) / 0.20)
            else:
                c = lerp_rgb(base_col, deep_col, (u - 0.62) / 0.38)
            pygame.draw.line(grad_overlay, (c[0], c[1], c[2], 255), (0, row), (gw - 1, row))
        grad_overlay.blit(glyph_surf, (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
        surf.blit(grad_overlay, (12, 8))

        # Diagonal DMC katana slash rift slicing cleanly across the emblem!
        pygame.draw.line(surf, (255, 242, 248, 235), (6, 42), (gw + 22, 18), 2)
        pygame.draw.line(surf, (255, 42, 102, 200), (4, 44), (gw + 24, 20), 2)
        emblems[rank] = surf
    return emblems


class FontManager:
    """Gothic serif & crisp tactical HUD font cache with drop-shadow helpers."""

    def __init__(self) -> None:
        self._cache: Dict[Tuple[str, int, bool, bool], pygame.font.Font] = {}

    def get(
        self,
        size: int,
        serif: bool = True,
        bold: bool = True,
        italic: bool = False,
    ) -> pygame.font.Font:
        key = ("serif" if serif else "sans", size, bold, italic)
        f = self._cache.get(key)
        if f is None:
            f = _load_crisp_font(size, serif=serif, bold=bold, italic=italic)
            self._cache[key] = f
        return f

    def draw_text(
        self,
        dest: pygame.Surface,
        text: str,
        pos: Tuple[int, int],
        size: int = 16,
        color: RGB = (244, 236, 246),
        shadow_color: Optional[RGB] = (14, 4, 12),
        serif: bool = True,
        bold: bool = True,
        italic: bool = False,
        align: str = "left",
        outline: bool = False,
    ) -> pygame.Rect:
        font = self.get(size, serif=serif, bold=bold, italic=italic)
        surf = font.render(text, True, color)
        rect = surf.get_rect()
        if align == "center":
            rect.midtop = pos
        elif align == "right":
            rect.topright = pos
        else:
            rect.topleft = pos

        if outline and shadow_color is not None:
            o_surf = font.render(text, True, shadow_color)
            for ox, oy in ((-1, 0), (1, 0), (0, -1), (0, 1), (1, 1)):
                dest.blit(o_surf, (rect.x + ox, rect.y + oy))
        elif shadow_color is not None:
            s_surf = font.render(text, True, shadow_color)
            dest.blit(s_surf, (rect.x + 1, rect.y + 2))
        dest.blit(surf, rect.topleft)
        return rect
