class PainterlyRasterizer:
    """High-craftsmanship painterly anime/CG rasterization toolkit for Pygame.

    Replaces crude flat polygons with smoothly shaded, 3D-volumetric, rim-lit,
    colored-ink-outlined shapes using fast SDL2 surface compositing.
    """

    def __init__(self) -> None:
        # Cached 1D gradient strips (64px) for ultra-fast smoothscale polygon shading
        self._grad_cache: Dict[Tuple[Any, ...], pygame.Surface] = {}
        # Precomputed smooth 64x64 Gaussian radial falloff kernel for true CG airbrush bloom
        self._glow_kernel: pygame.Surface = self._bake_radial_glow_kernel(64)
        self._glow_tint_cache: Dict[Tuple[int, int, int, int], pygame.Surface] = {}

    @staticmethod
    def _bake_radial_glow_kernel(size: int = 64) -> pygame.Surface:
        s = pygame.Surface((size, size), pygame.SRCALPHA)
        half = (size - 1) * 0.5
        for y in range(size):
            dy = (y - half) / half
            for x in range(size):
                dx = (x - half) / half
                d2 = dx * dx + dy * dy
                if d2 < 1.0:
                    # Premultiplied smooth Gaussian falloff so BLEND_RGBA_ADD feathers seamlessly!
                    falloff = (1.0 - d2) ** 2.6
                    v = clamp_int(int(255 * falloff), 0, 255)
                    s.set_at((x, y), (v, v, v, v))
        return s

    def _get_gradient_strip(
        self,
        c0: RGB,
        c1: RGB,
        c2: RGB,
        cylindrical: bool = False,
        rim_col: Optional[RGB] = None,
        gloss_pos: float = -1.0,
        gloss_col: Optional[RGB] = None,
        horizontal: bool = True,
    ) -> pygame.Surface:
        key = (c0, c1, c2, cylindrical, rim_col, round(gloss_pos, 2), gloss_col, horizontal)
        cached = self._grad_cache.get(key)
        if cached is not None:
            return cached

        size = 64
        w, h = (size, 1) if horizontal else (1, size)
        strip = pygame.Surface((w, h), pygame.SRCALPHA)
        for i in range(size):
            u = i / float(size - 1)
            if cylindrical:
                # 3D cylinder light curve: shadow edge -> lit belly -> soft core -> rim
                if u < 0.16:
                    col = lerp_color(c0, c1, smoothstep(u / 0.16))
                elif u < 0.56:
                    col = lerp_color(c1, c2, smoothstep((u - 0.16) / 0.40))
                elif u < 0.86:
                    col = lerp_color(c2, c0, smoothstep((u - 0.56) / 0.30))
                else:
                    rim_t = smoothstep((u - 0.86) / 0.14)
                    target = rim_col if rim_col is not None else lerp_color(c1, c2, 0.5)
                    col = lerp_color(c0, target, rim_t * 0.88)
            else:
                if u < 0.5:
                    col = lerp_color(c0, c1, u * 2.0)
                else:
                    col = lerp_color(c1, c2, (u - 0.5) * 2.0)
                if rim_col is not None and u > 0.84:
                    rt = smoothstep((u - 0.84) / 0.16)
                    col = lerp_color(col, rim_col, rt * 0.72)

            if gloss_pos >= 0.0 and gloss_col is not None:
                dist = abs(u - gloss_pos)
                if dist < 0.11:
                    gt = smoothstep(1.0 - dist / 0.11)
                    col = lerp_color(col, gloss_col, gt * 0.78)

            px = (i, 0) if horizontal else (0, i)
            strip.set_at(px, (col[0], col[1], col[2], 255))

        if len(self._grad_cache) > 1200:
            self._grad_cache.clear()
        self._grad_cache[key] = strip
        return strip

    def fill_shaded_poly(
        self,
        target: pygame.Surface,
        points: Sequence[Tuple[float, float]],
        shadow_col: RGB,
        base_col: RGB,
        light_col: RGB,
        rim_col: Optional[RGB] = None,
        outline_col: Optional[RGB] = None,
        outline_width: int = 2,
        horizontal_grad: bool = True,
        cylindrical: bool = False,
        gloss_pos: float = -1.0,
        gloss_col: Optional[RGB] = None,
        alpha: int = 255,
    ) -> None:
        """Render a polygon with smooth 3D painterly shading, rim light & anime ink."""
        if len(points) < 3:
            return
        xs = [p[0] for p in points]
        ys = [p[1] for p in points]
        min_x = int(math.floor(min(xs))) - 2
        max_x = int(math.ceil(max(xs))) + 2
        min_y = int(math.floor(min(ys))) - 2
        max_y = int(math.ceil(max(ys))) + 2
        bw = max_x - min_x
        bh = max_y - min_y
        if bw <= 1 or bh <= 1 or bw > 1400 or bh > 1400:
            return

        local_pts = [(p[0] - min_x, p[1] - min_y) for p in points]
        strip = self._get_gradient_strip(
            shadow_col,
            base_col,
            light_col,
            cylindrical=cylindrical,
            rim_col=rim_col,
            gloss_pos=gloss_pos,
            gloss_col=gloss_col,
            horizontal=horizontal_grad,
        )
        grad_surf = pygame.transform.smoothscale(strip, (bw, bh))
        mask_surf = pygame.Surface((bw, bh), pygame.SRCALPHA)
        pygame.draw.polygon(mask_surf, (255, 255, 255, clamp_int(alpha, 0, 255)), local_pts)
        grad_surf.blit(mask_surf, (0, 0), special_flags=pygame.BLEND_RGBA_MIN)
        target.blit(grad_surf, (min_x, min_y))

        if outline_col is not None and outline_width > 0:
            oc = with_alpha(outline_col, clamp_int(alpha, 0, 255))
            if outline_width == 1:
                pygame.draw.aalines(target, oc, True, points)
            else:
                pygame.draw.polygon(target, oc, points, outline_width)
                pygame.draw.aalines(target, oc, True, points)

    def draw_soft_glow(
        self,
        target: pygame.Surface,
        center: Tuple[float, float],
        radius: float,
        color: RGB,
        peak_alpha: int = 120,
        rings: int = 5,
    ) -> None:
        """Render a true smooth Gaussian airbrushed radial bloom (zero concentric rings!)."""
        _ = rings
        r = max(3, int(radius))
        a_bucket = clamp_int((peak_alpha // 6) * 6, 6, 255)
        key = (color[0], color[1], color[2], a_bucket)
        tinted = self._glow_tint_cache.get(key)
        if tinted is None:
            tinted = self._glow_kernel.copy()
            # Premultiply color by peak_alpha for true soft BLEND_RGBA_ADD airbrush!
            scale_a = a_bucket / 255.0
            mr = clamp_int(int(color[0] * scale_a), 0, 255)
            mg = clamp_int(int(color[1] * scale_a), 0, 255)
            mb = clamp_int(int(color[2] * scale_a), 0, 255)
            mult = pygame.Surface(tinted.get_size(), pygame.SRCALPHA)
            mult.fill((mr, mg, mb, a_bucket))
            tinted.blit(mult, (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
            if len(self._glow_tint_cache) > 256:
                self._glow_tint_cache.clear()
            self._glow_tint_cache[key] = tinted
        diam = r * 2
        scaled = pygame.transform.smoothscale(tinted, (diam, diam))
        target.blit(scaled, (int(center[0] - r), int(center[1] - r)), special_flags=pygame.BLEND_RGBA_ADD)

    def draw_shaded_capsule(
        self,
        target: pygame.Surface,
        a: Vec2,
        b: Vec2,
        r_a: float,
        r_b: float,
        shadow_col: RGB,
        base_col: RGB,
        light_col: RGB,
        rim_col: Optional[RGB] = None,
        outline_col: Optional[RGB] = None,
        bulge_mid: float = 0.0,
        gloss_pos: float = -1.0,
        gloss_col: Optional[RGB] = None,
        outline_width: int = 2,
    ) -> List[Tuple[float, float]]:
        """Draw a cylindrical 3D-shaded limb segment with smooth anatomical contour."""
        poly = build_tapered_capsule_poly(a, b, r_a, r_b, bulge_mid=bulge_mid)
        diff = b - a
        is_more_vertical = abs(diff.y) >= abs(diff.x) * 0.75
        self.fill_shaded_poly(
            target=target,
            points=poly,
            shadow_col=shadow_col,
            base_col=base_col,
            light_col=light_col,
            rim_col=rim_col,
            outline_col=outline_col,
            outline_width=outline_width,
            horizontal_grad=is_more_vertical,
            cylindrical=True,
            gloss_pos=gloss_pos,
            gloss_col=gloss_col,
        )
        return poly

    def draw_ruffle_lace_ribbon(
        self,
        target: pygame.Surface,
        curve_pts: Sequence[Vec2],
        depth: float,
        scallops: int,
        shadow_col: RGB,
        base_col: RGB,
        light_col: RGB,
        outline_col: RGB,
        outward_sign: float = 1.0,
    ) -> None:
        """Paint scalloped gothic lolita crimson/black lace ruffles along a hem curve."""
        n = len(curve_pts)
        if n < 2:
            return
        dense = sample_catmull_rom(curve_pts, steps_per_seg=4)
        dn = len(dense)
        if dn < 3:
            return

        top_edge: List[Tuple[float, float]] = []
        bot_edge: List[Tuple[float, float]] = []
        pleat_lines: List[Tuple[Tuple[float, float], Tuple[float, float], bool]] = []

        for i in range(dn):
            u = i / float(dn - 1)
            p = dense[i]
            if i == 0:
                t_vec = (dense[1] - dense[0]).normalized()
            elif i == dn - 1:
                t_vec = (dense[-1] - dense[-2]).normalized()
            else:
                t_vec = (dense[i + 1] - dense[i - 1]).normalized()
            nrm = t_vec.perp() * outward_sign
            wave = abs(math.sin(u * math.pi * max(2, scallops)))
            local_d = depth * (0.58 + 0.48 * wave)
            top_edge.append((p.x, p.y))
            bp = (p.x + nrm.x * local_d, p.y + nrm.y * local_d)
            bot_edge.append(bp)
            if i % max(2, dn // max(4, scallops * 2)) == 0:
                is_crest = wave > 0.65
                pleat_lines.append(((p.x, p.y), bp, is_crest))

        poly = top_edge + list(reversed(bot_edge))
        self.fill_shaded_poly(
            target=target,
            points=poly,
            shadow_col=shadow_col,
            base_col=base_col,
            light_col=light_col,
            outline_col=outline_col,
            outline_width=1,
            horizontal_grad=False,
            cylindrical=False,
        )

        # Crisp gothic fold ridges & highlights inside the ruffle
        for p0, p1, is_crest in pleat_lines:
            c = light_col if is_crest else shadow_col
            pygame.draw.line(target, c, p0, p1, 1)

    def draw_leather_buckle_strap(
        self,
        target: pygame.Surface,
        left_pt: Vec2,
        right_pt: Vec2,
        thickness: float,
        pal: CeciliaPalette,
        buckle_ratio: float = 0.62,
        show_buckle: bool = True,
    ) -> None:
        """Render a glossy gothic leather strap with metallic silver rectangular buckle."""
        diff = right_pt - left_pt
        length = diff.length()
        if length < 3.0:
            return
        fwd = Vec2(diff.x / length, diff.y / length)
        nrm = fwd.perp()
        hw = max(1.6, thickness * 0.5)

        # Slight curved leather wrap silhouette
        mid = left_pt.lerp_to(right_pt, 0.5) + nrm * (hw * 0.45)
        poly = [
            (left_pt.x - nrm.x * hw, left_pt.y - nrm.y * hw),
            (mid.x - nrm.x * hw, mid.y - nrm.y * hw),
            (right_pt.x - nrm.x * hw, right_pt.y - nrm.y * hw),
            (right_pt.x + nrm.x * hw, right_pt.y + nrm.y * hw),
            (mid.x + nrm.x * hw, mid.y + nrm.y * hw),
            (left_pt.x + nrm.x * hw, left_pt.y + nrm.y * hw),
        ]
        self.fill_shaded_poly(
            target=target,
            points=poly,
            shadow_col=pal.leather_shadow,
            base_col=pal.leather_base,
            light_col=pal.leather_gloss,
            outline_col=pal.ink_dark,
            outline_width=1,
            horizontal_grad=True,
            cylindrical=True,
            gloss_pos=0.40,
            gloss_col=pal.leather_gloss,
        )

        if show_buckle:
            bc = left_pt.lerp_to(right_pt, clamp(buckle_ratio, 0.15, 0.85))
            bw = max(2.8, thickness * 0.95)
            bh = max(2.6, thickness * 0.78)
            frame = [
                (bc.x - fwd.x * bw - nrm.x * bh, bc.y - fwd.y * bw - nrm.y * bh),
                (bc.x + fwd.x * bw - nrm.x * bh, bc.y + fwd.y * bw - nrm.y * bh),
                (bc.x + fwd.x * bw + nrm.x * bh, bc.y + fwd.y * bw + nrm.y * bh),
                (bc.x - fwd.x * bw + nrm.x * bh, bc.y - fwd.y * bw + nrm.y * bh),
            ]
            pygame.draw.polygon(target, pal.silver_shadow, frame)
            pygame.draw.polygon(target, pal.silver_bright, frame, 2)
            # Dark inner hollow + metallic prong bar
            in_bw = bw * 0.45
            in_bh = bh * 0.45
            inner = [
                (bc.x - fwd.x * in_bw - nrm.x * in_bh, bc.y - fwd.y * in_bw - nrm.y * in_bh),
                (bc.x + fwd.x * in_bw - nrm.x * in_bh, bc.y + fwd.y * in_bw - nrm.y * in_bh),
                (bc.x + fwd.x * in_bw + nrm.x * in_bh, bc.y + fwd.y * in_bw + nrm.y * in_bh),
                (bc.x - fwd.x * in_bw + nrm.x * in_bh, bc.y - fwd.y * in_bw + nrm.y * in_bh),
            ]
            pygame.draw.polygon(target, pal.leather_shadow, inner)
            pygame.draw.line(
                target,
                pal.silver_bright,
                (bc.x - fwd.x * bw * 0.8, bc.y - fwd.y * bw * 0.8),
                (bc.x + fwd.x * bw * 0.4, bc.y + fwd.y * bw * 0.4),
                1,
            )

    def draw_anime_golden_eye(
        self,
        target: pygame.Surface,
        center: Vec2,
        width: float,
        height: float,
        pal: CeciliaPalette,
        facing_sign: float = 1.0,
        gaze_offset: Vec2 = Vec2(0.0, 0.0),
        openness: float = 1.0,
        fierce: float = 0.0,
        glowing: bool = False,
    ) -> None:
        """Render Cecilia's iconic vibrant golden-yellow Danbooru/Pixiv anime eye."""
        if width < 2.2 or height < 1.5:
            return
        hw = width * 0.5
        hh = max(1.2, height * 0.5 * clamp(openness, 0.08, 1.25))

        if openness < 0.22:
            # Closed noble serene eyelid curve
            p0 = Vec2(center.x - hw, center.y - hh * 0.2)
            p1 = Vec2(center.x, center.y + height * 0.28)
            p2 = Vec2(center.x + hw, center.y - hh * 0.35)
            pts = [(p.x, p.y) for p in sample_quad_bezier(p0, p1, p2, 8)]
            pygame.draw.lines(target, pal.ink_dark, False, pts, max(2, int(width * 0.14)))
            return

        # Sclera almond polygon
        top_tilt = -fierce * hh * 0.42 * facing_sign
        p_in = Vec2(center.x - hw * facing_sign, center.y + hh * 0.15)
        p_out = Vec2(center.x + hw * facing_sign, center.y - hh * 0.12)
        p_top = Vec2(center.x + hw * 0.08 * facing_sign, center.y - hh + top_tilt)
        p_bot = Vec2(center.x, center.y + hh * 0.85)

        upper_arc = sample_quad_bezier(p_in, p_top, p_out, 8)
        lower_arc = sample_quad_bezier(p_out, p_bot, p_in, 8)
        sclera_poly = [(p.x, p.y) for p in (upper_arc + lower_arc[1:])]
        pygame.draw.polygon(target, (248, 244, 250), sclera_poly)

        # Subtle cool upper sclera shadow
        sh_arc = [Vec2(p.x, p.y + hh * 0.28) for p in upper_arc]
        sh_poly = [(p.x, p.y) for p in (upper_arc + list(reversed(sh_arc)))]
        if len(sh_poly) >= 3:
            pygame.draw.polygon(target, (208, 198, 222), sh_poly)

        # Vibrant golden iris positioned by gaze vector
        iris_r_x = max(1.8, width * 0.34)
        iris_r_y = max(1.8, hh * 0.96)
        ix = center.x + gaze_offset.x * width * 0.18
        iy = center.y + gaze_offset.y * hh * 0.15 + hh * 0.05

        if glowing:
            self.draw_soft_glow(target, (ix, iy), max(iris_r_x, iris_r_y) * 1.45, pal.eye_mid, peak_alpha=72, rings=4)

        # Iris outer amber rim -> vibrant yellow center -> lower luminous crescent
        iris_pts: List[Tuple[float, float]] = []
        for k in range(14):
            a = (math.tau * k) / 14.0
            px = ix + math.cos(a) * iris_r_x
            py = iy + math.sin(a) * iris_r_y
            # Clamp vertically within open eyelid
            py = clamp(py, center.y - hh * 0.92, center.y + hh * 0.86)
            iris_pts.append((px, py))

        self.fill_shaded_poly(
            target=target,
            points=iris_pts,
            shadow_col=pal.eye_outer,
            base_col=pal.eye_mid,
            light_col=pal.eye_glow,
            outline_col=pal.ink_dark,
            outline_width=1,
            horizontal_grad=False,
            cylindrical=False,
        )

        # Luminous golden lower-crescent anime bounce highlight inside iris
        if iris_r_x >= 3.0:
            cres_r_x = iris_r_x * 0.62
            cres_r_y = iris_r_y * 0.42
            cres_rect = pygame.Rect(
                int(ix - cres_r_x),
                int(iy + iris_r_y * 0.05),
                max(2, int(cres_r_x * 2)),
                max(2, int(cres_r_y * 1.4)),
            )
            pygame.draw.ellipse(target, pal.eye_glow, cres_rect)

        # Sharp vertical dark pupil
        pup_w = max(1.2, iris_r_x * 0.42)
        pup_h = max(1.6, iris_r_y * 0.56)
        pup_rect = pygame.Rect(int(ix - pup_w), int(iy - pup_h * 0.65), max(2, int(pup_w * 2)), max(2, int(pup_h * 1.35)))
        pygame.draw.ellipse(target, pal.eye_pupil, pup_rect)

        # Twin specular anime catchlights (key to cute/expressive Pixiv/Danbooru look!)
        hl_r = max(1, int(iris_r_x * 0.30))
        pygame.draw.circle(
            target,
            (255, 255, 255),
            (int(ix - iris_r_x * 0.36), int(iy - iris_r_y * 0.34)),
            hl_r,
        )
        if iris_r_x >= 4.0:
            pygame.draw.circle(
                target,
                (255, 252, 238),
                (int(ix + iris_r_x * 0.38), int(iy + iris_r_y * 0.32)),
                max(1, hl_r // 2),
            )

        # Thick dramatic upper eyelash ribbon with cute outer wing flick
        lash_w = [max(1.2, width * (0.10 + 0.14 * math.sin(math.pi * i / float(len(upper_arc) - 1)))) for i in range(len(upper_arc))]
        lash_poly = build_tapered_ribbon(upper_arc, lash_w, bias=-0.35)
        if len(lash_poly) >= 3:
            pygame.draw.polygon(target, pal.ink_dark, lash_poly)
        # Outer lash flick
        flick_tip = Vec2(p_out.x + width * 0.18 * facing_sign, p_out.y - height * 0.24)
        pygame.draw.line(target, pal.ink_dark, (p_out.x, p_out.y), (flick_tip.x, flick_tip.y), max(1, int(width * 0.10)))
        # Delicate lower lash line
        pygame.draw.lines(target, pal.ink_warm, False, [(p.x, p.y) for p in lower_arc[1:-1]], 1)

    def draw_demonic_greatsword(
        self,
        target: pygame.Surface,
        hilt_pos: Vec2,
        tip_pos: Vec2,
        pal: CeciliaPalette,
        plane: SwordPlane = SwordPlane.FLAT_FACING,
        blade_roll_deg: float = 0.0,
        persp_scale: float = 1.0,
        aura_intensity: float = 1.0,
        phase: float = 0.0,
    ) -> None:
        """Render Cecilia's massive gothic-demonic two-handed sword '呪いの刃'.

        Faithfully captures char.jpg: diamond ruby pommel, wrapped obsidian grip,
        swept winged demonic crossguard with crimson diamond filigree, broad
        tapered obsidian blade with baroque tip scrollwork, glowing crimson runes
        down the fuller, and swirling dark-crimson/violet cursed flames.
        """
        axis = tip_pos - hilt_pos
        total_len = axis.length()
        if total_len < 12.0:
            return
        fwd = Vec2(axis.x / total_len, axis.y / total_len)
        nrm = fwd.perp()

        # Perspective blade-width factor based on SwordPlane & blade roll
        roll_cos = abs(math.cos(math.radians(blade_roll_deg)))
        if plane == SwordPlane.EDGE_ON:
            width_factor = max(0.24, 0.30 * roll_cos + 0.14)
        elif plane == SwordPlane.THREE_QUARTER:
            width_factor = max(0.55, 0.72 * roll_cos + 0.16)
        elif plane == SwordPlane.FORESHORTENED_THRUST:
            width_factor = 0.92
        elif plane == SwordPlane.SPINNING_BLUR:
            width_factor = 1.15
        else:
            width_factor = max(0.68, 0.96 * roll_cos + 0.12)

        s = persp_scale
        grip_len = clamp(total_len * 0.21, 20.0 * s, 44.0 * s)
        guard_pos = hilt_pos + fwd * grip_len
        blade_len = max(18.0, total_len - grip_len)

        base_half_w = clamp(blade_len * 0.108, 7.0 * s, 21.0 * s) * width_factor
        mid_half_w = base_half_w * 0.86
        neck_half_w = base_half_w * 0.68
        flare_half_w = base_half_w * 1.16

        # ------------------------------------------------------------------
        # PASS 1: Eerie coiling cursed flame aura hugging the blade (char.jpg!)
        # ------------------------------------------------------------------
        if aura_intensity > 0.05:
            ai = clamp(aura_intensity, 0.0, 2.0)
            # Sleek airbrushed crimson glow along fuller channel (no giant circle blobs!)
            for step in range(4):
                u = 0.16 + step * 0.22
                bp = guard_pos + fwd * (blade_len * u)
                rad = (base_half_w * 1.45 + 9.0 * s) * (1.0 - u * 0.22) * min(1.35, ai)
                self.draw_soft_glow(target, (bp.x, bp.y), rad, pal.aura_primary, peak_alpha=clamp_int(int(48 * ai), 12, 110))

            # Delicate smoky coiling crimson & violet flame ribbons rising off edges
            aura_surf = pygame.Surface(target.get_size(), pygame.SRCALPHA)
            for wisp in range(5):
                side = -1.0 if (wisp % 2 == 0) else 1.0
                start_u = 0.10 + wisp * 0.17
                w_spine: List[Vec2] = []
                w_widths: List[float] = []
                for k in range(8):
                    ku = k / 7.0
                    bu = min(0.99, start_u + ku * 0.30)
                    swirl = math.sin(phase * 3.8 + wisp * 1.9 + ku * 5.0) * 6.5 * s
                    lat = side * (base_half_w * (0.85 + ku * 1.10)) + swirl
                    pt = guard_pos + fwd * (blade_len * bu) + nrm * lat
                    w_spine.append(pt)
                    w_widths.append(max(0.6, math.sin(ku * math.pi) * 4.4 * s * min(1.4, ai)))
                w_poly = build_tapered_ribbon(w_spine, w_widths)
                if len(w_poly) >= 3:
                    col_w = pal.aura_secondary if (wisp % 2 == 1) else pal.aura_primary
                    pygame.draw.polygon(aura_surf, with_alpha(col_w, clamp_int(int(96 * ai), 30, 165)), w_poly)
            target.blit(aura_surf, (0, 0))

        # ------------------------------------------------------------------
        # PASS 2: Two-handed leather grip & glowing crimson crystal pommel
        # ------------------------------------------------------------------
        pommel_tip = hilt_pos - fwd * (11.0 * s)
        pommel_poly = [
            (pommel_tip.x, pommel_tip.y),
            (hilt_pos.x + nrm.x * 5.2 * s - fwd.x * 3.0 * s, hilt_pos.y + nrm.y * 5.2 * s - fwd.y * 3.0 * s),
            (hilt_pos.x + fwd.x * 3.0 * s, hilt_pos.y + fwd.y * 3.0 * s),
            (hilt_pos.x - nrm.x * 5.2 * s - fwd.x * 3.0 * s, hilt_pos.y - nrm.y * 5.2 * s - fwd.y * 3.0 * s),
        ]
        self.fill_shaded_poly(
            target,
            pommel_poly,
            pal.rune_glow_outer,
            pal.accent_base,
            pal.rune_glow_core,
            outline_col=pal.ink_dark,
            outline_width=1,
            horizontal_grad=False,
        )

        # Cross-wrapped hilt cylinder
        self.draw_shaded_capsule(
            target,
            hilt_pos,
            guard_pos,
            3.8 * s,
            4.5 * s,
            pal.leather_shadow,
            pal.leather_base,
            pal.leather_gloss,
            outline_col=pal.ink_dark,
            outline_width=1,
        )
        # Diamond grip wrapping ticks
        wrap_steps = 5
        for wi in range(1, wrap_steps):
            wp = hilt_pos.lerp_to(guard_pos, wi / float(wrap_steps))
            p_l = wp - nrm * (4.0 * s) - fwd * (2.0 * s)
            p_r = wp + nrm * (4.0 * s) + fwd * (2.0 * s)
            pygame.draw.line(target, pal.blade_filigree, (p_l.x, p_l.y), (p_r.x, p_r.y), 1)

        # ------------------------------------------------------------------
        # PASS 3: Broad obsidian demonic blade with beveled facets & runes
        # ------------------------------------------------------------------
        b_root = guard_pos + fwd * (3.0 * s)
        b_flare = guard_pos + fwd * (blade_len * 0.14)
        b_waist = guard_pos + fwd * (blade_len * 0.28)
        b_belly = guard_pos + fwd * (blade_len * 0.72)
        b_shoulder = guard_pos + fwd * (blade_len * 0.86)

        # Full silhouette with subtle demonic flared ricasso & needle tip
        left_side = [
            b_root + nrm * (base_half_w * 0.92),
            b_flare + nrm * flare_half_w,
            b_waist + nrm * (base_half_w * 0.88),
            b_belly + nrm * mid_half_w,
            b_shoulder + nrm * neck_half_w,
            tip_pos,
        ]
        right_side = [
            b_shoulder - nrm * neck_half_w,
            b_belly - nrm * mid_half_w,
            b_waist - nrm * (base_half_w * 0.88),
            b_flare - nrm * flare_half_w,
            b_root - nrm * (base_half_w * 0.92),
        ]
        blade_poly = [(p.x, p.y) for p in (left_side + right_side)]

        # Glowing crimson edge aura outline
        pygame.draw.polygon(target, pal.rune_glow_outer, blade_poly, max(2, int(3.0 * s)))

        # Left bevel facet (lit obsidian steel) & Right bevel facet (deep shadowed steel)
        left_facet = [(p.x, p.y) for p in left_side] + [(b_root.x, b_root.y)]
        right_facet = [(b_root.x, b_root.y), (tip_pos.x, tip_pos.y)] + [(p.x, p.y) for p in right_side]

        self.fill_shaded_poly(
            target,
            left_facet,
            pal.blade_steel,
            pal.blade_edge,
            lerp_color(pal.blade_edge, (255, 240, 244), 0.35),
            rim_col=pal.rune_glow_outer,
            outline_col=pal.ink_dark,
            outline_width=1,
            horizontal_grad=False,
        )
        self.fill_shaded_poly(
            target,
            right_facet,
            pal.blade_shadow,
            pal.blade_steel,
            pal.blade_filigree,
            rim_col=pal.rune_glow_outer,
            outline_col=pal.ink_dark,
            outline_width=1,
            horizontal_grad=False,
        )

        # Dark recessed center fuller channel containing glowing crimson runes
        fuller_w = max(1.8, base_half_w * 0.38)
        f_start = guard_pos + fwd * (blade_len * 0.12)
        f_end = guard_pos + fwd * (blade_len * 0.74)
        fuller_poly = [
            (f_start.x + nrm.x * fuller_w, f_start.y + nrm.y * fuller_w),
            (f_end.x + nrm.x * (fuller_w * 0.65), f_end.y + nrm.y * (fuller_w * 0.65)),
            (f_end.x + fwd.x * (blade_len * 0.06), f_end.y + fwd.y * (blade_len * 0.06)),
            (f_end.x - nrm.x * (fuller_w * 0.65), f_end.y - nrm.y * (fuller_w * 0.65)),
            (f_start.x - nrm.x * fuller_w, f_start.y - nrm.y * fuller_w),
        ]
        pygame.draw.polygon(target, pal.blade_shadow, fuller_poly)
        pygame.draw.polygon(target, pal.blade_filigree, fuller_poly, 1)

        # Luminous etched demonic runes pulsing down the fuller channel!
        pulse = 0.72 + 0.28 * math.sin(phase * 5.0)
        rune_col_outer = lerp_color(pal.rune_glow_outer, pal.rune_glow_core, 0.25 * pulse)
        rune_col_core = lerp_color(pal.rune_glow_outer, pal.rune_glow_core, 0.85 * pulse)
        rune_count = 7
        for ri in range(rune_count):
            ru = 0.17 + (ri / float(rune_count)) * 0.54
            rc = guard_pos + fwd * (blade_len * ru)
            rs = max(2.2, fuller_w * 0.68)
            p_a = rc - fwd * rs
            p_b = rc + fwd * rs
            pygame.draw.line(target, rune_col_outer, (p_a.x, p_a.y), (p_b.x, p_b.y), max(2, int(2.6 * s)))
            pygame.draw.line(target, rune_col_core, (p_a.x, p_a.y), (p_b.x, p_b.y), 1)
            # Distinct geometric rune cross-strokes
            kind = ri % 3
            if kind == 0:
                pygame.draw.line(
                    target,
                    rune_col_core,
                    (rc.x - nrm.x * rs, rc.y - nrm.y * rs),
                    (rc.x + nrm.x * rs + fwd.x * rs * 0.5, rc.y + nrm.y * rs + fwd.y * rs * 0.5),
                    1,
                )
            elif kind == 1:
                pygame.draw.line(
                    target,
                    rune_col_core,
                    (p_a.x + nrm.x * rs, p_a.y + nrm.y * rs),
                    (p_b.x - nrm.x * rs, p_b.y - nrm.y * rs),
                    1,
                )
            else:
                pygame.draw.line(
                    target,
                    rune_col_core,
                    (rc.x - nrm.x * rs, rc.y - nrm.y * rs),
                    (rc.x + nrm.x * rs, rc.y + nrm.y * rs),
                    1,
                )

        # Baroque filigree chevron etched near the blade tip
        tip_f = guard_pos + fwd * (blade_len * 0.80)
        pygame.draw.lines(
            target,
            pal.blade_edge,
            False,
            [
                (tip_f.x + nrm.x * neck_half_w * 0.7 - fwd.x * 6.0 * s, tip_f.y + nrm.y * neck_half_w * 0.7 - fwd.y * 6.0 * s),
                (tip_f.x + fwd.x * 10.0 * s, tip_f.y + fwd.y * 10.0 * s),
                (tip_f.x - nrm.x * neck_half_w * 0.7 - fwd.x * 6.0 * s, tip_f.y - nrm.y * neck_half_w * 0.7 - fwd.y * 6.0 * s),
            ],
            1,
        )

        # ------------------------------------------------------------------
        # PASS 4: Ornate Gothic Winged Crossguard with Glowing Crimson Core
        # ------------------------------------------------------------------
        wing_span = clamp(blade_len * 0.24, 18.0 * s, 40.0 * s) * max(0.55, width_factor)
        guard_poly = [
            # Top center spire extending slightly onto blade
            guard_pos + fwd * (14.0 * s),
            # Left swept demonic horn/wing
            guard_pos + fwd * (8.0 * s) + nrm * (wing_span * 0.56),
            guard_pos + fwd * (16.0 * s) + nrm * (wing_span * 0.94),
            guard_pos + fwd * (3.0 * s) + nrm * (wing_span * 1.06),
            guard_pos - fwd * (8.0 * s) + nrm * (wing_span * 0.62),
            # Bottom throat
            guard_pos - fwd * (6.0 * s),
            # Right swept demonic horn/wing
            guard_pos - fwd * (8.0 * s) - nrm * (wing_span * 0.62),
            guard_pos + fwd * (3.0 * s) - nrm * (wing_span * 1.06),
            guard_pos + fwd * (16.0 * s) - nrm * (wing_span * 0.94),
            guard_pos + fwd * (8.0 * s) - nrm * (wing_span * 0.56),
        ]
        self.fill_shaded_poly(
            target,
            [(p.x, p.y) for p in guard_poly],
            pal.blade_shadow,
            pal.blade_steel,
            pal.blade_edge,
            rim_col=pal.rune_glow_outer,
            outline_col=pal.ink_dark,
            outline_width=2,
            horizontal_grad=True,
        )
        # Central crimson demon-eye diamond gem inside crossguard
        gem_c = guard_pos + fwd * (3.0 * s)
        gem_r = max(3.0, 6.0 * s * max(0.6, width_factor))
        gem_poly = [
            (gem_c.x + fwd.x * gem_r * 1.4, gem_c.y + fwd.y * gem_r * 1.4),
            (gem_c.x + nrm.x * gem_r, gem_c.y + nrm.y * gem_r),
            (gem_c.x - fwd.x * gem_r * 1.2, gem_c.y - fwd.y * gem_r * 1.2),
            (gem_c.x - nrm.x * gem_r, gem_c.y - nrm.y * gem_r),
        ]
        pygame.draw.polygon(target, pal.rune_glow_outer, gem_poly)
        pygame.draw.polygon(target, pal.rune_glow_core, [(gem_c.x + (px - gem_c.x) * 0.45, gem_c.y + (py - gem_c.y) * 0.45) for (px, py) in gem_poly])
        pygame.draw.polygon(target, pal.ink_dark, gem_poly, 1)

    def draw_perspective_slash_arc(
        self,
        target: pygame.Surface,
        center: Vec2,
        rx: float,
        ry: float,
        start_deg: float,
        end_deg: float,
        thickness: float,
        pal: CeciliaPalette,
        tilt_deg: float = 0.0,
        intensity: float = 1.0,
        is_thrust: bool = False,
    ) -> None:
        """Draw dramatic, perspective-foreshortened curved anime sword slash arcs!

        Handles horizontal foreshortened ellipses, diagonal cleaves, vertical
        guillotine crescents, and spiral crimson thrust cones — giving authentic
        KOF XIII / BlazBlue / Samurai Shodown hand-drawn slash impact.
        """
        if intensity <= 0.02:
            return
        slash_surf = pygame.Surface(target.get_size(), pygame.SRCALPHA)

        if is_thrust:
            # Piercing conical spiral lance beam for Cursed Fang / Thrust attacks
            rad_ang = math.radians(tilt_deg)
            fwd = Vec2(math.cos(rad_ang), math.sin(rad_ang))
            nrm = fwd.perp()
            length = max(rx, ry) * 1.45
            p0 = center - fwd * (length * 0.25)
            p1 = center + fwd * length
            cone_outer = [
                (p0.x + nrm.x * thickness * 1.4, p0.y + nrm.y * thickness * 1.4),
                (p1.x, p1.y),
                (p0.x - nrm.x * thickness * 1.4, p0.y - nrm.y * thickness * 1.4),
            ]
            cone_inner = [
                (p0.x + nrm.x * thickness * 0.55, p0.y + nrm.y * thickness * 0.55),
                (p1.x + fwd.x * 12.0, p1.y + fwd.y * 12.0),
                (p0.x - nrm.x * thickness * 0.55, p0.y - nrm.y * thickness * 0.55),
            ]
            pygame.draw.polygon(slash_surf, with_alpha(pal.slash_outer, int(175 * intensity)), cone_outer)
            pygame.draw.polygon(slash_surf, with_alpha(pal.slash_core, int(235 * intensity)), cone_inner)
            # Twin helical crimson energy spirals wrapping the lance
            for h_sign in (-1.0, 1.0):
                h_pts: List[Vec2] = []
                h_ws: List[float] = []
                for i in range(15):
                    u = i / 14.0
                    env = math.sin(u * math.pi)
                    swirl = math.sin(u * 10.5) * thickness * 1.15 * h_sign * (1.0 - u * 0.55)
                    h_pts.append(p0.lerp_to(p1, u) + nrm * swirl)
                    h_ws.append(max(0.8, env * 5.2 * intensity))
                h_poly = build_tapered_ribbon(h_pts, h_ws)
                if len(h_poly) >= 3:
                    pygame.draw.polygon(slash_surf, with_alpha(pal.aura_primary, int(205 * intensity)), h_poly)
            target.blit(slash_surf, (0, 0))
            return

        steps = 22
        outer_pts: List[Tuple[float, float]] = []
        mid_pts: List[Tuple[float, float]] = []
        inner_pts: List[Tuple[float, float]] = []
        core_outer: List[Tuple[float, float]] = []
        core_inner: List[Tuple[float, float]] = []

        tilt_r = math.radians(tilt_deg)
        ct = math.cos(tilt_r)
        st = math.sin(tilt_r)

        def ellipse_pt(ang_deg: float, rad_scale: float) -> Tuple[float, float]:
            a = math.radians(ang_deg)
            lx = math.cos(a) * rx * rad_scale
            ly = math.sin(a) * ry * rad_scale
            wx = center.x + lx * ct - ly * st
            wy = center.y + lx * st + ly * ct
            return (wx, wy)

        for i in range(steps + 1):
            u = i / float(steps)
            ang = lerp(start_deg, end_deg, u)
            # Leading edge thick and blazing, trailing tail razor-tapered
            taper = math.pow(u, 0.72) * math.sin(min(1.0, u * 1.08) * math.pi * 0.88 + 0.12)
            local_thick = thickness * clamp(taper, 0.04, 1.0)
            in_ratio = max(0.18, 1.0 - local_thick / max(24.0, max(rx, ry)))
            mid_ratio = lerp(in_ratio, 1.0, 0.52)
            core_in_ratio = lerp(in_ratio, 1.0, 0.78)

            outer_pts.append(ellipse_pt(ang, 1.04))
            mid_pts.append(ellipse_pt(ang, mid_ratio))
            inner_pts.append(ellipse_pt(ang, in_ratio))
            core_outer.append(ellipse_pt(ang, 1.02))
            core_inner.append(ellipse_pt(ang, core_in_ratio))

        # Layer 1: Dark cursed shadow wake
        wake_poly = outer_pts + list(reversed(inner_pts))
        if len(wake_poly) >= 3:
            pygame.draw.polygon(slash_surf, with_alpha(pal.aura_secondary, int(135 * intensity)), wake_poly)

        # Layer 2: Blazing crimson slash crescent body
        body_poly = outer_pts + list(reversed(mid_pts))
        if len(body_poly) >= 3:
            pygame.draw.polygon(slash_surf, with_alpha(pal.slash_outer, int(215 * intensity)), body_poly)

        # Layer 3: White-hot razor leading steel edge
        razor_poly = core_outer + list(reversed(core_inner))
        if len(razor_poly) >= 3:
            pygame.draw.polygon(slash_surf, with_alpha(pal.slash_core, int(245 * intensity)), razor_poly)

        # Layer 4: Crisp speed-streak accent lines following the arc
        if len(mid_pts) >= 3:
            pygame.draw.lines(slash_surf, with_alpha(pal.ink_dark, int(190 * intensity)), False, inner_pts[2:], 2)
            pygame.draw.lines(slash_surf, with_alpha(pal.slash_core, int(225 * intensity)), False, core_outer[4:], 2)

        target.blit(slash_surf, (0, 0))

