def dx_dy_to_numpad(dx: int, dy: int, facing_right: bool) -> int:
    fx = dx if facing_right else -dx
    if dy < 0:
        return 7 if fx < 0 else (9 if fx > 0 else 8)
    if dy > 0:
        return 1 if fx < 0 else (3 if fx > 0 else 2)
    return 4 if fx < 0 else (6 if fx > 0 else 5)


class InputBuffer:
    """18-frame fighting-game motion parser with generous arcade tolerances."""

    def __init__(self, max_len: int = 24) -> None:
        self.frames: Deque[InputFrame] = collections.deque(maxlen=max_len)
        self.history_display: Deque[Tuple[int, InputButton]] = collections.deque(maxlen=14)
        self._last_disp: Tuple[int, InputButton] = (5, InputButton.NONE)

    def push(self, frame: InputFrame) -> None:
        self.frames.append(frame)
        cur = (frame.numpad, frame.pressed)
        if frame.pressed != InputButton.NONE or frame.numpad != self._last_disp[0]:
            self.history_display.append(cur)
            self._last_disp = cur

    def latest(self) -> InputFrame:
        return self.frames[-1] if self.frames else InputFrame()

    def pressed_within(self, btn: InputButton, window: int = 5) -> bool:
        n = len(self.frames)
        for i in range(max(0, n - window), n):
            if self.frames[i].pressed & btn:
                return True
        return False

    def match_motion(self, seq: Sequence[int], window: int = 16) -> bool:
        """Ordered subsequence match with neutral/diagonal forgiveness."""
        n = len(self.frames)
        if n < len(seq):
            return False
        start = max(0, n - window)
        s_idx = 0
        for i in range(start, n):
            np = self.frames[i].numpad
            target = seq[s_idx]
            if np == target:
                s_idx += 1
                if s_idx >= len(seq):
                    return True
        return False

    def detect_double_tap(self, direction: int, window: int = 12) -> bool:
        n = len(self.frames)
        if n < 3:
            return False
        start = max(0, n - window)
        stage = 0
        for i in range(start, n):
            np = self.frames[i].numpad
            if stage == 0 and np == direction:
                stage = 1
            elif stage == 1 and np == 5:
                stage = 2
            elif stage == 2 and np == direction:
                return True
        return False


class InputManager:
    """Polls keyboard + optional USB gamepads cleanly for P1 and P2."""

    def __init__(self) -> None:
        self.p1_bind = default_p1_bindings()
        self.p2_bind = default_p2_bindings()
        self._prev_held: List[InputButton] = [InputButton.NONE, InputButton.NONE]
        self.joysticks: List[pygame.joystick.Joystick] = []
        try:
            pygame.joystick.init()
            for i in range(pygame.joystick.get_count()):
                js = pygame.joystick.Joystick(i)
                js.init()
                self.joysticks.append(js)
        except Exception:
            pass

    def poll_player(
        self, player_idx: int, facing_right: bool, allow_arrow_alias_p1: bool = True
    ) -> InputFrame:
        keys = pygame.key.get_pressed()
        b = self.p1_bind if player_idx == 0 else self.p2_bind

        left = bool(keys[b.left])
        right = bool(keys[b.right])
        up = bool(keys[b.up])
        down = bool(keys[b.down])

        if player_idx == 0 and allow_arrow_alias_p1:
            left = left or bool(keys[pygame.K_LEFT])
            right = right or bool(keys[pygame.K_RIGHT])
            up = up or bool(keys[pygame.K_UP])
            down = down or bool(keys[pygame.K_DOWN])

        held = InputButton.NONE
        if keys[b.btn_a]:
            held |= InputButton.A
        if keys[b.btn_b]:
            held |= InputButton.B
        if keys[b.btn_c]:
            held |= InputButton.C
        if keys[b.btn_d]:
            held |= InputButton.D
        if keys[b.btn_throw]:
            held |= InputButton.THROW
        if keys[b.btn_shadow]:
            held |= InputButton.SHADOW
        if keys[b.btn_eclipse]:
            held |= InputButton.ECLIPSE
        if keys[b.btn_taunt]:
            held |= InputButton.TAUNT

        # Optional USB Gamepad polling
        if player_idx < len(self.joysticks):
            js = self.joysticks[player_idx]
            try:
                if js.get_numaxes() >= 2:
                    ax0 = js.get_axis(0)
                    ax1 = js.get_axis(1)
                    if ax0 < -0.45:
                        left = True
                    elif ax0 > 0.45:
                        right = True
                    if ax1 < -0.45:
                        up = True
                    elif ax1 > 0.45:
                        down = True
                if js.get_numhats() >= 1:
                    hx, hy = js.get_hat(0)
                    if hx < 0:
                        left = True
                    elif hx > 0:
                        right = True
                    if hy > 0:
                        up = True
                    elif hy < 0:
                        down = True
                nb = js.get_numbuttons()
                if nb >= 4:
                    if js.get_button(0):
                        held |= InputButton.A
                    if js.get_button(1):
                        held |= InputButton.B
                    if js.get_button(2):
                        held |= InputButton.C
                    if js.get_button(3):
                        held |= InputButton.D
                if nb >= 6:
                    if js.get_button(4):
                        held |= InputButton.THROW
                    if js.get_button(5):
                        held |= InputButton.SHADOW
            except Exception:
                pass

        dx = (1 if right else 0) - (1 if left else 0)
        dy = (1 if down else 0) - (1 if up else 0)
        np = dx_dy_to_numpad(dx, dy, facing_right)
        prev = self._prev_held[player_idx]
        pressed = held & (~prev)
        self._prev_held[player_idx] = held
        return InputFrame(numpad=np, raw_dx=dx, raw_dy=dy, held=held, pressed=pressed)


