    def _apply_display_mode(self) -> None:
        if self.settings.fullscreen:
            self.window = pygame.display.set_mode((0, 0), pygame.FULLSCREEN)
        else:
            sc = clamp_int(self.settings.window_scale, 1, 2)
            self.window = pygame.display.set_mode((INTERNAL_W * sc, INTERNAL_H * sc), pygame.RESIZABLE)

    def present_canvas_nearest_neighbor(self) -> None:
        """
        Stretch locked 800x600 canvas to window preserving 4:3 aspect ratio using
        strict nearest-neighbor pixelization (pygame.transform.scale, NO AA!).
        """
        ww, wh = self.window.get_size()
        if ww == INTERNAL_W and wh == INTERNAL_H:
            self.window.blit(self.canvas, (0, 0))
        else:
            scale = min(ww / float(INTERNAL_W), wh / float(INTERNAL_H))
            dw = max(1, int(round(INTERNAL_W * scale)))
            dh = max(1, int(round(INTERNAL_H * scale)))
            ox = (ww - dw) // 2
            oy = (wh - dh) // 2
            self.window.fill((6, 2, 8))
            stretched = pygame.transform.scale(self.canvas, (dw, dh))
            self.window.blit(stretched, (ox, oy))
        pygame.display.flip()

    def run(self) -> int:
        while self.running:
            dt = min(0.05, self.clock.tick(TARGET_FPS) / 1000.0)
            self.time_s += dt
            self.audio.update()
            self._handle_events()
            self._update(dt)
            self._render()
            self.present_canvas_nearest_neighbor()
        self.audio.shutdown()
        pygame.quit()
        return 0

    def _handle_events(self) -> None:
        for ev in pygame.event.get():
            if ev.type == pygame.QUIT:
                self.running = False
                return
            if ev.type == pygame.KEYDOWN:
                if ev.key == pygame.K_F11:
                    self.settings.fullscreen = not self.settings.fullscreen
                    self._apply_display_mode()
                else:
                    self._on_keydown(ev.key)

    def _on_keydown(self, key: int) -> None:
        if self.screen == ScreenState.TITLE:
            if key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_u, pygame.K_j):
                self.audio.play_sfx(SFXId.UI_CONFIRM)
                self.audio.play_ost(OSTTrackId.MENU_SANCTUARY)
                self.screen = ScreenState.MAIN_MENU
            elif key == pygame.K_ESCAPE:
                self.running = False
            return

        if self.screen == ScreenState.MAIN_MENU:
            n = len(self._main_menu_items)
            if key in (pygame.K_UP, pygame.K_w):
                self.menu_idx = (self.menu_idx - 1) % n
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_DOWN, pygame.K_s):
                self.menu_idx = (self.menu_idx + 1) % n
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key == pygame.K_ESCAPE:
                self.audio.play_sfx(SFXId.UI_CANCEL)
                self.screen = ScreenState.TITLE
            elif key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_u):
                self.audio.play_sfx(SFXId.UI_CONFIRM)
                self._activate_main_menu(self.menu_idx)
            return

        if self.screen == ScreenState.CHARACTER_SELECT:
            n_pal = len(CECILIA_PALETTES)
            if key in (pygame.K_LEFT, pygame.K_a):
                self.p1_pal_idx = (self.p1_pal_idx - 1) % n_pal
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_RIGHT, pygame.K_d):
                self.p1_pal_idx = (self.p1_pal_idx + 1) % n_pal
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_q, pygame.K_UP, pygame.K_w):
                self.p2_pal_idx = (self.p2_pal_idx - 1) % n_pal
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_e, pygame.K_DOWN, pygame.K_s):
                self.p2_pal_idx = (self.p2_pal_idx + 1) % n_pal
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key == pygame.K_ESCAPE:
                self.audio.play_sfx(SFXId.UI_CANCEL)
                self.screen = ScreenState.MAIN_MENU
            elif key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_u):
                self.audio.play_sfx(SFXId.STINGER_FIGHT)
                self.match.survival_wins = 0
                self.vs_timer = 110
                self.screen = ScreenState.VS_SPLASH
            return

        if self.screen == ScreenState.VS_SPLASH:
            if key in (pygame.K_RETURN, pygame.K_SPACE):
                self.vs_timer = 1
            return

        if self.screen == ScreenState.BATTLE:
            if key == pygame.K_ESCAPE:
                self.pause_idx = 0
                self.screen = ScreenState.PAUSE_OVERLAY
                self.audio.play_sfx(SFXId.UI_CONFIRM)
            elif self.match.mode == GameMode.TRAINING:
                if key == pygame.K_F1:
                    modes = list(DummyMode)
                    idx = (modes.index(self.match.training_cfg.dummy_mode) + 1) % len(modes)
                    self.match.training_cfg.dummy_mode = modes[idx]
                    self.audio.play_sfx(SFXId.UI_MOVE)
                elif key == pygame.K_F2:
                    self.match.training_cfg.show_boxes = not self.match.training_cfg.show_boxes
                    self.audio.play_sfx(SFXId.UI_MOVE)
                elif key == pygame.K_F3:
                    self.match._begin_round(keep_meter=False)
                    self.audio.play_sfx(SFXId.UI_CONFIRM)
            elif self.match.mode == GameMode.COMBO_TRIALS and key == pygame.K_TAB:
                nxt = (self.match.trial_idx + 1) % len(COMBO_TRIALS)
                self.match.start_match(GameMode.COMBO_TRIALS, self.p1_pal_idx, self.p2_pal_idx, trial_idx=nxt)
                self.audio.play_sfx(SFXId.UI_CONFIRM)
            return

        if self.screen == ScreenState.PAUSE_OVERLAY:
            opts = 5
            if key in (pygame.K_UP, pygame.K_w):
                self.pause_idx = (self.pause_idx - 1) % opts
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_DOWN, pygame.K_s):
                self.pause_idx = (self.pause_idx + 1) % opts
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key == pygame.K_ESCAPE:
                self.screen = ScreenState.BATTLE
            elif key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_u):
                self.audio.play_sfx(SFXId.UI_CONFIRM)
                if self.pause_idx == 0:
                    self.screen = ScreenState.BATTLE
                elif self.pause_idx == 1:
                    self.match.start_match(self.match.mode, self.p1_pal_idx, self.p2_pal_idx, self.match.arcade_stage_idx, self.match.trial_idx)
                    self.screen = ScreenState.BATTLE
                elif self.pause_idx == 2:
                    self.screen = ScreenState.COMMAND_LIST
                elif self.pause_idx == 3:
                    self.screen = ScreenState.OPTIONS
                else:
                    self.audio.play_ost(OSTTrackId.MENU_SANCTUARY)
                    self.screen = ScreenState.MAIN_MENU
            return

        if self.screen == ScreenState.VICTORY_RESULTS:
            if key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_u):
                self.audio.play_sfx(SFXId.UI_CONFIRM)
                if self.match.mode == GameMode.ARCADE and self.match.winner_id == 0:
                    if self.match.arcade_stage_idx + 1 < len(ARCADE_PERSONAS):
                        self.match.arcade_stage_idx += 1
                        self.vs_timer = 110
                        self.screen = ScreenState.VS_SPLASH
                    else:
                        self.screen = ScreenState.ARCADE_ENDING
                elif self.match.mode == GameMode.SURVIVAL and self.match.winner_id == 0:
                    self.match.survival_wins += 1
                    self.vs_timer = 90
                    self.screen = ScreenState.VS_SPLASH
                else:
                    self.match.start_match(self.match.mode, self.p1_pal_idx, self.p2_pal_idx, self.match.arcade_stage_idx)
                    self.screen = ScreenState.BATTLE
            elif key == pygame.K_ESCAPE:
                self.audio.play_ost(OSTTrackId.MENU_SANCTUARY)
                self.screen = ScreenState.MAIN_MENU
            return

        if self.screen == ScreenState.ARCADE_ENDING:
            if key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_ESCAPE):
                self.audio.play_ost(OSTTrackId.TITLE_NOCTURNE)
                self.screen = ScreenState.TITLE
            return

        if self.screen == ScreenState.COMMAND_LIST:
            if key in (pygame.K_UP, pygame.K_w):
                self.cmd_scroll = max(0, self.cmd_scroll - 1)
            elif key in (pygame.K_DOWN, pygame.K_s):
                self.cmd_scroll = min(max(0, len(self.moves) - 10), self.cmd_scroll + 1)
            elif key in (pygame.K_ESCAPE, pygame.K_RETURN):
                self.screen = ScreenState.MAIN_MENU
            return

        if self.screen == ScreenState.GALLERY:
            if key in (pygame.K_UP, pygame.K_w):
                self.gallery_state_idx = (self.gallery_state_idx - 1) % len(self._gallery_states)
                self.gallery_frame_idx = 0
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_DOWN, pygame.K_s):
                self.gallery_state_idx = (self.gallery_state_idx + 1) % len(self._gallery_states)
                self.gallery_frame_idx = 0
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_LEFT, pygame.K_a):
                st = self._gallery_states[self.gallery_state_idx]
                self.gallery_playing = False
                self.gallery_frame_idx = (self.gallery_frame_idx - 1) % len(self.atlas[st])
            elif key in (pygame.K_RIGHT, pygame.K_d):
                st = self._gallery_states[self.gallery_state_idx]
                self.gallery_playing = False
                self.gallery_frame_idx = (self.gallery_frame_idx + 1) % len(self.atlas[st])
            elif key == pygame.K_SPACE:
                self.gallery_playing = not self.gallery_playing
            elif key == pygame.K_p:
                self.gallery_pal_idx = (self.gallery_pal_idx + 1) % len(CECILIA_PALETTES)
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key == pygame.K_m:
                tracks = list(OSTTrackId)
                self.gallery_ost_idx = (self.gallery_ost_idx + 1) % len(tracks)
                self.audio.play_ost(tracks[self.gallery_ost_idx], force_restart=True)
            elif key == pygame.K_ESCAPE:
                self.audio.play_ost(OSTTrackId.MENU_SANCTUARY)
                self.screen = ScreenState.MAIN_MENU
            return

        if self.screen == ScreenState.LORE_ARCHIVE:
            if key in (pygame.K_UP, pygame.K_w, pygame.K_LEFT, pygame.K_a):
                self.lore_idx = (self.lore_idx - 1) % len(LORE_ARCHIVE)
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_DOWN, pygame.K_s, pygame.K_RIGHT, pygame.K_d):
                self.lore_idx = (self.lore_idx + 1) % len(LORE_ARCHIVE)
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_ESCAPE, pygame.K_RETURN):
                self.screen = ScreenState.MAIN_MENU
            return

        if self.screen == ScreenState.OPTIONS:
            n_opt = 8
            if key in (pygame.K_UP, pygame.K_w):
                self.opt_idx = (self.opt_idx - 1) % n_opt
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_DOWN, pygame.K_s):
                self.opt_idx = (self.opt_idx + 1) % n_opt
                self.audio.play_sfx(SFXId.UI_MOVE)
            elif key in (pygame.K_LEFT, pygame.K_a, pygame.K_RIGHT, pygame.K_d):
                delta = 1 if key in (pygame.K_RIGHT, pygame.K_d) else -1
                self._adjust_option(self.opt_idx, delta)
                self.audio.play_sfx(SFXId.UI_SLIDER)
            elif key == pygame.K_ESCAPE:
                self.screen = ScreenState.MAIN_MENU

    def _activate_main_menu(self, idx: int) -> None:
        if idx == 0:
            self.selected_mode = GameMode.ARCADE
            self.match.arcade_stage_idx = 0
            self.screen = ScreenState.CHARACTER_SELECT
        elif idx == 1:
            self.selected_mode = GameMode.VERSUS_CPU
            self.screen = ScreenState.CHARACTER_SELECT
        elif idx == 2:
            self.selected_mode = GameMode.VERSUS_2P
            self.screen = ScreenState.CHARACTER_SELECT
        elif idx == 3:
            self.selected_mode = GameMode.SURVIVAL
            self.screen = ScreenState.CHARACTER_SELECT
        elif idx == 4:
            self.selected_mode = GameMode.TRAINING
            self.match.start_match(GameMode.TRAINING, self.p1_pal_idx, self.p2_pal_idx)
            self.screen = ScreenState.BATTLE
        elif idx == 5:
            self.selected_mode = GameMode.COMBO_TRIALS
            self.match.start_match(GameMode.COMBO_TRIALS, self.p1_pal_idx, self.p2_pal_idx, trial_idx=0)
            self.screen = ScreenState.BATTLE
        elif idx == 6:
            self.cmd_scroll = 0
            self.screen = ScreenState.COMMAND_LIST
        elif idx == 7:
            self.screen = ScreenState.GALLERY
        elif idx == 8:
            self.screen = ScreenState.LORE_ARCHIVE
        elif idx == 9:
            if self.match.replay.frames:
                self.match.start_match(GameMode.REPLAY)
                self.screen = ScreenState.BATTLE
            else:
                self.audio.play_sfx(SFXId.UI_FORBIDDEN)
        elif idx == 10:
            self.screen = ScreenState.OPTIONS
        else:
            self.running = False

    def _adjust_option(self, idx: int, delta: int) -> None:
        s = self.settings
        if idx == 0:
            s.master_volume = clamp(round(s.master_volume + delta * 0.1, 1), 0.0, 1.0)
        elif idx == 1:
            s.bgm_volume = clamp(round(s.bgm_volume + delta * 0.1, 1), 0.0, 1.0)
        elif idx == 2:
            s.sfx_volume = clamp(round(s.sfx_volume + delta * 0.1, 1), 0.0, 1.0)
        elif idx == 3:
            diffs = list(AIDifficulty)
            s.ai_difficulty = diffs[(diffs.index(s.ai_difficulty) + delta) % len(diffs)]
        elif idx == 4:
            s.rounds_to_win = clamp_int(s.rounds_to_win + delta, 1, 3)
        elif idx == 5:
            s.simple_specials = not s.simple_specials
        elif idx == 6:
            s.window_scale = 2 if s.window_scale == 1 else 1
            self._apply_display_mode()
        elif idx == 7:
            s.blood_intensity = clamp(round(s.blood_intensity + delta * 0.25, 2), 0.25, 1.5)

    def _update(self, dt: float) -> None:
        if self.screen == ScreenState.BOOT_LOADING:
            p_stage = self.stage.step_bake()
            p_spr = self.bank.step_prebake(max_frames=6) if p_stage >= 1.0 else 0.0
            self.load_progress = p_stage * 0.50 + p_spr * 0.50
            if self.load_progress >= 0.999:
                self.audio.play_ost(OSTTrackId.TITLE_NOCTURNE)
                self.screen = ScreenState.TITLE
            return

        if self.screen in (ScreenState.TITLE, ScreenState.MAIN_MENU, ScreenState.CHARACTER_SELECT, ScreenState.LORE_ARCHIVE, ScreenState.OPTIONS):
            self.stage.update(dt)
            return

        if self.screen == ScreenState.VS_SPLASH:
            self.stage.update(dt)
            self.vs_timer -= 1
            if self.vs_timer <= 0:
                self.match.start_match(
                    self.selected_mode, self.p1_pal_idx, self.p2_pal_idx,
                    arcade_stage=self.match.arcade_stage_idx,
                )
                self.screen = ScreenState.BATTLE
            return

        if self.screen == ScreenState.BATTLE:
            finished = self.match.step_frame(self.inp_mgr)
            if finished:
                self.audio.play_ost(OSTTrackId.VICTORY_ELEGY)
                self.screen = ScreenState.VICTORY_RESULTS
            return

        if self.screen == ScreenState.GALLERY:
            self.stage.update(dt)
            if self.gallery_playing:
                st = self._gallery_states[self.gallery_state_idx]
                frames = self.atlas[st]
                kf = frames[self.gallery_frame_idx % len(frames)]
                self.gallery_tick += 1
                if self.gallery_tick >= max(1, kf.duration):
                    self.gallery_tick = 0
                    self.gallery_frame_idx = (self.gallery_frame_idx + 1) % len(frames)

    def _render(self) -> None:
        c = self.canvas
        if self.screen == ScreenState.BOOT_LOADING:
            self._render_boot_loading(c)
        elif self.screen == ScreenState.TITLE:
            self._render_title(c)
        elif self.screen == ScreenState.MAIN_MENU:
            self._render_main_menu(c)
        elif self.screen == ScreenState.CHARACTER_SELECT:
            self._render_character_select(c)
        elif self.screen == ScreenState.VS_SPLASH:
            self._render_vs_splash(c)
        elif self.screen == ScreenState.BATTLE:
            self.match.render(c)
        elif self.screen == ScreenState.PAUSE_OVERLAY:
            self.match.render(c)
            self._render_pause_overlay(c)
        elif self.screen == ScreenState.VICTORY_RESULTS:
            self._render_victory_results(c)
        elif self.screen == ScreenState.ARCADE_ENDING:
            self._render_arcade_ending(c)
        elif self.screen == ScreenState.COMMAND_LIST:
            self._render_command_list(c)
        elif self.screen == ScreenState.GALLERY:
            self._render_gallery(c)
        elif self.screen == ScreenState.LORE_ARCHIVE:
            self._render_lore_archive(c)
        elif self.screen == ScreenState.OPTIONS:
            self._render_options(c)

        if self.settings.show_fps:
            self.fonts.draw_text(c, f"FPS {int(self.clock.get_fps())}", (735, 578), size=11, color=(255, 224, 128), serif=False)

