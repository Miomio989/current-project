    # --------------------------------------------------------------------------
    # REAL-TIME RIPPLING SWAMP WATER REFLECTION RENDERER (Signature mockup.jpg!)
    # --------------------------------------------------------------------------

    def render_fighter_water_reflection(
        self,
        dest: pygame.Surface,
        sprite: pygame.Surface,
        screen_x: float,
        ground_screen_y: float,
        anchor_x: int,
        anchor_y: int,
        elevation: float = 0.0,
    ) -> None:
        """
        Render a live vertically-flipped, vertically-foreshortened, sine-rippled
        mirror reflection of Cecilia & her glowing crimson slash arcs directly
        into the flooded swamp water beneath her boots!
        """
        # Vertical flip & gentle perspective squash (0.52 height) for mirror water look
        sw, sh = sprite.get_size()
        ref_h = max(16, int(sh * 0.50))
        flipped = pygame.transform.flip(sprite, False, True)
        squashed = pygame.transform.scale(flipped, (sw, ref_h))
        squashed.set_alpha(118)

        # Anchor foot touches right at ground_screen_y + elevation offset
        ref_top_y = int(ground_screen_y + elevation * 0.35 - (sh - anchor_y) * 0.50)
        base_left = int(screen_x - anchor_x)

        # Horizontal sine-wave water ripple slicing in crisp 5px horizontal strips
        strip_h = 5
        t_wave = self.time_sec * 5.8
        for sy in range(0, ref_h, strip_h):
            dest_y = ref_top_y + sy
            if dest_y < int(WATER_HORIZON_Y) or dest_y >= INTERNAL_H:
                continue
            wave_dx = int(math.sin(sy * 0.24 + t_wave) * (2.2 + sy * 0.045))
            actual_h = min(strip_h, ref_h - sy)
            dest.blit(squashed, (base_left + wave_dx, dest_y), pygame.Rect(0, sy, sw, actual_h))

    # --------------------------------------------------------------------------
    # Foreground Parallax Pass (Drifting Mist, Embers, Silhouette Cattails)
    # --------------------------------------------------------------------------

    def render_foreground(self, dest: pygame.Surface, cam_x: float, cam_y: float = 0.0) -> None:
