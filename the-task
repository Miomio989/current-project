            surf, jb_poly, pal.cloth_red_hi, pal.cloth_red_mid, pal.cloth_red_deep,
            ink_color=INK_CRIMSON, ink_width=1.8,
        )
        # High mandarin collar & ruby brooch
        cl_poly = [
            Vec2(cx - 11 * sc, cy + 16 * sc), Vec2(cx + 12 * sc, cy + 16 * sc),
            Vec2(cx + 11 * sc, cy + 28 * sc), Vec2(cx - 10 * sc, cy + 28 * sc),
        ]
        self.rast.paint_cg_poly(surf, cl_poly, pal.cloth_black_hi, pal.cloth_black_mid, pal.cloth_black_deep, ink_width=1.8)
        pygame.draw.circle(surf, pal.buckle_hi, (int(cx + 3 * sc), int(cy + 23 * sc)), max(3, int(4.6 * sc)))
        pygame.draw.circle(surf, pal.gem_mid, (int(cx + 3 * sc), int(cy + 23 * sc)), max(2, int(3.4 * sc)))
        pygame.draw.circle(surf, pal.gem_hi, (int(cx + 2 * sc), int(cy + 22 * sc)), max(1, int(1.4 * sc)))

