            pygame.draw.lines(surf, INK_COLOR, False, lash_pts, max(2, int(2.2 * scale)))
            pygame.draw.line(
                surf, (78, 52, 68),
                (ec - fwd * (ew * 0.65) - up * (open_h * 0.68)).to_int_tuple(),
                (ec + fwd * (ew * 0.65) - up * (open_h * 0.68)).to_int_tuple(), 1,
