                pygame.draw.lines(surf, INK_COLOR, False, [p0, p1, p2], max(1, int(1.8 * scale)))
                continue

            open_h = eh * (0.82 if expr in (ExpressionId.SERENE, ExpressionId.NOBLE_SMIRK) else (1.14 if expr == ExpressionId.SHOCK else 0.94))

            # Clean white sclera
            sclera = [
                ec - fwd * ew,
                ec + up * (open_h * 0.85),
                ec + fwd * ew,
                ec - up * (open_h * 0.72),
            ]
            pygame.draw.polygon(surf, (254, 250, 252), [p.to_int_tuple() for p in sclera])

            # Vibrant Glowing Yellow Anime Iris (outer amber -> vibrant yellow -> bright lower crescent -> dark pupil)
            iris_c = ec + fwd * gaze
            ir_r = max(2, int(min(ew, open_h) * 0.88))
            pygame.draw.circle(surf, pal.eye_outer, iris_c.to_int_tuple(), ir_r)
            pygame.draw.circle(surf, pal.eye_mid, (int(iris_c.x), int(iris_c.y + 0.5)), max(1, int(ir_r * 0.80)))
            # Luminous lower-iris crescent reflection (signature Danbooru/Pixiv eye jewel look!)
            pygame.draw.circle(surf, pal.eye_bright, (int(iris_c.x), int(iris_c.y + ir_r * 0.34)), max(1, int(ir_r * 0.50)))
            pygame.draw.circle(surf, pal.eye_pupil, iris_c.to_int_tuple(), max(1, int(ir_r * 0.36)))
            # Upper-left sharp anime catchlight + tiny secondary sparkle
            pygame.draw.circle(surf, (255, 255, 255), (int(iris_c.x - ir_r * 0.38), int(iris_c.y - ir_r * 0.36)), max(1, int(1.2 * scale)))
