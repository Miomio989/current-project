        facing_right: bool = True,
        expr: ExpressionId = ExpressionId.SERENE,
    ) -> pygame.Surface:
        """
        Render a lush, high-craft Danbooru/Pixiv anime CG close-up bust of
        Cecilia Darkmoon inside an ornate gothic diamond/shield portrait frame
        (matching mockup.jpg's top-left and top-right HUD portraits!).
        """
        ss = size * 2
        surf = pygame.Surface((ss, ss), pygame.SRCALPHA)
        cx, cy = ss * 0.50, ss * 0.52
        sc = ss / 110.0

        # Deep blood-moon crimson vignette backdrop behind portrait
        for r in range(int(ss * 0.52), 2, -2):
            u = r / (ss * 0.52)
            col = lerp_rgb((62, 10, 32), (14, 5, 16), u ** 0.85)
            pygame.draw.circle(surf, (col[0], col[1], col[2], 245), (int(cx), int(cy)), r)
        self.rast.stamp_bloom(surf, cx + 16 * sc, cy - 18 * sc, 36 * sc, pal.aura_mid, alpha=110, additive=True)

