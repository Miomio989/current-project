def main() -> int:
    ensure_dirs()
    QApplication.setHighDpiScaleFactorRoundingPolicy(Qt.HighDpiScaleFactorRoundingPolicy.PassThrough)
    app = QApplication(sys.argv)
    app.setApplicationName(APP_NAME)
    app.setStyle("Fusion")
    settings = load_settings()
    scale = float(settings.get("ui", {}).get("font_scale", 1.0) or 1.0)
    # v1.8.0: apply the saved theme BEFORE any widget exists (Kintsugi Gold or
    # Crimson Shrine; switching later is live, see MainWindow._apply_theme)
    set_theme(str(settings.get("ui", {}).get("theme", DEFAULT_THEME) or DEFAULT_THEME))
    apply_palette(app)
    base_font = QFont()
    base_font.setFamilies(["Segoe UI", "Yu Gothic UI", "Meiryo UI", "Noto Sans CJK JP", "Noto Sans", "DejaVu Sans"])
    base_font.setPointSizeF(11 * scale)
    app.setFont(base_font)
    app.setStyleSheet(build_stylesheet(scale))
    win = MainWindow()
    win.showMaximized()
    return app.exec()


if __name__ == "__main__":
    _code = main()
    # A worker blocked inside a network call cannot be killed from Python;
    # leaving Qt teardown avoids a possible abort from a lingering poller.
    os._exit(_code)
