def _qgrad(top: str, mid: str, bot: str) -> str:
    return (
        f"qlineargradient(x1:0,y1:0,x2:0,y2:1,"
        f"stop:0 {top},stop:0.48 {mid},stop:0.52 {bot},stop:1 {bot})"
    )


def tab_icon_px(scale: float = 1.0) -> int:
    """Pixel size of the left tab-rail icons for the current UI font scale.

    v3.2: icons are sized to FILL the whole interactive tab element (with a
    razor-thin 3px breathing margin) while keeping their square aspect ratio —
    26px at 100% scale up to 34px at 135%, and never below 22px at 85%."""
    s = max(0.85, min(1.35, float(scale)))
    return max(22, min(34, int(round(26.0 * s))))


def tab_rail_height(scale: float = 1.0) -> int:
    """Deterministic height of the icon tab rail: icon + hairline chrome, so
    the icon occupies ~75-80% of the interactive tab element."""
    return tab_icon_px(scale) + 8


def build_stylesheet(scale: float = 1.0) -> str:
    """Late-2000s glossy non-flat East-Asian workstation stylesheet.
    Wide 22px scrollbars, crisp 1px metallic specular bevels, tight 2-3px
    architectural radii, zero western flat-pastel aesthetics."""
    s = max(0.85, min(1.35, float(scale)))
    f_base = max(9, int(round(10.5 * s)))
    f_sm = max(8, int(round(9.5 * s)))
    f_xs = max(8, int(round(8.5 * s)))
