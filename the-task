    def _draw_arm(
        self,
        surf: pygame.Surface,
        sh: Pt2,
        elb: Pt2,
        hand: Pt2,
        pal: CeciliaCGPalette,
        ss: float,
        ldir: Pt2,
        is_front: bool,
    ) -> None:
        # 1. Iconic Dramatic Puffed Velvet Juliet Upper Sleeve (char.jpg!)
        up_mid = v_lerp(sh, elb, 0.56)
        puff_poly = build_anatomical_limb(
            sh, up_mid,
            8.4 * ss, 7.6 * ss,
            11.8 * ss, 10.6 * ss,  # Rich rounded gothic balloon puff!
            5.4 * ss, 5.0 * ss,
            mid_t=0.48, steps=8,
        )
        velvet_cols = (
            [pal.dress_black_sh, pal.dress_black_base, pal.dress_black_hi]
            if is_front
            else [pal.dress_black_sh, scale_rgb(pal.dress_black_base, 0.78), pal.dress_black_base]
        )
        self.cg.fill_shaded_poly(
            surf, puff_poly, velvet_cols,
            light_dir=ldir,
            spec_pos=v_lerp(sh, up_mid, 0.42),
            spec_color=pal.dress_black_hi, spec_radius=12 * ss, spec_alpha=115 if is_front else 55,
            rim_color=pal.hair_rim if is_front else None, rim_width=1.2 * ss,
            ink_color=pal.dress_black_sh, ink_width=1.4 * ss,
        )

        # 2. Sleek Fitted Tight Forearm Sleeve (up_mid -> elbow -> wrist)
        arm_lower = build_anatomical_limb(
            up_mid, elb,
            5.0 * ss, 4.6 * ss,
            4.8 * ss, 4.4 * ss,
            4.6 * ss, 4.2 * ss,
            mid_t=0.5, steps=5,
        )
        forearm = build_anatomical_limb(
            elb, hand,
            4.8 * ss, 4.4 * ss,
            4.4 * ss, 4.0 * ss,
            3.3 * ss, 3.1 * ss,
            mid_t=0.45, steps=7,
        )
        for seg in (arm_lower, forearm):
            self.cg.fill_shaded_poly(
                surf, seg, velvet_cols,
                light_dir=ldir,
                spec_pos=v_lerp(elb, hand, 0.45),
                spec_color=pal.leather_spec, spec_radius=9 * ss, spec_alpha=68 if is_front else 30,
                ink_color=pal.dress_black_sh, ink_width=1.25 * ss,
            )

        # Crimson ruffled wrist cuff (char.jpg!)
        tang = v_norm(v_sub(hand, elb))
        nrm = (-tang[1], tang[0])
        cuff_c = v_sub(hand, v_mul(tang, 3.2 * ss))
        cuff_poly = [
            (cuff_c[0] - nrm[0] * 4.4 * ss - tang[0] * 2.2 * ss, cuff_c[1] - nrm[1] * 4.4 * ss - tang[1] * 2.2 * ss),
            (cuff_c[0] + nrm[0] * 4.4 * ss - tang[0] * 2.2 * ss, cuff_c[1] + nrm[1] * 4.4 * ss - tang[1] * 2.2 * ss),
            (cuff_c[0] + nrm[0] * 5.6 * ss + tang[0] * 2.6 * ss, cuff_c[1] + nrm[1] * 5.6 * ss + tang[1] * 2.6 * ss),
            (cuff_c[0] - nrm[0] * 5.6 * ss + tang[0] * 2.6 * ss, cuff_c[1] - nrm[1] * 5.6 * ss + tang[1] * 2.6 * ss),
        ]
        self.cg.fill_shaded_poly(
            surf, cuff_poly,
            [pal.dress_red_sh, pal.dress_red_base, pal.dress_red_hi],
            light_dir=ldir, ink_color=pal.dress_red_sh, ink_width=1.0 * ss,
        )

        # Delicate porcelain hand gripping blade / posed gracefully
        h_rad = 3.8 * ss
        h_poly = [
            (hand[0] - nrm[0] * h_rad * 0.85, hand[1] - nrm[1] * h_rad * 0.85),
            (hand[0] + tang[0] * h_rad * 1.15 - nrm[0] * h_rad * 0.55, hand[1] + tang[1] * h_rad * 1.15 - nrm[1] * h_rad * 0.55),
            (hand[0] + tang[0] * h_rad * 1.35 + nrm[0] * h_rad * 0.45, hand[1] + tang[1] * h_rad * 1.35 + nrm[1] * h_rad * 0.45),
            (hand[0] + nrm[0] * h_rad * 0.90, hand[1] + nrm[1] * h_rad * 0.90),
        ]
        self.cg.fill_shaded_poly(
            surf, h_poly,
            [pal.skin_shadow, pal.skin_base, pal.skin_hi],
            light_dir=ldir, ink_color=pal.skin_ink, ink_width=1.1 * ss,
        )

    def _draw_head_and_face(
        self,
        surf: pygame.Surface,
        kf: HandCraftedKeyframe,
        pal: CeciliaCGPalette,
        ax: float,
        ay: float,
        ss: float,
        ldir: Pt2,
    ) -> None:
        hx = ax + kf.head[0] * ss
        hy = ay + kf.head[1] * ss
        rad_tilt = math.radians(kf.head_tilt)
        ct = math.cos(rad_tilt)
        st = math.sin(rad_tilt)

        def H(lx: float, ly: float) -> Pt2:
            rx = (lx * ct - ly * st) * ss
            ry = (lx * st + ly * ct) * ss
            return (hx + rx, hy + ry)

        # Neck connecting head cleanly to collar
        nk = (ax + kf.neck[0] * ss, ay + kf.neck[1] * ss)
        neck_poly = [
            (nk[0] - 4.0 * ss, nk[1] + 2 * ss),
            (nk[0] + 4.0 * ss, nk[1] + 2 * ss),
            H(4.0, 12.0),
            H(-4.0, 12.0),
        ]
        self.cg.fill_shaded_poly(
            surf, neck_poly,
            [pal.skin_shadow, pal.skin_mid, pal.skin_base],
            light_dir=ldir, ink_color=pal.skin_ink, ink_width=1.1 * ss,
        )

        # Crimson ponytail tie knot resting high at back-top of crown
        tie_poly = [H(-12.5, -16.5), H(-4.5, -20.0), H(-1.5, -13.5), H(-9.8, -10.5)]
        self.cg.fill_shaded_poly(
            surf, tie_poly,
            [pal.dress_red_sh, pal.dress_red_base, pal.dress_red_hi],
            light_dir=ldir, ink_color=pal.hair_dark, ink_width=1.2 * ss,
        )

        # True multi-angle anime face contour (changes silhouette for 3/4, Profile, Over-Shoulder!)
        yaw = kf.head_yaw
        if yaw == HeadYaw.THREE_QUARTER_BACK:
            # Seen mostly from behind — graceful cheek edge + lush hair back cap
            face_pts = [H(-11, -8), H(11, -8), H(12, 6), H(4, 15), H(-10, 10)]
        elif yaw == HeadYaw.PROFILE_FWD:
            # Crisp anime side profile (delicate forehead, petite nose tip, graceful chin!)
            face_pts = (
                sample_cubic(H(-12, -10), H(-11, 10), H(-2, 16), H(8.5, 14.5), 8)
                + [H(11.2, 8.2), H(12.2, 4.6), H(13.8, 2.5), H(11.4, -1.2), H(11.6, -9.0)]
                + sample_cubic(H(11.6, -9.0), H(6, -18), H(-8, -18), H(-12, -10), 6)
            )
        else:
            # Classic luminous 3/4-Front anime cranial & delicate tapered chin sculpt!
            shift = 2.6 if yaw in (HeadYaw.THREE_QUARTER_FWD, HeadYaw.TILT_DOWN, HeadYaw.TILT_UP) else (
                0.0 if yaw == HeadYaw.FRONT else -2.0
            )
            face_pts = (
                sample_cubic(H(-13.2, -5.0), H(-12.8, 7.2), H(-6.5 + shift * 0.4, 14.2), H(2.2 + shift, 16.4), 9)
                + sample_cubic(H(2.2 + shift, 16.4), H(10.8 + shift * 0.6, 13.4), H(13.6, 6.2), H(13.0, -5.2), 9)
                + sample_cubic(H(13.0, -5.2), H(10.0, -17.0), H(-10.0, -17.0), H(-13.2, -5.0), 8)
            )

        self.cg.fill_shaded_poly(
            surf, face_pts,
            [pal.skin_shadow, pal.skin_mid, pal.skin_base, pal.skin_hi],
            light_dir=(0.72, -0.42),
            spec_pos=H(5.0, 4.0), spec_color=pal.skin_hi, spec_radius=10 * ss, spec_alpha=68,
            ink_color=pal.skin_ink, ink_width=1.2 * ss,
        )

        # Render anime eyes, eyebrows & delicate mouth unless facing away
        if yaw != HeadYaw.THREE_QUARTER_BACK:
            self.cg.draw_soft_ellipse_airbrush(surf, H(5.5, 6.2)[0], H(5.5, 6.2)[1], 4.2 * ss, 2.2 * ss, pal.skin_blush, 58)
            eye_h = 3.2 if kf.expression != ExpressionId.PAIN else 1.4
            if yaw == HeadYaw.PROFILE_FWD:
                eyes_cfg = [(7.8, 2.2, 4.6, eye_h)]
            elif yaw == HeadYaw.FRONT:
                eyes_cfg = [(-5.4, 2.2, 5.2, eye_h), (5.4, 2.2, 5.2, eye_h)]
            else:
                eyes_cfg = [(-1.8, 2.4, 4.8, eye_h), (7.6, 2.1, 4.6, eye_h)]

            for ex, ey, ew, eh in eyes_cfg:
                ec = H(ex, ey)
                # Crisp white sclera + golden-yellow luminous iris + pupil + white catchlight!
                rect_s = (int(ec[0] - ew * 0.55 * ss), int(ec[1] - eh * 0.55 * ss), max(4, int(ew * 1.1 * ss)), max(3, int(eh * 1.1 * ss)))
                pygame.draw.ellipse(surf, pal.eye_sclera, rect_s)
                ir_r = max(2, int(eh * 0.54 * ss))
                pygame.draw.circle(surf, pal.eye_iris_dark, (int(ec[0] + 0.6 * ss), int(ec[1])), ir_r)
                pygame.draw.circle(surf, pal.eye_iris_mid, (int(ec[0] + 0.6 * ss), int(ec[1] + 0.3 * ss)), max(1, int(ir_r * 0.80)))
                pygame.draw.circle(surf, pal.eye_iris_glow, (int(ec[0] + 0.6 * ss), int(ec[1] + ir_r * 0.32)), max(1, int(ir_r * 0.44)))
                pygame.draw.circle(surf, pal.eye_pupil, (int(ec[0] + 0.6 * ss), int(ec[1])), max(1, int(ir_r * 0.34)))
                # Catchlight spark!
                pygame.draw.circle(surf, (255, 255, 255), (int(ec[0] - ir_r * 0.28), int(ec[1] - ir_r * 0.30)), max(1, int(1.1 * ss)))
                # Curved dark anime upper eyelash!
                lash = [
                    H(ex - ew * 0.58, ey - 0.1),
                    H(ex, ey - eh * 0.72),
                    H(ex + ew * 0.66, ey - 0.5),
                ]
                pygame.draw.lines(surf, pal.hair_dark, False, lash, max(2, int(1.8 * ss)))

            # Subtle anime mouth (serene line or fierce battle shout!)
            if kf.expression in (ExpressionId.FIERCE, ExpressionId.PAIN):
                mp = [H(1.8, 10.6), H(6.4, 10.4), H(5.4, 13.0), H(2.4, 13.0)]
                pygame.draw.polygon(surf, (152, 42, 62), mp)
                pygame.draw.aalines(surf, pal.skin_ink, True, mp)
            else:
                pygame.draw.aalines(surf, pal.skin_ink, False, [H(1.6, 11.2), H(4.6, 11.6), H(7.2, 10.9)])

        # Silky jet-black cranial hair dome + feathered bangs + angel-ring highlight!
        cap_poly = (
            sample_cubic(H(-15.5, 4.0), H(-17.0, -14.5), H(-6.0, -21.5), H(3.5, -20.5), 9)
            + sample_cubic(H(3.5, -20.5), H(15.0, -18.5), H(16.8, -8.5), H(14.5, 2.0), 8)
            + [H(10.5, -5.2), H(5.2, -1.2), H(0.6, -4.8), H(-4.0, -0.8), H(-9.4, -4.6), H(-15.5, 3.0)]
        )
        self.cg.fill_shaded_poly(
            surf, cap_poly,
            [pal.hair_dark, pal.hair_base, pal.hair_sheen, pal.hair_base],
            light_dir=ldir,
            spec_pos=H(4.5, -10.5), spec_color=pal.hair_spec, spec_radius=10 * ss, spec_alpha=58,
            rim_color=pal.hair_rim, rim_width=1.4 * ss,
            ink_color=pal.hair_dark, ink_width=1.35 * ss,
        )

        # Iconic face-framing twin sidelocks (framing cheeks down past collarbone!)
        for sl_pts, sl_w in (
            ((H(-11.2, -6.0), H(-14.6, 5.5), H(-12.5, 16.5), H(-7.2, 26.5)), (3.4, 2.4, 0.5)),
            ((H(12.2, -6.5), H(15.2, 4.8), H(13.4, 15.8), H(8.8, 25.0)), (3.0, 2.2, 0.5)),
        ):
            sp = sample_cubic(sl_pts[0], sl_pts[1], sl_pts[2], sl_pts[3], 9)
            ws = [lerp(sl_w[0] * ss, sl_w[1] * ss, t * 2) if t < 0.5 else lerp(sl_w[1] * ss, sl_w[2] * ss, (t - 0.5) * 2) for t in [i / 9.0 for i in range(10)]]
            poly = build_tapered_ribbon_poly(sp, ws)
            self.cg.fill_shaded_poly(
                surf, poly,
                [pal.hair_dark, pal.hair_base, pal.hair_sheen],
                light_dir=ldir, ink_color=pal.hair_dark, ink_width=1.1 * ss,
            )

    def _draw_demonic_sword_3d(
        self,
        surf: pygame.Surface,
        sw: Sword3DSpec,
        pal: CeciliaCGPalette,
        ax: float,
        ay: float,
        ss: float,
        overdrive: bool,
    ) -> None:
        """
        True 3D perspective-foreshortened Demonic Two-Handed Cursed Greatsword!
        Matches char.jpg & graphics-mockup.jpg:
          - Long diamond-wrapped grip + spiked crimson pommel
          - Thorny gothic bat-wing crossguard with faceted glowing crimson gem
          - Broad forged obsidian-iron bevel blade whose width dynamically scales
            with camera depth (hilt_z -> tip_z) and blade_roll!
          - Glowing crimson arcane runes etched down central fuller
          - Living multi-layered swirling crimson-magenta cursed flame aura!
        """
        hilt = (ax + sw.hilt_x * ss, ay + sw.hilt_y * ss)
        tip = (ax + sw.tip_x * ss, ay + sw.tip_y * ss)
        axis_v = v_sub(tip, hilt)
        L = max(14.0 * ss, v_len(axis_v))
        u_dir = v_norm(axis_v)
        nrm = (-u_dir[1], u_dir[0])

        # Perspective scale along camera depth Z (0.62 far -> 1.48 thrust toward camera!)
        persp_h = clamp(1.0 + sw.hilt_z * 0.42, 0.62, 1.50)
        persp_t = clamp(1.0 + sw.tip_z * 0.54, 0.58, 1.68)
        # Blade roll exposes broad face (cos=1) or razor edge perspective (cos=0.22)!
        face_vis = max(0.24, abs(math.cos(sw.blade_roll)))
        guard_vis = max(0.32, abs(math.cos(sw.guard_spin)))

        # 1. Living Smoky Crimson-Magenta Cursed Flame Tendrils streaming off the blade!
        aura_str = sw.aura_intensity * (1.35 if overdrive else 1.0)
        if aura_str > 0.08:
            # Soft atmospheric glow sheath along the entire cursed blade
            for bt, gr_k in ((0.22, 26), (0.48, 30), (0.74, 26), (0.94, 20)):
                bp = v_lerp(hilt, tip, bt)
                self.cg.blit_glow(
                    surf, bp, gr_k * ss * aura_str * lerp(persp_h, persp_t, bt),
                    pal.aura_outer if bt < 0.5 else pal.aura_mid,
                    clamp_int(int(128 * aura_str), 28, 185), additive=True,
                )
            # Sleek tapered curling spectral flame wisps (graphics-mockup.jpg style!)
            rng = random.Random(int(sw.aura_flicker * 997) + 31)
            for k in range(7):
                t0 = 0.10 + k * 0.125
                t1 = min(1.12, t0 + 0.34)
                side = 1.0 if (k % 2 == 0) else -1.0
                bw_k = lerp(10.5 * persp_h, 6.5 * persp_t, t0) * ss * face_vis
                p0 = v_add(v_lerp(hilt, tip, t0), v_mul(nrm, side * bw_k * 0.72))
                # Drift organically upward & trailing slightly along blade!
                drift_y = -(10.0 + rng.uniform(4.0, 18.0)) * ss * aura_str
                drift_n = side * (6.0 + rng.uniform(3.0, 11.0)) * ss * aura_str
                p3 = v_add(v_lerp(hilt, tip, t1), (nrm[0] * drift_n, nrm[1] * drift_n + drift_y))
                p1 = v_add(v_lerp(p0, p3, 0.36), (nrm[0] * side * 6.5 * ss, nrm[1] * side * 6.5 * ss - 4.0 * ss))
                p2 = v_add(v_lerp(p0, p3, 0.72), (-nrm[0] * side * 3.5 * ss, -nrm[1] * side * 3.5 * ss - 7.0 * ss))
                pts = sample_cubic(p0, p1, p2, p3, 10)
                ws = [max(0.5, (1.0 - (i / 10.0) ** 1.35) * (3.6 * ss * aura_str)) for i in range(11)]
                f_poly = build_tapered_ribbon_poly(pts, ws)
                x0, y0, fbw, fbh = poly_bbox(f_poly)
                fl_s = pygame.Surface((fbw + 6, fbh + 6), pygame.SRCALPHA)
                loc = [(p[0] - x0 + 3, p[1] - y0 + 3) for p in f_poly]
                c_fl = pal.aura_mid if k % 2 == 0 else pal.aura_outer
                f_mul = clamp(0.46 * aura_str, 0.18, 0.72)
                pygame.draw.polygon(fl_s, (int(c_fl[0] * f_mul), int(c_fl[1] * f_mul), int(c_fl[2] * f_mul), clamp_int(int(235 * f_mul), 0, 235)), loc)
                surf.blit(fl_s, (x0 - 3, y0 - 3), special_flags=pygame.BLEND_RGBA_ADD)

        # 2. Long Two-Handed Leather-Wrapped Grip + Crimson Spiked Pommel
        grip_len = 24.0 * ss * persp_h
        pommel = v_sub(hilt, v_mul(u_dir, grip_len))
        grip_poly = build_anatomical_limb(
            pommel, hilt,
            2.9 * ss * persp_h, 2.9 * ss * persp_h,
            3.1 * ss * persp_h, 3.1 * ss * persp_h,
            3.5 * ss * persp_h, 3.5 * ss * persp_h,
            mid_t=0.5, steps=5,
        )
        self.cg.fill_shaded_poly(
            surf, grip_poly,
            [pal.blade_dark, pal.leather_base, pal.leather_spec],
            light_dir=(0.6, -0.8), ink_color=pal.blade_dark, ink_width=1.2 * ss,
        )
        # Diamond-cross leather grip wraps
        for wi in range(1, 6):
            wp = v_lerp(pommel, hilt, wi / 6.0)
            pygame.draw.line(
                surf, pal.blade_steel,
                v_sub(wp, v_mul(nrm, 2.8 * ss * persp_h)),
                v_add(wp, v_mul(nrm, 2.8 * ss * persp_h)),
                max(1, int(1.0 * ss)),
            )
        # Glowing crimson diamond pommel spike (char.jpg!)
        pom_tip = v_sub(pommel, v_mul(u_dir, 9.5 * ss * persp_h))
        pom_poly = [
            pom_tip,
            v_add(pommel, v_mul(nrm, 4.6 * ss * persp_h)),
            v_add(pommel, v_mul(u_dir, 3.4 * ss * persp_h)),
            v_sub(pommel, v_mul(nrm, 4.6 * ss * persp_h)),
        ]
        self.cg.fill_shaded_poly(
            surf, pom_poly,
            [pal.blade_dark, pal.blade_steel, pal.rune_glow],
