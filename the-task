    # ---------------------------------------------------------------- helpers
    def _load_folder(self) -> None:
        """Folder selection changed: switch the working folder and reload."""
        it = self.folder_list.currentItem()
        if it is None:
            return
        name = it.data(Qt.ItemDataRole.UserRole)
        if name and name != self._folder:
            self._commit_form()
            self._folder = name
        self._reload_groups()

    def _reload_all(self) -> None:
        self._reload_folders()
        self._reload_groups()

    def _reload_folders(self) -> None:
        self.folder_list.clear()
        for f in self.folders:
            it = QListWidgetItem(f"[{f}]  ({len(self.groups.get(f, []))})")
            it.setData(Qt.ItemDataRole.UserRole, f)
            it.setToolTip(f"Folder {f}")
            # folder colour chip - the same colour the inserted tags carry
            pm = QPixmap(14, 14)
            pm.fill(QColor(tag_folder_color(f)))
            it.setIcon(QIcon(pm))
            self.folder_list.addItem(it)
            if f == self._folder:
                self.folder_list.setCurrentItem(it)
        ix = self.folder_list.currentRow()
        if ix < 0 and self.folder_list.count():
            self.folder_list.setCurrentRow(0)
            self._folder = self.folders[0]

    def _reload_groups(self) -> None:
        q = getattr(self, "_search_q", "").lower()
        self.group_list.clear()
        for g in self.groups.get(self._folder, []):
            if q and q not in g["label"].lower() and q not in g["text"].lower():
                continue
            it = QListWidgetItem(g["label"])
            it.setData(Qt.ItemDataRole.UserRole, g)
            it.setToolTip(g["text"])
            self.group_list.addItem(it)
        self._reload_folder_combo()
        if self.group_list.count():
            self.group_list.setCurrentRow(0)
        self._load_form()

    def _filter_groups(self, text: str) -> None:
        """Live filter. With a query it searches ACROSS ALL FOLDERS (results
        are marked with their folder and keep its colour chip); with an empty
        query the list shows the groups of the selected folder again."""
        self._search_q = " ".join(text.split()).lower()
        if not self._search_q:
            self._reload_groups()
            return
        self.group_list.clear()
        for f in self.folders:
            for g in self.groups.get(f, []):
                if self._search_q in g["label"].lower() or self._search_q in g["text"].lower():
                    it = QListWidgetItem(f"{g['label']}   \u2014   [{f}]")
                    it.setData(Qt.ItemDataRole.UserRole, g)
                    it.setToolTip(g["text"])
                    pm = QPixmap(14, 14)
                    pm.fill(QColor(tag_folder_color(f)))
                    it.setIcon(QIcon(pm))
                    self.group_list.addItem(it)
        if self.group_list.count():
            self.group_list.setCurrentRow(0)
        self._load_form()

    def _reload_folder_combo(self) -> None:
        self.folder_combo.blockSignals(True)
        self.folder_combo.clear()
        self.folder_combo.addItems(self.folders)
        ix = self.folder_combo.findText(self._folder)
        if ix >= 0:
            self.folder_combo.setCurrentIndex(ix)
        self.folder_combo.blockSignals(False)

    def _current_group(self) -> Optional[Dict[str, str]]:
        it = self.group_list.currentItem()
        return it.data(Qt.ItemDataRole.UserRole) if it else None

    def _load_form(self) -> None:
        g = self._current_group()
        # the setText calls below fire textChanged -> _commit_form; guard it,
        # otherwise merely SELECTING a cross-folder search result would "move"
        # it into the currently selected folder (combo shows that folder)
        self._form_loading = True
        try:
            if g is None:
                self.label_edit.clear()
                self.text_edit.clear()
            else:
                if self.label_edit.text() != g["label"]:
                    self.label_edit.setText(g["label"])
                if self.text_edit.toPlainText() != g["text"]:
                    self.text_edit.setPlainText(g["text"])
            self._reload_folder_combo()
        finally:
            self._form_loading = False

    def _commit_form(self) -> None:
        """Write the form into the selected group and refresh the list item."""
        if self._loading or getattr(self, "_form_loading", False):
            return
        g = self._current_group()
        if g is None:
            return
        label = self.label_edit.text().strip() or "Group"
        text = " ".join(self.text_edit.toPlainText().split())
        target = self.folder_combo.currentText() or self._folder
        # resolve the group's CURRENT folder by scanning (a global search may
        # show groups from other folders - never move a group by accident)
        cur_f = self._folder_of_group(g)
        moved = bool(cur_f) and target != cur_f
        g["label"], g["text"] = label, text
        it = self.group_list.currentItem()
        if it is not None:
            # keep the cross-folder search decoration intact when editing
            it.setText(label if not getattr(self, "_search_q", "")
                       else f"{label}   \u2014   [{cur_f}]")
            it.setToolTip(text)
        if moved and target in self.groups:
            rows = self.groups.get(cur_f, [])
            if g in rows:
                rows.remove(g)
            self.groups[target].append(g)
            self._reload_groups()

    def _folder_of_group(self, g: Dict[str, str]) -> str:
        """The folder that currently holds the group dict (identity scan)."""
        for f, rows in self.groups.items():
            if g in rows:
                return f
        return self._folder

    # ---------------------------------------------------------------- folders
    def _new_folder(self) -> None:
        name, ok = QInputDialog.getText(self, "New folder", "Folder name:")
        if not ok or not name.strip():
            return
        name = " ".join(name.split())
        if name in self.folders:
            self._flash(f"Folder [{name}] already exists.")
            return
        self.folders.append(name)
        self.groups[name] = []
        self._folder = name
        self._reload_all()

    def _rename_folder(self) -> None:
        old = self._folder
        name, ok = QInputDialog.getText(self, "Rename folder", "New name:", text=old)
        if not ok or not name.strip() or " ".join(name.split()) == old:
            return
        new = " ".join(name.split())
        if new in self.folders:
            self._flash(f"Folder [{new}] already exists.")
            return
        self.folders[self.folders.index(old)] = new
        self.groups[new] = self.groups.pop(old, [])
        self._folder = new
        self._reload_all()

    def _delete_folder(self) -> None:
        f = self._folder
        n = len(self.groups.get(f, []))
        if QMessageBox.question(self, "Delete folder",
                                f"Delete folder [{f}] with its {n} group(s)?",
                                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
                                ) != QMessageBox.StandardButton.Yes:
            return
        self.folders.remove(f)
        self.groups.pop(f, None)
        self._folder = self.folders[0] if self.folders else "General"
        if self._folder not in self.groups:
            self.groups[self._folder] = []
            if self._folder not in self.folders:
                self.folders.insert(0, self._folder)
        self._reload_all()

    # ---------------------------------------------------------------- groups
    def _new_group(self) -> None:
        self._commit_form()
        self.search_edit.clear()          # make sure the new row is visible
        g = {"label": "New group", "text": "new tag text"}
        self.groups.setdefault(self._folder, []).append(g)
        it = QListWidgetItem(g["label"])
        it.setData(Qt.ItemDataRole.UserRole, g)
        it.setToolTip(g["text"])
        self.group_list.addItem(it)
        self.group_list.setCurrentItem(it)
        self.label_edit.setFocus()
        self.label_edit.selectAll()
        self._load_form()

    def _duplicate_group(self) -> None:
        self._commit_form()
        src = self._current_group()
        if src is None:
            return
        g = {"label": src["label"] + " copy", "text": src["text"]}
        self.groups.setdefault(self._folder, []).append(g)
        it = QListWidgetItem(g["label"])
        it.setData(Qt.ItemDataRole.UserRole, g)
        it.setToolTip(g["text"])
        self.group_list.addItem(it)
        self.group_list.setCurrentItem(it)
        self._load_form()

    def _delete_group(self) -> None:
        row = self.group_list.currentRow()
        if row < 0:
            return
        g = self._current_group()
        rows = self.groups.get(self._folder, [])
        if g in rows:
            rows.remove(g)
        self.group_list.takeItem(row)
        row = min(row, self.group_list.count() - 1)
        if row >= 0:
            self.group_list.setCurrentRow(row)
        self._load_form()

    def _move_group(self, delta: int) -> None:
        """Reorder the group one slot up / down (persists on SAVE); works
        while a per-folder list is shown. While a cross-folder search filter
        is active the move is a no-op (the rows belong to several folders)."""
        self._commit_form()
        row = self.group_list.currentRow()
        if row < 0:
            return
        tgt = row + delta
        if tgt < 0 or tgt >= self.group_list.count():
            return
        g_a = self.group_list.item(row).data(Qt.ItemDataRole.UserRole)
        g_b = self.group_list.item(tgt).data(Qt.ItemDataRole.UserRole)
        rows = self.groups.get(self._folder, [])
        if g_a not in rows or g_b not in rows:
            return                     # global search filter active: skip
        ia, ib = rows.index(g_a), rows.index(g_b)
        rows[ia], rows[ib] = rows[ib], rows[ia]
        it = self.group_list.takeItem(row)
        self.group_list.insertItem(tgt, it)
        self.group_list.setCurrentRow(tgt)

    # ---------------------------------------------------------------- save
    def _flash(self, text: str) -> None:
        QMessageBox.information(self, "Tag editor", text)

    def _save_and_close(self) -> None:
        self._commit_form()
        # drop fully empty folders on save (keep at least General)
        folders = [f for f in self.folders if self.groups.get(f) or f == "General"]
        if not folders:
            folders = ["General"]
        save_tags_file(TAGS_FILE, folders, self.groups)
        self.accept()


