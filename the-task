    def spawn_blood_moon_wave(self, owner: Fighter, is_ex: bool = False) -> None:
        dir_s = 1.0 if owner.facing_right else -1.0
        proj = BloodMoonProjectile(
            owner_idx=owner.player_idx,
            palette_idx=owner.palette_idx,
            x=owner.x + dir_s * 88.0,
            y=GROUND_Y - 12.0,
            vx=dir_s * (15.8 if is_ex else 12.4),
            facing_right=owner.facing_right,
            hits_remaining=3 if is_ex else 1,
            damage=560 if is_ex else 880,
            chip_damage=95 if is_ex else 130,
            curse_buildup=16.0 if is_ex else 24.0,
            life=120,
            is_ex=is_ex,
        )
        self.projectiles.append(proj)

    def update(self, stage: CursedCathedralStage) -> None:
        # Cut-in timer
        if self.cut_in.active:
            self.cut_in.timer -= 1
            if self.cut_in.timer <= 0:
                self.cut_in.active = False

        if self.screen_flash_alpha > 1.0:
            self.screen_flash_alpha *= 0.84
        else:
            self.screen_flash_alpha = 0.0

        # Update particles
        alive_p: List[Particle] = []
        for p in self.particles:
            p.life -= 1
            if p.life <= 0:
                continue
            p.vx *= p.drag
            p.vy = p.vy * p.drag + p.gravity
            if p.kind == "PETAL":
                p.vx += math.sin(p.life * 0.22 + p.angle) * 0.18
            p.x += p.vx
            p.y += p.vy
            p.angle += p.ang_vel
            if p.y >= GROUND_Y + 4.0 and p.kind == "BLOOD":
                if p.splat_on_ground:
                    stage.add_blood_splatter(p.x, intensity=p.size * 0.14)
                continue
            alive_p.append(p)
        self.particles = alive_p

        # Update shockwave rings
        alive_r: List[ShockwaveRing] = []
        for r in self.rings:
            r.life -= 1
            if r.life <= 0:
                continue
            u = 1.0 - (r.life / float(max(1, r.max_life)))
            r.radius = lerp(12.0, r.max_radius, ease_out_cubic(u))
            r.angle += 4.5
            alive_r.append(r)
        self.rings = alive_r

        # Update fighter afterimages
        self.afterimages = [a for a in self.afterimages if self._dec_afterimage(a)]

        # Update callouts
        self.callouts = [c for c in self.callouts if self._dec_callout(c)]

        # Update Blood Moon Wave projectiles
        alive_proj: List[BloodMoonProjectile] = []
        for pr in self.projectiles:
            pr.life -= 1
            if pr.hit_cooldown > 0:
                pr.hit_cooldown -= 1
            pr.x += pr.vx
            pr.phase += 0.28
            if pr.life <= 0 or pr.hits_remaining <= 0 or pr.x < STAGE_LEFT_WALL - 140 or pr.x > STAGE_RIGHT_WALL + 140:
                continue
            # Trailing crimson flame sparks behind projectile
            if pr.life % 2 == 0:
                pal = CECILIA_PALETTES[pr.palette_idx]
                self._push_particle(
                    Particle(
                        x=pr.x - (18.0 if pr.facing_right else -18.0),
                        y=pr.y - random.uniform(20.0, 145.0),
                        vx=-pr.vx * 0.18,
                        vy=random.uniform(-2.5, -0.5),
                        size=random.uniform(3.0, 6.0),
                        color=pal.aura_primary,
                        alpha=210.0, life=16, max_life=16,
                        kind="EMBER", additive=True,
                    )
                )
            alive_proj.append(pr)
        self.projectiles = alive_proj

    @staticmethod
    def _dec_afterimage(a: Afterimage) -> bool:
        a.life -= 1
        return a.life > 0

    @staticmethod
    def _dec_callout(c: TacticalCallout) -> bool:
        c.life -= 1
        return c.life > 0

    def render_afterimages(self, target: pygame.Surface, cam: CameraDirector) -> None:
        for a in self.afterimages:
            sx, sy = cam.world_to_screen(a.world_x, a.world_y)
            ratio = a.life / float(max(1, a.max_life))
            w = max(8, int(a.sprite.get_width() * cam.zoom))
            h = max(8, int(a.sprite.get_height() * cam.zoom))
            img = pygame.transform.scale(a.sprite, (w, h)) if abs(cam.zoom - 1.0) > 0.015 else a.sprite.copy()
            img.set_alpha(clamp_int(int(145 * ratio), 10, 200))
            target.blit(img, (int(sx - SPRITE_ANCHOR_X * cam.zoom), int(sy - SPRITE_ANCHOR_Y * cam.zoom)))

    def render_projectiles(self, target: pygame.Surface, cam: CameraDirector) -> None:
        """Render towering procedurally shaded Blood Moon Wave crescent blades!"""
        for pr in self.projectiles:
            sx, sy = cam.world_to_screen(pr.x, pr.y)
            z = cam.zoom
            pal = CECILIA_PALETTES[pr.palette_idx]
            h = (166.0 if not pr.is_ex else 198.0) * z
            w = (68.0 if not pr.is_ex else 84.0) * z
            sign = 1.0 if pr.facing_right else -1.0

            # Outer glowing crimson aura
            self.rast.draw_soft_glow(target, (sx, sy - h * 0.5), h * 0.65, pal.aura_primary, peak_alpha=115, rings=4)

            # Razor curved crescent blade wave polygon
            outer_pts: List[Tuple[float, float]] = []
            inner_pts: List[Tuple[float, float]] = []
            core_pts: List[Tuple[float, float]] = []
            for i in range(15):
                u = i / 14.0
                ang = lerp(-1.28, 1.28, u)
                cy = sy - h * 0.5 + math.sin(ang) * (h * 0.52)
                ox = sx + sign * (math.cos(ang) * w * 0.72)
                ix = sx + sign * (math.cos(ang) * w * 0.16 - w * 0.24)
                cx_c = lerp(ix, ox, 0.72)
                outer_pts.append((ox, cy))
                inner_pts.append((ix, cy))
                core_pts.append((cx_c, cy))

            wave_surf = pygame.Surface((SCREEN_W, SCREEN_H), pygame.SRCALPHA)
            body = outer_pts + list(reversed(inner_pts))
            razor = outer_pts + list(reversed(core_pts))
            if len(body) >= 3:
                pygame.draw.polygon(wave_surf, with_alpha(pal.slash_outer, 215), body)
                pygame.draw.polygon(wave_surf, with_alpha(pal.slash_core, 245), razor)
                pygame.draw.lines(wave_surf, with_alpha(pal.aura_secondary, 220), False, inner_pts, 3)
            target.blit(wave_surf, (0, 0))

    def render_vfx(self, target: pygame.Surface, cam: CameraDirector) -> None:
        # 1. Expanding shockwave rings & rotating arcane sigils
        for r in self.rings:
            sx, sy = cam.world_to_screen(r.x, r.y)
            ratio = r.life / float(max(1, r.max_life))
            al = clamp_int(int(230 * ratio), 0, 255)
            rad = max(3, int(r.radius * cam.zoom))
            if r.is_arcane and rad >= 14:
                base_sigil = self._arcane_gold if r.color[1] > 160 else self._arcane_crimson
                scaled = pygame.transform.rotozoom(base_sigil, r.angle, clamp((rad * 2.0) / 220.0, 0.15, 1.8))
                scaled.set_alpha(al)
                rect = scaled.get_rect(center=(int(sx), int(sy)))
                target.blit(scaled, rect, special_flags=pygame.BLEND_RGBA_ADD)
            else:
                ring_s = pygame.Surface((rad * 2 + 8, rad * 2 + 8), pygame.SRCALPHA)
                pygame.draw.circle(ring_s, with_alpha(r.color, al), (rad + 4, rad + 4), rad, max(1, int(r.thickness * ratio)))
                target.blit(ring_s, (int(sx - rad - 4), int(sy - rad - 4)), special_flags=pygame.BLEND_RGBA_ADD)

        # 2. Particles (Blood arcs, Sparks, Rose Petals, Shards, Slash Streaks)
        norm_layer = pygame.Surface((SCREEN_W, SCREEN_H), pygame.SRCALPHA)
        add_layer = pygame.Surface((SCREEN_W, SCREEN_H), pygame.SRCALPHA)
        z = cam.zoom
        for p in self.particles:
            sx, sy = cam.world_to_screen(p.x, p.y)
            if sx < -60 or sx > SCREEN_W + 60 or sy < -60 or sy > SCREEN_H + 60:
                continue
            ratio = p.life / float(max(1, p.max_life))
            al = clamp_int(int(p.alpha * ratio), 0, 255)
            dst = add_layer if p.additive else norm_layer
            col = with_alpha(p.color, al)
            sz = max(1.2, p.size * z * (0.45 + 0.55 * ratio))

            if p.kind == "BLOOD":
                # Streaked teardrop arterial blood droplet oriented along velocity
                tail_x = sx - p.vx * z * 1.45
                tail_y = sy - p.vy * z * 1.45
                pygame.draw.line(dst, col, (tail_x, tail_y), (sx, sy), max(2, int(sz)))
                pygame.draw.circle(dst, col, (int(sx), int(sy)), max(1, int(sz * 0.72)))
            elif p.kind == "SPARK":
                tx = sx - p.vx * z * 1.9
                ty = sy - p.vy * z * 1.9
                pygame.draw.line(dst, col, (tx, ty), (sx, sy), max(1, int(sz * 0.7)))
            elif p.kind == "SLASH_LINE":
                dx = math.cos(p.angle) * sz
                dy = math.sin(p.angle) * sz
                pygame.draw.line(dst, col, (sx - dx, sy - dy), (sx + dx, sy + dy), max(2, int(4 * ratio)))
            elif p.kind == "PETAL":
                ca, sa = math.cos(p.angle), math.sin(p.angle)
                pts = [
                    (sx + ca * sz, sy + sa * sz),
                    (sx - sa * sz * 0.55, sy + ca * sz * 0.55),
                    (sx - ca * sz, sy - sa * sz),
                    (sx + sa * sz * 0.55, sy - ca * sz * 0.55),
                ]
                pygame.draw.polygon(dst, col, pts)
            elif p.kind == "SHARD":
                ca, sa = math.cos(p.angle), math.sin(p.angle)
                pts = [
                    (sx + ca * sz * 1.4, sy + sa * sz * 1.4),
                    (sx - sa * sz * 0.6, sy + ca * sz * 0.6),
                    (sx - ca * sz * 0.8, sy - sa * sz * 0.8),
                ]
                pygame.draw.polygon(dst, col, pts)
            else:
                pygame.draw.circle(dst, col, (int(sx), int(sy)), max(1, int(sz)))

        target.blit(norm_layer, (0, 0))
        target.blit(add_layer, (0, 0), special_flags=pygame.BLEND_RGBA_ADD)

        # 3. Screen impact flash overlay
        if self.screen_flash_alpha > 2.0:
            fl = pygame.Surface((SCREEN_W, SCREEN_H), pygame.SRCALPHA)
            fl.fill(with_alpha(self.screen_flash_color, clamp_int(int(self.screen_flash_alpha), 0, 220)))
            target.blit(fl, (0, 0), special_flags=pygame.BLEND_RGBA_ADD)

    def render_super_cut_in(
        self, target: pygame.Surface, bank: SpriteBank, fonts: FontManager
    ) -> None:
        """Render dramatic DMC4 / BlazBlue blazing anime cut-in banner during Supers!"""
        ci = self.cut_in
        if not ci.active:
            return
        u = 1.0 - (ci.timer / float(max(1, ci.max_timer)))
        # Slide in swiftly, hold dramatically, sweep out
        if u < 0.16:
            env = ease_out_cubic(u / 0.16)
        elif u > 0.82:
            env = 1.0 - ease_out_cubic((u - 0.82) / 0.18)
        else:
            env = 1.0

        band_h = int(206 * env)
        if band_h < 8:
            return
        band_y = HALF_H - band_h // 2 - 22

        # Diagonal slashed obsidian-crimson banner strip across entire screen
        band = pygame.Surface((SCREEN_W, band_h), pygame.SRCALPHA)
        base_col = (142, 8, 28, 236) if not ci.is_fatal else (92, 4, 18, 248)
        band.fill(base_col)

        # High-speed anime action lines streaking across banner
        rng = random.Random(int(ci.timer * 13) + 5)
        for _ in range(36):
            ly = rng.randint(0, band_h - 1)
            lw = rng.randint(140, 520)
            lx = rng.randint(-100, SCREEN_W)
            col_l = (255, 226, 150, 145) if ci.is_fatal else (255, 72, 92, 130)
            pygame.draw.line(band, col_l, (lx, ly), (lx + lw, ly), rng.randint(1, 3))

        # High-detail blazing golden-eyed Cecilia Darkmoon anime close-up portrait!
        facing_r = (ci.player_idx == 0)
        port = bank.get_portrait(
