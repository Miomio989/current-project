# ==============================================================================

class SpriteBank:
    """Bakes & caches Cecilia's painterly keyframe sprites, portraits, and tinted
    flash/afterimage overlays for rock-solid 60 FPS even on low-end laptops.
    """

    def __init__(self, rast: PainterlyRasterizer, renderer: CeciliaRenderer) -> None:
        self.rast = rast
        self.renderer = renderer
        self.keyframes = build_all_animation_keyframes()

        # Cache: (palette_idx, state, frame_idx, facing_right, resonance) -> Surface
        self._sprite_cache: Dict[Tuple[int, FighterState, int, bool, bool], pygame.Surface] = {}
        # Cache: (palette_idx, expression, width, height, cut_in, facing_right) -> Surface
        self._portrait_cache: Dict[Tuple[int, ExpressionId, int, int, bool, bool], pygame.Surface] = {}
        # Cache for pre-baked title key visual
        self._title_hero: Optional[pygame.Surface] = None

        # Progressive bake queue for smooth loading bar
        self._bake_queue: List[Tuple[int, FighterState, int]] = []
        self._total_preload: int = 0
        self._done_preload: int = 0
        self._prepare_preload_queue()

    def _prepare_preload_queue(self) -> None:
        """Queue core states for Palette 0 & Palette 1 during startup loading."""
        priority_states = [
            FighterState.IDLE,
            FighterState.WALK_FWD,
            FighterState.WALK_BACK,
            FighterState.DASH_FWD,
            FighterState.CROUCH_IDLE,
            FighterState.JUMP_RISE,
            FighterState.JUMP_FALL,
            FighterState.GUARD_STAND,
            FighterState.ATTACK_5L,
            FighterState.ATTACK_5M,
            FighterState.ATTACK_5H,
            FighterState.ATTACK_5C,
            FighterState.ATTACK_2M,
            FighterState.ATTACK_2H,
            FighterState.HITSTUN_HIGH,
            FighterState.INTRO_POSE,
        ]
        for pal_idx in (0, 1):
            for st in priority_states:
                kfs = self.keyframes[st]
                for fi in range(len(kfs)):
                    self._bake_queue.append((pal_idx, st, fi))
        self._total_preload = max(1, len(self._bake_queue))
        self._done_preload = 0

    def step_preload(self, budget_items: int = 6) -> float:
        """Bake a small chunk of sprites per loading-screen frame; returns progress [0..1]."""
        for _ in range(budget_items):
            if not self._bake_queue:
                break
            pal_idx, st, fi = self._bake_queue.pop(0)
            self.get_sprite(pal_idx, st, fi, facing_right=True, resonance=False)
            self._done_preload += 1
        return clamp(self._done_preload / float(self._total_preload), 0.0, 1.0)

    def is_preload_complete(self) -> bool:
        return len(self._bake_queue) == 0

    def get_frame_list(self, state: FighterState) -> List[PoseKeyframe]:
        return self.keyframes.get(state, self.keyframes[FighterState.IDLE])

    def get_frame_index_for_tick(
        self, state: FighterState, state_tick: int, loop: bool = False
    ) -> int:
        frames = self.get_frame_list(state)
        total = sum(max(1, f.duration) for f in frames)
        if total <= 0:
            return 0
        t = (state_tick % total) if loop else min(state_tick, total - 1)
        acc = 0
        for i, f in enumerate(frames):
            acc += max(1, f.duration)
            if t < acc:
                return i
        return len(frames) - 1

    def get_sprite(
        self,
        palette_idx: int,
        state: FighterState,
        frame_idx: int,
        facing_right: bool = True,
        resonance: bool = False,
    ) -> pygame.Surface:
        pal_i = palette_idx % len(CECILIA_PALETTES)
        frames = self.get_frame_list(state)
        fi = clamp_int(frame_idx, 0, len(frames) - 1)
        key = (pal_i, state, fi, facing_right, resonance)
        cached = self._sprite_cache.get(key)
        if cached is not None:
            return cached

        # Render right-facing canonical version first, flip for left-facing
        right_key = (pal_i, state, fi, True, resonance)
        right_surf = self._sprite_cache.get(right_key)
        if right_surf is None:
            pal = CECILIA_PALETTES[pal_i]
            right_surf = self.renderer.render_keyframe(
                frames[fi], pal, resonance_active=resonance
            )
            self._sprite_cache[right_key] = right_surf

        if facing_right:
            return right_surf

        flipped = pygame.transform.flip(right_surf, True, False)
        self._sprite_cache[key] = flipped

        # Keep cache memory bounded comfortably on low-RAM laptops
        if len(self._sprite_cache) > 1600:
            drop_keys = list(self._sprite_cache.keys())[:350]
            for dk in drop_keys:
                del self._sprite_cache[dk]
        return flipped

    def get_portrait(
        self,
        palette_idx: int,
        expression: ExpressionId,
        width: int = 112,
        height: int = 112,
        cut_in_mode: bool = False,
        facing_right: bool = True,
    ) -> pygame.Surface:
        pal_i = palette_idx % len(CECILIA_PALETTES)
        key = (pal_i, expression, width, height, cut_in_mode, facing_right)
        cached = self._portrait_cache.get(key)
        if cached is not None:
            return cached
        pal = CECILIA_PALETTES[pal_i]
        surf = self.renderer.render_portrait_bust(
            width=width,
            height=height,
            pal=pal,
            expression=expression,
            cut_in_mode=cut_in_mode,
            facing_right=facing_right,
        )
        self._portrait_cache[key] = surf
        return surf

    def get_title_hero_art(self) -> pygame.Surface:
        """Render large high-resolution full-figure key visual of Cecilia Darkmoon
        for the Title Screen (exact iconic noble pose from char.jpg!).
        """
        if self._title_hero is not None:
            return self._title_hero
        hero_kf = ANIMATION_KEYFRAMES[FighterState.INTRO_POSE][1]
        pal = CECILIA_PALETTES[0]
        raw = self.renderer.render_keyframe(hero_kf, pal, resonance_active=True, scale=1.52)
        scaled = pygame.transform.smoothscale(raw, (int(SPRITE_W * 1.48), int(SPRITE_H * 1.48)))
        self._title_hero = scaled
        return scaled

    @staticmethod
    def make_tinted_ghost(
        sprite: pygame.Surface, tint: RGB, alpha: int
    ) -> pygame.Surface:
        """Create a fast colored afterimage silhouette for Dash/EX/Resonance trails."""
        ghost = sprite.copy()
        tint_s = pygame.Surface(sprite.get_size(), pygame.SRCALPHA)
        tint_s.fill((tint[0], tint[1], tint[2], 255))
        ghost.blit(tint_s, (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
        ghost.set_alpha(clamp_int(alpha, 0, 255))
        return ghost

    @staticmethod
    def make_hitflash_sprite(
        sprite: pygame.Surface, flash_col: RGB = (255, 220, 225)
    ) -> pygame.Surface:
        """Create a crisp additive impact flash sprite on damage frames."""
        out = sprite.copy()
        add_s = pygame.Surface(sprite.get_size(), pygame.SRCALPHA)
        add_s.fill((flash_col[0] // 2, flash_col[1] // 2, flash_col[2] // 2, 0))
        out.blit(add_s, (0, 0), special_flags=pygame.BLEND_RGBA_ADD)
        return out

