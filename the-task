def render_calligraphy_logo(
    rast: PainterlyCGRasterizer,
    scale: float = 1.0,
    crimson_glow: bool = True,
    gold_trim: bool = False,
) -> pygame.Surface:
    """
    Render the official Japanese title '呪いの刃' in dramatic dry-brush
    sumi-e / Devil May Cry calligraphy with crimson cursed halo and crisp
    ivory-silver metallic brush luster.
    """
    w = max(32, int(round(410 * scale)))
    h = max(16, int(round(118 * scale)))
    surf = pygame.Surface((w, h), pygame.SRCALPHA)

    ox = 8.0 * scale
    oy = 8.0 * scale

    # Pass 1: Crimson cursed aura shadow beneath brushstrokes
    if crimson_glow:
        glow_surf = pygame.Surface((w, h), pygame.SRCALPHA)
        for gx, strokes in _CALLIGRAPHY_4GLYPHS:
            for st in strokes:
                pts = [Vec2(ox + (gx + p[0]) * scale, oy + p[1] * scale) for p in st.pts]
                curve = sample_catmull_rom(pts, steps_per_seg=6)
                n = len(curve)
                widths = [
                    (lerp(st.w_start, st.w_mid, u * 2.0) if u < 0.5 else lerp(st.w_mid, st.w_end, (u - 0.5) * 2.0))
                    * scale * 1.48
                    for u in (i / float(max(1, n - 1)) for i in range(n))
                ]
                _, _, poly = build_tapered_ribbon(curve, widths)
                if len(poly) >= 3:
                    pygame.draw.polygon(glow_surf, (224, 18, 62, 130), [p.as_int() for p in poly])
        surf.blit(glow_surf, (int(2 * scale), int(3 * scale)))
        surf.blit(glow_surf, (int(-1 * scale), int(1 * scale)))

    # Pass 2: Deep obsidian-crimson bevel outline + gleaming ivory-white brush core
    for idx_g, (gx, strokes) in enumerate(_CALLIGRAPHY_4GLYPHS):
        for idx_s, st in enumerate(strokes):
            pts = [Vec2(ox + (gx + p[0]) * scale, oy + p[1] * scale) for p in st.pts]
            curve = sample_catmull_rom(pts, steps_per_seg=6)
            n = len(curve)
            widths = [
                (lerp(st.w_start, st.w_mid, u * 2.0) if u < 0.5 else lerp(st.w_mid, st.w_end, (u - 0.5) * 2.0))
                * scale
                for u in (i / float(max(1, n - 1)) for i in range(n))
            ]
            _, _, poly = build_tapered_ribbon(curve, widths)
            if len(poly) < 3:
                continue
            # Special crimson highlight on the defining blade-drop stroke of 刃!
            is_blade_dot = (idx_g == 3 and idx_s == 2)
            if is_blade_dot:
                hi_c, mid_c, sh_c = (255, 198, 212), (242, 34, 82), (118, 8, 32)
            elif gold_trim:
                hi_c, mid_c, sh_c = (255, 248, 224), (236, 188, 108), (112, 46, 28)
            else:
                hi_c, mid_c, sh_c = (255, 250, 252), (228, 208, 222), (108, 32, 62)

            rast.paint_cg_poly(
                surf,
                poly,
                col_hi=hi_c,
                col_mid=mid_c,
                col_shadow=sh_c,
                light_dir=(0.25, -0.96),
                rim_color=(255, 128, 168),
                rim_strength=0.45,
                ink_color=(28, 4, 14),
                ink_width=max(1.0, 1.5 * scale),
                cel_cut=0.52,
                volume_curve=0.22,
            )

    # Pass 3: Subtle crimson horizontal katana gleam slashing through the logo
    slash_y = int(oy + 54 * scale)
    pygame.draw.line(
        surf,
        (255, 72, 124, 160),
        (int(4 * scale), slash_y + int(6 * scale)),
        (w - int(6 * scale), slash_y - int(8 * scale)),
        max(1, int(1.6 * scale)),
    )
    return surf


