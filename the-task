    # --------------------------------------------------------------------------
    # Live Update & Full Multi-Layer Render with Real-Time Fighter Reflections!
    # --------------------------------------------------------------------------

    def update(self, dt: float) -> None:
        self.time_s += dt
        # Periodic apocalyptic storm lightning
        self.next_lightning_t -= dt
        if self.next_lightning_t <= 0.0:
            self.lightning_flash = 0.85
            self.next_lightning_t = random.uniform(7.5, 16.0)
            bx = random.randint(120, 680)
            pts = [(bx, 0)]
            for step in range(1, 9):
                bx += random.randint(-28, 28)
                pts.append((bx, step * 44))
            self.lightning_pts = pts
        if self.lightning_flash > 0.0:
            self.lightning_flash = max(0.0, self.lightning_flash - dt * 3.4)

        for emb in self.embers:
            emb.life += dt
            emb.x += (emb.vx + math.sin(self.time_s * 2.4 + emb.phase) * 14.0) * dt
            emb.y += emb.vy * dt
            if emb.life >= emb.max_life or emb.y < 30.0:
                emb.life = 0.0
                emb.x = random.uniform(80.0, WORLD_W - 80.0)
                emb.y = random.uniform(430.0, 580.0)

        for bat in self.bats:
            bat.wing_phase += dt * 13.5
            bat.x += bat.vx * dt
            bat.y += (bat.vy + math.sin(self.time_s * 2.0 + bat.wing_phase * 0.2) * 16.0) * dt
            if bat.x < 40.0:
                bat.x = WORLD_W - 40.0
            elif bat.x > WORLD_W - 40.0:
                bat.x = 40.0

        # Expand ripples
        alive_r: List[WaterRipple] = []
        for r in self.ripples:
            r.radius += (r.max_radius - r.radius) * min(1.0, dt * 6.5) + dt * 24.0
            r.alpha -= dt * 1.65
            if r.alpha > 0.03 and r.radius < r.max_radius:
                alive_r.append(r)
        self.ripples = alive_r

        # Ballistic white-pink water splash plumes
        alive_s: List[WaterSplashPlume] = []
        for sp in self.splashes:
            sp.life += dt
            if sp.life < sp.max_life:
                sp.world_x += sp.vx * dt
                sp.world_y += sp.vy * dt
                sp.vy += 680.0 * dt
                alive_s.append(sp)
        self.splashes = alive_s

        # Slowly fade blood decals
        for dec in self.blood_decals:
            dec.alpha = max(0.18, dec.alpha - dt * 0.008)

