    """
    Three-tab AAA Gallery:
      Tab 0 — Hand-Crafted Animation Keyframe Inspector (step/play all 60 states & 536+ cels!)
      Tab 1 — CG Portraits & Super Cut-In Showcase
      Tab 2 — Full Non-Looping Techno/Breakbeat OST Jukebox with live spectrum bars
    """

    def __init__(self, bank: SpriteBank, audio: AudioManager, fonts: FontManager) -> None:
        self.bank = bank
        self.audio = audio
        self.fonts = fonts
        self.tab: int = 0
        self.states: List[FighterState] = list(bank.atlas.keys())
        self.state_idx: int = self.states.index(FighterState.ATTACK_5H)
        self.frame_idx: int = 4
        self.pal_idx: int = 0
        self.playing: bool = True
        self.anim_accum: float = 0.0
        self.track_idx: int = 2
        self.tracks: List[OSTTrackId] = list(OSTTrackId)

    def handle_key(self, key: int) -> bool:
        if key in (pygame.K_ESCAPE, pygame.K_BACKSPACE):
            return True
        if key == pygame.K_TAB:
            self.tab = (self.tab + 1) % 3
            return False
        if self.tab == 0:
            if key in (pygame.K_UP, pygame.K_w):
                self.state_idx = (self.state_idx - 1) % len(self.states)
                self.frame_idx = 0
            elif key in (pygame.K_DOWN, pygame.K_s):
                self.state_idx = (self.state_idx + 1) % len(self.states)
                self.frame_idx = 0
            elif key in (pygame.K_LEFT, pygame.K_a):
                self.playing = False
                n = len(self.bank.get_keyframes(self.states[self.state_idx]))
                self.frame_idx = (self.frame_idx - 1) % n
            elif key in (pygame.K_RIGHT, pygame.K_d):
                self.playing = False
                n = len(self.bank.get_keyframes(self.states[self.state_idx]))
                self.frame_idx = (self.frame_idx + 1) % n
            elif key == pygame.K_SPACE:
                self.playing = not self.playing
            elif key == pygame.K_c:
                self.pal_idx = (self.pal_idx + 1) % len(PALETTE_ORDER)
        elif self.tab == 1:
            if key in (pygame.K_LEFT, pygame.K_a, pygame.K_RIGHT, pygame.K_d):
                self.pal_idx = (self.pal_idx + (1 if key in (pygame.K_RIGHT, pygame.K_d) else -1)) % len(PALETTE_ORDER)
        elif self.tab == 2:
            if key in (pygame.K_UP, pygame.K_w):
                self.track_idx = (self.track_idx - 1) % len(self.tracks)
            elif key in (pygame.K_DOWN, pygame.K_s):
                self.track_idx = (self.track_idx + 1) % len(self.tracks)
            elif key in (pygame.K_RETURN, pygame.K_SPACE):
                self.audio.play_bgm(self.tracks[self.track_idx], force_restart=True)
        return False

    def render(self, dest: pygame.Surface, stage: CursedCathedralStage, dt: float, t: float) -> None:
        stage.render_background(dest, STAGE_CENTER_X, 0.0)
        veil = pygame.Surface((INTERNAL_W, INTERNAL_H), pygame.SRCALPHA)
        veil.fill((12, 4, 18, 206))
        dest.blit(veil, (0, 0))

        tabs = ("KEYFRAME INSPECTOR", "CG ART & CUT-INS", "OST JUKEBOX")
        for i, name in enumerate(tabs):
            tx = 140 + i * 260
            col = (255, 224, 118) if i == self.tab else (164, 142, 168)
            self.fonts.draw_text(dest, f"[ {name} ]", tx, 18, size=15, color=col, style="serif", bold=(i == self.tab), align="center")

        pal_key = PALETTE_ORDER[self.pal_idx]
        if self.tab == 0:
            st = self.states[self.state_idx]
            frames = self.bank.get_keyframes(st)
            if self.playing:
                self.anim_accum += dt * 60.0
                dur = max(1, frames[self.frame_idx % len(frames)].duration)
                if self.anim_accum >= dur:
                    self.anim_accum = 0.0
                    self.frame_idx = (self.frame_idx + 1) % len(frames)
            self.frame_idx %= len(frames)
            kf = frames[self.frame_idx]

