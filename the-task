    def _draw_gnarled_swamp_tree(
        self, surf: pygame.Surface, root_x: float, root_y: float, height: float, lean: float, seed: int
    ) -> None:
        """Draw a twisted dead swamp cypress silhouette draped in hanging moss."""
        col = (18, 8, 20)
        rim = (158, 34, 58)
        p0 = Vec2(root_x, root_y)
        p1 = Vec2(root_x + lean * 0.4, root_y - height * 0.45)
        p2 = Vec2(root_x + lean, root_y - height)
        trunk = sample_quad_bezier(p0, p1, p2, steps=10)
        ws = [13.0 * (1.0 - (i / 10.0) * 0.72) for i in range(11)]
        poly = build_variable_ribbon(trunk, ws)
        self.rast.paint_shaded_poly(surf, poly, (48, 22, 36), col, (10, 4, 12), rim_color=rim, rim_strength=0.35, outline_color=None)

        # Twisted skeletal branches + hanging Spanish moss tendrils
        for bi in range(5):
            u = 0.42 + bi * 0.13
            bp = trunk[min(len(trunk) - 1, int(u * (len(trunk) - 1)))]
            side = -1.0 if (bi % 2 == 0) else 1.0
            blen = height * (0.48 - bi * 0.05)
            b_mid = bp + Vec2(side * blen * 0.55, -blen * 0.25)
            b_end = bp + Vec2(side * blen, -blen * 0.12 + hash_2d(bi, seed, 88) * 28.0)
            b_curve = sample_quad_bezier(bp, b_mid, b_end, steps=7)
            b_rib = build_variable_ribbon(b_curve, [4.6 * (1.0 - k / 7.0) for k in range(8)])
            if len(b_rib) >= 4:
                self.rast.paint_soft_shadow_poly(surf, b_rib, col, alpha=245)
            # Hanging eerie moss strips
            for mi in (2, 4, 6):
                mp = b_curve[mi]
                mlen = 18.0 + hash_2d(bi * 7 + mi, seed, 331) * 32.0
                pygame.draw.line(surf, (38, 18, 32, 185), mp.to_int_tuple(), (int(mp.x + 2), int(mp.y + mlen)), 2)

